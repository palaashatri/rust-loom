import {
    LoomToolbar, LoomToolbarGroup, LoomToolbarSpacer, LoomToolbarDivider,
    LoomButton, LoomIconButton, LoomOverflowButton,
} from "foundation.slint";
import { Theme } from "theme.slint";

export component WriterActionToolbar inherits LoomToolbar {
    in property <bool> rtl: Theme.rtl;
    in property <bool> wide: false;
    in property <bool> overflow: false;
    in property <bool> inspector-available: true;
    in property <bool> inspector-visible: false;
    in property <bool> labeled-export: false;
    in property <float> page-zoom: 1.0;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in property <bool> is-bold: false;
    in property <bool> is-italic: false;
    in property <bool> is-underline: false;
    in property <bool> is-strikethrough: false;
    in property <int> text-alignment: 0;

    callback toggle-inspector;
    callback export-pdf;
    callback overflow-requested;
    callback page-zoom-changed(float);
    callback undo;
    callback redo;
    callback toggle-bold;
    callback toggle-italic;
    callback toggle-underline;
    callback toggle-strikethrough;
    callback select-alignment(int);
    callback insert-table;
    callback insert-shape;
    callback insert-text-box;
    callback insert-comment;
    callback add-page;
    callback toggle-sidebar;

    function next-page-zoom() -> float {
        return root.page-zoom >= 1.5 ? 1.0 : root.page-zoom + 0.25;
    }

    // Left Navigation / Document Group
    LoomToolbarGroup {
        LoomIconButton {
            icon: "sidebar";
            label: "View";
            tooltip: "Toggle View";
            clicked => { root.toggle-sidebar(); }
        }
        LoomButton {
            icon: "zoom-in";
            label: Math.round(root.page-zoom * 100) + "%";
            variant: "ghost";
            clicked => { root.page-zoom-changed(root.next-page-zoom()); }
        }
        LoomIconButton {
            icon: "plus";
            label: "Add Page";
            tooltip: "Add Page";
            clicked => { root.add-page(); }
        }
        LoomIconButton {
            icon: "undo";
            label: "Undo";
            tooltip: "Undo last edit (Cmd+Z)";
            enabled: root.can-undo;
            clicked => { root.undo(); }
        }
        LoomIconButton {
            icon: "redo";
            label: "Redo";
            tooltip: "Redo last edit (Cmd+Shift+Z)";
            enabled: root.can-redo;
            clicked => { root.redo(); }
        }
    }

    LoomToolbarDivider { }

    // Center Insert Group (matching Apple Pages Insert tools)
    LoomToolbarGroup {
        LoomButton {
            icon: "table";
            label: root.wide ? "Table" : "";
            variant: "ghost";
            clicked => { root.insert-table(); }
        }
        LoomButton {
            icon: "shape";
            label: root.wide ? "Shape" : "";
            variant: "ghost";
            clicked => { root.insert-shape(); }
        }
        LoomButton {
            icon: "text";
            label: root.wide ? "Text" : "";
            variant: "ghost";
            clicked => { root.insert-text-box(); }
        }
        LoomButton {
            icon: "comment";
            label: root.wide ? "Comment" : "";
            variant: "ghost";
            clicked => { root.insert-comment(); }
        }
    }

    LoomToolbarDivider { }

    // Fast Formatting Group
    LoomToolbarGroup {
        LoomIconButton {
            icon: "bold";
            label: "Bold";
            tooltip: "Bold (Cmd+B)";
            selected: root.is-bold;
            clicked => { root.toggle-bold(); }
        }
        LoomIconButton {
            icon: "italic";
            label: "Italic";
            tooltip: "Italic (Cmd+I)";
            selected: root.is-italic;
            clicked => { root.toggle-italic(); }
        }
        LoomIconButton {
            icon: "underline";
            label: "Underline";
            tooltip: "Underline (Cmd+U)";
            selected: root.is-underline;
            clicked => { root.toggle-underline(); }
        }
        LoomIconButton {
            icon: "strikethrough";
            label: "Strikethrough";
            tooltip: "Strikethrough";
            selected: root.is-strikethrough;
            clicked => { root.toggle-strikethrough(); }
        }
        LoomIconButton {
            icon: "align-left";
            label: "Align Left";
            tooltip: "Align Left";
            selected: root.text-alignment == 0;
            clicked => { root.select-alignment(0); }
        }
        LoomIconButton {
            icon: "align-center";
            label: "Align Center";
            tooltip: "Align Center";
            selected: root.text-alignment == 1;
            clicked => { root.select-alignment(1); }
        }
        LoomIconButton {
            icon: "align-right";
            label: "Align Right";
            tooltip: "Align Right";
            selected: root.text-alignment == 2;
            clicked => { root.select-alignment(2); }
        }
    }

    LoomToolbarSpacer { }

    // Right Action & Inspector Group
    LoomToolbarGroup {
        LoomButton {
            icon: "export";
            label: root.wide || root.labeled-export ? "Export PDF" : "";
            variant: "ghost";
            clicked => { root.export-pdf(); }
        }
        LoomButton {
            icon: "format";
            label: root.wide ? "Format" : "";
            variant: root.inspector-visible ? "primary" : "ghost";
            selected: root.inspector-visible;
            enabled: root.inspector-available;
            clicked => { if (root.inspector-available) { root.toggle-inspector(); } }
        }
        if root.overflow : LoomOverflowButton {
            clicked => { root.overflow-requested(); }
        }
    }
}

export component WriterToolbarBody inherits HorizontalLayout {
    in property <bool> wide: false;
    in property <bool> overflow: false;
    in property <bool> inspector-available: true;
    in property <bool> inspector-visible: false;
    in property <bool> labeled-export: false;
    in property <float> page-zoom: 1.0;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in property <bool> is-bold: false;
    in property <bool> is-italic: false;
    in property <bool> is-underline: false;
    in property <bool> is-strikethrough: false;
    in property <int> text-alignment: 0;
    in property <bool> rtl: false;

    callback toggle-inspector;
    callback export-pdf;
    callback overflow-requested;
    callback page-zoom-changed(float);
    callback undo;
    callback redo;
    callback toggle-bold;
    callback toggle-italic;
    callback toggle-underline;
    callback toggle-strikethrough;
    callback select-alignment(int);
    callback insert-table;
    callback insert-shape;
    callback insert-text-box;
    callback insert-comment;
    callback add-page;
    callback toggle-sidebar;

    spacing: Theme.tokens.space.xs;

    function next-page-zoom() -> float {
        return root.page-zoom >= 1.5 ? 1.0 : root.page-zoom + 0.25;
    }

    LoomToolbarGroup {
        LoomIconButton {
            icon: "sidebar";
            label: "View";
            tooltip: "Toggle View";
            clicked => { root.toggle-sidebar(); }
        }
        LoomButton {
            icon: "zoom-in";
            label: Math.round(root.page-zoom * 100) + "%";
            variant: "ghost";
            clicked => { root.page-zoom-changed(root.next-page-zoom()); }
        }
        LoomIconButton {
            icon: "plus";
            label: "Add Page";
            tooltip: "Add Page";
            clicked => { root.add-page(); }
        }
        LoomIconButton {
            icon: "undo";
            label: "Undo";
            tooltip: "Undo last edit (Cmd+Z)";
            enabled: root.can-undo;
            clicked => { root.undo(); }
        }
        LoomIconButton {
            icon: "redo";
            label: "Redo";
            tooltip: "Redo last edit (Cmd+Shift+Z)";
            enabled: root.can-redo;
            clicked => { root.redo(); }
        }
    }

    LoomToolbarDivider { }

    LoomToolbarGroup {
        LoomButton {
            icon: "table";
            label: root.wide ? "Table" : "";
            variant: "ghost";
            clicked => { root.insert-table(); }
        }
        LoomButton {
            icon: "shape";
            label: root.wide ? "Shape" : "";
            variant: "ghost";
            clicked => { root.insert-shape(); }
        }
        LoomButton {
            icon: "text";
            label: root.wide ? "Text" : "";
            variant: "ghost";
            clicked => { root.insert-text-box(); }
        }
        LoomButton {
            icon: "comment";
            label: root.wide ? "Comment" : "";
            variant: "ghost";
            clicked => { root.insert-comment(); }
        }
    }

    LoomToolbarDivider { }

    LoomToolbarGroup {
        LoomIconButton {
            icon: "bold";
            label: "Bold";
            tooltip: "Bold (Cmd+B)";
            selected: root.is-bold;
            clicked => { root.toggle-bold(); }
        }
        LoomIconButton {
            icon: "italic";
            label: "Italic";
            tooltip: "Italic (Cmd+I)";
            selected: root.is-italic;
            clicked => { root.toggle-italic(); }
        }
        LoomIconButton {
            icon: "underline";
            label: "Underline";
            tooltip: "Underline (Cmd+U)";
            selected: root.is-underline;
            clicked => { root.toggle-underline(); }
        }
        LoomIconButton {
            icon: "strikethrough";
            label: "Strikethrough";
            tooltip: "Strikethrough";
            selected: root.is-strikethrough;
            clicked => { root.toggle-strikethrough(); }
        }
        LoomIconButton {
            icon: "align-left";
            label: "Align Left";
            tooltip: "Align Left";
            selected: root.text-alignment == 0;
            clicked => { root.select-alignment(0); }
        }
        LoomIconButton {
            icon: "align-center";
            label: "Align Center";
            tooltip: "Align Center";
            selected: root.text-alignment == 1;
            clicked => { root.select-alignment(1); }
        }
        LoomIconButton {
            icon: "align-right";
            label: "Align Right";
            tooltip: "Align Right";
            selected: root.text-alignment == 2;
            clicked => { root.select-alignment(2); }
        }
    }

    LoomToolbarSpacer { }

    LoomToolbarGroup {
        LoomButton {
            icon: "export";
            label: root.wide || root.labeled-export ? "Export PDF" : "";
            variant: "ghost";
            clicked => { root.export-pdf(); }
        }
        LoomButton {
            icon: "format";
            label: root.wide ? "Format" : "";
            variant: root.inspector-visible ? "primary" : "ghost";
            selected: root.inspector-visible;
            enabled: root.inspector-available;
            clicked => { if (root.inspector-available) { root.toggle-inspector(); } }
        }
        if root.overflow : LoomOverflowButton {
            clicked => { root.overflow-requested(); }
        }
    }
}
