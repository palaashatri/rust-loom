import { LabeledToolbar, IconOverLabelToolbarItem, ToolbarSpacer } from "toolkit.slint";
import { LoomOverflowButton } from "foundation.slint";
import { Theme } from "theme.slint";

/// One icon-over-label row in three groups: View/Zoom on the reading-start
/// side, Insert/Text/Style/List in the middle, and Export plus the two
/// inspector tabs on the reading-end side. Items that open a menu report their
/// window x through `toggle-menu`; the menu itself is `WriterToolbarMenu`.
export component WriterActionToolbar inherits LabeledToolbar {
    in property <bool> inspector-visible: false;
    /// 0 = Format, 1 = Document.
    in property <int> inspector-tab: 0;
    /// 0 = none, 1 View, 2 Zoom, 3 Insert, 4 Text, 5 Style, 6 List, 7 Export,
    /// 8 More.
    in property <int> menu-kind: 0;
    /// Window y just below the toolbar, where menus open.
    out property <length> bottom-y: root.absolute-position.y + root.height;

    callback toggle-menu(int, length);
    callback show-inspector-tab(int);

    /// Return keyboard focus to the inspector tab that was showing (after the
    /// inspector closes).
    public function focus-inspector-trigger() {
        if (root.inspector-tab == 1) { document-item.focus-item(); } else { format-item.focus-item(); }
    }

    changed inspector-visible => {
        if (!root.inspector-visible) { root.focus-inspector-trigger(); }
    }

    IconOverLabelToolbarItem {
        icon: "view";
        label: "View";
        checked: root.menu-kind == 1;
        clicked => { root.toggle-menu(1, self.absolute-position.x); }
    }
    IconOverLabelToolbarItem {
        icon: "zoom-fit";
        label: "Zoom";
        checked: root.menu-kind == 2;
        clicked => { root.toggle-menu(2, self.absolute-position.x); }
    }

    ToolbarSpacer { }

    IconOverLabelToolbarItem {
        icon: "plus";
        label: "Insert";
        checked: root.menu-kind == 3;
        clicked => { root.toggle-menu(3, self.absolute-position.x); }
    }
    IconOverLabelToolbarItem {
        icon: "bold";
        label: "Text";
        checked: root.menu-kind == 4;
        clicked => { root.toggle-menu(4, self.absolute-position.x); }
    }
    IconOverLabelToolbarItem {
        icon: "text";
        label: "Style";
        checked: root.menu-kind == 5;
        clicked => { root.toggle-menu(5, self.absolute-position.x); }
    }
    IconOverLabelToolbarItem {
        icon: "list";
        label: "List";
        checked: root.menu-kind == 6;
        clicked => { root.toggle-menu(6, self.absolute-position.x); }
    }

    ToolbarSpacer { }

    IconOverLabelToolbarItem {
        icon: "export";
        label: "Export";
        checked: root.menu-kind == 7;
        clicked => { root.toggle-menu(7, self.absolute-position.x); }
    }
    format-item := IconOverLabelToolbarItem {
        icon: "format";
        label: "Format";
        checked: root.inspector-visible && root.inspector-tab == 0;
        clicked => { root.show-inspector-tab(0); }
    }
    document-item := IconOverLabelToolbarItem {
        icon: "document";
        label: "Document";
        checked: root.inspector-visible && root.inspector-tab == 1;
        clicked => { root.show-inspector-tab(1); }
    }
    more-button := LoomOverflowButton {
        tooltip: "More actions: undo, redo, new, open, save and find";
        clicked => { root.toggle-menu(8, more-button.absolute-position.x); }
    }
}
