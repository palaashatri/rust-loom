import { LoomButton } from "foundation.slint";
import { Icon } from "icons.slint";
import { Theme } from "theme.slint";

export struct WriterTemplatePreviewBlock {
    kind: string,
    text: string,
}

export struct WriterTemplateDescriptor {
    stable-id: string,
    display-name: string,
    category: int,
    preview-kind: string,
    appearance: string,
    preview-blocks: [WriterTemplatePreviewBlock],
}

export global WriterTemplateCatalog {
    in-out property <[WriterTemplateDescriptor]> templates: [];
}

component WriterTemplateCard inherits Rectangle {
    in property <string> title: "Blank";
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <length> preview-width: 140px;
    in property <length> preview-height: 180px;
    in property <color> preview-background: Theme.palette().paper;
    in property <string> preview-label: "Template preview";
    in property <string> preview-kind: "";
    callback clicked;

    width: 160px;
    height: 236px + 22px * (max(1.0, Theme.text-scale) - 1.0);
    border-radius: Theme.tokens.metrics.radius-medium;
    background: touch.has-hover && !root.selected ? Theme.palette().surface-raised : transparent;
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { root.clicked(); }

    VerticalLayout {
        spacing: 8px;
        padding: 8px;
        alignment: center;
        cross-axis-alignment: center;

        Rectangle {
            width: root.preview-width;
            height: root.preview-height;
            border-radius: Theme.tokens.metrics.radius-small;
            background: root.preview-background;
            border-width: root.selected ? 2.5px : 1px;
            border-color: root.selected ? Theme.palette().accent : Theme.palette().border;
            drop-shadow-blur: 14px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.palette().shadow;
            clip: true;
            accessible-role: groupbox;
            accessible-label: root.preview-label;
            accessible-description: root.preview-kind;
            @children
        }

        Rectangle {
            height: 22px * max(1.0, Theme.text-scale);
            border-radius: Theme.tokens.metrics.radius-small;
            background: root.selected ? Theme.palette().accent : transparent;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                alignment: center;
                cross-axis-alignment: center;
                Text {
                    text: root.title;
                    font-size: Theme.type.caption;
                    font-weight: root.selected ? 700 : 500;
                    color: root.selected ? Theme.palette().accent-ink : Theme.palette().ink;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                    max-width: root.width - 16px;
                }
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component CategoryRow inherits Rectangle {
    in property <string> label;
    in property <string> icon-name;
    in property <bool> active: false;
    callback clicked;
    height: 32px * max(1.0, Theme.text-scale);
    border-radius: Theme.tokens.metrics.radius-medium;
    background: root.active ? Theme.palette().surface-raised : transparent;
    if !Theme.rtl : HorizontalLayout {
        spacing: Theme.tokens.space.md;
        padding-left: Theme.tokens.space.md;
        padding-right: Theme.tokens.space.md;
        cross-axis-alignment: center;
        Icon { size: 16px; icon: root.icon-name; tint: root.active ? Theme.palette().accent : Theme.palette().ink-secondary; }
        Text {
            text: root.label;
            font-size: Theme.type.body;
            font-weight: root.active ? 600 : 400;
            color: Theme.palette().ink;
            vertical-alignment: center;
        }
    }
    if Theme.rtl : HorizontalLayout {
        spacing: Theme.tokens.space.md;
        padding-left: Theme.tokens.space.md;
        padding-right: Theme.tokens.space.md;
        alignment: end;
        cross-axis-alignment: center;
        Text {
            text: root.label;
            font-size: Theme.type.body;
            font-weight: root.active ? 600 : 400;
            color: Theme.palette().ink;
            vertical-alignment: center;
        }
        Icon { size: 16px; icon: root.icon-name; tint: root.active ? Theme.palette().accent : Theme.palette().ink-secondary; }
    }
    TouchArea { clicked => { root.clicked(); } }
}

/// A template card is selected and dispatched by its stable catalog ID. Its
/// position is only for layout and keyboard order; it never determines output.
component WriterTemplateOption inherits WriterTemplateCard {
    in property <WriterTemplateDescriptor> descriptor;
    in property <string> current-template-id: "blank";

    title: root.descriptor.display-name;
    accessible-description: "Preview: " + root.descriptor.preview-kind;
    selected: root.current-template-id == root.descriptor.stable-id;
    preview-background: root.descriptor.appearance == "black" ? #000000 : Theme.palette().paper;
    preview-label: root.descriptor.display-name + " preview";
    preview-kind: root.descriptor.preview-kind;

    if root.descriptor.preview-blocks.length > 0 : VerticalLayout {
        spacing: 4px;
        padding: 12px;
        for block[idx] in root.descriptor.preview-blocks : Text {
            text: block.text;
            accessible-label: block.text;
            font-size: block.kind == "heading1" ? Theme.tokens.typography.caption
                : block.kind == "heading2" ? Theme.tokens.typography.micro
                : Theme.tokens.typography.micro;
            font-weight: block.kind == "paragraph" ? 400 : 600;
            color: root.descriptor.appearance == "black" ? #ffffff
                : block.kind == "paragraph" ? Theme.palette().paper-muted : Theme.palette().paper-ink;
            wrap: word-wrap;
            horizontal-stretch: 1;
            vertical-stretch: 0;
        }
    }
}

export component TemplateChooserModal inherits Rectangle {
    in-out property <string> template-selected: "blank";
    in-out property <int> template-category: 0;
    property <int> template-columns: root.width <= 1024px && Theme.text-scale >= 2.0 ? 2 : 3;
    property <length> template-scroll-y: 0px;
    callback cancel-template;
    callback create-template(string);

    function template-visible(category: int) -> bool {
        return root.template-category == 0 || category == root.template-category;
    }

    function choose-template-category(category-index: int) {
        root.template-category = category-index;
        if (category-index > 0) {
            root.template-selected = root.template-id-for-category(category-index);
        }
    }

    x: 0px;
    y: 0px;
    background: Theme.palette().scrim;

    // The chooser is keyboard-complete: Left/Right pick a template, Up/Down a
    // category, Return creates, Escape cancels, and Tab cycles the chooser, its
    // Cancel button and its Create button without leaving the dialog.
    in property <int> refocus-tick: 0;
    changed refocus-tick => { chooser-focus.focus(); }
    changed template-selected => { root.reveal-selected-template(); }
    changed template-columns => { root.reveal-selected-template(); }

    function template-id-for-category(category: int) -> string {
        if (WriterTemplateCatalog.templates.length > 0 && WriterTemplateCatalog.templates[0].category == category) { return WriterTemplateCatalog.templates[0].stable-id; }
        if (WriterTemplateCatalog.templates.length > 1 && WriterTemplateCatalog.templates[1].category == category) { return WriterTemplateCatalog.templates[1].stable-id; }
        if (WriterTemplateCatalog.templates.length > 2 && WriterTemplateCatalog.templates[2].category == category) { return WriterTemplateCatalog.templates[2].stable-id; }
        if (WriterTemplateCatalog.templates.length > 3 && WriterTemplateCatalog.templates[3].category == category) { return WriterTemplateCatalog.templates[3].stable-id; }
        if (WriterTemplateCatalog.templates.length > 4 && WriterTemplateCatalog.templates[4].category == category) { return WriterTemplateCatalog.templates[4].stable-id; }
        if (WriterTemplateCatalog.templates.length > 5 && WriterTemplateCatalog.templates[5].category == category) { return WriterTemplateCatalog.templates[5].stable-id; }
        return root.template-id-at(root.template-index(root.template-selected));
    }

    function template-index(template-id: string) -> int {
        if (WriterTemplateCatalog.templates.length > 0 && WriterTemplateCatalog.templates[0].stable-id == template-id) { return 0; }
        if (WriterTemplateCatalog.templates.length > 1 && WriterTemplateCatalog.templates[1].stable-id == template-id) { return 1; }
        if (WriterTemplateCatalog.templates.length > 2 && WriterTemplateCatalog.templates[2].stable-id == template-id) { return 2; }
        if (WriterTemplateCatalog.templates.length > 3 && WriterTemplateCatalog.templates[3].stable-id == template-id) { return 3; }
        if (WriterTemplateCatalog.templates.length > 4 && WriterTemplateCatalog.templates[4].stable-id == template-id) { return 4; }
        return 5;
    }

    function template-id-at(index: int) -> string {
        return WriterTemplateCatalog.templates[index].stable-id;
    }

    function template-row(template-id: string) -> int {
        return floor(root.template-index(template-id) / root.template-columns);
    }

    function reveal-selected-template() {
        root.template-scroll-y = -root.template-row(root.template-selected)
            * (236px + 22px * (max(1.0, Theme.text-scale) - 1.0) + Theme.tokens.space.xl);
    }

    // The nearest visible stable ID in the reading direction, or the current one.
    function pick-template(delta: int) -> string {
        let s = root.template-index(root.template-selected);
        if (s + delta >= 0 && s + delta < WriterTemplateCatalog.templates.length && root.template-visible(WriterTemplateCatalog.templates[s + delta].category)) { return root.template-id-at(s + delta); }
        if (s + 2 * delta >= 0 && s + 2 * delta < WriterTemplateCatalog.templates.length && root.template-visible(WriterTemplateCatalog.templates[s + 2 * delta].category)) { return root.template-id-at(s + 2 * delta); }
        if (s + 3 * delta >= 0 && s + 3 * delta < WriterTemplateCatalog.templates.length && root.template-visible(WriterTemplateCatalog.templates[s + 3 * delta].category)) { return root.template-id-at(s + 3 * delta); }
        if (s + 4 * delta >= 0 && s + 4 * delta < WriterTemplateCatalog.templates.length && root.template-visible(WriterTemplateCatalog.templates[s + 4 * delta].category)) { return root.template-id-at(s + 4 * delta); }
        if (s + 5 * delta >= 0 && s + 5 * delta < WriterTemplateCatalog.templates.length && root.template-visible(WriterTemplateCatalog.templates[s + 5 * delta].category)) { return root.template-id-at(s + 5 * delta); }
        return root.template-id-at(s);
    }

    chooser-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        init => { chooser-focus.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.cancel-template(); return accept; }
            if (event.text == Key.Return) { root.create-template(root.template-selected); return accept; }
            if (event.text == Key.LeftArrow) { root.template-selected = root.pick-template(Theme.rtl ? 1 : -1); return accept; }
            if (event.text == Key.RightArrow) { root.template-selected = root.pick-template(Theme.rtl ? -1 : 1); return accept; }
            if (event.text == Key.UpArrow) { root.choose-template-category(max(0, root.template-category - 1)); return accept; }
            if (event.text == Key.DownArrow) { root.choose-template-category(min(5, root.template-category + 1)); return accept; }
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                if (event.text == Key.Backtab || event.modifiers.shift) {
                    if (create-button.has-focus) { cancel-button.grab-focus(); } else if (cancel-button.has-focus) { chooser-focus.focus(); } else { create-button.grab-focus(); }
                } else {
                    if (cancel-button.has-focus) { create-button.grab-focus(); } else if (create-button.has-focus) { chooser-focus.focus(); } else { cancel-button.grab-focus(); }
                }
                return accept;
            }
            return reject;
        }

    Rectangle {
        width: min(1160px, max(1px, root.width - 48px));
        x: (root.width - self.width) / 2;
        height: min(760px, max(480px, root.height - 48px));
        y: (root.height - self.height) / 2;
        border-radius: Theme.tokens.metrics.radius-large;
        border-width: 1px;
        border-color: Theme.palette().border;
        background: Theme.palette().surface;
        clip: true;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: Theme.palette().shadow;

        VerticalLayout {
            spacing: 0px;
            padding: 0px;

            // Main body: the category list at the reading-start side (left in LTR,
            // right in RTL) and the template grid filling the rest.
            Rectangle {
                vertical-stretch: 1;

                sidebar := Rectangle {
                    x: Theme.rtl ? parent.width - self.width : 0px;
                    width: 220px + 80px * (max(1.0, Theme.text-scale) - 1.0);
                    height: parent.height;
                    background: Theme.palette().panel;

                    VerticalLayout {
                        spacing: Theme.tokens.space.sm;
                        padding-top: Theme.tokens.space.xl;
                        padding-bottom: Theme.tokens.space.xl;
                        padding-left: Theme.tokens.space.lg;
                        padding-right: Theme.tokens.space.lg;

                        HorizontalLayout {
                            padding-left: Theme.rtl ? 0px : Theme.tokens.space.md;
                            padding-right: Theme.rtl ? Theme.tokens.space.md : 0px;
                            padding-bottom: Theme.tokens.space.sm;
                            alignment: Theme.rtl ? end : start;
                            Text {
                                text: "TEMPLATES";
                                font-size: 10px;
                                font-weight: 700;
                                color: Theme.palette().ink-secondary;
                            }
                        }

                        // Category items
                        CategoryRow { label: "All Templates"; icon-name: "grid"; active: root.template-category == 0; clicked => { root.choose-template-category(0); } }
                        CategoryRow { label: "Basic"; icon-name: "document"; active: root.template-category == 1; clicked => { root.choose-template-category(1); } }
                        CategoryRow { label: "Reports"; icon-name: "chart"; active: root.template-category == 2; clicked => { root.choose-template-category(2); } }
                        CategoryRow { label: "Letters"; icon-name: "folder"; active: root.template-category == 3; clicked => { root.choose-template-category(3); } }
                        CategoryRow { label: "Curricula Vitae"; icon-name: "layers"; active: root.template-category == 4; clicked => { root.choose-template-category(4); } }
                        CategoryRow { label: "Newsletters"; icon-name: "list"; active: root.template-category == 5; clicked => { root.choose-template-category(5); } }

                        Rectangle { vertical-stretch: 1; background: transparent; }

                        // Bottom Language indicator
                        HorizontalLayout {
                            spacing: Theme.tokens.space.sm;
                            padding: Theme.tokens.space.md;
                            alignment: Theme.rtl ? end : start;
                            Text {
                                text: "English (US)";
                                font-size: Theme.type.caption;
                                color: Theme.palette().ink-secondary;
                                vertical-alignment: center;
                            }
                            Icon { size: 12px; icon: "chevron-down"; tint: Theme.palette().ink-secondary; }
                        }
                    }

                    Rectangle {
                        x: Theme.rtl ? 0px : parent.width - 1px;
                        y: 0px;
                        width: 1px;
                        height: parent.height;
                        background: Theme.palette().border;
                    }
                }

                // Content area
                Flickable {
                    x: Theme.rtl ? 0px : sidebar.width;
                    y: 0px;
                    width: parent.width - sidebar.width;
                    height: parent.height;
                    viewport-height: max(self.height, template-content.preferred-height);
                    viewport-y <=> root.template-scroll-y;

                    template-content := VerticalLayout {
                        padding-top: Theme.tokens.space.xl;
                        padding-bottom: Theme.tokens.space.xl;
                        padding-left: Theme.tokens.space.xxl;
                        padding-right: Theme.tokens.space.xxl;
                        spacing: Theme.tokens.space.xl;

                        Text {
                            text: "Choose a Template";
                            font-size: 24px * max(1.0, Theme.text-scale);
                            font-weight: 700;
                            color: Theme.palette().ink;
                            horizontal-alignment: Theme.rtl ? right : left;
                        }

                        if root.template-columns == 2 : VerticalLayout {
                            spacing: Theme.tokens.space.xl;
                            if !Theme.rtl : HorizontalLayout {
                                spacing: Theme.tokens.space.xl;
                                alignment: center;
                                if root.template-visible(WriterTemplateCatalog.templates[0].category) : WriterTemplateOption { descriptor: WriterTemplateCatalog.templates[0]; current-template-id: root.template-selected; clicked => { root.template-selected = WriterTemplateCatalog.templates[0].stable-id; } }
                                if root.template-visible(WriterTemplateCatalog.templates[1].category) : WriterTemplateOption { descriptor: WriterTemplateCatalog.templates[1]; current-template-id: root.template-selected; clicked => { root.template-selected = WriterTemplateCatalog.templates[1].stable-id; } }
                            }
                            if Theme.rtl : HorizontalLayout {
                                spacing: Theme.tokens.space.xl;
                                alignment: center;
                                if root.template-visible(WriterTemplateCatalog.templates[1].category) : WriterTemplateOption { descriptor: WriterTemplateCatalog.templates[1]; current-template-id: root.template-selected; clicked => { root.template-selected = WriterTemplateCatalog.templates[1].stable-id; } }
                                if root.template-visible(WriterTemplateCatalog.templates[0].category) : WriterTemplateOption { descriptor: WriterTemplateCatalog.templates[0]; current-template-id: root.template-selected; clicked => { root.template-selected = WriterTemplateCatalog.templates[0].stable-id; } }
                            }
                            if !Theme.rtl : HorizontalLayout {
                                spacing: Theme.tokens.space.xl;
                                alignment: center;
                                if root.template-visible(WriterTemplateCatalog.templates[2].category) : WriterTemplateOption { descriptor: WriterTemplateCatalog.templates[2]; current-template-id: root.template-selected; clicked => { root.template-selected = WriterTemplateCatalog.templates[2].stable-id; } }
                                if root.template-visible(WriterTemplateCatalog.templates[3].category) : WriterTemplateOption { descriptor: WriterTemplateCatalog.templates[3]; current-template-id: root.template-selected; clicked => { root.template-selected = WriterTemplateCatalog.templates[3].stable-id; } }
                            }
                            if Theme.rtl : HorizontalLayout {
                                spacing: Theme.tokens.space.xl;
                                alignment: center;
                                if root.template-visible(WriterTemplateCatalog.templates[3].category) : WriterTemplateOption { descriptor: WriterTemplateCatalog.templates[3]; current-template-id: root.template-selected; clicked => { root.template-selected = WriterTemplateCatalog.templates[3].stable-id; } }
                                if root.template-visible(WriterTemplateCatalog.templates[2].category) : WriterTemplateOption { descriptor: WriterTemplateCatalog.templates[2]; current-template-id: root.template-selected; clicked => { root.template-selected = WriterTemplateCatalog.templates[2].stable-id; } }
                            }
                            if !Theme.rtl : HorizontalLayout {
                                spacing: Theme.tokens.space.xl;
                                alignment: center;
                                if root.template-visible(WriterTemplateCatalog.templates[4].category) : WriterTemplateOption { descriptor: WriterTemplateCatalog.templates[4]; current-template-id: root.template-selected; clicked => { root.template-selected = WriterTemplateCatalog.templates[4].stable-id; } }
                                if root.template-visible(WriterTemplateCatalog.templates[5].category) : WriterTemplateOption { descriptor: WriterTemplateCatalog.templates[5]; current-template-id: root.template-selected; clicked => { root.template-selected = WriterTemplateCatalog.templates[5].stable-id; } }
                            }
                            if Theme.rtl : HorizontalLayout {
                                spacing: Theme.tokens.space.xl;
                                alignment: center;
                                if root.template-visible(WriterTemplateCatalog.templates[5].category) : WriterTemplateOption { descriptor: WriterTemplateCatalog.templates[5]; current-template-id: root.template-selected; clicked => { root.template-selected = WriterTemplateCatalog.templates[5].stable-id; } }
                                if root.template-visible(WriterTemplateCatalog.templates[4].category) : WriterTemplateOption { descriptor: WriterTemplateCatalog.templates[4]; current-template-id: root.template-selected; clicked => { root.template-selected = WriterTemplateCatalog.templates[4].stable-id; } }
                            }
                        }

                        if root.template-columns == 3 : VerticalLayout {
                            spacing: Theme.tokens.space.xl;
                            if !Theme.rtl : HorizontalLayout {
                                spacing: Theme.tokens.space.xl;
                                alignment: center;
                                if root.template-visible(WriterTemplateCatalog.templates[0].category) : WriterTemplateOption { descriptor: WriterTemplateCatalog.templates[0]; current-template-id: root.template-selected; clicked => { root.template-selected = WriterTemplateCatalog.templates[0].stable-id; } }
                                if root.template-visible(WriterTemplateCatalog.templates[1].category) : WriterTemplateOption { descriptor: WriterTemplateCatalog.templates[1]; current-template-id: root.template-selected; clicked => { root.template-selected = WriterTemplateCatalog.templates[1].stable-id; } }
                                if root.template-visible(WriterTemplateCatalog.templates[2].category) : WriterTemplateOption { descriptor: WriterTemplateCatalog.templates[2]; current-template-id: root.template-selected; clicked => { root.template-selected = WriterTemplateCatalog.templates[2].stable-id; } }
                            }
                            if Theme.rtl : HorizontalLayout {
                                spacing: Theme.tokens.space.xl;
                                alignment: center;
                                if root.template-visible(WriterTemplateCatalog.templates[2].category) : WriterTemplateOption { descriptor: WriterTemplateCatalog.templates[2]; current-template-id: root.template-selected; clicked => { root.template-selected = WriterTemplateCatalog.templates[2].stable-id; } }
                                if root.template-visible(WriterTemplateCatalog.templates[1].category) : WriterTemplateOption { descriptor: WriterTemplateCatalog.templates[1]; current-template-id: root.template-selected; clicked => { root.template-selected = WriterTemplateCatalog.templates[1].stable-id; } }
                                if root.template-visible(WriterTemplateCatalog.templates[0].category) : WriterTemplateOption { descriptor: WriterTemplateCatalog.templates[0]; current-template-id: root.template-selected; clicked => { root.template-selected = WriterTemplateCatalog.templates[0].stable-id; } }
                            }
                            if !Theme.rtl : HorizontalLayout {
                                spacing: Theme.tokens.space.xl;
                                alignment: center;
                                if root.template-visible(WriterTemplateCatalog.templates[3].category) : WriterTemplateOption { descriptor: WriterTemplateCatalog.templates[3]; current-template-id: root.template-selected; clicked => { root.template-selected = WriterTemplateCatalog.templates[3].stable-id; } }
                                if root.template-visible(WriterTemplateCatalog.templates[4].category) : WriterTemplateOption { descriptor: WriterTemplateCatalog.templates[4]; current-template-id: root.template-selected; clicked => { root.template-selected = WriterTemplateCatalog.templates[4].stable-id; } }
                                if root.template-visible(WriterTemplateCatalog.templates[5].category) : WriterTemplateOption { descriptor: WriterTemplateCatalog.templates[5]; current-template-id: root.template-selected; clicked => { root.template-selected = WriterTemplateCatalog.templates[5].stable-id; } }
                            }
                            if Theme.rtl : HorizontalLayout {
                                spacing: Theme.tokens.space.xl;
                                alignment: center;
                                if root.template-visible(WriterTemplateCatalog.templates[5].category) : WriterTemplateOption { descriptor: WriterTemplateCatalog.templates[5]; current-template-id: root.template-selected; clicked => { root.template-selected = WriterTemplateCatalog.templates[5].stable-id; } }
                                if root.template-visible(WriterTemplateCatalog.templates[4].category) : WriterTemplateOption { descriptor: WriterTemplateCatalog.templates[4]; current-template-id: root.template-selected; clicked => { root.template-selected = WriterTemplateCatalog.templates[4].stable-id; } }
                                if root.template-visible(WriterTemplateCatalog.templates[3].category) : WriterTemplateOption { descriptor: WriterTemplateCatalog.templates[3]; current-template-id: root.template-selected; clicked => { root.template-selected = WriterTemplateCatalog.templates[3].stable-id; } }
                            }
                        }
                    }
                }
            }

            // Bottom Action Bar. The primary button sits at the reading end: right
            // in LTR, left in RTL; the hint fills the rest.
            Rectangle {
                height: 56px;
                background: Theme.palette().chrome;

                Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.palette().border; }

                cancel-button := LoomButton {
                    label: "Cancel";
                    variant: "secondary";
                    width: self.preferred-width;
                    height: Theme.tokens.metrics.control-height;
                    x: Theme.rtl
                        ? create-button.x + create-button.width + Theme.tokens.space.lg
                        : create-button.x - Theme.tokens.space.lg - self.width;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.cancel-template(); }
                }

                create-button := LoomButton {
                    label: "Create Document";
                    variant: "primary";
                    width: self.preferred-width;
                    height: Theme.tokens.metrics.control-height;
                    x: Theme.rtl ? Theme.tokens.space.xl : parent.width - Theme.tokens.space.xl - self.width;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.create-template(root.template-selected); }
                }

                Text {
                    text: "Escape to cancel • Return to create";
                    font-size: Theme.type.caption;
                    color: Theme.palette().ink-secondary;
                    x: Theme.rtl ? cancel-button.x + cancel-button.width + Theme.tokens.space.lg : Theme.tokens.space.xl;
                    width: Theme.rtl
                        ? max(0px, parent.width - Theme.tokens.space.xl - self.x)
                        : max(0px, cancel-button.x - Theme.tokens.space.lg - Theme.tokens.space.xl);
                    height: parent.height;
                    horizontal-alignment: Theme.rtl ? right : left;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
    }
}
