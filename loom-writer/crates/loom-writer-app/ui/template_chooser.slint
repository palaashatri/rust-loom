import { LoomButton } from "foundation.slint";
import { Icon } from "icons.slint";
import { Theme } from "theme.slint";
import {
    WriterTemplatePreviewBlock,
    WriterTemplateDescriptor,
    WriterTemplatePreview,
} from "template_previews.slint";

export { WriterTemplatePreviewBlock, WriterTemplateDescriptor }

export global WriterTemplateCatalog {
    in-out property <[WriterTemplateDescriptor]> templates: [];
}

component WriterTemplateCard inherits Rectangle {
    in property <string> title: "Blank";
    in property <bool> selected: false;
    in property <bool> grid-focused: false;
    in property <bool> enabled: true;
    in property <length> preview-width: 140px;
    in property <length> preview-height: 180px;
    in property <color> preview-background: Theme.palette().paper;
    in property <string> preview-label: "Template preview";
    in property <string> preview-kind: "";
    callback clicked;
    callback activated;

    width: 162px + 28px * (max(1.0, Theme.text-scale) - 1.0);
    height: 238px + 34px * (max(1.0, Theme.text-scale) - 1.0);
    border-radius: Theme.tokens.metrics.radius-medium;
    background: root.selected ? Theme.palette().selection-soft
        : (touch.has-hover ? Theme.palette().surface-raised : transparent);
    border-width: root.selected && root.grid-focused ? 1.5px : 0px;
    border-color: Theme.palette().focus;
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { root.clicked(); }

    VerticalLayout {
        spacing: 8px; padding: 8px; alignment: center; cross-axis-alignment: center;

        stage := Rectangle {
            width: 140px; height: 180px; background: transparent;
            frame := Rectangle {
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                width: root.preview-width; height: root.preview-height;
                border-radius: Theme.tokens.metrics.radius-small; background: root.preview-background;
                border-width: root.selected ? 2.5px : 1px;
                border-color: root.selected ? Theme.palette().accent
                    : (touch.has-hover ? Theme.palette().border-strong : Theme.palette().border);
                drop-shadow-blur: root.selected ? 22px : 18px;
                drop-shadow-offset-y: root.selected ? 6px : 4px;
                drop-shadow-color: Theme.palette().shadow;
                clip: true;
                accessible-role: groupbox; accessible-label: root.preview-label; accessible-description: root.preview-kind;

                Rectangle {
                    x: 3px; y: 3px; width: parent.width - 6px; height: parent.height - 6px;
                    border-radius: max(0px, Theme.tokens.metrics.radius-small - 3px);
                    background: root.preview-background; clip: true;
                    @children
                }
            }
            if root.selected : Rectangle {
                x: Theme.rtl ? frame.x - 6px : frame.x + frame.width - 14px; y: frame.y - 6px;
                width: 20px; height: 20px; border-radius: 10px;
                background: Theme.palette().accent; border-width: 1.5px; border-color: Theme.palette().surface;
                drop-shadow-blur: 6px; drop-shadow-offset-y: 2px; drop-shadow-color: Theme.palette().shadow;
                Icon {
                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                    size: 11px; icon: "check"; tint: Theme.palette().accent-ink;
                }
            }
        }

        Rectangle {
            height: 24px + 28px * (max(1.0, Theme.text-scale) - 1.0);
            border-radius: Theme.tokens.metrics.radius-small;
            background: root.selected ? Theme.palette().accent : transparent;
            HorizontalLayout {
                padding-left: 8px; padding-right: 8px; alignment: center; cross-axis-alignment: center;
                Text {
                    text: root.title; font-size: Theme.type.caption; font-weight: root.selected ? 700 : 500;
                    color: root.selected ? Theme.palette().accent-ink : Theme.palette().ink;
                    horizontal-alignment: center; vertical-alignment: center;
                    wrap: word-wrap; overflow: elide; max-width: root.width - 16px;
                }
            }
        }
    }

    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } double-clicked => { root.activated(); } }
}

component CategoryRow inherits Rectangle {
    in property <string> label;
    in property <string> icon-name;
    in property <bool> active: false;
    callback clicked;

    height: max(32px, 28px * max(1.0, Theme.text-scale));
    border-radius: Theme.tokens.metrics.radius-medium;
    background: root.active ? Theme.palette().selection-soft : (cat-touch.has-hover ? Theme.palette().surface-sunken : transparent);
    accessible-role: tab; accessible-label: root.label; accessible-checked: root.active;
    accessible-action-default => { root.clicked(); }

    if root.active : Rectangle {
        x: Theme.rtl ? parent.width - 3px : 0px; y: 6px; width: 3px; height: parent.height - 12px;
        border-radius: 1.5px; background: Theme.palette().accent;
    }
    HorizontalLayout {
        spacing: Theme.tokens.space.md; padding-left: Theme.tokens.space.md; padding-right: Theme.tokens.space.md; cross-axis-alignment: center;
        if !Theme.rtl : Icon { size: 16px; icon: root.icon-name; tint: root.active ? Theme.palette().accent : Theme.palette().ink-secondary; }
        Text {
            horizontal-stretch: 1; text: root.label; font-size: Theme.type.body;
            font-weight: root.active ? 700 : 500; color: root.active ? Theme.palette().accent : Theme.palette().ink;
            horizontal-alignment: Theme.rtl ? right : left; vertical-alignment: center; overflow: elide;
        }
        if Theme.rtl : Icon { size: 16px; icon: root.icon-name; tint: root.active ? Theme.palette().accent : Theme.palette().ink-secondary; }
    }
    cat-touch := TouchArea { clicked => { root.clicked(); } }
}

component WriterTemplateOption inherits WriterTemplateCard {
    in property <WriterTemplateDescriptor> descriptor;
    in property <string> current-template-id: "blank";
    title: root.descriptor.display-name;
    accessible-description: "Preview: " + root.descriptor.preview-kind;
    selected: root.current-template-id == root.descriptor.stable-id;
    preview-height: root.descriptor.orientation == "landscape" ? 104px : 180px;
    preview-background: root.descriptor.appearance == "black" ? #000000 : Theme.palette().paper;
    preview-label: root.descriptor.display-name + " preview";
    preview-kind: root.descriptor.preview-kind;
    WriterTemplatePreview { width: 100%; height: 100%; descriptor: root.descriptor; }
}

component TemplateCardRow inherits Rectangle {
    in property <[int]> indices: [];
    in-out property <string> selected-id: "blank";
    in property <bool> grid-focused: false;
    callback activate-template(string);

    pure function empty-descriptor() -> WriterTemplateDescriptor {
        return { stable-id: "", display-name: "", category: 0, preview-kind: "", appearance: "white", orientation: "portrait", has-table: false, preview-blocks: [] };
    }
    height: 238px + 34px * (max(1.0, Theme.text-scale) - 1.0); background: transparent;
    HorizontalLayout {
        spacing: Theme.tokens.space.xl; alignment: center;
        for slot in root.indices.length : WriterTemplateOption {
            property <int> card-idx: Theme.rtl ? root.indices[root.indices.length - 1 - slot] : root.indices[slot];
            property <bool> valid: self.card-idx < WriterTemplateCatalog.templates.length;
            descriptor: self.valid ? WriterTemplateCatalog.templates[self.card-idx] : root.empty-descriptor();
            current-template-id: root.selected-id; grid-focused: root.grid-focused;
            clicked => { if (self.valid) { root.selected-id = self.descriptor.stable-id; } }
            activated => { if (self.valid) { root.selected-id = self.descriptor.stable-id; root.activate-template(self.descriptor.stable-id); } }
        }
    }
}

export component TemplateChooserModal inherits Rectangle {
    in-out property <string> template-selected: "blank";
    in-out property <int> template-category: 0;
    property <int> template-columns: root.width <= 1024px && Theme.text-scale >= 2.0 ? 2 : 3;
    property <length> template-scroll-y: 0px;
    callback cancel-template;
    callback create-template(string);
    callback open-file-requested;

    pure function empty-descriptor() -> WriterTemplateDescriptor {
        return {
            stable-id: "blank", display-name: "Blank", category: 1, preview-kind: "blank",
            appearance: "white", orientation: "portrait", has-table: false, preview-blocks: [],
        };
    }

    function template-visible(category: int) -> bool {
        return root.template-category == 0 || category == root.template-category;
    }

    function choose-template-category(category-index: int) {
        root.template-category = category-index;
        root.template-scroll-y = 0px;
        if (category-index > 0) { root.template-selected = root.template-id-for-category(category-index); }
    }

    x: 0px; y: 0px; background: Theme.palette().scrim;

    in property <int> refocus-tick: 0;
    changed refocus-tick => { chooser-focus.focus(); }
    changed template-selected => { root.reveal-selected-template(); }
    changed template-columns => { root.reveal-selected-template(); }

    function match-cat(i: int, cat: int) -> bool { return i < WriterTemplateCatalog.templates.length && WriterTemplateCatalog.templates[i].category == cat; }
    function cat-scan4(a: int, cat: int) -> int {
        if (root.match-cat(a, cat)) { return a; }
        if (root.match-cat(a + 1, cat)) { return a + 1; }
        if (root.match-cat(a + 2, cat)) { return a + 2; }
        if (root.match-cat(a + 3, cat)) { return a + 3; }
        return -1;
    }
    function template-id-for-category(cat: int) -> string {
        if (root.cat-scan4(0, cat) >= 0) { return WriterTemplateCatalog.templates[root.cat-scan4(0, cat)].stable-id; }
        if (root.cat-scan4(4, cat) >= 0) { return WriterTemplateCatalog.templates[root.cat-scan4(4, cat)].stable-id; }
        if (root.cat-scan4(8, cat) >= 0) { return WriterTemplateCatalog.templates[root.cat-scan4(8, cat)].stable-id; }
        if (root.cat-scan4(12, cat) >= 0) { return WriterTemplateCatalog.templates[root.cat-scan4(12, cat)].stable-id; }
        if (root.cat-scan4(16, cat) >= 0) { return WriterTemplateCatalog.templates[root.cat-scan4(16, cat)].stable-id; }
        return root.template-id-at(root.template-index(root.template-selected));
    }
    function match-id(i: int, id: string) -> bool { return i < WriterTemplateCatalog.templates.length && WriterTemplateCatalog.templates[i].stable-id == id; }
    function id-scan4(a: int, id: string) -> int {
        if (root.match-id(a, id)) { return a; }
        if (root.match-id(a + 1, id)) { return a + 1; }
        if (root.match-id(a + 2, id)) { return a + 2; }
        if (root.match-id(a + 3, id)) { return a + 3; }
        return -1;
    }
    function template-index(id: string) -> int {
        if (root.id-scan4(0, id) >= 0) { return root.id-scan4(0, id); }
        if (root.id-scan4(4, id) >= 0) { return root.id-scan4(4, id); }
        if (root.id-scan4(8, id) >= 0) { return root.id-scan4(8, id); }
        if (root.id-scan4(12, id) >= 0) { return root.id-scan4(12, id); }
        if (root.id-scan4(16, id) >= 0) { return root.id-scan4(16, id); }
        return 0;
    }
    function template-id-at(index: int) -> string {
        if (index >= 0 && index < WriterTemplateCatalog.templates.length) { return WriterTemplateCatalog.templates[index].stable-id; }
        return "blank";
    }
    function vis-before(i: int, target: int) -> int {
        return (i < target && i < WriterTemplateCatalog.templates.length && root.template-visible(WriterTemplateCatalog.templates[i].category)) ? 1 : 0;
    }
    function vis-sum4(a: int, target: int) -> int {
        return root.vis-before(a, target) + root.vis-before(a + 1, target) + root.vis-before(a + 2, target) + root.vis-before(a + 3, target);
    }
    function visible-position(template-id: string) -> int {
        let t = root.template-index(template-id);
        return root.vis-sum4(0, t) + root.vis-sum4(4, t) + root.vis-sum4(8, t) + root.vis-sum4(12, t) + root.vis-sum4(16, t);
    }
    function template-row(template-id: string) -> int { return floor(root.visible-position(template-id) / root.template-columns); }

    function reveal-selected-template() {
        let card-h = 238px + 34px * (max(1.0, Theme.text-scale) - 1.0);
        let row-stride = card-h + Theme.tokens.space.xl;
        let header-end = Theme.tokens.space.xl;
        let row-top = header-end + root.template-row(root.template-selected) * row-stride;
        let row-bottom = row-top + card-h;
        let min-scroll = min(0px, chooser-flickable.height - template-content.preferred-height);
        if (row-top < -root.template-scroll-y) {
            root.template-scroll-y = clamp(-max(0px, row-top - Theme.tokens.space.md), min-scroll, 0px);
        } else if (row-bottom > -root.template-scroll-y + chooser-flickable.height) {
            root.template-scroll-y = clamp(-(row-bottom + Theme.tokens.space.md - chooser-flickable.height), min-scroll, 0px);
        } else {
            root.template-scroll-y = clamp(root.template-scroll-y, min-scroll, 0px);
        }
    }

    function vis-at(i: int) -> bool {
        return i >= 0 && i < WriterTemplateCatalog.templates.length
            && root.template-visible(WriterTemplateCatalog.templates[i].category);
    }

    function pick-scan4(start: int, step: int) -> int {
        if (root.vis-at(start)) { return start; }
        if (root.vis-at(start + step)) { return start + step; }
        if (root.vis-at(start + 2 * step)) { return start + 2 * step; }
        if (root.vis-at(start + 3 * step)) { return start + 3 * step; }
        return -1;
    }

    function pick-template(delta: int) -> string {
        let s = root.template-index(root.template-selected);
        let step = delta < 0 ? -1 : 1;
        if (root.pick-scan4(s + step, step) >= 0) { return root.template-id-at(root.pick-scan4(s + step, step)); }
        if (root.pick-scan4(s + 5 * step, step) >= 0) { return root.template-id-at(root.pick-scan4(s + 5 * step, step)); }
        if (root.pick-scan4(s + 9 * step, step) >= 0) { return root.template-id-at(root.pick-scan4(s + 9 * step, step)); }
        if (root.pick-scan4(s + 13 * step, step) >= 0) { return root.template-id-at(root.pick-scan4(s + 13 * step, step)); }
        if (root.pick-scan4(s + 17 * step, step) >= 0) { return root.template-id-at(root.pick-scan4(s + 17 * step, step)); }
        return root.template-id-at(s);
    }

    property <int> selected-cat-idx: root.template-index(root.template-selected);
    property <WriterTemplateDescriptor> selected-desc: root.selected-cat-idx < WriterTemplateCatalog.templates.length
        ? WriterTemplateCatalog.templates[root.selected-cat-idx] : root.empty-descriptor();

    chooser-focus := FocusScope {
        width: parent.width; height: parent.height;
        init => { chooser-focus.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.cancel-template(); return accept; }
            if (event.text == Key.Return) { root.create-template(root.template-selected); return accept; }
            if (event.text == Key.LeftArrow) { root.template-selected = root.pick-template(Theme.rtl ? 1 : -1); return accept; }
            if (event.text == Key.RightArrow) { root.template-selected = root.pick-template(Theme.rtl ? -1 : 1); return accept; }
            if (event.text == Key.UpArrow) { root.choose-template-category(max(0, root.template-category - 1)); return accept; }
            if (event.text == Key.DownArrow) { root.choose-template-category(min(6, root.template-category + 1)); return accept; }
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                if (event.text == Key.Backtab || event.modifiers.shift) {
                    if (create-button.has-focus) { cancel-button.grab-focus(); } else if (cancel-button.has-focus) { open-button.grab-focus(); }
                    else if (open-button.has-focus) { chooser-focus.focus(); } else { create-button.grab-focus(); }
                } else {
                    if (open-button.has-focus) { cancel-button.grab-focus(); } else if (cancel-button.has-focus) { create-button.grab-focus(); }
                    else if (create-button.has-focus) { chooser-focus.focus(); } else { open-button.grab-focus(); }
                }
                return accept;
            }
            return reject;
        }
        Rectangle {
            width: min(1060px, max(1px, root.width - 40px)); x: (root.width - self.width) / 2;
            height: min(680px, max(min(360px, root.height - 16px), root.height - 56px)); y: (root.height - self.height) / 2;
            border-radius: Theme.tokens.metrics.radius-large; border-width: 1px; border-color: Theme.palette().border-strong;
            background: Theme.palette().surface; clip: true;
            drop-shadow-blur: 32px; drop-shadow-offset-y: 12px; drop-shadow-color: Theme.palette().shadow;
            VerticalLayout {
                spacing: 0px; padding: 0px;
                Rectangle {
                    vertical-stretch: 1;
                    sidebar := Rectangle {
                        x: Theme.rtl ? parent.width - self.width : 0px;
                        width: 224px + 124px * (max(1.0, Theme.text-scale) - 1.0);
                        height: parent.height; background: Theme.palette().panel;
                        VerticalLayout {
                            spacing: 6px; padding: Theme.tokens.space.lg; padding-left: Theme.tokens.space.md; padding-right: Theme.tokens.space.md;
                            HorizontalLayout {
                                padding-left: Theme.rtl ? 0px : Theme.tokens.space.md; padding-right: Theme.rtl ? Theme.tokens.space.md : 0px;
                                padding-bottom: Theme.tokens.space.xs; alignment: Theme.rtl ? end : start;
                                Text { text: "CATEGORIES"; font-size: Theme.type.caption; font-weight: 700; color: Theme.palette().ink-secondary; }
                            }
                            for cat in [
                                { idx: 0, label: "All Templates", icon: "grid" },
                                { idx: 1, label: "Basic", icon: "document" },
                                { idx: 2, label: "Reports & Business", icon: "chart" },
                                { idx: 3, label: "Letters & Memos", icon: "folder" },
                                { idx: 4, label: "Resumes & Academic", icon: "layers" },
                                { idx: 5, label: "Publishing", icon: "list" },
                                { idx: 6, label: "Personal", icon: "sparkle" },
                            ] : CategoryRow {
                                label: cat.label; icon-name: cat.icon; active: root.template-category == cat.idx;
                                clicked => { root.choose-template-category(cat.idx); }
                            }
                            Rectangle { vertical-stretch: 1; background: transparent; }
                        }
                        Rectangle { x: Theme.rtl ? 0px : parent.width - 1px; y: 0px; width: 1px; height: parent.height; background: Theme.palette().border; }
                    }

                    VerticalLayout {
                        x: Theme.rtl ? 0px : sidebar.width; y: 0px;
                        width: parent.width - sidebar.width; height: parent.height; spacing: 0px;

                        Rectangle {
                            height: max(54px, chooser-heading.preferred-height + Theme.tokens.space.lg);
                            background: Theme.palette().surface;

                            chooser-heading := Text {
                                text: "Template Chooser"; font-size: Theme.type.heading; font-weight: 700; color: Theme.palette().ink;
                                x: Theme.rtl ? parent.width - Theme.tokens.space.xxl - self.width : Theme.tokens.space.xxl;
                                y: (parent.height - self.height) / 2;
                                horizontal-alignment: Theme.rtl ? right : left;
                            }
                            summary-pill := Rectangle {
                                property <length> max-pill-w: max(80px, parent.width - chooser-heading.preferred-width - Theme.tokens.space.xxl * 2 - Theme.tokens.space.md);
                                width: min(self.max-pill-w, pill-row.preferred-width);
                                height: max(26px, pill-row.preferred-height);
                                x: Theme.rtl ? Theme.tokens.space.xxl : parent.width - Theme.tokens.space.xxl - self.width;
                                y: (parent.height - self.height) / 2;
                                border-radius: self.height / 2; background: Theme.palette().selection-soft;
                                border-width: 1px; border-color: Theme.is-high-contrast ? Theme.palette().accent : Theme.palette().border;
                                pill-row := HorizontalLayout {
                                    padding-left: Theme.tokens.space.md; padding-right: Theme.tokens.space.md;
                                    spacing: Theme.tokens.space.sm; cross-axis-alignment: center;
                                    Rectangle { width: 6px; height: 6px; border-radius: 3px; background: Theme.palette().accent; }
                                    Text {
                                        text: root.selected-desc.display-name + " \u{2022} "
                                            + (root.selected-desc.orientation == "landscape" ? "Landscape" : "Portrait");
                                        font-size: Theme.type.caption; font-weight: 600; color: Theme.palette().accent; overflow: elide;
                                    }
                                }
                            }
                            Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.palette().border; }
                        }

                        chooser-flickable := Flickable {
                            vertical-stretch: 1; viewport-height: max(self.height, template-content.preferred-height);
                            viewport-y <=> root.template-scroll-y;

                            template-content := VerticalLayout {
                                padding: Theme.tokens.space.xl; padding-left: Theme.tokens.space.xxl; padding-right: Theme.tokens.space.xxl;
                                spacing: Theme.tokens.space.xl;

                                if root.template-category == 0 : VerticalLayout {
                                    spacing: Theme.tokens.space.xl;
                                    for row-idx in floor((WriterTemplateCatalog.templates.length + root.template-columns - 1) / root.template-columns) : HorizontalLayout {
                                        spacing: Theme.tokens.space.xl; alignment: center;
                                        for col-idx in root.template-columns : Rectangle {
                                            property <int> slot-col: Theme.rtl ? (root.template-columns - 1 - col-idx) : col-idx;
                                            property <int> slot-idx: row-idx * root.template-columns + self.slot-col;
                                            width: 162px + 28px * (max(1.0, Theme.text-scale) - 1.0);
                                            height: 238px + 34px * (max(1.0, Theme.text-scale) - 1.0);
                                            background: transparent;
                                            if self.slot-idx < WriterTemplateCatalog.templates.length : WriterTemplateOption {
                                                descriptor: WriterTemplateCatalog.templates[parent.slot-idx];
                                                current-template-id: root.template-selected;
                                                grid-focused: chooser-focus.has-focus;
                                                clicked => { root.template-selected = WriterTemplateCatalog.templates[parent.slot-idx].stable-id; }
                                                activated => {
                                                    root.template-selected = WriterTemplateCatalog.templates[parent.slot-idx].stable-id;
                                                    root.create-template(WriterTemplateCatalog.templates[parent.slot-idx].stable-id);
                                                }
                                            }
                                        }
                                    }
                                }

                                if root.template-category == 1 && root.template-columns == 3 : TemplateCardRow { indices: [0, 1, 3]; selected-id <=> root.template-selected; grid-focused: chooser-focus.has-focus; activate-template(id) => { root.create-template(id); } }
                                if root.template-category == 1 && root.template-columns == 2 : VerticalLayout {
                                    spacing: Theme.tokens.space.xl;
                                    TemplateCardRow { indices: [0, 1]; selected-id <=> root.template-selected; grid-focused: chooser-focus.has-focus; activate-template(id) => { root.create-template(id); } }
                                    TemplateCardRow { indices: [3]; selected-id <=> root.template-selected; grid-focused: chooser-focus.has-focus; activate-template(id) => { root.create-template(id); } }
                                }
                                if root.template-category == 2 && root.template-columns == 3 : VerticalLayout {
                                    spacing: Theme.tokens.space.xl;
                                    TemplateCardRow { indices: [2, 4, 5]; selected-id <=> root.template-selected; grid-focused: chooser-focus.has-focus; activate-template(id) => { root.create-template(id); } }
                                    TemplateCardRow { indices: [6]; selected-id <=> root.template-selected; grid-focused: chooser-focus.has-focus; activate-template(id) => { root.create-template(id); } }
                                }
                                if root.template-category == 2 && root.template-columns == 2 : VerticalLayout {
                                    spacing: Theme.tokens.space.xl;
                                    TemplateCardRow { indices: [2, 4]; selected-id <=> root.template-selected; grid-focused: chooser-focus.has-focus; activate-template(id) => { root.create-template(id); } }
                                    TemplateCardRow { indices: [5, 6]; selected-id <=> root.template-selected; grid-focused: chooser-focus.has-focus; activate-template(id) => { root.create-template(id); } }
                                }
                                if root.template-category == 3 && root.template-columns == 3 : VerticalLayout {
                                    spacing: Theme.tokens.space.xl;
                                    TemplateCardRow { indices: [7, 8, 9]; selected-id <=> root.template-selected; grid-focused: chooser-focus.has-focus; activate-template(id) => { root.create-template(id); } }
                                    TemplateCardRow { indices: [10]; selected-id <=> root.template-selected; grid-focused: chooser-focus.has-focus; activate-template(id) => { root.create-template(id); } }
                                }
                                if root.template-category == 3 && root.template-columns == 2 : VerticalLayout {
                                    spacing: Theme.tokens.space.xl;
                                    TemplateCardRow { indices: [7, 8]; selected-id <=> root.template-selected; grid-focused: chooser-focus.has-focus; activate-template(id) => { root.create-template(id); } }
                                    TemplateCardRow { indices: [9, 10]; selected-id <=> root.template-selected; grid-focused: chooser-focus.has-focus; activate-template(id) => { root.create-template(id); } }
                                }
                                if root.template-category == 4 && root.template-columns == 3 : TemplateCardRow { indices: [11, 12, 13]; selected-id <=> root.template-selected; grid-focused: chooser-focus.has-focus; activate-template(id) => { root.create-template(id); } }
                                if root.template-category == 4 && root.template-columns == 2 : VerticalLayout {
                                    spacing: Theme.tokens.space.xl;
                                    TemplateCardRow { indices: [11, 12]; selected-id <=> root.template-selected; grid-focused: chooser-focus.has-focus; activate-template(id) => { root.create-template(id); } }
                                    TemplateCardRow { indices: [13]; selected-id <=> root.template-selected; grid-focused: chooser-focus.has-focus; activate-template(id) => { root.create-template(id); } }
                                }
                                if root.template-category == 5 : TemplateCardRow { indices: [14, 15]; selected-id <=> root.template-selected; grid-focused: chooser-focus.has-focus; activate-template(id) => { root.create-template(id); } }
                                if root.template-category == 6 : TemplateCardRow { indices: [16, 17]; selected-id <=> root.template-selected; grid-focused: chooser-focus.has-focus; activate-template(id) => { root.create-template(id); } }
                            }
                        }
                    }
                }

                Rectangle {
                    height: max(56px, Theme.scaled-control-height + Theme.tokens.space.lg);
                    background: Theme.palette().chrome;
                    Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.palette().border; }

                    open-button := LoomButton {
                        label: "Open File\u{2026}"; variant: "secondary";
                        width: self.preferred-width; height: Theme.scaled-control-height;
                        x: Theme.rtl ? parent.width - Theme.tokens.space.xl - self.width : Theme.tokens.space.xl;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.open-file-requested(); }
                    }
                    cancel-button := LoomButton {
                        label: "Cancel"; variant: "secondary";
                        width: self.preferred-width; height: Theme.scaled-control-height;
                        x: Theme.rtl ? create-button.x + create-button.width + Theme.tokens.space.lg : create-button.x - Theme.tokens.space.lg - self.width;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.cancel-template(); }
                    }
                    create-button := LoomButton {
                        label: "Create Document"; variant: "primary";
                        width: self.preferred-width; height: Theme.scaled-control-height;
                        x: Theme.rtl ? Theme.tokens.space.xl : parent.width - Theme.tokens.space.xl - self.width;
                        y: (parent.height - self.height) / 2;
                        clicked => { root.create-template(root.template-selected); }
                    }
                    Text {
                        text: "Esc: cancel \u{2022} Return: create"; font-size: Theme.type.caption; color: Theme.palette().ink-secondary;
                        x: Theme.rtl ? cancel-button.x + cancel-button.width + Theme.tokens.space.lg : open-button.x + open-button.width + Theme.tokens.space.lg;
                        width: Theme.rtl ? max(0px, open-button.x - Theme.tokens.space.lg - self.x) : max(0px, cancel-button.x - Theme.tokens.space.lg - self.x);
                        height: parent.height; horizontal-alignment: Theme.rtl ? right : left; vertical-alignment: center; overflow: elide;
                    }
                }
            }
        }
    }
}
