import { LoomButton } from "foundation.slint";
import { Icon } from "icons.slint";
import { Theme } from "theme.slint";

component WriterTemplateCard inherits Rectangle {
    in property <string> title: "Blank";
    in property <bool> selected: false;
    in property <bool> enabled: true;
    in property <length> preview-width: 140px;
    in property <length> preview-height: 180px;
    in property <color> preview-background: Theme.palette().paper;
    callback clicked;

    width: 160px;
    height: 236px + 22px * (max(1.0, Theme.text-scale) - 1.0);
    border-radius: Theme.tokens.metrics.radius-medium;
    background: touch.has-hover && !root.selected ? Theme.palette().surface-raised : transparent;
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { root.clicked(); }

    VerticalLayout {
        spacing: 8px;
        padding: 8px;
        alignment: center;
        cross-axis-alignment: center;

        Rectangle {
            width: root.preview-width;
            height: root.preview-height;
            border-radius: Theme.tokens.metrics.radius-small;
            background: root.preview-background;
            border-width: root.selected ? 2.5px : 1px;
            border-color: root.selected ? Theme.palette().accent : Theme.palette().border;
            drop-shadow-blur: 14px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.palette().shadow;
            clip: true;
            @children
        }

        Rectangle {
            height: 22px * max(1.0, Theme.text-scale);
            border-radius: Theme.tokens.metrics.radius-small;
            background: root.selected ? Theme.palette().accent : transparent;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                alignment: center;
                cross-axis-alignment: center;
                Text {
                    text: root.title;
                    font-size: Theme.type.caption;
                    font-weight: root.selected ? 700 : 500;
                    color: root.selected ? Theme.palette().accent-ink : Theme.palette().ink;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                    max-width: root.width - 16px;
                }
            }
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component CategoryRow inherits Rectangle {
    in property <string> label;
    in property <string> icon-name;
    in property <bool> active: false;
    callback clicked;
    height: 32px * max(1.0, Theme.text-scale);
    border-radius: Theme.tokens.metrics.radius-medium;
    background: root.active ? Theme.palette().surface-raised : transparent;
    if !Theme.rtl : HorizontalLayout {
        spacing: Theme.tokens.space.md;
        padding-left: Theme.tokens.space.md;
        padding-right: Theme.tokens.space.md;
        cross-axis-alignment: center;
        Icon { size: 16px; icon: root.icon-name; tint: root.active ? Theme.palette().accent : Theme.palette().ink-secondary; }
        Text {
            text: root.label;
            font-size: Theme.type.body;
            font-weight: root.active ? 600 : 400;
            color: Theme.palette().ink;
            vertical-alignment: center;
        }
    }
    if Theme.rtl : HorizontalLayout {
        spacing: Theme.tokens.space.md;
        padding-left: Theme.tokens.space.md;
        padding-right: Theme.tokens.space.md;
        alignment: end;
        cross-axis-alignment: center;
        Text {
            text: root.label;
            font-size: Theme.type.body;
            font-weight: root.active ? 600 : 400;
            color: Theme.palette().ink;
            vertical-alignment: center;
        }
        Icon { size: 16px; icon: root.icon-name; tint: root.active ? Theme.palette().accent : Theme.palette().ink-secondary; }
    }
    TouchArea { clicked => { root.clicked(); } }
}

/// One template card, whose miniature document is chosen by its number. The
/// same six cards appear in either reading order.
component WriterTemplateOption inherits WriterTemplateCard {
    in property <int> index: 0;
    in property <int> current: 0;

    title: ["Blank", "Blank Black", "Executive Report", "Business Letter", "Curriculum Vitae", "Newsletter"][root.index];
    selected: root.current == root.index;
    preview-background: root.index == 1 ? #18181b : Theme.palette().paper;

    if root.index == 0 : VerticalLayout {
        spacing: 8px;
        padding: 16px;
        Text {
            text: "Aa";
            font-size: Theme.tokens.typography.display-large;
            font-weight: 700;
            color: Theme.palette().paper-ink;
            horizontal-alignment: center;
            vertical-alignment: center;
            vertical-stretch: 1;
        }
        Rectangle { height: 1px; background: Theme.palette().paper-line; }
    }
    if root.index == 1 : VerticalLayout {
        spacing: 8px;
        padding: 16px;
        Text {
            text: "Aa";
            font-size: Theme.tokens.typography.display-large;
            font-weight: 700;
            color: #f4f4f5;
            horizontal-alignment: center;
            vertical-alignment: center;
            vertical-stretch: 1;
        }
        Rectangle { height: 1px; background: #3f3f46; }
    }
    if root.index == 2 : VerticalLayout {
        spacing: 6px;
        padding: 14px;
        Text { text: "REPORT TITLE"; font-size: Theme.tokens.typography.micro; font-weight: 700; color: Theme.palette().paper-ink; }
        Rectangle { height: 2px; background: Theme.palette().accent; }
        Rectangle { height: 3px; background: Theme.palette().paper-line; }
        Rectangle { height: 3px; background: Theme.palette().paper-line; }
        Rectangle { height: 3px; width: 75%; background: Theme.palette().paper-line; }
        Rectangle { height: 6px; background: transparent; }
        Text { text: "Executive Summary"; font-size: Theme.tokens.typography.micro; font-weight: 600; color: Theme.palette().paper-muted; }
        Rectangle { height: 3px; background: Theme.palette().paper-line; }
        Rectangle { height: 3px; width: 85%; background: Theme.palette().paper-line; }
        Rectangle { vertical-stretch: 1; background: transparent; }
    }
    if root.index == 3 : VerticalLayout {
        spacing: 6px;
        padding: 14px;
        Text { text: "Your Name"; font-size: Theme.tokens.typography.caption; font-weight: 600; color: Theme.palette().paper-ink; }
        Text { text: "October 24, 2026"; font-size: Theme.tokens.typography.micro; color: Theme.palette().paper-muted; }
        Rectangle { height: 1px; background: Theme.palette().paper-line; }
        Text { text: "Dear Recipient,"; font-size: Theme.tokens.typography.micro; color: Theme.palette().paper-ink; }
        Rectangle { height: 3px; background: Theme.palette().paper-line; }
        Rectangle { height: 3px; background: Theme.palette().paper-line; }
        Rectangle { height: 3px; width: 60%; background: Theme.palette().paper-line; }
        Rectangle { vertical-stretch: 1; background: transparent; }
    }
    if root.index == 4 : VerticalLayout {
        spacing: 5px;
        padding: 12px;
        Text { text: "YOUR NAME"; font-size: Theme.tokens.typography.caption; font-weight: 700; color: Theme.palette().paper-ink; }
        Rectangle { height: 2px; background: Theme.palette().content-cool; }
        Text { text: "EXPERIENCE"; font-size: Theme.tokens.typography.micro; font-weight: 600; color: Theme.palette().paper-muted; }
        Rectangle { height: 3px; background: Theme.palette().paper-line; }
        Rectangle { height: 3px; width: 80%; background: Theme.palette().paper-line; }
        Text { text: "EDUCATION"; font-size: Theme.tokens.typography.micro; font-weight: 600; color: Theme.palette().paper-muted; }
        Rectangle { height: 3px; background: Theme.palette().paper-line; }
        Rectangle { vertical-stretch: 1; background: transparent; }
    }
    if root.index == 5 : VerticalLayout {
        spacing: 4px;
        padding: 12px;
        Rectangle {
            height: 20px;
            background: Theme.palette().content-accent-soft;
            border-radius: 2px;
            Text { text: "NEWSLETTER"; font-size: 8px; font-weight: 700; color: Theme.palette().accent; horizontal-alignment: center; vertical-alignment: center; }
        }
        HorizontalLayout {
            spacing: 6px;
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 3px;
                Rectangle { height: 3px; background: Theme.palette().paper-line; }
                Rectangle { height: 3px; background: Theme.palette().paper-line; }
                Rectangle { height: 3px; background: Theme.palette().paper-line; }
                Rectangle { vertical-stretch: 1; background: transparent; }
            }
            Rectangle { width: 1px; background: Theme.palette().paper-line; }
            VerticalLayout {
                spacing: 3px;
                Rectangle { height: 3px; background: Theme.palette().paper-line; }
                Rectangle { height: 3px; background: Theme.palette().paper-line; }
                Rectangle { vertical-stretch: 1; background: transparent; }
            }
        }
    }
}

export component TemplateChooserModal inherits Rectangle {
    in-out property <int> template-selected: 0;
    in-out property <int> template-category: 0;
    callback cancel-template;
    callback create-template(int);

    function template-visible(template-index: int) -> bool {
        return root.template-category == 0
            || (root.template-category == 1 && (template-index == 0 || template-index == 1))
            || (root.template-category == 2 && template-index == 2)
            || (root.template-category == 3 && template-index == 3)
            || (root.template-category == 4 && template-index == 4)
            || (root.template-category == 5 && template-index == 5);
    }

    function choose-template-category(category-index: int) {
        root.template-category = category-index;
        if (category-index == 1 && root.template-selected > 1) {
            root.template-selected = 0;
        } else if (category-index == 2) {
            root.template-selected = 2;
        } else if (category-index == 3) {
            root.template-selected = 3;
        } else if (category-index == 4) {
            root.template-selected = 4;
        } else if (category-index == 5) {
            root.template-selected = 5;
        }
    }

    x: 0px;
    y: 0px;
    background: Theme.palette().scrim;

    // The chooser is keyboard-complete: Left/Right pick a template, Up/Down a
    // category, Return creates, Escape cancels, and Tab cycles the chooser, its
    // Cancel button and its Create button without leaving the dialog.
    in property <int> refocus-tick: 0;
    changed refocus-tick => { chooser-focus.focus(); }

    // The nearest visible template in the direction of `delta`, or the current one.
    function pick-template(delta: int) -> int {
        let s = root.template-selected;
        if (s + delta >= 0 && s + delta <= 5 && root.template-visible(s + delta)) { return s + delta; }
        if (s + 2 * delta >= 0 && s + 2 * delta <= 5 && root.template-visible(s + 2 * delta)) { return s + 2 * delta; }
        if (s + 3 * delta >= 0 && s + 3 * delta <= 5 && root.template-visible(s + 3 * delta)) { return s + 3 * delta; }
        if (s + 4 * delta >= 0 && s + 4 * delta <= 5 && root.template-visible(s + 4 * delta)) { return s + 4 * delta; }
        if (s + 5 * delta >= 0 && s + 5 * delta <= 5 && root.template-visible(s + 5 * delta)) { return s + 5 * delta; }
        return s;
    }

    chooser-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        init => { chooser-focus.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.cancel-template(); return accept; }
            if (event.text == Key.Return) { root.create-template(root.template-selected); return accept; }
            if (event.text == Key.LeftArrow) { root.template-selected = root.pick-template(Theme.rtl ? 1 : -1); return accept; }
            if (event.text == Key.RightArrow) { root.template-selected = root.pick-template(Theme.rtl ? -1 : 1); return accept; }
            if (event.text == Key.UpArrow) { root.choose-template-category(max(0, root.template-category - 1)); return accept; }
            if (event.text == Key.DownArrow) { root.choose-template-category(min(5, root.template-category + 1)); return accept; }
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                if (event.text == Key.Backtab || event.modifiers.shift) {
                    if (create-button.has-focus) { cancel-button.grab-focus(); } else if (cancel-button.has-focus) { chooser-focus.focus(); } else { create-button.grab-focus(); }
                } else {
                    if (cancel-button.has-focus) { create-button.grab-focus(); } else if (create-button.has-focus) { chooser-focus.focus(); } else { cancel-button.grab-focus(); }
                }
                return accept;
            }
            return reject;
        }

    Rectangle {
        width: min(1160px, max(1px, root.width - 48px));
        x: (root.width - self.width) / 2;
        height: min(760px, max(480px, root.height - 48px));
        y: (root.height - self.height) / 2;
        border-radius: Theme.tokens.metrics.radius-large;
        border-width: 1px;
        border-color: Theme.palette().border;
        background: Theme.palette().surface;
        clip: true;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: Theme.palette().shadow;

        VerticalLayout {
            spacing: 0px;
            padding: 0px;

            // Main body: the category list at the reading-start side (left in LTR,
            // right in RTL) and the template grid filling the rest.
            Rectangle {
                vertical-stretch: 1;

                sidebar := Rectangle {
                    x: Theme.rtl ? parent.width - self.width : 0px;
                    width: 220px + 80px * (max(1.0, Theme.text-scale) - 1.0);
                    height: parent.height;
                    background: Theme.palette().panel;

                    VerticalLayout {
                        spacing: Theme.tokens.space.sm;
                        padding-top: Theme.tokens.space.xl;
                        padding-bottom: Theme.tokens.space.xl;
                        padding-left: Theme.tokens.space.lg;
                        padding-right: Theme.tokens.space.lg;

                        HorizontalLayout {
                            padding-left: Theme.rtl ? 0px : Theme.tokens.space.md;
                            padding-right: Theme.rtl ? Theme.tokens.space.md : 0px;
                            padding-bottom: Theme.tokens.space.sm;
                            alignment: Theme.rtl ? end : start;
                            Text {
                                text: "TEMPLATES";
                                font-size: 10px;
                                font-weight: 700;
                                color: Theme.palette().ink-secondary;
                            }
                        }

                        // Category items
                        CategoryRow { label: "All Templates"; icon-name: "grid"; active: root.template-category == 0; clicked => { root.choose-template-category(0); } }
                        CategoryRow { label: "Basic"; icon-name: "document"; active: root.template-category == 1; clicked => { root.choose-template-category(1); } }
                        CategoryRow { label: "Reports"; icon-name: "book"; active: root.template-category == 2; clicked => { root.choose-template-category(2); } }
                        CategoryRow { label: "Letters"; icon-name: "folder"; active: root.template-category == 3; clicked => { root.choose-template-category(3); } }
                        CategoryRow { label: "Curricula Vitae"; icon-name: "layers"; active: root.template-category == 4; clicked => { root.choose-template-category(4); } }
                        CategoryRow { label: "Newsletters"; icon-name: "layout"; active: root.template-category == 5; clicked => { root.choose-template-category(5); } }

                        Rectangle { vertical-stretch: 1; background: transparent; }

                        // Bottom Language indicator
                        HorizontalLayout {
                            spacing: Theme.tokens.space.sm;
                            padding: Theme.tokens.space.md;
                            alignment: Theme.rtl ? end : start;
                            Text {
                                text: "English (US)";
                                font-size: Theme.type.caption;
                                color: Theme.palette().ink-secondary;
                                vertical-alignment: center;
                            }
                            Icon { size: 12px; icon: "chevron-down"; tint: Theme.palette().ink-secondary; }
                        }
                    }

                    Rectangle {
                        x: Theme.rtl ? 0px : parent.width - 1px;
                        y: 0px;
                        width: 1px;
                        height: parent.height;
                        background: Theme.palette().border;
                    }
                }

                // Content area
                Flickable {
                    x: Theme.rtl ? 0px : sidebar.width;
                    y: 0px;
                    width: parent.width - sidebar.width;
                    height: parent.height;
                    viewport-height: 640px;

                    VerticalLayout {
                        padding-top: Theme.tokens.space.xl;
                        padding-bottom: Theme.tokens.space.xl;
                        padding-left: Theme.tokens.space.xxl;
                        padding-right: Theme.tokens.space.xxl;
                        spacing: Theme.tokens.space.xl;

                        Text {
                            text: "Choose a Template";
                            font-size: 24px * max(1.0, Theme.text-scale);
                            font-weight: 700;
                            color: Theme.palette().ink;
                            horizontal-alignment: Theme.rtl ? right : left;
                        }

                        // Row 1: Basic & Reports. Right-to-left reads each row from the right.
                        if !Theme.rtl : HorizontalLayout {
                            spacing: Theme.tokens.space.xl;
                            alignment: center;
                            if root.template-visible(0) : WriterTemplateOption { index: 0; current: root.template-selected; clicked => { root.template-selected = 0; } }
                            if root.template-visible(1) : WriterTemplateOption { index: 1; current: root.template-selected; clicked => { root.template-selected = 1; } }
                            if root.template-visible(2) : WriterTemplateOption { index: 2; current: root.template-selected; clicked => { root.template-selected = 2; } }
                        }
                        if Theme.rtl : HorizontalLayout {
                            spacing: Theme.tokens.space.xl;
                            alignment: center;
                            if root.template-visible(2) : WriterTemplateOption { index: 2; current: root.template-selected; clicked => { root.template-selected = 2; } }
                            if root.template-visible(1) : WriterTemplateOption { index: 1; current: root.template-selected; clicked => { root.template-selected = 1; } }
                            if root.template-visible(0) : WriterTemplateOption { index: 0; current: root.template-selected; clicked => { root.template-selected = 0; } }
                        }

                        // Row 2: Letters, CV & Newsletters
                        if !Theme.rtl : HorizontalLayout {
                            spacing: Theme.tokens.space.xl;
                            alignment: center;
                            if root.template-visible(3) : WriterTemplateOption { index: 3; current: root.template-selected; clicked => { root.template-selected = 3; } }
                            if root.template-visible(4) : WriterTemplateOption { index: 4; current: root.template-selected; clicked => { root.template-selected = 4; } }
                            if root.template-visible(5) : WriterTemplateOption { index: 5; current: root.template-selected; clicked => { root.template-selected = 5; } }
                        }
                        if Theme.rtl : HorizontalLayout {
                            spacing: Theme.tokens.space.xl;
                            alignment: center;
                            if root.template-visible(5) : WriterTemplateOption { index: 5; current: root.template-selected; clicked => { root.template-selected = 5; } }
                            if root.template-visible(4) : WriterTemplateOption { index: 4; current: root.template-selected; clicked => { root.template-selected = 4; } }
                            if root.template-visible(3) : WriterTemplateOption { index: 3; current: root.template-selected; clicked => { root.template-selected = 3; } }
                        }
                    }
                }
            }

            // Bottom Action Bar. The primary button sits at the reading end: right
            // in LTR, left in RTL; the hint fills the rest.
            Rectangle {
                height: 56px;
                background: Theme.palette().chrome;

                Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.palette().border; }

                cancel-button := LoomButton {
                    label: "Cancel";
                    variant: "secondary";
                    width: self.preferred-width;
                    height: Theme.tokens.metrics.control-height;
                    x: Theme.rtl
                        ? create-button.x + create-button.width + Theme.tokens.space.lg
                        : create-button.x - Theme.tokens.space.lg - self.width;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.cancel-template(); }
                }

                create-button := LoomButton {
                    label: "Create Document";
                    variant: "primary";
                    width: self.preferred-width;
                    height: Theme.tokens.metrics.control-height;
                    x: Theme.rtl ? Theme.tokens.space.xl : parent.width - Theme.tokens.space.xl - self.width;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.create-template(root.template-selected); }
                }

                Text {
                    text: "Escape to cancel • Return to create";
                    font-size: Theme.type.caption;
                    color: Theme.palette().ink-secondary;
                    x: Theme.rtl ? cancel-button.x + cancel-button.width + Theme.tokens.space.lg : Theme.tokens.space.xl;
                    width: Theme.rtl
                        ? max(0px, parent.width - Theme.tokens.space.xl - self.x)
                        : max(0px, cancel-button.x - Theme.tokens.space.lg - Theme.tokens.space.xl);
                    height: parent.height;
                    horizontal-alignment: Theme.rtl ? right : left;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
    }
}
