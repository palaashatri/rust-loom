/// Capability state shared by Writer's alignment controls.
export global WriterFormatState {
    // 0 left, 1 center, 2 right, 3 justify; -1 when Start/End is active.
    in-out property <int> text-alignment: 0;
    // 0 Start, 1 End, -1 for a physical alignment or a mixed selection.
    in-out property <int> logical-alignment: -1;
    // 0 Automatic, 1 LTR, 2 RTL, -1 when the selection is mixed.
    in-out property <int> paragraph-direction: 0;
    in-out property <bool> justify-available: false;
    in-out property <bool> paragraph-formatting-available: false;
    in-out property <bool> inline-formatting-available: false;
    in-out property <bool> color-formatting-available: false;
    in-out property <bool> superscript-selected: false;
    in-out property <bool> superscript-mixed: false;
    in-out property <bool> subscript-selected: false;
    in-out property <bool> subscript-mixed: false;
    in-out property <string> foreground-color: "";
    in-out property <bool> foreground-color-mixed: false;
    in-out property <bool> color-dialog-open: false;
    in-out property <string> color-input: "";
    in-out property <string> color-error: "";

    callback select-direction(int);
    callback select-logical-alignment(int);
    callback toggle-superscript;
    callback toggle-subscript;
    callback open-foreground-color;
    callback apply-foreground-color;
    callback cancel-foreground-color;
    callback clear-foreground-color-error;
}
