import { LoomColorSwatch } from "foundation.slint";

/// Capability state shared by Writer's alignment controls.
export global WriterFormatState {
    // 0 left, 1 center, 2 right, 3 justify; -1 when Start/End is active.
    in-out property <int> text-alignment: 0;
    // 0 Start, 1 End, -1 for a physical alignment or a mixed selection.
    in-out property <int> logical-alignment: -1;
    // 0 Automatic, 1 LTR, 2 RTL, -1 when the selection is mixed.
    in-out property <int> paragraph-direction: 0;
    in-out property <bool> justify-available: false;
    in-out property <bool> paragraph-formatting-available: false;
    in-out property <bool> inline-formatting-available: false;
    in-out property <bool> color-formatting-available: false;
    in-out property <bool> superscript-selected: false;
    in-out property <bool> superscript-mixed: false;
    in-out property <bool> subscript-selected: false;
    in-out property <bool> subscript-mixed: false;
    in-out property <string> foreground-color: "";
    in-out property <bool> foreground-color-mixed: false;
    // The shared 48-color palette, filled from `loom_ui::color_palette`.
    in-out property <[LoomColorSwatch]> color-swatches: [];
    in-out property <bool> color-palette-open: false;
    // Selected color as `#RRGGBB`, empty for Automatic or a mixed selection.
    in-out property <string> foreground-color-value: "";
    // The swatch drawn in the color well; meaningful when the value is not empty.
    in-out property <color> foreground-color-swatch: #000000;
    // Swatch name, `#RRGGBB`, "Automatic" or "Mixed".
    in-out property <string> foreground-color-label: "Automatic";
    in-out property <bool> color-dialog-open: false;
    in-out property <string> color-input: "";
    in-out property <string> color-error: "";
    in-out property <int> list-marker-index: 0;

    callback select-direction(int);
    callback select-logical-alignment(int);
    callback toggle-superscript;
    callback toggle-subscript;
    callback open-foreground-color;
    callback select-foreground-color(string);
    callback reset-foreground-color;
    callback apply-foreground-color;
    callback cancel-foreground-color;
    callback clear-foreground-color-error;
    callback select-list-marker(int);
    callback apply-list-preset(int, int);
    in-out property <bool> format-painter-active: false;
    in-out property <bool> format-painter-locked: false;
    callback format-painter-copy;
    callback format-painter-copy-locked;
    callback format-painter-apply;
    in-out property <bool> hyperlink-open: false;
    in-out property <string> hyperlink-url: "";
    in-out property <string> hyperlink-tooltip: "";
    in-out property <string> hyperlink-error: "";
    in-out property <bool> hyperlink-has-existing: false;
    callback hyperlink-open-requested();
    callback hyperlink-apply(string, string);
    callback hyperlink-remove();
    callback hyperlink-cancel();
    callback insert-toc();
    in-out property <bool> show-ruler: false;
    in-out property <length> page-width-px: 612px;
    in-out property <length> margin-left-px: 72px;
    in-out property <length> margin-right-px: 72px;
    in-out property <string> watermark-text: "";
    callback set-watermark-text(string);
}
