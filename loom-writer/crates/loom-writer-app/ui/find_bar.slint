import { LoomButton, LoomTextField, LoomToggle, LocalMenu } from "foundation.slint";
import { Theme } from "theme.slint";

/// One page-space rectangle of a find match that is not the current match
/// (page points, from the top-left of the page content area).
export struct FindRect {
    x: length,
    y: length,
    width: length,
    height: length,
}

/// Find and replace state shared between the window and the controller. A
/// global keeps it out of the window's own property and callback lists.
export global FindBar {
    in-out property <bool> open: false;
    in-out property <bool> show-replace: false;
    in-out property <string> query: "";
    in-out property <string> replacement: "";
    in-out property <string> status: "";
    /// Case-sensitive matching.
    in-out property <bool> match-case: false;
    /// Secondary highlights for every match but the current one; empty while
    /// the bar is closed.
    in-out property <[FindRect]> match-rects: [];
    /// Raised each time the bar is asked for, so an open bar takes focus again.
    in-out property <int> focus-tick: 0;
    /// Raised when the bar closes, so the page takes focus back.
    in-out property <int> page-focus-tick: 0;
    /// Ctrl+F (false) or Ctrl+H (true) was pressed.
    callback open-requested(bool);
    callback query-changed(string);
    callback find-next;
    callback find-previous;
    callback close;
    callback replace-current;
    callback replace-all;
    /// Alt+letter or F10 pressed in the bar: open this in-window menu.
    callback menu-requested(int);
}

/// The find bar: a field with Previous and Next, and an optional replace row.
export component FindBarOverlay inherits Rectangle {
    in property <int> focus-tick: FindBar.focus-tick;

    width: 480px * max(1.0, Theme.text-scale);
    // At large text the action buttons move to their own row instead of
    // squeezing the field.
    property <bool> stacked: Theme.text-scale > 1.25;
    height: layout.preferred-height + 2 * Theme.tokens.space.sm;
    background: Theme.palette().surface-raised;
    border-width: 1px;
    border-color: Theme.palette().border-strong;
    border-radius: Theme.tokens.metrics.radius-medium;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Theme.palette().shadow;
    accessible-role: groupbox;
    accessible-label: "Find and replace";

    FocusScope {
        // Shift+Enter steps back. The text field takes Enter for itself, so this
        // looks at the key before the field does.
        capture-key-pressed(event) => {
            let target = LocalMenu.target(event);
            if (target >= 0) { FindBar.menu-requested(target); return accept; }
            if (event.text == Key.Return && event.modifiers.shift) { FindBar.find-previous(); return accept; }
            return reject;
        }
        // Escape closes the bar wherever focus is inside it.
        key-pressed(event) => {
            if (event.text == Key.Escape) { FindBar.close(); return accept; }
            if (event.text == Key.F3) {
                if (event.modifiers.shift) { FindBar.find-previous(); } else { FindBar.find-next(); }
                return accept;
            }
            return reject;
        }

    layout := VerticalLayout {
        padding: Theme.tokens.space.sm;
        spacing: Theme.tokens.space.xs;

        // The field comes first at the reading start, then the match count and
        // the Previous, Next and Done buttons: the exact mirror image in RTL.
        if !Theme.rtl : HorizontalLayout {
            spacing: Theme.tokens.space.xs;
            LoomTextField {
                label: "Find";
                placeholder: "Find in document";
                value <=> FindBar.query;
                focus-request: root.focus-tick;
                init => { self.focus-input(); }
                edited(text) => { FindBar.query-changed(text); }
                accepted(text) => { FindBar.find-next(); }
                cancelled => { FindBar.close(); }
            }
            Text {
                text: FindBar.status;
                min-width: 84px * max(1.0, Theme.text-scale);
                font-size: Theme.type.caption;
                color: Theme.palette().ink-secondary;
                vertical-alignment: center;
                horizontal-alignment: center;
                accessible-role: text;
                accessible-label: "Find results";
                accessible-live-region: AccessibleLiveness.polite;
            }
            if !root.stacked : LoomButton { label: "Previous"; variant: "ghost"; clicked => { FindBar.find-previous(); } }
            if !root.stacked : LoomButton { label: "Next"; variant: "ghost"; clicked => { FindBar.find-next(); } }
            if !root.stacked : LoomButton { label: "Done"; variant: "ghost"; clicked => { FindBar.close(); } }
        }
        if Theme.rtl : HorizontalLayout {
            spacing: Theme.tokens.space.xs;
            if !root.stacked : LoomButton { label: "Done"; variant: "ghost"; clicked => { FindBar.close(); } }
            if !root.stacked : LoomButton { label: "Next"; variant: "ghost"; clicked => { FindBar.find-next(); } }
            if !root.stacked : LoomButton { label: "Previous"; variant: "ghost"; clicked => { FindBar.find-previous(); } }
            Text {
                text: FindBar.status;
                min-width: 84px * max(1.0, Theme.text-scale);
                font-size: Theme.type.caption;
                color: Theme.palette().ink-secondary;
                vertical-alignment: center;
                horizontal-alignment: center;
                accessible-role: text;
                accessible-label: "Find results";
                accessible-live-region: AccessibleLiveness.polite;
            }
            LoomTextField {
                label: "Find";
                placeholder: "Find in document";
                value <=> FindBar.query;
                focus-request: root.focus-tick;
                init => { self.focus-input(); }
                edited(text) => { FindBar.query-changed(text); }
                accepted(text) => { FindBar.find-next(); }
                cancelled => { FindBar.close(); }
            }
        }
        if root.stacked && !Theme.rtl : HorizontalLayout {
            spacing: Theme.tokens.space.xs;
            alignment: end;
            LoomButton { label: "Previous"; variant: "ghost"; clicked => { FindBar.find-previous(); } }
            LoomButton { label: "Next"; variant: "ghost"; clicked => { FindBar.find-next(); } }
            LoomButton { label: "Done"; variant: "ghost"; clicked => { FindBar.close(); } }
        }
        if root.stacked && Theme.rtl : HorizontalLayout {
            spacing: Theme.tokens.space.xs;
            alignment: start;
            LoomButton { label: "Done"; variant: "ghost"; clicked => { FindBar.close(); } }
            LoomButton { label: "Next"; variant: "ghost"; clicked => { FindBar.find-next(); } }
            LoomButton { label: "Previous"; variant: "ghost"; clicked => { FindBar.find-previous(); } }
        }

        LoomToggle {
            label: "Match case";
            checked: FindBar.match-case;
            toggled(value) => {
                FindBar.match-case = value;
                FindBar.query-changed(FindBar.query);
            }
        }

        if FindBar.show-replace && !Theme.rtl : HorizontalLayout {
            spacing: Theme.tokens.space.xs;
            LoomTextField {
                label: "Replace with";
                placeholder: "Replace with";
                value <=> FindBar.replacement;
                accepted(text) => { FindBar.replace-current(); }
                cancelled => { FindBar.close(); }
            }
            if !root.stacked : LoomButton { label: "Replace"; variant: "ghost"; clicked => { FindBar.replace-current(); } }
            if !root.stacked : LoomButton { label: "Replace all"; variant: "ghost"; clicked => { FindBar.replace-all(); } }
        }
        if FindBar.show-replace && Theme.rtl : HorizontalLayout {
            spacing: Theme.tokens.space.xs;
            if !root.stacked : LoomButton { label: "Replace all"; variant: "ghost"; clicked => { FindBar.replace-all(); } }
            if !root.stacked : LoomButton { label: "Replace"; variant: "ghost"; clicked => { FindBar.replace-current(); } }
            LoomTextField {
                label: "Replace with";
                placeholder: "Replace with";
                value <=> FindBar.replacement;
                accepted(text) => { FindBar.replace-current(); }
                cancelled => { FindBar.close(); }
            }
        }
        if FindBar.show-replace && root.stacked && !Theme.rtl : HorizontalLayout {
            spacing: Theme.tokens.space.xs;
            alignment: end;
            LoomButton { label: "Replace"; variant: "ghost"; clicked => { FindBar.replace-current(); } }
            LoomButton { label: "Replace all"; variant: "ghost"; clicked => { FindBar.replace-all(); } }
        }
        if FindBar.show-replace && root.stacked && Theme.rtl : HorizontalLayout {
            spacing: Theme.tokens.space.xs;
            alignment: start;
            LoomButton { label: "Replace all"; variant: "ghost"; clicked => { FindBar.replace-all(); } }
            LoomButton { label: "Replace"; variant: "ghost"; clicked => { FindBar.replace-current(); } }
        }
    }
    }
}
