import {
    LoomPanel, LoomSectionHeader, LoomSegmentedControl, LoomIconButton, LoomButton,
} from "foundation.slint";
import { Icon } from "icons.slint";
import { Theme } from "theme.slint";

export component WriterInspector inherits LoomPanel {
    in-out property <int> inspector-tab: 0;
    in-out property <bool> is-bold: false;
    in-out property <bool> is-italic: false;
    in-out property <bool> is-underline: false;
    in-out property <bool> is-strikethrough: false;
    in-out property <int> heading-level: 0;
    in-out property <int> font-family-index: 0;
    in-out property <int> font-size-pt: 11;
    in-out property <int> text-alignment: 0;
    in-out property <int> line-spacing-index: 1;
    in-out property <int> list-style-index: 0;
    in-out property <int> column-count: 1;
    in-out property <int> margin-preset: 0;
    in-out property <bool> drop-cap-enabled: false;
    in-out property <int> page-orientation: 0;
    in-out property <int> paper-size: 0;
    in property <string> status-left: "";
    in property <int> word-count: 83;
    in property <int> char-count: 507;
    in property <int> page-count: 1;
    in property <int> reading-time-mins: 1;

    callback toggle-bold;
    callback toggle-italic;
    callback toggle-underline;
    callback toggle-strikethrough;
    callback select-heading(int);
    callback select-font-family(int);
    callback increase-font-size;
    callback decrease-font-size;
    callback select-alignment(int);
    callback indent-text;
    callback outdent-text;
    callback select-line-spacing(int);
    callback select-list-style(int);
    callback select-columns(int);
    callback select-margins(int);
    callback toggle-drop-cap;
    callback select-orientation(int);
    callback select-paper-size(int);

    title: "Format";
    width: 290px;

    VerticalLayout {
        spacing: Theme.tokens.space.md;
        padding: Theme.tokens.space.md;
        alignment: start;

        LoomSegmentedControl {
            items: ["Style", "Layout", "More"];
            current <=> root.inspector-tab;
            label: "Format Tabs";
        }

        // TAB 0: STYLE
        if root.inspector-tab == 0 : VerticalLayout {
            spacing: Theme.tokens.space.md;

            LoomSectionHeader { title: "Paragraph Style"; }

            LoomSegmentedControl {
                items: ["Body", "Title", "Sub", "H1", "H2", "H3"];
                current <=> root.heading-level;
                label: "Heading Style";
                selected(idx) => { root.select-heading(idx); }
            }

            LoomSectionHeader { title: "Font & Size"; }

            HorizontalLayout {
                spacing: Theme.tokens.space.sm;
                cross-axis-alignment: center;

                LoomSegmentedControl {
                    horizontal-stretch: 1;
                    items: ["Sans", "Serif", "Mono"];
                    current <=> root.font-family-index;
                    label: "Font Family";
                    selected(idx) => { root.select-font-family(idx); }
                }

                // Font size stepper
                Rectangle {
                    width: 104px;
                    height: 32px;
                    border-radius: Theme.tokens.metrics.radius-medium;
                    border-width: 1px;
                    border-color: Theme.palette().border;
                    background: Theme.palette().surface-raised;

                    HorizontalLayout {
                        spacing: 2px;
                        padding-left: 4px;
                        padding-right: 4px;
                        cross-axis-alignment: center;

                        LoomIconButton {
                            icon: "minus";
                            label: "Smaller";
                            tooltip: "Decrease font size";
                            clicked => { root.decrease-font-size(); }
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: root.font-size-pt + " pt";
                            font-size: Theme.tokens.typography.caption;
                            font-weight: 600;
                            color: Theme.palette().ink;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        LoomIconButton {
                            icon: "plus";
                            label: "Larger";
                            tooltip: "Increase font size";
                            clicked => { root.increase-font-size(); }
                        }
                    }
                }
            }

            // Character styles row
            HorizontalLayout {
                spacing: Theme.tokens.space.xs;
                alignment: start;

                LoomIconButton {
                    icon: "bold";
                    label: "Bold";
                    tooltip: "Bold (Cmd+B)";
                    selected: root.is-bold;
                    clicked => { root.toggle-bold(); }
                }
                LoomIconButton {
                    icon: "italic";
                    label: "Italic";
                    tooltip: "Italic (Cmd+I)";
                    selected: root.is-italic;
                    clicked => { root.toggle-italic(); }
                }
                LoomIconButton {
                    icon: "underline";
                    label: "Underline";
                    tooltip: "Underline (Cmd+U)";
                    selected: root.is-underline;
                    clicked => { root.toggle-underline(); }
                }
                LoomIconButton {
                    icon: "strikethrough";
                    label: "Strikethrough";
                    tooltip: "Strikethrough";
                    selected: root.is-strikethrough;
                    clicked => { root.toggle-strikethrough(); }
                }
            }

            LoomSectionHeader { title: "Alignment & Spacing"; }

            HorizontalLayout {
                spacing: Theme.tokens.space.sm;

                LoomSegmentedControl {
                    horizontal-stretch: 1;
                    items: ["Left", "Center", "Right", "Justify"];
                    current <=> root.text-alignment;
                    label: "Text Alignment";
                    selected(idx) => { root.select-alignment(idx); }
                }

                HorizontalLayout {
                    spacing: Theme.tokens.space.xs;

                    LoomIconButton {
                        icon: "outdent";
                        label: "Outdent";
                        tooltip: "Decrease Indent";
                        clicked => { root.outdent-text(); }
                    }
                    LoomIconButton {
                        icon: "indent";
                        label: "Indent";
                        tooltip: "Increase Indent";
                        clicked => { root.indent-text(); }
                    }
                }
            }

            HorizontalLayout {
                spacing: Theme.tokens.space.sm;
                cross-axis-alignment: center;

                Text {
                    text: "Line Spacing:";
                    font-size: Theme.tokens.typography.caption;
                    color: Theme.palette().ink-secondary;
                }

                LoomSegmentedControl {
                    horizontal-stretch: 1;
                    items: ["1.0", "1.15", "1.5", "2.0"];
                    current <=> root.line-spacing-index;
                    label: "Line Spacing";
                    selected(idx) => { root.select-line-spacing(idx); }
                }
            }

            LoomSectionHeader { title: "Lists"; }

            LoomSegmentedControl {
                items: ["None", "Bulleted", "Numbered"];
                current <=> root.list-style-index;
                label: "List Style";
                selected(idx) => { root.select-list-style(idx); }
            }
        }

        // TAB 1: LAYOUT
        if root.inspector-tab == 1 : VerticalLayout {
            spacing: Theme.tokens.space.md;

            LoomSectionHeader { title: "Document Columns"; }

            LoomSegmentedControl {
                items: ["1 Column", "2 Columns", "3 Columns"];
                current: root.column-count - 1;
                label: "Columns";
                selected(idx) => { root.select-columns(idx + 1); }
            }

            LoomSectionHeader { title: "Page Margins"; }

            LoomSegmentedControl {
                items: ["Normal", "Narrow", "Wide"];
                current <=> root.margin-preset;
                label: "Margins";
                selected(idx) => { root.select-margins(idx); }
            }

            LoomSectionHeader { title: "Page Orientation"; }

            LoomSegmentedControl {
                items: ["Portrait", "Landscape"];
                current <=> root.page-orientation;
                label: "Orientation";
                selected(idx) => { root.select-orientation(idx); }
            }

            LoomSectionHeader { title: "Paper Size"; }

            LoomSegmentedControl {
                items: ["US Letter", "A4"];
                current <=> root.paper-size;
                label: "Paper Size";
                selected(idx) => { root.select-paper-size(idx); }
            }
        }

        // TAB 2: MORE
        if root.inspector-tab == 2 : VerticalLayout {
            spacing: Theme.tokens.space.md;

            LoomSectionHeader { title: "Typography Features"; }

            HorizontalLayout {
                cross-axis-alignment: center;
                Text {
                    horizontal-stretch: 1;
                    text: "Drop Cap";
                    font-size: Theme.tokens.typography.body;
                    color: Theme.palette().ink;
                }
                LoomButton {
                    label: root.drop-cap-enabled ? "Enabled" : "Disabled";
                    variant: root.drop-cap-enabled ? "primary" : "secondary";
                    clicked => { root.toggle-drop-cap(); }
                }
            }

            LoomSectionHeader { title: "Document Metrics"; }

            // Rich document metrics summary card
            Rectangle {
                border-radius: Theme.tokens.metrics.radius-medium;
                background: Theme.palette().surface-sunken;
                border-width: 1px;
                border-color: Theme.palette().border;

                VerticalLayout {
                    padding: Theme.tokens.space.md;
                    spacing: Theme.tokens.space.sm;

                    HorizontalLayout {
                        Text { text: "Pages:"; font-size: Theme.tokens.typography.caption; color: Theme.palette().ink-secondary; horizontal-stretch: 1; }
                        Text { text: root.page-count + ""; font-size: Theme.tokens.typography.caption; font-weight: 600; color: Theme.palette().ink; }
                    }
                    HorizontalLayout {
                        Text { text: "Words:"; font-size: Theme.tokens.typography.caption; color: Theme.palette().ink-secondary; horizontal-stretch: 1; }
                        Text { text: root.word-count + ""; font-size: Theme.tokens.typography.caption; font-weight: 600; color: Theme.palette().ink; }
                    }
                    HorizontalLayout {
                        Text { text: "Characters:"; font-size: Theme.tokens.typography.caption; color: Theme.palette().ink-secondary; horizontal-stretch: 1; }
                        Text { text: root.char-count + ""; font-size: Theme.tokens.typography.caption; font-weight: 600; color: Theme.palette().ink; }
                    }
                    HorizontalLayout {
                        Text { text: "Reading Time:"; font-size: Theme.tokens.typography.caption; color: Theme.palette().ink-secondary; horizontal-stretch: 1; }
                        Text { text: "~" + root.reading-time-mins + " min"; font-size: Theme.tokens.typography.caption; font-weight: 600; color: Theme.palette().ink; }
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; background: transparent; }

        // Persistent bottom document status card
        Rectangle {
            height: 52px;
            border-radius: Theme.tokens.metrics.radius-medium;
            background: Theme.palette().surface-sunken;
            border-width: 1px;
            border-color: Theme.palette().border;

            VerticalLayout {
                padding-left: Theme.tokens.space.md;
                padding-right: Theme.tokens.space.md;
                spacing: 2px;
                alignment: center;

                Text {
                    text: root.word-count + " words • " + root.char-count + " characters";
                    font-size: Theme.tokens.typography.caption;
                    font-weight: 600;
                    color: Theme.palette().ink;
                }
                Text {
                    text: root.status-left != "" ? root.status-left : "Page 1 of " + root.page-count;
                    font-size: Theme.tokens.typography.micro;
                    color: Theme.palette().ink-secondary;
                    overflow: elide;
                }
            }
        }
    }
}
