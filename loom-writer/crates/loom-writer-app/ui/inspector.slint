import {
    LoomPanel, LoomSectionHeader, LoomSegmentedControl, LoomIconButton, LoomButton,
    LoomTextField,
} from "foundation.slint";
import { Icon } from "icons.slint";
import { Theme } from "theme.slint";

/// One anchored comment thread shown in the format inspector.
export struct WriterCommentEntry {
    id: string,
    author: string,
    body: string,
    resolved: bool,
    orphaned: bool,
}

export component WriterInspector inherits LoomPanel {
    in-out property <bool> is-bold: false;
    in-out property <bool> is-italic: false;
    in-out property <bool> is-underline: false;
    in-out property <bool> is-strikethrough: false;
    in-out property <int> heading-level: 0;
    in-out property <int> font-family-index: 0;
    in-out property <int> font-size-pt: 11;
    in-out property <int> text-alignment: 0;
    in-out property <int> line-spacing-index: 1;
    in-out property <int> page-paper-index: 0;
    in-out property <int> page-orientation-index: 0;
    in-out property <int> page-margins-index: 0;
    in-out property <int> list-style-index: 0;
    in property <[WriterCommentEntry]> comment-entries: [];
    in property <bool> active: false;
    /// 0 = Format, 1 = Document (page setup and comments).
    in-out property <int> inspector-tab: 0;
    /// Set to put the keyboard caret in the new-comment field.
    in-out property <bool> comment-focus-pending: false;
    /// Set once at launch so the first automatic open does not take focus.
    in-out property <bool> quiet-open: false;
    in-out property <string> comment-draft: "";
    in property <string> status-left: "";
    in property <int> word-count: 83;
    in property <int> char-count: 507;
    in property <int> page-count: 1;
    in property <int> reading-time-mins: 0;

    callback toggle-bold;
    callback toggle-italic;
    callback toggle-underline;
    callback toggle-strikethrough;
    callback select-heading(int);
    callback select-font-family(int);
    callback increase-font-size;
    callback decrease-font-size;
    callback select-alignment(int);
    callback indent-text;
    callback outdent-text;
    callback select-line-spacing(int);
    callback select-paper-size(int);
    callback select-orientation(int);
    callback select-margins(int);
    callback select-list-style(int);
    callback add-comment(string);
    callback set-comment-resolved(string, bool);
    callback delete-comment(string);
    callback navigate-comment(string);
    callback close-requested;

    public function focus-first-control() {
        tab-control.grab-focus();
    }

    // Opening the inspector moves focus into it (a user action). Startup returns
    // focus to the page afterwards, so no ring is drawn at launch.
    changed active => {
        if (root.active && !root.comment-focus-pending && !root.quiet-open) {
            tab-control.grab-focus();
        }
        if (root.active) { root.quiet-open = false; }
    }

    width: 320px;

    // Content scrolls; the panel never grows past the window height, so the
    // status bar below always stays fully visible.
    inspector-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (root.active && event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            width: parent.width;
            height: parent.height;
            spacing: Theme.tokens.space.md;

            // The tabs fill the row and the close button sits at the reading end:
            // right in LTR, left in RTL.
            Rectangle {
                height: Theme.scaled-control-height;
                tab-control := LoomSegmentedControl {
                    x: (Theme.rtl ? close-button.width + Theme.tokens.space.sm : 0px) + Theme.tokens.space.xl;
                    y: 0px;
                    width: parent.width - close-button.width - Theme.tokens.space.sm - 2 * Theme.tokens.space.xl;
                    items: ["Format", "Document"];
                    current <=> root.inspector-tab;
                    label: "Inspector tab";
                }
                close-button := LoomIconButton {
                    x: Theme.rtl ? Theme.tokens.space.xl : parent.width - self.width - Theme.tokens.space.xl;
                    y: (parent.height - self.height) / 2;
                    icon: "close";
                    label: "Close inspector";
                    tooltip: "Close inspector";
                    clicked => { root.close-requested(); }
                }
            }

            Flickable {
                vertical-stretch: 1;
                viewport-width: self.width;
                viewport-height: max(self.height, content.preferred-height);

        content := VerticalLayout {
            spacing: Theme.tokens.space.md;
            padding-top: Theme.tokens.space.md;
            padding-bottom: Theme.tokens.space.md;
            alignment: start;

            if root.inspector-tab == 0 : VerticalLayout {
                spacing: Theme.tokens.space.md;

            LoomSectionHeader { title: "Paragraph Style"; }

            VerticalLayout {
                padding-left: Theme.tokens.space.xl;
                padding-right: Theme.tokens.space.xl;
            heading-control := LoomSegmentedControl {
                items: ["Body", "H1", "H2", "H3"];
                current <=> root.heading-level;
                label: "Heading Style";
                selected(idx) => { root.select-heading(idx); }
            }
            }

            LoomSectionHeader { title: "Font & Size"; }

            // The font family fills the row; the size stepper sits at the reading end.
            VerticalLayout {
                padding-left: Theme.tokens.space.xl;
                padding-right: Theme.tokens.space.xl;
            Rectangle {
                height: max(32px, Theme.scaled-control-height);
                LoomSegmentedControl {
                    x: Theme.rtl ? font-stepper.width + Theme.tokens.space.sm : 0px;
                    y: (parent.height - self.height) / 2;
                    width: parent.width - font-stepper.width - Theme.tokens.space.sm;
                    items: ["Sans", "Serif", "Mono"];
                    current <=> root.font-family-index;
                    label: "Font Family";
                    selected(idx) => { root.select-font-family(idx); }
                }

                // Font size stepper
                font-stepper := Rectangle {
                    x: Theme.rtl ? 0px : parent.width - self.width;
                    y: (parent.height - self.height) / 2;
                    width: 104px;
                    height: 32px;
                    border-radius: Theme.tokens.metrics.radius-medium;
                    border-width: 1px;
                    border-color: Theme.palette().border;
                    background: Theme.palette().surface-raised;

                    if !Theme.rtl : HorizontalLayout {
                        spacing: 2px;
                        padding-left: 4px;
                        padding-right: 4px;
                        cross-axis-alignment: center;

                        LoomIconButton {
                            icon: "minus";
                            label: "Smaller";
                            tooltip: "Decrease font size";
                            clicked => { root.decrease-font-size(); }
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: root.font-size-pt + " pt";
                            font-size: Theme.type.caption;
                            font-weight: 600;
                            color: Theme.palette().ink;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        LoomIconButton {
                            icon: "plus";
                            label: "Larger";
                            tooltip: "Increase font size";
                            clicked => { root.increase-font-size(); }
                        }
                    }
                    if Theme.rtl : HorizontalLayout {
                        spacing: 2px;
                        padding-left: 4px;
                        padding-right: 4px;
                        cross-axis-alignment: center;

                        LoomIconButton {
                            icon: "plus";
                            label: "Larger";
                            tooltip: "Increase font size";
                            clicked => { root.increase-font-size(); }
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: root.font-size-pt + " pt";
                            font-size: Theme.type.caption;
                            font-weight: 600;
                            color: Theme.palette().ink;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        LoomIconButton {
                            icon: "minus";
                            label: "Smaller";
                            tooltip: "Decrease font size";
                            clicked => { root.decrease-font-size(); }
                        }
                    }
                }
            }
            }

            // Character styles row, from the reading-start edge: Bold sits at the
            // left in LTR and at the right in RTL.
            if !Theme.rtl : HorizontalLayout {
                spacing: Theme.tokens.space.xs;
                alignment: start;
                padding-left: Theme.tokens.space.xl;
                padding-right: Theme.tokens.space.xl;

                LoomIconButton {
                    icon: "bold";
                    label: "Bold";
                    tooltip: "Bold (Cmd+B)";
                    selected: root.is-bold;
                    clicked => { root.toggle-bold(); }
                }
                LoomIconButton {
                    icon: "italic";
                    label: "Italic";
                    tooltip: "Italic (Cmd+I)";
                    selected: root.is-italic;
                    clicked => { root.toggle-italic(); }
                }
                LoomIconButton {
                    icon: "underline";
                    label: "Underline";
                    tooltip: "Underline (Cmd+U)";
                    selected: root.is-underline;
                    clicked => { root.toggle-underline(); }
                }
                LoomIconButton {
                    icon: "strikethrough";
                    label: "Strikethrough";
                    tooltip: "Strikethrough";
                    selected: root.is-strikethrough;
                    clicked => { root.toggle-strikethrough(); }
                }
            }
            if Theme.rtl : HorizontalLayout {
                spacing: Theme.tokens.space.xs;
                alignment: end;
                padding-left: Theme.tokens.space.xl;
                padding-right: Theme.tokens.space.xl;

                LoomIconButton {
                    icon: "strikethrough";
                    label: "Strikethrough";
                    tooltip: "Strikethrough";
                    selected: root.is-strikethrough;
                    clicked => { root.toggle-strikethrough(); }
                }
                LoomIconButton {
                    icon: "underline";
                    label: "Underline";
                    tooltip: "Underline (Cmd+U)";
                    selected: root.is-underline;
                    clicked => { root.toggle-underline(); }
                }
                LoomIconButton {
                    icon: "italic";
                    label: "Italic";
                    tooltip: "Italic (Cmd+I)";
                    selected: root.is-italic;
                    clicked => { root.toggle-italic(); }
                }
                LoomIconButton {
                    icon: "bold";
                    label: "Bold";
                    tooltip: "Bold (Cmd+B)";
                    selected: root.is-bold;
                    clicked => { root.toggle-bold(); }
                }
            }

            LoomSectionHeader { title: "Alignment & Spacing"; }

            // Alignment fills the row; the two indent buttons sit at the reading end.
            VerticalLayout {
                padding-left: Theme.tokens.space.xl;
                padding-right: Theme.tokens.space.xl;
            Rectangle {
                height: Theme.scaled-control-height;
                LoomSegmentedControl {
                    x: Theme.rtl ? indent-pair.width + Theme.tokens.space.sm : 0px;
                    y: 0px;
                    width: parent.width - indent-pair.width - Theme.tokens.space.sm;
                    // Justified lines are not drawn by the page editor, so there is no Justify option.
                    items: ["Left", "Center", "Right"];
                    current <=> root.text-alignment;
                    label: "Text Alignment";
                    selected(idx) => { root.select-alignment(idx); }
                }

                indent-pair := Rectangle {
                    x: Theme.rtl ? 0px : parent.width - self.width;
                    y: (parent.height - self.height) / 2;
                    width: 2 * Theme.tokens.metrics.control-height + Theme.tokens.space.xs;
                    height: Theme.tokens.metrics.control-height;

                    if !Theme.rtl : HorizontalLayout {
                        spacing: Theme.tokens.space.xs;
                        LoomIconButton {
                            icon: "outdent";
                            label: "Outdent";
                            tooltip: "Decrease Indent";
                            clicked => { root.outdent-text(); }
                        }
                        LoomIconButton {
                            icon: "indent";
                            label: "Indent";
                            tooltip: "Increase Indent";
                            clicked => { root.indent-text(); }
                        }
                    }
                    if Theme.rtl : HorizontalLayout {
                        spacing: Theme.tokens.space.xs;
                        LoomIconButton {
                            icon: "indent";
                            label: "Indent";
                            tooltip: "Increase Indent";
                            clicked => { root.indent-text(); }
                        }
                        LoomIconButton {
                            icon: "outdent";
                            label: "Outdent";
                            tooltip: "Decrease Indent";
                            clicked => { root.outdent-text(); }
                        }
                    }
                }
            }
            }

            // The caption sits at the reading-start edge, the choices fill the rest.
            VerticalLayout {
                padding-left: Theme.tokens.space.xl;
                padding-right: Theme.tokens.space.xl;
            // Line spacing: the label sits above the strip, and the strip ends where the
            // alignment strip above ends, so the two rows share their far edge.
            Text {
                text: "Line Spacing";
                font-size: Theme.type.body;
                color: Theme.palette().ink;
                horizontal-alignment: Theme.rtl ? right : left;
            }

            Rectangle {
                height: Theme.scaled-control-height;
                LoomSegmentedControl {
                    x: Theme.rtl ? indent-pair.width + Theme.tokens.space.sm : 0px;
                    y: 0px;
                    width: parent.width - indent-pair.width - Theme.tokens.space.sm;
                    items: ["1.0", "1.15", "1.5", "2.0"];
                    current <=> root.line-spacing-index;
                    label: "Line Spacing";
                    selected(idx) => { root.select-line-spacing(idx); }
                }
            }
            }

            LoomSectionHeader { title: "Lists"; }

            VerticalLayout {
                padding-left: Theme.tokens.space.xl;
                padding-right: Theme.tokens.space.xl;
            LoomSegmentedControl {
                items: ["None", "Bulleted", "Numbered"];
                current <=> root.list-style-index;
                label: "List Style";
                selected(idx) => { root.select-list-style(idx); }
            }
            }
            }

            if root.inspector-tab == 1 : VerticalLayout {
                spacing: Theme.tokens.space.md;
                property <bool> focus-pending: root.comment-focus-pending;
                init => { if (root.active && root.comment-focus-pending) { comment-field.focus-input(); root.comment-focus-pending = false; } }
                changed focus-pending => { if (root.active && root.comment-focus-pending) { comment-field.focus-input(); root.comment-focus-pending = false; } }

            LoomSectionHeader { title: "Comments"; }

            VerticalLayout {
                padding-left: Theme.tokens.space.xl;
                padding-right: Theme.tokens.space.xl;
            comment-field := LoomTextField {
                label: "New comment";
                placeholder: "Comment on the selection…";
                value <=> root.comment-draft;
                accepted(body) => { root.add-comment(body); }
            }
            }

            VerticalLayout {
                padding-left: Theme.tokens.space.xl;
                padding-right: Theme.tokens.space.xl;
            LoomButton {
                label: "Add Comment";
                variant: "secondary";
                enabled: root.comment-draft != "";
                clicked => { root.add-comment(root.comment-draft); }
            }
            }

            for entry in root.comment-entries : Rectangle {
                accessible-role: AccessibleRole.text;
                accessible-label: entry.orphaned
                    ? "Comment by " + entry.author + ", the commented text was removed: " + entry.body
                    : entry.resolved
                        ? "Comment by " + entry.author + ", resolved: " + entry.body
                        : "Comment by " + entry.author + ": " + entry.body;
                border-radius: Theme.tokens.metrics.radius-medium;
                background: entry.resolved
                    ? Theme.palette().surface-sunken
                    : Theme.palette().surface-raised;
                border-width: 1px;
                border-color: Theme.palette().border;

                VerticalLayout {
                    padding: Theme.tokens.space.sm;
                    spacing: Theme.tokens.space.xs;

                    Text {
                        text: entry.orphaned
                            ? entry.author + " · text removed"
                            : entry.resolved
                                ? entry.author + " · resolved"
                                : entry.author;
                        font-size: Theme.type.micro;
                        color: Theme.palette().ink-secondary;
                        horizontal-alignment: Theme.rtl ? right : left;
                    }
                    Text {
                        text: entry.body;
                        font-size: Theme.type.caption;
                        color: Theme.palette().ink;
                        horizontal-alignment: Theme.rtl ? right : left;
                        wrap: word-wrap;
                        overflow: elide;
                    }
                    if !Theme.rtl : HorizontalLayout {
                        spacing: Theme.tokens.space.xs;
                        alignment: start;

                        LoomButton {
                            label: entry.orphaned ? "Text removed" : "Show on page";
                            variant: "secondary";
                            enabled: !entry.orphaned;
                            clicked => { root.navigate-comment(entry.id); }
                        }
                        LoomButton {
                            label: entry.resolved ? "Reopen" : "Resolve";
                            variant: "ghost";
                            clicked => { root.set-comment-resolved(entry.id, !entry.resolved); }
                        }
                        LoomButton {
                            label: "Delete";
                            variant: "ghost";
                            clicked => { root.delete-comment(entry.id); }
                        }
                    }
                    if Theme.rtl : HorizontalLayout {
                        spacing: Theme.tokens.space.xs;
                        alignment: end;

                        LoomButton {
                            label: "Delete";
                            variant: "ghost";
                            clicked => { root.delete-comment(entry.id); }
                        }
                        LoomButton {
                            label: entry.resolved ? "Reopen" : "Resolve";
                            variant: "ghost";
                            clicked => { root.set-comment-resolved(entry.id, !entry.resolved); }
                        }
                        LoomButton {
                            label: entry.orphaned ? "Text removed" : "Show on page";
                            variant: "secondary";
                            enabled: !entry.orphaned;
                            clicked => { root.navigate-comment(entry.id); }
                        }
                    }
                }
            }

            LoomSectionHeader { title: "Page Setup"; }

            VerticalLayout {
                padding-left: Theme.tokens.space.xl;
                padding-right: Theme.tokens.space.xl;
            LoomSegmentedControl {
                items: ["A4", "US Letter"];
                current <=> root.page-paper-index;
                label: "Paper Size";
                selected(idx) => { root.select-paper-size(idx); }
            }
            }

            VerticalLayout {
                padding-left: Theme.tokens.space.xl;
                padding-right: Theme.tokens.space.xl;
            LoomSegmentedControl {
                items: ["Portrait", "Landscape"];
                current <=> root.page-orientation-index;
                label: "Orientation";
                selected(idx) => { root.select-orientation(idx); }
            }
            }

            VerticalLayout {
                padding-left: Theme.tokens.space.xl;
                padding-right: Theme.tokens.space.xl;
            LoomSegmentedControl {
                items: ["Normal", "Narrow", "Wide"];
                current <=> root.page-margins-index;
                label: "Margins";
                selected(idx) => { root.select-margins(idx); }
            }
            }
            }
        }
        }

        // Persistent bottom document status card (pinned below the scroll area)
        HorizontalLayout {
            padding-left: Theme.tokens.space.xl;
            padding-right: Theme.tokens.space.xl;
            padding-bottom: Theme.tokens.space.xl;
            Rectangle {
                height: 52px;
                border-radius: Theme.tokens.metrics.radius-medium;
                background: Theme.palette().surface-sunken;
                border-width: 1px;
                border-color: Theme.palette().border;

                VerticalLayout {
                    padding-left: Theme.tokens.space.md;
                    padding-right: Theme.tokens.space.md;
                    spacing: 2px;
                    alignment: center;

                    Text {
                        text: "Page 1 of " + root.page-count;
                        font-size: Theme.type.caption;
                        font-weight: 600;
                        color: Theme.palette().ink;
                        horizontal-alignment: Theme.rtl ? right : left;
                    }
                    Text {
                        text: root.reading-time-mins > 0 ? ("~" + root.reading-time-mins + " min read") : "";
                        font-size: Theme.type.micro;
                        color: Theme.palette().ink-secondary;
                        horizontal-alignment: Theme.rtl ? right : left;
                        overflow: elide;
                    }
                }
            }
        }
        }
    }
}
