import {
    LoomPanel, LoomSectionHeader, LoomSegmentedControl, LoomIconButton, LoomButton,
    LoomTextField, LoomNumericField,
} from "foundation.slint";
import { Icon } from "icons.slint";
import { Theme } from "theme.slint";
import { WriterFormatState } from "alignment_state.slint";
import { WriterHeaderFooterState } from "writer_header_footer.slint";
import { WriterFormatTab } from "text_formatting.slint";

/// Exact page geometry displayed by Writer's document inspector, in millimeters.
export struct WriterPageGeometry {
    width_mm: float, height_mm: float,
    top_mm: float, bottom_mm: float, left_mm: float, right_mm: float,
    margin_top_pt: float, margin_bottom_pt: float, margin_left_pt: float, margin_right_pt: float,
}

/// One anchored comment thread shown in the format inspector.
export struct WriterCommentEntry {
    id: string,
    author: string,
    body: string,
    resolved: bool,
    orphaned: bool,
}

export component WriterInspector inherits LoomPanel {
    in-out property <bool> is-bold: false;
    in-out property <bool> is-italic: false;
    in-out property <bool> is-underline: false;
    in-out property <bool> is-strikethrough: false;
    // The platform modifier named in shortcut hints ("Ctrl" or "Cmd").
    in property <string> shortcut-modifier: "Ctrl";
    in-out property <int> heading-level: 0;
    in-out property <int> font-size-pt: 11;
    in-out property <string> font-size-value: "11";
    in-out property <int> text-alignment <=> WriterFormatState.text-alignment;
    in-out property <int> line-spacing-index: 1;
    in-out property <int> page-paper-index: 0;
    in-out property <int> page-orientation-index: 0;
    in-out property <int> page-margins-index: 0;
    in property <WriterPageGeometry> page-geometry: {
        width_mm: 210.00, height_mm: 297.00,
        top_mm: 25.40, bottom_mm: 25.40, left_mm: 25.40, right_mm: 25.40,
        margin_top_pt: 72.0, margin_bottom_pt: 72.0, margin_left_pt: 72.0, margin_right_pt: 72.0,
    };
    in-out property <int> list-style-index: 0;
    in property <[WriterCommentEntry]> comment-entries: [];
    in property <bool> active: false;
    /// 0 = Format, 1 = Document (with Page Setup and Review sections).
    in-out property <int> inspector-tab: 0;
    /// 0 = Page Setup, 1 = Review within the Document tab.
    in-out property <int> document-tab: 0;
    /// Set to put the keyboard caret in the new-comment field.
    in-out property <bool> comment-focus-pending: false;
    /// Set by the composer when it takes focus; cleared by the next activation change.
    property <bool> composer-took-focus: false;
    /// Set once at launch so the first automatic open does not take focus.
    in-out property <bool> quiet-open: false;
    in-out property <string> comment-draft: "";
    in property <string> status-left: "";
    in property <int> word-count: 83;
    in property <int> char-count: 507;
    in property <int> page-count: 1;
    property <string> page-summary: root.page-count == 1 ? "1 page" : "" + root.page-count + " pages";
    in property <int> reading-time-mins: 0;

    property <string> page-width-draft: "" + root.page-geometry.width_mm;
    property <string> page-height-draft: "" + root.page-geometry.height_mm;
    property <string> page-top-draft: "" + root.page-geometry.top_mm;
    property <string> page-bottom-draft: "" + root.page-geometry.bottom_mm;
    property <string> page-left-draft: "" + root.page-geometry.left_mm;
    property <string> page-right-draft: "" + root.page-geometry.right_mm;
    property <bool> page-width-invalid: false;
    property <bool> page-height-invalid: false;
    property <bool> page-top-invalid: false;
    property <bool> page-bottom-invalid: false;
    property <bool> page-left-invalid: false;
    property <bool> page-right-invalid: false;
    property <bool> geometry-invalid: page-width-invalid || page-height-invalid || page-top-invalid || page-bottom-invalid || page-left-invalid || page-right-invalid;

    changed page-geometry => {
        page-width-draft = "" + page-geometry.width_mm;
        page-height-draft = "" + page-geometry.height_mm;
        page-top-draft = "" + page-geometry.top_mm;
        page-bottom-draft = "" + page-geometry.bottom_mm;
        page-left-draft = "" + page-geometry.left_mm;
        page-right-draft = "" + page-geometry.right_mm;
        page-width-invalid = false;
        page-height-invalid = false;
        page-top-invalid = false;
        page-bottom-invalid = false;
        page-left-invalid = false;
        page-right-invalid = false;
    }

    callback toggle-bold;
    callback toggle-italic;
    callback toggle-underline;
    callback toggle-strikethrough;
    callback select-heading(int);
    callback increase-font-size;
    callback decrease-font-size;
    callback apply-font-size(string) -> bool;
    callback select-alignment(int);
    callback indent-text;
    callback outdent-text;
    callback select-line-spacing(int);
    callback select-paper-size(int);
    callback select-orientation(int);
    callback select-margins(int);
    callback edit-page-geometry(string, string) -> bool;
    callback select-list-style(int);
    callback add-comment(string);
    callback set-comment-resolved(string, bool);
    callback delete-comment(string);
    callback navigate-comment(string);
    callback close-requested;
    callback f6-pressed(bool);

    in-out property <bool> is-table-selected: false;
    in-out property <string> table-style-id: "table-style-medium-1";
    in-out property <bool> table-header-row: true;
    in-out property <bool> table-banded-rows: true;
    in-out property <bool> table-first-column: false;
    callback set-table-style(string);
    callback toggle-table-option(string);
    callback table-action(string);

    public function focus-first-control() {
        tab-control.grab-focus();
    }

    // Opening the inspector moves focus into it (a user action). Startup returns
    // focus to the page afterwards, so no ring is drawn at launch.
    // The composer's init runs before this handler when the panel opens, so it
    // may already have taken focus; the panel must not take it back.
    changed active => {
        if (root.active && !root.comment-focus-pending && !root.quiet-open && !root.composer-took-focus) {
            tab-control.grab-focus();
        }
        root.composer-took-focus = false;
        if (root.active) { root.quiet-open = false; }
    }

    width: 320px;

    // A 1 px divider on the canvas-side edge in the shared border token: in light
    // theme the panel and the canvas share one fill, so the edge needs its own line.
    Rectangle {
        x: Theme.rtl ? parent.width - self.width : 0px;
        y: 0px;
        width: 1px;
        height: parent.height;
        background: Theme.palette().border;
        accessible-role: none;
    }

    // Content scrolls; the panel never grows past the window height, so the
    // status bar below always stays fully visible.
    inspector-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(event) => {
            if (root.active && event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            // F6 moves on to the page; the inspector is where the cycle is entered from.
            if (root.active && event.text == Key.F6) {
                root.f6-pressed(event.modifiers.shift);
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            width: parent.width;
            height: parent.height;
            spacing: Theme.tokens.space.md;
            // Keeps the tab strip clear of the toolbar divider above the panel.
            padding-top: Theme.tokens.space.md;

            // The tabs fill the row and the close button sits at the reading end:
            // right in LTR, left in RTL.
            Rectangle {
                height: Theme.scaled-control-height;
                tab-control := LoomSegmentedControl {
                    x: (Theme.rtl ? close-button.width + Theme.tokens.space.sm : 0px) + Theme.tokens.space.xl;
                    y: 0px;
                    width: parent.width - close-button.width - Theme.tokens.space.sm - 2 * Theme.tokens.space.xl;
                    items: ["Format", "Document"];
                    current <=> root.inspector-tab;
                    label: "Inspector tab";
                }
                close-button := LoomIconButton {
                    text-scale: Theme.text-scale;
                    x: Theme.rtl ? Theme.tokens.space.xl : parent.width - self.width - Theme.tokens.space.xl;
                    y: (parent.height - self.height) / 2;
                    icon: "close";
                    label: "Close inspector";
                    tooltip: "Close inspector";
                    clicked => { root.close-requested(); }
                }
            }

            Rectangle {
                vertical-stretch: 1;
            inspector-scroll := Flickable {
                width: parent.width;
                height: parent.height;
                viewport-width: self.width;
                viewport-height: max(self.height, content.preferred-height);

        content := VerticalLayout {
            spacing: Theme.tokens.space.md;
            padding-top: Theme.tokens.space.md;
            padding-bottom: Theme.tokens.space.md;
            alignment: start;

            if root.inspector-tab == 0 : WriterFormatTab {
                is-table-selected <=> root.is-table-selected;
                table-style-id <=> root.table-style-id;
                table-header-row <=> root.table-header-row;
                table-banded-rows <=> root.table-banded-rows;
                table-first-column <=> root.table-first-column;
                heading-level <=> root.heading-level;
                font-size-pt <=> root.font-size-pt;
                font-size-value <=> root.font-size-value;
                text-alignment <=> root.text-alignment;
                line-spacing-index <=> root.line-spacing-index;
                list-style-index <=> root.list-style-index;
                is-bold: root.is-bold;
                is-italic: root.is-italic;
                is-underline: root.is-underline;
                is-strikethrough: root.is-strikethrough;
                shortcut-modifier: root.shortcut-modifier;
                set-table-style(id) => { root.set-table-style(id); }
                toggle-table-option(opt) => { root.toggle-table-option(opt); }
                table-action(act) => { root.table-action(act); }
                select-heading(idx) => { root.select-heading(idx); }
                increase-font-size => { root.increase-font-size(); }
                decrease-font-size => { root.decrease-font-size(); }
                apply-font-size(value) => { return root.apply-font-size(value); }
                toggle-bold => { root.toggle-bold(); }
                toggle-italic => { root.toggle-italic(); }
                toggle-underline => { root.toggle-underline(); }
                toggle-strikethrough => { root.toggle-strikethrough(); }
                select-alignment(idx) => { root.select-alignment(idx); }
                indent-text => { root.indent-text(); }
                outdent-text => { root.outdent-text(); }
                select-line-spacing(idx) => { root.select-line-spacing(idx); }
                select-list-style(idx) => { root.select-list-style(idx); }
            }
            if root.inspector-tab == 1 : VerticalLayout {
                spacing: Theme.tokens.space.md;
                VerticalLayout {
                    padding-left: Theme.tokens.space.xl;
                    padding-right: Theme.tokens.space.xl;
                    LoomSegmentedControl {
                        horizontal-stretch: 1;
                        items: ["Page Setup", "Review"];
                        current <=> root.document-tab;
                        label: "Document section";
                    }
                }

            if root.document-tab == 1 : VerticalLayout {
                spacing: Theme.tokens.space.md;
                property <bool> focus-pending: root.comment-focus-pending;
                init => {
                    if (root.active && root.comment-focus-pending) {
                        comment-field.focus-input();
                        root.comment-focus-pending = false;
                        root.composer-took-focus = true;
                    }
                }
                changed focus-pending => {
                    if (root.active && root.comment-focus-pending) {
                        comment-field.focus-input();
                        root.comment-focus-pending = false;
                        root.composer-took-focus = true;
                    }
                }

                LoomSectionHeader { title: "Comments"; }

            VerticalLayout {
                padding-left: Theme.tokens.space.xl;
                padding-right: Theme.tokens.space.xl;
            comment-field := LoomTextField {
                label: "New comment";
                placeholder: "Comment on the selection…";
                value <=> root.comment-draft;
                accepted(body) => { root.add-comment(body); }
            }
            }

            VerticalLayout {
                padding-left: Theme.tokens.space.xl;
                padding-right: Theme.tokens.space.xl;
            LoomButton {
                label: "Add Comment";
                variant: "secondary";
                enabled: root.comment-draft != "";
                clicked => { root.add-comment(root.comment-draft); }
            }
            }

            for entry in root.comment-entries : Rectangle {
                accessible-role: AccessibleRole.text;
                accessible-label: entry.orphaned
                    ? "Comment by " + entry.author + ", the commented text was removed: " + entry.body
                    : entry.resolved
                        ? "Comment by " + entry.author + ", resolved: " + entry.body
                        : "Comment by " + entry.author + ": " + entry.body;
                border-radius: Theme.tokens.metrics.radius-medium;
                background: entry.resolved
                    ? Theme.palette().surface-sunken
                    : Theme.palette().surface-raised;
                border-width: 1px;
                border-color: Theme.palette().border;

                VerticalLayout {
                    padding: Theme.tokens.space.sm;
                    spacing: Theme.tokens.space.xs;

                    Text {
                        text: entry.orphaned
                            ? entry.author + " · text removed"
                            : entry.resolved
                                ? entry.author + " · resolved"
                                : entry.author;
                        font-size: Theme.type.micro;
                        color: Theme.palette().ink-secondary;
                        horizontal-alignment: Theme.rtl ? right : left;
                    }
                    Text {
                        text: entry.body;
                        font-size: Theme.type.caption;
                        color: Theme.palette().ink;
                        horizontal-alignment: Theme.rtl ? right : left;
                        wrap: word-wrap;
                        overflow: elide;
                    }
                    if !Theme.rtl : HorizontalLayout {
                        spacing: Theme.tokens.space.xs;
                        alignment: start;

                        LoomButton {
                            label: entry.orphaned ? "Text removed" : "Show on page";
                            variant: "secondary";
                            enabled: !entry.orphaned;
                            clicked => { root.navigate-comment(entry.id); }
                        }
                        LoomButton {
                            label: entry.resolved ? "Reopen" : "Resolve";
                            variant: "ghost";
                            clicked => { root.set-comment-resolved(entry.id, !entry.resolved); }
                        }
                        LoomButton {
                            label: "Delete";
                            variant: "ghost";
                            clicked => { root.delete-comment(entry.id); }
                        }
                    }
                    if Theme.rtl : HorizontalLayout {
                        spacing: Theme.tokens.space.xs;
                        alignment: end;

                        LoomButton {
                            label: "Delete";
                            variant: "ghost";
                            clicked => { root.delete-comment(entry.id); }
                        }
                        LoomButton {
                            label: entry.resolved ? "Reopen" : "Resolve";
                            variant: "ghost";
                            clicked => { root.set-comment-resolved(entry.id, !entry.resolved); }
                        }
                        LoomButton {
                            label: entry.orphaned ? "Text removed" : "Show on page";
                            variant: "secondary";
                            enabled: !entry.orphaned;
                            clicked => { root.navigate-comment(entry.id); }
                        }
                    }
                }
            }
            }

            if root.document-tab == 0 : VerticalLayout {
                spacing: Theme.tokens.space.md;
            LoomSectionHeader { title: "Page Setup"; }
            LoomButton {
                label: "Headers and Footers";
                variant: "secondary";
                horizontal-stretch: 1;
                clicked => { WriterHeaderFooterState.open-editor(); }
            }

            // Keep the page summary at the start of this independently selected
            // region so comment volume cannot move Page Setup down the inspector.
            HorizontalLayout {
                padding-left: Theme.tokens.space.xl;
                padding-right: Theme.tokens.space.xl;
                padding-bottom: Theme.tokens.space.xl;
                Rectangle {
                    height: 52px;
                    accessible-role: AccessibleRole.text;
                    accessible-label: root.page-summary;
                    border-radius: Theme.tokens.metrics.radius-medium;
                    background: Theme.palette().surface-sunken;
                    border-width: 1px;
                    border-color: Theme.palette().border;

                    VerticalLayout {
                        padding-left: Theme.tokens.space.md;
                        padding-right: Theme.tokens.space.md;
                        spacing: 2px;
                        alignment: center;

                        Text {
                            text: root.page-summary;
                            font-size: Theme.type.caption;
                            font-weight: 600;
                            color: Theme.palette().ink;
                            horizontal-alignment: Theme.rtl ? right : left;
                        }
                    }
                }
            }

            VerticalLayout {
                padding-left: Theme.tokens.space.xl;
                padding-right: Theme.tokens.space.xl;
                spacing: Theme.tokens.space.xs;
                Text {
                    text: "Paper Size";
                    font-size: Theme.type.body;
                    color: Theme.palette().ink;
                    horizontal-alignment: Theme.rtl ? right : left;
                }
            LoomSegmentedControl {
                items: ["A4", "US Letter", "Custom"];
                current <=> root.page-paper-index;
                label: "Paper Size";
                selected(idx) => { root.select-paper-size(idx); }
            }
            }

            VerticalLayout {
                padding-left: Theme.tokens.space.xl;
                padding-right: Theme.tokens.space.xl;
                spacing: Theme.tokens.space.xs;
                Text {
                    text: "Orientation";
                    font-size: Theme.type.body;
                    color: Theme.palette().ink;
                    horizontal-alignment: Theme.rtl ? right : left;
                }
            LoomSegmentedControl {
                items: ["Portrait", "Landscape"];
                current <=> root.page-orientation-index;
                label: "Orientation";
                selected(idx) => { root.select-orientation(idx); }
            }
            }

            VerticalLayout {
                padding-left: Theme.tokens.space.xl;
                padding-right: Theme.tokens.space.xl;
                spacing: Theme.tokens.space.xs;
                Text {
                    text: "Margins";
                    font-size: Theme.type.body;
                    color: Theme.palette().ink;
                    horizontal-alignment: Theme.rtl ? right : left;
                }
            LoomSegmentedControl {
                items: ["Normal", "Narrow", "Wide", "Custom"];
                current <=> root.page-margins-index;
                label: "Margins";
                selected(idx) => { root.select-margins(idx); }
            }
            }

            if root.page-paper-index == 2 : VerticalLayout {
                padding-left: Theme.tokens.space.xl;
                padding-right: Theme.tokens.space.xl;
                spacing: Theme.tokens.space.xs;
                Text {
                    text: "Custom paper size";
                    font-size: Theme.type.body;
                    color: Theme.palette().ink;
                }
                HorizontalLayout {
                    spacing: Theme.tokens.space.xs;
                    LoomNumericField {
                        label: "Page width";
                        description: "25.40–705.56 mm";
                        unit: "mm";
                        value <=> root.page-width-draft;
                        invalid: root.page-width-invalid;
                        edited(_) => { root.page-width-invalid = false; }
                        accepted(value) => { root.page-width-invalid = !root.edit-page-geometry("width", value); }
                        cancelled => { root.page-width-draft = "" + root.page-geometry.width_mm; root.page-width-invalid = false; }
                    }
                    LoomNumericField {
                        label: "Page height";
                        description: "25.40–705.56 mm";
                        unit: "mm";
                        value <=> root.page-height-draft;
                        invalid: root.page-height-invalid;
                        edited(_) => { root.page-height-invalid = false; }
                        accepted(value) => { root.page-height-invalid = !root.edit-page-geometry("height", value); }
                        cancelled => { root.page-height-draft = "" + root.page-geometry.height_mm; root.page-height-invalid = false; }
                    }
                }
            }

            if root.page-margins-index == 3 : VerticalLayout {
                padding-left: Theme.tokens.space.xl;
                padding-right: Theme.tokens.space.xl;
                spacing: Theme.tokens.space.xs;
                Text {
                    text: "Custom margins";
                    font-size: Theme.type.body;
                    color: Theme.palette().ink;
                }
                HorizontalLayout {
                    spacing: Theme.tokens.space.xs;
                    LoomNumericField {
                        label: "Top margin";
                        description: "0–705.56 mm; preserve at least 12.70 mm of text area";
                        unit: "mm";
                        value <=> root.page-top-draft;
                        invalid: root.page-top-invalid;
                        edited(_) => { root.page-top-invalid = false; }
                        accepted(value) => { root.page-top-invalid = !root.edit-page-geometry("top", value); }
                        cancelled => { root.page-top-draft = "" + root.page-geometry.top_mm; root.page-top-invalid = false; }
                    }
                    LoomNumericField {
                        label: "Bottom margin";
                        description: "0–705.56 mm; preserve at least 12.70 mm of text area";
                        unit: "mm";
                        value <=> root.page-bottom-draft;
                        invalid: root.page-bottom-invalid;
                        edited(_) => { root.page-bottom-invalid = false; }
                        accepted(value) => { root.page-bottom-invalid = !root.edit-page-geometry("bottom", value); }
                        cancelled => { root.page-bottom-draft = "" + root.page-geometry.bottom_mm; root.page-bottom-invalid = false; }
                    }
                }
                HorizontalLayout {
                    spacing: Theme.tokens.space.xs;
                    LoomNumericField {
                        label: "Left margin";
                        description: "0–705.56 mm; preserve at least 12.70 mm of text area";
                        unit: "mm";
                        value <=> root.page-left-draft;
                        invalid: root.page-left-invalid;
                        edited(_) => { root.page-left-invalid = false; }
                        accepted(value) => { root.page-left-invalid = !root.edit-page-geometry("left", value); }
                        cancelled => { root.page-left-draft = "" + root.page-geometry.left_mm; root.page-left-invalid = false; }
                    }
                    LoomNumericField {
                        label: "Right margin";
                        description: "0–705.56 mm; preserve at least 12.70 mm of text area";
                        unit: "mm";
                        value <=> root.page-right-draft;
                        invalid: root.page-right-invalid;
                        edited(_) => { root.page-right-invalid = false; }
                        accepted(value) => { root.page-right-invalid = !root.edit-page-geometry("right", value); }
                        cancelled => { root.page-right-draft = "" + root.page-geometry.right_mm; root.page-right-invalid = false; }
                    }
                }
            }
            if root.geometry-invalid && (root.page-paper-index == 2 || root.page-margins-index == 3) : VerticalLayout {
                padding-left: Theme.tokens.space.xl;
                padding-right: Theme.tokens.space.xl;
                Text {
                    text: "Enter valid millimeter values and leave at least 12.70 mm for text.";
                    font-size: Theme.type.caption;
                    color: Theme.palette().danger;
                    wrap: word-wrap;
                    accessible-role: AccessibleRole.text;
                }
            }
            }
            }
        }
        }
                // The panel scrolls; this thin thumb shows that there is more below
                // and where the view sits (no other scrollbar exists here).
                if inspector-scroll.viewport-height > inspector-scroll.height : Rectangle {
                    x: parent.width - 4px;
                    width: 3px;
                    y: (parent.height - self.height) * (-inspector-scroll.viewport-y / max(1px, inspector-scroll.viewport-height - inspector-scroll.height));
                    height: max(24px, parent.height * inspector-scroll.height / inspector-scroll.viewport-height);
                    border-radius: 1.5px;
                    background: Theme.palette().border-strong;
                    accessible-role: none;
                }
            }

        }
    }
}
