import { LoomButton, LoomSearchField } from "foundation.slint";
import { Theme } from "theme.slint";

export struct StartHubRecentItem {
    name: string,
    path: string,
    subtitle: string,
    kind: string,
}

export global StartHubState {
    in-out property <bool> open: false;
    in-out property <int> sidebar-tab: 0;
    in-out property <string> search-query: "";
    in-out property <[StartHubRecentItem]> recents: [];
    in-out property <int> selected-index: 0;
    in-out property <bool> focus-request: false;

    callback open-recent(string);
    callback open-file();
    callback blank-document();
    callback new-document();
    callback close-hub();
    callback search-edited(string);
    callback tab-changed(int);
}

component StartHubSidebarItem inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    callback clicked();

    height: max(34px, Theme.scaled-control-height + 4px);
    border-radius: Theme.tokens.metrics.radius-medium;
    background: root.active
        ? Theme.palette().selection-soft
        : (item-touch.has-hover ? Theme.palette().surface-sunken : transparent);
    accessible-role: tab;
    accessible-label: root.label;
    accessible-selected: root.active;
    accessible-action-default => { root.clicked(); }

    HorizontalLayout {
        padding-left: Theme.tokens.space.md;
        padding-right: Theme.tokens.space.md;
        alignment: Theme.rtl ? end : start;

        Text {
            text: root.label;
            font-size: Theme.type.body;
            font-weight: root.active ? 700 : 500;
            color: root.active ? Theme.palette().accent : Theme.palette().ink;
            horizontal-alignment: Theme.rtl ? right : left;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    item-touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component StartHubRecentRow inherits Rectangle {
    in property <StartHubRecentItem> item;
    in property <bool> selected: false;
    callback select-row();
    callback activate-row();

    height: max(54px, 28px + 22px * max(1.0, Theme.text-scale));
    border-radius: Theme.tokens.metrics.radius-medium;
    background: root.selected
        ? Theme.palette().selection-soft
        : (row-touch.has-hover ? Theme.palette().surface : transparent);
    border-width: root.selected ? 1px : 0px;
    border-color: Theme.palette().accent;

    property <length> badge-w: max(42px, 34px * max(1.0, Theme.text-scale));
    property <length> badge-h: max(30px, 24px * max(1.0, Theme.text-scale));

    row-touch := TouchArea {
        clicked => { root.select-row(); }
        double-clicked => { root.activate-row(); }
    }

    badge := Rectangle {
        x: Theme.rtl
            ? parent.width - Theme.tokens.space.md - self.width
            : Theme.tokens.space.md;
        y: (parent.height - self.height) / 2;
        width: root.badge-w;
        height: root.badge-h;
        border-radius: Theme.tokens.metrics.radius-small;
        background: Theme.palette().selection-soft;

        Text {
            text: root.item.kind;
            font-size: Theme.type.caption;
            font-weight: 700;
            color: Theme.palette().accent;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    open-btn := LoomButton {
        label: "Open";
        accessible-name: "Open " + root.item.name;
        variant: "secondary";
        width: self.preferred-width;
        x: Theme.rtl
            ? Theme.tokens.space.md
            : parent.width - Theme.tokens.space.md - self.width;
        y: (parent.height - self.height) / 2;
        clicked => { root.activate-row(); }
    }

    subtitle-label := Text {
        text: root.item.subtitle;
        font-size: Theme.type.caption;
        color: Theme.palette().ink-secondary;
        width: self.preferred-width;
        x: Theme.rtl
            ? open-btn.x + open-btn.width + Theme.tokens.space.md
            : open-btn.x - Theme.tokens.space.md - self.width;
        y: (parent.height - self.height) / 2;
        vertical-alignment: center;
    }

    VerticalLayout {
        x: Theme.rtl
            ? subtitle-label.x + subtitle-label.width + Theme.tokens.space.md
            : badge.x + badge.width + Theme.tokens.space.md;
        width: max(0px, Theme.rtl
            ? badge.x - Theme.tokens.space.md - self.x
            : subtitle-label.x - Theme.tokens.space.md - self.x);
        height: parent.height;
        alignment: center;
        spacing: 2px;

        Text {
            text: root.item.name;
            font-size: Theme.type.body;
            font-weight: 600;
            color: Theme.palette().ink;
            horizontal-alignment: Theme.rtl ? right : left;
            overflow: elide;
        }
        Text {
            text: root.item.path;
            font-size: Theme.type.caption;
            color: Theme.palette().ink-secondary;
            horizontal-alignment: Theme.rtl ? right : left;
            overflow: elide;
        }
    }
}

export component StartHubModal inherits Rectangle {
    in property <bool> focus-request: StartHubState.focus-request;
    property <length> list-scroll-y: 0px;
    background: Theme.palette().scrim;
    accessible-role: groupbox;
    accessible-label: "Loom Writer Start Hub";

    init => {
        hub-focus.focus();
    }

    public function focus-start-hub() {
        hub-focus.focus();
    }

    changed focus-request => {
        if (StartHubState.open) {
            hub-focus.focus();
        }
    }

    function reveal-selected-row() {
        let row-h = max(54px, 28px + 22px * max(1.0, Theme.text-scale)) + 4px;
        let top = Theme.tokens.space.sm + max(0, StartHubState.selected-index) * row-h;
        let bottom = top + row-h;
        let min-scroll = min(0px, recents-flickable.height - recents-list.preferred-height);
        if (top < -root.list-scroll-y) {
            root.list-scroll-y = clamp(-max(0px, top - Theme.tokens.space.sm), min-scroll, 0px);
        } else if (bottom > -root.list-scroll-y + recents-flickable.height) {
            root.list-scroll-y = clamp(-(bottom + Theme.tokens.space.sm - recents-flickable.height), min-scroll, 0px);
        }
    }

    TouchArea {
        clicked => { StartHubState.close-hub(); }
    }

    hub-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                StartHubState.close-hub();
                return accept;
            }
            if (event.text == Key.DownArrow && StartHubState.recents.length > 0) {
                StartHubState.selected-index = min(StartHubState.recents.length - 1, StartHubState.selected-index + 1);
                root.reveal-selected-row();
                return accept;
            }
            if (event.text == Key.UpArrow && StartHubState.recents.length > 0) {
                StartHubState.selected-index = max(0, StartHubState.selected-index - 1);
                root.reveal-selected-row();
                return accept;
            }
            if (event.text == Key.Return) {
                if (StartHubState.selected-index >= 0 && StartHubState.selected-index < StartHubState.recents.length) {
                    StartHubState.open-recent(StartHubState.recents[StartHubState.selected-index].path);
                } else {
                    StartHubState.new-document();
                }
                return accept;
            }
            if (event.text == Key.Tab && !event.modifiers.shift && new-template-button.has-focus) {
                hub-focus.focus();
                return accept;
            }
            if ((event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) && hub-focus.has-focus) {
                new-template-button.grab-focus();
                return accept;
            }
            return reject;
        }

        Rectangle {
            width: min(980px, max(480px, root.width - 48px));
            height: min(600px, max(360px, root.height - 48px));
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.tokens.metrics.radius-large;
            background: Theme.palette().surface;
            border-width: 1px;
            border-color: Theme.palette().border;
            clip: true;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: Theme.palette().shadow;

            TouchArea { }

            sidebar := Rectangle {
                x: Theme.rtl ? parent.width - self.width : 0px;
                width: 210px + 70px * (max(1.0, Theme.text-scale) - 1.0);
                height: parent.height;
                background: Theme.palette().panel;

                Rectangle {
                    x: Theme.rtl ? 0px : parent.width - 1px;
                    width: 1px;
                    height: parent.height;
                    background: Theme.palette().border;
                }

                VerticalLayout {
                    padding: Theme.tokens.space.lg;
                    spacing: Theme.tokens.space.sm;

                    Text {
                        text: "Loom Writer";
                        font-size: Theme.type.title;
                        font-weight: 700;
                        color: Theme.palette().ink;
                        horizontal-alignment: Theme.rtl ? right : left;
                    }
                    Text {
                        text: "Documents";
                        font-size: Theme.type.caption;
                        color: Theme.palette().ink-secondary;
                        horizontal-alignment: Theme.rtl ? right : left;
                    }

                    Rectangle { height: Theme.tokens.space.md; }

                    StartHubSidebarItem {
                        label: "Recents";
                        active: StartHubState.sidebar-tab == 0;
                        clicked => {
                            StartHubState.sidebar-tab = 0;
                            StartHubState.tab-changed(0);
                        }
                    }
                    StartHubSidebarItem {
                        label: "Documents on Disk";
                        active: StartHubState.sidebar-tab == 1;
                        clicked => {
                            StartHubState.sidebar-tab = 1;
                            StartHubState.tab-changed(1);
                        }
                    }

                    Rectangle { vertical-stretch: 1; }
                }
            }

            VerticalLayout {
                x: Theme.rtl ? 0px : sidebar.width;
                width: parent.width - sidebar.width;
                height: parent.height;
                padding: Theme.tokens.space.xl;
                spacing: Theme.tokens.space.md;

                // Header bar
                Rectangle {
                    height: Theme.scaled-control-height;
                    background: transparent;

                    close-button := LoomButton {
                        label: "Close";
                        variant: "ghost";
                        width: self.preferred-width;
                        x: Theme.rtl ? 0px : parent.width - self.width;
                        y: (parent.height - self.height) / 2;
                        clicked => { StartHubState.close-hub(); }
                    }

                    search-field := LoomSearchField {
                        width: 220px;
                        label: "Filter recent documents";
                        placeholder: "Filter documents…";
                        value <=> StartHubState.search-query;
                        x: Theme.rtl
                            ? close-button.x + close-button.width + Theme.tokens.space.sm
                            : close-button.x - Theme.tokens.space.sm - self.width;
                        y: (parent.height - self.height) / 2;
                        edited(text) => { StartHubState.search-edited(text); }
                    }

                    Text {
                        text: StartHubState.sidebar-tab == 0 ? "Recent Documents" : "Documents on Disk";
                        font-size: Theme.type.title;
                        font-weight: 700;
                        color: Theme.palette().ink;
                        x: Theme.rtl ? search-field.x + search-field.width + Theme.tokens.space.md : 0px;
                        width: max(0px, Theme.rtl
                            ? parent.width - self.x
                            : search-field.x - Theme.tokens.space.md);
                        height: parent.height;
                        horizontal-alignment: Theme.rtl ? right : left;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                // Recents browser well
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: Theme.tokens.metrics.radius-medium;
                    background: Theme.palette().surface-sunken;
                    border-width: 1px;
                    border-color: Theme.palette().border;
                    clip: true;

                    VerticalLayout {
                        visible: StartHubState.recents.length == 0;
                        alignment: center;
                        padding: Theme.tokens.space.xl;
                        spacing: Theme.tokens.space.sm;

                        Text {
                            text: StartHubState.search-query == ""
                                ? "No recent documents yet."
                                : "No documents match \"" + StartHubState.search-query + "\".";
                            font-size: Theme.type.body;
                            font-weight: 600;
                            color: Theme.palette().ink;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Choose New from Template to browse templates, or Open File… to open an existing document.";
                            font-size: Theme.type.caption;
                            color: Theme.palette().ink-secondary;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                    }

                    recents-flickable := Flickable {
                        visible: StartHubState.recents.length > 0;
                        width: 100%;
                        height: 100%;
                        viewport-width: self.width;
                        viewport-height: max(self.height, recents-list.preferred-height);
                        viewport-y <=> root.list-scroll-y;

                        recents-list := VerticalLayout {
                            width: parent.width;
                            padding: Theme.tokens.space.sm;
                            spacing: 4px;

                            for item[idx] in StartHubState.recents : StartHubRecentRow {
                                item: item;
                                selected: idx == StartHubState.selected-index;
                                select-row => { StartHubState.selected-index = idx; }
                                activate-row => { StartHubState.open-recent(item.path); }
                            }
                        }
                    }
                }

                // Footer action bar
                Rectangle {
                    height: Theme.scaled-control-height;
                    background: transparent;

                    blank-button := LoomButton {
                        label: "Blank Document";
                        variant: "ghost";
                        width: self.preferred-width;
                        x: Theme.rtl ? parent.width - self.width : 0px;
                        y: (parent.height - self.height) / 2;
                        clicked => { StartHubState.blank-document(); }
                    }

                    open-file-button := LoomButton {
                        label: "Open File…";
                        variant: "secondary";
                        width: self.preferred-width;
                        x: Theme.rtl
                            ? blank-button.x - Theme.tokens.space.sm - self.width
                            : blank-button.x + blank-button.width + Theme.tokens.space.sm;
                        y: (parent.height - self.height) / 2;
                        clicked => { StartHubState.open-file(); }
                    }

                    new-template-button := LoomButton {
                        label: "New from Template";
                        variant: "primary";
                        width: self.preferred-width;
                        x: Theme.rtl ? 0px : parent.width - self.width;
                        y: (parent.height - self.height) / 2;
                        clicked => { StartHubState.new-document(); }
                    }
                }
            }
        }
    }
}
