import { TemplateChooserModal } from "template_chooser.slint";
import { CommandPaletteItem } from "../../../../loom-core/crates/loom-ui/ui/components.slint";
import { LoomWindowResizeEdges, LocalMenuEntry, LocalMenuPopup } from "foundation.slint";
import { FindBar, FindBarOverlay } from "find_bar.slint";
import { WriterSaveChangesDialog } from "save_changes_dialog.slint";
import { DocxImportWarningDialog } from "docx_import_warning.slint";
import { DocxSaveWarningDialog, DocxSaveWarningState } from "docx_save_warning.slint";
import { DocxExportReportDialog } from "docx_export_report.slint";
import { WriterPaletteHost } from "palette_host.slint";
import { PictureAltDialog } from "writer_components.slint";
import { Theme } from "theme.slint";
import { WriterTextColorDialog } from "writer_text_color_dialog.slint";
import { WriterHeaderFooterDialog, WriterHeaderFooterState } from "writer_header_footer.slint";
import { WriterFootnoteDialog, WriterFootnoteState } from "writer_footnotes.slint";
import { WriterReviewPanel, WriterReviewState } from "writer_review.slint";
import { WriterPdfExportDialog } from "writer_pdf_export_dialog.slint";
import { WriterFormatState } from "alignment_state.slint";

/// Dialogs, the in-window menu popup, the command palette, the find bar and the
/// frameless-window resize edges, stacked above the page in the same order as
/// before. `WriterApp` owns all of the state and wires it in.
export component WriterOverlays inherits Rectangle {
    in property <bool> template-chooser-open;
    in property <int> template-refocus-tick;
    in-out property <string> template-selected;
    in-out property <int> template-category;
    callback cancel-template;
    callback create-template(string);
    in property <bool> save-changes-open;
    in property <string> save-changes-document;
    in property <bool> save-changes-closing;
    callback save-changes-save;
    callback save-changes-discard;
    callback save-changes-cancel;
    in property <bool> docx-import-warning-open;
    in property <string> docx-import-warning-message;
    callback docx-import-continue;
    callback docx-import-cancel;
    in-out property <bool> docx-export-report-open;
    in property <string> docx-export-report-message;
    in property <bool> local-menu-visible;
    in property <[string]> local-menu-labels;
    in property <[LocalMenuEntry]> local-menu-popup-items;
    in-out property <int> local-menu-open-index;
    in-out property <int> local-menu-popup-selected-index;
    callback local-menu-opened(int);
    callback local-menu-move(int);
    callback menu-closed;
    callback local-menu-action(string);
    in-out property <bool> palette-open;
    in property <[CommandPaletteItem]> palette-commands;
    in-out property <string> palette-query;
    in-out property <bool> palette-query-selected;
    in property <int> palette-selected;
    callback palette-invoked(int);
    callback palette-query-changed(string);
    callback palette-move(int);
    callback palette-key-text(string);
    callback palette-backspace;
    callback palette-close;
    in property <length> outline-width;
    in property <length> inspector-width;
    in property <bool> rtl;
    in property <length> toolbar-bottom;
    in property <bool> custom-chrome;
    in property <bool> maximized;
    callback window-resize(int);

    public function focus-palette() {
        palette-host.grab-focus();
    }

    if root.template-chooser-open : TemplateChooserModal {
        width: root.width;
        height: root.height;
        refocus-tick: root.template-refocus-tick;
        template-selected <=> root.template-selected;
        template-category <=> root.template-category;
        cancel-template => { root.cancel-template(); }
        create-template(idx) => { root.create-template(idx); }
    }

PictureAltDialog {}
    if WriterHeaderFooterState.dialog-open : WriterHeaderFooterDialog {
        width: root.width;
        height: root.height;
    }
    if WriterFootnoteState.dialog-open : WriterFootnoteDialog {
        width: root.width;
        height: root.height;
    }
    if WriterFormatState.color-dialog-open : WriterTextColorDialog {
        width: root.width;
        height: root.height;
    }
    if root.save-changes-open : WriterSaveChangesDialog {
        width: root.width;
        height: root.height;
        document: root.save-changes-document;
        closing: root.save-changes-closing;
        save => { root.save-changes-save(); }
        discard => { root.save-changes-discard(); }
        cancel => { root.save-changes-cancel(); }
    }

    if root.docx-import-warning-open : DocxImportWarningDialog {
        width: root.width;
        height: root.height;
        open: root.docx-import-warning-open;
        warning-message: root.docx-import-warning-message;
        import-continue => { root.docx-import-continue(); }
        import-cancel => { root.docx-import-cancel(); }
    }

    if root.docx-export-report-open : DocxExportReportDialog {
        width: root.width;
        height: root.height;
        open <=> root.docx-export-report-open;
        report-message: root.docx-export-report-message;
    }

    if DocxSaveWarningState.dialog-open : DocxSaveWarningDialog {
        width: root.width;
        height: root.height;
        open: DocxSaveWarningState.dialog-open;
        warning-message: DocxSaveWarningState.warning-message;
        continue-docx => { DocxSaveWarningState.continue-docx(); }
        cancel-docx => { DocxSaveWarningState.cancel-docx(); }
    }

    LocalMenuPopup {
        x: 0px;
        y: 36px;
        width: root.width;
        height: root.height - 36px;
        menu-enabled: root.local-menu-visible;
        labels: root.local-menu-labels;
        items: root.local-menu-popup-items;
        open-index <=> root.local-menu-open-index;
        selected-index <=> root.local-menu-popup-selected-index;
        menu-opened(index) => { root.local-menu-opened(index); }
        menu-move(direction) => { root.local-menu-move(direction); }
        menu-closed => { root.menu-closed(); }
        menu-action(id) => { root.local-menu-action(id); }
    }

    // The command palette and its Ctrl+A search scope; see palette_host.slint.
    palette-host := WriterPaletteHost {
        width: parent.width;
        height: parent.height;
        open: root.palette-open;
        commands: root.palette-commands;
        query <=> root.palette-query;
        query-selected <=> root.palette-query-selected;
        selected: root.palette-selected;
        command-invoked(idx) => { root.palette-invoked(idx); }
        query-changed(q) => { root.palette-query-changed(q); }
        move-selection(delta) => { root.palette-move(delta); }
        key-text(text) => { root.palette-key-text(text); }
        backspace => { root.palette-backspace(); }
        close-requested => {
            root.palette-open = false;
            root.palette-close();
        }
    }

    // Find bar sits under the toolbar at the viewport reading edge.
    if FindBar.open : FindBarOverlay {
        width: min(480px * max(1.0, Theme.text-scale), root.width - root.outline-width - root.inspector-width - 32px);
        x: root.rtl ? root.inspector-width + 16px : root.width - root.inspector-width - self.width - 16px;
        y: root.toolbar-bottom + 8px;
    }

    if WriterReviewState.panel-open : WriterReviewPanel {
        width: min(420px * max(1.0, Theme.text-scale), root.width - 32px);
        height: min(460px * max(1.0, Theme.text-scale), root.height - root.toolbar-bottom - 24px);
        x: root.rtl ? root.inspector-width + 16px : root.width - root.inspector-width - self.width - 16px;
        y: root.toolbar-bottom + 8px;
    }

    if WriterReviewState.pdf-export-open : WriterPdfExportDialog {
        width: root.width;
        height: root.height;
        open <=> WriterReviewState.pdf-export-open;
        export-view(view) => { WriterReviewState.export-pdf-view(view); }
        cancel => {
            WriterReviewState.pdf-export-open = false;
            WriterReviewState.cancel-pdf-export();
        }
    }

    LoomWindowResizeEdges {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        enabled: root.custom-chrome && !root.maximized;
        resize(direction) => { root.window-resize(direction); }
    }
}
