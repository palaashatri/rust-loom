import { LoomColorPalette, LoomIconButton } from "foundation.slint";
import { Theme } from "theme.slint";
import { WriterFormatState } from "alignment_state.slint";

/// Accessible 48-color modal foreground-color picker, used when triggered from
/// menus or the Command Palette while the Format inspector is closed.
export component WriterTextColorDialog inherits FocusScope {
    init => { palette.grab-focus(); }

    key-pressed(event) => {
        if (event.text == Key.Escape) {
            WriterFormatState.cancel-foreground-color();
            return accept;
        }
        return reject;
    }

    Rectangle {
        width: root.width;
        height: root.height;
        background: Theme.palette().scrim;

        TouchArea {
            clicked => { WriterFormatState.cancel-foreground-color(); }
        }

        Rectangle {
            width: min(360px * max(1.0, Theme.text-scale), root.width - 48px);
            height: min(layout.preferred-height, root.height - 48px);
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            border-radius: Theme.tokens.metrics.radius-large;
            border-width: 1px;
            border-color: Theme.palette().border-strong;
            background: Theme.palette().surface;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: Theme.palette().shadow;

            TouchArea { }

            layout := VerticalLayout {
                padding: Theme.tokens.space.lg;
                spacing: Theme.tokens.space.md;

                HorizontalLayout {
                    spacing: Theme.tokens.space.sm;
                    cross-axis-alignment: center;

                    if Theme.rtl : LoomIconButton {
                        text-scale: Theme.text-scale;
                        icon: "close";
                        label: "Cancel";
                        tooltip: "Close color picker";
                        clicked => { WriterFormatState.cancel-foreground-color(); }
                    }

                    Text {
                        text: "Text Color";
                        font-size: Theme.type.heading;
                        font-weight: 700;
                        color: Theme.palette().ink;
                        horizontal-alignment: Theme.rtl ? right : left;
                        horizontal-stretch: 1;
                    }

                    if !Theme.rtl : LoomIconButton {
                        text-scale: Theme.text-scale;
                        icon: "close";
                        label: "Cancel";
                        tooltip: "Close color picker";
                        clicked => { WriterFormatState.cancel-foreground-color(); }
                    }
                }

                palette := LoomColorPalette {
                    swatches: WriterFormatState.color-swatches;
                    selected-hex: WriterFormatState.foreground-color-value;
                    is-automatic: WriterFormatState.foreground-color-value == "" && !WriterFormatState.foreground-color-mixed;
                    is-mixed: WriterFormatState.foreground-color-mixed;
                    kind-label: "Text color";
                    hex-input <=> WriterFormatState.color-input;
                    hex-error: WriterFormatState.color-error;
                    enabled: WriterFormatState.color-formatting-available;
                    select-color(hex) => { WriterFormatState.select-foreground-color(hex); }
                    select-automatic => { WriterFormatState.reset-foreground-color(); }
                    hex-edited(_) => { WriterFormatState.clear-foreground-color-error(); }
                    hex-submitted(hex) => {
                        WriterFormatState.color-input = hex;
                        WriterFormatState.apply-foreground-color();
                    }
                    close-requested => { WriterFormatState.cancel-foreground-color(); }
                }
            }
        }
    }
}
