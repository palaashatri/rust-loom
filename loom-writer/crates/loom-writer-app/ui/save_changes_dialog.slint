import { LoomButton } from "foundation.slint";
import { Theme } from "theme.slint";

/// Save, Discard or Cancel before a document is replaced or the window closes.
/// A modal: its FocusScope parents the three buttons so keys bubble to it, Tab
/// cycles Cancel, Discard, Save without leaving, Escape cancels, and the
/// primary button is focused when it opens.
export component WriterSaveChangesDialog inherits FocusScope {
    in property <string> document: "";
    in property <bool> closing: false;
    callback save;
    callback discard;
    callback cancel;

    init => { save-button.grab-focus(); }
    key-pressed(event) => {
        if (event.text == Key.Escape) { root.cancel(); return accept; }
        if (event.text == Key.Tab || event.text == Key.Backtab) {
            if (event.text == Key.Backtab || event.modifiers.shift) {
                if (save-button.has-focus) { discard-button.grab-focus(); } else if (discard-button.has-focus) { cancel-button.grab-focus(); } else { save-button.grab-focus(); }
            } else {
                if (cancel-button.has-focus) { discard-button.grab-focus(); } else if (discard-button.has-focus) { save-button.grab-focus(); } else { cancel-button.grab-focus(); }
            }
            return accept;
        }
        return reject;
    }

    Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000066;

        // This full-window hit target keeps clicks from reaching the editor.
        TouchArea { clicked => { root.focus(); } }

        Rectangle {
            width: min(440px, root.width - 48px);
            height: min(layout.preferred-height, root.height - 48px);
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            border-radius: Theme.tokens.metrics.radius-large;
            border-width: 1px;
            border-color: Theme.palette().border;
            background: Theme.palette().surface;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: Theme.palette().shadow;

            layout := VerticalLayout {
                spacing: Theme.tokens.space.md;
                padding: Theme.tokens.space.xl;

                Text {
                    text: "Save changes?";
                    font-size: Theme.type.heading;
                    font-weight: 700;
                    color: Theme.palette().ink;
                    horizontal-alignment: Theme.rtl ? right : left;
                }
                Text {
                    text: "Save changes to \"" + root.document + "\" before " + (root.closing ? "closing" : "replacing it") + "?";
                    font-size: Theme.type.body;
                    color: Theme.palette().ink-secondary;
                    horizontal-alignment: Theme.rtl ? right : left;
                    wrap: word-wrap;
                }
                // The primary button sits at the reading end: right in LTR, left in RTL.
                Rectangle {
                    height: Theme.tokens.metrics.control-height;
                    save-button := LoomButton {
                        label: "Save";
                        variant: "primary";
                        width: self.preferred-width;
                        height: Theme.tokens.metrics.control-height;
                        x: Theme.rtl ? 0px : parent.width - self.width;
                        clicked => { root.save(); }
                    }
                    discard-button := LoomButton {
                        label: "Discard";
                        variant: "danger";
                        width: self.preferred-width;
                        height: Theme.tokens.metrics.control-height;
                        x: Theme.rtl ? save-button.width + Theme.tokens.space.sm : save-button.x - Theme.tokens.space.sm - self.width;
                        clicked => { root.discard(); }
                    }
                    cancel-button := LoomButton {
                        label: "Cancel";
                        variant: "secondary";
                        width: self.preferred-width;
                        height: Theme.tokens.metrics.control-height;
                        x: Theme.rtl ? discard-button.x + discard-button.width + Theme.tokens.space.sm : discard-button.x - Theme.tokens.space.sm - self.width;
                        clicked => { root.cancel(); }
                    }
                }
            }
        }
    }
}
