import { LoomStatusBar, LoomStatusText, LoomIconButton } from "foundation.slint";
import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { FindBar } from "find_bar.slint";

export { WriterActionToolbar } from "toolbar.slint";
export { WriterToolbarMenu } from "toolbar_menu.slint";
export { WriterOutlinePane, WriterOutlineEntry } from "outline_pane.slint";
export { WriterInspector } from "inspector.slint";
export { PictureAltDialog, PictureAlt } from "picture_alt_dialog.slint";

/// One stretch of a row's text that is drawn in a single look: the plain words
/// of the document and the character style they carry, never markup.
export struct WriterTextSegment {
    text: string,
    /// Left edge and top from the row's own, for a positioned row.
    x: length,
    y: length,
    /// 700 for a bold run, else 400: the page measures weights below Bold as
    /// Regular, so it draws them that way too.
    weight: int,
    italic: bool,
    underline: bool,
    strikethrough: bool,
}

/// A line drawn under (underline) or through (strikethrough) a segment, in the
/// row's own coordinates. Slint's text item cannot draw either by itself.
export struct WriterTextRule {
    x: length,
    y: length,
    width: length,
    height: length,
}

/// A rendered paragraph projected from the Writer document model.
export struct WriterRenderBlock {
    segments: [WriterTextSegment],
    rules: [WriterTextRule],
    /// False: one segment that the text item aligns and wraps itself. True:
    /// each segment sits at its own `x`/`y` and the row is not wrapped again.
    positioned: bool,
    x: length,
    y: length,
    width: length,
    font-size: length,
    /// The family this row is drawn in; empty draws in the document font.
    font-family: string,
    height: length,
    alignment: int,
    marker: string,
    unsupported: bool,
    unsupported-label: string,
    /// A colour from the block's own style (table cell text); when false the
    /// page ink is used.
    has-color: bool,
    color: color,
    /// True for generated table-cell text, whose High Contrast ink is forced
    /// to black over the High Contrast-only white cell surface.
    table-cell: bool,
}

/// A selection highlight or collapsed caret rectangle projected from the
/// authoritative Writer page layout.
export struct WriterSelectionRect {
    page-index: int,
    x: length,
    y: length,
    width: length,
    height: length,
    caret: bool,
    /// A caret drawn over a filled table cell takes that cell's text colour.
    has-color: bool,
    color: color,
}

/// A comment range projected from the same page layout as text selection.
export struct WriterCommentRect {
    comment-id: string,
    label: string,
    page-index: int,
    x: length,
    y: length,
    width: length,
    height: length,
    marker: bool,
    /// The highlight behind the commented text: a document colour from Rust,
    /// so it is the same in light, dark and high contrast.
    fill: color,
}

/// A table cell rectangle projected with borders and background fills.
export struct WriterTableCellRect {
    x: length,
    y: length,
    width: length,
    height: length,
    bg-color: color,
    has-bg: bool,
    border-color: color,
    selection-border-color: color,
    border-width: length,
    selected: bool,
    /// True for actual table cells; chart surfaces keep their own appearance.
    table-cell: bool,
    /// Canonical editor byte offset for a table cell; -1 for non-cell shapes.
    caret-offset: int,
}

/// An inline picture placed on the page stack.
export struct WriterPageImage {
    x: length,
    y: length,
    width: length,
    height: length,
    source: image,
    label: string,
    /// True for the picture the caret is on: it draws an outline and corner handles.
    selected: bool,
}

/// The pictures the page shows; set from Rust with the rest of the projection.
export global PageImages {
    in-out property <[WriterPageImage]> items: [];
}

/// A corner handle of the selected picture: 8 px, drawn over the picture.
component PictureCornerHandle inherits Rectangle {
    width: 8px;
    height: 8px;
    background: Theme.active-theme == "high-contrast" ? Theme.palette().paper-ink : Theme.palette().selection;
    border-width: 1px;
    border-color: Theme.palette().paper;
    accessible-role: none;
}

/// The page-margin chip that marks a comment's first line. It is drawn in page
/// ink on page paper in every theme, so it reads the same in dark and high
/// contrast. Its label is spoken, never drawn, so it cannot run past the page.
component CommentMarker inherits Rectangle {
    in property <string> label: "";
    callback clicked;

    width: Theme.tokens.metrics.control-height * max(1.0, Theme.text-scale);
    height: Theme.tokens.metrics.control-height * max(1.0, Theme.text-scale);
    border-radius: Theme.tokens.metrics.radius-medium;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Theme.palette().focus : Theme.palette().paper-muted;
    background: Theme.palette().paper;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    Icon {
        x: (root.width - self.size) / 2;
        y: (root.height - self.size) / 2;
        size: Theme.tokens.metrics.icon-size * max(1.0, Theme.text-scale);
        icon: "comment";
        tint: Theme.palette().paper-ink;
    }

    focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { clicked => { focus.focus(); root.clicked(); } }
}

/// Writer's selection-aware text editor.
component WriterDocumentEditor inherits Rectangle {
    in-out property <string> text: "";
    in property <[WriterRenderBlock]> render-blocks: [];
    in property <[WriterSelectionRect]> selection-rects: [];
    in property <[WriterCommentRect]> comment-rects: [];
    in property <[WriterTableCellRect]> table-cell-rects: [];
    in property <string> document-accessible-label: "Document body";
    in property <float> page-zoom: 1.0;
    in property <string> placeholder: "Type your text here...";
    in property <bool> enabled: true;
    in property <length> font-size: Theme.tokens.typography.body;
    in property <int> selection-anchor: 0;
    in property <int> selection-focus: 0;
    // Approximate relative luminance of a colour (a square-law gamma stands in
    // for the sRGB curve), from 0 (black) to 1 (white).
    pure function luminance(c: color) -> float {
        return (0.2126 * c.red * c.red + 0.7152 * c.green * c.green + 0.0722 * c.blue * c.blue) / 65025.0;
    }
    pure function contrast(a: float, b: float) -> float {
        return (max(a, b) + 0.05) / (min(a, b) + 0.05);
    }
    // The line between table cells, chosen against the fill it sits on: the soft
    // page-muted grey where that reaches 3:1, else white on a dark fill, else ink.
    pure function table-line(fill: float) -> color {
        return root.contrast(root.luminance(Theme.palette().paper-muted), fill) >= 3.0
            ? Theme.palette().paper-muted
            : root.contrast(root.luminance(Theme.palette().paper), fill) >= 3.0
                ? Theme.palette().paper
                : Theme.palette().paper-ink;
    }
    callback edited(string, int, int);
    callback selection-changed(int, int);
    callback pointer-pressed(length, length, bool);
    callback pointer-moved(length, length);
    callback pointer-released(length, length);
    callback pointer-cancelled;
    callback key-pressed(event: KeyEvent) -> EventResult;

    horizontal-stretch: 1;
    vertical-stretch: 1;
    min-width: 0px;
    min-height: 0px;
    background: transparent;
    accessible-role: AccessibleRole.text-input;
    accessible-label: root.document-accessible-label;
    accessible-enabled: root.enabled;
    accessible-value <=> root.text;
    accessible-placeholder-text: root.placeholder;
    accessible-action-default => { editor.focus(); }
    forward-focus: editor;

    focus-touch := TouchArea { clicked => { editor.focus(); } }

    if root.text == "" : Text {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        text: root.placeholder;
        font-family: Theme.document-font-family;
        font-size: root.font-size;
        color: Theme.palette().paper-muted;
        vertical-alignment: top;
        wrap: word-wrap;
        accessible-role: none;
    }

    preview := Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        for comment in root.comment-rects : Rectangle {
            x: comment.x * root.page-zoom;
            y: comment.y * root.page-zoom;
            width: max(1px, comment.width * root.page-zoom);
            height: max(1px, comment.height * root.page-zoom);
            border-radius: 2px;
            background: comment.fill;
            // High contrast outlines each anchor in page ink, so its edge does not
            // depend on the highlight colour.
            border-width: Theme.active-theme == "high-contrast" ? 2px : 0px;
            border-color: Theme.palette().paper-ink;
            accessible-role: none;
        }
        // Secondary highlights for the other find matches; the current match
        // is the ordinary selection drawn after them.
        for found in FindBar.match-rects : Rectangle {
            x: found.x * root.page-zoom;
            y: found.y * root.page-zoom;
            width: max(1px, found.width * root.page-zoom);
            height: max(1px, found.height * root.page-zoom);
            border-radius: 2px;
            background: Theme.palette().warning.with-alpha(0.35);
            accessible-role: none;
        }
        for cell in root.table-cell-rects : Rectangle {
            x: cell.x * root.page-zoom;
            y: cell.y * root.page-zoom;
            // A table cell draws its border inside its own box. Reaching one border
            // width past the right and bottom edges puts each shared line where the
            // neighbour's left or top border is, so every interior line is drawn once
            // rather than as two adjacent borders.
            width: max(1px, cell.width * root.page-zoom)
                + (cell.table-cell ? cell.border-width * root.page-zoom : 0px);
            height: max(1px, cell.height * root.page-zoom)
                + (cell.table-cell ? cell.border-width * root.page-zoom : 0px);
            background: Theme.active-theme == "high-contrast" && cell.table-cell
                ? Theme.palette().paper
                : cell.has-bg ? cell.bg-color : transparent;
            border-color: Theme.active-theme == "high-contrast" && cell.table-cell
                ? Theme.palette().paper-ink
                : cell.table-cell
                    ? root.table-line(cell.has-bg ? root.luminance(cell.bg-color) : 1.0)
                    : cell.border-color;
            border-width: cell.border-width * root.page-zoom;
            accessible-role: none;
        }
        for cell in root.table-cell-rects : Rectangle {
            x: cell.x * root.page-zoom;
            y: cell.y * root.page-zoom;
            width: max(1px, cell.width * root.page-zoom);
            height: max(1px, cell.height * root.page-zoom);
            background: Theme.palette().selection.with-alpha(0.22);
            border-color: Theme.active-theme == "high-contrast" && cell.table-cell
                ? cell.selection-border-color
                : Theme.palette().selection;
            border-width: max(1px, 2px * root.page-zoom);
            visible: cell.selected;
            accessible-role: none;
        }
        for pic in PageImages.items : Rectangle {
            x: pic.x * root.page-zoom;
            y: pic.y * root.page-zoom;
            width: max(1px, pic.width * root.page-zoom);
            height: max(1px, pic.height * root.page-zoom);
            accessible-role: none;
            Image {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                source: pic.source;
                image-fit: fill;
                accessible-role: image;
                accessible-label: pic.label;
            }
            // The outline and corner handles of the selected picture.
            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                border-width: 2px;
                border-color: Theme.active-theme == "high-contrast" ? Theme.palette().paper-ink : Theme.palette().selection;
                visible: pic.selected;
                accessible-role: none;
            }
            PictureCornerHandle { x: -4px; y: -4px; visible: pic.selected; }
            PictureCornerHandle { x: parent.width - 4px; y: -4px; visible: pic.selected; }
            PictureCornerHandle { x: -4px; y: parent.height - 4px; visible: pic.selected; }
            PictureCornerHandle { x: parent.width - 4px; y: parent.height - 4px; visible: pic.selected; }
        }
        for selection in root.selection-rects : Rectangle {
            x: selection.x * root.page-zoom;
            y: selection.y * root.page-zoom;
            width: max(1px, selection.width * root.page-zoom);
            height: max(1px, selection.height * root.page-zoom);
            background: selection.caret ? transparent : Theme.palette().selection;
            visible: !selection.caret;
            accessible-role: none;
        }
        for block in root.render-blocks : Text {
            // A list marker ends a small gap before its item's text, inside
            // the room the layout reserves left of that text (text_start_pt).
            // The text column is the layout's own, so caret and selection align.
            x: block.x * root.page-zoom - 4px * root.page-zoom - self.width;
            y: block.y * root.page-zoom;
            width: max(14px, block.marker.character-count * block.font-size * 0.62) * root.page-zoom;
            height: block.height * root.page-zoom;
            text: block.marker;
            font-family: Theme.document-font-family;
            visible: block.marker != "";
            font-size: block.font-size * root.page-zoom;
            color: Theme.palette().paper-ink;
            horizontal-alignment: right;
            vertical-alignment: top;
            accessible-role: none;
        }
        for block in root.render-blocks : Rectangle {
            x: block.x * root.page-zoom;
            y: block.y * root.page-zoom;
            width: max(1px, block.width * root.page-zoom);
            height: block.height * root.page-zoom;
            accessible-role: none;
            property <color> ink: Theme.active-theme == "high-contrast" && block.table-cell
                ? Theme.palette().paper-ink
                : block.has-color ? block.color : Theme.palette().paper-ink;
            // One Text per typed segment. A row of plain text is one segment
            // that the Text aligns and wraps itself; a row with several looks
            // or with rules is positioned segment by segment from Rust.
            for segment in block.segments : Text {
                x: block.positioned ? segment.x * root.page-zoom : 0px;
                y: block.positioned ? segment.y * root.page-zoom : 0px;
                width: block.positioned
                    ? max(1px, (block.width - segment.x + 4px) * root.page-zoom)
                    : parent.width;
                height: block.positioned
                    ? max(block.font-size * 1.4, block.height - segment.y) * root.page-zoom
                    : parent.height;
                text: segment.text;
                font-family: block.font-family != "" ? block.font-family : Theme.document-font-family;
                font-size: block.font-size * root.page-zoom;
                font-weight: segment.weight;
                font-italic: segment.italic;
                color: parent.ink;
                wrap: block.positioned ? TextWrap.no-wrap : TextWrap.word-wrap;
                horizontal-alignment: !block.positioned && block.alignment == 1
                    ? TextHorizontalAlignment.center
                    : !block.positioned && block.alignment == 2
                        ? TextHorizontalAlignment.right
                        : TextHorizontalAlignment.left;
                vertical-alignment: top;
            }
            for rule in block.rules : Rectangle {
                x: rule.x * root.page-zoom;
                y: rule.y * root.page-zoom;
                width: max(1px, rule.width * root.page-zoom);
                height: max(1px, rule.height * root.page-zoom);
                background: parent.ink;
                accessible-role: none;
            }
        }
        for block in root.render-blocks : Text {
            x: block.x * root.page-zoom;
            y: block.y * root.page-zoom;
            width: max(1px, block.width * root.page-zoom);
            height: max(14px, min(18px, block.height * root.page-zoom));
            text: block.unsupported ? block.unsupported-label : "";
            color: Theme.palette().warning;
            font-size: 10px * root.page-zoom;
            horizontal-alignment: right;
            vertical-alignment: top;
            visible: block.unsupported;
            accessible-role: none;
        }
        for selection in root.selection-rects : Rectangle {
            // A caret stands a fixed gap before its position, so the glyph there
            // never touches it. The gap scales with the page.
            property <length> mark-width: max(1px, selection.width * root.page-zoom);
            x: selection.caret
                ? selection.x * root.page-zoom - 2px * root.page-zoom - mark-width
                : selection.x * root.page-zoom;
            y: selection.y * root.page-zoom;
            width: mark-width;
            height: max(1px, selection.height * root.page-zoom);
            background: Theme.active-theme == "high-contrast"
                ? Theme.palette().paper-ink
                : selection.has-color ? selection.color : Theme.palette().paper-ink;
            visible: selection.caret && (editor.has-focus || root.selection-anchor == root.selection-focus);
            accessible-role: none;
        }
    }

    editor := TextInput {
        font-family: Theme.document-font-family;
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        text <=> root.text;
        enabled: root.enabled;
        single-line: false;
        wrap: word-wrap;
        vertical-alignment: top;
        font-size: root.font-size;
        color: transparent;
        selection-background-color: transparent;
        selection-foreground-color: transparent;
        accessible-role: none;
        edited => {
            root.selection-changed(editor.anchor-position-byte-offset, editor.cursor-position-byte-offset);
            root.edited(editor.text, editor.anchor-position-byte-offset, editor.cursor-position-byte-offset);
        }
        cursor-position-changed(_) => {
            root.selection-changed(editor.anchor-position-byte-offset, editor.cursor-position-byte-offset);
        }
        key-pressed(event) => { return root.key-pressed(event); }
    }

    pointer-surface := TouchArea {
        enabled: root.enabled;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                editor.focus();
                root.pointer-pressed(self.mouse-x, self.mouse-y, event.modifiers.shift);
            } else if (event.kind == PointerEventKind.up) {
                root.pointer-released(self.mouse-x, self.mouse-y);
            } else if (event.kind == PointerEventKind.cancel) {
                root.pointer-cancelled();
            }
        }
        moved => {
            if (self.pressed) {
                root.pointer-moved(self.mouse-x, self.mouse-y);
            }
        }
    }

    changed selection-anchor => { editor.set-selection-offsets(root.selection-anchor, root.selection-focus); }
    changed selection-focus => { editor.set-selection-offsets(root.selection-anchor, root.selection-focus); }
}

/// The editable paper surface.
export component WriterPageCanvas inherits Rectangle {
    in property <string> doc-title: "Untitled Document";
    in-out property <string> doc-content: "";
    in property <[WriterRenderBlock]> render-blocks: [];
    in property <[WriterSelectionRect]> selection-rects: [];
    in property <[WriterCommentRect]> comment-rects: [];
    in property <[WriterTableCellRect]> table-cell-rects: [];
    in property <string> document-accessible-label: "Document body";
    in-out property <int> selection-anchor: 0;
    in-out property <int> selection-focus: 0;
    in-out property <float> page-zoom: 1.0;
    in-out property <length> page-scroll-x: 0px;
    in-out property <length> page-scroll-y: 0px;
    // Height of the visible page area, so the controller can keep the caret in view.
    in-out property <length> view-height: 0px;
    // The Flickable's offsets are negative when scrolled; the controller works
    // with the positive distance scrolled, so the sign flips at this boundary.
    private property <length> native-x;
    private property <length> native-y;
    private property <length> measured-height: page-scroll.height;
    in property <int> page-count: 1;
    // Only the sheets near the viewport are drawn; a long document would
    // otherwise keep one shadowed rectangle alive per page.
    in property <int> visible-page-first: 0;
    in property <int> visible-page-count: 1;
    in property <length> page-stack-height: 842px;
    in property <float> page-gap-pt: 24.0;
    in property <float> page-width-pt: 595.0;
    in property <float> page-height-pt: 842.0;
    in property <float> page-margin-pt: 72.0;
    callback document-edited(string, int, int);
    callback selection-changed(int, int);
    callback pointer-pressed(length, length, bool);
    callback pointer-moved(length, length);
    callback pointer-released(length, length);
    callback pointer-cancelled;
    callback activate-comment(string);
    callback page-zoom-changed(float);
    callback page-scroll-changed(length, length);
    callback key-pressed(event: KeyEvent) -> EventResult;

    background: Theme.palette().canvas;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    forward-focus: document-editor;

    init => { root.view-height = page-scroll.height; }
    changed measured-height => { root.view-height = root.measured-height; }
    changed native-x => { root.page-scroll-x = -root.native-x; }
    changed native-y => { root.page-scroll-y = -root.native-y; }
    changed page-scroll-x => {
        root.native-x = -max(0px, min(root.page-scroll-x, page-scroll.viewport-width - page-scroll.width));
    }
    changed page-scroll-y => {
        root.native-y = -max(0px, min(root.page-scroll-y, page-scroll.viewport-height - page-scroll.height));
    }

    page-scroll := Flickable {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        viewport-width: max(parent.width, page.width + 48px);
        viewport-height: max(parent.height, page.y + page.height + max(24px, page.gap));
        viewport-x <=> root.native-x;
        viewport-y <=> root.native-y;
        flicked => { root.page-scroll-changed(-self.viewport-x, -self.viewport-y); }

        page := Rectangle {
            // Page geometry is pushed from the document's page setup
            // (loom_writer_core::PageSetup::page_style) in points.
            private property <length> raw-width: root.page-width-pt * 1px;
            private property <length> raw-height: root.page-height-pt * 1px;
            private property <length> page-padding: root.page-margin-pt * 1px * root.page-zoom;
            // Gap between sheets, from the same constant the layout uses.
            property <length> gap: root.page-gap-pt * 1px * root.page-zoom;

            x: max(24px, (page-scroll.width - self.width) / 2);
            y: 24px;
            width: self.raw-width * root.page-zoom;
            // The container spans the whole stack; the paper itself is drawn
            // one sheet per page below, at the pitch the layout projects.
            height: root.page-count > 1
                ? root.page-stack-height * root.page-zoom
                : self.raw-height * root.page-zoom;
            background: transparent;

            for offset in root.visible-page-count : Rectangle {
                x: 0px;
                y: (root.visible-page-first + offset) * (page.raw-height * root.page-zoom + page.gap);
                width: page.width;
                height: page.raw-height * root.page-zoom;
                border-radius: Theme.tokens.metrics.radius-small;
                border-width: 1px;
                border-color: Theme.palette().border;
                background: Theme.palette().paper;
                // A tight shadow: it must not reach the sheet above across the gap.
                drop-shadow-blur: 8px;
                drop-shadow-offset-y: 1px;
                drop-shadow-color: Theme.palette().shadow;
                accessible-role: none;
            }
            VerticalLayout {
                padding-top: page.page-padding;
                padding-bottom: page.page-padding;
                padding-left: page.page-padding;
                padding-right: page.page-padding;
                spacing: 0px;

                document-editor := WriterDocumentEditor {
                    text <=> root.doc-content;
                    render-blocks <=> root.render-blocks;
                    selection-rects <=> root.selection-rects;
                    comment-rects: root.comment-rects;
                    table-cell-rects: root.table-cell-rects;
                    document-accessible-label: root.document-accessible-label;
                    selection-anchor <=> root.selection-anchor;
                    selection-focus <=> root.selection-focus;
                    page-zoom: root.page-zoom;
                    font-size: 11px * root.page-zoom;
                    edited(value, anchor, focus) => { root.document-edited(value, anchor, focus); }
                    selection-changed(anchor, focus) => { root.selection-changed(anchor, focus); }
                    pointer-pressed(x, y, extend) => { root.pointer-pressed(x, y, extend); }
                    pointer-moved(x, y) => { root.pointer-moved(x, y); }
                    pointer-released(x, y) => { root.pointer-released(x, y); }
                    pointer-cancelled => { root.pointer-cancelled(); }
                    key-pressed(event) => { return root.key-pressed(event); }
                }
            }
            // An icon-only chip: its label is spoken, never drawn, so it cannot
            // run past the page edge at any zoom or text scale.
            for comment in root.comment-rects : CommentMarker {
                visible: comment.marker;
                x: page.width - page.page-padding / 2 - self.width / 2;
                y: page.page-padding + comment.y * root.page-zoom - self.height / 2;
                label: comment.label;
                clicked => { root.activate-comment(comment.comment-id); }
            }
        }
    }
}

/// App-local status surface using canonical LoomStatusBar.
export component WriterStatusBar inherits LoomStatusBar {
    // The shared bar is a fixed 28 px, which left the 2.0x caption 2 px of room
    // below. Writer's bar grows to hold its own caption and never shrinks below
    // the shared height.
    min-height: max(Theme.tokens.metrics.status-height, Theme.type.caption * 1.6 + 2 * Theme.tokens.space.xs);
    max-height: max(Theme.tokens.metrics.status-height, Theme.type.caption * 1.6 + 2 * Theme.tokens.space.xs);
    in property <string> leading-text: "";
    in property <string> trailing-text: "";
    // Right-to-left puts the leading status at the right edge.
    if !Theme.rtl : LoomStatusText {
        text: root.leading-text;
        live: true;
        horizontal-stretch: 1;
    }
    if !Theme.rtl : LoomStatusText {
        text: root.trailing-text;
    }
    if Theme.rtl : LoomStatusText {
        text: root.trailing-text;
    }
    if Theme.rtl : LoomStatusText {
        text: root.leading-text;
        live: true;
        horizontal-stretch: 1;
        horizontal-alignment: right;
    }
}
