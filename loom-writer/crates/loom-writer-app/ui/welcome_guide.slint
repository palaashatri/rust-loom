import { LoomButton } from "foundation.slint";
import { Icon } from "icons.slint";
import { Theme } from "theme.slint";
import { WelcomeIllustrationStage } from "welcome_illustrations.slint";

export global WelcomeGuideState {
    in-out property <bool> open: false;
    in-out property <int> step: 0;
    in-out property <string> mod-key: "Ctrl+";
    in-out property <bool> focus-request: false;
    callback close-guide();
    callback try-action(string);
}

component StepBullet inherits Rectangle {
    in property <string> text-value;
    height: max(Theme.tokens.metrics.icon-small + 4px, bullet-text.preferred-height);

    Rectangle {
        x: Theme.rtl ? parent.width - self.width : 0px;
        y: 2px;
        width: max(18px, Theme.tokens.metrics.icon-small + 4px);
        height: self.width;
        border-radius: self.width / 2;
        background: Theme.palette().selection-soft;

        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            icon: "check";
            tint: Theme.palette().accent;
            size: max(10px, Theme.tokens.metrics.icon-small - 2px);
        }
    }

    bullet-text := Text {
        property <length> lead-w: max(18px, Theme.tokens.metrics.icon-small + 4px) + Theme.tokens.space.md;
        x: Theme.rtl ? 0px : self.lead-w;
        y: (parent.height - self.height) / 2;
        width: max(40px, parent.width - self.lead-w);
        height: self.preferred-height;
        text: root.text-value;
        color: Theme.palette().ink;
        font-family: Theme.ui-font-family;
        font-size: Theme.type.body;
        wrap: word-wrap;
        horizontal-alignment: Theme.rtl ? right : left;
    }
}

export component WelcomeGuideModal inherits Rectangle {
    in property <bool> open: WelcomeGuideState.open;
    in property <int> step-watch: WelcomeGuideState.step;
    changed step-watch => { lesson-scroll.viewport-y = 0px; }
    property <bool> guide-open: root.open;
    property <bool> focus-req: WelcomeGuideState.focus-request;

    width: 100%;
    height: 100%;
    visible: root.open;
    background: Theme.palette().scrim;

    pure function clamped-step() -> int {
        WelcomeGuideState.step < 0 ? 0 : WelcomeGuideState.step > 6 ? 6 : WelcomeGuideState.step
    }

    pure function dot-step(idx: int) -> int { Theme.rtl ? (6 - idx) : idx }

    pure function step-title(s: int) -> string {
        [
            "Welcome to Loom Writer",
            "Typography, Styles & Languages",
            "Tables, Pictures & Charts",
            "Headers, Footers & Footnotes",
            "Review, Comments & Tracked Changes",
            "Print Preview & Multi-Format Export",
            "Command Palette & Shortcuts",
        ][s]
    }

    pure function step-subtitle(s: int) -> string {
        [
            "Local-first documents with automatic crash recovery and 18 ready-to-use templates.",
            "Rich character and paragraph formatting across Latin and RTL/bidi scripts.",
            "Structured content blocks built for clean pagination, resizing, and accessibility.",
            "Running page furniture and smart footnotes that flow cleanly across pages.",
            "Collaborate with anchored discussions, tracked edits, and revision-aware output.",
            "Inspect exact page geometry and export faithful PDF, Word, and Markdown files.",
            "Navigate every tool by keyboard and tune Loom Writer to your display theme.",
        ][s]
    }

    pure function step-bullet-one(s: int) -> string {
        [
            "Save native .loomdoc files locally or open and export Microsoft Word .docx documents.",
            "Apply heading styles, font families, text colors, highlights, superscript, and subscript.",
            "Create typed tables with merged or split cells and custom column proportions.",
            "Add headers and footers with dynamic page and total-page fields.",
            "Attach anchored comments to selections and record insertions and deletions as revisions.",
            "Adjust paper size, orientation, and margin presets right inside Print Preview.",
            "Press " + WelcomeGuideState.mod-key + "K or " + WelcomeGuideState.mod-key + "Shift+P for the Command Palette, and F1 for this guide.",
        ][s]
    }

    pure function step-bullet-two(s: int) -> string {
        [
            "Crash recovery checkpoints keep unsaved edits safe between sessions.",
            "Format bulleted and numbered lists, alignment, justification, and indentation.",
            "Insert resizable pictures with alt text and preserve pasted charts cleanly.",
            "Suppress first-page headers or footers for title and cover layouts.",
            "Export PDFs in either Final or Review view and round-trip revisions with .docx.",
            "Switch between Final and With Markup views before saving to PDF.",
            "Search by action name or shortcut, and switch Light, Dark, or High-Contrast themes.",
        ][s]
    }

    pure function step-bullet-three(s: int) -> string {
        [
            "Start immediately from 18 built-in templates spanning memos, reports, briefs, and CVs.",
            "Full RTL and bidirectional text layout mirrors smoothly at any UI scale.",
            "Navigate cells and media directly with keyboard focus and inspector controls.",
            "Long footnotes paginate automatically with continued overflow across page breaks.",
            "Accept or reject tracked edits individually or all at once from the Review drawer.",
            "Share finished documents cleanly to PDF, Word (.docx), or plain Markdown.",
            "Use " + WelcomeGuideState.mod-key + "S to save, " + WelcomeGuideState.mod-key + "Z to undo, and Escape to return focus to the page.",
        ][s]
    }

    pure function try-label(s: int) -> string {
        [
            "Browse Templates", "Load Practice Document", "Insert Sample Table",
            "Open Headers & Footers", "Open Tracked Changes", "Open Print Preview",
            "Open Command Palette",
        ][s]
    }

    pure function try-action-id(s: int) -> string {
        ["templates", "sample-doc", "insert-table", "headers-footers", "review-panel", "print-preview", "palette"][s]
    }

    function step-prev() {
        if (root.clamped-step() > 0) { WelcomeGuideState.step = root.clamped-step() - 1; }
    }

    function step-next() {
        if (root.clamped-step() < 6) {
            WelcomeGuideState.step = root.clamped-step() + 1;
        } else {
            WelcomeGuideState.close-guide();
        }
    }

    function focus-initial() {
        if (root.open) {
            key-handler.focus();
            next-btn.grab-focus();
        }
    }

    init => { root.focus-initial(); }
    changed guide-open => { root.focus-initial(); }
    changed focus-req => { root.focus-initial(); }

    backdrop-touch := TouchArea {
        enabled: root.open;
        clicked => { WelcomeGuideState.close-guide(); }
    }

    key-handler := FocusScope {
        enabled: root.open;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(parent.width - 48px, 780px * (1.0 + 0.24 * (max(1.0, Theme.text-scale) - 1.0)));
        height: min(parent.height - 72px, max(440px, 470px + 96px * (max(1.0, Theme.text-scale) - 1.0)));

        property <bool> wide-stage: self.width >= 640px;
        property <length> stage-w: self.wide-stage ? 280px : 0px;

        key-pressed(event) => {
            if (!root.open) { return reject; }
            if (event.text == Key.Escape) { WelcomeGuideState.close-guide(); return accept; }
            if (event.text == Key.LeftArrow) {
                if (Theme.rtl) { if (root.clamped-step() < 6) { root.step-next(); } } else { root.step-prev(); }
                return accept;
            }
            if (event.text == Key.RightArrow) {
                if (Theme.rtl) { root.step-prev(); } else if (root.clamped-step() < 6) { root.step-next(); }
                return accept;
            }
            if ((event.text == Key.Tab && event.modifiers.shift) || event.text == Key.Backtab) {
                if (close-btn.has-focus) { next-btn.grab-focus(); }
                else if (next-btn.has-focus) {
                    if (root.clamped-step() > 0) { prev-btn.grab-focus(); } else { try-btn.grab-focus(); }
                } else if (prev-btn.has-focus) { try-btn.grab-focus(); }
                else { close-btn.grab-focus(); }
                return accept;
            }
            if (event.text == Key.Tab) {
                if (close-btn.has-focus) { try-btn.grab-focus(); }
                else if (try-btn.has-focus) {
                    if (root.clamped-step() > 0) { prev-btn.grab-focus(); } else { next-btn.grab-focus(); }
                } else if (prev-btn.has-focus) { next-btn.grab-focus(); }
                else { close-btn.grab-focus(); }
                return accept;
            }
            if (event.text == Key.DownArrow || event.text == Key.PageDown) {
                let min-y = min(0px, lesson-scroll.height - lesson-scroll.viewport-height);
                let step-y = event.text == Key.PageDown ? max(48px, lesson-scroll.height * 0.8) : 36px;
                lesson-scroll.viewport-y = clamp(lesson-scroll.viewport-y - step-y, min-y, 0px);
                return accept;
            }
            if (event.text == Key.UpArrow || event.text == Key.PageUp) {
                let min-y = min(0px, lesson-scroll.height - lesson-scroll.viewport-height);
                let step-y = event.text == Key.PageUp ? max(48px, lesson-scroll.height * 0.8) : 36px;
                lesson-scroll.viewport-y = clamp(lesson-scroll.viewport-y + step-y, min-y, 0px);
                return accept;
            }
            return reject;
        }

        card := Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.palette().surface;
            border-radius: Theme.tokens.metrics.radius-large;
            border-width: 1px;
            border-color: Theme.palette().border-strong;
            drop-shadow-blur: 32px;
            drop-shadow-offset-y: 12px;
            drop-shadow-color: Theme.palette().shadow;
            clip: true;

            TouchArea { enabled: root.open; }

            VerticalLayout {
                spacing: 0px;
                padding: 0px;

                body-split := Rectangle {
                    vertical-stretch: 1;

                    if key-handler.wide-stage : WelcomeIllustrationStage {
                        x: Theme.rtl ? parent.width - self.width : 0px;
                        y: 0px;
                        width: key-handler.stage-w;
                        height: parent.height;
                        step: root.clamped-step();
                        mod-key: WelcomeGuideState.mod-key;
                    }

                    if key-handler.wide-stage : Rectangle {
                        x: Theme.rtl ? parent.width - key-handler.stage-w - 1px : key-handler.stage-w;
                        y: 0px;
                        width: 1px;
                        height: parent.height;
                        background: Theme.palette().border;
                    }

                    content-pane := Rectangle {
                        x: Theme.rtl ? 0px : (key-handler.wide-stage ? key-handler.stage-w + 1px : 0px);
                        y: 0px;
                        width: key-handler.wide-stage ? parent.width - key-handler.stage-w - 1px : parent.width;
                        height: parent.height;

                        VerticalLayout {
                            padding: Theme.tokens.space.xxl;
                            spacing: Theme.tokens.space.md;

                            if !key-handler.wide-stage : WelcomeIllustrationStage {
                                height: 144px;
                                border-radius: Theme.tokens.metrics.radius-medium;
                                border-width: 1px;
                                border-color: Theme.palette().border;
                                step: root.clamped-step();
                                mod-key: WelcomeGuideState.mod-key;
                                compact: true;
                            }

                            top-bar := Rectangle {
                                height: max(step-pill.height, close-btn.preferred-height);

                                step-pill := Rectangle {
                                    x: Theme.rtl ? parent.width - self.width : 0px;
                                    y: (parent.height - self.height) / 2;
                                    width: pill-label.preferred-width + Theme.tokens.space.lg;
                                    height: pill-label.preferred-height + Theme.tokens.space.sm;
                                    border-radius: self.height / 2;
                                    background: Theme.palette().selection-soft;
                                    border-width: 1px;
                                    border-color: Theme.active-theme == "high-contrast" ? Theme.palette().accent : transparent;

                                    pill-label := Text {
                                        text: "STEP " + (root.clamped-step() + 1) + " OF 7";
                                        color: Theme.palette().accent;
                                        font-family: Theme.ui-font-family;
                                        font-size: Theme.type.caption;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                close-btn := LoomButton {
                                    x: Theme.rtl ? 0px : parent.width - self.width;
                                    y: (parent.height - self.height) / 2;
                                    width: self.preferred-width;
                                    height: self.preferred-height;
                                    label: "Close";
                                    icon: "close";
                                    variant: "ghost";
                                    accessible-name: "Close Welcome Guide";
                                    clicked => { WelcomeGuideState.close-guide(); }
                                }
                            }

                            Text {
                                text: root.step-title(root.clamped-step());
                                color: Theme.palette().ink;
                                font-family: Theme.ui-font-family;
                                font-size: Theme.type.display;
                                font-weight: 700;
                                wrap: word-wrap;
                                horizontal-alignment: Theme.rtl ? right : left;
                            }

                            lesson-scroll := Flickable {
                                vertical-stretch: 1;
                                viewport-height: body-col.preferred-height;

                                body-col := VerticalLayout {
                                    width: parent.width;
                                    spacing: Theme.tokens.space.md;

                                    Text {
                                        text: root.step-subtitle(root.clamped-step());
                                        color: Theme.palette().ink-secondary;
                                        font-family: Theme.ui-font-family;
                                        font-size: Theme.type.body;
                                        wrap: word-wrap;
                                        horizontal-alignment: Theme.rtl ? right : left;
                                    }

                                    Rectangle {
                                        background: Theme.palette().surface-raised;
                                        border-radius: Theme.tokens.metrics.radius-medium;
                                        border-width: 1px;
                                        border-color: Theme.palette().border;

                                        VerticalLayout {
                                            padding: Theme.tokens.space.lg;
                                            spacing: Theme.tokens.space.md;
                                            StepBullet { text-value: root.step-bullet-one(root.clamped-step()); }
                                            StepBullet { text-value: root.step-bullet-two(root.clamped-step()); }
                                            StepBullet { text-value: root.step-bullet-three(root.clamped-step()); }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                height: try-btn.preferred-height + 8px;

                                try-btn := LoomButton {
                                    x: Theme.rtl ? parent.width - self.width - 4px : 4px;
                                    y: 4px;
                                    width: self.preferred-width;
                                    height: self.preferred-height;
                                    label: "Try: " + root.try-label(root.clamped-step());
                                    icon: "sparkle";
                                    variant: "secondary";
                                    accessible-name: "Try " + root.try-label(root.clamped-step());
                                    clicked => {
                                        WelcomeGuideState.try-action(root.try-action-id(root.clamped-step()));
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.palette().border; }

                footer-bar := Rectangle {
                    height: max(56px, max(dots-row.preferred-height, nav-group.height) + Theme.tokens.space.xl);
                    background: Theme.palette().chrome;

                    footer-inner := Rectangle {
                        x: Theme.tokens.space.xl;
                        y: (parent.height - self.height) / 2;
                        width: parent.width - 2 * Theme.tokens.space.xl;
                        height: max(dots-row.preferred-height, nav-group.height);

                        dots-row := HorizontalLayout {
                            x: Theme.rtl ? parent.width - self.width : 0px;
                            y: (parent.height - self.height) / 2;
                            width: self.preferred-width;
                            height: self.preferred-height;
                            spacing: Theme.tokens.space.xs;

                            for idx in [0, 1, 2, 3, 4, 5, 6]: TouchArea {
                                width: 24px;
                                height: 24px;
                                accessible-role: button;
                                accessible-label: "Welcome Guide Step " + (root.dot-step(idx) + 1);
                                accessible-action-default => { WelcomeGuideState.step = root.dot-step(idx); }
                                clicked => { WelcomeGuideState.step = root.dot-step(idx); }

                                Rectangle {
                                    width: root.dot-step(idx) == root.clamped-step() ? 22px : 8px;
                                    height: 8px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 4px;
                                    background: root.dot-step(idx) == root.clamped-step()
                                        ? Theme.palette().accent : Theme.palette().ink-secondary;
                                }
                            }
                        }

                        if key-handler.width >= 720px && Theme.text-scale < 1.35 : Text {
                            text: "\u{2190} \u{2192} Navigate  \u{2022}  Esc Close";
                            color: Theme.palette().ink-secondary;
                            font-family: Theme.ui-font-family;
                            font-size: Theme.type.caption;
                            x: Theme.rtl
                                ? nav-group.x + nav-group.width + Theme.tokens.space.md
                                : dots-row.x + dots-row.width + Theme.tokens.space.md;
                            width: max(0px, Theme.rtl
                                ? dots-row.x - Theme.tokens.space.md - self.x
                                : nav-group.x - Theme.tokens.space.md - self.x);
                            height: parent.height;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            overflow: elide;
                        }

                        nav-group := Rectangle {
                            x: Theme.rtl ? 4px : parent.width - self.width - 4px;
                            y: (parent.height - self.height) / 2;
                            width: prev-btn.preferred-width + Theme.tokens.space.md + next-btn.preferred-width;
                            height: max(prev-btn.preferred-height, next-btn.preferred-height);

                            prev-btn := LoomButton {
                                x: Theme.rtl ? next-btn.preferred-width + Theme.tokens.space.md : 0px;
                                y: (parent.height - self.height) / 2;
                                width: self.preferred-width;
                                height: self.preferred-height;
                                label: "Previous";
                                icon: Theme.rtl ? "chevron-right" : "chevron-left";
                                variant: "secondary";
                                enabled: root.clamped-step() > 0;
                                accessible-name: "Previous Welcome Step";
                                clicked => { root.step-prev(); }
                            }

                            next-btn := LoomButton {
                                x: Theme.rtl ? 0px : prev-btn.preferred-width + Theme.tokens.space.md;
                                y: (parent.height - self.height) / 2;
                                width: self.preferred-width;
                                height: self.preferred-height;
                                label: root.clamped-step() < 6 ? "Next" : "Get Started";
                                icon: root.clamped-step() < 6 ? (Theme.rtl ? "chevron-left" : "chevron-right") : "check";
                                variant: "primary";
                                accessible-name: root.clamped-step() < 6 ? "Next Welcome Step" : "Finish Welcome Guide";
                                clicked => { root.step-next(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
