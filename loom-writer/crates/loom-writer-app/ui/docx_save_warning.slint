import { LoomButton } from "foundation.slint";
import { Theme } from "theme.slint";

export global DocxSaveWarningState {
    in-out property <bool> dialog-open: false;
    in-out property <string> warning-message: "";
    callback continue-docx;
    callback cancel-docx;
}

export component DocxSaveWarningDialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> warning-message: "";

    callback continue-docx;
    callback cancel-docx;

    visible: root.open;

    init => {
        if (root.open) { cancel-button.grab-focus(); }
    }

    changed open => {
        if (root.open) { cancel-button.grab-focus(); }
    }

    warning-focus := FocusScope {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        enabled: root.open;
        visible: root.open;

        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel-docx();
                return accept;
            }
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                if (cancel-button.has-focus) {
                    continue-button.grab-focus();
                } else {
                    cancel-button.grab-focus();
                }
                return accept;
            }
            return reject;
        }

        Rectangle {
            width: root.width;
            height: root.height;
            background: Theme.palette().scrim;

            TouchArea {
                clicked => { cancel-button.grab-focus(); }
            }

            Rectangle {
                width: min(600px * max(1.0, Theme.text-scale), root.width - 32px);
                height: min(dialog-layout.preferred-height, root.height - 32px);
                x: (root.width - self.width) / 2;
                y: (root.height - self.height) / 2;
                background: Theme.palette().surface;
                border-width: 1px;
                border-color: Theme.palette().border;
                border-radius: Theme.tokens.metrics.radius-large;
                drop-shadow-blur: 24px;
                drop-shadow-offset-y: 8px;
                drop-shadow-color: Theme.palette().shadow;
                accessible-role: AccessibleRole.region;

                dialog-layout := VerticalLayout {
                    padding: Theme.tokens.space.xl;
                    spacing: Theme.tokens.space.md;

                    Text {
                        text: "Save as Word Document?";
                        font-size: Theme.tokens.typography.heading * max(1.0, Theme.text-scale);
                        font-weight: 700;
                        color: Theme.palette().ink;
                        horizontal-alignment: Theme.rtl ? right : left;
                    }

                    Text {
                        text: root.warning-message;
                        font-size: Theme.type.body;
                        color: Theme.palette().ink-secondary;
                        wrap: word-wrap;
                        horizontal-alignment: Theme.rtl ? right : left;
                    }

                    Rectangle {
                        height: Theme.tokens.metrics.control-height;
                        continue-button := LoomButton {
                            label: "Continue with DOCX";
                            variant: "primary";
                            width: self.preferred-width;
                            height: Theme.tokens.metrics.control-height;
                            x: Theme.rtl ? 0px : parent.width - self.width;
                            clicked => { root.continue-docx(); }
                        }
                        cancel-button := LoomButton {
                            label: "Cancel";
                            variant: "secondary";
                            width: self.preferred-width;
                            height: Theme.tokens.metrics.control-height;
                            x: Theme.rtl ? continue-button.width + Theme.tokens.space.sm : continue-button.x - Theme.tokens.space.sm - self.width;
                            clicked => { root.cancel-docx(); }
                        }
                    }
                }
            }
        }
    }
}
