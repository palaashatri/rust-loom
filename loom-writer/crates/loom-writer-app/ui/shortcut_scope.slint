// Writer's window-level keyboard shortcuts. The scope wraps the whole window
// content, so a key that no focused control takes reaches these handlers, and
// Alt+letter reaches the menus from inside a text field.
import { FindBar } from "find_bar.slint";

export component WriterShortcutScope inherits FocusScope {
    in property <bool> palette-open;
    in property <bool> template-chooser-open;
    in property <bool> save-changes-open;
    in property <bool> modal-open: false;
    in property <int> toolbar-menu-kind;
    callback open-menu-for-key(KeyEvent) -> bool;
    callback leave-chrome(bool);
    callback shortcut-pressed(string, bool, bool) -> bool;
    callback open-palette();
    callback new-doc();
    callback open-doc();
    callback save-doc();
    callback save-as-doc();
    callback export-pdf();
    callback toggle-bold();
    callback toggle-italic();
    callback toggle-underline();
    callback undo();
    callback redo();

    pure function is-standard-editor-chord(event: KeyEvent) -> bool {
        let t = event.text;
        let plain = !event.modifiers.shift && !event.modifiers.alt;
        if (plain && (t == "a" || t == "A" || t == "c" || t == "C" || t == "x" || t == "X"
            || t == "v" || t == "V" || t == "z" || t == "Z" || t == "y" || t == "Y"
            || t == "b" || t == "B" || t == "i" || t == "I" || t == "u" || t == "U"
            || t == "n" || t == "N" || t == "o" || t == "O" || t == "s" || t == "S"
            || t == "e" || t == "E")) {
            return true;
        }
        if (event.modifiers.shift && !event.modifiers.alt && (t == "z" || t == "Z" || t == "s" || t == "S")) {
            return true;
        }
        return t == Key.LeftArrow || t == Key.RightArrow || t == Key.UpArrow || t == Key.DownArrow
            || t == Key.Home || t == Key.End || t == Key.Return || t == Key.Tab
            || t == Key.Backspace || t == Key.Delete;
    }

    // A window-wide shortcut scope, not a control: Tab skips it.
    focus-on-tab-navigation: false;
    // Alt+letter, F10, F1, and extended chords reach the shell even from a focused
    // TextInput (the page, find bar, or comment box), which would otherwise consume
    // shifted/Option printable keys before they bubble up.
    capture-key-pressed(event) => {
        if (root.modal-open) { return reject; }
        if (root.open-menu-for-key(event)) { return accept; }
        if (!root.palette-open && !root.template-chooser-open && root.toolbar-menu-kind == 0 && !root.save-changes-open) {
            if (event.text == Key.F1 && !event.modifiers.control && !event.modifiers.meta && !event.modifiers.alt && !event.modifiers.shift) {
                if (root.shortcut-pressed("F1", false, false)) { return accept; }
            }
            if ((event.modifiers.control || event.modifiers.meta) && !root.is-standard-editor-chord(event)) {
                if (root.shortcut-pressed(event.text, event.modifiers.shift, event.modifiers.alt)) {
                    return accept;
                }
            }
        }
        return reject;
    }
    key-pressed(event) => {
        if (root.palette-open || root.template-chooser-open || root.toolbar-menu-kind != 0 || root.save-changes-open || root.modal-open) { return reject; }
        if (event.text == Key.F6) { root.leave-chrome(event.modifiers.shift); return accept; }
        if (event.text == Key.F1 && !event.modifiers.control && !event.modifiers.meta && !event.modifiers.alt && !event.modifiers.shift) {
            if (root.shortcut-pressed("F1", false, false)) { return accept; }
        }
        if (event.text == Key.F3) {
            if (event.modifiers.shift) { FindBar.find-previous(); } else { FindBar.find-next(); }
            return accept;
        }
        if (root.open-menu-for-key(event)) { return accept; }
        if (event.modifiers.control || event.modifiers.meta) {
            if (!event.modifiers.shift && !event.modifiers.alt) {
                if (event.text == Key.K || event.text == "k" || event.text == "K") {
                    root.open-palette();
                    return accept;
                }
                if (event.text == "n" || event.text == "N") {
                    root.new-doc();
                    return accept;
                }
                if (event.text == "o" || event.text == "O") {
                    root.open-doc();
                    return accept;
                }
                if (event.text == "s" || event.text == "S") {
                    root.save-doc();
                    return accept;
                }
                if (event.text == "e" || event.text == "E") {
                    root.export-pdf();
                    return accept;
                }
                if (event.text == "b" || event.text == "B") {
                    root.toggle-bold();
                    return accept;
                }
                if (event.text == "i" || event.text == "I") {
                    root.toggle-italic();
                    return accept;
                }
                if (event.text == "u" || event.text == "U") {
                    root.toggle-underline();
                    return accept;
                }
                if (event.text == "z" || event.text == "Z") {
                    root.undo();
                    return accept;
                }
                if (event.text == "f" || event.text == "F") {
                    FindBar.open-requested(false);
                    return accept;
                }
                if (event.text == "h" || event.text == "H") {
                    FindBar.open-requested(true);
                    return accept;
                }
            }
            if (event.modifiers.shift && !event.modifiers.alt) {
                if (event.text == "s" || event.text == "S") {
                    root.save-as-doc();
                    return accept;
                }
                if (event.text == "z" || event.text == "Z") {
                    root.redo();
                    return accept;
                }
            }
            if (root.shortcut-pressed(event.text, event.modifiers.shift, event.modifiers.alt)) {
                return accept;
            }
        }
        return reject;
    }
    @children
}
