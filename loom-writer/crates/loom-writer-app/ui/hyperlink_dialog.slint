import { LoomButton } from "foundation.slint";
import { Theme } from "theme.slint";

export component HyperlinkDialog inherits Rectangle {
    in-out property <string> url-text: "";
    in-out property <string> tooltip-text: "";
    in property <string> error-text: "";
    in property <bool> has-existing: false;

    callback apply-link(string, string);
    callback remove-link();
    callback cancel();

    width: 400px;
    height: 220px;
    background: Theme.palette().surface;
    border-radius: Theme.tokens.metrics.radius-medium;
    border-width: 1px;
    border-color: Theme.palette().border;
    forward-focus: url-input;
    init => { url-input.focus(); }

    VerticalLayout {
        spacing: 10px;
        padding: 12px;

        Text {
            text: "Insert Hyperlink";
            font-size: 14px;
            font-weight: 600;
            color: Theme.palette().ink;
        }

        Rectangle {
            height: 30px;
            border-radius: Theme.tokens.metrics.radius-small;
            border-width: 1px;
            border-color: Theme.palette().border;
            background: Theme.palette().surface-sunken;
            url-input := TextInput {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                vertical-alignment: center;
                text <=> root.url-text;
                color: Theme.palette().ink;
                accessible-role: text-input;
                accessible-label: "Hyperlink URL";
            }
        }

        Rectangle {
            height: 30px;
            border-radius: Theme.tokens.metrics.radius-small;
            border-width: 1px;
            border-color: Theme.palette().border;
            background: Theme.palette().surface-sunken;
            TextInput {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                vertical-alignment: center;
                text <=> root.tooltip-text;
                color: Theme.palette().ink;
                accessible-role: text-input;
                accessible-label: "Hyperlink Tooltip";
            }
        }

        if root.error-text != "" : Text {
            text: root.error-text;
            color: Theme.palette().danger;
            font-size: 11px;
            wrap: word-wrap;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            if root.has-existing : LoomButton {
                label: "Remove";
                accessible-label: "Remove hyperlink";
                clicked => { root.remove-link(); }
            }
            LoomButton {
                label: "Cancel";
                accessible-label: "Cancel hyperlink dialog";
                clicked => { root.cancel(); }
            }
            LoomButton {
                label: "Apply";
                variant: "primary";
                accessible-label: "Apply hyperlink";
                clicked => { root.apply-link(root.url-text, root.tooltip-text); }
            }
        }
    }
}
