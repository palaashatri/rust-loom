import {
    AppHeader, WorkspaceToolbar, ToolButton, IconButton, StatusBar,
    SegmentedControl, CanvasBackdrop, Slider, MetricChip
} from "components.slint";
import { Theme } from "theme.slint";
import { TextEdit } from "std-widgets.slint";
export { Theme } from "theme.slint";
export { Palette as WidgetPalette } from "std-widgets.slint";

export component WriterApp inherits Window {
    title: "Loom Writer";
    min-width: 980px;
    min-height: 680px;
    background: Theme.palette().canvas;

    in property <string> doc-title: "Untitled";
    in-out property <string> doc-content: "";
    in property <string> status-left: "";
    in property <string> status-right: "";
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;

    in-out property <bool> is-bold: false;
    in-out property <bool> is-italic: false;
    in-out property <bool> is-underline: false;
    in-out property <int> heading-level: 0;
    in-out property <int> text-alignment: 0;
    in-out property <float> zoom-value: 88.0;

    callback new-doc;
    callback open-doc;
    callback save-doc;
    callback export-pdf;
    callback undo;
    callback redo;
    callback document-edited(string);
    callback toggle-bold;
    callback toggle-italic;
    callback toggle-underline;
    callback select-heading(int);
    callback select-alignment(int);

    VerticalLayout {
        spacing: 0px;

        AppHeader {
            app-name: "Loom Writer";
            document-title: root.doc-title;
            icon: "document";
            context: "Open document package";
            state-text: "Editing locally";
            state-tone: 0;
        }

        WorkspaceToolbar {
            ToolButton { icon: "new"; text: "New"; clicked => { root.new-doc(); } }
            ToolButton { icon: "open"; text: "Open"; clicked => { root.open-doc(); } }
            ToolButton { icon: "save"; text: "Save"; clicked => { root.save-doc(); } }
            Rectangle { width: 1px; height: 20px; background: Theme.palette().border; }
            IconButton { icon: "undo"; label: "Undo"; enabled: root.can-undo; clicked => { root.undo(); } }
            IconButton { icon: "redo"; label: "Redo"; enabled: root.can-redo; clicked => { root.redo(); } }
            Rectangle { width: 1px; height: 20px; background: Theme.palette().border; }

            SegmentedControl {
                items: ["Body", "H1", "H2", "H3"];
                current <=> root.heading-level;
                selected(idx) => { root.select-heading(idx); }
            }
            ToolButton {
                text: "B";
                checked: root.is-bold;
                clicked => { root.is-bold = !root.is-bold; root.toggle-bold(); }
            }
            ToolButton {
                text: "I";
                checked: root.is-italic;
                clicked => { root.is-italic = !root.is-italic; root.toggle-italic(); }
            }
            ToolButton {
                text: "U";
                checked: root.is-underline;
                clicked => { root.is-underline = !root.is-underline; root.toggle-underline(); }
            }
            SegmentedControl {
                items: ["Left", "Center", "Right"];
                current <=> root.text-alignment;
                selected(idx) => { root.select-alignment(idx); }
            }

            Rectangle { horizontal-stretch: 1; background: transparent; }
            MetricChip { label: "Zoom"; value: Math.round(root.zoom-value) + "%"; }
            ToolButton { icon: "export"; text: "Export PDF"; clicked => { root.export-pdf(); } }
        }

        CanvasBackdrop {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            stage-color: Theme.palette().canvas-alt;

            Rectangle {
                width: min(806px, parent.width - 96px);
                height: parent.height - 64px;
                border-radius: 7px;
                background: Theme.palette().shadow;
            }

            Rectangle {
                width: min(794px, parent.width - 108px);
                height: parent.height - 76px;
                border-radius: 5px;
                background: Theme.palette().paper;
                border-width: 1px;
                border-color: Theme.palette().paper-line;
                clip: true;

                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: 28px;
                    background: Theme.palette().content-accent-soft;
                    border-width: 0px;

                    HorizontalLayout {
                        spacing: 0px;
                        padding-left: 56px;
                        padding-right: 56px;
                        for marker in ["0", "1", "2", "3", "4", "5", "6", "7"] : Rectangle {
                            horizontal-stretch: 1;
                            Text {
                                text: marker;
                                font-size: Theme.tokens.typography.micro;
                                color: Theme.palette().paper-muted;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                x: 0px;
                                y: parent.height - 8px;
                                width: 1px;
                                height: 8px;
                                background: Theme.palette().paper-line;
                            }
                        }
                    }
                }

                VerticalLayout {
                    x: 0px;
                    y: 28px;
                    width: parent.width;
                    height: parent.height - 28px;
                    padding-left: 66px;
                    padding-right: 66px;
                    padding-top: 40px;
                    padding-bottom: 44px;
                    spacing: 15px;

                    Text {
                        text: root.doc-title;
                        font-size: Theme.tokens.typography.heading;
                        font-weight: 700;
                        color: Theme.palette().paper-ink;
                        horizontal-alignment: root.text-alignment == 1
                            ? center
                            : root.text-alignment == 2 ? right : left;
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.palette().paper-line;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        clip: true;

                        TextEdit {
                            width: parent.width;
                            height: parent.height;
                            text <=> root.doc-content;
                            font-size: Theme.tokens.typography.body-large;
                            placeholder-text: "Start writing…";
                            wrap: word-wrap;
                            edited => { root.document-edited(self.text); }
                            key-pressed(event) => {
                                if (event.modifiers.control && (event.text == "z" || event.text == "Z")) {
                                    if (event.modifiers.shift) {
                                        root.redo();
                                    } else {
                                        root.undo();
                                    }
                                    accept
                                } else if (event.modifiers.control && (event.text == "y" || event.text == "Y")) {
                                    root.redo();
                                    accept
                                }
                                reject
                            }
                        }
                    }
                }
            }

            Rectangle {
                x: parent.width - 280px;
                y: parent.height - 56px;
                width: 250px;
                height: 34px;
                border-radius: 9px;
                background: Theme.palette().overlay;
                border-width: 1px;
                border-color: Theme.palette().border;

                HorizontalLayout {
                    spacing: 8px;
                    padding-left: 9px;
                    padding-right: 9px;
                    IconButton {
                        icon: "minus";
                        label: "Zoom out";
                        clicked => { root.zoom-value = Math.max(40, root.zoom-value - 10); }
                    }
                    Slider {
                        label: "Zoom";
                        minimum: 40;
                        maximum: 160;
                        value <=> root.zoom-value;
                        horizontal-stretch: 1;
                    }
                    IconButton {
                        icon: "plus";
                        label: "Zoom in";
                        clicked => { root.zoom-value = Math.min(160, root.zoom-value + 10); }
                    }
                }
            }
        }

        StatusBar {
            status-left: root.status-left;
            status-right: root.status-right;
        }
    }
}
