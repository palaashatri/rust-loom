import {
    TitleChrome, ContextToolbar, LabeledToolbar, ToolbarGroup, ToolbarSpacer, ToolbarButton, DirectionalLayout,
    IconOnlyToolbarItem, Overflow, IconOverLabelToolbarItem, StatusBar, CanvasSurface, InspectorSurface,
    SectionHeader, TextField, SegmentedControl, PropertyRow, TemplateCard
} from "toolkit.slint";
import { CommandPalette, CommandPaletteItem } from "components.slint";
import { Icon } from "icons.slint";
import { Theme, ResponsivePolicy } from "theme.slint";
import {
    WriterToolbarBody, WriterPageCanvas, WriterInspector, WriterStatusBar,
    WriterToolbarOverflow
} from "writer_components.slint";
export { Theme, ResponsivePolicy } from "theme.slint";
export { Palette as WidgetPalette } from "std-widgets.slint";

export component WriterApp inherits Window {
    title: "Loom Writer";
    min-width: 900px;
    min-height: 680px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.palette().canvas;

    in property <bool> wide-toolbar: false;
    in property <bool> icon-only-toolbar: false;
    in property <bool> labeled-toolbar: false;
    in property <bool> labeled-export: false;
    in property <bool> overflow-toolbar: false;
    in property <bool> rtl: false;
    in-out property <bool> toolbar-overflow-open: false;
    in-out property <bool> show-inspector: false;
    in property <bool> inspector-available: true;
    property <bool> inspector-visible: root.show-inspector && root.inspector-available && !root.icon-only-toolbar;
    in-out property <int> inspector-tab: 0;
    callback window-resized(length);
    changed rtl => {
        Theme.rtl = root.rtl;
    }
    changed width => {
        root.window-resized(root.width);
        if (!ResponsivePolicy.priority-2-overflow(root.width)) {
            root.close-toolbar-overflow();
        }
    }

    in property <string> doc-title: "Untitled Document";
    in-out property <string> doc-content: "";
    in-out property <int> selection-anchor: 0;
    in-out property <int> selection-focus: 0;
    in property <string> status-left: "";
    in property <string> status-right: "";
    in property <string> selection-announcement: "No text selected";
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;

    in-out property <bool> is-bold: false;
    in-out property <bool> is-italic: false;
    in-out property <bool> is-underline: false;
    in-out property <int> heading-level: 0;
    in-out property <int> text-alignment: 0;

    in-out property <bool> template-chooser-open: false;
    in-out property <int> template-selected: 0;
    in-out property <int> template-category: 0;

    callback new-doc;
    callback open-doc;
    callback save-doc;
    callback save-as-doc;
    callback export-pdf;
    callback undo;
    callback redo;
    callback document-edited(string, int, int);
    callback selection-changed(int, int);
    callback toggle-bold;
    callback toggle-italic;
    callback toggle-underline;
    callback select-heading(int);
    callback select-alignment(int);
    callback toggle-inspector;
    callback create-template(int);
    callback cancel-template;

    in-out property <[CommandPaletteItem]> palette-commands: [];
    in-out property <bool> palette-open: false;
    in-out property <string> palette-query: "";
    in-out property <int> palette-selected: 0;
    callback palette-invoked(int);
    callback palette-query-changed(string);
    callback palette-move(int);
    callback palette-key-text(string);
    callback palette-backspace;
    callback palette-close;

    public function open-palette() {
        root.palette-open = true;
        root.palette-query = "";
        palette.grab-focus();
    }

    function template-visible(template-index: int) -> bool {
        return root.template-category == 0
            || (root.template-category == 1 && template-index <= 1)
            || (root.template-category == 2 && template-index == 2)
            || (root.template-category == 3 && template-index == 3);
    }

    function choose-template-category(category-index: int) {
        root.template-category = category-index;
        if (category-index == 1 && root.template-selected > 1) {
            root.template-selected = 0;
        } else if (category-index == 2) {
            root.template-selected = 2;
        } else if (category-index == 3) {
            root.template-selected = 3;
        }
    }

    function compact-label(full-label: string) -> string {
        return root.wide-toolbar ? full-label : "";
    }

    public function close-toolbar-overflow() {
        if (root.toolbar-overflow-open) {
            root.toolbar-overflow-open = false;
            app-focus.focus();
        }
    }

    changed overflow-toolbar => {
        if (!root.overflow-toolbar) {
            root.close-toolbar-overflow();
        }
    }

    overflow-menu-focus := FocusScope {
        enabled: root.toolbar-overflow-open;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-toolbar-overflow();
                return accept;
            }
            return reject;
        }
    }

    template-chooser-focus := FocusScope {
        enabled: root.template-chooser-open;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel-template();
                return accept;
            }
            if (event.text == Key.Return) {
                root.create-template(root.template-selected);
                return accept;
            }
            return reject;
        }
    }

    changed template-chooser-open => {
        if (root.template-chooser-open) {
            template-chooser-focus.focus();
        } else {
            app-focus.focus();
        }
    }

    changed palette-open => {
        if (!root.palette-open) {
            app-focus.focus();
        }
    }

    app-focus := FocusScope {
        key-pressed(event) => {
            if (root.palette-open || root.template-chooser-open || root.toolbar-overflow-open) { return reject; }
            if (event.modifiers.control || event.modifiers.meta) {
                if (event.text == Key.K || event.text == "k") {
                    root.open-palette();
                    return accept;
                }
                if (event.text == "n" || event.text == "N") {
                    root.new-doc();
                    return accept;
                }
                if (event.text == "o" || event.text == "O") {
                    root.open-doc();
                    return accept;
                }
                if (event.text == "s" || event.text == "S") {
                    if (event.modifiers.shift) { root.save-as-doc(); } else { root.save-doc(); }
                    return accept;
                }
                if (event.text == "e" || event.text == "E") {
                    root.export-pdf();
                    return accept;
                }
                if (event.text == "b" || event.text == "B") {
                    root.toggle-bold();
                    return accept;
                }
                if (event.text == "i" || event.text == "I") {
                    root.toggle-italic();
                    return accept;
                }
                if (event.text == "u" || event.text == "U") {
                    root.toggle-underline();
                    return accept;
                }
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0px;
            padding: 0px;

            // Document Chrome Titlebar
            TitleChrome {
                title: root.doc-title;
                trailing-text: "";
            }

            // Pages-style action toolbar. The host and its groups now choose
            // one slot each; responsive state only selects which host exists.
            if root.labeled-toolbar : LabeledToolbar {
                WriterToolbarBody {
                    rtl: root.rtl;
                    wide: true;
                    overflow: root.overflow-toolbar;
                    inspector-available: root.inspector-available;
                    inspector-visible: root.inspector-visible;
                    labeled-export: root.labeled-export;
                    toggle-inspector => { root.toggle-inspector(); }
                    export-pdf => { root.export-pdf(); }
                    overflow-requested => {
                        if (root.toolbar-overflow-open) {
                            root.close-toolbar-overflow();
                        } else {
                            root.toolbar-overflow-open = true;
                            overflow-menu-focus.focus();
                        }
                    }
                }
            }
            if !root.labeled-toolbar : ContextToolbar {
                WriterToolbarBody {
                    rtl: root.rtl;
                    wide: false;
                    overflow: root.overflow-toolbar;
                    inspector-available: root.inspector-available;
                    inspector-visible: root.inspector-visible;
                    labeled-export: root.labeled-export;
                    toggle-inspector => { root.toggle-inspector(); }
                    export-pdf => { root.export-pdf(); }
                    overflow-requested => {
                        if (root.toolbar-overflow-open) {
                            root.close-toolbar-overflow();
                        } else {
                            root.toolbar-overflow-open = true;
                            overflow-menu-focus.focus();
                        }
                    }
                }
            }

            // Main editor work area. The canvas and inspector own their
            // internal flow; this row only assigns the primary/secondary
            // workspace roles. The explicit branches mirror the secondary
            // inspector around the primary page because Slint's stable
            // HorizontalLayout does not reorder children for RTL.
            DirectionalLayout {
                spacing: 0px;
                vertical-stretch: 1;
                rtl: root.rtl;

                if !root.rtl : WriterPageCanvas {
                    doc-title: root.doc-title;
                    doc-content <=> root.doc-content;
                    selection-anchor <=> root.selection-anchor;
                    selection-focus <=> root.selection-focus;
                    selection-announcement: root.selection-announcement;
                    document-edited(value, anchor, focus) => { root.document-edited(value, anchor, focus); }
                    selection-changed(anchor, focus) => { root.selection-changed(anchor, focus); }
                    key-pressed(event) => { return reject; }
                }

                if !root.rtl && root.inspector-visible : WriterInspector {
                    preferred-width: 280px;
                    inspector-tab <=> root.inspector-tab;
                    is-bold <=> root.is-bold;
                    is-italic <=> root.is-italic;
                    is-underline <=> root.is-underline;
                    heading-level <=> root.heading-level;
                    text-alignment <=> root.text-alignment;
                    status-left: root.status-left;
                    toggle-bold => { root.toggle-bold(); }
                    toggle-italic => { root.toggle-italic(); }
                    toggle-underline => { root.toggle-underline(); }
                    select-heading(idx) => { root.select-heading(idx); }
                    select-alignment(idx) => { root.select-alignment(idx); }
                }

                if root.rtl && root.inspector-visible : WriterInspector {
                    preferred-width: 280px;
                    inspector-tab <=> root.inspector-tab;
                    is-bold <=> root.is-bold;
                    is-italic <=> root.is-italic;
                    is-underline <=> root.is-underline;
                    heading-level <=> root.heading-level;
                    text-alignment <=> root.text-alignment;
                    status-left: root.status-left;
                    toggle-bold => { root.toggle-bold(); }
                    toggle-italic => { root.toggle-italic(); }
                    toggle-underline => { root.toggle-underline(); }
                    select-heading(idx) => { root.select-heading(idx); }
                    select-alignment(idx) => { root.select-alignment(idx); }
                }

                if root.rtl : WriterPageCanvas {
                    doc-title: root.doc-title;
                    doc-content <=> root.doc-content;
                    selection-anchor <=> root.selection-anchor;
                    selection-focus <=> root.selection-focus;
                    selection-announcement: root.selection-announcement;
                    document-edited(value, anchor, focus) => { root.document-edited(value, anchor, focus); }
                    selection-changed(anchor, focus) => { root.selection-changed(anchor, focus); }
                    key-pressed(event) => { return reject; }
                }
            }

            // Standard Status Bar
            WriterStatusBar {
                leading-text: root.status-left;
                trailing-text: root.status-right;
            }
        }
    }

    // Compact toolbars keep the primary workspace clear and expose every
    // currently actionable toolbar command through one real,
    // keyboard-accessible menu.
    if root.toolbar-overflow-open && root.overflow-toolbar : Rectangle {
        width: root.width;
        height: root.height;
        background: transparent;

        TouchArea { clicked => { root.close-toolbar-overflow(); } }

        VerticalLayout {
            padding-top: Theme.tokens.metrics.header-height + Theme.tokens.metrics.context-toolbar-height + Theme.tokens.space.sm;
            padding-right: Theme.tokens.space.lg;
            padding-left: Theme.tokens.space.lg;
            cross-axis-alignment: end;
            WriterToolbarOverflow {
                inspector-available: root.inspector-available;
                inspector-visible: root.inspector-visible;
                toggle-inspector => { root.toggle-inspector(); }
                export-pdf => { root.export-pdf(); }
                close-requested => { root.close-toolbar-overflow(); }
            }
        }
    }

    // Modal Template Chooser matching Apple Pages reference
    if root.template-chooser-open : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: Theme.palette().scrim;

        Rectangle {
            // Keep the chooser almost as broad and tall as the surrounding
            // window, while retaining a visible margin on compact desktops.
            width: min(1160px, max(1px, parent.width - 48px));
            x: (parent.width - self.width) / 2;
            height: min(760px, max(480px, parent.height - 48px));
            y: (parent.height - self.height) / 2;
            border-radius: Theme.tokens.metrics.radius-large;
            border-width: 1px;
            border-color: Theme.palette().border;
            background: Theme.palette().surface;
            clip: true;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: Theme.palette().shadow;

            VerticalLayout {
                spacing: 0px;
                padding: 0px;

                // Main body: Sidebar + Content Grid
                HorizontalLayout {
                    spacing: 0px;
                    vertical-stretch: 1;

                    // Left Category Sidebar
                    Rectangle {
                        width: 220px;
                        background: Theme.palette().panel;

                        VerticalLayout {
                            spacing: Theme.tokens.space.sm;
                            padding-top: Theme.tokens.space.xl; padding-bottom: Theme.tokens.space.xl; padding-left: Theme.tokens.space.lg; padding-right: Theme.tokens.space.lg;

                            HorizontalLayout {
                                padding-left: Theme.tokens.space.md;
                                padding-bottom: Theme.tokens.space.sm;
                                Text {
                                    text: "TEMPLATES";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: Theme.palette().ink-secondary;
                                }
                            }

                            // Category items
                            Rectangle {
                                height: 32px;
                                border-radius: Theme.tokens.metrics.radius-medium;
                                background: root.template-category == 0 ? Theme.palette().surface-raised : transparent;
                                HorizontalLayout {
                                    spacing: Theme.tokens.space.md; padding-left: Theme.tokens.space.md; padding-right: Theme.tokens.space.md; cross-axis-alignment: center;
                                    Icon { size: 16px; icon: "grid"; tint: root.template-category == 0 ? Theme.palette().accent : Theme.palette().ink-secondary; }
                                    Text {
                                        text: "All Templates";
                                        font-size: Theme.tokens.typography.body;
                                        font-weight: root.template-category == 0 ? 600 : 400;
                                        color: Theme.palette().ink;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.choose-template-category(0); } }
                            }

                            Rectangle {
                                height: 32px;
                                border-radius: Theme.tokens.metrics.radius-medium;
                                background: root.template-category == 1 ? Theme.palette().surface-raised : transparent;
                                HorizontalLayout {
                                    spacing: Theme.tokens.space.md; padding-left: Theme.tokens.space.md; padding-right: Theme.tokens.space.md; cross-axis-alignment: center;
                                    Icon { size: 16px; icon: "document"; tint: root.template-category == 1 ? Theme.palette().accent : Theme.palette().ink-secondary; }
                                    Text {
                                        text: "Basic";
                                        font-size: Theme.tokens.typography.body;
                                        font-weight: root.template-category == 1 ? 600 : 400;
                                        color: Theme.palette().ink;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.choose-template-category(1); } }
                            }

                            Rectangle {
                                height: 32px;
                                border-radius: Theme.tokens.metrics.radius-medium;
                                background: root.template-category == 2 ? Theme.palette().surface-raised : transparent;
                                HorizontalLayout {
                                    spacing: Theme.tokens.space.md; padding-left: Theme.tokens.space.md; padding-right: Theme.tokens.space.md; cross-axis-alignment: center;
                                    Icon { size: 16px; icon: "folder"; tint: root.template-category == 2 ? Theme.palette().accent : Theme.palette().ink-secondary; }
                                    Text {
                                        text: "Letters";
                                        font-size: Theme.tokens.typography.body;
                                        font-weight: root.template-category == 2 ? 600 : 400;
                                        color: Theme.palette().ink;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.choose-template-category(2); } }
                            }

                            Rectangle {
                                height: 32px;
                                border-radius: Theme.tokens.metrics.radius-medium;
                                background: root.template-category == 3 ? Theme.palette().surface-raised : transparent;
                                HorizontalLayout {
                                    spacing: Theme.tokens.space.md; padding-left: Theme.tokens.space.md; padding-right: Theme.tokens.space.md; cross-axis-alignment: center;
                                    Icon { size: 16px; icon: "layers"; tint: root.template-category == 3 ? Theme.palette().accent : Theme.palette().ink-secondary; }
                                    Text {
                                        text: "Curricula Vitae";
                                        font-size: Theme.tokens.typography.body;
                                        font-weight: root.template-category == 3 ? 600 : 400;
                                        color: Theme.palette().ink;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.choose-template-category(3); } }
                            }

                            Rectangle { vertical-stretch: 1; background: transparent; }

                            // Bottom Language indicator
                            HorizontalLayout {
                                spacing: Theme.tokens.space.sm; padding: Theme.tokens.space.md;
                                Text {
                                    text: "English (US)";
                                    font-size: Theme.tokens.typography.caption;
                                    color: Theme.palette().ink-secondary;
                                    vertical-alignment: center;
                                }
                                Icon { size: 12px; icon: "chevron-down"; tint: Theme.palette().ink-secondary; }
                            }
                        }

                        Rectangle { x: parent.width - 1px; y: 0px; width: 1px; height: parent.height; background: Theme.palette().border; }
                    }

                    // Right Content Area
                    VerticalLayout {
                        horizontal-stretch: 1;
                        padding-top: Theme.tokens.space.xxl; padding-bottom: Theme.tokens.space.xl; padding-left: Theme.tokens.space.xxl; padding-right: Theme.tokens.space.xxl;
                        spacing: Theme.tokens.space.xl;

                        Text {
                            text: "Choose a Template";
                            font-size: 24px;
                            font-weight: 700;
                            color: Theme.palette().ink;
                        }

                        // Two rows keep the fixed paper preview cards inside
                        // the content column at the 900px contract minimum.
                        VerticalLayout {
                            spacing: Theme.tokens.space.xl;

                            HorizontalLayout {
                                spacing: Theme.tokens.space.xl;

                                if root.template-visible(0) : TemplateCard {
                                    title: "Blank";
                                    selected: root.template-selected == 0;
                                    preview-width: 140px;
                                    preview-height: 175px;
                                    width: 160px;
                                    height: 230px;
                                    show-selected-badge: true;
                                    clicked => { root.template-selected = 0; }
                                    VerticalLayout {
                                        spacing: 8px;
                                        padding: 16px;
                                        Text {
                                            text: "Aa";
                                            font-size: Theme.tokens.typography.display-large;
                                            font-weight: 700;
                                            color: Theme.palette().paper-ink;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            vertical-stretch: 1;
                                        }
                                        Rectangle { height: 1px; background: Theme.palette().paper-line; }
                                    }
                                }

                                if root.template-visible(1) : TemplateCard {
                                    title: "Report";
                                    selected: root.template-selected == 1;
                                    preview-width: 140px;
                                    preview-height: 175px;
                                    width: 160px;
                                    height: 230px;
                                    show-selected-badge: true;
                                    clicked => { root.template-selected = 1; }
                                    VerticalLayout {
                                        spacing: 6px;
                                        padding: 14px;
                                        Text { text: "REPORT TITLE"; font-size: Theme.tokens.typography.micro; font-weight: 700; color: Theme.palette().paper-ink; }
                                        Rectangle { height: 2px; background: Theme.palette().accent; }
                                        Rectangle { height: 3px; background: Theme.palette().paper-line; }
                                        Rectangle { height: 3px; background: Theme.palette().paper-line; }
                                        Rectangle { height: 3px; width: 75%; background: Theme.palette().paper-line; }
                                        Rectangle { height: 8px; background: transparent; }
                                        Text { text: "Executive Summary"; font-size: Theme.tokens.typography.micro; font-weight: 600; color: Theme.palette().paper-muted; }
                                        Rectangle { height: 3px; background: Theme.palette().paper-line; }
                                        Rectangle { height: 3px; width: 85%; background: Theme.palette().paper-line; }
                                        Rectangle { vertical-stretch: 1; background: transparent; }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: Theme.tokens.space.xl;

                                if root.template-visible(2) : TemplateCard {
                                    title: "Letter";
                                    selected: root.template-selected == 2;
                                    preview-width: 140px;
                                    preview-height: 175px;
                                    width: 160px;
                                    height: 230px;
                                    show-selected-badge: true;
                                    clicked => { root.template-selected = 2; }
                                    VerticalLayout {
                                        spacing: 6px;
                                        padding: 14px;
                                        Text { text: "Your Name"; font-size: Theme.tokens.typography.caption; font-weight: 600; color: Theme.palette().paper-ink; }
                                        Text { text: "October 24, 2026"; font-size: Theme.tokens.typography.micro; color: Theme.palette().paper-muted; }
                                        Rectangle { height: 1px; background: Theme.palette().paper-line; }
                                        Text { text: "Dear Recipient,"; font-size: Theme.tokens.typography.micro; color: Theme.palette().paper-ink; }
                                        Rectangle { height: 3px; background: Theme.palette().paper-line; }
                                        Rectangle { height: 3px; background: Theme.palette().paper-line; }
                                        Rectangle { height: 3px; width: 60%; background: Theme.palette().paper-line; }
                                        Rectangle { vertical-stretch: 1; background: transparent; }
                                    }
                                }

                                if root.template-visible(3) : TemplateCard {
                                    title: "CV";
                                    selected: root.template-selected == 3;
                                    preview-width: 140px;
                                    preview-height: 175px;
                                    width: 160px;
                                    height: 230px;
                                    show-selected-badge: true;
                                    clicked => { root.template-selected = 3; }
                                    VerticalLayout {
                                        spacing: 5px;
                                        padding: 12px;
                                        Text { text: "YOUR NAME"; font-size: Theme.tokens.typography.caption; font-weight: 700; color: Theme.palette().paper-ink; }
                                        Rectangle { height: 2px; background: Theme.palette().content-cool; }
                                        Text { text: "EXPERIENCE"; font-size: Theme.tokens.typography.micro; font-weight: 600; color: Theme.palette().paper-muted; }
                                        Rectangle { height: 3px; background: Theme.palette().paper-line; }
                                        Rectangle { height: 3px; width: 80%; background: Theme.palette().paper-line; }
                                        Text { text: "EDUCATION"; font-size: Theme.tokens.typography.micro; font-weight: 600; color: Theme.palette().paper-muted; }
                                        Rectangle { height: 3px; background: Theme.palette().paper-line; }
                                        Rectangle { vertical-stretch: 1; background: transparent; }
                                    }
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }
                }

                // Bottom Action Bar
                Rectangle {
                    height: 56px;
                    background: Theme.palette().chrome;

                    Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.palette().border; }

                    HorizontalLayout {
                        spacing: Theme.tokens.space.lg;
                        padding-left: Theme.tokens.space.xl;
                        padding-right: Theme.tokens.space.xl;
                        cross-axis-alignment: center;

                        Text {
                            text: "Escape to cancel • Return to create";
                            font-size: Theme.tokens.typography.caption;
                            color: Theme.palette().ink-secondary;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }

                        ToolbarButton {
                            label: "Cancel";
                            clicked => { root.cancel-template(); }
                        }

                        ToolbarButton {
                            label: "Create Document";
                            primary: true;
                            clicked => { root.create-template(root.template-selected); }
                        }
                    }
                }
            }
        }
    }

        palette := CommandPalette {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            open: root.palette-open;
            commands: root.palette-commands;
            query: root.palette-query;
            selected: root.palette-selected;
            command-invoked(idx) => { root.palette-invoked(idx); }
            query-changed(q) => {
                root.palette-query = q;
                root.palette-query-changed(q);
            }
            move-selection(delta) => { root.palette-move(delta); }
            key-text(text) => { root.palette-key-text(text); }
            backspace => { root.palette-backspace(); }
            close-requested => {
                root.palette-open = false;
                root.palette-close();
            }
        }
}
