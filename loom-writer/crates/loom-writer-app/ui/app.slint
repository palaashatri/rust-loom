import { TemplateChooserModal } from "template_chooser.slint";
import { CommandPaletteItem } from "../../../../loom-core/crates/loom-ui/ui/components.slint";
import {
    LoomButton, LoomTitleBar, LoomWindowResizeEdges,
    LocalMenu, LocalMenuLabels, LocalMenuEntry, LocalMenuPopup,
} from "foundation.slint";
import { Icon } from "icons.slint";
import { FindBar, FindBarOverlay } from "find_bar.slint";
import { WriterSaveChangesDialog } from "save_changes_dialog.slint";
import { WriterPaletteHost } from "palette_host.slint";
import { WriterShortcutScope } from "shortcut_scope.slint";
import { Theme, ResponsivePolicy } from "theme.slint";
import {
    WriterActionToolbar, WriterToolbarMenu, WriterPageCanvas,
    WriterStatusBar, WriterRenderBlock, WriterSelectionRect,
    WriterCommentRect, WriterOutlinePane, WriterOutlineEntry
} from "writer_components.slint";
import { WriterInspector, WriterCommentEntry } from "inspector.slint";
export { Theme, ResponsivePolicy } from "theme.slint";
export { LocalMenu, LocalMenuEntry } from "foundation.slint";
export { FindBar, FindRect } from "find_bar.slint";
export { Palette as WidgetPalette } from "std-widgets.slint";

export component WriterApp inherits Window {
    // Set from the document's name and unsaved state, as Sheets does.
    in-out property <string> window-title: "Loom Writer";
    title: root.window-title;
    default-font-family: Theme.ui-font-family;
    // Windows and Linux draw their own frame so the menu and the title share
    // one row. macOS keeps the native frame and global menu bar.
    in property <bool> custom-chrome: false;
    no-frame: root.custom-chrome;
    callback window-drag;
    callback window-close;
    callback window-resize(int);
    in property <bool> local-menu-visible: true;
    in property <[string]> local-menu-labels: ["File", "Edit", "View", "Format"];
    in property <[LocalMenuEntry]> local-menu-items: [];
    in property <[LocalMenuEntry]> local-menu-popup-items: [];
    in-out property <int> local-menu-open-index: -1;
    in-out property <int> local-menu-selected-index: -1;
    in-out property <int> local-menu-popup-selected-index: -1;
    callback local-menu-opened(int);
    callback local-menu-move(int);
    callback local-menu-action(string);
    min-width: 900px;
    min-height: 680px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.palette().canvas;

    in property <bool> wide-toolbar: false;
    in property <bool> icon-only-toolbar: false;
    in property <bool> labeled-toolbar: false;
    in property <bool> labeled-export: false;
    in property <bool> overflow-toolbar: false;
    in property <bool> rtl: false;
    /// The More menu (kind 8). Other toolbar menus use `toolbar-menu`.
    in-out property <bool> toolbar-overflow-open: false;
    /// 0 none, 1 View, 2 Zoom, 3 Insert, 4 Text, 5 Style, 6 List, 7 Export.
    in-out property <int> toolbar-menu: 0;
    property <length> toolbar-menu-x: 0px;
    property <length> outline-width: root.show-navigator ? 220px * (1.0 + 0.7 * (max(1.0, Theme.text-scale) - 1.0)) : 0px;
    property <int> toolbar-menu-kind: root.toolbar-overflow-open ? 8 : root.toolbar-menu;
    in-out property <bool> show-inspector: false;
    /// 0 = Format, 1 = Document.
    in-out property <int> inspector-tab: 0;
    in-out property <bool> comment-focus-pending: false;
    in-out property <bool> show-navigator: false;
    in property <[WriterOutlineEntry]> outline-entries: [];
    callback toolbar-command(string);
    callback jump-outline(int);
    callback view-state-changed;
    changed show-navigator => { root.view-state-changed(); }
    in property <bool> inspector-available: true;
    in-out property <bool> compact-inspector-layout: false;
    in-out property <bool> inspector-quiet-open: false;
    // The compact toolbar still exposes Format. Keep the panel available at
    // every width so the button always does something when activated.
    property <bool> inspector-visible: root.show-inspector && root.inspector-available;
    property <bool> docked-inspector-visible: root.inspector-visible && !root.compact-inspector-layout;
    property <bool> compact-inspector-visible: root.inspector-visible && root.compact-inspector-layout;
    /// Width the open inspector takes from the window's reading-end side
    /// (the left side in RTL); zero while it is closed.
    property <length> inspector-width: root.compact-inspector-visible ? compact-inspector.width : docked-inspector.width;
    callback window-resized(length);
    changed rtl => {
        Theme.rtl = root.rtl;
    }
    changed width => {
        root.window-resized(root.width);
        if (!ResponsivePolicy.priority-2-overflow(root.width)) {
            root.close-toolbar-overflow();
        }
    }

    /// Toolbar Format/Document: show that inspector tab, or close the
    /// inspector when its tab is already showing. Opening and closing go
    /// through `toggle-inspector`, so the command registry and menu see it.
    public function show-inspector-tab(tab: int) {
        if (root.inspector-visible && root.inspector-tab == tab) {
            root.toggle-inspector();
        } else {
            root.inspector-tab = tab;
            if (!root.inspector-visible) { root.toggle-inspector(); }
        }
    }

    /// Insert > Comment: open the Document tab and put the caret in the
    /// new-comment field.
    public function open-comment-composer() {
        root.inspector-tab = 1;
        root.comment-focus-pending = true;
        if (!root.inspector-visible) { root.toggle-inspector(); }
    }

    in property <string> doc-title: "Untitled Document";
    in-out property <string> doc-content: "";
    in property <[WriterRenderBlock]> render-blocks: [];
    in property <[WriterSelectionRect]> selection-rects: [];
    in property <[WriterCommentRect]> comment-rects: [];
    in-out property <int> selection-anchor: 0;
    in-out property <int> selection-focus: 0;
    in property <string> status-left: "";
    in property <string> status-right: "";
    in property <string> selection-announcement: "No text selected";
    in-out property <float> page-zoom: 1.0;
    in-out property <length> page-scroll-x: 0px;
    in-out property <length> page-scroll-y: 0px;
    in-out property <length> page-view-height: 0px;
    in-out property <int> page-count: 1;
    in property <int> visible-page-first: 0;
    in property <int> visible-page-count: 1;
    in-out property <length> page-stack-height: 842px;
    in-out property <float> page-gap-pt: 24.0;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in-out property <bool> document-dirty: false;
    in-out property <bool> save-changes-open: false;
    in-out property <string> save-changes-document: "";
    in-out property <bool> save-changes-closing: false;

    in-out property <bool> is-bold: false;
    in-out property <bool> is-italic: false;
    in-out property <bool> is-underline: false;
    in-out property <bool> is-strikethrough: false;
    in-out property <int> heading-level: 0;
    in-out property <int> font-family-index: 0;
    in-out property <int> font-size-pt: 11;
    in-out property <int> text-alignment: 0;
    in-out property <int> line-spacing-index: 1;
    in property <int> word-count: 0;
    in property <int> char-count: 0;
    in property <int> reading-time-mins: 0;

    in property <float> page-width-pt: 595.0;
    in property <float> page-height-pt: 842.0;
    in property <float> page-margin-pt: 72.0;
    in-out property <int> page-paper-index: 0;
    in-out property <int> page-orientation-index: 0;
    in-out property <int> page-margins-index: 0;
    in-out property <int> list-style-index: 0;
    in property <[WriterCommentEntry]> comment-entries: [];
    in-out property <string> comment-draft: "";

    in-out property <bool> template-chooser-open: false;
    in-out property <int> template-selected: 0;
    in-out property <int> template-category: 0;

    callback new-doc;
    callback open-doc;
    callback save-doc;
    callback save-as-doc;
    callback export-pdf;
    callback export-docx;
    callback export-markdown;
    callback undo;
    callback redo;
    callback document-edited(string, int, int);
    callback selection-changed(int, int);
    callback insert-tab;
    callback page-move(int, bool);
    callback pointer-pressed(length, length, bool);
    callback pointer-moved(length, length);
    callback pointer-released(length, length);
    callback pointer-cancelled;
    callback page-zoom-changed(float);
    callback page-scroll-changed(length, length);
    callback toggle-bold;
    callback toggle-italic;
    callback toggle-underline;
    callback toggle-strikethrough;
    callback select-heading(int);
    callback select-font-family(int);
    callback increase-font-size;
    callback decrease-font-size;
    callback select-alignment(int);
    callback indent-text;
    callback outdent-text;
    callback select-line-spacing(int);
    callback select-paper-size(int);
    callback select-orientation(int);
    callback select-margins(int);
    callback select-list-style(int);
    callback insert-table;
    callback add-comment(string);
    callback set-comment-resolved(string, bool);
    callback delete-comment(string);
    callback toggle-inspector;
    callback navigate-comment(string);
    callback create-template(int);
    callback cancel-template;
    callback save-changes-save;
    callback save-changes-discard;
    callback save-changes-cancel;

    in-out property <[CommandPaletteItem]> palette-commands: [];
    in-out property <bool> palette-open: false;
    in-out property <string> palette-query: "";
    // Ctrl+A selects the search text: the next typed text replaces it.
    in-out property <bool> palette-query-selected: false;
    // The platform modifier that shortcut hints name: "Ctrl", or "Cmd" on macOS.
    in-out property <string> shortcut-modifier: "Ctrl";
    in-out property <int> palette-selected: 0;
    callback palette-invoked(int);
    callback palette-query-changed(string);
    callback palette-move(int);
    callback palette-key-text(string);
    callback palette-backspace;
    callback palette-close;

    changed page-zoom => { root.page-zoom-changed(root.page-zoom); }
    changed page-scroll-x => { root.page-scroll-changed(root.page-scroll-x, root.page-scroll-y); }
    changed page-scroll-y => { root.page-scroll-changed(root.page-scroll-x, root.page-scroll-y); }

    // Hand keyboard focus to the page editor (and the window-level shortcut
    // scope above it), so typing and shortcuts work without a prior click.
    public function focus-page() {
        app-focus.focus();
        FindBar.page-focus-tick += 1;
    }

    /// F6 cycles the keyboard through the page, the toolbar and the open
    /// inspector: page, toolbar, inspector, page. Shift+F6 runs the cycle
    /// backwards. Tab inside the page types a tab, so the page passes F6 on.
    /// Alt+letter or F10 opens the in-window menu named by that key. The page
    /// text box would otherwise type the letter, so it asks first too.
    function open-menu-for-key(event: KeyEvent) -> bool {
        let target = LocalMenu.target(event);
        if (!root.local-menu-visible || !root.custom-chrome || target < 0) { return false; }
        root.local-menu-open-index = target;
        return true;
    }

    public function focus-inspector() {
        if (root.compact-inspector-layout) {
            compact-inspector.focus-first-control();
        } else {
            docked-inspector.focus-first-control();
        }
    }

    /// From the page: F6 goes to the toolbar; Shift+F6 goes back to the open
    /// inspector, or to the toolbar when no inspector is open.
    public function leave-page(backwards: bool) {
        if (backwards && root.inspector-visible) {
            root.focus-inspector();
        } else {
            action-toolbar.focus-first();
        }
    }

    /// From the toolbar, or any control outside the page and inspector: F6 goes
    /// to the open inspector, or to the page; Shift+F6 goes to the page.
    public function leave-chrome(backwards: bool) {
        if (!backwards && root.inspector-visible) {
            root.focus-inspector();
        } else {
            root.focus-page();
        }
    }

    /// From the inspector: F6 goes to the page; Shift+F6 goes back to the toolbar.
    public function leave-inspector(backwards: bool) {
        if (backwards) {
            action-toolbar.focus-first();
        } else {
            root.focus-page();
        }
    }

    public function open-palette() {
        root.palette-open = true;
        root.palette-query = "";
        root.palette-query-selected = false;
        palette-host.grab-focus();
    }

    function compact-label(full-label: string) -> string {
        return root.wide-toolbar ? full-label : "";
    }

    /// Escape (or a click outside) closes the open toolbar menu and puts focus
    /// back on the toolbar item that opened it.
    public function dismiss-toolbar-menu() {
        let kind = root.toolbar-menu-kind;
        if (kind != 0) {
            root.toolbar-overflow-open = false;
            root.toolbar-menu = 0;
            action-toolbar.focus-menu-trigger(kind);
        }
    }

    /// Close whichever toolbar menu is open and return focus to the page.
    public function close-toolbar-overflow() {
        if (root.toolbar-overflow-open || root.toolbar-menu != 0) {
            root.toolbar-overflow-open = false;
            root.toolbar-menu = 0;
            root.focus-page();
        }
    }

    // The chooser owns its own keyboard focus (see `TemplateChooserModal`);
    // closing it returns focus to the page. `template-refocus-tick` hands focus
    // back when a dialog stacked on top of it closes.
    property <int> template-refocus-tick: 0;
    changed template-chooser-open => {
        if (!root.template-chooser-open) { root.focus-page(); }
    }

    changed save-changes-open => {
        if (!root.save-changes-open) {
            if (root.template-chooser-open) { root.template-refocus-tick += 1; } else { root.focus-page(); }
        }
    }

    changed palette-open => {
        if (root.palette-open) {
            palette-host.grab-focus();
        } else {
            root.focus-page();
        }
    }

    app-focus := WriterShortcutScope {
        palette-open: root.palette-open;
        template-chooser-open: root.template-chooser-open;
        save-changes-open: root.save-changes-open;
        toolbar-menu-kind: root.toolbar-menu-kind;
        open-menu-for-key(event) => { return root.open-menu-for-key(event); }
        leave-chrome(backwards) => { root.leave-chrome(backwards); }
        open-palette => { root.open-palette(); }
        new-doc => { root.new-doc(); }
        open-doc => { root.open-doc(); }
        save-doc => { root.save-doc(); }
        save-as-doc => { root.save-as-doc(); }
        export-pdf => { root.export-pdf(); }
        toggle-bold => { root.toggle-bold(); }
        toggle-italic => { root.toggle-italic(); }
        toggle-underline => { root.toggle-underline(); }
        undo => { root.undo(); }
        redo => { root.redo(); }
        VerticalLayout {
            spacing: 0px;
            padding: 0px;

            if root.custom-chrome : LoomTitleBar {
                title: root.doc-title + (root.document-dirty ? " \u{2022}" : "");
                maximized: root.maximized;
                drag-requested => { root.window-drag(); }
                // `maximized` and `minimized` are Slint's own window properties.
                toggle-maximize => { root.maximized = !root.maximized; }
                minimize => { root.minimized = true; }
                close => { root.window-close(); }
                LocalMenuLabels {
                    labels: root.local-menu-labels;
                    open-index <=> root.local-menu-open-index;
                }
            }

            action-toolbar := WriterActionToolbar {
                inspector-visible: root.inspector-visible;
                inspector-tab: root.inspector-tab;
                menu-kind: root.toolbar-menu-kind;
                toggle-menu(kind, x) => {
                    root.toolbar-menu-x = x;
                    if (kind == 8) {
                        root.toolbar-menu = 0;
                        root.toolbar-overflow-open = !root.toolbar-overflow-open;
                    } else {
                        root.toolbar-overflow-open = false;
                        root.toolbar-menu = root.toolbar-menu == kind ? 0 : kind;
                    }
                    if (root.toolbar-menu-kind != 0) { toolbar-menu-popup.focus-menu(); } else { root.focus-page(); }
                }
                show-inspector-tab(tab) => { root.show-inspector-tab(tab); }
            }

            // Outline, page and inspector. Left-to-right puts the outline at the left and
            // the inspector at the right; right-to-left mirrors them. They are placed by
            // position so one page canvas serves both directions.
            Rectangle {
                vertical-stretch: 1;
                // The page stack is taller than the window; it scrolls, so it
                // must not raise the row's minimum and push the status bar off.
                min-height: 0px;

                if root.show-navigator : WriterOutlinePane {
                    x: root.rtl ? parent.width - self.width : 0px;
                    y: 0px;
                    height: parent.height;
                    entries: root.outline-entries;
                    jump(idx) => { root.jump-outline(idx); }
                    close-requested => { root.show-navigator = false; root.focus-page(); }
                }

                // The page fills what the outline and the inspector leave; the layout
                // gives it its size, and two spacers hold the side panels' room.
                HorizontalLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    spacing: 0px;
                    Rectangle { width: root.rtl ? docked-inspector.width : root.outline-width; }
                    page-canvas := WriterPageCanvas {
                        horizontal-stretch: 1;
                        doc-title: root.doc-title;
                        doc-content <=> root.doc-content;
                        render-blocks <=> root.render-blocks;
                        selection-rects <=> root.selection-rects;
                        comment-rects: root.comment-rects;
                        activate-comment(id) => { root.navigate-comment(id); }
                        selection-anchor <=> root.selection-anchor;
                        selection-focus <=> root.selection-focus;
                        page-zoom <=> root.page-zoom;
                        page-scroll-x <=> root.page-scroll-x;
                        page-scroll-y <=> root.page-scroll-y;
                        view-height <=> root.page-view-height;
                        page-count: root.page-count;
                        visible-page-first: root.visible-page-first;
                        visible-page-count: root.visible-page-count;
                        page-stack-height: root.page-stack-height;
                        page-gap-pt: root.page-gap-pt;
                        page-width-pt: root.page-width-pt;
                        page-height-pt: root.page-height-pt;
                        page-margin-pt: root.page-margin-pt;
                        page-zoom-changed(value) => { root.page-zoom-changed(value); }
                        page-scroll-changed(x, y) => { root.page-scroll-changed(x, y); }
                        document-edited(value, anchor, focus) => { root.document-edited(value, anchor, focus); }
                        selection-changed(anchor, focus) => { root.selection-changed(anchor, focus); }
                        pointer-pressed(x, y, extend) => { root.pointer-pressed(x, y, extend); }
                        pointer-moved(x, y) => { root.pointer-moved(x, y); }
                        pointer-released(x, y) => { root.pointer-released(x, y); }
                        pointer-cancelled => { root.pointer-cancelled(); }
                        key-pressed(event) => {
                            // The text box has an undo of its own that knows nothing of formatting,
                            // replace or table edits; the document history is the only one.
                            if ((event.modifiers.control || event.modifiers.meta) && (event.text == "z" || event.text == "Z" || event.text == "y" || event.text == "Y")) {
                                if (event.text == "y" || event.text == "Y" || event.modifiers.shift) { root.redo(); } else { root.undo(); }
                                return accept;
                            }
                            if (root.open-menu-for-key(event)) { return accept; }
                            if (event.text == Key.F6) { root.leave-page(event.modifiers.shift); return accept; }
                            if (event.text == Key.Tab) {
                                if (!event.modifiers.shift) { root.insert-tab(); }
                                return accept;
                            }
                            if (event.text == Key.PageDown) { root.page-move(1, event.modifiers.shift); return accept; }
                            if (event.text == Key.PageUp) { root.page-move(-1, event.modifiers.shift); return accept; }
                            return reject;
                        }
                    }
                    Rectangle { width: root.rtl ? root.outline-width : docked-inspector.width; }
                }

                docked-inspector := WriterInspector {
                    shortcut-modifier: root.shortcut-modifier;
                    x: root.rtl ? 0px : parent.width - self.width;
                    y: 0px;
                    width: root.docked-inspector-visible ? 320px * (1.0 + 0.7 * (max(1.0, Theme.text-scale) - 1.0)) : 0px;
                    height: parent.height;
                    visible: root.docked-inspector-visible;
                    active: root.docked-inspector-visible;
                    inspector-tab <=> root.inspector-tab;
                    comment-focus-pending <=> root.comment-focus-pending;
                    quiet-open <=> root.inspector-quiet-open;
                    close-requested => { root.toggle-inspector(); }
                    f6-pressed(backwards) => { root.leave-inspector(backwards); }
                    is-bold <=> root.is-bold;
                    is-italic <=> root.is-italic;
                    is-underline <=> root.is-underline;
                    is-strikethrough <=> root.is-strikethrough;
                    heading-level <=> root.heading-level;
                    font-family-index <=> root.font-family-index;
                    font-size-pt <=> root.font-size-pt;
                    text-alignment <=> root.text-alignment;
                    line-spacing-index <=> root.line-spacing-index;
                    page-paper-index <=> root.page-paper-index;
                    page-orientation-index <=> root.page-orientation-index;
                    page-margins-index <=> root.page-margins-index;
                    list-style-index <=> root.list-style-index;
                    comment-entries: root.comment-entries;
                    add-comment(body) => { root.add-comment(body); }
                    navigate-comment(id) => { root.navigate-comment(id); }
                    set-comment-resolved(id, resolved) => { root.set-comment-resolved(id, resolved); }
                    delete-comment(id) => { root.delete-comment(id); }
                    status-left: root.status-left;
                    word-count: root.word-count;
                    char-count: root.char-count;
                    page-count: root.page-count;
                    reading-time-mins: root.reading-time-mins;
                    toggle-bold => { root.toggle-bold(); }
                    toggle-italic => { root.toggle-italic(); }
                    toggle-underline => { root.toggle-underline(); }
                    toggle-strikethrough => { root.toggle-strikethrough(); }
                    select-heading(idx) => { root.select-heading(idx); }
                    select-font-family(idx) => { root.select-font-family(idx); }
                    increase-font-size => { root.increase-font-size(); }
                    decrease-font-size => { root.decrease-font-size(); }
                    select-alignment(idx) => { root.select-alignment(idx); }
                    indent-text => { root.indent-text(); }
                    outdent-text => { root.outdent-text(); }
                    select-line-spacing(idx) => { root.select-line-spacing(idx); }
                    select-paper-size(idx) => { root.select-paper-size(idx); }
                    select-orientation(idx) => { root.select-orientation(idx); }
                    select-margins(idx) => { root.select-margins(idx); }
                    select-list-style(idx) => { root.select-list-style(idx); }
                }
            }

            WriterStatusBar {
                leading-text: root.status-left;
                trailing-text: root.status-right;
            }
        }
    }

    Rectangle {
        visible: root.compact-inspector-visible;
        x: 0px;
        y: action-toolbar.bottom-y;
        width: root.width;
        height: root.height - action-toolbar.bottom-y;
        background: transparent;

        Rectangle {
            width: parent.width;
            height: parent.height;
            background: Theme.palette().scrim;
            TouchArea { clicked => { root.toggle-inspector(); } }
        }

        compact-inspector := WriterInspector {
            shortcut-modifier: root.shortcut-modifier;
            x: root.rtl ? 0px : max(0px, parent.width - 360px * (1.0 + 0.7 * (max(1.0, Theme.text-scale) - 1.0)));
            y: 0px;
            width: min(360px * (1.0 + 0.7 * (max(1.0, Theme.text-scale) - 1.0)), parent.width);
            height: parent.height;
            active: root.compact-inspector-visible;
            inspector-tab <=> root.inspector-tab;
            comment-focus-pending <=> root.comment-focus-pending;
            quiet-open <=> root.inspector-quiet-open;
            close-requested => { root.toggle-inspector(); }
            f6-pressed(backwards) => { root.leave-inspector(backwards); }
            is-bold <=> root.is-bold;
            is-italic <=> root.is-italic;
            is-underline <=> root.is-underline;
            is-strikethrough <=> root.is-strikethrough;
            heading-level <=> root.heading-level;
            font-family-index <=> root.font-family-index;
            font-size-pt <=> root.font-size-pt;
            text-alignment <=> root.text-alignment;
            line-spacing-index <=> root.line-spacing-index;
            page-paper-index <=> root.page-paper-index;
            page-orientation-index <=> root.page-orientation-index;
            page-margins-index <=> root.page-margins-index;
            list-style-index <=> root.list-style-index;
            comment-entries: root.comment-entries;
            add-comment(body) => { root.add-comment(body); }
            navigate-comment(id) => { root.navigate-comment(id); }
            set-comment-resolved(id, resolved) => { root.set-comment-resolved(id, resolved); }
            delete-comment(id) => { root.delete-comment(id); }
            status-left: root.status-left;
            word-count: root.word-count;
            char-count: root.char-count;
            page-count: root.page-count;
            reading-time-mins: root.reading-time-mins;
            toggle-bold => { root.toggle-bold(); }
            toggle-italic => { root.toggle-italic(); }
            toggle-underline => { root.toggle-underline(); }
            toggle-strikethrough => { root.toggle-strikethrough(); }
            select-heading(idx) => { root.select-heading(idx); }
            select-font-family(idx) => { root.select-font-family(idx); }
            increase-font-size => { root.increase-font-size(); }
            decrease-font-size => { root.decrease-font-size(); }
            select-alignment(idx) => { root.select-alignment(idx); }
            indent-text => { root.indent-text(); }
            outdent-text => { root.outdent-text(); }
            select-line-spacing(idx) => { root.select-line-spacing(idx); }
            select-paper-size(idx) => { root.select-paper-size(idx); }
            select-orientation(idx) => { root.select-orientation(idx); }
            select-margins(idx) => { root.select-margins(idx); }
            select-list-style(idx) => { root.select-list-style(idx); }
        }

    }

    toolbar-menu-popup := WriterToolbarMenu {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        kind: root.toolbar-menu-kind;
        menu-x: root.toolbar-menu-x;
        menu-y: action-toolbar.bottom-y;
        inspector-visible: root.inspector-visible;
        navigator-visible: root.show-navigator;
        page-zoom: root.page-zoom;
        can-undo: root.can-undo;
        can-redo: root.can-redo;
        is-bold: root.is-bold;
        is-italic: root.is-italic;
        is-underline: root.is-underline;
        is-strikethrough: root.is-strikethrough;
        text-alignment: root.text-alignment;
        heading-level: root.heading-level;
        list-style-index: root.list-style-index;
        close-requested => { root.dismiss-toolbar-menu(); }
        command(id) => { root.close-toolbar-overflow(); root.toolbar-command(id); }
    }

    if root.template-chooser-open : TemplateChooserModal {
        width: root.width;
        height: root.height;
        refocus-tick: root.template-refocus-tick;
        template-selected <=> root.template-selected;
        template-category <=> root.template-category;
        cancel-template => { root.cancel-template(); }
        create-template(idx) => { root.create-template(idx); }
    }

    if root.save-changes-open : WriterSaveChangesDialog {
        width: root.width;
        height: root.height;
        document: root.save-changes-document;
        closing: root.save-changes-closing;
        save => { root.save-changes-save(); }
        discard => { root.save-changes-discard(); }
        cancel => { root.save-changes-cancel(); }
    }

    LocalMenuPopup {
        x: 0px;
        y: 36px;
        width: root.width;
        height: root.height - 36px;
        menu-enabled: root.local-menu-visible && root.custom-chrome;
        labels: root.local-menu-labels;
        items: root.local-menu-popup-items;
        open-index <=> root.local-menu-open-index;
        selected-index: root.local-menu-popup-selected-index;
        menu-opened(index) => { root.local-menu-opened(index); }
        menu-move(direction) => { root.local-menu-move(direction); }
        menu-closed => { root.focus-page(); }
        menu-action(id) => { root.local-menu-action(id); }
    }

    // The command palette and its Ctrl+A search scope; see palette_host.slint.
    palette-host := WriterPaletteHost {
        width: parent.width;
        height: parent.height;
        open: root.palette-open;
        commands: root.palette-commands;
        query <=> root.palette-query;
        query-selected <=> root.palette-query-selected;
        selected: root.palette-selected;
        command-invoked(idx) => { root.palette-invoked(idx); }
        query-changed(q) => { root.palette-query-changed(q); }
        move-selection(delta) => { root.palette-move(delta); }
        key-text(text) => { root.palette-key-text(text); }
        backspace => { root.palette-backspace(); }
        close-requested => {
            root.palette-open = false;
            root.palette-close();
        }
    }

    // The find bar sits in the document area: just under the toolbar, at the
    // reading-end edge of the page viewport (right in LTR, left in RTL), and
    // never over the inspector or the outline, which own the window's sides.
    if FindBar.open : FindBarOverlay {
        width: min(480px * max(1.0, Theme.text-scale), root.width - root.outline-width - root.inspector-width - 32px);
        x: root.rtl ? root.inspector-width + 16px : root.width - root.inspector-width - self.width - 16px;
        y: action-toolbar.bottom-y + 8px;
    }

    LoomWindowResizeEdges {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        enabled: root.custom-chrome && !root.maximized;
        resize(direction) => { root.window-resize(direction); }
    }
}
