// Loom Writer application window: shared components + writer-specific
// chrome built inline (a Window component cannot be nested, so the app
// owns its title bar and status bar).

import { ToolButton, IconButton, SearchField, StatusBar, SegmentedControl } from "components.slint";
import { Icon } from "icons.slint";
import { Theme } from "theme.slint";
import { TextEdit } from "std-widgets.slint";
export { Theme } from "theme.slint";
export { Palette as WidgetPalette } from "std-widgets.slint";

export component WriterApp inherits Window {
    title: "Loom Writer";
    in property <string> doc-title: "Untitled";
    in-out property <string> doc-content: "";
    in property <string> status-left: "";
    in property <string> status-right: "";

    // Rich Text Formatting properties
    in-out property <bool> is-bold: false;
    in-out property <bool> is-italic: false;
    in-out property <bool> is-underline: false;
    in-out property <int> heading-level: 0; // 0: Normal, 1: H1, 2: H2, 3: H3
    in-out property <int> text-alignment: 0; // 0: Left, 1: Center, 2: Right

    callback new-doc;
    callback open-doc;
    callback save-doc;
    callback export-pdf;
    callback undo;
    callback redo;
    callback document-edited(string);
    callback toggle-bold;
    callback toggle-italic;
    callback toggle-underline;
    callback select-heading(int);
    callback select-alignment(int);

    background: Theme.palette().canvas;

    VerticalLayout {
        spacing: 0px;
        padding: 0px;

        Rectangle {
            min-height: 40px;
            max-height: 40px;
            background: Theme.palette().surface;

            VerticalLayout {
                spacing: 0px;
                padding: 0px;

                HorizontalLayout {
                    spacing: 8px;
                    padding-left: 6px;
                    padding-right: 12px;
                    Icon {
                        icon: "layers";
                        size: 18px;
                        tint: Theme.palette().accent;
                        y: (parent.height - 18px) / 2;
                    }
                    Text {
                        text: "Loom Writer";
                        font-size: Theme.tokens.typography.title;
                        font-weight: 700;
                        color: Theme.palette().ink;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.palette().border;
                }
            }
        }

        // Standard Action Toolbar
        Rectangle {
            min-height: Theme.tokens.metrics.toolbar-height;
            max-height: Theme.tokens.metrics.toolbar-height;
            background: Theme.palette().chrome;

            HorizontalLayout {
                height: parent.height;
                cross-axis-alignment: center;
                spacing: 6px;
                padding-left: 8px;
                padding-right: 8px;

                ToolButton { icon: "new"; text: "New"; clicked => { root.new-doc(); } }
                ToolButton { icon: "open"; text: "Open"; clicked => { root.open-doc(); } }
                ToolButton { icon: "save"; text: "Save"; clicked => { root.save-doc(); } }
                ToolButton { icon: "undo"; clicked => { root.undo(); } }
                ToolButton { icon: "redo"; clicked => { root.redo(); } }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                SearchField { placeholder: "Search document"; }
                IconButton { icon: "export"; label: "Export PDF"; clicked => { root.export-pdf(); } }
            }
        }

        // Rich Text Formatting Toolbar
        Rectangle {
            min-height: 36px;
            max-height: 36px;
            background: Theme.palette().surface;

            HorizontalLayout {
                height: parent.height;
                cross-axis-alignment: center;
                spacing: 8px;
                padding-left: 8px;
                padding-right: 8px;

                Text {
                    text: "Style:";
                    font-size: Theme.tokens.typography.caption;
                    color: Theme.palette().ink-secondary;
                    vertical-alignment: center;
                }
                SegmentedControl {
                    items: ["Normal", "H1", "H2", "H3"];
                    current <=> root.heading-level;
                    selected(idx) => { root.select-heading(idx); }
                }

                Rectangle { width: 1px; height: 18px; background: Theme.palette().border; }

                ToolButton {
                    text: "B";
                    checked: root.is-bold;
                    clicked => {
                        root.is-bold = !root.is-bold;
                        root.toggle-bold();
                    }
                }
                ToolButton {
                    text: "I";
                    checked: root.is-italic;
                    clicked => {
                        root.is-italic = !root.is-italic;
                        root.toggle-italic();
                    }
                }
                ToolButton {
                    text: "U";
                    checked: root.is-underline;
                    clicked => {
                        root.is-underline = !root.is-underline;
                        root.toggle-underline();
                    }
                }

                Rectangle { width: 1px; height: 18px; background: Theme.palette().border; }

                Text {
                    text: "Align:";
                    font-size: Theme.tokens.typography.caption;
                    color: Theme.palette().ink-secondary;
                    vertical-alignment: center;
                }
                SegmentedControl {
                    items: ["Left", "Center", "Right"];
                    current <=> root.text-alignment;
                    selected(idx) => { root.select-alignment(idx); }
                }
            }
        }

        Rectangle {
            height: 1px;
            background: Theme.palette().border;
        }

        // Main Paper Canvas with margin container & shadow effect
        HorizontalLayout {
            spacing: 0px;
            padding: 0px;
            vertical-stretch: 1;

            Rectangle {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                background: Theme.palette().canvas;

                HorizontalLayout {
                    alignment: center;
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 24px;
                    padding-bottom: 24px;

                    // Paper Canvas Container with Margin & Subtle Shadow Border
                    Rectangle {
                        max-width: 760px;
                        horizontal-stretch: 1;
                        height: 100%;
                        background: Theme.palette().surface;
                        border-radius: 6px;
                        border-width: 1px;
                        border-color: Theme.palette().border-strong;

                        VerticalLayout {
                            width: 100%;
                            height: 100%;
                            padding-left: 48px;
                            padding-right: 48px;
                            padding-top: 36px;
                            padding-bottom: 36px;

                            Text {
                                text: root.doc-title;
                                font-size: root.heading-level == 1 ? Theme.tokens.typography.title
                                         : root.heading-level == 2 ? Theme.tokens.typography.heading
                                         : root.heading-level == 3 ? Theme.tokens.typography.body
                                         : Theme.tokens.typography.heading;
                                font-weight: 700;
                                color: Theme.palette().ink;
                                horizontal-alignment: root.text-alignment == 1 ? center : root.text-alignment == 2 ? right : left;
                            }
                            Rectangle { min-height: 16px; max-height: 16px; }
                            Rectangle {
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                clip: true;
                                TextEdit {
                                    width: parent.width;
                                    height: parent.height;
                                    text <=> root.doc-content;
                                    font-size: Theme.tokens.typography.body;
                                    placeholder-text: "Start writing…";
                                    wrap: word-wrap;
                                    edited => {
                                        root.document-edited(self.text);
                                    }
                                    key-pressed(event) => {
                                        if (event.modifiers.control && (event.text == "z" || event.text == "Z")) {
                                            if (event.modifiers.shift) {
                                                root.redo();
                                            } else {
                                                root.undo();
                                            }
                                            accept
                                        } else if (event.modifiers.control && (event.text == "y" || event.text == "Y")) {
                                            root.redo();
                                            accept
                                        }
                                        reject
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        StatusBar {
            status-left: root.status-left;
            status-right: root.status-right;
        }
    }
}
