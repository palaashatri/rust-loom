import {
    DocumentChrome, Toolbar, ToolbarGroup, ToolbarSpacer, ToolbarButton,
    ToolbarIconButton, ToolkitStatusBar, CanvasSurface
} from "toolkit.slint";
import { CommandPalette, CommandPaletteItem } from "components.slint";
import { Theme } from "theme.slint";
import { TextEdit } from "std-widgets.slint";
export { Theme } from "theme.slint";
export { Palette as WidgetPalette } from "std-widgets.slint";

export component WriterApp inherits Window {
    title: "Loom Writer";
    min-width: 1024px;
    min-height: 720px;
    background: Theme.palette().canvas;
    property <bool> wide-toolbar: root.width >= 1320px;
    property <bool> labeled-export: root.width >= 1180px;

    in property <string> doc-title: "Untitled";
    in-out property <string> doc-content: "";
    in property <string> status-left: "";
    in property <string> status-right: "";
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;

    in-out property <bool> is-bold: false;
    in-out property <bool> is-italic: false;
    in-out property <bool> is-underline: false;
    in-out property <int> heading-level: 0;
    in-out property <int> text-alignment: 0;
    in-out property <float> zoom-value: 88.0;

    callback new-doc;
    callback open-doc;
    callback save-doc;
    callback save-as-doc;
    callback export-pdf;
    callback undo;
    callback redo;
    callback document-edited(string);
    callback toggle-bold;
    callback toggle-italic;
    callback toggle-underline;
    callback select-heading(int);
    callback select-alignment(int);

    in-out property <[CommandPaletteItem]> palette-commands: [];
    in-out property <bool> palette-open: false;
    in-out property <string> palette-query: "";
    in-out property <int> palette-selected: 0;
    callback palette-invoked(int);
    callback palette-query-changed(string);
    callback palette-move(int);
    callback palette-key-text(string);
    callback palette-backspace;
    callback palette-close;
    public function open-palette() {
        root.palette-open = true;
        root.palette-query = "";
        palette.grab-focus();
    }

    app-focus := FocusScope {
        key-pressed(event) => {
            if (root.palette-open) { return reject; }
            if (event.modifiers.control || event.modifiers.meta) {
                if (event.text == Key.K || event.text == "k") {
                    root.open-palette();
                    return accept;
                }
                if (event.text == "n" || event.text == "N") {
                    root.new-doc();
                    return accept;
                }
                if (event.text == "o" || event.text == "O") {
                    root.open-doc();
                    return accept;
                }
                if (event.text == "s" || event.text == "S") {
                    if (event.modifiers.shift) { root.save-as-doc(); } else { root.save-doc(); }
                    return accept;
                }
                if (event.text == "e" || event.text == "E") {
                    root.export-pdf();
                    return accept;
                }
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0px;
            padding: 0px;

            DocumentChrome {
                title: root.doc-title;
            }

            Toolbar {
                ToolbarGroup {
                    ToolbarIconButton { icon: "new"; label: "New document"; clicked => { root.new-doc(); } }
                    ToolbarIconButton { icon: "open"; label: "Open document"; clicked => { root.open-doc(); } }
                    ToolbarIconButton { icon: "save"; label: "Save"; clicked => { root.save-doc(); } }
                    ToolbarIconButton { icon: "undo"; label: "Undo"; enabled: root.can-undo; clicked => { root.undo(); } }
                    ToolbarIconButton { icon: "redo"; label: "Redo"; enabled: root.can-redo; clicked => { root.redo(); } }
                }

                ToolbarGroup {
                    leading-separation: true;
                    ToolbarButton { label: "Body"; checked: root.heading-level == 0; clicked => { root.select-heading(0); } }
                    ToolbarButton { label: "H1"; checked: root.heading-level == 1; clicked => { root.select-heading(1); } }
                    ToolbarButton { label: "H2"; checked: root.heading-level == 2; clicked => { root.select-heading(2); } }
                    ToolbarButton { label: "H3"; checked: root.heading-level == 3; clicked => { root.select-heading(3); } }
                    ToolbarIconButton {
                        icon: "bold";
                        label: "Bold";
                        checked: root.is-bold;
                        clicked => { root.is-bold = !root.is-bold; root.toggle-bold(); }
                    }
                    ToolbarIconButton {
                        icon: "italic";
                        label: "Italic";
                        checked: root.is-italic;
                        clicked => { root.is-italic = !root.is-italic; root.toggle-italic(); }
                    }
                    ToolbarIconButton {
                        icon: "underline";
                        label: "Underline";
                        checked: root.is-underline;
                        clicked => { root.is-underline = !root.is-underline; root.toggle-underline(); }
                    }
                    if root.wide-toolbar : ToolbarIconButton {
                        icon: "align-left";
                        label: "Align left";
                        checked: root.text-alignment == 0;
                        clicked => { root.select-alignment(0); }
                    }
                    if root.wide-toolbar : ToolbarIconButton {
                        icon: "align-center";
                        label: "Align center";
                        checked: root.text-alignment == 1;
                        clicked => { root.select-alignment(1); }
                    }
                    if root.wide-toolbar : ToolbarIconButton {
                        icon: "align-right";
                        label: "Align right";
                        checked: root.text-alignment == 2;
                        clicked => { root.select-alignment(2); }
                    }
                }

                ToolbarSpacer { }

                ToolbarGroup {
                    ToolbarIconButton {
                        icon: "minus";
                        label: "Zoom out";
                        clicked => { root.zoom-value = Math.max(40, root.zoom-value - 10); }
                    }
                    Text {
                        text: Math.round(root.zoom-value) + "%";
                        min-width: 44px;
                        font-size: Theme.tokens.typography.caption;
                        font-weight: 500;
                        color: Theme.palette().ink-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    ToolbarIconButton {
                        icon: "plus";
                        label: "Zoom in";
                        clicked => { root.zoom-value = Math.min(160, root.zoom-value + 10); }
                    }
                    if root.labeled-export : ToolbarButton {
                        icon: "export";
                        label: "Export PDF";
                        primary: true;
                        clicked => { root.export-pdf(); }
                    }
                    if !root.labeled-export : ToolbarIconButton {
                        icon: "export";
                        label: "Export PDF";
                        clicked => { root.export-pdf(); }
                    }
                }
            }

            CanvasSurface {
                page := Rectangle {
                    width: min(760px, parent.width - 48px);
                    height: parent.height - 48px;
                    x: (parent.width - self.width) / 2;
                    y: 24px;
                    background: Theme.palette().paper;
                    border-width: 1px;
                    border-color: Theme.palette().paper-line;
                    clip: true;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: 24px;
                        background: Theme.palette().surface;

                        HorizontalLayout {
                            spacing: 0px;
                            padding-left: 64px;
                            padding-right: 64px;
                            for marker in ["0", "1", "2", "3", "4", "5", "6", "7"] : Rectangle {
                                horizontal-stretch: 1;
                                Text {
                                    text: marker;
                                    font-size: Theme.tokens.typography.micro;
                                    color: Theme.palette().paper-muted;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    x: 0px;
                                    y: parent.height - 6px;
                                    width: 1px;
                                    height: 6px;
                                    background: Theme.palette().paper-line;
                                }
                            }
                        }
                    }

                    Rectangle {
                        x: 0px;
                        y: 24px;
                        width: parent.width;
                        height: parent.height - 24px;

                        TextEdit {
                            x: 64px;
                            y: 48px;
                            width: parent.width - 128px;
                            height: parent.height - 96px;
                            text <=> root.doc-content;
                            font-size: Theme.tokens.typography.body-large;
                            placeholder-text: "Start writing…";
                            wrap: word-wrap;
                            edited => { root.document-edited(self.text); }
                            key-pressed(event) => {
                                if (event.modifiers.control && (event.text == "z" || event.text == "Z")) {
                                    if (event.modifiers.shift) { root.redo(); } else { root.undo(); }
                                    accept
                                } else if ((event.modifiers.control || event.modifiers.meta) && (event.text == "y" || event.text == "Y")) {
                                    root.redo();
                                    accept
                                } else if ((event.modifiers.control || event.modifiers.meta) && (event.text == "s" || event.text == "S")) {
                                    if (event.modifiers.shift) { root.save-as-doc(); } else { root.save-doc(); }
                                    accept
                                } else if ((event.modifiers.control || event.modifiers.meta) && (event.text == "o" || event.text == "O")) {
                                    root.open-doc();
                                    accept
                                } else if ((event.modifiers.control || event.modifiers.meta) && (event.text == "e" || event.text == "E")) {
                                    root.export-pdf();
                                    accept
                                }
                                reject
                            }
                        }
                    }
                }
            }

            ToolkitStatusBar {
                leading: root.status-left;
                trailing: root.status-right + (root.status-right == "" ? "" : "  •  ") + Math.round(root.zoom-value) + "%";
            }
        }

        palette := CommandPalette {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            open: root.palette-open;
            commands: root.palette-commands;
            query: root.palette-query;
            selected: root.palette-selected;
            command-invoked(idx) => { root.palette-invoked(idx); }
            query-changed(q) => {
                root.palette-query = q;
                root.palette-query-changed(q);
            }
            move-selection(delta) => { root.palette-move(delta); }
            key-text(text) => { root.palette-key-text(text); }
            backspace => { root.palette-backspace(); }
            close-requested => {
                root.palette-open = false;
                app-focus.focus();
            }
        }
    }
}
