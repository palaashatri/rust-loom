import {
    DocumentChrome, Toolbar, ToolbarGroup, ToolbarSpacer, ToolbarButton,
    ToolbarIconButton, ToolbarOverflowButton, AppleToolbarItem, ToolkitStatusBar, CanvasSurface, InspectorSurface,
    SectionHeader, TextField, SegmentedControl, PropertyRow
} from "toolkit.slint";
import { CommandPalette, CommandPaletteItem } from "components.slint";
import { Icon } from "icons.slint";
import { Theme } from "theme.slint";
export { Theme } from "theme.slint";
export { Palette as WidgetPalette } from "std-widgets.slint";

/// A Pages-class portrait template card for the New Document chooser.
/// Uses realistic paper proportions (1:1.414 portrait) with deterministic
/// Slint geometry to represent document templates.
component TemplateCard inherits Rectangle {
    in property <int> template-index: 0;
    in property <string> template-name: "Blank";
    in property <string> description: "Start from an empty page";
    in property <bool> selected: false;
    callback clicked;

    width: 160px;
    height: 230px;
    border-radius: Theme.tokens.metrics.radius-medium;
    background: touch.has-hover && !root.selected ? Theme.palette().surface-raised : transparent;
    accessible-role: button;
    accessible-label: root.template-name + " template";
    accessible-action-default => { root.clicked(); }

    VerticalLayout {
        spacing: 10px;
        padding: 6px;
        alignment: center;
        cross-axis-alignment: center;

        Rectangle {
            width: 140px;
            height: 175px;
            border-radius: 4px;
            border-width: root.selected ? 2.5px : 1px;
            border-color: root.selected ? Theme.palette().accent : Theme.palette().paper-line;
            background: Theme.palette().paper;
            drop-shadow-blur: 10px;
            drop-shadow-offset-y: 3px;
            drop-shadow-color: Theme.palette().shadow;
            clip: true;

            // Template 0: Blank
            if root.template-index == 0 : VerticalLayout {
                spacing: 8px;
                padding: 16px;
                Text {
                    text: "Aa";
                    font-size: 32px;
                    font-weight: 700;
                    color: Theme.palette().paper-ink;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    vertical-stretch: 1;
                }
                Rectangle { height: 1px; background: Theme.palette().paper-line; }
            }

            // Template 1: Report
            if root.template-index == 1 : VerticalLayout {
                spacing: 6px;
                padding: 14px;
                Text { text: "REPORT TITLE"; font-size: 10px; font-weight: 700; color: Theme.palette().paper-ink; }
                Rectangle { height: 2px; background: Theme.palette().accent; }
                Rectangle { height: 3px; background: Theme.palette().paper-line; }
                Rectangle { height: 3px; background: Theme.palette().paper-line; }
                Rectangle { height: 3px; width: 75%; background: Theme.palette().paper-line; }
                Rectangle { height: 8px; background: transparent; }
                Text { text: "Executive Summary"; font-size: 8px; font-weight: 600; color: Theme.palette().paper-muted; }
                Rectangle { height: 3px; background: Theme.palette().paper-line; }
                Rectangle { height: 3px; width: 85%; background: Theme.palette().paper-line; }
                Rectangle { vertical-stretch: 1; background: transparent; }
            }

            // Template 2: Letter
            if root.template-index == 2 : VerticalLayout {
                spacing: 6px;
                padding: 14px;
                Text { text: "Your Name"; font-size: 11px; font-weight: 600; color: Theme.palette().paper-ink; }
                Text { text: "October 24, 2026"; font-size: 8px; color: Theme.palette().paper-muted; }
                Rectangle { height: 1px; background: Theme.palette().paper-line; }
                Text { text: "Dear Recipient,"; font-size: 8px; color: Theme.palette().paper-ink; }
                Rectangle { height: 3px; background: Theme.palette().paper-line; }
                Rectangle { height: 3px; background: Theme.palette().paper-line; }
                Rectangle { height: 3px; width: 60%; background: Theme.palette().paper-line; }
                Rectangle { vertical-stretch: 1; background: transparent; }
            }

            // Template 3: CV / Resume
            if root.template-index == 3 : VerticalLayout {
                spacing: 5px;
                padding: 12px;
                Text { text: "YOUR NAME"; font-size: 11px; font-weight: 700; color: Theme.palette().paper-ink; }
                Rectangle { height: 2px; background: Theme.palette().content-cool; }
                Text { text: "EXPERIENCE"; font-size: 8px; font-weight: 600; color: Theme.palette().paper-muted; }
                Rectangle { height: 3px; background: Theme.palette().paper-line; }
                Rectangle { height: 3px; width: 80%; background: Theme.palette().paper-line; }
                Text { text: "EDUCATION"; font-size: 8px; font-weight: 600; color: Theme.palette().paper-muted; }
                Rectangle { height: 3px; background: Theme.palette().paper-line; }
                Rectangle { vertical-stretch: 1; background: transparent; }
            }
        }

        if root.selected : Rectangle {
            height: 20px;
            border-radius: 4px;
            background: Theme.palette().accent;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                alignment: center;
                cross-axis-alignment: center;
                Text {
                    text: root.template-name;
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.palette().accent-ink;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if !root.selected : Text {
            text: root.template-name;
            font-size: 11px;
            font-weight: 500;
            color: Theme.palette().ink;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

/// The document editor text area rendered inside the white page.
component DocumentPageEditor inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder: "Type your text here...";
    in property <bool> enabled: true;
    in property <length> font-size: 14px;
    callback edited(string);
    callback key-pressed(event: KeyEvent) -> EventResult;

    background: transparent;
    accessible-role: AccessibleRole.text-input;
    accessible-label: "Document body";
    accessible-enabled: root.enabled;
    accessible-value <=> root.text;
    accessible-placeholder-text: root.placeholder;
    accessible-action-default => { editor.focus(); }
    forward-focus: editor;

    if root.text == "" : Text {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        text: root.placeholder;
        font-size: root.font-size;
        color: Theme.palette().paper-muted;
        vertical-alignment: top;
        wrap: word-wrap;
        accessible-role: none;
    }

    editor := TextInput {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        text <=> root.text;
        enabled: root.enabled;
        single-line: false;
        wrap: word-wrap;
        vertical-alignment: top;
        font-size: root.font-size;
        color: root.enabled ? Theme.palette().paper-ink : Theme.palette().ink-disabled;
        selection-background-color: Theme.palette().selection;
        selection-foreground-color: Theme.palette().accent-ink;
        accessible-role: none;
        edited => { root.edited(editor.text); }
        key-pressed(event) => { return root.key-pressed(event); }
    }

    TouchArea {
        clicked => { editor.focus(); }
    }
}

export component WriterApp inherits Window {
    title: "Loom Writer";
    min-width: 900px;
    min-height: 680px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.palette().canvas;

    in property <bool> wide-toolbar: false;
    in property <bool> labeled-export: false;
    in property <bool> overflow-toolbar: false;
    in-out property <bool> toolbar-overflow-open: false;
    in-out property <bool> show-inspector: false;
    in property <bool> inspector-available: true;
    property <bool> inspector-visible: root.show-inspector && root.inspector-available;
    in-out property <int> inspector-tab: 0;
    callback window-resized(length);
    changed width => {
        root.window-resized(root.width);
        if (root.width >= 1180px) {
            root.toolbar-overflow-open = false;
            app-focus.focus();
        }
    }

    in property <string> doc-title: "Untitled Document";
    in-out property <string> doc-content: "";
    in property <string> status-left: "";
    in property <string> status-right: "";
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;

    in-out property <bool> is-bold: false;
    in-out property <bool> is-italic: false;
    in-out property <bool> is-underline: false;
    in-out property <int> heading-level: 0;
    in-out property <int> text-alignment: 0;

    in-out property <bool> template-chooser-open: false;
    in-out property <int> template-selected: 0;
    in-out property <int> template-category: 0;

    callback new-doc;
    callback open-doc;
    callback save-doc;
    callback save-as-doc;
    callback export-pdf;
    callback undo;
    callback redo;
    callback document-edited(string);
    callback toggle-bold;
    callback toggle-italic;
    callback toggle-underline;
    callback select-heading(int);
    callback select-alignment(int);
    callback toggle-inspector;
    callback create-template(int);
    callback cancel-template;

    in-out property <[CommandPaletteItem]> palette-commands: [];
    in-out property <bool> palette-open: false;
    in-out property <string> palette-query: "";
    in-out property <int> palette-selected: 0;
    callback palette-invoked(int);
    callback palette-query-changed(string);
    callback palette-move(int);
    callback palette-key-text(string);
    callback palette-backspace;
    callback palette-close;

    public function open-palette() {
        root.palette-open = true;
        root.palette-query = "";
        palette.grab-focus();
    }

    function template-visible(template-index: int) -> bool {
        return root.template-category == 0
            || (root.template-category == 1 && template-index <= 1)
            || (root.template-category == 2 && template-index == 2)
            || (root.template-category == 3 && template-index == 3);
    }

    function choose-template-category(category-index: int) {
        root.template-category = category-index;
        if (category-index == 1 && root.template-selected > 1) {
            root.template-selected = 0;
        } else if (category-index == 2) {
            root.template-selected = 2;
        } else if (category-index == 3) {
            root.template-selected = 3;
        }
    }

    function compact-label(full-label: string) -> string {
        return root.wide-toolbar ? full-label : "";
    }

    function close-toolbar-overflow() {
        root.toolbar-overflow-open = false;
        app-focus.focus();
    }

    changed overflow-toolbar => {
        if (!root.overflow-toolbar) {
            root.toolbar-overflow-open = false;
            app-focus.focus();
        }
    }

    overflow-menu-focus := FocusScope {
        enabled: root.toolbar-overflow-open;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-toolbar-overflow();
                return accept;
            }
            return reject;
        }
    }

    template-chooser-focus := FocusScope {
        enabled: root.template-chooser-open;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel-template();
                return accept;
            }
            if (event.text == Key.Return) {
                root.create-template(root.template-selected);
                return accept;
            }
            return reject;
        }
    }

    changed template-chooser-open => {
        if (root.template-chooser-open) {
            template-chooser-focus.focus();
        } else {
            app-focus.focus();
        }
    }

    app-focus := FocusScope {
        key-pressed(event) => {
            if (root.palette-open || root.template-chooser-open || root.toolbar-overflow-open) { return reject; }
            if (event.modifiers.control || event.modifiers.meta) {
                if (event.text == Key.K || event.text == "k") {
                    root.open-palette();
                    return accept;
                }
                if (event.text == "n" || event.text == "N") {
                    root.new-doc();
                    return accept;
                }
                if (event.text == "o" || event.text == "O") {
                    root.open-doc();
                    return accept;
                }
                if (event.text == "s" || event.text == "S") {
                    if (event.modifiers.shift) { root.save-as-doc(); } else { root.save-doc(); }
                    return accept;
                }
                if (event.text == "e" || event.text == "E") {
                    root.export-pdf();
                    return accept;
                }
                if (event.text == "b" || event.text == "B") {
                    root.toggle-bold();
                    return accept;
                }
                if (event.text == "i" || event.text == "I") {
                    root.toggle-italic();
                    return accept;
                }
                if (event.text == "u" || event.text == "U") {
                    root.toggle-underline();
                    return accept;
                }
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0px;
            padding: 0px;

            // Document Chrome Titlebar
            DocumentChrome {
                title: root.doc-title;
                trailing-text: "";
            }

            // Pages-Style Action Toolbar
            Toolbar {
                // Left group: View, page zoom, Add Page
                ToolbarGroup {
                    if root.wide-toolbar : AppleToolbarItem {
                        icon: "eye";
                        label: root.compact-label("View");
                        accessible-label: "View";
                        enabled: root.inspector-available;
                        clicked => { if (root.inspector-available) { root.toggle-inspector(); } }
                    }
                    if root.wide-toolbar : AppleToolbarItem {
                        icon: "zoom-in";
                        label: root.compact-label("Page Zoom");
                        accessible-label: "Page zoom unavailable";
                        enabled: false;
                    }
                    if root.wide-toolbar : AppleToolbarItem {
                        icon: "plus";
                        label: root.compact-label("Add Page");
                        accessible-label: "Add Page unavailable";
                        enabled: false;
                    }
                    if !root.wide-toolbar && !root.overflow-toolbar : ToolbarIconButton {
                        icon: "eye";
                        label: "View";
                        enabled: root.inspector-available;
                        clicked => { root.toggle-inspector(); }
                    }
                    if root.overflow-toolbar : ToolbarOverflowButton {
                        label: "More Writer actions";
                        clicked => {
                            if (root.toolbar-overflow-open) {
                                root.close-toolbar-overflow();
                            } else {
                                root.toolbar-overflow-open = true;
                                overflow-menu-focus.focus();
                            }
                        }
                    }
                }

                if !root.overflow-toolbar : ToolbarSpacer { }

                // Center group: Table, Chart, Text, Shape, Media, Comment
                if root.wide-toolbar : ToolbarGroup {
                    AppleToolbarItem { icon: "table"; label: root.compact-label("Table"); accessible-label: "Insert table unavailable"; enabled: false; }
                    AppleToolbarItem { icon: "chart"; label: root.compact-label("Chart"); accessible-label: "Insert chart unavailable"; enabled: false; }
                    AppleToolbarItem { icon: "text"; label: root.compact-label("Text"); accessible-label: "Insert text box unavailable"; enabled: false; }
                    AppleToolbarItem { icon: "shape"; label: root.compact-label("Shape"); accessible-label: "Insert shape unavailable"; enabled: false; }
                    AppleToolbarItem { icon: "image"; label: root.compact-label("Media"); accessible-label: "Insert media unavailable"; enabled: false; }
                    AppleToolbarItem { icon: "comment"; label: root.compact-label("Comment"); accessible-label: "Insert comment unavailable"; enabled: false; }
                }

                if !root.overflow-toolbar : ToolbarSpacer { }

                // Right group: Share, Format, Document / Export
                if root.wide-toolbar : ToolbarGroup {
                    AppleToolbarItem { icon: "share"; label: root.compact-label("Share"); accessible-label: "Share unavailable"; enabled: false; }
                    AppleToolbarItem {
                        icon: "format";
                        label: root.compact-label("Format");
                        accessible-label: "Format inspector";
                        checked: root.inspector-visible;
                        enabled: root.inspector-available;
                        clicked => { if (root.inspector-available) { root.toggle-inspector(); } }
                    }
                    AppleToolbarItem {
                        icon: "document";
                        label: root.compact-label("Document");
                        accessible-label: "Document settings unavailable";
                        checked: false;
                        enabled: false;
                    }
                    AppleToolbarItem {
                        icon: "export";
                        label: root.labeled-export ? "Export" : "";
                        accessible-label: "Export PDF";
                        clicked => { root.export-pdf(); }
                    }
                }
                if !root.wide-toolbar && !root.overflow-toolbar : ToolbarGroup {
                    ToolbarIconButton {
                        icon: "format";
                        label: "Format";
                        checked: root.inspector-visible;
                        enabled: root.inspector-available;
                        clicked => { if (root.inspector-available) { root.toggle-inspector(); } }
                    }
                    ToolbarIconButton {
                        icon: "export";
                        label: "Export PDF";
                        clicked => { root.export-pdf(); }
                    }
                }
            }

            // Main Editor Canvas and Right Inspector
            HorizontalLayout {
                spacing: 0px;
                vertical-stretch: 1;

                // Document Canvas Area
                CanvasSurface {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    // Centered Document Page
                    Rectangle {
                        // Keep the editable page recognizably portrait at
                        // every desktop height. Width must follow the paper
                        // height rather than independently consuming a wide
                        // canvas, which produced a landscape "document".
                        private property <length> page-height: min(1080px, max(420px, parent.height - 48px));
                        x: max(24px, (parent.width - self.width) / 2);
                        y: max(24px, (parent.height - self.height) / 2);
                        width: min(820px, max(320px, self.page-height * 0.72));
                        height: self.page-height;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Theme.palette().border;
                        background: Theme.palette().paper;
                        drop-shadow-blur: 24px;
                        drop-shadow-offset-y: 8px;
                        drop-shadow-color: Theme.palette().shadow;
                        clip: true;

                        VerticalLayout {
                            padding-top: 48px;
                            padding-bottom: 48px;
                            padding-left: 56px;
                            padding-right: 56px;
                            spacing: 12px;

                            Text {
                                text: root.doc-title;
                                font-size: 22px;
                                font-weight: 700;
                                color: Theme.palette().paper-ink;
                            }
                            Text {
                                text: "Local-first document";
                                font-size: 13px;
                                font-weight: 400;
                                color: Theme.palette().paper-muted;
                            }
                            Rectangle { height: 1.5px; background: Theme.palette().paper-line; }

                            DocumentPageEditor {
                                text <=> root.doc-content;
                                font-size: 15px;
                                edited(val) => { root.document-edited(val); }
                            }
                        }
                    }
                }

                // Apple Pages-Style Text Inspector
                if root.inspector-visible : InspectorSurface {
                    title: "Format";
                    width: 280px;

                    VerticalLayout {
                        spacing: 12px;
                        padding: 12px;
                        alignment: start;

                        // Tab selector: Style | Layout | More
                        SegmentedControl {
                            items: ["Style", "Layout", "More"];
                            current <=> root.inspector-tab;
                            label: "Format Tabs";
                        }

                        // Paragraph Style Section
                        SectionHeader { title: "Paragraph Style"; }

                        SegmentedControl {
                            items: ["Body", "H1", "H2", "Title"];
                            current <=> root.heading-level;
                            label: "Heading Style";
                            selected(idx) => { root.select-heading(idx); }
                        }

                        // Font & Typography Section
                        SectionHeader { title: "Font"; }

                        PropertyRow {
                            label: "Family";
                            TextField {
                                label: "Font family";
                                value: "Helvetica Neue";
                                enabled: false;
                            }
                        }

                        // Inline Formatting: B I U S
                        PropertyRow {
                            label: "Style";
                            HorizontalLayout {
                                spacing: 4px;

                                ToolbarIconButton {
                                    icon: "bold";
                                    label: "Bold";
                                    checked: root.is-bold;
                                    clicked => { root.toggle-bold(); }
                                }
                                ToolbarIconButton {
                                    icon: "italic";
                                    label: "Italic";
                                    checked: root.is-italic;
                                    clicked => { root.toggle-italic(); }
                                }
                                ToolbarIconButton {
                                    icon: "underline";
                                    label: "Underline";
                                    checked: root.is-underline;
                                    clicked => { root.toggle-underline(); }
                                }
                                ToolbarIconButton {
                                    icon: "strikethrough";
                                    label: "Strikethrough";
                                    checked: false;
                                    enabled: false;
                                }
                            }
                        }

                        // Alignment Section
                        SectionHeader { title: "Alignment"; }

                        SegmentedControl {
                            items: ["Left", "Center", "Right", "Justify"];
                            current <=> root.text-alignment;
                            label: "Text Alignment";
                            selected(idx) => { root.select-alignment(idx); }
                        }

                        PropertyRow {
                            label: "Indentation";
                            HorizontalLayout {
                                spacing: 4px;
                                ToolbarIconButton {
                                    icon: "outdent";
                                    label: "Decrease indent";
                                    enabled: false;
                                }
                                ToolbarIconButton {
                                    icon: "indent";
                                    label: "Increase indent";
                                    enabled: false;
                                }
                            }
                        }

                        // Spacing & Lists Section
                        SectionHeader { title: "Spacing & Lists"; }

                        PropertyRow {
                            label: "Line Spacing";
                            TextField {
                                label: "Line Spacing";
                                value: "1.15";
                                enabled: false;
                            }
                        }

                        PropertyRow {
                            label: "Bullets";
                            TextField {
                                label: "Bullets & Lists";
                                value: "None";
                                enabled: false;
                            }
                        }

                        Rectangle { vertical-stretch: 1; background: transparent; }

                        // Document Statistics Summary Card
                        Rectangle {
                            height: 68px;
                            border-radius: 6px;
                            background: Theme.palette().surface-sunken;
                            border-width: 1px;
                            border-color: Theme.palette().border;

                            VerticalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                padding-top: 10px;
                                padding-bottom: 10px;
                                spacing: 4px;
                                alignment: center;
                                Text {
                                    text: "Document Statistics";
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: Theme.palette().ink;
                                }
                                Text {
                                    text: root.status-left;
                                    font-size: 11px;
                                    color: Theme.palette().ink-secondary;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }

            // Standard Status Bar
            ToolkitStatusBar {
                leading: root.status-left;
                trailing: root.status-right;
            }
        }
    }

    // Compact toolbars keep the primary workspace clear and expose every
    // currently actionable toolbar command through one real,
    // keyboard-accessible menu.
    if root.toolbar-overflow-open && root.overflow-toolbar : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: transparent;

        TouchArea {
            clicked => { root.close-toolbar-overflow(); }
        }

        Rectangle {
            x: max(8px, root.width - 272px);
            y: Theme.tokens.metrics.header-height + 8px;
            width: 256px;
            height: 148px;
            border-radius: Theme.tokens.metrics.radius-medium;
            border-width: 1px;
            border-color: Theme.palette().border;
            background: Theme.palette().surface;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.palette().shadow;

            VerticalLayout {
                spacing: 4px;
                padding: 8px;

                ToolbarButton {
                    icon: "eye";
                    label: "View";
                    enabled: root.inspector-available;
                    horizontal-stretch: 1;
                    clicked => { root.toggle-inspector(); root.close-toolbar-overflow(); }
                }
                ToolbarButton {
                    icon: "format";
                    label: "Format";
                    checked: root.inspector-visible;
                    enabled: root.inspector-available;
                    horizontal-stretch: 1;
                    clicked => { root.toggle-inspector(); root.close-toolbar-overflow(); }
                }
                ToolbarButton {
                    icon: "export";
                    label: "Export PDF";
                    horizontal-stretch: 1;
                    clicked => { root.export-pdf(); root.close-toolbar-overflow(); }
                }
            }
        }
    }

    // Modal Template Chooser matching Apple Pages reference
    if root.template-chooser-open : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: Theme.palette().scrim;

        Rectangle {
            // Keep the chooser almost as broad and tall as the surrounding
            // window, while retaining a visible margin on compact desktops.
            width: min(1160px, max(1px, parent.width - 48px));
            x: (parent.width - self.width) / 2;
            height: min(760px, max(480px, parent.height - 48px));
            y: (parent.height - self.height) / 2;
            border-radius: Theme.tokens.metrics.radius-large;
            border-width: 1px;
            border-color: Theme.palette().border;
            background: Theme.palette().surface;
            clip: true;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: Theme.palette().shadow;

            VerticalLayout {
                spacing: 0px;
                padding: 0px;

                // Main body: Sidebar + Content Grid
                HorizontalLayout {
                    spacing: 0px;
                    vertical-stretch: 1;

                    // Left Category Sidebar
                    Rectangle {
                        width: 220px;
                        background: Theme.palette().panel;

                        VerticalLayout {
                            spacing: 4px;
                            padding-top: 16px; padding-bottom: 16px; padding-left: 12px; padding-right: 12px;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-bottom: 4px;
                                Text {
                                    text: "TEMPLATES";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: Theme.palette().ink-secondary;
                                }
                            }

                            // Category items
                            Rectangle {
                                height: 32px;
                                border-radius: Theme.tokens.metrics.radius-medium;
                                background: root.template-category == 0 ? Theme.palette().surface-raised : transparent;
                                HorizontalLayout {
                                    spacing: 8px; padding-left: 10px; padding-right: 10px; cross-axis-alignment: center;
                                    Icon { size: 16px; icon: "grid"; tint: root.template-category == 0 ? Theme.palette().accent : Theme.palette().ink-secondary; }
                                    Text {
                                        text: "All Templates";
                                        font-size: Theme.tokens.typography.body;
                                        font-weight: root.template-category == 0 ? 600 : 400;
                                        color: Theme.palette().ink;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.choose-template-category(0); } }
                            }

                            Rectangle {
                                height: 32px;
                                border-radius: Theme.tokens.metrics.radius-medium;
                                background: root.template-category == 1 ? Theme.palette().surface-raised : transparent;
                                HorizontalLayout {
                                    spacing: 8px; padding-left: 10px; padding-right: 10px; cross-axis-alignment: center;
                                    Icon { size: 16px; icon: "document"; tint: root.template-category == 1 ? Theme.palette().accent : Theme.palette().ink-secondary; }
                                    Text {
                                        text: "Basic";
                                        font-size: Theme.tokens.typography.body;
                                        font-weight: root.template-category == 1 ? 600 : 400;
                                        color: Theme.palette().ink;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.choose-template-category(1); } }
                            }

                            Rectangle {
                                height: 32px;
                                border-radius: Theme.tokens.metrics.radius-medium;
                                background: root.template-category == 2 ? Theme.palette().surface-raised : transparent;
                                HorizontalLayout {
                                    spacing: 8px; padding-left: 10px; padding-right: 10px; cross-axis-alignment: center;
                                    Icon { size: 16px; icon: "folder"; tint: root.template-category == 2 ? Theme.palette().accent : Theme.palette().ink-secondary; }
                                    Text {
                                        text: "Letters";
                                        font-size: Theme.tokens.typography.body;
                                        font-weight: root.template-category == 2 ? 600 : 400;
                                        color: Theme.palette().ink;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.choose-template-category(2); } }
                            }

                            Rectangle {
                                height: 32px;
                                border-radius: Theme.tokens.metrics.radius-medium;
                                background: root.template-category == 3 ? Theme.palette().surface-raised : transparent;
                                HorizontalLayout {
                                    spacing: 8px; padding-left: 10px; padding-right: 10px; cross-axis-alignment: center;
                                    Icon { size: 16px; icon: "layers"; tint: root.template-category == 3 ? Theme.palette().accent : Theme.palette().ink-secondary; }
                                    Text {
                                        text: "Curricula Vitae";
                                        font-size: Theme.tokens.typography.body;
                                        font-weight: root.template-category == 3 ? 600 : 400;
                                        color: Theme.palette().ink;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.choose-template-category(3); } }
                            }

                            Rectangle { vertical-stretch: 1; background: transparent; }

                            // Bottom Language indicator
                            HorizontalLayout {
                                spacing: 6px; padding: 8px;
                                Text {
                                    text: "English (US)";
                                    font-size: Theme.tokens.typography.caption;
                                    color: Theme.palette().ink-secondary;
                                    vertical-alignment: center;
                                }
                                Icon { size: 12px; icon: "chevron-down"; tint: Theme.palette().ink-secondary; }
                            }
                        }

                        Rectangle { x: parent.width - 1px; y: 0px; width: 1px; height: parent.height; background: Theme.palette().border; }
                    }

                    // Right Content Area
                    VerticalLayout {
                        horizontal-stretch: 1;
                        padding-top: 24px; padding-bottom: 20px; padding-left: 28px; padding-right: 28px;
                        spacing: 16px;

                        Text {
                            text: "Choose a Template";
                            font-size: 24px;
                            font-weight: 700;
                            color: Theme.palette().ink;
                        }

                        // Two rows keep the fixed paper preview cards inside
                        // the content column at the 900px contract minimum.
                        VerticalLayout {
                            spacing: 16px;

                            HorizontalLayout {
                                spacing: 16px;

                                if root.template-visible(0) : TemplateCard {
                                    template-index: 0;
                                    template-name: "Blank";
                                    description: "A clean page for any idea";
                                    selected: root.template-selected == 0;
                                    clicked => { root.template-selected = 0; }
                                }

                                if root.template-visible(1) : TemplateCard {
                                    template-index: 1;
                                    template-name: "Report";
                                    description: "A structured document";
                                    selected: root.template-selected == 1;
                                    clicked => { root.template-selected = 1; }
                                }
                            }

                            HorizontalLayout {
                                spacing: 16px;

                                if root.template-visible(2) : TemplateCard {
                                    template-index: 2;
                                    template-name: "Letter";
                                    description: "Formal correspondence";
                                    selected: root.template-selected == 2;
                                    clicked => { root.template-selected = 2; }
                                }

                                if root.template-visible(3) : TemplateCard {
                                    template-index: 3;
                                    template-name: "CV";
                                    description: "Professional resume";
                                    selected: root.template-selected == 3;
                                    clicked => { root.template-selected = 3; }
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }
                }

                // Bottom Action Bar
                Rectangle {
                    height: 56px;
                    background: Theme.palette().chrome;

                    Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.palette().border; }

                    HorizontalLayout {
                        spacing: 12px;
                        padding-left: 20px;
                        padding-right: 20px;
                        cross-axis-alignment: center;

                        Text {
                            text: "Escape to cancel • Return to create";
                            font-size: Theme.tokens.typography.caption;
                            color: Theme.palette().ink-secondary;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }

                        ToolbarButton {
                            label: "Cancel";
                            clicked => { root.cancel-template(); }
                        }

                        ToolbarButton {
                            label: "Create Document";
                            primary: true;
                            clicked => { root.create-template(root.template-selected); }
                        }
                    }
                }
            }
        }
    }

        palette := CommandPalette {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            open: root.palette-open;
            commands: root.palette-commands;
            query: root.palette-query;
            selected: root.palette-selected;
            command-invoked(idx) => { root.palette-invoked(idx); }
            query-changed(q) => {
                root.palette-query = q;
                root.palette-query-changed(q);
            }
            move-selection(delta) => { root.palette-move(delta); }
            key-text(text) => { root.palette-key-text(text); }
            backspace => { root.palette-backspace(); }
            close-requested => {
                root.palette-open = false;
                root.palette-close();
            }
        }
}
