import {
    LoomSectionHeader,
    LoomSegmentedControl,
    LoomIconButton,
    LoomButton,
    LoomNumericField,
    LoomColorWell,
    LoomColorPalette,
} from "foundation.slint";
import { Theme } from "theme.slint";
import { ParagraphOptionsSection } from "paragraph_options.slint";
import { FontPicker, WriterFontField, WriterFontList } from "font_picker.slint";
import { WriterFormatState } from "alignment_state.slint";
import { WriterTableInspector } from "table_inspector.slint";

component InspectorDivider inherits Rectangle {
    height: 1px;
    background: Theme.palette().border;
}

export component WriterFormatTab inherits VerticalLayout {
    in-out property <bool> is-table-selected: false;
    in-out property <string> table-style-id: "table-style-medium-1";
    in-out property <bool> table-header-row: true;
    in-out property <bool> table-banded-rows: true;
    in-out property <bool> table-first-column: false;
    in-out property <int> heading-level: 0;
    in-out property <int> font-size-pt: 11;
    in-out property <string> font-size-value: "11";
    in-out property <int> text-alignment: 0;
    in-out property <int> line-spacing-index: 1;
    in-out property <int> list-style-index: 0;
    in property <bool> is-bold: false;
    in property <bool> is-italic: false;
    in property <bool> is-underline: false;
    in property <bool> is-strikethrough: false;
    in property <string> shortcut-modifier: "Ctrl";
    callback set-table-style(string);
    callback toggle-table-option(string);
    callback table-action(string);
    callback select-heading(int);
    callback increase-font-size;
    callback decrease-font-size;
    callback apply-font-size(string) -> bool;
    callback toggle-bold;
    callback toggle-italic;
    callback toggle-underline;
    callback toggle-strikethrough;
    callback select-alignment(int);
    callback indent-text;
    callback outdent-text;
    callback select-line-spacing(int);
    callback select-list-style(int);

    property <string> font-size-draft: "11";
    property <bool> font-size-invalid: false;
    property <bool> paragraph-options-expanded: false;
    property <bool> baseline-options-expanded: false;
    property <int> table-subtab: 1;

    changed is-table-selected => {
        if (root.is-table-selected) {
            root.table-subtab = 1;
        }
    }

    changed font-size-value => {
        root.font-size-draft = root.font-size-value;
        root.font-size-invalid = false;
    }
            spacing: Theme.tokens.space.sm;

            if root.is-table-selected : VerticalLayout {
                padding-left: Theme.tokens.space.xl;
                padding-right: Theme.tokens.space.xl;
                LoomSegmentedControl {
                    items: ["Text", "Table"];
                    current <=> root.table-subtab;
                    label: "Format Scope";
                }
            }
            if root.is-table-selected && root.table-subtab == 1 : WriterTableInspector {
                current-style-id <=> root.table-style-id;
                header-row <=> root.table-header-row;
                banded-rows <=> root.table-banded-rows;
                first-column <=> root.table-first-column;
                set-table-style(id) => { root.set-table-style(id); }
                toggle-table-option(opt) => { root.toggle-table-option(opt); }
                table-action(act) => { root.table-action(act); }
            }

        if !root.is-table-selected || root.table-subtab == 0 : VerticalLayout {
            spacing: Theme.tokens.space.sm;

        LoomSectionHeader { title: "Text Style"; }

        VerticalLayout {
            padding-left: Theme.tokens.space.xl;
            padding-right: Theme.tokens.space.xl;
            heading-control := LoomSegmentedControl {
                items: ["Body", "H1", "H2", "H3"];
                current <=> root.heading-level;
                label: "Heading Style";
                selected(idx) => { root.select-heading(idx); }
            }
        }

        InspectorDivider { }
        LoomSectionHeader { title: "Font & Size"; }

        // Full-width font family selector so long family names never clip next to the size stepper.
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Theme.tokens.space.xs;
            padding-left: Theme.tokens.space.xl;
            padding-right: Theme.tokens.space.xl;

            WriterFontField {
                horizontal-stretch: 1;
            }

            // The open list sits cleanly beneath the full-width field; the panel scrolls.
            if FontPicker.open : WriterFontList { }

            // Clean, zero-double-border Font Size stepper row.
            HorizontalLayout {
                spacing: Theme.tokens.space.xs;
                cross-axis-alignment: center;
                min-height: max(Theme.scaled-control-height, 28px * max(1.0, Theme.text-scale));

                if !Theme.rtl : LoomIconButton {
                    text-scale: Theme.text-scale;
                    icon: "minus";
                    label: "Smaller";
                    tooltip: "Decrease font size";
                    clicked => { root.decrease-font-size(); }
                }
                if Theme.rtl : LoomIconButton {
                    text-scale: Theme.text-scale;
                    icon: "plus";
                    label: "Larger";
                    tooltip: "Increase font size";
                    clicked => { root.increase-font-size(); }
                }

                LoomNumericField {
                    horizontal-stretch: 1;
                    label: "Font size";
                    description: "6–72 pt in half-point increments";
                    unit: "pt";
                    field-min-width: 74px;
                    value <=> root.font-size-draft;
                    invalid: root.font-size-invalid;
                    edited(_) => { root.font-size-invalid = false; }
                    accepted(value) => { root.font-size-invalid = !root.apply-font-size(value); }
                    cancelled => {
                        root.font-size-draft = root.font-size-value;
                        root.font-size-invalid = false;
                    }
                }

                if !Theme.rtl : LoomIconButton {
                    text-scale: Theme.text-scale;
                    icon: "plus";
                    label: "Larger";
                    tooltip: "Increase font size";
                    clicked => { root.increase-font-size(); }
                }
                if Theme.rtl : LoomIconButton {
                    text-scale: Theme.text-scale;
                    icon: "minus";
                    label: "Smaller";
                    tooltip: "Decrease font size";
                    clicked => { root.decrease-font-size(); }
                }
            }

            // Character styles aligned flush with the inspector content edge.
            Rectangle {
                height: max(Theme.scaled-control-height, 28px * max(1.0, Theme.text-scale));
                background: Theme.palette().surface-sunken;
                border-radius: Theme.tokens.metrics.radius-medium;
                border-width: 1px;
                border-color: Theme.palette().border;
                if !Theme.rtl : HorizontalLayout {
                    padding: 0px;
                    spacing: Theme.tokens.space.xs;
                    alignment: start;
                    cross-axis-alignment: center;
                    height: parent.height;

                    LoomIconButton {
                        text-scale: Theme.text-scale;
                        icon: "bold";
                        label: "Bold";
                        tooltip: "Bold (" + root.shortcut-modifier + "+B)";
                        selected: root.is-bold;
                        clicked => { root.toggle-bold(); }
                    }
                    LoomIconButton {
                        text-scale: Theme.text-scale;
                        icon: "italic";
                        label: "Italic";
                        tooltip: "Italic (" + root.shortcut-modifier + "+I)";
                        selected: root.is-italic;
                        clicked => { root.toggle-italic(); }
                    }
                    LoomIconButton {
                        text-scale: Theme.text-scale;
                        icon: "underline";
                        label: "Underline";
                        tooltip: "Underline (" + root.shortcut-modifier + "+U)";
                        selected: root.is-underline;
                        clicked => { root.toggle-underline(); }
                    }
                    LoomIconButton {
                        text-scale: Theme.text-scale;
                        icon: "strikethrough";
                        label: "Strikethrough";
                        tooltip: "Strikethrough";
                        selected: root.is-strikethrough;
                        clicked => { root.toggle-strikethrough(); }
                    }
                }
                if Theme.rtl : HorizontalLayout {
                    padding: 0px;
                    spacing: Theme.tokens.space.xs;
                    alignment: end;
                    cross-axis-alignment: center;
                    height: parent.height;

                    LoomIconButton {
                        text-scale: Theme.text-scale;
                        icon: "strikethrough";
                        label: "Strikethrough";
                        tooltip: "Strikethrough";
                        selected: root.is-strikethrough;
                        clicked => { root.toggle-strikethrough(); }
                    }
                    LoomIconButton {
                        text-scale: Theme.text-scale;
                        icon: "underline";
                        label: "Underline";
                        tooltip: "Underline (" + root.shortcut-modifier + "+U)";
                        selected: root.is-underline;
                        clicked => { root.toggle-underline(); }
                    }
                    LoomIconButton {
                        text-scale: Theme.text-scale;
                        icon: "italic";
                        label: "Italic";
                        tooltip: "Italic (" + root.shortcut-modifier + "+I)";
                        selected: root.is-italic;
                        clicked => { root.toggle-italic(); }
                    }
                    LoomIconButton {
                        text-scale: Theme.text-scale;
                        icon: "bold";
                        label: "Bold";
                        tooltip: "Bold (" + root.shortcut-modifier + "+B)";
                        selected: root.is-bold;
                        clicked => { root.toggle-bold(); }
                    }
                }
            }

            // Unified 48-color well + inline collapsible palette.
            LoomColorWell {
                label: "Text Color";
                accessible-name: "Text Color";
                description: WriterFormatState.foreground-color-mixed
                    ? "Foreground color is mixed across the selection"
                    : WriterFormatState.foreground-color != ""
                        ? "Foreground color " + WriterFormatState.foreground-color
                        : "Foreground color Automatic";
                current-color: WriterFormatState.foreground-color-swatch;
                is-automatic: WriterFormatState.foreground-color-value == "" && !WriterFormatState.foreground-color-mixed;
                is-mixed: WriterFormatState.foreground-color-mixed;
                color-label: WriterFormatState.foreground-color-label;
                open: WriterFormatState.color-palette-open;
                enabled: WriterFormatState.color-formatting-available;
                toggled => {
                    if (!WriterFormatState.color-palette-open) {
                        WriterFormatState.color-input = WriterFormatState.foreground-color-value;
                        WriterFormatState.clear-foreground-color-error();
                    }
                    WriterFormatState.color-palette-open = !WriterFormatState.color-palette-open;
                }
            }

            if WriterFormatState.color-palette-open : LoomColorPalette {
                swatches: WriterFormatState.color-swatches;
                selected-hex: WriterFormatState.foreground-color-value;
                is-automatic: WriterFormatState.foreground-color-value == "" && !WriterFormatState.foreground-color-mixed;
                is-mixed: WriterFormatState.foreground-color-mixed;
                kind-label: "Text color";
                hex-input <=> WriterFormatState.color-input;
                hex-error: WriterFormatState.color-error;
                enabled: WriterFormatState.color-formatting-available;
                select-color(hex) => { WriterFormatState.select-foreground-color(hex); }
                select-automatic => { WriterFormatState.reset-foreground-color(); }
                hex-edited(_) => { WriterFormatState.clear-foreground-color-error(); }
                hex-submitted(hex) => {
                    WriterFormatState.color-input = hex;
                    WriterFormatState.apply-foreground-color();
                }
                close-requested => { WriterFormatState.cancel-foreground-color(); }
            }
        }

        InspectorDivider { }
        LoomSectionHeader { title: "Alignment & Spacing"; }

        // Alignment fills the row; the two indent buttons sit at the reading end.
        // One layout holds both, so the buttons can never be placed past the row.
        VerticalLayout {
            padding-left: Theme.tokens.space.xl;
            padding-right: Theme.tokens.space.xl;
            HorizontalLayout {
                spacing: Theme.tokens.space.sm;
                height: Theme.scaled-control-height;
                if !Theme.rtl : LoomSegmentedControl {
                    horizontal-stretch: 1;
                    items: WriterFormatState.justify-available
                        ? ["Left", "Center", "Right", "Justify"]
                        : ["Left", "Center", "Right"];
                    current <=> root.text-alignment;
                    label: "Text Alignment";
                    selected(idx) => { root.select-alignment(idx); }
                }
                indent-pair := HorizontalLayout {
                    spacing: Theme.tokens.space.xs;
                    if !Theme.rtl : LoomIconButton {
                        text-scale: Theme.text-scale;
                        icon: "outdent";
                        label: "Outdent";
                        tooltip: "Decrease Indent";
                        clicked => { root.outdent-text(); }
                    }
                    if !Theme.rtl : LoomIconButton {
                        text-scale: Theme.text-scale;
                        icon: "indent";
                        label: "Indent";
                        tooltip: "Increase Indent";
                        clicked => { root.indent-text(); }
                    }
                    if Theme.rtl : LoomIconButton {
                        text-scale: Theme.text-scale;
                        icon: "indent";
                        label: "Indent";
                        tooltip: "Increase Indent";
                        clicked => { root.indent-text(); }
                    }
                    if Theme.rtl : LoomIconButton {
                        text-scale: Theme.text-scale;
                        icon: "outdent";
                        label: "Outdent";
                        tooltip: "Decrease Indent";
                        clicked => { root.outdent-text(); }
                    }
                }
                if Theme.rtl : LoomSegmentedControl {
                    horizontal-stretch: 1;
                    items: WriterFormatState.justify-available
                        ? ["Left", "Center", "Right", "Justify"]
                        : ["Left", "Center", "Right"];
                    current <=> root.text-alignment;
                    label: "Text Alignment";
                    selected(idx) => { root.select-alignment(idx); }
                }
            }
        }

        // The caption sits at the reading-start edge, the choices fill the rest.
        VerticalLayout {
            padding-left: Theme.tokens.space.xl;
            padding-right: Theme.tokens.space.xl;
            padding-top: Theme.tokens.space.sm;
            spacing: Theme.tokens.space.xs;
        // Line spacing: the label sits above the strip, and the strip ends where the
        // alignment strip above ends, so the two rows share their far edge.
        Text {
            text: "Line Spacing";
            font-size: Theme.type.caption;
            font-weight: 500;
            color: Theme.palette().ink-secondary;
            horizontal-alignment: Theme.rtl ? right : left;
        }

        Rectangle {
            height: Theme.scaled-control-height;
            LoomSegmentedControl {
                x: 0px;
                y: 0px;
                width: parent.width;
                items: ["1.0", "1.15", "1.5", "2.0"];
                current <=> root.line-spacing-index;
                label: "Line Spacing";
                selected(idx) => { root.select-line-spacing(idx); }
            }
        }
        }

        InspectorDivider { }
        LoomSectionHeader { title: "Lists"; }

        VerticalLayout {
            padding-left: Theme.tokens.space.xl;
            padding-right: Theme.tokens.space.xl;
            spacing: Theme.tokens.space.xs;
        LoomSegmentedControl {
            items: ["None", "Bulleted", "Numbered"];
            current <=> root.list-style-index;
            label: "List Style";
            selected(idx) => { root.select-list-style(idx); }
        }
        if root.list-style-index == 1 : LoomSegmentedControl {
            items: ["•", "◦", "▪", "–"];
            current <=> WriterFormatState.list-marker-index;
            label: "Bullet Style";
            selected(idx) => { WriterFormatState.select-list-marker(idx); }
        }
        if root.list-style-index == 2 : LoomSegmentedControl {
            items: ["1.", "a.", "A.", "i.", "I."];
            current <=> WriterFormatState.list-marker-index;
            label: "Numbering Style";
            selected(idx) => { WriterFormatState.select-list-marker(idx); }
        }
        }

        InspectorDivider { }
        LoomButton {
            horizontal-stretch: 1;
            label: "Paragraph options";
            icon: root.paragraph-options-expanded ? "chevron-down" : "chevron-right";
            variant: "ghost";
            leading: true;
            selected: root.paragraph-options-expanded;
            accessible-expandable: true;
            accessible-expanded: root.paragraph-options-expanded;
            clicked => { root.paragraph-options-expanded = !root.paragraph-options-expanded; }
        }
        if root.paragraph-options-expanded : ParagraphOptionsSection { }

        LoomButton {
            horizontal-stretch: 1;
            label: "Baseline options";
            icon: root.baseline-options-expanded ? "chevron-down" : "chevron-right";
            variant: "ghost";
            leading: true;
            selected: root.baseline-options-expanded;
            accessible-expandable: true;
            accessible-expanded: root.baseline-options-expanded;
            clicked => { root.baseline-options-expanded = !root.baseline-options-expanded; }
        }
        if root.baseline-options-expanded : VerticalLayout {
            VerticalLayout {
                padding-left: Theme.tokens.space.lg;
                padding-right: Theme.tokens.space.lg;
                spacing: Theme.tokens.space.xs;
                if !Theme.rtl : HorizontalLayout {
                    spacing: Theme.tokens.space.xs;
                    LoomButton {
                        width: (parent.width - Theme.tokens.space.xs) / 2;
                        label: "Superscript";
                        selected: WriterFormatState.superscript-selected;
                        variant: WriterFormatState.superscript-selected ? "secondary" : "ghost";
                        enabled: WriterFormatState.inline-formatting-available;
                        accessible-checkable: true;
                        accessible-checked: WriterFormatState.superscript-selected;
                        accessible-description: WriterFormatState.superscript-mixed
                            ? "Superscript is mixed across the selection"
                            : "Toggle superscript";
                        clicked => { WriterFormatState.toggle-superscript(); }
                    }
                    LoomButton {
                        width: (parent.width - Theme.tokens.space.xs) / 2;
                        label: "Subscript";
                        selected: WriterFormatState.subscript-selected;
                        variant: WriterFormatState.subscript-selected ? "secondary" : "ghost";
                        enabled: WriterFormatState.inline-formatting-available;
                        accessible-checkable: true;
                        accessible-checked: WriterFormatState.subscript-selected;
                        accessible-description: WriterFormatState.subscript-mixed
                            ? "Subscript is mixed across the selection"
                            : "Toggle subscript";
                        clicked => { WriterFormatState.toggle-subscript(); }
                    }
                }
                if Theme.rtl : HorizontalLayout {
                    spacing: Theme.tokens.space.xs;
                    LoomButton {
                        width: (parent.width - Theme.tokens.space.xs) / 2;
                        label: "Subscript";
                        selected: WriterFormatState.subscript-selected;
                        variant: WriterFormatState.subscript-selected ? "secondary" : "ghost";
                        enabled: WriterFormatState.inline-formatting-available;
                        accessible-checkable: true;
                        accessible-checked: WriterFormatState.subscript-selected;
                        accessible-description: WriterFormatState.subscript-mixed
                            ? "Subscript is mixed across the selection"
                            : "Toggle subscript";
                        clicked => { WriterFormatState.toggle-subscript(); }
                    }
                    LoomButton {
                        width: (parent.width - Theme.tokens.space.xs) / 2;
                        label: "Superscript";
                        selected: WriterFormatState.superscript-selected;
                        variant: WriterFormatState.superscript-selected ? "secondary" : "ghost";
                        enabled: WriterFormatState.inline-formatting-available;
                        accessible-checkable: true;
                        accessible-checked: WriterFormatState.superscript-selected;
                        accessible-description: WriterFormatState.superscript-mixed
                            ? "Superscript is mixed across the selection"
                            : "Toggle superscript";
                        clicked => { WriterFormatState.toggle-superscript(); }
                    }
                }
            }
        }
        }
}
