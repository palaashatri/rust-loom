# Loom suite orchestration tasks.
# Invoke with `just <recipe>`, or run scripts/ directly (just is optional).

REPOS := "loom-core loom-writer loom-sheets loom-present"

default:
    @just --list

fmt:
    bash scripts/fmt-all.sh

clippy:
    bash scripts/clippy-all.sh

test:
    bash scripts/test-all.sh

build:
    bash scripts/build-all.sh --debug

release:
    bash scripts/build-all.sh

visual-qa:
    bash scripts/visual-qa-all.sh

offline-test:
    bash scripts/offline-test.sh

package:
    bash scripts/package.sh

verify-package:
    bash scripts/verify-package.sh
