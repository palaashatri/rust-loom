// Motion-specific workspace objects. Shared shell primitives remain in
// loom-ui; these components own the composition's stage, layer, timeline,
// inspector, and transport state wiring.
import {
    DirectionalLayout, ToolbarGroup, ToolbarSpacer, ToolbarIconButton,
    IconOnlyToolbarItem, IconOverLabelToolbarItem, Overflow, InspectorSurface, SidebarSurface,
    CanvasSurface, ToolkitStatusBar, PanelHeader
} from "../../../../loom-core/crates/loom-ui/ui/toolkit.slint";
import {
    IconButton, Slider, WorkspaceRow, MetricChip, CanvasBackdrop,
    TransportButton, EmptyState, PaneTabs
} from "../../../../loom-core/crates/loom-ui/ui/components.slint";
import { Icon } from "../../../../loom-core/crates/loom-ui/ui/icons.slint";
import { Theme } from "../../../../loom-core/crates/loom-ui/ui/theme.slint";

/// Motion's responsive context toolbar. State changes are emitted through the
/// existing callbacks, so toolbar controls remain real commands after the
/// shell is extracted from the Window.
export component MotionToolbarBody inherits DirectionalLayout {
    in property <bool> compact-layout: false;
    in property <bool> labeled: false;
    in property <bool> overflow: false;
    in-out property <bool> show-guides: true;
    in-out property <bool> show-safe-area: true;
    in property <bool> is-playing: false;
    in property <bool> is-looping: false;
    in-out property <float> zoom-value: 68.0;
    callback add-layer;
    callback play-pause;
    callback step-back;
    callback step-forward;
    callback toggle-loop;
    callback export-frame;
    callback overflow-requested;

    spacing: Theme.tokens.space.xs;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    if root.labeled : ToolbarGroup { labeled-slot: true;
        IconOverLabelToolbarItem { icon: "cursor"; label: "Transform"; checked: true; }
        IconOverLabelToolbarItem { icon: "plus"; label: "Layer"; clicked => { root.add-layer(); } }
        IconOverLabelToolbarItem { icon: "grid"; label: "Guides"; checked: root.show-guides; clicked => { root.show-guides = !root.show-guides; } }
        IconOverLabelToolbarItem { icon: "eye"; label: "Safe Area"; checked: root.show-safe-area; clicked => { root.show-safe-area = !root.show-safe-area; } }
    }

    if !root.labeled : ToolbarGroup { labeled-slot: false;
        IconOnlyToolbarItem { icon: "cursor"; label: "Transform"; checked: true; }
        IconOnlyToolbarItem { icon: "plus"; label: "Add layer"; clicked => { root.add-layer(); } }
        IconOnlyToolbarItem { icon: "grid"; label: "Toggle guides"; checked: root.show-guides; clicked => { root.show-guides = !root.show-guides; } }
        IconOnlyToolbarItem { icon: "eye"; label: "Toggle safe area"; checked: root.show-safe-area; clicked => { root.show-safe-area = !root.show-safe-area; } }
        if root.overflow : Overflow {
            label: "More Motion actions";
            clicked => { root.overflow-requested(); }
        }
    }

    if root.labeled || !root.overflow : ToolbarSpacer { }

    if root.labeled : ToolbarGroup { labeled-slot: true;
        IconOverLabelToolbarItem { icon: "chevron-left"; label: "Step Back"; clicked => { root.step-back(); } }
        IconOverLabelToolbarItem { icon: root.is-playing ? "pause" : "play"; label: root.is-playing ? "Pause" : "Play"; checked: root.is-playing; clicked => { root.play-pause(); } }
        IconOverLabelToolbarItem { icon: "chevron-right"; label: "Step Fwd"; clicked => { root.step-forward(); } }
        IconOverLabelToolbarItem { icon: "redo"; label: "Loop"; checked: root.is-looping; clicked => { root.toggle-loop(); } }
    }

    if !root.labeled && !root.overflow : ToolbarGroup { labeled-slot: false;
        IconOnlyToolbarItem { icon: "chevron-left"; label: "Step back"; clicked => { root.step-back(); } }
        IconOnlyToolbarItem { icon: root.is-playing ? "pause" : "play"; label: root.is-playing ? "Pause" : "Play"; checked: root.is-playing; clicked => { root.play-pause(); } }
        IconOnlyToolbarItem { icon: "chevron-right"; label: "Step forward"; clicked => { root.step-forward(); } }
        IconOnlyToolbarItem { icon: "redo"; label: "Toggle loop"; checked: root.is-looping; clicked => { root.toggle-loop(); } }
    }

    if !root.overflow : ToolbarSpacer { }

    if root.labeled : ToolbarGroup { labeled-slot: true;
        IconOverLabelToolbarItem { icon: "timeline"; label: "Curves unavailable"; enabled: false; checked: false; }
        IconOverLabelToolbarItem { icon: "export"; label: "Export SVG"; clicked => { root.export-frame(); } }
        IconOverLabelToolbarItem { icon: "zoom-in"; label: Math.round(root.zoom-value) + "%"; clicked => { root.zoom-value = root.zoom-value >= 150 ? 100 : root.zoom-value + 25; } }
    }

    if !root.labeled && !root.overflow : ToolbarGroup { labeled-slot: false;
        ToolbarIconButton { icon: "timeline"; label: "Curves unavailable"; enabled: false; checked: false; }
        ToolbarIconButton { icon: "export"; label: "Export SVG"; clicked => { root.export-frame(); } }
        ToolbarIconButton { icon: "zoom-in"; label: Math.round(root.zoom-value) + "%"; clicked => { root.zoom-value = root.zoom-value >= 150 ? 100 : root.zoom-value + 25; } }
    }
}

/// Layer list and add-layer affordance.
export component MotionLayersPanel inherits SidebarSurface {
    in property <[string]> layer-labels: [];
    in property <int> active-layer-index: 0;
    in property <length> panel-width: 246px;
    callback select-layer(int);
    callback add-layer;
    width: root.panel-width;
    title: "Layers";
    detail: root.layer-labels.length + " items";

    VerticalLayout {
        spacing: Theme.tokens.space.md;
        padding: Theme.tokens.space.lg;
        for label[idx] in root.layer-labels : WorkspaceRow {
            label: label;
            height: 50px;
            selected: idx == root.active-layer-index;
            clicked => { root.select-layer(idx); }
            HorizontalLayout {
                spacing: Theme.tokens.space.md;
                padding-left: Theme.tokens.space.md;
                padding-right: Theme.tokens.space.md;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: Theme.tokens.metrics.radius-large;
                    background: idx == root.active-layer-index ? Theme.palette().selection-soft : Theme.palette().surface-sunken;
                    border-width: 1px;
                    border-color: idx == root.active-layer-index ? Theme.palette().accent : Theme.palette().border;
                    Icon { icon: "layers"; size: 15px; tint: idx == root.active-layer-index ? Theme.palette().accent : Theme.palette().ink-secondary; }
                }
                VerticalLayout {
                    spacing: Theme.tokens.space.xs;
                    Text { text: label; font-size: Theme.tokens.typography.body; font-weight: idx == root.active-layer-index ? 650 : 500; color: Theme.palette().ink; overflow: elide; }
                    Text { text: idx == root.active-layer-index ? "Selected · Direct transform" : "Motion layer"; font-size: Theme.tokens.typography.caption; color: idx == root.active-layer-index ? Theme.palette().accent : Theme.palette().ink-disabled; overflow: elide; }
                }
            }
        }
        if root.layer-labels.length == 0 : EmptyState {
            icon: "layers";
            title: "No layers";
            description: "Add a text, image, or vector layer to start the composition.";
            action-text: "Add Layer";
            action => { root.add-layer(); }
        }
        Rectangle { vertical-stretch: 1; background: transparent; }
        IconButton { icon: "plus"; label: "Add Motion Layer"; clicked => { root.add-layer(); } }
    }
}

/// Live composition stage. Stage-shell sizing is layout-based; only the
/// selected object's transform and guides use content-relative coordinates.
export component MotionStage inherits CanvasBackdrop {
    in property <string> comp-name: "Untitled Composition";
    in property <[string]> layer-labels: [];
    in property <[string]> layer-types: [];
    in property <[float]> layer-pos-x: [];
    in property <[float]> layer-pos-y: [];
    in property <[float]> layer-scale: [];
    in property <[float]> layer-rotation: [];
    in property <[float]> layer-opacity: [];
    in property <[bool]> layer-visible: [];
    in property <int> active-layer-index: 0;
    in-out property <float> pos-x: 960.0;
    in-out property <float> pos-y: 540.0;
    in-out property <float> scale-val: 100.0;
    in-out property <float> rotation-val: 0.0;
    in-out property <float> opacity-val: 100.0;
    in property <bool> show-guides: true;
    in property <bool> show-safe-area: true;
    in property <bool> compact-layout: false;
    in property <bool> is-playing: false;
    callback transform-changed(string, float);
    callback transform-begin;
    callback transform-end;

    vertical-stretch: 1;
    stage-color: Theme.palette().media-stage;

    stage-shell := Rectangle {
        horizontal-stretch: 1;
        vertical-stretch: 1;
        max-width: 860px;
        max-height: 484px;
        border-radius: Theme.tokens.metrics.radius-large;
        background: Theme.palette().paper-ink;
        border-width: 1px;
        border-color: Theme.palette().border-strong;
        clip: true;

        stage := Rectangle {
            x: 18px;
            y: 18px;
            width: parent.width - 36px;
            height: parent.height - 36px;
            border-width: 1px;
            border-color: Theme.palette().grid-major;
            background: Theme.palette().media-stage;
            clip: true;

            if root.show-guides : Rectangle { x: parent.width / 2; width: 1px; height: parent.height; background: Theme.palette().grid-minor; }
            if root.show-guides : Rectangle { y: parent.height / 2; width: parent.width; height: 1px; background: Theme.palette().grid-minor; }
            if root.show-guides : Rectangle { x: parent.width / 3; width: 1px; height: parent.height; background: Theme.palette().grid-minor; }
            if root.show-guides : Rectangle { x: parent.width * 2 / 3; width: 1px; height: parent.height; background: Theme.palette().grid-minor; }
            if root.show-guides : Rectangle { y: parent.height / 3; width: parent.width; height: 1px; background: Theme.palette().grid-minor; }
            if root.show-guides : Rectangle { y: parent.height * 2 / 3; width: parent.width; height: 1px; background: Theme.palette().grid-minor; }

            if root.show-safe-area : Rectangle { x: parent.width * 0.05; y: parent.height * 0.05; width: parent.width * 0.90; height: parent.height * 0.90; border-width: 1px; border-color: Theme.palette().border-strong; background: transparent; }
            if root.show-safe-area : Rectangle { x: parent.width * 0.10; y: parent.height * 0.10; width: parent.width * 0.80; height: parent.height * 0.80; border-width: 1px; border-color: Theme.palette().grid-minor; background: transparent; }

            // Every layer is projected from the controller's sampled frame.
            // The active layer remains the dedicated transform target below.
            for layer_x[idx] in root.layer-pos-x : Rectangle {
                visible: root.layer-visible.length > idx && root.layer-visible[idx] && idx != root.active-layer-index;
                property <string> layer-type: root.layer-types.length > idx ? root.layer-types[idx] : "";
                property <float> layer-y: root.layer-pos-y.length > idx ? root.layer-pos-y[idx] : 0.0;
                property <float> layer-scale-value: root.layer-scale.length > idx ? root.layer-scale[idx] : 1.0;
                property <float> layer-rotation-value: root.layer-rotation.length > idx ? root.layer-rotation[idx] : 0.0;
                property <float> layer-opacity-value: root.layer-opacity.length > idx ? root.layer-opacity[idx] : 1.0;
                x: clamp(layer_x / 1920.0 * parent.width - self.width / 2, 0px, parent.width - self.width);
                y: clamp(self.layer-y / 1080.0 * parent.height - self.height / 2, 0px, parent.height - self.height);
                width: clamp(parent.width * 0.26 * self.layer-scale-value, 64px, parent.width * 0.56);
                height: clamp(parent.height * 0.18 * self.layer-scale-value, 44px, parent.height * 0.42);
                // The outer rectangle only owns sampled geometry and
                // visibility. Concrete content is projected below by layer
                // type instead of rendering every layer as the same card.
                background: transparent;
                opacity: self.layer-opacity-value;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
                transform-rotation: self.layer-rotation-value * 1deg;
                if self.layer-type == "Text" : Text {
                    width: parent.width - 16px;
                    x: 8px;
                    y: parent.height / 2 - 10px;
                    text: root.layer-labels.length > idx ? root.layer-labels[idx] : "Text layer";
                    color: Theme.palette().ink;
                    font-size: Theme.tokens.typography.body-large;
                    font-weight: 650;
                    horizontal-alignment: center;
                    overflow: elide;
                }
                if self.layer-type == "VectorShape" : Rectangle {
                    x: parent.width * 0.08;
                    y: parent.height * 0.12;
                    width: parent.width * 0.84;
                    height: parent.height * 0.76;
                    border-radius: Theme.tokens.metrics.radius-large;
                    border-width: 1px;
                    border-color: Theme.palette().accent;
                    background: Theme.palette().content-accent-soft;
                }
                if self.layer-type != "Text" && self.layer-type != "VectorShape" : Rectangle {
                    border-radius: Theme.tokens.metrics.radius-large;
                    border-width: 1px;
                    border-color: Theme.palette().border-strong;
                    background: Theme.palette().surface-raised;
                    Text {
                        width: parent.width - 16px;
                        x: 8px;
                        y: parent.height / 2 - 8px;
                        text: root.layer-labels.length > idx ? root.layer-labels[idx] : "Motion layer";
                        color: Theme.palette().ink-secondary;
                        font-size: Theme.tokens.typography.caption;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }
            }

            selected-object := Rectangle {
                property <string> selected-layer-type: root.layer-types.length > root.active-layer-index ? root.layer-types[root.active-layer-index] : "";
                visible: root.layer-labels.length == 0 || (root.layer-visible.length > root.active-layer-index && root.layer-visible[root.active-layer-index]);
                x: clamp(root.pos-x / 1920.0 * parent.width - self.width / 2, 0px, parent.width - self.width);
                y: clamp(root.pos-y / 1080.0 * parent.height - self.height / 2, 0px, parent.height - self.height);
                width: clamp(parent.width * 0.46 * root.scale-val / 100.0, 88px, parent.width * 0.78);
                height: clamp(parent.height * 0.28 * root.scale-val / 100.0, 58px, parent.height * 0.64);
                border-radius: Theme.tokens.metrics.radius-large;
                border-width: root.layer-labels.length > 0 ? 2px : 1px;
                border-color: drag.has-hover || transform-focus.has-focus ? Theme.palette().focus : root.layer-labels.length > 0 ? Theme.palette().accent : Theme.palette().border-strong;
                background: self.selected-layer-type == "Text" || self.selected-layer-type == "VectorShape" ? transparent : Theme.palette().content-accent-soft;
                opacity: root.opacity-val / 100.0;
                animate x, y, width, height { duration: drag.pressed || root.is-playing || Theme.tokens.reduced-motion ? 0ms : 190ms; easing: cubic-bezier(0.2, 0.9, 0.2, 1.0); }
                animate border-color { duration: Theme.tokens.reduced-motion ? 0ms : 120ms; }

                // Project the active layer using the same type-specific
                // content model as non-selected layers.  The outer rectangle
                // owns sampled geometry, opacity, and transform handles;
                // these children own the actual layer visual instead of a
                // composition-wide placeholder card.
                if self.selected-layer-type == "Text" : Text {
                    width: parent.width - 24px;
                    height: parent.height;
                    x: 12px;
                    y: 0px;
                    text: root.layer-labels.length > root.active-layer-index ? root.layer-labels[root.active-layer-index] : "Text layer";
                    color: Theme.active-theme == "high-contrast" ? Theme.palette().paper-ink : Theme.palette().ink;
                    font-size: Theme.tokens.typography.body-large;
                    font-weight: 650;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }

                if self.selected-layer-type == "VectorShape" : Rectangle {
                    x: parent.width * 0.08;
                    y: parent.height * 0.12;
                    width: parent.width * 0.84;
                    height: parent.height * 0.76;
                    border-radius: Theme.tokens.metrics.radius-large;
                    border-width: 1px;
                    border-color: Theme.palette().accent;
                    background: Theme.palette().content-accent-soft;
                }

                if self.selected-layer-type != "Text" && self.selected-layer-type != "VectorShape" : Rectangle {
                    border-radius: Theme.tokens.metrics.radius-large;
                    border-width: 1px;
                    border-color: Theme.palette().border-strong;
                    background: Theme.palette().surface-raised;
                    Text {
                        width: parent.width - 16px;
                        x: 8px;
                        y: parent.height / 2 - 8px;
                        text: root.layer-labels.length > root.active-layer-index ? root.layer-labels[root.active-layer-index] : "Add a layer to begin";
                        color: Theme.palette().ink-secondary;
                        font-size: Theme.tokens.typography.caption;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }

                if root.layer-labels.length > 0 : Rectangle { x: -5px; y: -5px; width: 10px; height: 10px; border-radius: 5px; background: Theme.palette().paper; border-width: 2px; border-color: Theme.palette().accent; }
                if root.layer-labels.length > 0 : Rectangle { x: parent.width - 5px; y: -5px; width: 10px; height: 10px; border-radius: 5px; background: Theme.palette().paper; border-width: 2px; border-color: Theme.palette().accent; }
                if root.layer-labels.length > 0 : Rectangle { x: -5px; y: parent.height - 5px; width: 10px; height: 10px; border-radius: 5px; background: Theme.palette().paper; border-width: 2px; border-color: Theme.palette().accent; }
                if root.layer-labels.length > 0 : Rectangle { x: parent.width - 5px; y: parent.height - 5px; width: 10px; height: 10px; border-radius: 5px; background: Theme.palette().paper; border-width: 2px; border-color: Theme.palette().accent; }

                transform-focus := FocusScope {
                    enabled: root.layer-labels.length > 0;
                    key-pressed(event) => {
                        if (event.text == Key.LeftArrow) { root.pos-x = max(0.0, root.pos-x - 1.0); root.transform-changed("pos-x", root.pos-x); return accept; }
                        if (event.text == Key.RightArrow) { root.pos-x = min(1920.0, root.pos-x + 1.0); root.transform-changed("pos-x", root.pos-x); return accept; }
                        if (event.text == Key.UpArrow) { root.pos-y = max(0.0, root.pos-y - 1.0); root.transform-changed("pos-y", root.pos-y); return accept; }
                        if (event.text == Key.DownArrow) { root.pos-y = min(1080.0, root.pos-y + 1.0); root.transform-changed("pos-y", root.pos-y); return accept; }
                        return reject;
                    }
                }

                drag := TouchArea {
                    enabled: root.layer-labels.length > 0;
                    mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                    property <float> start-pos-x: 0.0;
                    property <float> start-pos-y: 0.0;
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { self.start-pos-x = root.pos-x; self.start-pos-y = root.pos-y; transform-focus.focus(); root.transform-begin(); }
                        if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) { root.transform-end(); }
                    }
                    moved => {
                        if (self.pressed) {
                            root.pos-x = clamp(self.start-pos-x + (self.mouse-x - self.pressed-x) / stage.width * 1920.0, 0.0, 1920.0);
                            root.pos-y = clamp(self.start-pos-y + (self.mouse-y - self.pressed-y) / stage.height * 1080.0, 0.0, 1080.0);
                            root.transform-changed("pos-x", root.pos-x);
                            root.transform-changed("pos-y", root.pos-y);
                        }
                    }
                }
            }

            if drag.pressed : Rectangle { x: selected-object.x + selected-object.width / 2; width: 1px; height: parent.height; background: Theme.palette().focus; }
            if drag.pressed : Rectangle { y: selected-object.y + selected-object.height / 2; width: parent.width; height: 1px; background: Theme.palette().focus; }
            if drag.pressed : Rectangle {
                x: Theme.tokens.space.lg;
                y: Theme.tokens.space.lg;
                height: 26px;
                min-width: 178px;
                max-width: parent.width - Theme.tokens.space.xxl;
                border-radius: Theme.tokens.metrics.radius-medium;
                background: Theme.palette().overlay;
                border-width: 1px;
                border-color: Theme.palette().border;
                HorizontalLayout {
                    spacing: Theme.tokens.space.md;
                    padding-left: Theme.tokens.space.md;
                    padding-right: Theme.tokens.space.md;
                    Icon { icon: "cursor"; size: 13px; tint: Theme.palette().accent; }
                    Text { text: "Dragging layer · release to commit"; font-size: Theme.tokens.typography.caption; color: Theme.palette().ink-secondary; vertical-alignment: center; overflow: elide; }
                }
            }
        }
    }
}

/// Optional keyframe graph drawer.
export component MotionCurveDrawer inherits Rectangle {
    in property <bool> open: false;
    height: root.open ? 176px : 0px;
    clip: true;
    background: Theme.palette().panel;
    animate height { duration: Theme.tokens.reduced-motion ? 0ms : 190ms; easing: cubic-bezier(0.2, 0.9, 0.2, 1.0); }
    VerticalLayout {
        spacing: 0px;
        PanelHeader { title: "Keyframe Graph"; detail: "Selected property"; }
        Rectangle {
            vertical-stretch: 1;
            background: Theme.palette().canvas-alt;
            Rectangle { x: parent.width * 0.25; width: 1px; height: parent.height; background: Theme.palette().grid-minor; }
            Rectangle { x: parent.width * 0.50; width: 1px; height: parent.height; background: Theme.palette().grid-major; }
            Rectangle { x: parent.width * 0.75; width: 1px; height: parent.height; background: Theme.palette().grid-minor; }
            Rectangle { y: parent.height * 0.33; width: parent.width; height: 1px; background: Theme.palette().grid-minor; }
            Rectangle { y: parent.height * 0.66; width: parent.width; height: 1px; background: Theme.palette().grid-minor; }
            VerticalLayout {
                width: parent.width;
                height: parent.height;
                alignment: center;
                spacing: Theme.tokens.space.sm;
                Text { text: "No keyed property selected"; font-size: Theme.tokens.typography.body; font-weight: 650; color: Theme.palette().ink; horizontal-alignment: center; }
                Text { text: "Choose a keyed property to edit its interpolation curve."; font-size: Theme.tokens.typography.caption; color: Theme.palette().ink-secondary; horizontal-alignment: center; overflow: elide; }
            }
        }
    }
}

/// Transform/timing inspector with a 56px compact rail.
export component MotionInspector inherits InspectorSurface {
    in property <bool> expanded: true;
    in property <bool> compact-layout: false;
    in-out property <int> inspector-tab: 0;
    in property <string> layer-detail: "";
    in-out property <float> pos-x: 960.0;
    in-out property <float> pos-y: 540.0;
    in-out property <float> scale-val: 100.0;
    in-out property <float> rotation-val: 0.0;
    in-out property <float> opacity-val: 100.0;
    in property <string> timecode-display: "00:00:00:00";
    in property <string> timecode-text: "00:00:00:00 (60 fps)";
    in property <float> duration-secs: 10.0;
    in property <float> selected-keyframe-time: 0.0;
    in property <string> selected-keyframe-property: "";
    callback toggle-expanded;
    callback transform-changed(string, float);
    callback edit-keyframe-time(string, float);

    width: root.expanded ? (root.compact-layout ? 240px : 304px) : 56px;
    min-panel-width: root.expanded ? 240px : 56px;
    title: root.expanded ? "Inspector" : "";
    detail: root.layer-detail;
    animate width { duration: Theme.tokens.reduced-motion ? 0ms : 190ms; easing: cubic-bezier(0.2, 0.9, 0.2, 1.0); }

    if !root.expanded : VerticalLayout {
        spacing: Theme.tokens.space.md;
        padding-top: Theme.tokens.space.md;
        IconButton { icon: "chevron-left"; label: "Expand inspector"; clicked => { root.toggle-expanded(); } }
        Icon { icon: "settings"; size: 17px; tint: Theme.palette().ink-disabled; }
    }

    if root.expanded : VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 36px;
            HorizontalLayout {
                padding-left: Theme.tokens.space.md;
                padding-right: Theme.tokens.space.md;
                PaneTabs { items: ["Transform", "Timing"]; current <=> root.inspector-tab; horizontal-stretch: 1; }
                IconButton { icon: "chevron-right"; label: "Collapse inspector"; clicked => { root.toggle-expanded(); } }
            }
        }
        VerticalLayout {
            spacing: Theme.tokens.space.lg;
            padding: 0px;
            if root.inspector-tab == 0 : VerticalLayout {
                spacing: Theme.tokens.space.lg;
                Text { text: "POSITION"; font-size: Theme.tokens.typography.caption; font-weight: 700; color: Theme.palette().ink-secondary; }
                Text { text: "X   " + Math.round(root.pos-x) + " px"; font-size: Theme.tokens.typography.body; color: Theme.palette().ink; }
                Slider { label: "X position"; value: root.pos-x; minimum: 0.0; maximum: 1920.0; changed(val) => { root.pos-x = val; root.transform-changed("pos-x", val); } }
                Text { text: "Y   " + Math.round(root.pos-y) + " px"; font-size: Theme.tokens.typography.body; color: Theme.palette().ink; }
                Slider { label: "Y position"; value: root.pos-y; minimum: 0.0; maximum: 1080.0; changed(val) => { root.pos-y = val; root.transform-changed("pos-y", val); } }
                Rectangle { height: 1px; background: Theme.palette().border; }
                Text { text: "APPEARANCE"; font-size: Theme.tokens.typography.caption; font-weight: 700; color: Theme.palette().ink-secondary; }
                Text { text: "Scale   " + Math.round(root.scale-val) + "%"; font-size: Theme.tokens.typography.body; color: Theme.palette().ink; }
                Slider { label: "Scale"; value: root.scale-val; minimum: 10.0; maximum: 200.0; changed(val) => { root.scale-val = val; root.transform-changed("scale", val); } }
                Text { text: "Rotation   " + Math.round(root.rotation-val) + "°"; font-size: Theme.tokens.typography.body; color: Theme.palette().ink; }
                Slider { label: "Rotation"; value: root.rotation-val; minimum: -180.0; maximum: 180.0; changed(val) => { root.rotation-val = val; root.transform-changed("rotation", val); } }
                Text { text: "Opacity   " + Math.round(root.opacity-val) + "%"; font-size: Theme.tokens.typography.body; color: Theme.palette().ink; }
                Slider { label: "Opacity"; value: root.opacity-val; minimum: 0.0; maximum: 100.0; changed(val) => { root.opacity-val = val; root.transform-changed("opacity", val); } }
            }
            if root.inspector-tab == 1 : VerticalLayout {
                spacing: Theme.tokens.space.lg;
                Text { text: "COMPOSITION"; font-size: Theme.tokens.typography.caption; font-weight: 700; color: Theme.palette().ink-secondary; }
                MetricChip { label: "Time"; value: root.timecode-display; }
                MetricChip { label: "Rate"; value: root.timecode-text; }
                Rectangle { height: 1px; background: Theme.palette().border; }
                if root.selected-keyframe-property != "" : VerticalLayout {
                    spacing: Theme.tokens.space.sm;
                    Text { text: "KEYFRAME · " + root.selected-keyframe-property; font-size: Theme.tokens.typography.caption; font-weight: 700; color: Theme.palette().ink-secondary; }
                    Text { text: "Time   " + Math.round(root.selected-keyframe-time * 1000) / 1000 + "s"; font-size: Theme.tokens.typography.body; color: Theme.palette().ink; }
                    Slider {
                        label: "Keyframe time";
                        minimum: 0.0;
                        maximum: Math.max(0.001, root.duration-secs);
                        value: root.selected-keyframe-time;
                        changed(val) => { root.edit-keyframe-time(root.selected-keyframe-property, val); }
                    }
                    Text { text: "Drag the time slider or use Shift + Arrow in the timeline."; wrap: word-wrap; font-size: Theme.tokens.typography.caption; color: Theme.palette().ink-secondary; }
                }
                if root.selected-keyframe-property == "" : Text { text: "Select a keyframe marker to edit its timing."; wrap: word-wrap; font-size: Theme.tokens.typography.caption; color: Theme.palette().ink-secondary; }
            }
            Rectangle { vertical-stretch: 1; background: transparent; }
        }
    }
}

/// Motion timeline with a ruler and content-relative layer clips.
export component MotionTimeline inherits Rectangle {
    in property <[string]> layer-labels: [];
    in property <int> active-layer-index: 0;
    in property <length> layer-column-width: 246px;
    in property <string> timecode-display: "00:00:00:00";

    in property <float> duration-secs: 10.0;
    in property <float> current-time-secs: 0.0;
    in property <float> frame-rate: 60.0;
    in property <[float]> active-layer-keyframes: [];
    in property <[string]> active-keyframe-properties: [];
    in property <[float]> layer-start-secs: [];
    in property <[float]> layer-duration-secs: [];
    in property <float> selected-keyframe-time: 0.0;
    in property <string> selected-keyframe-property: "";

    callback select-layer(int);
    callback scrub-time(float);
    callback select-keyframe(float, string);
    callback edit-keyframe-time(string, float);

    height: 220px;
    background: Theme.palette().panel;

    timeline-focus := FocusScope {
        enabled: root.layer-labels.length > 0;
        key-pressed(event) => {
            let frame_step = 1.0 / Math.max(0.001, root.frame-rate);
            if (event.text == Key.LeftArrow) {
                if (event.modifiers.shift && root.selected-keyframe-property != "") {
                    root.edit-keyframe-time(root.selected-keyframe-property, max(0.0, root.selected-keyframe-time - frame_step));
                    return accept;
                }
                root.scrub-time(max(0.0, root.current-time-secs - frame_step));
                return accept;
            }
            if (event.text == Key.RightArrow) {
                if (event.modifiers.shift && root.selected-keyframe-property != "") {
                    root.edit-keyframe-time(root.selected-keyframe-property, min(root.duration-secs, root.selected-keyframe-time + frame_step));
                    return accept;
                }
                root.scrub-time(min(root.duration-secs, root.current-time-secs + frame_step));
                return accept;
            }
            return reject;
        }
    }

    VerticalLayout {
        spacing: 0px;
        PanelHeader { title: "Timeline"; detail: root.timecode-display; }
        Rectangle {
            height: 24px;
            background: Theme.palette().chrome;
            HorizontalLayout {
                spacing: 0px;
                Rectangle {
                    width: root.layer-column-width;
                    background: Theme.palette().surface-sunken;
                    Text { x: 12px; text: "LAYER"; font-size: Theme.tokens.typography.micro; font-weight: 700; color: Theme.palette().ink-disabled; vertical-alignment: center; }
                }
                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;
                    for i in 6 : Rectangle {
                        property <length> tick-width: parent.width / 5.0;
                        x: i == 5 ? parent.width - self.tick-width : parent.width * i / 5.0;
                        width: self.tick-width;
                        height: parent.height;
                        Text {
                            x: 2px;
                            width: parent.width - 4px;
                            text: Math.round(i / 5.0 * root.duration-secs * 10) / 10 + "s";
                            font-size: Theme.tokens.typography.micro;
                            color: Theme.palette().ink-disabled;
                            horizontal-alignment: i == 5 ? right : start;
                            vertical-alignment: center;
                        }
                        Rectangle { x: 0px; y: parent.height - 8px; width: 1px; height: 8px; background: Theme.palette().grid-major; }
                    }
                    TouchArea {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                timeline-focus.focus();
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                root.scrub-time(clamp(self.mouse-x / max(1px, self.width), 0.0, 1.0) * root.duration-secs);
                            }
                        }
                        clicked => {
                            root.scrub-time(clamp(self.mouse-x / max(1px, self.width), 0.0, 1.0) * root.duration-secs);
                        }
                    }
                }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            background: Theme.palette().canvas-alt;
            clip: true;
            VerticalLayout {
                spacing: Theme.tokens.space.xs;
                padding-top: Theme.tokens.space.sm;
                padding-bottom: Theme.tokens.space.sm;
                for label[idx] in root.layer-labels : WorkspaceRow {
                    label: label;
                    height: 44px;
                    selected: idx == root.active-layer-index;
                    clicked => { root.select-layer(idx); }
                    HorizontalLayout {
                        spacing: 0px;
                        Rectangle {
                            width: root.layer-column-width;
                            background: Theme.palette().panel;
                            HorizontalLayout {
                                spacing: Theme.tokens.space.md;
                                padding-left: Theme.tokens.space.lg;
                                padding-right: Theme.tokens.space.md;
                                Icon { icon: "layers"; size: 14px; tint: idx == root.active-layer-index ? Theme.palette().accent : Theme.palette().ink-secondary; }
                                Text { text: label; font-size: Theme.tokens.typography.body; color: Theme.palette().ink; overflow: elide; }
                            }
                        }
                        Rectangle {
                            horizontal-stretch: 1;
                            background: Theme.palette().canvas-alt;
                            Rectangle {
                                property <float> layer-start: root.layer-start-secs.length > idx ? root.layer-start-secs[idx] : 0.0;
                                property <float> layer-duration: root.layer-duration-secs.length > idx ? root.layer-duration-secs[idx] : root.duration-secs;
                                property <float> timeline-duration: Math.max(0.001, root.duration-secs);
                                x: clamp(self.layer-start / self.timeline-duration * parent.width, 0px, max(0px, parent.width - 1px));
                                y: 6px;
                                width: max(1px, min(self.layer-duration / self.timeline-duration * parent.width, max(1px, parent.width - self.x)));
                                height: parent.height - 12px;
                                border-radius: Theme.tokens.metrics.radius-medium;
                                background: idx == root.active-layer-index ? Theme.palette().selection-soft : Theme.palette().surface-raised;
                                border-width: 1px;
                                border-color: idx == root.active-layer-index ? Theme.palette().accent : Theme.palette().border;
                                Text { x: 22px; width: parent.width - 30px; text: label; font-size: Theme.tokens.typography.caption; color: Theme.palette().ink; vertical-alignment: center; overflow: elide; }
                                Rectangle { x: 9px; y: parent.height / 2 - 4px; width: 8px; height: 8px; border-radius: 2px; background: idx == root.active-layer-index ? Theme.palette().accent : Theme.palette().border-strong; }
                            }
                            if idx == root.active-layer-index : Rectangle {
                                width: parent.width;
                                height: parent.height;
                                for kf[idx] in root.active-layer-keyframes : Rectangle {
                                    property <string> keyframe-property: root.active-keyframe-properties.length > idx ? root.active-keyframe-properties[idx] : "";
                                    x: clamp((kf / Math.max(0.001, root.duration-secs)) * parent.width - 4px, 0px, max(0px, parent.width - 8px));
                                    y: parent.height / 2 - 4px;
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: root.selected-keyframe-property == self.keyframe-property && Math.abs(root.selected-keyframe-time - kf) < 0.0001 ? Theme.palette().paper : Theme.palette().accent;
                                    TouchArea {
                                        x: 0px;
                                        y: 0px;
                                        width: parent.width;
                                        height: parent.height;
                                        mouse-cursor: MouseCursor.grab;
                                        clicked => { timeline-focus.focus(); root.select-keyframe(kf, parent.keyframe-property); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle {
                x: clamp(root.layer-column-width + (root.current-time-secs / Math.max(0.001, root.duration-secs)) * (parent.width - root.layer-column-width), root.layer-column-width, parent.width - 2px);
                y: 0px; width: 2px; height: parent.height; background: Theme.palette().accent;
            }
            Rectangle {
                x: clamp(root.layer-column-width + (root.current-time-secs / Math.max(0.001, root.duration-secs)) * (parent.width - root.layer-column-width) - Theme.tokens.space.sm / 2, root.layer-column-width, parent.width - Theme.tokens.space.sm);
                y: 0px; width: Theme.tokens.space.md; height: Theme.tokens.space.md; border-radius: Theme.tokens.metrics.radius-small; background: Theme.palette().accent;
            }
        }
    }
}

export component MotionStatusBar inherits ToolkitStatusBar { }
