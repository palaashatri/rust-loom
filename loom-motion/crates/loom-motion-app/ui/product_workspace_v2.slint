import {
    AppHeader, WorkspaceToolbar, ToolButton, IconButton, StatusBar, Slider,
    SidebarSurface, InspectorSurface, WorkspaceRow, PaneTabs, MetricChip,
    CanvasBackdrop, TransportButton, EmptyState, PanelHeader, StatusPill
} from "components.slint";
import { Icon } from "icons.slint";
import { Theme } from "theme.slint";

export component MotionApp inherits Window {
    title: "Loom Motion";
    min-width: 920px;
    min-height: 720px;
    background: Theme.palette().canvas;
    property <bool> compact-layout: root.width < 1180px;
    property <length> layer-column-width: root.compact-layout ? 188px : 246px;

    in property <string> comp-name: "Untitled Composition";
    in property <string> timecode-text: "00:00:00:00 (60 fps)";
    in-out property <string> timecode-display: "00:00:00:00";
    in property <[string]> layer-labels: [];
    in property <int> active-layer-index: 0;
    in-out property <bool> is-playing: false;
    in-out property <bool> is-looping: false;
    in-out property <bool> curve-drawer-open: false;
    in-out property <int> inspector-tab: 0;
    in-out property <float> zoom-value: 68.0;

    in-out property <float> pos-x: 960.0;
    in-out property <float> pos-y: 540.0;
    in-out property <float> scale-val: 100.0;
    in-out property <float> rotation-val: 0.0;
    in-out property <float> opacity-val: 100.0;

    in property <string> status-left: "Ready";
    in property <string> status-right: "Offline";
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;

    property <bool> show-guides: true;
    property <bool> show-safe-area: true;
    property <bool> inspector-expanded: true;

    callback new-comp;
    callback open-comp;
    callback save-comp;
    callback undo;
    callback redo;
    callback export-frame;
    callback add-layer;
    callback play-pause;
    callback step-back;
    callback step-forward;
    callback toggle-loop;
    callback select-layer(int);
    callback transform-changed(string, float);
    callback toggle-curve-drawer;

    VerticalLayout {
        spacing: 0px;

        AppHeader {
            app-name: "Loom Motion";
            document-title: root.comp-name;
            icon: "layers";
            context: root.timecode-text;
            state-text: root.is-playing ? "Previewing" : "Local composition";
            state-tone: root.is-playing ? 1 : 0;
        }

        WorkspaceToolbar {
            ToolButton { icon: "new"; text: "New"; clicked => { root.new-comp(); } }
            ToolButton { icon: "open"; text: "Open"; clicked => { root.open-comp(); } }
            ToolButton { icon: "save"; text: "Save"; clicked => { root.save-comp(); } }
            IconButton { icon: "undo"; label: "Undo"; enabled: root.can-undo; clicked => { root.undo(); } }
            IconButton { icon: "redo"; label: "Redo"; enabled: root.can-redo; clicked => { root.redo(); } }
            Rectangle { width: 1px; height: 20px; background: Theme.palette().border; }
            ToolButton { icon: "cursor"; text: "Transform"; checked: true; }
            ToolButton { icon: "plus"; text: "Layer"; clicked => { root.add-layer(); } }
            ToolButton {
                icon: "grid";
                text: "Guides";
                checked: root.show-guides;
                clicked => { root.show-guides = !root.show-guides; }
            }
            ToolButton {
                icon: "eye";
                text: "Safe Area";
                checked: root.show-safe-area;
                clicked => { root.show-safe-area = !root.show-safe-area; }
            }
            ToolButton { icon: "export"; text: "Export Frame"; clicked => { root.export-frame(); } }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            TransportButton { icon: "chevron-left"; label: "Step backward one frame"; clicked => { root.step-back(); } }
            TransportButton {
                icon: root.is-playing ? "pause" : "play";
                label: root.is-playing ? "Pause preview" : "Play preview";
                active: root.is-playing;
                clicked => {
                    root.is-playing = !root.is-playing;
                    root.play-pause();
                }
            }
            TransportButton { icon: "chevron-right"; label: "Step forward one frame"; clicked => { root.step-forward(); } }
            TransportButton {
                icon: "redo";
                label: "Loop preview";
                active: root.is-looping;
                clicked => {
                    root.is-looping = !root.is-looping;
                    root.toggle-loop();
                }
            }
            MetricChip { label: "TC"; value: root.timecode-display; }
            MetricChip { label: "Zoom"; value: Math.round(root.zoom-value) + "%"; }
            ToolButton {
                icon: "timeline";
                text: "Curves";
                checked: root.curve-drawer-open;
                clicked => {
                    root.curve-drawer-open = !root.curve-drawer-open;
                    root.toggle-curve-drawer();
                }
            }
        }

        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            SidebarSurface {
                width: root.layer-column-width;
                title: "Layers";
                detail: root.layer-labels.length + " items";

                VerticalLayout {
                    spacing: 7px;
                    padding: 10px;

                    for label[idx] in root.layer-labels : WorkspaceRow {
                        label: label;
                        height: 50px;
                        selected: idx == root.active-layer-index;
                        clicked => { root.select-layer(idx); }

                        HorizontalLayout {
                            spacing: 9px;
                            padding-left: 9px;
                            padding-right: 9px;
                            Rectangle {
                                width: 32px;
                                height: 32px;
                                border-radius: 9px;
                                background: idx == root.active-layer-index ? Theme.palette().selection-soft : Theme.palette().surface-sunken;
                                border-width: 1px;
                                border-color: idx == root.active-layer-index ? Theme.palette().accent : Theme.palette().border;
                                Icon {
                                    icon: "layers";
                                    size: 15px;
                                    tint: idx == root.active-layer-index ? Theme.palette().accent : Theme.palette().ink-secondary;
                                }
                            }
                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: label;
                                    font-size: Theme.tokens.typography.body;
                                    font-weight: idx == root.active-layer-index ? 650 : 500;
                                    color: Theme.palette().ink;
                                    overflow: elide;
                                }
                                Text {
                                    text: idx == root.active-layer-index ? "Selected · Direct transform" : "Motion layer";
                                    font-size: Theme.tokens.typography.caption;
                                    color: idx == root.active-layer-index ? Theme.palette().accent : Theme.palette().ink-disabled;
                                }
                            }
                        }
                    }

                    if root.layer-labels.length == 0 : EmptyState {
                        icon: "layers";
                        title: "No layers";
                        description: "Add a text, image, or vector layer to start the composition.";
                        action-text: "Add Layer";
                        action => { root.add-layer(); }
                    }

                    Rectangle { vertical-stretch: 1; background: transparent; }
                    ToolButton { icon: "plus"; text: "Add Motion Layer"; clicked => { root.add-layer(); } }
                }
            }

            Rectangle { width: 1px; background: Theme.palette().border; }

            VerticalLayout {
                spacing: 0px;
                horizontal-stretch: 1;

                CanvasBackdrop {
                    vertical-stretch: 1;
                    stage-color: Theme.palette().media-stage;

                    stage-shell := Rectangle {
                        width: min(860px, parent.width - (root.compact-layout ? 28px : 70px));
                        height: min(484px, parent.height - (root.compact-layout ? 34px : 74px));
                        border-radius: 9px;
                        background: Theme.palette().paper-ink;
                        border-width: 1px;
                        border-color: Theme.palette().border-strong;
                        clip: true;

                        stage := Rectangle {
                            x: 18px;
                            y: 18px;
                            width: parent.width - 36px;
                            height: parent.height - 36px;
                            border-width: 1px;
                            border-color: Theme.palette().grid-major;
                            background: Theme.palette().media-stage;
                            clip: true;

                            if root.show-guides : Rectangle { x: parent.width / 2; width: 1px; height: parent.height; background: Theme.palette().grid-minor; }
                            if root.show-guides : Rectangle { y: parent.height / 2; width: parent.width; height: 1px; background: Theme.palette().grid-minor; }
                            if root.show-guides : Rectangle { x: parent.width / 3; width: 1px; height: parent.height; background: Theme.palette().grid-minor; }
                            if root.show-guides : Rectangle { x: parent.width * 2 / 3; width: 1px; height: parent.height; background: Theme.palette().grid-minor; }
                            if root.show-guides : Rectangle { y: parent.height / 3; width: parent.width; height: 1px; background: Theme.palette().grid-minor; }
                            if root.show-guides : Rectangle { y: parent.height * 2 / 3; width: parent.width; height: 1px; background: Theme.palette().grid-minor; }

                            if root.show-safe-area : Rectangle {
                                x: parent.width * 0.05;
                                y: parent.height * 0.05;
                                width: parent.width * 0.90;
                                height: parent.height * 0.90;
                                border-width: 1px;
                                border-color: Theme.palette().border-strong;
                                background: transparent;
                            }
                            if root.show-safe-area : Rectangle {
                                x: parent.width * 0.10;
                                y: parent.height * 0.10;
                                width: parent.width * 0.80;
                                height: parent.height * 0.80;
                                border-width: 1px;
                                border-color: Theme.palette().grid-minor;
                                background: transparent;
                            }

                            selected-object := Rectangle {
                                x: clamp(root.pos-x / 1920.0 * parent.width - self.width / 2, 0px, parent.width - self.width);
                                y: clamp(root.pos-y / 1080.0 * parent.height - self.height / 2, 0px, parent.height - self.height);
                                width: clamp(parent.width * 0.46 * root.scale-val / 100.0, 88px, parent.width * 0.78);
                                height: clamp(parent.height * 0.28 * root.scale-val / 100.0, 58px, parent.height * 0.64);
                                border-radius: 11px;
                                border-width: root.layer-labels.length > 0 ? 2px : 1px;
                                border-color: drag.has-hover || transform-focus.has-focus ? Theme.palette().focus : root.layer-labels.length > 0 ? Theme.palette().accent : Theme.palette().border-strong;
                                background: Theme.palette().content-accent-soft;
                                opacity: root.opacity-val / 100.0;

                                animate x, y, width, height {
                                    duration: drag.pressed || Theme.tokens.reduced-motion ? 0ms : 190ms;
                                    easing: cubic-bezier(0.2, 0.9, 0.2, 1.0);
                                }
                                animate border-color { duration: Theme.tokens.reduced-motion ? 0ms : 120ms; }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 8px;
                                    padding: 18px;
                                    Text {
                                        text: root.comp-name;
                                        color: Theme.palette().paper-ink;
                                        font-size: Theme.tokens.typography.heading;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: root.layer-labels.length > 0 ? root.layer-labels[root.active-layer-index] : "Add a layer to begin";
                                        color: Theme.palette().content-accent;
                                        font-size: Theme.tokens.typography.body-large;
                                        font-weight: 650;
                                        horizontal-alignment: center;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: "X " + Math.round(root.pos-x) + "   Y " + Math.round(root.pos-y)
                                            + "   ·   " + Math.round(root.scale-val) + "%"
                                            + "   ·   " + Math.round(root.rotation-val) + "°";
                                        color: Theme.palette().paper-muted;
                                        font-size: Theme.tokens.typography.caption;
                                        horizontal-alignment: center;
                                    }
                                }

                                if root.layer-labels.length > 0 : Rectangle { x: -5px; y: -5px; width: 10px; height: 10px; border-radius: 5px; background: Theme.palette().paper; border-width: 2px; border-color: Theme.palette().accent; }
                                if root.layer-labels.length > 0 : Rectangle { x: parent.width - 5px; y: -5px; width: 10px; height: 10px; border-radius: 5px; background: Theme.palette().paper; border-width: 2px; border-color: Theme.palette().accent; }
                                if root.layer-labels.length > 0 : Rectangle { x: -5px; y: parent.height - 5px; width: 10px; height: 10px; border-radius: 5px; background: Theme.palette().paper; border-width: 2px; border-color: Theme.palette().accent; }
                                if root.layer-labels.length > 0 : Rectangle { x: parent.width - 5px; y: parent.height - 5px; width: 10px; height: 10px; border-radius: 5px; background: Theme.palette().paper; border-width: 2px; border-color: Theme.palette().accent; }

                                transform-focus := FocusScope {
                                    enabled: root.layer-labels.length > 0;
                                    key-pressed(event) => {
                                        if (event.text == Key.LeftArrow) {
                                            root.pos-x = max(0.0, root.pos-x - 1.0);
                                            root.transform-changed("pos-x", root.pos-x);
                                            return accept;
                                        }
                                        if (event.text == Key.RightArrow) {
                                            root.pos-x = min(1920.0, root.pos-x + 1.0);
                                            root.transform-changed("pos-x", root.pos-x);
                                            return accept;
                                        }
                                        if (event.text == Key.UpArrow) {
                                            root.pos-y = max(0.0, root.pos-y - 1.0);
                                            root.transform-changed("pos-y", root.pos-y);
                                            return accept;
                                        }
                                        if (event.text == Key.DownArrow) {
                                            root.pos-y = min(1080.0, root.pos-y + 1.0);
                                            root.transform-changed("pos-y", root.pos-y);
                                            return accept;
                                        }
                                        return reject;
                                    }
                                }

                                drag := TouchArea {
                                    enabled: root.layer-labels.length > 0;
                                    mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                                    property <float> start-pos-x: 0.0;
                                    property <float> start-pos-y: 0.0;
                                    pointer-event(event) => {
                                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                            self.start-pos-x = root.pos-x;
                                            self.start-pos-y = root.pos-y;
                                            transform-focus.focus();
                                        }
                                    }
                                    moved => {
                                        if (self.pressed) {
                                            root.pos-x = clamp(self.start-pos-x + (self.mouse-x - self.pressed-x) / stage.width * 1920.0, 0.0, 1920.0);
                                            root.pos-y = clamp(self.start-pos-y + (self.mouse-y - self.pressed-y) / stage.height * 1080.0, 0.0, 1080.0);
                                            root.transform-changed("pos-x", root.pos-x);
                                            root.transform-changed("pos-y", root.pos-y);
                                        }
                                    }
                                }
                            }

                            if drag.pressed : Rectangle { x: selected-object.x + selected-object.width / 2; width: 1px; height: parent.height; background: Theme.palette().focus; }
                            if drag.pressed : Rectangle { y: selected-object.y + selected-object.height / 2; width: parent.width; height: 1px; background: Theme.palette().focus; }

                            Rectangle {
                                x: 12px;
                                y: 12px;
                                height: 26px;
                                min-width: 178px;
                                border-radius: 8px;
                                background: Theme.palette().overlay;
                                border-width: 1px;
                                border-color: Theme.palette().border;
                                HorizontalLayout {
                                    spacing: 7px;
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Icon { icon: "cursor"; size: 13px; tint: Theme.palette().accent; }
                                    Text {
                                        text: drag.pressed ? "Dragging layer · release to commit" : "Drag layer · arrows nudge 1 px";
                                        font-size: Theme.tokens.typography.caption;
                                        color: Theme.palette().ink-secondary;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        x: 28px;
                        y: parent.height - 58px;
                        width: 260px;
                        height: 36px;
                        border-radius: 10px;
                        background: Theme.palette().overlay;
                        border-width: 1px;
                        border-color: Theme.palette().border;
                        HorizontalLayout {
                            spacing: 8px;
                            padding-left: 9px;
                            padding-right: 9px;
                            IconButton { icon: "minus"; label: "Zoom out"; clicked => { root.zoom-value = Math.max(10, root.zoom-value - 10); } }
                            Slider { label: "Zoom"; minimum: 10; maximum: 200; value <=> root.zoom-value; horizontal-stretch: 1; }
                            IconButton { icon: "plus"; label: "Zoom in"; clicked => { root.zoom-value = Math.min(200, root.zoom-value + 10); } }
                        }
                    }

                    Rectangle {
                        x: parent.width - 190px;
                        y: 28px;
                        width: 162px;
                        height: 34px;
                        border-radius: 9px;
                        background: Theme.palette().overlay;
                        border-width: 1px;
                        border-color: Theme.palette().border;
                        HorizontalLayout {
                            spacing: 7px;
                            padding-left: 9px;
                            padding-right: 9px;
                            StatusPill { text: root.is-playing ? "PLAY" : "PAUSED"; tone: root.is-playing ? 1 : 0; }
                            Text { text: root.timecode-display; font-size: Theme.tokens.typography.caption; font-weight: 650; color: Theme.palette().ink; }
                        }
                    }
                }

                Rectangle {
                    height: root.curve-drawer-open ? 176px : 0px;
                    clip: true;
                    background: Theme.palette().panel;
                    animate height {
                        duration: Theme.tokens.reduced-motion ? 0ms : 190ms;
                        easing: cubic-bezier(0.2, 0.9, 0.2, 1.0);
                    }
                    VerticalLayout {
                        spacing: 0px;
                        PanelHeader { title: "Keyframe Graph"; detail: "Selected property"; }
                        Rectangle {
                            vertical-stretch: 1;
                            background: Theme.palette().canvas-alt;
                            Rectangle { x: parent.width * 0.25; width: 1px; height: parent.height; background: Theme.palette().grid-minor; }
                            Rectangle { x: parent.width * 0.50; width: 1px; height: parent.height; background: Theme.palette().grid-major; }
                            Rectangle { x: parent.width * 0.75; width: 1px; height: parent.height; background: Theme.palette().grid-minor; }
                            Rectangle { y: parent.height * 0.33; width: parent.width; height: 1px; background: Theme.palette().grid-minor; }
                            Rectangle { y: parent.height * 0.66; width: parent.width; height: 1px; background: Theme.palette().grid-minor; }
                            VerticalLayout {
                                alignment: center;
                                spacing: 5px;
                                Text { text: "No keyed property selected"; font-size: Theme.tokens.typography.body; font-weight: 650; color: Theme.palette().ink; horizontal-alignment: center; }
                                Text { text: "Choose a keyed property to edit its interpolation curve."; font-size: Theme.tokens.typography.caption; color: Theme.palette().ink-secondary; horizontal-alignment: center; }
                            }
                        }
                    }
                }
            }

            Rectangle { width: 1px; background: Theme.palette().border; }

            InspectorSurface {
                width: root.inspector-expanded ? (root.compact-layout ? 236px : 304px) : 50px;
                title: root.inspector-expanded ? "Inspector" : "";
                detail: root.inspector-expanded && root.layer-labels.length > 0 ? "Layer " + (root.active-layer-index + 1) : "";
                animate width {
                    duration: Theme.tokens.reduced-motion ? 0ms : 190ms;
                    easing: cubic-bezier(0.2, 0.9, 0.2, 1.0);
                }

                if !root.inspector-expanded : VerticalLayout {
                    spacing: 10px;
                    padding-top: 10px;
                    IconButton { icon: "chevron-left"; label: "Expand inspector"; clicked => { root.inspector-expanded = true; } }
                    Icon { icon: "settings"; size: 17px; tint: Theme.palette().ink-disabled; }
                }

                if root.inspector-expanded : VerticalLayout {
                    spacing: 0px;
                    Rectangle {
                        height: 36px;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            PaneTabs { items: ["Transform", "Timing"]; current <=> root.inspector-tab; horizontal-stretch: 1; }
                            IconButton { icon: "chevron-right"; label: "Collapse inspector"; clicked => { root.inspector-expanded = false; } }
                        }
                    }
                    VerticalLayout {
                        spacing: 12px;
                        padding: 14px;
                        if root.inspector-tab == 0 : VerticalLayout {
                            spacing: 12px;
                            Text { text: "POSITION"; font-size: Theme.tokens.typography.caption; font-weight: 700; color: Theme.palette().ink-secondary; }
                            Text { text: "X   " + Math.round(root.pos-x) + " px"; font-size: Theme.tokens.typography.body; color: Theme.palette().ink; }
                            Slider { label: "X position"; value: root.pos-x; minimum: 0.0; maximum: 1920.0; changed(val) => { root.pos-x = val; root.transform-changed("pos-x", val); } }
                            Text { text: "Y   " + Math.round(root.pos-y) + " px"; font-size: Theme.tokens.typography.body; color: Theme.palette().ink; }
                            Slider { label: "Y position"; value: root.pos-y; minimum: 0.0; maximum: 1080.0; changed(val) => { root.pos-y = val; root.transform-changed("pos-y", val); } }
                            Rectangle { height: 1px; background: Theme.palette().border; }
                            Text { text: "APPEARANCE"; font-size: Theme.tokens.typography.caption; font-weight: 700; color: Theme.palette().ink-secondary; }
                            Text { text: "Scale   " + Math.round(root.scale-val) + "%"; font-size: Theme.tokens.typography.body; color: Theme.palette().ink; }
                            Slider { label: "Scale"; value: root.scale-val; minimum: 10.0; maximum: 200.0; changed(val) => { root.scale-val = val; root.transform-changed("scale", val); } }
                            Text { text: "Rotation   " + Math.round(root.rotation-val) + "°"; font-size: Theme.tokens.typography.body; color: Theme.palette().ink; }
                            Slider { label: "Rotation"; value: root.rotation-val; minimum: -180.0; maximum: 180.0; changed(val) => { root.rotation-val = val; root.transform-changed("rotation", val); } }
                            Text { text: "Opacity   " + Math.round(root.opacity-val) + "%"; font-size: Theme.tokens.typography.body; color: Theme.palette().ink; }
                            Slider { label: "Opacity"; value: root.opacity-val; minimum: 0.0; maximum: 100.0; changed(val) => { root.opacity-val = val; root.transform-changed("opacity", val); } }
                        }
                        if root.inspector-tab == 1 : VerticalLayout {
                            spacing: 12px;
                            Text { text: "COMPOSITION"; font-size: Theme.tokens.typography.caption; font-weight: 700; color: Theme.palette().ink-secondary; }
                            MetricChip { label: "Time"; value: root.timecode-display; }
                            MetricChip { label: "Rate"; value: root.timecode-text; }
                            Rectangle { height: 1px; background: Theme.palette().border; }
                            Text {
                                text: "The property graph remains empty until keyed data is selected. Loom does not synthesize curves.";
                                wrap: word-wrap;
                                font-size: Theme.tokens.typography.caption;
                                color: Theme.palette().ink-secondary;
                            }
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }
                }
            }
        }

        Rectangle {
            height: root.compact-layout ? 158px : 182px;
            background: Theme.palette().panel;
            VerticalLayout {
                spacing: 0px;
                PanelHeader { title: "Timeline"; detail: root.timecode-display; }
                Rectangle {
                    height: 26px;
                    background: Theme.palette().chrome;
                    HorizontalLayout {
                        spacing: 0px;
                        Rectangle {
                            width: root.layer-column-width;
                            background: Theme.palette().surface-sunken;
                            Text { x: 12px; text: "LAYER"; font-size: Theme.tokens.typography.micro; font-weight: 700; color: Theme.palette().ink-disabled; vertical-alignment: center; }
                        }
                        for marker in ["0s", "2s", "4s", "6s", "8s", "10s"] : Rectangle {
                            horizontal-stretch: 1;
                            Text { text: marker; font-size: Theme.tokens.typography.micro; color: Theme.palette().ink-disabled; horizontal-alignment: start; vertical-alignment: center; }
                            Rectangle { x: 0px; y: parent.height - 8px; width: 1px; height: 8px; background: Theme.palette().grid-major; }
                        }
                    }
                }
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.palette().canvas-alt;
                    clip: true;
                    VerticalLayout {
                        spacing: 3px;
                        padding-top: 5px;
                        padding-bottom: 5px;
                        for label[idx] in root.layer-labels : WorkspaceRow {
                            label: label;
                            height: 42px;
                            selected: idx == root.active-layer-index;
                            clicked => { root.select-layer(idx); }
                            HorizontalLayout {
                                spacing: 0px;
                                Rectangle {
                                    width: root.layer-column-width;
                                    background: Theme.palette().panel;
                                    HorizontalLayout {
                                        spacing: 7px;
                                        padding-left: 11px;
                                        padding-right: 9px;
                                        Icon { icon: "layers"; size: 14px; tint: idx == root.active-layer-index ? Theme.palette().accent : Theme.palette().ink-secondary; }
                                        Text { text: label; font-size: Theme.tokens.typography.body; color: Theme.palette().ink; overflow: elide; }
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: Theme.palette().canvas-alt;
                                    Rectangle {
                                        x: 10px + idx * 14px;
                                        y: 6px;
                                        width: max(120px, parent.width * 0.62 - idx * 18px);
                                        height: parent.height - 12px;
                                        border-radius: 7px;
                                        background: idx == root.active-layer-index ? Theme.palette().selection-soft : Theme.palette().surface-raised;
                                        border-width: 1px;
                                        border-color: idx == root.active-layer-index ? Theme.palette().accent : Theme.palette().border;
                                        Text { x: 22px; width: parent.width - 30px; text: label; font-size: Theme.tokens.typography.caption; color: Theme.palette().ink; vertical-alignment: center; overflow: elide; }
                                        Rectangle { x: 9px; y: parent.height / 2 - 4px; width: 8px; height: 8px; border-radius: 2px; background: idx == root.active-layer-index ? Theme.palette().accent : Theme.palette().border-strong; }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle { x: root.layer-column-width; y: 0px; width: 1px; height: parent.height; background: Theme.palette().accent; }
                    Rectangle { x: root.layer-column-width - 4px; y: 0px; width: 9px; height: 9px; border-radius: 3px; background: Theme.palette().accent; }
                }
            }
        }

        StatusBar { status-left: root.status-left; status-right: root.status-right; }
    }
}
