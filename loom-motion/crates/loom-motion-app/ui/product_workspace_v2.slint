import {
    DocumentChrome, DirectionalLayout
} from "toolkit.slint";
import { CommandPalette, CommandPaletteItem } from "../../../../loom-core/crates/loom-ui/ui/components.slint";
import {
    MotionToolbar, MotionLayersPanel, MotionStage, MotionCurveDrawer,
    MotionInspector, MotionTimeline, MotionStatusBar
} from "components.slint";
import { Theme, ResponsivePolicy } from "theme.slint";

export component MotionApp inherits Window {
    title: "Loom Motion";
    min-width: 920px;
    min-height: 720px;
    background: Theme.palette().canvas;
    in property <bool> rtl: false;
    changed rtl => { Theme.rtl = root.rtl; }
    in property <bool> compact-layout: false;
    callback window-resized(length);
    changed width => { root.window-resized(root.width); }
    // Timeline and panel contracts keep the layer header readable even in the
    // compact composition. The 200px floor also matches the sidebar minimum.
    property <length> layer-column-width: root.compact-layout ? 200px : 246px;

    in property <string> comp-name: "Untitled Composition";
    in property <string> timecode-text: "00:00:00:00 (60 fps)";
    in-out property <string> timecode-display: "00:00:00:00";
    in property <[string]> layer-labels: [];
    in property <int> active-layer-index: 0;
    in-out property <bool> is-playing: false;
    in-out property <bool> is-looping: false;
    in-out property <bool> curve-drawer-open: false;
    in-out property <int> inspector-tab: 0;
    in-out property <float> zoom-value: 68.0;

    in-out property <float> pos-x: 960.0;
    in-out property <float> pos-y: 540.0;
    in-out property <float> scale-val: 100.0;
    in-out property <float> rotation-val: 0.0;
    in-out property <float> opacity-val: 100.0;

    in property <string> status-left: "Ready";
    in property <string> status-right: "Offline";
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;

    in-out property <bool> show-guides: true;
    in-out property <bool> show-safe-area: true;
    // Keep the inspector as a compact rail when the host selects the compact
    // layout; users can still expand it with the rail button. At reference
    // widths the inspector starts expanded as before.
    property <bool> inspector-expanded: !root.compact-layout;

    callback new-comp;
    callback open-comp;
    callback save-comp;
    callback save-as-comp;
    callback undo;
    callback redo;
    callback export-frame;
    callback add-layer;
    callback play-pause;
    callback step-back;
    callback step-forward;
    callback toggle-loop;
    callback select-layer(int);
    callback transform-changed(string, float);
    callback toggle-curve-drawer;

    in-out property <[CommandPaletteItem]> palette-commands: [];
    in-out property <bool> palette-open: false;
    in-out property <string> palette-query: "";
    in-out property <int> palette-selected: 0;
    callback palette-invoked(int);
    callback palette-query-changed(string);
    callback palette-move(int);
    callback palette-key-text(string);
    callback palette-backspace;
    callback palette-close;

    public function open-palette() {
        root.palette-open = true;
        root.palette-query = "";
        palette.grab-focus();
    }

    app-focus := FocusScope {
        key-pressed(event) => {
            if (root.palette-open) { return reject; }
            if (event.modifiers.control || event.modifiers.meta) {
                if (event.text == Key.K || event.text == "k") {
                    root.open-palette();
                    return accept;
                }
                if (event.text == "n" || event.text == "N") {
                    root.new-comp();
                    return accept;
                }
                if (event.text == "o" || event.text == "O") {
                    root.open-comp();
                    return accept;
                }
                if (event.text == "s" || event.text == "S") {
                    if (event.modifiers.shift) { root.save-as-comp(); } else { root.save-comp(); }
                    return accept;
                }
                if (event.text == "e" || event.text == "E") {
                    root.export-frame();
                    return accept;
                }
            }
            return reject;
        }

        VerticalLayout {
        spacing: 0px;

        DocumentChrome {
            title: root.comp-name;
            trailing-text: root.timecode-text;
        }

        MotionToolbar {
            compact-layout: root.compact-layout;
            show-guides <=> root.show-guides;
            show-safe-area <=> root.show-safe-area;
            is-playing <=> root.is-playing;
            is-looping <=> root.is-looping;
            curve-drawer-open <=> root.curve-drawer-open;
            zoom-value <=> root.zoom-value;
            add-layer => { root.add-layer(); }
            play-pause => { root.play-pause(); }
            step-back => { root.step-back(); }
            step-forward => { root.step-forward(); }
            toggle-loop => { root.toggle-loop(); }
            toggle-curve-drawer => { root.toggle-curve-drawer(); }
            export-frame => { root.export-frame(); }
        }

        DirectionalLayout {
            rtl: root.rtl;
            spacing: 0px;
            vertical-stretch: 1;

            if !root.rtl : MotionLayersPanel {
                panel-width: root.layer-column-width;
                layer-labels: root.layer-labels;
                active-layer-index: root.active-layer-index;
                select-layer(index) => { root.select-layer(index); }
                add-layer => { root.add-layer(); }
            }

            if !root.rtl : Rectangle { width: 1px; background: Theme.palette().border; }

            if root.rtl : MotionInspector {
                compact-layout: root.compact-layout;
                expanded <=> root.inspector-expanded;
                inspector-tab <=> root.inspector-tab;
                layer-detail: root.layer-labels.length > 0 ? "Layer " + (root.active-layer-index + 1) : "";
                pos-x <=> root.pos-x;
                pos-y <=> root.pos-y;
                scale-val <=> root.scale-val;
                rotation-val <=> root.rotation-val;
                opacity-val <=> root.opacity-val;
                timecode-display: root.timecode-display;
                timecode-text: root.timecode-text;
                toggle-expanded => { root.inspector-expanded = !root.inspector-expanded; }
                transform-changed(property, value) => { root.transform-changed(property, value); }
            }

            if root.rtl : Rectangle { width: 1px; background: Theme.palette().border; }

            VerticalLayout {
                spacing: 0px;
                horizontal-stretch: 1;

                MotionStage {
                    vertical-stretch: 1;
                    comp-name: root.comp-name;
                    layer-labels: root.layer-labels;
                    active-layer-index: root.active-layer-index;
                    pos-x <=> root.pos-x;
                    pos-y <=> root.pos-y;
                    scale-val <=> root.scale-val;
                    rotation-val <=> root.rotation-val;
                    opacity-val <=> root.opacity-val;
                    show-guides: root.show-guides;
                    show-safe-area: root.show-safe-area;
                    compact-layout: root.compact-layout;
                    transform-changed(property, value) => { root.transform-changed(property, value); }
                }

                MotionCurveDrawer {
                    horizontal-stretch: 1;
                    open <=> root.curve-drawer-open;
                }
            }

            if root.rtl : Rectangle { width: 1px; background: Theme.palette().border; }

            if root.rtl : MotionLayersPanel {
                panel-width: root.layer-column-width;
                layer-labels: root.layer-labels;
                active-layer-index: root.active-layer-index;
                select-layer(index) => { root.select-layer(index); }
                add-layer => { root.add-layer(); }
            }

            if !root.rtl : MotionInspector {
                compact-layout: root.compact-layout;
                expanded <=> root.inspector-expanded;
                inspector-tab <=> root.inspector-tab;
                layer-detail: root.layer-labels.length > 0 ? "Layer " + (root.active-layer-index + 1) : "";
                pos-x <=> root.pos-x;
                pos-y <=> root.pos-y;
                scale-val <=> root.scale-val;
                rotation-val <=> root.rotation-val;
                opacity-val <=> root.opacity-val;
                timecode-display: root.timecode-display;
                timecode-text: root.timecode-text;
                toggle-expanded => { root.inspector-expanded = !root.inspector-expanded; }
                transform-changed(property, value) => { root.transform-changed(property, value); }
            }
        }

        MotionTimeline {
            horizontal-stretch: 1;
            layer-labels: root.layer-labels;
            active-layer-index: root.active-layer-index;
            layer-column-width: root.layer-column-width;
            timecode-display: root.timecode-display;
            select-layer(index) => { root.select-layer(index); }
        }

        MotionStatusBar {
            leading: root.status-left;
            trailing: root.status-right;
        }
        }
    }

    palette := CommandPalette {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        open: root.palette-open;
        commands: root.palette-commands;
        query: root.palette-query;
        selected: root.palette-selected;
        command-invoked(idx) => {
            root.palette-invoked(idx);
        }
        query-changed(q) => {
            root.palette-query = q;
            root.palette-query-changed(q);
        }
        move-selection(delta) => {
            root.palette-move(delta);
        }
        key-text(text) => {
            root.palette-key-text(text);
        }
        backspace => {
            root.palette-backspace();
        }
        close-requested => {
            root.palette-open = false;
            app-focus.focus();
        }
    }
}
