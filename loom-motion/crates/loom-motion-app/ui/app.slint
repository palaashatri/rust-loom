import {
    AppHeader, WorkspaceToolbar, ToolButton, IconButton, StatusBar, Slider,
    SidebarSurface, InspectorSurface, WorkspaceRow, PaneTabs, MetricChip,
    CanvasBackdrop, TransportButton, EmptyState, PanelHeader
} from "components.slint";
import { Icon } from "icons.slint";
import { Theme } from "theme.slint";
export { Theme } from "theme.slint";

export component MotionApp inherits Window {
    title: "Loom Motion";
    min-width: 1100px;
    min-height: 720px;
    background: Theme.palette().canvas;

    in property <string> comp-name: "Untitled Composition";
    in property <string> timecode-text: "00:00:00:00 (60 fps)";
    in-out property <string> timecode-display: "00:00:00:00";
    in property <[string]> layer-labels: [];
    in property <int> active-layer-index: 0;
    in-out property <bool> is-playing: false;
    in-out property <bool> is-looping: false;
    in-out property <bool> curve-drawer-open: false;
    in-out property <int> inspector-tab: 0;
    in-out property <float> zoom-value: 68.0;

    in-out property <float> pos-x: 960.0;
    in-out property <float> pos-y: 540.0;
    in-out property <float> scale-val: 100.0;
    in-out property <float> rotation-val: 0.0;
    in-out property <float> opacity-val: 100.0;

    in property <string> status-left: "Ready";
    in property <string> status-right: "Offline";

    callback new-comp;
    callback open-comp;
    callback save-comp;
    callback add-layer;
    callback play-pause;
    callback step-back;
    callback step-forward;
    callback toggle-loop;
    callback select-layer(int);
    callback transform-changed(string, float);
    callback toggle-curve-drawer;

    VerticalLayout {
        spacing: 0px;

        AppHeader {
            app-name: "Loom Motion";
            document-title: root.comp-name;
            icon: "layers";
            context: root.timecode-text;
            state-text: "Local composition";
            state-tone: 0;
        }

        WorkspaceToolbar {
            ToolButton { icon: "new"; text: "New"; clicked => { root.new-comp(); } }
            ToolButton { icon: "open"; text: "Open"; clicked => { root.open-comp(); } }
            ToolButton { icon: "save"; text: "Save"; clicked => { root.save-comp(); } }
            Rectangle { width: 1px; height: 20px; background: Theme.palette().border; }
            ToolButton { icon: "plus"; text: "Layer"; clicked => { root.add-layer(); } }

            Rectangle { horizontal-stretch: 1; background: transparent; }

            TransportButton {
                icon: "chevron-left";
                label: "Step backward one frame";
                clicked => { root.step-back(); }
            }
            TransportButton {
                icon: root.is-playing ? "pause" : "play";
                label: root.is-playing ? "Pause preview" : "Play preview";
                active: root.is-playing;
                clicked => {
                    root.is-playing = !root.is-playing;
                    root.play-pause();
                }
            }
            TransportButton {
                icon: "chevron-right";
                label: "Step forward one frame";
                clicked => { root.step-forward(); }
            }
            TransportButton {
                icon: "redo";
                label: "Loop preview";
                active: root.is-looping;
                clicked => {
                    root.is-looping = !root.is-looping;
                    root.toggle-loop();
                }
            }
            MetricChip { label: "TC"; value: root.timecode-display; }

            Rectangle { horizontal-stretch: 1; background: transparent; }

            MetricChip { label: "Zoom"; value: Math.round(root.zoom-value) + "%"; }
            ToolButton {
                icon: "timeline";
                text: "Curves";
                checked: root.curve-drawer-open;
                clicked => {
                    root.curve-drawer-open = !root.curve-drawer-open;
                    root.toggle-curve-drawer();
                }
            }
        }

        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            SidebarSurface {
                width: 246px;
                title: "Layers";
                detail: root.layer-labels.length + " items";

                VerticalLayout {
                    spacing: 7px;
                    padding: 10px;

                    for label[idx] in root.layer-labels : WorkspaceRow {
                        height: 48px;
                        selected: idx == root.active-layer-index;
                        clicked => { root.select-layer(idx); }

                        HorizontalLayout {
                            spacing: 9px;
                            padding-left: 9px;
                            padding-right: 9px;

                            Rectangle {
                                width: 31px;
                                height: 31px;
                                border-radius: 8px;
                                background: idx == root.active-layer-index
                                    ? Theme.palette().selection-soft
                                    : Theme.palette().surface-sunken;
                                border-width: 1px;
                                border-color: idx == root.active-layer-index
                                    ? Theme.palette().accent
                                    : Theme.palette().border;
                                Icon {
                                    icon: "layers";
                                    size: 15px;
                                    tint: idx == root.active-layer-index
                                        ? Theme.palette().accent
                                        : Theme.palette().ink-secondary;
                                }
                            }

                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: label;
                                    font-size: Theme.tokens.typography.body;
                                    font-weight: idx == root.active-layer-index ? 650 : 500;
                                    color: Theme.palette().ink;
                                    overflow: elide;
                                }
                                Text {
                                    text: idx == root.active-layer-index ? "Selected layer" : "Motion layer";
                                    font-size: Theme.tokens.typography.caption;
                                    color: Theme.palette().ink-disabled;
                                }
                            }
                        }
                    }

                    if root.layer-labels.length == 0 : EmptyState {
                        icon: "layers";
                        title: "No layers";
                        description: "Add a text, image, or vector layer to start the composition.";
                        action-text: "Add Layer";
                        action => { root.add-layer(); }
                    }

                    Rectangle { vertical-stretch: 1; background: transparent; }
                    ToolButton { icon: "plus"; text: "Add Motion Layer"; clicked => { root.add-layer(); } }
                }
            }

            Rectangle { width: 1px; background: Theme.palette().border; }

            VerticalLayout {
                spacing: 0px;
                horizontal-stretch: 1;

                CanvasBackdrop {
                    vertical-stretch: 1;
                    stage-color: Theme.palette().media-stage;

                    Rectangle {
                        width: min(800px, parent.width - 70px);
                        height: min(450px, parent.height - 70px);
                        border-radius: 7px;
                        background: Theme.palette().paper-ink;
                        border-width: 1px;
                        border-color: Theme.palette().border-strong;
                        clip: true;

                        Rectangle {
                            x: 18px;
                            y: 18px;
                            width: parent.width - 36px;
                            height: parent.height - 36px;
                            border-width: 1px;
                            border-color: Theme.palette().grid-major;
                            background: Theme.palette().media-stage;
                        }

                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 62%;
                            height: 38%;
                            border-radius: 10px;
                            border-width: root.layer-labels.length > 0 ? 2px : 1px;
                            border-color: root.layer-labels.length > 0
                                ? Theme.palette().accent
                                : Theme.palette().border-strong;
                            background: Theme.palette().content-accent-soft;

                            VerticalLayout {
                                alignment: center;
                                spacing: 8px;
                                padding: 18px;
                                Text {
                                    text: root.comp-name;
                                    color: Theme.palette().paper-ink;
                                    font-size: Theme.tokens.typography.heading;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: root.layer-labels.length > 0
                                        ? root.layer-labels[root.active-layer-index]
                                        : "Add a layer to begin";
                                    color: Theme.palette().content-accent;
                                    font-size: Theme.tokens.typography.body-large;
                                    font-weight: 650;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Position " + Math.round(root.pos-x) + ", " + Math.round(root.pos-y)
                                        + "   ·   Scale " + Math.round(root.scale-val) + "%"
                                        + "   ·   Rotation " + Math.round(root.rotation-val) + "°";
                                    color: Theme.palette().paper-muted;
                                    font-size: Theme.tokens.typography.caption;
                                    horizontal-alignment: center;
                                }
                            }

                            if root.layer-labels.length > 0 : Rectangle {
                                x: -4px; y: -4px; width: 8px; height: 8px;
                                border-radius: 4px; background: Theme.palette().paper;
                                border-width: 2px; border-color: Theme.palette().accent;
                            }
                            if root.layer-labels.length > 0 : Rectangle {
                                x: parent.width - 4px; y: -4px; width: 8px; height: 8px;
                                border-radius: 4px; background: Theme.palette().paper;
                                border-width: 2px; border-color: Theme.palette().accent;
                            }
                            if root.layer-labels.length > 0 : Rectangle {
                                x: -4px; y: parent.height - 4px; width: 8px; height: 8px;
                                border-radius: 4px; background: Theme.palette().paper;
                                border-width: 2px; border-color: Theme.palette().accent;
                            }
                            if root.layer-labels.length > 0 : Rectangle {
                                x: parent.width - 4px; y: parent.height - 4px; width: 8px; height: 8px;
                                border-radius: 4px; background: Theme.palette().paper;
                                border-width: 2px; border-color: Theme.palette().accent;
                            }
                        }
                    }

                    Rectangle {
                        x: 28px;
                        y: parent.height - 56px;
                        width: 250px;
                        height: 34px;
                        border-radius: 9px;
                        background: Theme.palette().overlay;
                        border-width: 1px;
                        border-color: Theme.palette().border;

                        HorizontalLayout {
                            spacing: 8px;
                            padding-left: 9px;
                            padding-right: 9px;
                            IconButton {
                                icon: "minus";
                                label: "Zoom out";
                                clicked => { root.zoom-value = Math.max(10, root.zoom-value - 10); }
                            }
                            Slider {
                                label: "Zoom";
                                minimum: 10;
                                maximum: 200;
                                value <=> root.zoom-value;
                                horizontal-stretch: 1;
                            }
                            IconButton {
                                icon: "plus";
                                label: "Zoom in";
                                clicked => { root.zoom-value = Math.min(200, root.zoom-value + 10); }
                            }
                        }
                    }
                }

                if root.curve-drawer-open : Rectangle {
                    height: 160px;
                    background: Theme.palette().panel;
                    border-width: 0px;

                    VerticalLayout {
                        spacing: 0px;
                        PanelHeader { title: "Keyframe Graph"; detail: "Selected property"; }
                        Rectangle {
                            vertical-stretch: 1;
                            background: Theme.palette().canvas-alt;
                            border-width: 0px;

                            Rectangle { x: 25%; width: 1px; height: parent.height; background: Theme.palette().grid-minor; }
                            Rectangle { x: 50%; width: 1px; height: parent.height; background: Theme.palette().grid-major; }
                            Rectangle { x: 75%; width: 1px; height: parent.height; background: Theme.palette().grid-minor; }
                            Rectangle { y: 33%; width: parent.width; height: 1px; background: Theme.palette().grid-minor; }
                            Rectangle { y: 66%; width: parent.width; height: 1px; background: Theme.palette().grid-minor; }

                            VerticalLayout {
                                alignment: center;
                                spacing: 5px;
                                Text {
                                    text: "No keyed property selected";
                                    font-size: Theme.tokens.typography.body;
                                    font-weight: 650;
                                    color: Theme.palette().ink;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "The graph will show real interpolation handles after a property has keyframes.";
                                    font-size: Theme.tokens.typography.caption;
                                    color: Theme.palette().ink-secondary;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            Rectangle { width: 1px; background: Theme.palette().border; }

            InspectorSurface {
                width: 294px;
                title: "Inspector";
                detail: root.layer-labels.length > 0 ? "Layer " + (root.active-layer-index + 1) : "No selection";

                PaneTabs {
                    items: ["Transform", "Timing"];
                    current <=> root.inspector-tab;
                }

                VerticalLayout {
                    spacing: 12px;
                    padding: 14px;

                    if root.inspector-tab == 0 : VerticalLayout {
                        spacing: 12px;

                        Text {
                            text: "POSITION";
                            font-size: Theme.tokens.typography.caption;
                            font-weight: 700;
                            color: Theme.palette().ink-secondary;
                        }

                        Text { text: "X   " + Math.round(root.pos-x) + " px"; font-size: Theme.tokens.typography.body; color: Theme.palette().ink; }
                        Slider {
                            label: "Value";
                            value: root.pos-x;
                            minimum: 0.0;
                            maximum: 1920.0;
                            changed(val) => { root.pos-x = val; root.transform-changed("pos-x", val); }
                        }

                        Text { text: "Y   " + Math.round(root.pos-y) + " px"; font-size: Theme.tokens.typography.body; color: Theme.palette().ink; }
                        Slider {
                            label: "Value";
                            value: root.pos-y;
                            minimum: 0.0;
                            maximum: 1080.0;
                            changed(val) => { root.pos-y = val; root.transform-changed("pos-y", val); }
                        }

                        Rectangle { height: 1px; background: Theme.palette().border; }
                        Text {
                            text: "APPEARANCE";
                            font-size: Theme.tokens.typography.caption;
                            font-weight: 700;
                            color: Theme.palette().ink-secondary;
                        }

                        Text { text: "Scale   " + Math.round(root.scale-val) + "%"; font-size: Theme.tokens.typography.body; color: Theme.palette().ink; }
                        Slider {
                            label: "Scale";
                            value: root.scale-val;
                            minimum: 0.0;
                            maximum: 200.0;
                            changed(val) => { root.scale-val = val; root.transform-changed("scale", val); }
                        }

                        Text { text: "Rotation   " + Math.round(root.rotation-val) + "°"; font-size: Theme.tokens.typography.body; color: Theme.palette().ink; }
                        Slider {
                            label: "Rotation";
                            value: root.rotation-val;
                            minimum: -180.0;
                            maximum: 180.0;
                            changed(val) => { root.rotation-val = val; root.transform-changed("rotation", val); }
                        }

                        Text { text: "Opacity   " + Math.round(root.opacity-val) + "%"; font-size: Theme.tokens.typography.body; color: Theme.palette().ink; }
                        Slider {
                            label: "Opacity";
                            value: root.opacity-val;
                            minimum: 0.0;
                            maximum: 100.0;
                            changed(val) => { root.opacity-val = val; root.transform-changed("opacity", val); }
                        }
                    }

                    if root.inspector-tab == 1 : VerticalLayout {
                        spacing: 12px;
                        Text {
                            text: "COMPOSITION";
                            font-size: Theme.tokens.typography.caption;
                            font-weight: 700;
                            color: Theme.palette().ink-secondary;
                        }
                        MetricChip { label: "Time"; value: root.timecode-display; }
                        MetricChip { label: "Rate"; value: root.timecode-text; }
                        Rectangle { height: 1px; background: Theme.palette().border; }
                        Text {
                            text: "Keyframe editing is available through the property timeline when keyed data exists. No synthetic curves are displayed.";
                            wrap: word-wrap;
                            font-size: Theme.tokens.typography.caption;
                            color: Theme.palette().ink-secondary;
                        }
                    }

                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }
        }

        Rectangle {
            height: 176px;
            background: Theme.palette().panel;
            border-width: 0px;

            VerticalLayout {
                spacing: 0px;
                PanelHeader { title: "Timeline"; detail: root.timecode-display; }

                Rectangle {
                    height: 24px;
                    background: Theme.palette().chrome;
                    border-width: 0px;

                    HorizontalLayout {
                        spacing: 0px;
                        Rectangle { width: 246px; background: Theme.palette().surface-sunken; }
                        for marker in ["0s", "2s", "4s", "6s", "8s", "10s"] : Rectangle {
                            horizontal-stretch: 1;
                            Text {
                                text: marker;
                                font-size: Theme.tokens.typography.micro;
                                color: Theme.palette().ink-disabled;
                                horizontal-alignment: start;
                                vertical-alignment: center;
                            }
                            Rectangle { x: 0px; y: parent.height - 7px; width: 1px; height: 7px; background: Theme.palette().grid-major; }
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.palette().canvas-alt;
                    clip: true;

                    VerticalLayout {
                        spacing: 3px;
                        padding-top: 5px;
                        padding-bottom: 5px;

                        for label[idx] in root.layer-labels : WorkspaceRow {
                            height: 40px;
                            selected: idx == root.active-layer-index;
                            clicked => { root.select-layer(idx); }

                            HorizontalLayout {
                                spacing: 0px;

                                Rectangle {
                                    width: 246px;
                                    background: Theme.palette().panel;
                                    border-width: 0px;
                                    HorizontalLayout {
                                        spacing: 7px;
                                        padding-left: 11px;
                                        padding-right: 9px;
                                        Icon { icon: "layers"; size: 14px; tint: Theme.palette().ink-secondary; }
                                        Text { text: label; font-size: Theme.tokens.typography.body; color: Theme.palette().ink; overflow: elide; }
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: Theme.palette().canvas-alt;
                                    border-width: 0px;

                                    Rectangle {
                                        x: 10px + idx * 14px;
                                        y: 6px;
                                        width: max(120px, parent.width * 0.62 - idx * 18px);
                                        height: parent.height - 12px;
                                        border-radius: 7px;
                                        background: idx == root.active-layer-index
                                            ? Theme.palette().selection-soft
                                            : Theme.palette().surface-raised;
                                        border-width: 1px;
                                        border-color: idx == root.active-layer-index
                                            ? Theme.palette().accent
                                            : Theme.palette().border;
                                        Text {
                                            x: 9px;
                                            width: parent.width - 18px;
                                            text: label;
                                            font-size: Theme.tokens.typography.caption;
                                            color: Theme.palette().ink;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        x: 246px;
                        y: 0px;
                        width: 1px;
                        height: parent.height;
                        background: Theme.palette().accent;
                    }
                }
            }
        }

        StatusBar {
            status-left: root.status-left;
            status-right: root.status-right;
        }
    }
}
