import { ToolButton, IconButton, StatusBar, Slider, CollapsiblePanel } from "components.slint";
import { Icon } from "icons.slint";
import { Theme } from "theme.slint";
export { Theme } from "theme.slint";

export component MotionApp inherits Window {
    title: "Loom Motion";
    min-width: 980px;
    min-height: 680px;
    background: Theme.palette().canvas;

    in property <string> comp-name: "Untitled Composition";
    in property <string> timecode-text: "00:00:00:00 (60 fps)";
    in-out property <string> timecode-display: "00:00:00:00";
    in property <[string]> layer-labels: [];
    in property <int> active-layer-index: 0;
    in-out property <bool> is-playing: false;
    in-out property <bool> is-looping: false;
    in-out property <bool> curve-drawer-open: false;

    // Transform Property Inspector
    in-out property <float> pos-x: 960.0;
    in-out property <float> pos-y: 540.0;
    in-out property <float> scale-val: 100.0;
    in-out property <float> rotation-val: 0.0;
    in-out property <float> opacity-val: 100.0;

    in property <string> status-left: "Ready";
    in property <string> status-right: "Offline";

    callback new-comp;
    callback open-comp;
    callback save-comp;
    callback add-layer;
    callback play-pause;
    callback step-back;
    callback step-forward;
    callback toggle-loop;
    callback select-layer(int);
    callback transform-changed(string, float);
    callback toggle-curve-drawer;

    VerticalLayout {
        spacing: 0px;

        // Titlebar
        Rectangle {
            min-height: 40px;
            max-height: 40px;
            background: Theme.palette().surface;

            HorizontalLayout {
                spacing: 8px;
                padding-left: 12px;
                padding-right: 12px;
                Icon {
                    icon: "layers";
                    size: 18px;
                    tint: Theme.palette().accent;
                    y: (parent.height - 18px) / 2;
                }
                Text {
                    text: "Loom Motion — " + root.comp-name;
                    font-size: Theme.tokens.typography.title;
                    font-weight: 700;
                    color: Theme.palette().ink;
                    vertical-alignment: center;
                }
            }
        }

        // Toolbar & Animation Transport Controls
        Rectangle {
            min-height: 40px;
            max-height: 40px;
            background: Theme.palette().surface-sunken;

            HorizontalLayout {
                height: parent.height;
                cross-axis-alignment: center;
                spacing: 6px;
                padding-left: 8px;
                padding-right: 8px;

                ToolButton { icon: "new"; text: "New Comp"; clicked => { root.new-comp(); } }
                ToolButton { icon: "open"; text: "Open"; clicked => { root.open-comp(); } }
                ToolButton { icon: "save"; text: "Save"; clicked => { root.save-comp(); } }
                ToolButton { icon: "add"; text: "+ Motion Layer"; clicked => { root.add-layer(); } }

                Rectangle { width: 1px; height: 20px; background: Theme.palette().border; }

                // Animation Transport Controls
                ToolButton { text: "⏮ Step Back"; clicked => { root.step-back(); } }
                ToolButton {
                    text: root.is-playing ? "⏸ Pause" : "▶ Play";
                    checked: root.is-playing;
                    clicked => { root.is-playing = !root.is-playing; root.play-pause(); }
                }
                ToolButton { text: "⏭ Step Fwd"; clicked => { root.step-forward(); } }
                ToolButton {
                    text: "🔁 Loop";
                    checked: root.is-looping;
                    clicked => { root.is-looping = !root.is-looping; root.toggle-loop(); }
                }

                Rectangle {
                    background: Theme.palette().surface;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.palette().border;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;
                        Text {
                            text: root.timecode-display;
                            font-size: Theme.tokens.typography.body;
                            font-weight: 700;
                            color: Theme.palette().accent;
                            vertical-alignment: center;
                        }
                    }
                }

                Rectangle { horizontal-stretch: 1; background: transparent; }

                ToolButton {
                    text: "📈 Curve Editor";
                    checked: root.curve-drawer-open;
                    clicked => {
                        root.curve-drawer-open = !root.curve-drawer-open;
                        root.toggle-curve-drawer();
                    }
                }
            }
        }

        // Main Workspace & Transform Inspector
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;

            // Canvas Preview Area
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.palette().canvas;

                VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: 480px;
                        height: 270px;
                        background: Theme.palette().surface;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Theme.palette().border;

                        VerticalLayout {
                            alignment: center;

                            Text {
                                text: root.comp-name;
                                color: Theme.palette().ink;
                                font-size: Theme.tokens.typography.heading;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: root.timecode-text;
                                color: Theme.palette().accent;
                                font-size: Theme.tokens.typography.body;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Pos: (" + Math.round(root.pos-x) + ", " + Math.round(root.pos-y) + ") • Scale: " + Math.round(root.scale-val) + "% • Rot: " + Math.round(root.rotation-val) + "°";
                                color: Theme.palette().ink-secondary;
                                font-size: Theme.tokens.typography.caption;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }

            Rectangle { width: 1px; background: Theme.palette().border; }

            // Transform Property Inspector Sidebar
            Rectangle {
                width: 260px;
                background: Theme.palette().surface;

                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;

                    Text {
                        text: "TRANSFORM INSPECTOR";
                        font-size: Theme.tokens.typography.caption;
                        font-weight: 700;
                        color: Theme.palette().ink-secondary;
                    }

                    // Position X
                    VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            Text { text: "Position X"; font-size: Theme.tokens.typography.caption; color: Theme.palette().ink; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: Math.round(root.pos-x) + " px"; font-size: Theme.tokens.typography.caption; color: Theme.palette().ink-secondary; }
                        }
                        Slider {
                            value: root.pos-x;
                            minimum: 0.0;
                            maximum: 1920.0;
                            changed(val) => { root.pos-x = val; root.transform-changed("pos-x", val); }
                        }
                    }

                    // Position Y
                    VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            Text { text: "Position Y"; font-size: Theme.tokens.typography.caption; color: Theme.palette().ink; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: Math.round(root.pos-y) + " px"; font-size: Theme.tokens.typography.caption; color: Theme.palette().ink-secondary; }
                        }
                        Slider {
                            value: root.pos-y;
                            minimum: 0.0;
                            maximum: 1080.0;
                            changed(val) => { root.pos-y = val; root.transform-changed("pos-y", val); }
                        }
                    }

                    // Scale
                    VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            Text { text: "Scale"; font-size: Theme.tokens.typography.caption; color: Theme.palette().ink; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: Math.round(root.scale-val) + "%"; font-size: Theme.tokens.typography.caption; color: Theme.palette().ink-secondary; }
                        }
                        Slider {
                            value: root.scale-val;
                            minimum: 0.0;
                            maximum: 200.0;
                            changed(val) => { root.scale-val = val; root.transform-changed("scale", val); }
                        }
                    }

                    // Rotation
                    VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            Text { text: "Rotation"; font-size: Theme.tokens.typography.caption; color: Theme.palette().ink; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: Math.round(root.rotation-val) + "°"; font-size: Theme.tokens.typography.caption; color: Theme.palette().ink-secondary; }
                        }
                        Slider {
                            value: root.rotation-val;
                            minimum: -180.0;
                            maximum: 180.0;
                            changed(val) => { root.rotation-val = val; root.transform-changed("rotation", val); }
                        }
                    }

                    // Opacity
                    VerticalLayout {
                        spacing: 2px;
                        HorizontalLayout {
                            Text { text: "Opacity"; font-size: Theme.tokens.typography.caption; color: Theme.palette().ink; }
                            Rectangle { horizontal-stretch: 1; }
                            Text { text: Math.round(root.opacity-val) + "%"; font-size: Theme.tokens.typography.caption; color: Theme.palette().ink-secondary; }
                        }
                        Slider {
                            value: root.opacity-val;
                            minimum: 0.0;
                            maximum: 100.0;
                            changed(val) => { root.opacity-val = val; root.transform-changed("opacity", val); }
                        }
                    }
                }
            }
        }

        // Keyframe Curve Editor Drawer Panel
        if root.curve-drawer-open : Rectangle {
            height: 130px;
            background: Theme.palette().surface-sunken;
            border-width: 1px;
            border-color: Theme.palette().border;

            VerticalLayout {
                padding: 8px;
                spacing: 4px;

                HorizontalLayout {
                    Text {
                        text: "KEYFRAME CURVE EDITOR";
                        font-size: Theme.tokens.typography.caption;
                        font-weight: 700;
                        color: Theme.palette().accent;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    ToolButton { text: "Linear"; clicked => {} }
                    ToolButton { text: "Ease In"; clicked => {} }
                    ToolButton { text: "Ease Out"; clicked => {} }
                    ToolButton { text: "Bezier Curve"; checked: true; clicked => {} }
                }

                Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;
                    background: Theme.palette().surface;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.palette().border;

                    HorizontalLayout {
                        alignment: center;
                        Text {
                            text: "S-Curve Bezier Editor — Handle Points [P0, P1, P2, P3]";
                            font-size: Theme.tokens.typography.caption;
                            color: Theme.palette().ink-secondary;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }

        // Timeline Track Area
        Rectangle {
            height: 140px;
            background: Theme.palette().surface;

            VerticalLayout {
                padding: 10px;
                spacing: 6px;

                Text {
                    text: "TIMELINE TRACKS";
                    font-size: Theme.tokens.typography.caption;
                    font-weight: 700;
                    color: Theme.palette().ink-secondary;
                }

                for label[idx] in root.layer-labels : Rectangle {
                    height: 36px;
                    background: idx == root.active-layer-index
                        ? Theme.palette().selection-soft
                        : Theme.palette().surface-sunken;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: idx == root.active-layer-index
                        ? Theme.palette().accent
                        : transparent;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;

                        Text {
                            text: label;
                            color: Theme.palette().ink;
                            font-size: Theme.tokens.typography.body;
                            vertical-alignment: center;
                        }
                    }
                    touch := TouchArea {
                        clicked => { root.select-layer(idx); }
                    }
                    accessible-role: button;
                    accessible-label: "Select motion layer " + label;
                }
            }
        }

        StatusBar {
            status-left: root.status-left;
            status-right: root.status-right;
        }
    }
}

