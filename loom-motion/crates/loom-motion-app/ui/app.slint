// Loom Motion - Main Window
import { CommandPalette, CommandPaletteItem } from "components.slint";
import { Theme, ResponsivePolicy } from "theme.slint";
import { MotionActionToolbar } from "toolbar.slint";
import { MotionInspector } from "inspector.slint";
import { MotionStage } from "stage.slint";
import { MotionTimeline } from "timeline.slint";
import { MotionLayersPanel, MotionStatusBar } from "motion_components.slint";

export { Theme, ResponsivePolicy } from "theme.slint";

export component MotionApp inherits Window {
    title: "Loom Motion";
    min-width: 920px;
    min-height: 720px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.palette().canvas;

    in property <bool> rtl: false;
    changed rtl => { Theme.rtl = root.rtl; }
    in property <bool> compact-layout: false;
    in property <bool> icon-only-toolbar: false;
    in property <bool> labeled-toolbar: false;
    in property <bool> overflow-toolbar: false;

    callback window-resized(length);
    changed width => { root.window-resized(root.width); }

    property <length> layer-column-width: root.compact-layout ? 200px : 246px;

    in property <string> comp-name: "Untitled Composition";
    in property <string> timecode-text: "00:00:00:00 (60 fps)";
    in-out property <string> timecode-display: "00:00:00:00";
    in property <[string]> layer-labels: [];
    in property <[string]> layer-types: [];
    in property <int> active-layer-index: 0;
    in property <bool> is-playing: false;
    in property <bool> is-looping: false;
    in-out property <int> inspector-tab: 0;
    in-out property <float> zoom-value: 68.0;

    in-out property <float> pos-x: 960.0;
    in-out property <float> pos-y: 540.0;
    in-out property <float> scale-val: 100.0;
    in-out property <float> rotation-val: 0.0;
    in-out property <float> opacity-val: 100.0;

    in property <string> status-left: "Ready";
    in property <string> status-right: "Offline";
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;

    in-out property <bool> show-guides: true;
    in-out property <bool> show-safe-area: true;
    in-out property <bool> inspector-expanded: !root.compact-layout;

    callback new-comp;
    callback open-comp;
    callback save-comp;
    callback save-as-comp;
    callback undo;
    callback redo;
    callback export-frame;
    callback add-layer;
    callback play-pause;
    callback step-back;
    callback step-forward;
    callback toggle-loop;
    callback select-layer(int);
    callback transform-changed(string, float);
    callback transform-begin;
    callback transform-end;
    callback scrub-time(float);
    callback select-keyframe(float, string);
    callback edit-keyframe-time(string, float);

    in property <float> duration-secs: 10.0;
    in property <float> current-time-secs: 0.0;
    in property <float> frame-rate: 60.0;
    in property <[float]> active-layer-keyframes: [];
    in property <[string]> active-keyframe-properties: [];
    in property <[float]> layer-start-secs: [];
    in property <[float]> layer-duration-secs: [];
    in property <[float]> layer-pos-x: [];
    in property <[float]> layer-pos-y: [];
    in property <[float]> layer-scale: [];
    in property <[float]> layer-rotation: [];
    in property <[float]> layer-opacity: [];
    in property <[bool]> layer-visible: [];
    in property <string> selected-keyframe-property: "";
    in property <float> selected-keyframe-time: 0.0;

    in-out property <[CommandPaletteItem]> palette-commands: [];
    in-out property <bool> palette-open: false;
    in-out property <string> palette-query: "";
    in-out property <int> palette-selected: 0;
    callback palette-invoked(int);
    callback palette-query-changed(string);
    callback palette-move(int);
    callback palette-key-text(string);
    callback palette-backspace;
    callback palette-close;

    public function open-palette() {
        root.palette-open = true;
        root.palette-query = "";
        palette.grab-focus();
    }

    app-focus := FocusScope {
        key-pressed(event) => {
            if (root.palette-open) { return reject; }
            if (event.modifiers.control || event.modifiers.meta) {
                if (event.text == Key.K || event.text == "k") {
                    root.open-palette();
                    return accept;
                }
                if (event.text == "n" || event.text == "N") {
                    root.new-comp();
                    return accept;
                }
                if (event.text == "o" || event.text == "O") {
                    root.open-comp();
                    return accept;
                }
                if (event.text == "s" || event.text == "S") {
                    if (event.modifiers.shift) { root.save-as-comp(); } else { root.save-comp(); }
                    return accept;
                }
                if (event.text == "e" || event.text == "E") {
                    root.export-frame();
                    return accept;
                }
            }
            if (event.text == Key.LeftArrow) {
                root.step-back();
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.step-forward();
                return accept;
            }
            if (event.text == " ") {
                root.play-pause();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0px;
            padding: 0px;

            // Top Action Toolbar
            MotionActionToolbar {
                rtl: root.rtl;
                compact-layout: root.compact-layout;
                labeled: root.labeled-toolbar;
                overflow: root.overflow-toolbar;
                show-guides <=> root.show-guides;
                show-safe-area <=> root.show-safe-area;
                is-playing: root.is-playing;
                is-looping: root.is-looping;
                zoom-value <=> root.zoom-value;
                timecode-display: root.timecode-display;
                inspector-visible: root.inspector-expanded;
                add-layer => { root.add-layer(); }
                play-pause => { root.play-pause(); }
                step-back => { root.step-back(); }
                step-forward => { root.step-forward(); }
                toggle-loop => { root.toggle-loop(); }
                export-frame => { root.export-frame(); }
                toggle-inspector => { root.inspector-expanded = !root.inspector-expanded; }
                overflow-requested => { root.open-palette(); }
            }

            // Main Editor Workspace (Layers + Stage + Inspector)
            HorizontalLayout {
                spacing: 0px;
                vertical-stretch: 1;

                if !root.rtl : MotionLayersPanel {
                    panel-width: root.layer-column-width;
                    layer-labels: root.layer-labels;
                    active-layer-index: root.active-layer-index;
                    select-layer(index) => { root.select-layer(index); }
                    add-layer => { root.add-layer(); }
                }

                if root.rtl && root.inspector-expanded : MotionInspector {
                    compact-layout: root.compact-layout;
                    expanded <=> root.inspector-expanded;
                    inspector-tab <=> root.inspector-tab;
                    layer-detail: root.layer-labels.length > 0 ? "Layer " + (root.active-layer-index + 1) : "";
                    pos-x <=> root.pos-x;
                    pos-y <=> root.pos-y;
                    scale-val <=> root.scale-val;
                    rotation-val <=> root.rotation-val;
                    opacity-val <=> root.opacity-val;
                    timecode-display: root.timecode-display;
                    timecode-text: root.timecode-text;
                    duration-secs: root.duration-secs;
                    selected-keyframe-time: root.selected-keyframe-time;
                    selected-keyframe-property: root.selected-keyframe-property;
                    toggle-expanded => { root.inspector-expanded = !root.inspector-expanded; }
                    transform-changed(property, value) => { root.transform-changed(property, value); }
                    edit-keyframe-time(property, value) => { root.edit-keyframe-time(property, value); }
                }

                // Center Stage Canvas
                MotionStage {
                    comp-name: root.comp-name;
                    layer-labels: root.layer-labels;
                    layer-types: root.layer-types;
                    active-layer-index: root.active-layer-index;
                    pos-x <=> root.pos-x;
                    pos-y <=> root.pos-y;
                    scale-val <=> root.scale-val;
                    rotation-val <=> root.rotation-val;
                    opacity-val <=> root.opacity-val;
                    show-guides: root.show-guides;
                    show-safe-area: root.show-safe-area;
                    is-playing: root.is-playing;
                    layer-pos-x: root.layer-pos-x;
                    layer-pos-y: root.layer-pos-y;
                    layer-scale: root.layer-scale;
                    layer-rotation: root.layer-rotation;
                    layer-opacity: root.layer-opacity;
                    layer-visible: root.layer-visible;
                    compact-layout: root.compact-layout;
                    transform-changed(property, value) => { root.transform-changed(property, value); }
                    transform-begin => { root.transform-begin(); }
                    transform-end => { root.transform-end(); }
                }

                if root.rtl : MotionLayersPanel {
                    panel-width: root.layer-column-width;
                    layer-labels: root.layer-labels;
                    active-layer-index: root.active-layer-index;
                    select-layer(index) => { root.select-layer(index); }
                    add-layer => { root.add-layer(); }
                }

                if !root.rtl && root.inspector-expanded : MotionInspector {
                    compact-layout: root.compact-layout;
                    expanded <=> root.inspector-expanded;
                    inspector-tab <=> root.inspector-tab;
                    layer-detail: root.layer-labels.length > 0 ? "Layer " + (root.active-layer-index + 1) : "";
                    pos-x <=> root.pos-x;
                    pos-y <=> root.pos-y;
                    scale-val <=> root.scale-val;
                    rotation-val <=> root.rotation-val;
                    opacity-val <=> root.opacity-val;
                    timecode-display: root.timecode-display;
                    timecode-text: root.timecode-text;
                    duration-secs: root.duration-secs;
                    selected-keyframe-time: root.selected-keyframe-time;
                    selected-keyframe-property: root.selected-keyframe-property;
                    toggle-expanded => { root.inspector-expanded = !root.inspector-expanded; }
                    transform-changed(property, value) => { root.transform-changed(property, value); }
                    edit-keyframe-time(property, value) => { root.edit-keyframe-time(property, value); }
                }
            }

            // Bottom Multi-track Timeline
            MotionTimeline {
                layer-labels: root.layer-labels;
                active-layer-index: root.active-layer-index;
                layer-column-width: root.layer-column-width;
                timecode-display: root.timecode-display;
                duration-secs: root.duration-secs;
                current-time-secs: root.current-time-secs;
                frame-rate: root.frame-rate;
                active-layer-keyframes: root.active-layer-keyframes;
                active-keyframe-properties: root.active-keyframe-properties;
                layer-start-secs: root.layer-start-secs;
                layer-duration-secs: root.layer-duration-secs;
                selected-keyframe-time: root.selected-keyframe-time;
                selected-keyframe-property: root.selected-keyframe-property;
                select-layer(index) => { root.select-layer(index); }
                scrub-time(time) => { root.scrub-time(time); }
                select-keyframe(time, property) => { root.select-keyframe(time, property); }
                edit-keyframe-time(property, time) => { root.edit-keyframe-time(property, time); }
            }

            // Bottom Status Bar
            MotionStatusBar {
                leading: root.status-left;
                trailing: root.status-right;
            }
        }
    }

    // Modal Command Palette
    palette := CommandPalette {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        open: root.palette-open;
        commands: root.palette-commands;
        query: root.palette-query;
        selected: root.palette-selected;
        command-invoked(idx) => {
            root.palette-invoked(idx);
        }
        query-changed(q) => {
            root.palette-query = q;
            root.palette-query-changed(q);
        }
        move-selection(delta) => {
            root.palette-move(delta);
        }
        key-text(text) => {
            root.palette-key-text(text);
        }
        backspace => {
            root.palette-backspace();
        }
        close-requested => {
            root.palette-open = false;
            app-focus.focus();
        }
    }
}
