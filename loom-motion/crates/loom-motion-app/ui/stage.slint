// Loom Motion - Composition Stage / Canvas
import { Theme } from "theme.slint";
import { Icon } from "icons.slint";

export component MotionStage inherits Rectangle {
    in property <string> comp-name: "Untitled Composition";
    in property <[string]> layer-labels: [];
    in property <[string]> layer-types: [];
    in property <[bool]> layer-visible: [];
    in property <image> frame-image;
    in property <float> composition-width: 1920.0;
    in property <float> composition-height: 1080.0;
    in property <int> active-layer-index: 0;
    in-out property <float> pos-x: 960.0;
    in-out property <float> pos-y: 540.0;
    in-out property <float> scale-val: 100.0;
    in-out property <float> rotation-val: 0.0;
    in-out property <float> opacity-val: 100.0;
    in property <bool> show-guides: true;
    in property <bool> show-safe-area: true;
    in property <bool> compact-layout: false;
    in property <bool> is-playing: false;

    callback transform-changed(string, float);
    callback transform-begin;
    callback transform-end;

    vertical-stretch: 1;
    horizontal-stretch: 1;
    background: Theme.palette().media-stage;

    stage-container := Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(parent.width - 32px, 860px);
        height: min(parent.height - 32px, 484px);
        border-radius: Theme.tokens.metrics.radius-large;
        background: Theme.palette().paper-ink;
        border-width: 1px;
        border-color: Theme.palette().border-strong;
        drop-shadow-blur: 16px;
        drop-shadow-color: Theme.palette().shadow;
        clip: true;

        stage := Rectangle {
            property <float> document-width: max(root.composition-width, 1.0);
            property <float> document-height: max(root.composition-height, 1.0);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(parent.width - 32px, (parent.height - 32px) * self.document-width / self.document-height);
            height: self.width * self.document-height / self.document-width;
            background: #101217;
            border-width: 1px;
            border-color: Theme.palette().grid-major;
            clip: true;

            // This image is generated from the same sampled SVG frame that the
            // export action writes. Guides and selection handles stay as UI overlays.
            Image {
                source: root.frame-image;
                width: parent.width;
                height: parent.height;
                image-fit: contain;
            }

            // Composition Guides (Rule of Thirds)
            if root.show-guides : Rectangle { x: parent.width / 2; width: 1px; height: parent.height; background: Theme.palette().grid-minor; }
            if root.show-guides : Rectangle { y: parent.height / 2; width: parent.width; height: 1px; background: Theme.palette().grid-minor; }
            if root.show-guides : Rectangle { x: parent.width / 3; width: 1px; height: parent.height; background: Theme.palette().grid-minor; }
            if root.show-guides : Rectangle { x: parent.width * 2 / 3; width: 1px; height: parent.height; background: Theme.palette().grid-minor; }
            if root.show-guides : Rectangle { y: parent.height / 3; width: parent.width; height: 1px; background: Theme.palette().grid-minor; }
            if root.show-guides : Rectangle { y: parent.height * 2 / 3; width: parent.width; height: 1px; background: Theme.palette().grid-minor; }

            // Action & Title Safe Areas
            if root.show-safe-area : Rectangle {
                x: parent.width * 0.05; y: parent.height * 0.05;
                width: parent.width * 0.90; height: parent.height * 0.90;
                border-width: 1px; border-color: Theme.palette().border-strong;
                background: transparent;
            }
            if root.show-safe-area : Rectangle {
                x: parent.width * 0.10; y: parent.height * 0.10;
                width: parent.width * 0.80; height: parent.height * 0.80;
                border-width: 1px; border-color: Theme.palette().grid-minor;
                background: transparent;
            }

            if root.layer-labels.length == 0 : Text {
                x: 16px; y: parent.height / 2 - self.height / 2;
                width: parent.width - 32px;
                text: "Add a layer to begin";
                color: #f5f2eb;
                font-size: Theme.tokens.typography.body-large;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // This is only a selection outline. The image above owns all layer artwork.
            selected-object := Rectangle {
                property <string> selected-layer-type: root.layer-types.length > root.active-layer-index ? root.layer-types[root.active-layer-index] : "";
                property <float> selection-width-document: self.selected-layer-type == "Text" ? 650.0 : self.selected-layer-type == "VectorShape" ? 360.0 : 320.0;
                property <float> selection-height-document: self.selected-layer-type == "Text" ? 86.0 : self.selected-layer-type == "VectorShape" ? 200.0 : 180.0;
                property <float> selection-top-document: root.pos-y - (self.selected-layer-type == "Text" ? 70.0 : self.selection-height-document / 2.0);
                visible: root.layer-labels.length > 0 && root.layer-visible.length > root.active-layer-index && root.layer-visible[root.active-layer-index];
                x: clamp(root.pos-x / stage.document-width * parent.width - self.width / 2, 0px, parent.width - self.width);
                y: clamp(self.selection-top-document / stage.document-height * parent.height, 0px, parent.height - self.height);
                width: max(24px, self.selection-width-document / stage.document-width * parent.width * root.scale-val / 100.0);
                height: max(24px, self.selection-height-document / stage.document-height * parent.height * root.scale-val / 100.0);
                border-radius: Theme.tokens.metrics.radius-large;
                border-width: 2px;
                border-color: drag.has-hover || transform-focus.has-focus ? Theme.palette().focus : Theme.palette().accent;
                background: transparent;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
                transform-rotation: root.rotation-val * 1deg;
                animate x, y, width, height { duration: drag.pressed || root.is-playing || Theme.tokens.reduced-motion ? 0ms : 190ms; easing: cubic-bezier(0.2, 0.9, 0.2, 1.0); }
                animate border-color { duration: Theme.tokens.reduced-motion ? 0ms : 120ms; }

                // Selection Corner Handles are UI chrome and never enter the exported SVG.
                Rectangle { x: -5px; y: -5px; width: 10px; height: 10px; border-radius: 5px; background: Theme.palette().paper; border-width: 2px; border-color: Theme.palette().accent; }
                Rectangle { x: parent.width - 5px; y: -5px; width: 10px; height: 10px; border-radius: 5px; background: Theme.palette().paper; border-width: 2px; border-color: Theme.palette().accent; }
                Rectangle { x: -5px; y: parent.height - 5px; width: 10px; height: 10px; border-radius: 5px; background: Theme.palette().paper; border-width: 2px; border-color: Theme.palette().accent; }
                Rectangle { x: parent.width - 5px; y: parent.height - 5px; width: 10px; height: 10px; border-radius: 5px; background: Theme.palette().paper; border-width: 2px; border-color: Theme.palette().accent; }

                transform-focus := FocusScope {
                    key-pressed(event) => {
                        if (event.text == Key.LeftArrow) { root.pos-x = max(0.0, root.pos-x - 1.0); root.transform-changed("pos-x", root.pos-x); return accept; }
                        if (event.text == Key.RightArrow) { root.pos-x = min(stage.document-width, root.pos-x + 1.0); root.transform-changed("pos-x", root.pos-x); return accept; }
                        if (event.text == Key.UpArrow) { root.pos-y = max(0.0, root.pos-y - 1.0); root.transform-changed("pos-y", root.pos-y); return accept; }
                        if (event.text == Key.DownArrow) { root.pos-y = min(stage.document-height, root.pos-y + 1.0); root.transform-changed("pos-y", root.pos-y); return accept; }
                        return reject;
                    }
                }

                drag := TouchArea {
                    mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                    property <float> start-pos-x: 0.0;
                    property <float> start-pos-y: 0.0;
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            self.start-pos-x = root.pos-x;
                            self.start-pos-y = root.pos-y;
                            transform-focus.focus();
                            root.transform-begin();
                        }
                        if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                            root.transform-end();
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            root.pos-x = clamp(self.start-pos-x + (self.mouse-x - self.pressed-x) / stage.width * stage.document-width, 0.0, stage.document-width);
                            root.pos-y = clamp(self.start-pos-y + (self.mouse-y - self.pressed-y) / stage.height * stage.document-height, 0.0, stage.document-height);
                            root.transform-changed("pos-x", root.pos-x);
                            root.transform-changed("pos-y", root.pos-y);
                        }
                    }
                }
            }

            // Crosshair Guidelines on Drag
            if drag.pressed : Rectangle { x: selected-object.x + selected-object.width / 2; width: 1px; height: parent.height; background: Theme.palette().focus; }
            if drag.pressed : Rectangle { y: selected-object.y + selected-object.height / 2; width: parent.width; height: 1px; background: Theme.palette().focus; }

            // Drag indicator pill
            if drag.pressed : Rectangle {
                x: Theme.tokens.space.lg;
                y: Theme.tokens.space.lg;
                height: 26px;
                min-width: 178px;
                max-width: parent.width - Theme.tokens.space.xxl;
                border-radius: Theme.tokens.metrics.radius-medium;
                background: Theme.palette().overlay;
                border-width: 1px;
                border-color: Theme.palette().border;
                HorizontalLayout {
                    spacing: Theme.tokens.space.md;
                    padding-left: Theme.tokens.space.md;
                    padding-right: Theme.tokens.space.md;
                    Icon { icon: "cursor"; size: 13px; tint: Theme.palette().accent; }
                    Text { text: "Direct transform · release to commit"; font-size: Theme.tokens.typography.caption; color: Theme.palette().ink-secondary; vertical-alignment: center; overflow: elide; }
                }
            }
        }
    }
}
