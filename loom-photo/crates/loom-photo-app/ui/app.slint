import { ToolButton, IconButton, StatusBar } from "components.slint";
import { Icon } from "icons.slint";
import { Theme } from "theme.slint";
export { Theme } from "theme.slint";

export component PhotoApp inherits Window {
    title: "Loom Photo";
    min-width: 900px;
    min-height: 600px;
    background: Theme.palette().canvas;

    in property <string> project-name: "Untitled Image";
    in property <string> dimensions-text: "3840 x 2160 • 300 DPI";
    in property <[string]> layer-labels: [];
    in property <int> active-layer-index: 0;
    in property <string> selected-layer-text: "Selected: Background";
    in property <string> status-left: "Ready";
    in property <string> status-right: "Offline";

    callback new-project;
    callback open-project;
    callback save-project;
    callback add-layer;
    callback add-adjustment;
    callback export-image;
    callback select-layer(int);

    VerticalLayout {
        spacing: 0px;

        // Titlebar
        Rectangle {
            min-height: 41px;
            max-height: 41px;
            background: Theme.palette().surface;

            HorizontalLayout {
                spacing: 8px;
                padding-left: 12px;
                padding-right: 12px;
                Icon {
                    icon: "layers";
                    size: 18px;
                    tint: Theme.palette().accent;
                    y: (parent.height - 18px) / 2;
                }
                Text {
                    text: "Loom Photo — " + root.project-name;
                    font-size: Theme.tokens.typography.title;
                    font-weight: 700;
                    color: Theme.palette().ink;
                    vertical-alignment: center;
                }
            }
        }

        // Toolbar
        Rectangle {
            min-height: 40px;
            max-height: 40px;
            background: Theme.palette().surface-sunken;

            HorizontalLayout {
                height: parent.height;
                cross-axis-alignment: center;
                spacing: 6px;
                padding-left: 8px;
                padding-right: 8px;

                ToolButton { icon: "new"; text: "New Image"; clicked => { root.new-project(); } }
                ToolButton { icon: "open"; text: "Open"; clicked => { root.open-project(); } }
                ToolButton { icon: "save"; text: "Save"; clicked => { root.save-project(); } }
                ToolButton { icon: "add"; text: "+ Layer"; clicked => { root.add-layer(); } }
                ToolButton { icon: "settings"; text: "+ Adjustment"; clicked => { root.add-adjustment(); } }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                IconButton { icon: "export"; label: "Export PNG"; clicked => { root.export-image(); } }
            }
        }

        // Editing layout
        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            // Canvas Area
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.palette().canvas;

                VerticalLayout {
                    alignment: center;

                    Rectangle {
                        width: 520px;
                        height: 340px;
                        background: Theme.palette().surface;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Theme.palette().border;

                        VerticalLayout {
                            alignment: center;
                            padding: 16px;

                            Text {
                                text: root.project-name;
                                color: Theme.palette().ink;
                                font-size: Theme.tokens.typography.heading;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: root.dimensions-text;
                                color: Theme.palette().ink-secondary;
                                font-size: Theme.tokens.typography.body;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }

            // Layers Sidebar
            Rectangle {
                width: 240px;
                background: Theme.palette().surface;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: "LAYERS";
                        font-size: Theme.tokens.typography.caption;
                        font-weight: 700;
                        color: Theme.palette().ink-secondary;
                    }

                    Text {
                        text: root.selected-layer-text;
                        color: Theme.palette().accent;
                        font-size: Theme.tokens.typography.caption;
                    }

                    for label[idx] in root.layer-labels : Rectangle {
                        height: 40px;
                        background: idx == root.active-layer-index
                            ? Theme.palette().selection-soft
                            : Theme.palette().surface-sunken;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: idx == root.active-layer-index
                            ? Theme.palette().accent
                            : transparent;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;

                            Text {
                                text: label;
                                color: Theme.palette().accent;
                                font-size: Theme.tokens.typography.body;
                                vertical-alignment: center;
                            }
                        }
                        touch := TouchArea {
                            clicked => { root.select-layer(idx); }
                        }
                        accessible-role: button;
                        accessible-label: "Select layer " + label;
                    }

                }
            }
        }

        StatusBar {
            status-left: root.status-left;
            status-right: root.status-right;
        }
    }
}
