import {
    DocumentChrome, DirectionalLayout
} from "toolkit.slint";
import { CommandPalette, CommandPaletteItem } from "../../../../loom-core/crates/loom-ui/ui/components.slint";
import { PhotoToolbar, PhotoCanvas, PhotoInspector, PhotoStatusBar } from "components.slint";
import { Theme, ResponsivePolicy } from "theme.slint";

export component PhotoApp inherits Window {
    title: "Loom Photo";
    min-width: 1024px;
    min-height: 720px;
    // Give the window a stable intrinsic size before optional inspector and
    // export controls resolve. This keeps width-sensitive visibility bindings
    // from feeding back into the window's own layout calculation.
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.palette().canvas;
    in property <bool> rtl: false;
    changed rtl => { Theme.rtl = root.rtl; }
    // The host supplies the responsive breakpoint after selecting the window
    // size. Reading root.width from a conditional child makes the optional
    // inspector/export controls feed back into the window's implicit size.
    in property <bool> inspector-available: true;
    property <bool> inspector-visible: root.show-inspector && root.inspector-available;
    in property <bool> labeled-export: false;
    callback window-resized(length);
    changed width => { root.window-resized(root.width); }

    in property <string> project-name: "Untitled Photo";
    in property <string> dimensions-text: "0 × 0";
    in property <string> status-left: "Ready";
    in property <string> status-right: "Offline";
    in property <[string]> layer-labels: [];
    in property <[bool]> layer-visibilities: [];
    in property <int> active-layer-index: 0;
    in property <bool> can-move-up: false;
    in property <bool> can-move-down: false;
    in property <string> active-blend-mode: "Normal";
    in property <float> active-layer-opacity: 100.0;
    in property <image> preview-image;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in property <bool> has-preview: false;

    in-out property <int> active-tool: 0;
    // Pan is a viewport mode, not a paint/select tool. Keep it separate from
    // the tool index so the palette's Pan command cannot accidentally mark
    // Brush as active or make the canvas draggable while another tool is in
    // use.
    in-out property <bool> pan-mode: false;
    in-out property <int> inspector-tab: 0;
    in-out property <float> brightness-value: 0.0;
    in-out property <float> contrast-value: 0.0;
    in-out property <float> saturation-value: 0.0;
    in-out property <float> zoom-value: 72.0;

    property <length> viewport-pan-x: 0px;
    property <length> viewport-pan-y: 0px;
    property <bool> show-grid: true;
    in-out property <bool> show-inspector: true;

    callback new-project;
    callback open-project;
    callback save-project;
    callback save-as-project;
    callback undo;
    callback redo;
    callback add-layer;
    callback add-adjustment;
    callback remove-layer;
    callback move-layer(int);
    callback select-layer(int);
    callback toggle-layer-visibility(int);
    callback opacity-changed(float);
    callback blend-mode-changed(string);
    callback select-tool(string);
    callback brightness-changed(float);
    callback contrast-changed(float);
    callback saturation-changed(float);
    callback import-image;
    callback export-png;
    callback export-jpeg;
    callback toggle-inspector;

    in-out property <[CommandPaletteItem]> palette-commands: [];
    in-out property <bool> palette-open: false;
    in-out property <string> palette-query: "";
    in-out property <int> palette-selected: 0;
    callback palette-invoked(int);
    callback palette-query-changed(string);
    callback palette-move(int);
    callback palette-key-text(string);
    callback palette-backspace;
    callback palette-close;

    public function open-palette() {
        root.palette-open = true;
        root.palette-query = "";
        palette.grab-focus();
    }

    app-focus := FocusScope {
        key-pressed(event) => {
            if (root.palette-open) { return reject; }
            if ((event.modifiers.control || event.modifiers.meta) && (event.text == Key.K || event.text == "k")) {
                root.open-palette();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0px;
            padding: 0px;

            DocumentChrome {
                title: root.project-name;
                trailing-text: root.dimensions-text;
            }

            PhotoToolbar {
                active-tool: root.active-tool;
                zoom-value <=> root.zoom-value;
                inspector-visible: root.inspector-visible;
                labeled-export: root.labeled-export;
                select-tool(tool) => {
                    root.active-tool = tool == "brush" ? 1 : tool == "wand" ? 2 : 0;
                    root.pan-mode = false;
                    root.select-tool(tool);
                }
                add-layer => { root.add-layer(); }
                add-adjustment => { root.add-adjustment(); }
                import-image => { root.import-image(); }
                export-png => { root.export-png(); }
                toggle-inspector => { root.toggle-inspector(); }
            }

            DirectionalLayout {
                rtl: root.rtl;
                spacing: 0px;
                vertical-stretch: 1;

                if root.inspector-visible && root.rtl : PhotoInspector {
                    inspector-tab <=> root.inspector-tab;
                    layer-labels: root.layer-labels;
                    layer-visibilities: root.layer-visibilities;
                    active-layer-index: root.active-layer-index;
                    can-move-up: root.can-move-up;
                    can-move-down: root.can-move-down;
                    active-blend-mode: root.active-blend-mode;
                    active-layer-opacity: root.active-layer-opacity;
                    brightness-value: root.brightness-value;
                    contrast-value: root.contrast-value;
                    saturation-value: root.saturation-value;
                    has-preview: root.has-preview;
                    select-layer(index) => { root.select-layer(index); }
                    toggle-layer-visibility(index) => { root.toggle-layer-visibility(index); }
                    add-layer => { root.add-layer(); }
                    add-adjustment => { root.add-adjustment(); }
                    move-layer(delta) => { root.move-layer(delta); }
                    remove-layer => { root.remove-layer(); }
                    blend-mode-changed(mode) => { root.blend-mode-changed(mode); }
                    opacity-changed(value) => { root.opacity-changed(value); }
                    brightness-changed(value) => { root.brightness-changed(value); }
                    contrast-changed(value) => { root.contrast-changed(value); }
                    saturation-changed(value) => { root.saturation-changed(value); }
                    import-image => { root.import-image(); }
                    export-png => { root.export-png(); }
                    export-jpeg => { root.export-jpeg(); }
                }

                photo-canvas := PhotoCanvas {
                    has-preview: root.has-preview;
                    preview-image: root.preview-image;
                    show-grid: root.show-grid;
                    active-tool: root.active-tool;
                    pan-mode <=> root.pan-mode;
                    zoom-value <=> root.zoom-value;
                    viewport-pan-x <=> root.viewport-pan-x;
                    viewport-pan-y <=> root.viewport-pan-y;
                    import-image => { root.import-image(); }
                }

                if root.inspector-visible && !root.rtl : PhotoInspector {
                    inspector-tab <=> root.inspector-tab;
                    layer-labels: root.layer-labels;
                    layer-visibilities: root.layer-visibilities;
                    active-layer-index: root.active-layer-index;
                    can-move-up: root.can-move-up;
                    can-move-down: root.can-move-down;
                    active-blend-mode: root.active-blend-mode;
                    active-layer-opacity: root.active-layer-opacity;
                    brightness-value: root.brightness-value;
                    contrast-value: root.contrast-value;
                    saturation-value: root.saturation-value;
                    has-preview: root.has-preview;
                    select-layer(index) => { root.select-layer(index); }
                    toggle-layer-visibility(index) => { root.toggle-layer-visibility(index); }
                    add-layer => { root.add-layer(); }
                    add-adjustment => { root.add-adjustment(); }
                    move-layer(delta) => { root.move-layer(delta); }
                    remove-layer => { root.remove-layer(); }
                    blend-mode-changed(mode) => { root.blend-mode-changed(mode); }
                    opacity-changed(value) => { root.opacity-changed(value); }
                    brightness-changed(value) => { root.brightness-changed(value); }
                    contrast-changed(value) => { root.contrast-changed(value); }
                    saturation-changed(value) => { root.saturation-changed(value); }
                    import-image => { root.import-image(); }
                    export-png => { root.export-png(); }
                    export-jpeg => { root.export-jpeg(); }
                }
            }

            PhotoStatusBar {
                leading: root.status-left + "  •  " + (root.pan-mode ? (photo-canvas.panning ? "Panning viewport" : "Pan tool") : root.active-tool == 0 ? "Select tool" : root.active-tool == 1 ? "Brush tool" : "Wand tool");
                trailing: root.status-right + "  •  " + Math.round(root.zoom-value) + "%";
            }
        }

        palette := CommandPalette {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            open: root.palette-open;
            commands: root.palette-commands;
            query: root.palette-query;
            selected: root.palette-selected;
            command-invoked(idx) => { root.palette-invoked(idx); }
            query-changed(q) => {
                root.palette-query = q;
                root.palette-query-changed(q);
            }
            move-selection(delta) => { root.palette-move(delta); }
            key-text(text) => { root.palette-key-text(text); }
            backspace => { root.palette-backspace(); }
            close-requested => {
                root.palette-open = false;
                app-focus.focus();
            }
        }
    }
}
