import {
    DocumentChrome, Toolbar, ToolbarGroup, ToolbarSpacer, ToolbarButton,
    ToolbarIconButton, ToolkitStatusBar, InspectorSurface, SectionHeader,
    SegmentedControl, RangeSlider, PropertyRow, TabStrip, CanvasSurface
} from "toolkit.slint";
import { CommandPalette, CommandPaletteItem } from "components.slint";
import { Icon } from "icons.slint";
import { Theme } from "theme.slint";

export component PhotoApp inherits Window {
    title: "Loom Photo";
    min-width: 1024px;
    min-height: 720px;
    background: Theme.palette().canvas;
    property <bool> inspector-visible: root.show-inspector && root.width >= 1180px;
    property <bool> labeled-export: root.width >= 1320px;

    in property <string> project-name: "Untitled Photo";
    in property <string> dimensions-text: "0 × 0";
    in property <string> status-left: "Ready";
    in property <string> status-right: "Offline";
    in property <[string]> layer-labels: [];
    in property <[bool]> layer-visibilities: [];
    in property <int> active-layer-index: 0;
    in property <string> active-blend-mode: "Normal";
    in property <float> active-layer-opacity: 100.0;
    in property <image> preview-image;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in property <bool> has-preview: false;

    in-out property <int> active-tool: 0;
    in-out property <int> inspector-tab: 0;
    in-out property <float> brightness-value: 0.0;
    in-out property <float> contrast-value: 0.0;
    in-out property <float> saturation-value: 0.0;
    in-out property <float> zoom-value: 72.0;

    property <length> viewport-pan-x: 0px;
    property <length> viewport-pan-y: 0px;
    property <bool> show-grid: true;
    property <bool> show-inspector: true;

    callback new-project;
    callback open-project;
    callback save-project;
    callback save-as-project;
    callback undo;
    callback redo;
    callback add-layer;
    callback add-adjustment;
    callback remove-layer;
    callback move-layer(int);
    callback select-layer(int);
    callback toggle-layer-visibility(int);
    callback opacity-changed(float);
    callback blend-mode-changed(string);
    callback select-tool(string);
    callback brightness-changed(float);
    callback contrast-changed(float);
    callback saturation-changed(float);
    callback import-image;
    callback export-png;
    callback export-jpeg;

    in-out property <[CommandPaletteItem]> palette-commands: [];
    in-out property <bool> palette-open: false;
    in-out property <string> palette-query: "";
    in-out property <int> palette-selected: 0;
    callback palette-invoked(int);
    callback palette-query-changed(string);
    callback palette-move(int);
    callback palette-key-text(string);
    callback palette-backspace;
    callback palette-close;

    public function open-palette() {
        root.palette-open = true;
        root.palette-query = "";
        palette.grab-focus();
    }

    app-focus := FocusScope {
        key-pressed(event) => {
            if (root.palette-open) { return reject; }
            if ((event.modifiers.control || event.modifiers.meta) && (event.text == Key.K || event.text == "k")) {
                root.open-palette();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0px;
            padding: 0px;

            DocumentChrome {
                title: root.project-name;
                trailing-text: root.dimensions-text;
            }

            Toolbar {
                ToolbarGroup {
                    ToolbarIconButton { icon: "new"; label: "New project"; clicked => { root.new-project(); } }
                    ToolbarIconButton { icon: "open"; label: "Open project"; clicked => { root.open-project(); } }
                    ToolbarIconButton { icon: "save"; label: "Save"; clicked => { root.save-project(); } }
                    ToolbarIconButton { icon: "undo"; label: "Undo"; enabled: root.can-undo; clicked => { root.undo(); } }
                    ToolbarIconButton { icon: "redo"; label: "Redo"; enabled: root.can-redo; clicked => { root.redo(); } }
                }

                ToolbarGroup {
                    leading-separation: true;
                    ToolbarButton { icon: "plus"; label: "Layer"; clicked => { root.add-layer(); } }
                    ToolbarIconButton { icon: "wand"; label: "Add adjustment"; clicked => { root.add-adjustment(); } }
                    ToolbarIconButton { icon: "import"; label: "Import image"; clicked => { root.import-image(); } }
                }

                ToolbarSpacer { }

                ToolbarGroup {
                    ToolbarIconButton {
                        icon: "minus";
                        label: "Zoom out";
                        clicked => { root.zoom-value = Math.max(10, root.zoom-value - 10); }
                    }
                    Text {
                        text: Math.round(root.zoom-value) + "%";
                        min-width: 44px;
                        font-size: Theme.tokens.typography.caption;
                        font-weight: 500;
                        color: Theme.palette().ink-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    ToolbarIconButton {
                        icon: "plus";
                        label: "Zoom in";
                        clicked => { root.zoom-value = Math.min(200, root.zoom-value + 10); }
                    }
                    ToolbarIconButton {
                        icon: "settings";
                        label: "Toggle inspector";
                        checked: root.inspector-visible;
                        clicked => { root.show-inspector = !root.show-inspector; }
                    }
                    if root.labeled-export : ToolbarButton {
                        icon: "export";
                        label: "Export PNG";
                        primary: true;
                        enabled: root.has-preview;
                        clicked => { root.export-png(); }
                    }
                    if !root.labeled-export : ToolbarIconButton {
                        icon: "export";
                        label: "Export PNG";
                        enabled: root.has-preview;
                        clicked => { root.export-png(); }
                    }
                }
            }

            HorizontalLayout {
                spacing: 0px;
                vertical-stretch: 1;

                Rectangle {
                    width: 40px;
                    background: Theme.palette().chrome;

                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        height: parent.height;
                        background: Theme.palette().border;
                    }

                    VerticalLayout {
                        spacing: 4px;
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: 8px;
                        padding-bottom: 8px;

                        ToolbarIconButton {
                            icon: "cursor";
                            label: "Select tool";
                            checked: root.active-tool == 0;
                            clicked => { root.active-tool = 0; root.select-tool("Select"); }
                        }
                        ToolbarIconButton {
                            icon: "cursor";
                            label: "Pan tool";
                            checked: root.active-tool == 1;
                            clicked => { root.active-tool = 1; root.select-tool("Pan"); }
                        }
                        ToolbarIconButton {
                            icon: "grid";
                            label: "Toggle grid";
                            checked: root.show-grid;
                            clicked => { root.show-grid = !root.show-grid; }
                        }
                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }
                }

                CanvasSurface {
                    stage := Rectangle {
                        x: 24px;
                        y: 24px;
                        width: parent.width - 48px;
                        height: parent.height - 48px;
                        background: Theme.palette().media-stage;
                        border-width: 1px;
                        border-color: canvas-focus.has-focus ? Theme.palette().focus : Theme.palette().border-strong;
                        clip: true;

                        if root.show-grid : Rectangle { x: parent.width / 2; width: 1px; height: parent.height; background: Theme.palette().grid-major; }
                        if root.show-grid : Rectangle { y: parent.height / 2; width: parent.width; height: 1px; background: Theme.palette().grid-major; }
                        if root.show-grid : Rectangle { x: parent.width / 4; width: 1px; height: parent.height; background: Theme.palette().grid-minor; }
                        if root.show-grid : Rectangle { x: parent.width * 3 / 4; width: 1px; height: parent.height; background: Theme.palette().grid-minor; }
                        if root.show-grid : Rectangle { y: parent.height / 4; width: parent.width; height: 1px; background: Theme.palette().grid-minor; }
                        if root.show-grid : Rectangle { y: parent.height * 3 / 4; width: parent.width; height: 1px; background: Theme.palette().grid-minor; }

                        if root.has-preview : viewport := Rectangle {
                            property <length> scaled-width: max(120px, stage.width * root.zoom-value / 100.0);
                            property <length> scaled-height: max(90px, stage.height * root.zoom-value / 100.0);
                            x: (stage.width - self.scaled-width) / 2 + root.viewport-pan-x;
                            y: (stage.height - self.scaled-height) / 2 + root.viewport-pan-y;
                            width: self.scaled-width;
                            height: self.scaled-height;
                            background: Theme.palette().paper-ink;
                            border-width: 1px;
                            border-color: Theme.palette().accent;
                            clip: true;
                            Image {
                                source: root.preview-image;
                                width: parent.width;
                                height: parent.height;
                                image-fit: contain;
                            }
                            Rectangle { x: -4px; y: -4px; width: 8px; height: 8px; border-radius: 4px; background: Theme.palette().paper; border-width: 1px; border-color: Theme.palette().accent; }
                            Rectangle { x: parent.width - 4px; y: -4px; width: 8px; height: 8px; border-radius: 4px; background: Theme.palette().paper; border-width: 1px; border-color: Theme.palette().accent; }
                            Rectangle { x: -4px; y: parent.height - 4px; width: 8px; height: 8px; border-radius: 4px; background: Theme.palette().paper; border-width: 1px; border-color: Theme.palette().accent; }
                            Rectangle { x: parent.width - 4px; y: parent.height - 4px; width: 8px; height: 8px; border-radius: 4px; background: Theme.palette().paper; border-width: 1px; border-color: Theme.palette().accent; }
                        }

                        if !root.has-preview : VerticalLayout {
                            alignment: center;
                            spacing: 12px;
                            Icon { icon: "image"; size: 40px; tint: Theme.palette().ink-disabled; }
                            Text {
                                text: "Import an image to begin";
                                font-size: Theme.tokens.typography.heading;
                                font-weight: 600;
                                color: Theme.palette().ink;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "PNG and JPEG are decoded locally.";
                                font-size: Theme.tokens.typography.body;
                                color: Theme.palette().ink-secondary;
                                horizontal-alignment: center;
                            }
                            ToolbarButton { icon: "import"; label: "Import Image"; primary: true; clicked => { root.import-image(); } }
                        }

                        canvas-focus := FocusScope {
                            enabled: root.has-preview;
                            key-pressed(event) => {
                                if (event.text == Key.LeftArrow) {
                                    root.viewport-pan-x = root.viewport-pan-x - 1px;
                                    return accept;
                                }
                                if (event.text == Key.RightArrow) {
                                    root.viewport-pan-x = root.viewport-pan-x + 1px;
                                    return accept;
                                }
                                if (event.text == Key.UpArrow) {
                                    root.viewport-pan-y = root.viewport-pan-y - 1px;
                                    return accept;
                                }
                                if (event.text == Key.DownArrow) {
                                    root.viewport-pan-y = root.viewport-pan-y + 1px;
                                    return accept;
                                }
                                return reject;
                            }
                        }

                        canvas-pan := TouchArea {
                            enabled: root.has-preview;
                            mouse-cursor: root.active-tool == 1 ? (self.pressed ? MouseCursor.grabbing : MouseCursor.grab) : MouseCursor.default;
                            property <length> start-pan-x: 0px;
                            property <length> start-pan-y: 0px;
                            pointer-event(event) => {
                                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                    self.start-pan-x = root.viewport-pan-x;
                                    self.start-pan-y = root.viewport-pan-y;
                                    canvas-focus.focus();
                                }
                            }
                            moved => {
                                if (self.pressed && root.active-tool == 1) {
                                    root.viewport-pan-x = clamp(self.start-pan-x + self.mouse-x - self.pressed-x, -stage.width, stage.width);
                                    root.viewport-pan-y = clamp(self.start-pan-y + self.mouse-y - self.pressed-y, -stage.height, stage.height);
                                }
                            }
                        }
                    }
                }

                if root.inspector-visible : InspectorSurface {
                    width: 280px;
                    title: "Inspector";

                    VerticalLayout {
                        spacing: 12px;
                        padding: 12px;

                        TabStrip {
                            tabs: ["Adjust", "Layers", "Export"];
                            current <=> root.inspector-tab;
                        }

                        if root.inspector-tab == 0 : VerticalLayout {
                            spacing: 12px;
                            SectionHeader { title: "Color"; }
                            PropertyRow {
                                label: "Brightness";
                                RangeSlider { label: "Brightness"; minimum: -100; maximum: 100; value <=> root.brightness-value; changed(value) => { root.brightness-changed(value); } }
                            }
                            PropertyRow {
                                label: "Contrast";
                                RangeSlider { label: "Contrast"; minimum: -100; maximum: 100; value <=> root.contrast-value; changed(value) => { root.contrast-changed(value); } }
                            }
                            PropertyRow {
                                label: "Saturation";
                                RangeSlider { label: "Saturation"; minimum: -100; maximum: 100; value <=> root.saturation-value; changed(value) => { root.saturation-changed(value); } }
                            }
                        }

                        if root.inspector-tab == 1 : VerticalLayout {
                            spacing: 10px;
                            SectionHeader { title: "Layers"; }
                            for label[index] in root.layer-labels : Rectangle {
                                height: 44px;
                                border-radius: Theme.tokens.metrics.radius-medium;
                                background: index == root.active-layer-index ? Theme.palette().selection-soft : layer-touch.has-hover ? Theme.palette().surface-raised : transparent;

                                HorizontalLayout {
                                    spacing: 8px;
                                    padding-left: 6px;
                                    padding-right: 8px;
                                    cross-axis-alignment: center;
                                    ToolbarIconButton {
                                        icon: root.layer-visibilities[index] ? "eye" : "eye-off";
                                        label: "Toggle layer visibility";
                                        clicked => { root.toggle-layer-visibility(index); }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        horizontal-stretch: 1;
                                        Text {
                                            text: label;
                                            font-size: Theme.tokens.typography.body;
                                            font-weight: index == root.active-layer-index ? 600 : 400;
                                            color: Theme.palette().ink;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: index == root.active-layer-index ? root.active-blend-mode + " · " + Math.round(root.active-layer-opacity) + "%" : "Layer";
                                            font-size: Theme.tokens.typography.caption;
                                            color: Theme.palette().ink-secondary;
                                            overflow: elide;
                                        }
                                    }
                                }

                                layer-touch := TouchArea { clicked => { root.select-layer(index); } }
                                accessible-role: button;
                                accessible-label: label;
                                accessible-action-default => { root.select-layer(index); }
                            }

                            HorizontalLayout {
                                spacing: 4px;
                                ToolbarIconButton { icon: "plus"; label: "Add pixel layer"; clicked => { root.add-layer(); } }
                                ToolbarIconButton { icon: "wand"; label: "Add adjustment"; clicked => { root.add-adjustment(); } }
                                ToolbarIconButton { icon: "chevron-left"; label: "Move layer down"; clicked => { root.move-layer(-1); } }
                                ToolbarIconButton { icon: "chevron-right"; label: "Move layer up"; clicked => { root.move-layer(1); } }
                                ToolbarSpacer { }
                                ToolbarIconButton {
                                    icon: "trash";
                                    label: "Delete selected layer";
                                    enabled: root.layer-labels.length > 1;
                                    clicked => { root.remove-layer(); }
                                }
                            }

                            SectionHeader { title: "Compositing"; }
                            SegmentedControl {
                                label: "Blend mode";
                                items: ["Normal", "Multiply", "Screen", "Overlay"];
                                current: root.active-blend-mode == "Multiply" ? 1 : root.active-blend-mode == "Screen" ? 2 : root.active-blend-mode == "Overlay" ? 3 : 0;
                                selected(index) => { root.blend-mode-changed(index == 1 ? "Multiply" : index == 2 ? "Screen" : index == 3 ? "Overlay" : "Normal"); }
                            }
                            PropertyRow {
                                label: "Opacity";
                                RangeSlider { label: "Opacity"; minimum: 0; maximum: 100; value: root.active-layer-opacity; changed(value) => { root.opacity-changed(value); } }
                            }
                        }

                        if root.inspector-tab == 2 : VerticalLayout {
                            spacing: 12px;
                            SectionHeader { title: "Import"; }
                            Text {
                                text: "Choose a PNG or JPEG with the native picker. Imported images remain separate from Loom Photo project files.";
                                wrap: word-wrap;
                                font-size: Theme.tokens.typography.caption;
                                color: Theme.palette().ink-secondary;
                            }
                            ToolbarButton { icon: "import"; label: "Import PNG / JPEG"; clicked => { root.import-image(); } }
                            SectionHeader { title: "Export"; }
                            ToolbarButton { icon: "export"; label: "Export PNG"; primary: true; enabled: root.has-preview; clicked => { root.export-png(); } }
                            ToolbarButton { icon: "export"; label: "Export JPEG"; enabled: root.has-preview; clicked => { root.export-jpeg(); } }
                        }

                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }
                }
            }

            ToolkitStatusBar {
                leading: root.status-left + "  •  " + (root.active-tool == 1 ? (canvas-pan.pressed ? "Panning viewport" : "Pan tool") : "Select tool");
                trailing: root.status-right + "  •  " + Math.round(root.zoom-value) + "%";
            }
        }

        palette := CommandPalette {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            open: root.palette-open;
            commands: root.palette-commands;
            query: root.palette-query;
            selected: root.palette-selected;
            command-invoked(idx) => { root.palette-invoked(idx); }
            query-changed(q) => {
                root.palette-query = q;
                root.palette-query-changed(q);
            }
            move-selection(delta) => { root.palette-move(delta); }
            key-text(text) => { root.palette-key-text(text); }
            backspace => { root.palette-backspace(); }
            close-requested => {
                root.palette-open = false;
                app-focus.focus();
            }
        }
    }
}
