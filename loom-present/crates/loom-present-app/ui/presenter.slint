import { Theme } from "theme.slint";
import { LoomButton } from "foundation.slint";
import { ThumbRows, MiniSlide } from "present_components.slint";
import { PresenterToolBar } from "presenter_overlay.slint";
export { ThumbRows, ObjectPart, ObjectParts, ElementInk } from "present_components.slint";

export struct PresenterStrokeDot {
    x: float,
    y: float,
    color: color,
    size: length,
}

// The presenter's own window: notes, what comes next, and a clock. It is a
// separate window so it can sit on a second display while the slideshow fills
// the audience screen; on one display it is simply a rehearsal view.
export component PresenterWindow inherits Window {
    icon: @image-url("../../../../loom-core/crates/loom-ui/ui/app-icons/loom-present.png");
    title: "Presenter View";
    default-font-family: Theme.ui-font-family;
    min-width: 640px;
    min-height: 420px;
    preferred-width: 960px;
    preferred-height: 600px;
    background: Theme.palette().canvas;

    in property <string> position-text: "Slide 1 of 1";
    in property <string> slide-title: "";
    in property <string> notes: "";
    in-out property <int> screen-overlay: 0; // 0: none, 1: blackout (B), 2: whiteout (W)
    in-out property <length> notes-font-size: Theme.type.body;
    in property <string> next-title: "";
    in property <string> elapsed: "00:00";
    in property <bool> timer-running: true;
    in property <bool> has-next: false;
    in property <bool> has-previous: false;
    in property <ThumbRows> current-rows;
    in property <ThumbRows> next-rows;
    // Set from the window height after layout, so it cannot feed back into it.
    property <bool> roomy: false;
    changed height => { root.roomy = self.height >= 560px; }

    in-out property <int> active-tool: 0;
    in property <string> jump-buffer: "";
    in property <[PresenterStrokeDot]> stroke-dots: [];
    in property <bool> has-laser: false;
    in property <float> laser-x: 0;
    in property <float> laser-y: 0;

    callback next-slide();
    callback previous-slide();
    callback toggle-timer();
    callback reset-timer();
    callback close-presenter();
    callback select-tool(int);
    callback clear-annotations();
    callback jump-digit(string);
    callback commit-jump();
    callback stroke-begin(float, float);
    callback stroke-move(float, float);

    init => { Theme.application = "present"; keys.focus(); root.roomy = self.height >= 560px; }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.close-presenter(); }
            else if (event.text >= "0" && event.text <= "9") { root.jump-digit(event.text); }
            else if (event.text == Key.Return && root.jump-buffer != "") { root.commit-jump(); }
            else if (event.text == Key.RightArrow || event.text == Key.DownArrow || event.text == Key.PageDown || event.text == " " || event.text == Key.Return) { root.next-slide(); }
            else if (event.text == Key.LeftArrow || event.text == Key.UpArrow || event.text == Key.PageUp || event.text == Key.Backspace) { root.previous-slide(); }
            return accept;
        }

        VerticalLayout {
            padding: Theme.tokens.space.xl;
            spacing: Theme.tokens.space.lg;

            HorizontalLayout {
                spacing: Theme.tokens.space.md;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: root.position-text;
                        font-size: Theme.type.caption;
                        font-weight: 600;
                        color: Theme.palette().ink-secondary;
                        accessible-role: AccessibleRole.text;
                    }
                    Text {
                        text: root.slide-title;
                        font-family: Theme.document-font-family;
                        font-size: Theme.type.heading;
                        font-weight: 700;
                        color: Theme.palette().ink;
                        overflow: elide;
                        accessible-role: AccessibleRole.text;
                        accessible-label: "Current slide: " + root.slide-title;
                    }
                }
                Text {
                    text: root.elapsed;
                    font-size: Theme.type.heading;
                    font-weight: 600;
                    color: root.timer-running ? Theme.palette().ink : Theme.palette().ink-secondary;
                    vertical-alignment: center;
                    accessible-role: AccessibleRole.text;
                    accessible-label: "Elapsed time " + root.elapsed + (root.timer-running ? "" : ", paused");
                }
                LoomButton {
                    label: root.timer-running ? "Pause" : "Resume";
                    clicked => { root.toggle-timer(); }
                }
                LoomButton {
                    label: "Reset";
                    clicked => { root.reset-timer(); }
                }
            }

            HorizontalLayout {
                spacing: Theme.tokens.space.lg;
                vertical-stretch: 1;

                Rectangle {
                    horizontal-stretch: 3;
                    background: Theme.palette().surface;
                    border-radius: Theme.tokens.metrics.radius-medium;
                    border-width: 1px;
                    border-color: Theme.palette().border;
                    clip: true;
                    VerticalLayout {
                        padding: Theme.tokens.space.lg;
                        spacing: Theme.tokens.space.sm;
                        Text {
                            text: "Notes";
                            font-size: Theme.type.caption;
                            font-weight: 600;
                            color: Theme.palette().ink-secondary;
                        }
                        Text {
                            text: root.notes == "" ? "No notes for this slide." : root.notes;
                            font-size: root.notes-font-size;
                            font-family: Theme.document-font-family;
                            wrap: word-wrap;
                            color: root.notes == "" ? Theme.palette().ink-secondary : Theme.palette().ink;
                            vertical-stretch: 1;
                            accessible-role: AccessibleRole.text;
                            accessible-label: "Speaker notes: " + (root.notes == "" ? "none" : root.notes);
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: 2;
                    background: Theme.palette().surface;
                    border-radius: Theme.tokens.metrics.radius-medium;
                    border-width: 1px;
                    border-color: Theme.palette().border;
                    VerticalLayout {
                        padding: Theme.tokens.space.lg;
                        spacing: Theme.tokens.space.sm;
                        // The slide on screen is the primary preview: first, and as wide as the panel.
                        Text {
                            text: "Current";
                            font-size: Theme.type.caption;
                            font-weight: 600;
                            color: Theme.palette().ink-secondary;
                        }
                        Rectangle {
                            MiniSlide {
                                width: parent.width;
                                rows: root.current-rows;
                                description: "Current slide: " + root.slide-title;
                            }
                            for dot in root.stroke-dots : Rectangle {
                                x: dot.x * parent.width - dot.size / 2;
                                y: dot.y * parent.height - dot.size / 2;
                                width: dot.size;
                                height: dot.size;
                                border-radius: dot.size / 2;
                                background: dot.color;
                            }
                            if root.has-laser : Rectangle {
                                x: root.laser-x * parent.width - 4px;
                                y: root.laser-y * parent.height - 4px;
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: Theme.palette().danger;
                            }
                            TouchArea {
                                pointer-event(ev) => {
                                    if (ev.kind == PointerEventKind.down && ev.button == PointerEventButton.left) {
                                        root.stroke-begin(self.mouse-x / max(1px, self.width), self.mouse-y / max(1px, self.height));
                                    }
                                }
                                moved => {
                                    if (self.pressed) {
                                        root.stroke-move(self.mouse-x / max(1px, self.width), self.mouse-y / max(1px, self.height));
                                    }
                                }
                            }
                        }
                        Text {
                            text: "Next";
                            font-size: Theme.type.caption;
                            font-weight: 600;
                            color: Theme.palette().ink-secondary;
                        }
                        // The next slide is a smaller preview; short windows leave it out.
                        if root.has-next && root.roomy : HorizontalLayout {
                            MiniSlide {
                                horizontal-stretch: 3;
                                rows: root.next-rows;
                                description: "Next slide: " + root.next-title;
                            }
                            Rectangle { horizontal-stretch: 2; }
                        }
                        if !root.has-next : Rectangle {
                            height: 64px;
                            background: Theme.palette().canvas;
                            border-radius: Theme.tokens.metrics.radius-small;
                            Text {
                                text: "End of slideshow";
                                font-size: Theme.type.body-large;
                                color: Theme.palette().ink-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                accessible-role: AccessibleRole.text;
                                accessible-label: "No next slide";
                            }
                        }
                        Text {
                            visible: root.has-next;
                            text: root.next-title;
                            font-family: Theme.document-font-family;
                            wrap: word-wrap;
                            font-size: Theme.type.body-large;
                            font-weight: 600;
                            color: Theme.palette().ink;
                            accessible-role: AccessibleRole.text;
                            accessible-label: root.has-next ? "Next slide: " + root.next-title : "No next slide";
                        }
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }

            PresenterToolBar {
                active-tool: root.active-tool;
                jump-buffer: root.jump-buffer;
                select-tool(t) => { root.active-tool = t; root.select-tool(t); }
                clear-annotations => { root.clear-annotations(); }
            }

            HorizontalLayout {
                spacing: Theme.tokens.space.md;
                LoomButton {
                    label: "Previous";
                    enabled: root.has-previous;
                    clicked => { root.previous-slide(); }
                }
                LoomButton {
                    label: "Next";
                    variant: "primary";
                    enabled: root.has-next;
                    clicked => { root.next-slide(); }
                }
                Rectangle { horizontal-stretch: 1; }
                LoomButton {
                    label: "Close";
                    clicked => { root.close-presenter(); }
                }
            }
        }
    }
}
