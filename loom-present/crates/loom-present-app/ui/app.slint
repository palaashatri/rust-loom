import { CommandPalette, CommandPaletteItem } from "components.slint";
import { Theme, ResponsivePolicy } from "theme.slint";
import {
    PresentSlideStrip, PresentSlideCanvas, PresentNotesEditor, ThumbRows,
    PresentStatusBar, PresentToolbarOverflow
} from "present_components.slint";
import { PresentActionToolbar, PresentToolbarMenu } from "toolbar.slint";
import { PresentInspector } from "inspector.slint";
import { PresentModals, WelcomeGuideState, StartHubState, PrintPreviewState, FindReplaceState } from "present_modals.slint";
import { PresentShortcutScope } from "shortcut_scope.slint";
import {
    LoomButton, LoomIconButton, LoomTitleBar, LoomWindowResizeEdges,
    LocalMenu, LocalMenuBar, LocalMenuLabels, LocalMenuEntry, LocalMenuPopup,
} from "foundation.slint";
import { RecoveryFailureNotice } from "recovery_failure_notice.slint";

export { Theme, ResponsivePolicy } from "theme.slint";
export { LocalMenu, LocalMenuEntry } from "foundation.slint";
export { WelcomeGuideState, StartHubState, PrintPreviewState, FindReplaceState }
export { FontPicker, FontPickerLine } from "font_picker.slint";
export { PresenterWindow, ThumbRows, ObjectPart, ObjectParts, ElementInk } from "presenter.slint";

export component PresentApp inherits Window {
    icon: @image-url("../../../../loom-core/crates/loom-ui/ui/app-icons/loom-present.png");
    in property <string> os-window-title: "Loom Present";
    title: root.os-window-title;
    default-font-family: Theme.ui-font-family;
    in property <bool> custom-chrome: false;
    no-frame: root.custom-chrome;
    callback window-drag;
    callback window-close;
    callback window-resize(int);
    in property <bool> local-menu-visible: true;
    in property <[string]> local-menu-labels: ["File", "Edit", "View", "Insert", "Slide"];
    in property <[LocalMenuEntry]> local-menu-items: [];
    in property <[LocalMenuEntry]> local-menu-popup-items: [];
    in-out property <int> local-menu-open-index: -1;
    in-out property <int> local-menu-selected-index: -1;
    in-out property <int> local-menu-popup-selected-index: -1;
    callback local-menu-opened(int);
    callback local-menu-move(int);
    callback local-menu-action(string);
    min-width: 1024px;
    min-height: 720px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: root.is-preview-mode ? Colors.black : Theme.palette().canvas;

    // User-requested state survives widths where the inspector is unavailable.
    in-out property <bool> show-inspector: false;
    in property <bool> inspector-available: true;
    // The user's request is the effective state at every width: a compact
    // window docks the inspector instead of silently discarding the request.
    out property <bool> inspector-visible: root.show-inspector;
    in-out property <bool> show-navigator: true;
    in-out property <bool> view-menu-open: false;
    in-out property <bool> zoom-menu-open: false;
    in-out property <int> zoom-index: 0;
    property <length> menu-x: 0px;
    property <float> zoom-factor: root.zoom-index == 1 ? 0.75 : root.zoom-index == 2 ? 0.5 : 1.0;
    callback view-state-changed;
    changed show-inspector => { root.view-state-changed(); }
    changed show-navigator => { root.view-state-changed(); }
    changed show-notes-drawer => { root.view-state-changed(); }
    public function show-inspector-tab(tab: int) {
        if (root.inspector-visible && root.inspector-tab == tab) {
            root.show-inspector = false;
        } else {
            root.inspector-tab = tab;
            root.show-inspector = true;
        }
    }
    property <int> focus-view-tick: 0;
    in-out property <int> inspector-focus-tick: 0;
    in-out property <int> strip-focus-tick: 0;
    property <int> focus-zoom-tick: 0;
    /// Escape in the View or Zoom menu: close it and focus the item that opened it.
    function dismiss-view-menus() {
        let was-zoom = root.zoom-menu-open;
        root.view-menu-open = false;
        root.zoom-menu-open = false;
        if (was-zoom) { root.focus-zoom-tick += 1; } else { root.focus-view-tick += 1; }
    }
    function close-view-menus() {
        root.view-menu-open = false;
        root.zoom-menu-open = false;
        root.focus-editor();
    }
    in property <bool> icon-only-toolbar: false;
    in property <bool> labeled-toolbar: false;
    in property <bool> labeled-export: false;
    in property <bool> overflow-toolbar: false;
    in property <bool> rtl: false;
    in-out property <bool> toolbar-overflow-open: false;
    callback window-resized(length);
    changed rtl => {
        Theme.rtl = root.rtl;
    }
    changed width => {
        root.window-resized(root.width);
        if (!ResponsivePolicy.priority-2-overflow(root.width)) {
            root.close-toolbar-overflow();
        }
    }

    in property <string> deck-title: "Untitled Deck";
    in property <bool> deck-dirty: false;
    in property <string> slide-title: "Slide Title";
    in property <string> slide-body: "";
    in property <string> slide-count-text: "1 slide";
    in property <[string]> slide-titles: [];
    in property <[ThumbRows]> slide-thumbs: [];
    /// First slide and slide count the strip draws; set by the controller.
    in-out property <int> strip-first: 0;
    in-out property <int> strip-count: 24;
    in property <int> active-slide-index: 0;
    in property <bool> can-move-slide-up: false;
    in property <bool> can-move-slide-down: false;
    in-out property <string> slide-announcement: "";
    in property <[string]> element-labels: [];
    in property <[string]> element-placeholders: [];
    in property <int> active-element-index: 0;
    in property <string> active-element-label: "No element selected";
    in property <string> active-element-content: "";
    in property <bool> active-element-content-editable: true;
    in property <[string]> element-contents: [];
    in property <[float]> element-xs: [];
    in property <[float]> element-ys: [];
    in property <[float]> element-widths: [];
    in property <[float]> element-heights: [];
    in property <[float]> element-rotations: [];
    in property <[int]> element-types: [];
    in property <[image]> element-images: [];
    in property <[bool]> element-selected: [];
    in property <int> selection-count: 0;
    in property <[float]> snap-guides-x: [];
    in property <[float]> snap-guides-y: [];
    in property <float> marquee-x: 0;
    in property <float> marquee-y: 0;
    in property <float> marquee-width: 0;
    in property <float> marquee-height: 0;
    in property <bool> marquee-visible: false;
    in property <float> element-x: 100;
    in property <float> element-y: 100;
    in property <float> element-width: 400;
    in property <float> element-height: 100;
    in property <string> element-x-text: "100";
    in property <string> element-y-text: "100";
    in property <string> element-width-text: "400";
    in property <string> element-height-text: "100";
    in property <string> element-rotation-text: "0°";
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in property <string> status-left: "Ready";
    in property <string> status-right: "Offline";
    in property <string> recovery-failure-message: "";
    in-out property <bool> save-changes-open: false;
    in-out property <string> save-changes-document: "";
    in-out property <bool> save-changes-closing: false;

    in-out property <string> slide-notes: "";
    in-out property <bool> show-notes-drawer: false;
    in-out property <bool> is-preview-mode: false;
    full-screen: root.is-preview-mode;
    changed is-preview-mode => {
        root.focus-editor();
        if !root.is-preview-mode {
            root.reveal = 1.0;
        }
    }
    public function focus-editor() {
        if (root.is-preview-mode) {
            app-focus.focus();
        } else {
            slide-canvas.focus-slide();
        }
    }

    /// A new active slide takes keyboard focus, unless a menu or dialog has it.
    public function focus-slide-after-change() {
        if (!root.palette-open && !root.theme-chooser-open && !root.save-changes-open && !root.view-menu-open && !root.zoom-menu-open && !root.toolbar-overflow-open && root.local-menu-open-index < 0) {
            root.focus-editor();
        }
    }
    /// F6 walks the regions (slide, toolbar, inspector, strip); Shift+F6 walks back.
    public function cycle-region(start: int, backwards: bool) {
        let inspector = root.inspector-visible && !root.is-preview-mode;
        let strip = root.show-navigator && !root.is-preview-mode;
        let target = start == 0 ? (backwards ? (strip ? 3 : (inspector ? 2 : 1)) : 1)
            : start == 1 ? (backwards ? 0 : (inspector ? 2 : (strip ? 3 : 0)))
            : start == 2 ? (backwards ? 1 : (strip ? 3 : 0))
            : (backwards ? (inspector ? 2 : 1) : 0);
        if (target == 0) { root.focus-editor(); }
        else if (target == 1) { root.focus-view-tick += 1; }
        else if (target == 2) { root.inspector-focus-tick += 1; }
        else { root.strip-focus-tick += 1; }
    }

    init => { Theme.application = "present"; root.focus-editor(); }

    changed palette-open => {
        if (!root.palette-open) { root.focus-editor(); }
    }

    in-out property <float> reveal: 1.0;
    out property <float> transition-progress: root.reveal;
    property <float> reveal-eased: 1.0 - (1.0 - root.reveal) * (1.0 - root.reveal);
    changed active-slide-index => {
        if root.is-preview-mode && (root.transition-index == 1 || root.transition-index == 2) {
            root.reveal = 0.0;
        }
    }
    Timer {
        interval: 16ms;
        running: root.reveal < 1.0;
        triggered => { root.reveal = min(1.0, root.reveal + 0.036); }
    }
    in-out property <int> active-template-index: 1;
    in-out property <int> inspector-tab: 0;
    in-out property <int> transition-index: 0;
    in-out property <float> zoom-value: 78;

    in-out property <bool> theme-chooser-open: false;
    in-out property <int> theme-selected: 0;
    in-out property <int> theme-category: 0;
    in-out property <bool> aspect-ratio-wide: true;

    callback new-deck;
    /// A key the window did not use. Rust explains a typed letter instead of dropping it.
    callback window-key-unhandled(string);
    callback dispatch-shortcut(string, bool, bool, bool) -> bool;
    callback open-deck;
    callback save-deck;
    callback save-as-deck;
    callback save-changes-save;
    callback save-changes-discard;
    callback save-changes-cancel;
    callback export-pdf;
    callback export-pptx;
    callback undo;
    callback redo;
    callback copy;
    callback cut;
    callback paste;
    callback add-slide;
    callback delete-slide;
    /// The slide strip visible window.
    callback strip-window-changed(int, int);
    /// A deferred recovery draft is due.
    callback recovery-flush();
    callback recovery-retry();
    callback duplicate-slide;
    callback move-slide-up;
    callback move-slide-down;
    /// Slide `from` was dragged (or keyboard-moved) to position `to`.
    callback reorder-slide(int, int);
    callback prev-slide;
    callback next-slide;
    callback select-slide(int);
    callback add-text;
    callback add-shape;
    callback add-shape-kind(string);
    callback add-picture;
    callback duplicate-selection;
    callback select-all-elements;
    callback open-print-preview;
    callback add-table;
    callback insert-table-size(int, int);
    in-out property <bool> insert-table-dialog-open: false;
    in-out property <int> insert-table-dialog-rows: 3;
    in-out property <int> insert-table-dialog-cols: 3;
    callback add-chart;
    in-out property <bool> pptx-import-warning-open: false;
    in-out property <string> pptx-import-warning-message: "";
    callback pptx-import-continue;
    callback pptx-import-cancel;
    in property <bool> inspector-is-table: false;
    in-out property <string> inspector-table-style-id: "table-style-medium-1";
    in-out property <bool> inspector-table-header-row: true;
    in-out property <bool> inspector-table-banded-rows: true;
    in-out property <bool> inspector-table-first-column: false;
    callback set-table-style(string);
    callback toggle-table-option(string);
    callback table-action(string);
    callback new-sample-deck;
    callback select-element(int);
    callback transform-element(string, float, float, float, float);
    callback set-element-rotation(string, float);
    callback update-element-content(string);
    callback end-table-cell-edit;
    callback apply-template(int);
    callback set-transition(int);
    callback create-theme(int);
    callback cancel-theme;
    callback choose-theme-category(int);
    callback toggle-inspector;
    callback toggle-preview-mode;
    callback open-presenter;
    /// Alt+letter or F10 opens the in-window menu named by that key.
    function open-menu-for-key(event: KeyEvent) -> bool {
        let target = LocalMenu.target(event);
        if (!root.local-menu-visible || root.is-preview-mode || target < 0) { return false; }
        root.local-menu-open-index = target;
        return true;
    }
    public function close-toolbar-overflow() {
        root.toolbar-overflow-open = false;
    }
    public function open-palette() {
        root.palette-open = true;
        root.palette-query = "";
        palette.grab-focus();
    }
    callback notes-edited(string);
    callback canvas-pressed(float, float, bool);
    callback canvas-moved(float, float);
    callback canvas-released(float, float);
    callback canvas-cancelled;
    callback canvas-key-pressed(string, bool, bool) -> EventResult;
    callback element-pressed(int, bool);
    callback element-moved(int, float, float);
    callback element-released(int);
    callback element-cancelled(int);
    callback handle-pressed(int, string, bool);
    callback handle-moved(int, string, float, float);
    callback handle-released(int, string);
    callback handle-cancelled(int, string);

    in-out property <bool> palette-open: false;
    in-out property <[CommandPaletteItem]> palette-commands: [];
    in-out property <string> palette-query: "";
    in-out property <int> palette-selected: 0;
    callback palette-invoked(int);
    callback palette-query-changed(string);
    callback palette-close;
    callback palette-move(int);
    callback palette-key-text(string);
    callback palette-backspace;

    function close-overflow-menu() {
        root.toolbar-overflow-open = false;
        root.focus-editor();
    }

    property <int> theme-refocus-tick: 0;
    property <length> menu-top: (root.custom-chrome || (root.local-menu-visible && !root.is-preview-mode) ? 36px : 0px) + Theme.tokens.metrics.labeled-toolbar-max-height + ResponsivePolicy.toolbar-label-extra;
    changed theme-chooser-open => {
        if (!root.theme-chooser-open) { root.focus-editor(); }
    }

    app-focus := PresentShortcutScope {
        modal-blocking: root.palette-open || root.theme-chooser-open || root.toolbar-overflow-open || root.view-menu-open || root.zoom-menu-open || WelcomeGuideState.open || StartHubState.open || PrintPreviewState.open || FindReplaceState.open || root.insert-table-dialog-open || root.pptx-import-warning-open || root.save-changes-open;
        is-preview-mode: root.is-preview-mode;
        selection-count: slide-canvas.selection-count;
        open-menu-for-key(event) => { root.open-menu-for-key(event) }
        dispatch-shortcut(key, shift, primary, alt) => { root.dispatch-shortcut(key, shift, primary, alt) }
        toggle-preview-mode => { root.toggle-preview-mode(); }
        open-presenter => { root.open-presenter(); }
        next-slide => { root.next-slide(); }
        prev-slide => { root.prev-slide(); }
        focus-editor => { root.focus-editor(); }
        cycle-region(dir, shift) => { root.cycle-region(dir, shift); }
        start-editing => { slide-canvas.start-editing() }
        window-key-unhandled(text) => { root.window-key-unhandled(text); }

        VerticalLayout {
            spacing: 0px;
            padding: 0px;

            if root.custom-chrome && !root.is-preview-mode : LoomTitleBar {
                title: root.deck-title + (root.deck-dirty ? " \u{2022}" : "");
                maximized: root.maximized;
                drag-requested => { root.window-drag(); }
                toggle-maximize => { root.maximized = !root.maximized; }
                minimize => { root.minimized = true; }
                close => { root.window-close(); }
                LocalMenuLabels {
                    labels: root.local-menu-labels;
                    open-index <=> root.local-menu-open-index;
                }
            }
            if root.local-menu-visible && !root.custom-chrome && !root.is-preview-mode : LocalMenuBar {
                labels: root.local-menu-labels;
                open-index <=> root.local-menu-open-index;
            }

            if !root.is-preview-mode : action-toolbar := PresentActionToolbar {
                focus-view-tick: root.focus-view-tick;
                focus-zoom-tick: root.focus-zoom-tick;
                overflow: root.overflow-toolbar;
                compact: root.icon-only-toolbar;
                inspector-visible: root.inspector-visible;
                inspector-tab: root.inspector-tab;
                view-menu-open: root.view-menu-open;
                zoom-menu-open: root.zoom-menu-open;
                is-preview-mode: root.is-preview-mode;
                toggle-view-menu(anchor) => {
                    root.zoom-menu-open = false;
                    root.menu-x = anchor;
                    root.view-menu-open = !root.view-menu-open;
                    if (!root.view-menu-open) { root.focus-editor(); }
                }
                toggle-zoom-menu(anchor) => {
                    root.view-menu-open = false;
                    root.menu-x = anchor;
                    root.zoom-menu-open = !root.zoom-menu-open;
                    if (!root.zoom-menu-open) { root.focus-editor(); }
                }
                add-slide => { root.add-slide(); }
                add-text => { root.add-text(); }
                add-shape => { root.add-shape(); }
                add-picture => { root.add-picture(); }
                add-table => { root.add-table(); }
                add-chart => { root.add-chart(); }
                toggle-preview => { root.toggle-preview-mode(); }
                show-inspector-tab(tab) => { root.show-inspector-tab(tab); }
                overflow-requested => {
                    if (root.toolbar-overflow-open) {
                        root.close-toolbar-overflow();
                    } else {
                        root.toolbar-overflow-open = true;
                    }
                }
            }

            HorizontalLayout {
                spacing: 0px;
                vertical-stretch: 1;

                if root.rtl && root.inspector-visible && !root.is-preview-mode : inspector-rtl := PresentInspector {
                    inspector-tab <=> root.inspector-tab;
                    compact: !root.inspector-available;
                    active-template-index <=> root.active-template-index;
                    transition-index <=> root.transition-index;
                    slide-count-text: root.slide-count-text;
                    aspect-ratio-wide: root.aspect-ratio-wide;
                    active-element-label: root.active-element-label;
                    active-element-content: root.active-element-content;
                    content-editable: root.active-element-content-editable;
                    active-element-index: root.active-element-index;
                    element-count: root.element-labels.length;
                    selection-count: root.selection-count;
                    element-x-text: root.element-x-text;
                    element-y-text: root.element-y-text;
                    element-width-text: root.element-width-text;
                    element-height-text: root.element-height-text;
                    element-rotation-text: root.element-rotation-text;
                    is-table: root.inspector-is-table;
                    table-style-id <=> root.inspector-table-style-id;
                    table-header-row <=> root.inspector-table-header-row;
                    table-banded-rows <=> root.inspector-table-banded-rows;
                    table-first-column <=> root.inspector-table-first-column;
                    set-table-style(s) => { root.set-table-style(s); }
                    toggle-table-option(o) => { root.toggle-table-option(o); }
                    table-action(a) => { root.table-action(a); }
                    apply-template(idx) => { root.apply-template(idx); }
                    update-element-content(value) => { root.update-element-content(value); }
                    set-transition(idx) => { root.set-transition(idx); }
                    open-theme-chooser => { root.theme-selected = 0; root.theme-category = 0; root.theme-chooser-open = true; }
                    region-key(backwards) => { root.cycle-region(2, backwards); }
                    focus-request: root.inspector-focus-tick;
                }

                if !root.rtl && !root.is-preview-mode && root.show-navigator : strip-ltr := PresentSlideStrip {
                    titles: root.slide-titles;
                    thumbs: root.slide-thumbs;
                    active-index: root.active-slide-index;
                    can-move-up: root.can-move-slide-up;
                    can-move-down: root.can-move-slide-down;
                    announcement <=> root.slide-announcement;
                    select-slide(idx) => { root.select-slide(idx); }
                    add-slide => { root.add-slide(); }
                    delete-slide => { root.delete-slide(); }
                    move-slide-up => { root.move-slide-up(); }
                    move-slide-down => { root.move-slide-down(); }
                    reorder-slide(from, to) => { root.reorder-slide(from, to); }
                    drag-finished => { root.focus-editor(); }
                    window-changed(first, count) => { root.strip-window-changed(first, count); }
                    region-key(backwards) => { root.cycle-region(3, backwards); }
                    focus-active-tick: root.strip-focus-tick;
                }

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 0px;

                    Rectangle {
                      vertical-stretch: 1;
                      horizontal-stretch: 1;
                      clip: true;
                    slide-canvas := PresentSlideCanvas {
                        x: root.is-preview-mode && root.transition-index == 2 ? (1.0 - root.reveal-eased) * parent.width : 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        opacity: root.is-preview-mode && root.transition-index == 1 ? root.reveal-eased : 1.0;
                        editing-enabled: !root.is-preview-mode;
                        fit-screen: root.is-preview-mode;
                        zoom: root.zoom-factor;
                        background: root.is-preview-mode ? Colors.black : Theme.palette().canvas;
                        aspect-ratio-wide: root.aspect-ratio-wide;
                        element-labels: root.element-labels; element-placeholders: root.element-placeholders; element-contents: root.element-contents;
                        element-xs: root.element-xs; element-ys: root.element-ys; element-widths: root.element-widths; element-heights: root.element-heights;
                        element-rotations: root.element-rotations; element-types: root.element-types; element-images: root.element-images;
                        element-selected: root.element-selected; selection-count: root.selection-count;
                        snap-guides-x: root.snap-guides-x; snap-guides-y: root.snap-guides-y;
                        marquee-x: root.marquee-x; marquee-y: root.marquee-y; marquee-width: root.marquee-width; marquee-height: root.marquee-height; marquee-visible: root.marquee-visible;
                        active-element-index: root.active-element-index;
                        select-element(idx) => { root.select-element(idx); }
                        canvas-pressed(x, y, shift) => { root.canvas-pressed(x, y, shift); }
                        canvas-moved(x, y) => { root.canvas-moved(x, y); }
                        canvas-released(x, y) => { root.canvas-released(x, y); }
                        canvas-cancelled => { root.canvas-cancelled(); }
                        canvas-key-pressed(k, shift, modified) => { return root.canvas-key-pressed(k, shift, modified); }
                        element-pressed(idx, shift) => { root.element-pressed(idx, shift); }
                        element-moved(idx, dx, dy) => { root.element-moved(idx, dx, dy); }
                        element-released(idx) => { root.element-released(idx); }
                        element-cancelled(idx) => { root.element-cancelled(idx); }
                        handle-pressed(idx, kind, shift) => { root.handle-pressed(idx, kind, shift); }
                        handle-moved(idx, kind, dx, dy) => { root.handle-moved(idx, kind, dx, dy); }
                        handle-released(idx, kind) => { root.handle-released(idx, kind); }
                        handle-cancelled(idx, kind) => { root.handle-cancelled(idx, kind); }
                        content-edited(text) => { root.update-element-content(text); }
                        table-text-edit-ended => { root.end-table-cell-edit(); }
                        region-key(backwards) => { root.cycle-region(0, backwards); }
                    }
                    }

                    if root.show-notes-drawer && !root.is-preview-mode : Rectangle {
                        height: 110px + 70px * (max(1.0, Theme.text-scale) - 1.0);
                        background: Theme.palette().chrome;

                        Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.palette().border; }

                        VerticalLayout {
                            padding-top: 8px; padding-bottom: 8px; padding-left: 16px; padding-right: 16px;
                            spacing: 4px;

                            if !root.rtl : HorizontalLayout {
                                Text {
                                    text: "Speaker Notes";
                                    font-size: Theme.type.caption;
                                    font-weight: 600;
                                    color: Theme.palette().ink;
                                    horizontal-stretch: 1;
                                }
                                LoomIconButton {
                                    icon: "close";
                                    label: "Close speaker notes";
                                    tooltip: "Close speaker notes";
                                    clicked => { root.show-notes-drawer = false; root.focus-editor(); }
                                }
                            }
                            if root.rtl : HorizontalLayout {
                                LoomIconButton {
                                    icon: "close";
                                    label: "Close speaker notes";
                                    tooltip: "Close speaker notes";
                                    clicked => { root.show-notes-drawer = false; root.focus-editor(); }
                                }
                                Text {
                                    text: "Speaker Notes";
                                    font-size: Theme.type.caption;
                                    font-weight: 600;
                                    color: Theme.palette().ink;
                                    horizontal-stretch: 1;
                                    horizontal-alignment: right;
                                }
                            }

                            PresentNotesEditor {
                                text <=> root.slide-notes;
                                placeholder-text: "Add presenter notes for this slide...";
                                edited(t) => { root.notes-edited(t); }
                            }
                        }
                    }
                }

                if root.rtl && !root.is-preview-mode && root.show-navigator : strip-rtl := PresentSlideStrip {
                    titles: root.slide-titles;
                    thumbs: root.slide-thumbs;
                    active-index: root.active-slide-index;
                    can-move-up: root.can-move-slide-up;
                    can-move-down: root.can-move-slide-down;
                    announcement <=> root.slide-announcement;
                    select-slide(idx) => { root.select-slide(idx); }
                    add-slide => { root.add-slide(); }
                    delete-slide => { root.delete-slide(); }
                    move-slide-up => { root.move-slide-up(); }
                    move-slide-down => { root.move-slide-down(); }
                    reorder-slide(from, to) => { root.reorder-slide(from, to); }
                    drag-finished => { root.focus-editor(); }
                    window-changed(first, count) => { root.strip-window-changed(first, count); }
                    region-key(backwards) => { root.cycle-region(3, backwards); }
                    focus-active-tick: root.strip-focus-tick;
                }

                if !root.rtl && root.inspector-visible && !root.is-preview-mode : inspector-ltr := PresentInspector {
                    inspector-tab <=> root.inspector-tab;
                    compact: !root.inspector-available;
                    active-template-index <=> root.active-template-index;
                    transition-index <=> root.transition-index;
                    slide-count-text: root.slide-count-text;
                    aspect-ratio-wide: root.aspect-ratio-wide;
                    active-element-label: root.active-element-label;
                    active-element-content: root.active-element-content;
                    content-editable: root.active-element-content-editable;
                    active-element-index: root.active-element-index;
                    element-count: root.element-labels.length;
                    selection-count: root.selection-count;
                    element-x-text: root.element-x-text;
                    element-y-text: root.element-y-text;
                    element-width-text: root.element-width-text;
                    element-height-text: root.element-height-text;
                    element-rotation-text: root.element-rotation-text;
                    is-table: root.inspector-is-table;
                    table-style-id <=> root.inspector-table-style-id; table-header-row <=> root.inspector-table-header-row;
                    table-banded-rows <=> root.inspector-table-banded-rows; table-first-column <=> root.inspector-table-first-column;
                    set-table-style(s) => { root.set-table-style(s); } toggle-table-option(o) => { root.toggle-table-option(o); }
                    table-action(a) => { root.table-action(a); } apply-template(idx) => { root.apply-template(idx); }
                    update-element-content(value) => { root.update-element-content(value); }
                    set-transition(idx) => { root.set-transition(idx); }
                    open-theme-chooser => { root.theme-selected = 0; root.theme-category = 0; root.theme-chooser-open = true; }
                    region-key(backwards) => { root.cycle-region(2, backwards); }
                    focus-request: root.inspector-focus-tick;
                }
            }

            if !root.is-preview-mode && root.recovery-failure-message != "" : RecoveryFailureNotice {
                failure-message: root.recovery-failure-message;
                retry => { root.recovery-retry(); }
                save-as => { root.save-as-deck(); }
            }

            if !root.is-preview-mode : PresentStatusBar {
                leading-text: root.status-left;
                trailing-text: root.status-right;
            }
        }
    }

    if root.toolbar-overflow-open && root.overflow-toolbar : Rectangle {
        width: root.width;
        height: root.height;
        background: transparent;
        TouchArea { clicked => { root.close-toolbar-overflow(); } }
        VerticalLayout {
            padding-top: root.menu-top + Theme.tokens.space.sm;
            padding-left: Theme.tokens.space.lg;
            padding-right: Theme.tokens.space.lg;
            cross-axis-alignment: root.rtl ? start : end;
            PresentToolbarOverflow {
                can-undo: root.can-undo;
                can-redo: root.can-redo;
                undo => { root.undo(); }
                redo => { root.redo(); }
                open-theme-chooser => { root.theme-selected = 0; root.theme-category = 0; root.theme-chooser-open = true; }
                export-pdf => { root.export-pdf(); }
                export-pptx => { root.export-pptx(); }
                close-requested => { root.close-overflow-menu(); }
            }
        }
    }

    if (root.view-menu-open || root.zoom-menu-open) && !root.is-preview-mode : Rectangle {
        width: root.width;
        height: root.height;
        background: transparent;
        TouchArea { clicked => { root.close-view-menus(); } }
        PresentToolbarMenu {
            kind: root.zoom-menu-open ? 1 : 0;
            x: root.rtl
                ? max(8px, min(root.menu-x - self.width, root.width - self.width - 8px))
                : max(0px, min(root.menu-x, root.width - self.width - 8px));
            y: root.menu-top;
            navigator-visible: root.show-navigator;
            notes-visible: root.show-notes-drawer;
            zoom-index: root.zoom-index;
            toggle-navigator => { root.show-navigator = !root.show-navigator; }
            toggle-notes => { root.show-notes-drawer = !root.show-notes-drawer; }
            open-welcome-guide => { root.local-menu-action("help.welcome_guide"); }
            choose-zoom(idx) => { root.zoom-index = idx; }
            choose-appearance(id) => { root.local-menu-action(id); }
            close-requested => { root.close-view-menus(); }
            dismissed => { root.dismiss-view-menus(); }
        }
    }

    PresentModals {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        theme-chooser-open <=> root.theme-chooser-open;
        theme-refocus-tick: root.theme-refocus-tick;
        theme-selected <=> root.theme-selected;
        theme-category <=> root.theme-category;
        choose-theme-category(cat) => { root.choose-theme-category(cat); }
        cancel-theme => { root.cancel-theme(); }
        create-theme(idx) => { root.create-theme(idx); }
        save-changes-open: root.save-changes-open;
        save-changes-document: root.save-changes-document;
        save-changes-closing: root.save-changes-closing;
        rtl: root.rtl;
        save-changes-save => { root.save-changes-save(); }
        save-changes-discard => { root.save-changes-discard(); }
        save-changes-cancel => { root.save-changes-cancel(); }
        pptx-import-warning-open: root.pptx-import-warning-open;
        pptx-import-warning-message: root.pptx-import-warning-message;
        pptx-import-cancel => { root.pptx-import-cancel(); }
        pptx-import-continue => { root.pptx-import-continue(); }
        insert-table-dialog-open <=> root.insert-table-dialog-open;
        insert-table-dialog-rows <=> root.insert-table-dialog-rows;
        insert-table-dialog-cols <=> root.insert-table-dialog-cols;
        insert-table-size(r, c) => { root.insert-table-size(r, c); }
    }

    menu-keys := FocusScope {
        x: 0px;
        y: 36px;
        width: root.width;
        height: root.height - 36px;
        focus-on-click: false;
        focus-on-tab-navigation: false;
        capture-key-pressed(event) => {
            if (root.local-menu-open-index < 0) { return reject; }
            if (event.text == Key.Escape || event.text == Key.F10 || event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.LeftArrow || event.text == Key.RightArrow || event.text == Key.Return || event.text == Key.Space || LocalMenu.target(event) >= 0) { return reject; }
            root.local-menu-open-index = -1;
            root.focus-editor();
            if (!event.modifiers.control && !event.modifiers.meta) { root.window-key-unhandled(event.text); }
            return accept;
        }

        LocalMenuPopup {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            menu-enabled: root.local-menu-visible && !root.is-preview-mode;
            labels: root.local-menu-labels;
            items: root.local-menu-popup-items;
            open-index <=> root.local-menu-open-index;
            selected-index: root.local-menu-popup-selected-index;
            menu-opened(index) => { root.local-menu-opened(index); }
            menu-move(direction) => { root.local-menu-move(direction); }
            menu-closed => { root.focus-editor(); }
            menu-action(id) => { root.local-menu-action(id); }
        }
    }

    palette := CommandPalette {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        open: root.palette-open;
        commands: root.palette-commands;
        query: root.palette-query;
        selected: root.palette-selected;
        command-invoked(idx) => { root.palette-invoked(idx); }
        query-changed(q) => { root.palette-query = q; root.palette-query-changed(q); }
        move-selection(delta) => { root.palette-move(delta); }
        key-text(text) => { root.palette-key-text(text); }
        backspace => { root.palette-backspace(); }
        close-requested => { root.palette-open = false; root.palette-close(); }
    }



    changed pptx-import-warning-open => { if (!root.pptx-import-warning-open) { root.focus-editor(); } }
    changed save-changes-open => {
        if (!root.save-changes-open) {
            if (root.theme-chooser-open) { root.theme-refocus-tick += 1; } else { root.focus-editor(); }
        }
    }

    if root.is-preview-mode : TouchArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                if (event.button == PointerEventButton.right) { root.prev-slide(); }
                else if (event.button == PointerEventButton.left) { root.next-slide(); }
            }
        }
    }

    LoomWindowResizeEdges {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        enabled: root.custom-chrome && !root.maximized && !root.is-preview-mode;
        resize(direction) => { root.window-resize(direction); }
    }
}
