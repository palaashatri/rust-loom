import {
    TitleChrome, ContextToolbar, LabeledToolbar, ToolbarGroup, ToolbarSpacer, ToolbarButton, DirectionalLayout,
    IconOnlyToolbarItem, Overflow, IconOverLabelToolbarItem, StatusBar, SidebarSurface, InspectorSurface,
    SectionHeader, Field, SegmentedControl, RangeSlider, PropertyRow,
    CanvasSurface
} from "toolkit.slint";
import { CommandPalette, CommandPaletteItem } from "components.slint";
import { Icon } from "icons.slint";
import { Theme, ResponsivePolicy } from "theme.slint";
export { Theme, ResponsivePolicy } from "theme.slint";

/// Toolbar contents are shared by both explicit slot hosts. The host owns
/// the 40px/48-52px geometry; this body only switches command visibility.
component PresentToolbarBody inherits DirectionalLayout {
    in property <bool> labeled: false;
    in property <bool> overflow: false;
    callback toggle-notes;
    callback open-theme-chooser;
    callback add-slide;
    callback add-text;
    callback add-shape;
    callback toggle-preview;
    callback toggle-inspector;
    callback export-pdf;
    callback overflow-requested;

    spacing: 4px;
    leading-padding: 0px;
    trailing-padding: 0px;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    if root.labeled : ToolbarGroup { labeled-slot: true;
        IconOverLabelToolbarItem {
            icon: "eye";
            label: "View";
            accessible-label: "View speaker notes";
            clicked => { root.toggle-notes(); }
        }
        IconOverLabelToolbarItem {
            icon: "format";
            label: "Theme";
            accessible-label: "Choose theme";
            clicked => { root.open-theme-chooser(); }
        }
        IconOverLabelToolbarItem {
            icon: "plus";
            label: "Add Slide";
            accessible-label: "Add slide";
            clicked => { root.add-slide(); }
        }
    }

    if !root.labeled : ToolbarGroup { labeled-slot: false;
        if !root.overflow : IconOnlyToolbarItem {
            icon: "eye";
            label: "View speaker notes";
            clicked => { root.toggle-notes(); }
        }
        if !root.overflow : IconOnlyToolbarItem {
            icon: "format";
            label: "Choose theme";
            clicked => { root.open-theme-chooser(); }
        }
        if !root.overflow : IconOnlyToolbarItem {
            icon: "plus";
            label: "Add slide";
            clicked => { root.add-slide(); }
        }
        if root.overflow : Overflow {
            label: "More presentation actions";
            clicked => { root.overflow-requested(); }
        }
    }

    if !root.overflow : ToolbarSpacer { }

    if root.labeled : ToolbarGroup { labeled-slot: true;
        IconOverLabelToolbarItem { icon: "table"; label: "Table"; accessible-label: "Insert table unavailable"; enabled: false; }
        IconOverLabelToolbarItem { icon: "chart"; label: "Chart"; accessible-label: "Insert chart unavailable"; enabled: false; }
        IconOverLabelToolbarItem { icon: "text"; label: "Text"; accessible-label: "Add text"; clicked => { root.add-text(); } }
        IconOverLabelToolbarItem { icon: "shape"; label: "Shape"; accessible-label: "Add shape"; clicked => { root.add-shape(); } }
        IconOverLabelToolbarItem { icon: "image"; label: "Media"; accessible-label: "Insert media unavailable"; enabled: false; }
        IconOverLabelToolbarItem { icon: "comment"; label: "Comment"; accessible-label: "Insert comment unavailable"; enabled: false; }
    }

    if !root.overflow : ToolbarSpacer { }

    if root.labeled : ToolbarGroup { labeled-slot: true;
        IconOverLabelToolbarItem {
            icon: "play";
            label: "Play";
            accessible-label: "Play presentation";
            clicked => { root.toggle-preview(); }
        }
        IconOverLabelToolbarItem {
            icon: "format";
            label: "Format";
            accessible-label: "Format inspector";
            clicked => { root.toggle-inspector(); }
        }
        IconOverLabelToolbarItem { icon: "share"; label: "Share"; accessible-label: "Share unavailable"; enabled: false; }
        IconOverLabelToolbarItem {
            icon: "export";
            label: "Export";
            accessible-label: "Export PDF";
            clicked => { root.export-pdf(); }
        }
    }

    if !root.labeled && !root.overflow : ToolbarGroup { labeled-slot: false;
        IconOnlyToolbarItem { icon: "play"; label: "Play presentation"; clicked => { root.toggle-preview(); } }
        IconOnlyToolbarItem { icon: "format"; label: "Format inspector"; clicked => { root.toggle-inspector(); } }
        IconOnlyToolbarItem { icon: "export"; label: "Export PDF"; clicked => { root.export-pdf(); } }
    }
}

/// Keynote-style slide theme preview card
component ThemeCard inherits Rectangle {
    in property <int> theme-index: 0;
    in property <string> theme-name: "Basic White";
    in property <string> description: "Standard white background";
    in property <bool> is-wide: true;
    in property <bool> selected: false;
    callback clicked;

    width: root.is-wide ? 200px : 160px;
    height: 170px;
    border-radius: Theme.tokens.metrics.radius-medium;
    background: touch.has-hover && !root.selected ? Theme.palette().surface-raised : transparent;
    accessible-role: button;
    accessible-label: root.theme-name + " theme";
    accessible-action-default => { root.clicked(); }

    VerticalLayout {
        spacing: 10px;
        padding: 6px;
        alignment: center;
        cross-axis-alignment: center;

        // Slide Thumbnail Box
        Rectangle {
            width: root.is-wide ? 180px : 144px;
            height: root.is-wide ? 101px : 108px;
            border-radius: 4px;
            border-width: root.selected ? 2.5px : 1px;
            // Selection uses the same semantic accent as the editor chrome.
            // The previous cool-blue treatment made the chooser look like a
            // different product in light/dark/high-contrast captures.
            border-color: root.selected ? Theme.palette().accent : Theme.palette().paper-line;
            background: root.theme-index == 1 ? Theme.palette().surface-sunken
                : root.theme-index == 3 ? Theme.palette().accent
                : Theme.palette().paper;
            drop-shadow-blur: 10px;
            drop-shadow-offset-y: 3px;
            drop-shadow-color: Theme.palette().shadow;
            clip: true;

            VerticalLayout {
                padding: 12px;
                alignment: center;
                spacing: 4px;

                Text {
                    text: root.theme-name;
                    font-size: 11px;
                    font-weight: 700;
                    color: root.theme-index == 1 ? Theme.palette().ink
                        : root.theme-index == 3 ? Theme.palette().accent-ink
                        : Theme.palette().paper-ink;
                    horizontal-alignment: center;
                }
                Rectangle {
                    width: 40px;
                    height: 2px;
                    background: Theme.palette().accent;
                }
                Text {
                    text: "Presentation Title";
                    font-size: 8px;
                    color: root.theme-index == 1 ? Theme.palette().ink-secondary
                        : root.theme-index == 3 ? Theme.palette().accent-ink
                        : Theme.palette().paper-muted;
                    horizontal-alignment: center;
                }
            }
        }

        if root.selected : Rectangle {
            height: 20px;
            border-radius: 4px;
            background: Theme.palette().accent;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                alignment: center;
                cross-axis-alignment: center;
                Text {
                    text: root.theme-name;
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.palette().accent-ink;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if !root.selected : Text {
            text: root.theme-name;
            font-size: 11px;
            font-weight: 500;
            color: Theme.palette().ink;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

/// A notes editor following Loom palette
component SpeakerNotesEditor inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder-text: "";
    in property <bool> enabled: true;
    in property <length> font-size: Theme.tokens.typography.body;
    callback edited(string);
    callback key-pressed(event: KeyEvent) -> EventResult;
    callback key-released(event: KeyEvent) -> EventResult;

    border-radius: Theme.tokens.metrics.radius-small;
    border-width: notes-input.has-focus ? 2px : 1px;
    border-color: notes-input.has-focus ? Theme.palette().focus : Theme.palette().border-strong;
    background: root.enabled ? Theme.palette().surface-raised : Theme.palette().surface-sunken;
    clip: true;

    accessible-role: AccessibleRole.text-input;
    accessible-label: "Speaker Notes";
    accessible-enabled: root.enabled;
    accessible-value <=> root.text;
    accessible-placeholder-text: root.placeholder-text;
    accessible-read-only: false;
    accessible-action-default => { notes-input.focus(); }
    forward-focus: notes-input;

    if root.text == "" : Text {
        x: 10px;
        y: 8px;
        width: max(1px, root.width - 20px);
        height: max(1px, root.height - 16px);
        text: root.placeholder-text;
        font-size: root.font-size;
        color: Theme.palette().ink-disabled;
        vertical-alignment: top;
        wrap: word-wrap;
        accessible-role: none;
    }

    notes-input := TextInput {
        x: 10px;
        y: 8px;
        width: max(1px, root.width - 20px);
        height: max(1px, root.height - 16px);
        text <=> root.text;
        enabled: root.enabled;
        single-line: false;
        wrap: word-wrap;
        vertical-alignment: top;
        font-size: root.font-size;
        color: root.enabled ? Theme.palette().ink : Theme.palette().ink-disabled;
        selection-background-color: Theme.palette().selection;
        selection-foreground-color: Theme.palette().accent-ink;
        accessible-role: none;
        edited => { root.edited(notes-input.text); }
        key-pressed(event) => { root.key-pressed(event); }
        key-released(event) => { root.key-released(event); }
    }
}

export component PresentApp inherits Window {
    title: "Loom Present";
    min-width: 1024px;
    min-height: 720px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.palette().canvas;

    in property <bool> show-inspector: false;
    in property <bool> labeled-export: false;
    in property <bool> overflow-toolbar: false;
    in property <bool> rtl: false;
    in-out property <bool> toolbar-overflow-open: false;
    callback window-resized(length);
    changed rtl => {
        Theme.rtl = root.rtl;
    }
    changed width => {
        root.window-resized(root.width);
        if (!ResponsivePolicy.priority-2-overflow(root.width)) {
            root.close-toolbar-overflow();
        }
    }

    in property <string> deck-title: "Untitled Deck";
    in property <string> slide-title: "Slide Title";
    in property <string> slide-body: "";
    in property <string> slide-count-text: "1 slide";
    in property <[string]> slide-titles: [];
    in property <int> active-slide-index: 0;
    in property <[string]> element-labels: [];
    in property <int> active-element-index: 0;
    in property <string> active-element-label: "No element selected";
    in property <string> active-element-content: "";
    in property <[string]> element-contents: [];
    in property <[float]> element-xs: [];
    in property <[float]> element-ys: [];
    in property <[float]> element-widths: [];
    in property <[float]> element-heights: [];
    in property <[int]> element-types: [];
    in property <float> element-x: 100;
    in property <float> element-y: 100;
    in property <float> element-width: 400;
    in property <float> element-height: 100;
    in property <string> element-x-text: "100";
    in property <string> element-y-text: "100";
    in property <string> element-width-text: "400";
    in property <string> element-height-text: "100";
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in property <string> status-left: "Ready";
    in property <string> status-right: "Offline";

    in-out property <string> slide-notes: "";
    in-out property <bool> show-notes-drawer: false;
    in-out property <bool> is-preview-mode: false;
    in-out property <int> active-template-index: 1;
    in-out property <int> inspector-tab: 0;
    in-out property <int> transition-index: 0;
    in-out property <float> zoom-value: 78;

    in-out property <bool> theme-chooser-open: false;
    in-out property <int> theme-selected: 0;
    in-out property <int> theme-category: 0;
    in-out property <bool> aspect-ratio-wide: true;

    callback new-deck;
    callback open-deck;
    callback save-deck;
    callback save-as-deck;
    callback add-slide;
    callback duplicate-slide;
    callback delete-slide;
    callback undo;
    callback redo;
    callback select-slide(int);
    callback select-element(int);
    callback add-text;
    callback add-shape;
    callback transform-element(string, float);
    callback update-element-content(string);
    callback export-pdf;
    callback notes-edited(string);
    callback toggle-preview-mode;
    callback apply-template(int);
    callback set-transition(int);
    callback prev-slide;
    callback next-slide;
    callback toggle-inspector;
    callback create-theme(int);
    callback cancel-theme;

    in-out property <[CommandPaletteItem]> palette-commands: [];
    in-out property <bool> palette-open: false;
    in-out property <string> palette-query: "";
    in-out property <int> palette-selected: 0;
    callback palette-invoked(int);
    callback palette-query-changed(string);
    callback palette-move(int);
    callback palette-key-text(string);
    callback palette-backspace;
    callback palette-close;

    public function open-palette() {
        root.palette-open = true;
        root.palette-query = "";
        palette.grab-focus();
    }

    function theme-visible(theme-index: int) -> bool {
        return root.theme-category == 0
            || (root.theme-category == 1 && theme-index <= 1)
            || (root.theme-category == 2 && theme-index == 2)
            || (root.theme-category == 3 && theme-index >= 3);
    }

    function choose-theme-category(category-index: int) {
        root.theme-category = category-index;
        if (category-index == 1 && root.theme-selected > 1) {
            root.theme-selected = 0;
        } else if (category-index == 2) {
            root.theme-selected = 2;
        } else if (category-index == 3) {
            root.theme-selected = 3;
        }
    }

    function compact-label(full-label: string) -> string {
        return root.labeled-export ? full-label : "";
    }

    public function close-toolbar-overflow() {
        if (root.toolbar-overflow-open) {
            root.toolbar-overflow-open = false;
            app-focus.focus();
        }
    }

    changed overflow-toolbar => {
        if (!root.overflow-toolbar) {
            root.close-toolbar-overflow();
        }
    }

    overflow-menu-focus := FocusScope {
        enabled: root.toolbar-overflow-open;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-toolbar-overflow();
                return accept;
            }
            return reject;
        }
    }

    theme-chooser-focus := FocusScope {
        enabled: root.theme-chooser-open;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel-theme();
                return accept;
            }
            if (event.text == Key.Return) {
                root.create-theme(root.theme-selected);
                return accept;
            }
            return reject;
        }
    }

    changed theme-chooser-open => {
        if (root.theme-chooser-open) {
            theme-chooser-focus.focus();
        } else {
            app-focus.focus();
        }
    }

    app-focus := FocusScope {
        key-pressed(event) => {
            if (root.palette-open || root.theme-chooser-open || root.toolbar-overflow-open) { return reject; }
            if (event.modifiers.control || event.modifiers.meta) {
                if (event.text == Key.K || event.text == "k") {
                    root.open-palette();
                    return accept;
                }
                if (event.text == "n" || event.text == "N") {
                    root.new-deck();
                    return accept;
                }
                if (event.text == "o" || event.text == "O") {
                    root.open-deck();
                    return accept;
                }
                if (event.text == "s" || event.text == "S") {
                    if (event.modifiers.shift) { root.save-as-deck(); } else { root.save-deck(); }
                    return accept;
                }
                if (event.text == "e" || event.text == "E") {
                    root.export-pdf();
                    return accept;
                }
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0px;
            padding: 0px;

            // Document Chrome Titlebar
            TitleChrome {
                title: root.deck-title;
                trailing-text: root.is-preview-mode ? "Presenting" : root.slide-count-text;
            }

            // Keynote-style action toolbar. Select a concrete slot owner so a
            // context row never silently stretches icon-over-label controls.
            if !root.is-preview-mode && root.labeled-export : LabeledToolbar {
                PresentToolbarBody {
                    labeled: true;
                    overflow: root.overflow-toolbar;
                    toggle-notes => { root.show-notes-drawer = !root.show-notes-drawer; }
                    open-theme-chooser => {
                        root.theme-selected = 0;
                        root.theme-category = 0;
                        root.theme-chooser-open = true;
                    }
                    add-slide => { root.add-slide(); }
                    add-text => { root.add-text(); }
                    add-shape => { root.add-shape(); }
                    toggle-preview => { root.toggle-preview-mode(); }
                    toggle-inspector => { root.toggle-inspector(); }
                    export-pdf => { root.export-pdf(); }
                    overflow-requested => {
                        if (root.toolbar-overflow-open) {
                            root.close-toolbar-overflow();
                        } else {
                            root.toolbar-overflow-open = true;
                            overflow-menu-focus.focus();
                        }
                    }
                }
            }
            if !root.is-preview-mode && !root.labeled-export : ContextToolbar {
                PresentToolbarBody {
                    labeled: false;
                    overflow: root.overflow-toolbar;
                    toggle-notes => { root.show-notes-drawer = !root.show-notes-drawer; }
                    open-theme-chooser => {
                        root.theme-selected = 0;
                        root.theme-category = 0;
                        root.theme-chooser-open = true;
                    }
                    add-slide => { root.add-slide(); }
                    add-text => { root.add-text(); }
                    add-shape => { root.add-shape(); }
                    toggle-preview => { root.toggle-preview-mode(); }
                    toggle-inspector => { root.toggle-inspector(); }
                    export-pdf => { root.export-pdf(); }
                    overflow-requested => {
                        if (root.toolbar-overflow-open) {
                            root.close-toolbar-overflow();
                        } else {
                            root.toolbar-overflow-open = true;
                            overflow-menu-focus.focus();
                        }
                    }
                }
            }

            // Main Slide Canvas Area
            DirectionalLayout {
                spacing: 0px;
                vertical-stretch: 1;

                // Left Slide Miniature Strip
                if !root.is-preview-mode : SidebarSurface {
                    title: "Slides";
                    width: 220px;

                    VerticalLayout {
                        spacing: 8px;
                        padding-top: 10px;
                        padding-bottom: 10px;
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: start;

                        for title[idx] in root.slide-titles : Rectangle {
                            height: 100px;
                            border-radius: Theme.tokens.metrics.radius-medium;
                            border-width: idx == root.active-slide-index ? 2px : 1px;
                            border-color: idx == root.active-slide-index ? Theme.palette().accent : Theme.palette().border;
                            background: idx == root.active-slide-index ? Theme.palette().selection-soft : Theme.palette().surface;

                            HorizontalLayout {
                                spacing: 6px;
                                padding: 6px;

                                // Slide Number
                                Text {
                                    text: (idx + 1) + "";
                                    font-size: Theme.tokens.typography.micro;
                                    font-weight: 700;
                                    color: Theme.palette().ink-secondary;
                                    width: 12px;
                                    vertical-alignment: top;
                                }

                                // Mini Slide Layout Preview
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 2px;
                                    border-width: 1px;
                                    border-color: Theme.palette().paper-line;
                                    background: Theme.palette().paper;

                                    VerticalLayout {
                                        padding: 8px;
                                        spacing: 4px;
                                        alignment: center;

                                        Text {
                                            text: title;
                                            font-size: 8px;
                                            font-weight: 700;
                                            color: Theme.palette().paper-ink;
                                            horizontal-alignment: center;
                                            overflow: elide;
                                        }
                                        Rectangle { height: 1px; width: 60%; background: Theme.palette().accent; }
                                        Rectangle { height: 2px; width: 80%; background: Theme.palette().paper-line; }
                                        Rectangle { height: 2px; width: 70%; background: Theme.palette().paper-line; }
                                    }
                                }
                            }

                            TouchArea {
                                clicked => { root.select-slide(idx); }
                            }
                        }

                        Rectangle { vertical-stretch: 1; background: transparent; }

                        // Slide Strip Action Bar
                        HorizontalLayout {
                            spacing: 4px;
                            IconOnlyToolbarItem { icon: "plus"; label: "Add Slide"; clicked => { root.add-slide(); } }
                            IconOnlyToolbarItem { icon: "trash-2"; label: "Delete Slide"; clicked => { root.delete-slide(); } }
                            ToolbarSpacer { }
                        }
                    }
                }

                // Center Canvas & Notes
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 0px;

                    CanvasSurface {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;

                        // Center the slide in the available stage while
                        // constraining both axes.  Width-only sizing let a
                        // short window push the slide below the canvas,
                        // clipping the bottom edge and selection affordances.
                        Rectangle {
                            property <float> slide-ratio: root.aspect-ratio-wide ? 0.5625 : 0.75;
                            x: max(24px, (parent.width - self.width) / 2);
                            y: max(24px, (parent.height - self.height) / 2);
                            width: min(
                                min(840px, max(1px, parent.width - 48px)),
                                max(1px, (parent.height - 48px) / self.slide-ratio)
                            );
                            height: self.width * self.slide-ratio;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: Theme.palette().border;
                            background: Theme.palette().paper;
                            drop-shadow-blur: 16px;
                            drop-shadow-offset-y: 6px;
                            drop-shadow-color: Theme.palette().shadow;
                            clip: true;

                            // Render the domain scene model in slide
                            // coordinates (960×540 points), rather than
                            // painting a fixed title/body mockup.  Every
                            // rendered node shares the selected-element index
                            // consumed by the inspector and the thumbnail
                            // strip, so selection cannot drift visually.
                            for element_x[idx] in root.element-xs : Rectangle {
                                property <length> render-x: clamp(element_x * parent.width / 960.0, 0px, max(0px, parent.width - 2px));
                                property <length> render-y: clamp(root.element-ys[idx] * parent.height / 540.0, 0px, max(0px, parent.height - 2px));
                                property <length> render-width: max(1px, min(root.element-widths[idx] * parent.width / 960.0, max(1px, parent.width - self.render-x - 2px)));
                                property <length> render-height: max(1px, min(root.element-heights[idx] * parent.height / 540.0, max(1px, parent.height - self.render-y - 2px)));
                                x: self.render-x;
                                y: self.render-y;
                                width: self.render-width;
                                height: self.render-height;
                                border-radius: root.element-types[idx] == 4 ? self.width / 2 : 4px;
                                border-width: idx == root.active-element-index ? 2px : 0px;
                                border-color: Theme.palette().accent;
                                background: root.element-types[idx] == 3 ? Theme.palette().content-accent-soft
                                    : root.element-types[idx] == 4 ? Theme.palette().content-cool-soft
                                    : root.element-types[idx] == 5 ? Theme.palette().content-accent
                                    : transparent;
                                accessible-role: button;
                                accessible-label: root.element-labels[idx];
                                accessible-action-default => { root.select-element(idx); }

                                Text {
                                    x: 8px;
                                    y: 6px;
                                    width: max(1px, parent.width - 16px);
                                    height: max(1px, parent.height - 12px);
                                    text: root.element-contents[idx];
                                    font-size: root.element-types[idx] == 0 ? 28px
                                        : root.element-types[idx] == 5 ? 24px : 16px;
                                    font-weight: root.element-types[idx] == 0 || root.element-types[idx] == 5 ? 700 : 400;
                                    color: root.element-types[idx] == 3 || root.element-types[idx] == 4 ? Theme.palette().ink
                                        : root.element-types[idx] == 1 || root.element-types[idx] == 2 ? Theme.palette().paper-muted
                                        : Theme.palette().paper-ink;
                                    horizontal-alignment: root.element-types[idx] == 0 || root.element-types[idx] == 5 ? center : left;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                    overflow: elide;
                                }

                                TouchArea {
                                    clicked => { root.select-element(idx); }
                                }
                            }
                        }
                    }

                    // Speaker Notes Collapsible Drawer
                    if root.show-notes-drawer && !root.is-preview-mode : Rectangle {
                        height: 110px;
                        background: Theme.palette().chrome;

                        Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.palette().border; }

                        VerticalLayout {
                            padding-top: 8px; padding-bottom: 8px; padding-left: 16px; padding-right: 16px;
                            spacing: 4px;

                            HorizontalLayout {
                                Text {
                                    text: "Speaker Notes";
                                    font-size: Theme.tokens.typography.caption;
                                    font-weight: 600;
                                    color: Theme.palette().ink;
                                    horizontal-stretch: 1;
                                }
                                IconOnlyToolbarItem {
                                    icon: "close";
                                    label: "Close notes drawer";
                                    clicked => { root.show-notes-drawer = false; }
                                }
                            }

                            SpeakerNotesEditor {
                                text <=> root.slide-notes;
                                placeholder-text: "Add presenter notes for this slide...";
                                edited(t) => { root.notes-edited(t); }
                            }
                        }
                    }
                }

                // Apple Keynote-Style Right Inspector
                if root.show-inspector && !root.is-preview-mode : InspectorSurface {
                    title: "Format";
                    width: 280px;

                    VerticalLayout {
                        spacing: 12px;
                        padding: 12px;
                        alignment: start;

                        // Tabs: Format | Animate | Document
                        SegmentedControl {
                            items: ["Format", "Animate", "Document"];
                            current <=> root.inspector-tab;
                            label: "Inspector Tabs";
                        }

                        // Tab 0: Format
                        if root.inspector-tab == 0 : VerticalLayout {
                            spacing: 10px;

                            SectionHeader { title: "Slide Layout"; }

                            SegmentedControl {
                                items: ["Title", "Content", "2 Col", "Image"];
                                current <=> root.active-template-index;
                                label: "Layout Template";
                                selected(idx) => { root.apply-template(idx); }
                            }

                            SectionHeader { title: "Background"; }

                            PropertyRow {
                                label: "Color Fill";
                                Rectangle {
                                    height: 24px; border-radius: 4px;
                                    background: Theme.palette().paper;
                                    border-width: 1px; border-color: Theme.palette().border;
                                }
                            }

                            SectionHeader { title: "Selected Element"; }

                            Rectangle {
                                min-height: 40px;
                                border-radius: Theme.tokens.metrics.radius-small;
                                border-width: 1px;
                                border-color: Theme.palette().border;
                                background: Theme.palette().selection-soft;

                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 2px;
                                    Text {
                                        text: root.active-element-label;
                                        font-size: Theme.tokens.typography.body;
                                        font-weight: 600;
                                        color: Theme.palette().ink;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: root.element-labels.length > 0 ? "Element " + (root.active-element-index + 1) + " of " + root.element-labels.length : "No element selected";
                                        font-size: Theme.tokens.typography.micro;
                                        color: Theme.palette().ink-secondary;
                                        overflow: elide;
                                    }
                                }
                            }

                            Field {
                                label: "Element text";
                                value: root.active-element-content;
                                enabled: root.active-element-label != "No element selected";
                                edited(t) => { root.update-element-content(t); }
                            }

                            SectionHeader { title: "Geometry"; }

                            PropertyRow {
                                label: "Position";
                                Text {
                                    text: root.element-x-text + " × " + root.element-y-text;
                                    font-size: Theme.tokens.typography.body;
                                    color: Theme.palette().ink;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }

                            PropertyRow {
                                label: "Size";
                                Text {
                                    text: root.element-width-text + " × " + root.element-height-text;
                                    font-size: Theme.tokens.typography.body;
                                    color: Theme.palette().ink;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                        }

                        // Tab 1: Animate
                        if root.inspector-tab == 1 : VerticalLayout {
                            spacing: 10px;

                            SectionHeader { title: "Slide Transition"; }

                            SegmentedControl {
                                items: ["None", "Dissolve", "Push", "Wipe"];
                                current <=> root.transition-index;
                                label: "Transition Type";
                                selected(idx) => { root.set-transition(idx); }
                            }

                            PropertyRow {
                                label: "Duration";
                                Field { label: "Duration"; value: "1.00 s"; enabled: false; }
                            }
                        }

                        // Tab 2: Document
                        if root.inspector-tab == 2 : VerticalLayout {
                            spacing: 10px;

                            SectionHeader { title: "Slide Size"; }

                            SegmentedControl {
                                items: ["16:9 Wide", "4:3 Standard"];
                                current: root.aspect-ratio-wide ? 0 : 1;
                                label: "Slide Aspect Ratio";
                                selected(idx) => { root.aspect-ratio-wide = (idx == 0); }
                            }

                            SectionHeader { title: "Deck Information"; }

                            PropertyRow {
                                label: "Slides";
                                Text { text: root.slide-count-text; font-size: Theme.tokens.typography.body; color: Theme.palette().ink; vertical-alignment: center; }
                            }
                        }

                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }
                }
            }

            // Standard Status Bar
            StatusBar {
                leading: root.status-left;
                trailing: root.status-right;
            }
        }
    }

    // Compact toolbar overflow menu. Every enabled action from the labeled
    // toolbar remains available below the compact-width breakpoint.
    if root.toolbar-overflow-open && root.overflow-toolbar : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: transparent;

        TouchArea { clicked => { root.close-toolbar-overflow(); } }

        Rectangle {
            x: max(8px, root.width - 272px);
            y: Theme.tokens.metrics.header-height + 32px + 8px;
            width: 256px;
            height: 272px;
            border-radius: Theme.tokens.metrics.radius-medium;
            border-width: 1px;
            border-color: Theme.palette().border;
            background: Theme.palette().surface;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.palette().shadow;

            VerticalLayout {
                spacing: 4px;
                padding: 8px;

                ToolbarButton {
                    icon: "eye";
                    label: "View speaker notes";
                    horizontal-stretch: 1;
                    clicked => { root.show-notes-drawer = !root.show-notes-drawer; root.close-toolbar-overflow(); }
                }
                ToolbarButton {
                    icon: "format";
                    label: "Choose theme";
                    horizontal-stretch: 1;
                    clicked => { root.theme-selected = 0; root.theme-category = 0; root.theme-chooser-open = true; root.close-toolbar-overflow(); }
                }
                ToolbarButton {
                    icon: "plus";
                    label: "Add slide";
                    horizontal-stretch: 1;
                    clicked => { root.add-slide(); root.close-toolbar-overflow(); }
                }
                ToolbarButton {
                    icon: "text";
                    label: "Add text";
                    horizontal-stretch: 1;
                    clicked => { root.add-text(); root.close-toolbar-overflow(); }
                }
                ToolbarButton {
                    icon: "shape";
                    label: "Add shape";
                    horizontal-stretch: 1;
                    clicked => { root.add-shape(); root.close-toolbar-overflow(); }
                }
                ToolbarButton {
                    icon: "play";
                    label: "Play presentation";
                    horizontal-stretch: 1;
                    clicked => { root.toggle-preview-mode(); root.close-toolbar-overflow(); }
                }
                ToolbarButton {
                    icon: "format";
                    label: "Format inspector";
                    checked: root.show-inspector;
                    horizontal-stretch: 1;
                    clicked => { root.toggle-inspector(); root.close-toolbar-overflow(); }
                }
                ToolbarButton {
                    icon: "export";
                    label: "Export PDF";
                    horizontal-stretch: 1;
                    clicked => { root.export-pdf(); root.close-toolbar-overflow(); }
                }
            }
        }
    }

    if root.theme-chooser-open : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: Theme.palette().scrim;

        Rectangle {
            // The theme browser is intentionally large enough for visual
            // comparison; fixed 960×620 geometry looked like a cramped
            // dialog on wide macOS displays.
            width: min(1160px, max(1px, parent.width - 48px));
            height: min(760px, max(480px, parent.height - 48px));
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.tokens.metrics.radius-large;
            border-width: 1px;
            border-color: Theme.palette().border;
            background: Theme.palette().surface;
            clip: true;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: Theme.palette().shadow;

            VerticalLayout {
                spacing: 0px;
                padding: 0px;

                HorizontalLayout {
                    spacing: 0px;
                    vertical-stretch: 1;

                    // Sidebar
                    Rectangle {
                        width: 220px;
                        background: Theme.palette().panel;

                        VerticalLayout {
                            spacing: 4px;
                            padding-top: 16px;
                            padding-bottom: 16px;
                            padding-left: 12px;
                            padding-right: 12px;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-bottom: 4px;
                                Text {
                                    text: "THEMES";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: Theme.palette().ink-secondary;
                                }
                            }

                            Rectangle {
                                height: 32px;
                                border-radius: Theme.tokens.metrics.radius-medium;
                                background: root.theme-category == 0 ? Theme.palette().surface-raised : transparent;
                                HorizontalLayout {
                                    spacing: 8px; padding-left: 10px; padding-right: 10px; cross-axis-alignment: center;
                                    Icon { size: 16px; icon: "grid"; tint: root.theme-category == 0 ? Theme.palette().accent : Theme.palette().ink-secondary; }
                                    Text {
                                        text: "All Themes";
                                        font-size: Theme.tokens.typography.body;
                                        font-weight: root.theme-category == 0 ? 600 : 400;
                                        color: Theme.palette().ink;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.choose-theme-category(0); } }
                            }

                            Rectangle {
                                height: 32px;
                                border-radius: Theme.tokens.metrics.radius-medium;
                                background: root.theme-category == 1 ? Theme.palette().surface-raised : transparent;
                                HorizontalLayout {
                                    spacing: 8px; padding-left: 10px; padding-right: 10px; cross-axis-alignment: center;
                                    Icon { size: 16px; icon: "slide"; tint: root.theme-category == 1 ? Theme.palette().accent : Theme.palette().ink-secondary; }
                                    Text {
                                        text: "Basic";
                                        font-size: Theme.tokens.typography.body;
                                        font-weight: root.theme-category == 1 ? 600 : 400;
                                        color: Theme.palette().ink;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.choose-theme-category(1); } }
                            }

                            Rectangle {
                                height: 32px;
                                border-radius: Theme.tokens.metrics.radius-medium;
                                background: root.theme-category == 2 ? Theme.palette().surface-raised : transparent;
                                HorizontalLayout {
                                    spacing: 8px; padding-left: 10px; padding-right: 10px; cross-axis-alignment: center;
                                    Icon { size: 16px; icon: "wand"; tint: root.theme-category == 2 ? Theme.palette().accent : Theme.palette().ink-secondary; }
                                    Text {
                                        text: "Dynamic";
                                        font-size: Theme.tokens.typography.body;
                                        font-weight: root.theme-category == 2 ? 600 : 400;
                                        color: Theme.palette().ink;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.choose-theme-category(2); } }
                            }

                            Rectangle {
                                height: 32px;
                                border-radius: Theme.tokens.metrics.radius-medium;
                                background: root.theme-category == 3 ? Theme.palette().surface-raised : transparent;
                                HorizontalLayout {
                                    spacing: 8px; padding-left: 10px; padding-right: 10px; cross-axis-alignment: center;
                                    Icon { size: 16px; icon: "brush"; tint: root.theme-category == 3 ? Theme.palette().accent : Theme.palette().ink-secondary; }
                                    Text {
                                        text: "Minimal";
                                        font-size: Theme.tokens.typography.body;
                                        font-weight: root.theme-category == 3 ? 600 : 400;
                                        color: Theme.palette().ink;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.choose-theme-category(3); } }
                            }

                            Rectangle { vertical-stretch: 1; background: transparent; }

                            HorizontalLayout {
                                spacing: 6px; padding: 8px;
                                Text {
                                    text: "English (US)";
                                    font-size: Theme.tokens.typography.caption;
                                    color: Theme.palette().ink-secondary;
                                    vertical-alignment: center;
                                }
                                Icon { size: 12px; icon: "chevron-down"; tint: Theme.palette().ink-secondary; }
                            }
                        }

                        Rectangle { x: parent.width - 1px; y: 0px; width: 1px; height: parent.height; background: Theme.palette().border; }
                    }

                    // Content Area
                    VerticalLayout {
                        horizontal-stretch: 1;
                        padding-top: 24px;
                        padding-bottom: 20px;
                        padding-left: 28px;
                        padding-right: 28px;
                        spacing: 16px;

                        HorizontalLayout {
                            Text {
                                text: "Choose a Theme";
                                font-size: 24px;
                                font-weight: 700;
                                color: Theme.palette().ink;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }

                            // Aspect ratio picker
                            SegmentedControl {
                                items: ["Widescreen (16:9)", "Standard (4:3)"];
                                current: root.aspect-ratio-wide ? 0 : 1;
                                label: "Theme Aspect Ratio";
                                selected(idx) => { root.aspect-ratio-wide = (idx == 0); }
                            }
                        }

                        // The modal content column is 684px wide at the
                        // reference viewport. Two rows keep every 200px-wide
                        // widescreen card inside that column instead of
                        // clipping the fourth card at the right edge.
                        VerticalLayout {
                            spacing: 16px;

                            HorizontalLayout {
                                spacing: 16px;

                                if root.theme-visible(0) : ThemeCard {
                                    theme-index: 0;
                                    theme-name: "Basic White";
                                    description: "Clean white presentation";
                                    is-wide: root.aspect-ratio-wide;
                                    selected: root.theme-selected == 0;
                                    clicked => { root.theme-selected = 0; }
                                }

                                if root.theme-visible(1) : ThemeCard {
                                    theme-index: 1;
                                    theme-name: "Basic Black";
                                    description: "Sleek dark presentation";
                                    is-wide: root.aspect-ratio-wide;
                                    selected: root.theme-selected == 1;
                                    clicked => { root.theme-selected = 1; }
                                }
                            }

                            HorizontalLayout {
                                spacing: 16px;

                                if root.theme-visible(2) : ThemeCard {
                                    theme-index: 2;
                                    theme-name: "Classic Editorial";
                                    description: "Refined typographic layout";
                                    is-wide: root.aspect-ratio-wide;
                                    selected: root.theme-selected == 2;
                                    clicked => { root.theme-selected = 2; }
                                }

                                if root.theme-visible(3) : ThemeCard {
                                    theme-index: 3;
                                    theme-name: "Dynamic Accent";
                                    description: "Bold gradient styling";
                                    is-wide: root.aspect-ratio-wide;
                                    selected: root.theme-selected == 3;
                                    clicked => { root.theme-selected = 3; }
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }
                }

                // Footer Bar
                Rectangle {
                    height: 56px;
                    background: Theme.palette().chrome;

                    Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.palette().border; }

                    HorizontalLayout {
                        spacing: 12px;
                        padding-left: 20px;
                        padding-right: 20px;
                        cross-axis-alignment: center;

                        Text {
                            text: "Escape to cancel • Return to create";
                            font-size: Theme.tokens.typography.caption;
                            color: Theme.palette().ink-secondary;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }

                        ToolbarButton {
                            label: "Cancel";
                            clicked => { root.cancel-theme(); }
                        }

                        ToolbarButton {
                            label: "Create Presentation";
                            primary: true;
                            clicked => { root.create-theme(root.theme-selected); }
                        }
                    }
                }
            }
        }
    }

    palette := CommandPalette {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        open: root.palette-open;
        commands: root.palette-commands;
        query: root.palette-query;
        selected: root.palette-selected;
        command-invoked(idx) => { root.palette-invoked(idx); }
        query-changed(q) => {
            root.palette-query = q;
            root.palette-query-changed(q);
        }
        move-selection(delta) => { root.palette-move(delta); }
        key-text(text) => { root.palette-key-text(text); }
        backspace => { root.palette-backspace(); }
        close-requested => {
            root.palette-open = false;
            root.palette-close();
        }
    }
}
