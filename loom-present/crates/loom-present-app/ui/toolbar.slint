import { LabeledToolbar, IconOverLabelToolbarItem, ToolbarSpacer } from "components.slint";
import { LoomOverflowButton, LoomMenuItem } from "foundation.slint";
import { Theme } from "theme.slint";

/// One icon-over-label row in three groups: View/Zoom/Add Slide on the
/// reading-start side, Insert/Text/Shape in the middle, Play and the three
/// inspector tabs on the reading-end side.
export component PresentActionToolbar inherits LabeledToolbar {
    in property <bool> overflow: false;
    in property <bool> inspector-visible: false;
    in property <int> inspector-tab: 0;
    in property <bool> view-menu-open: false;
    in property <bool> zoom-menu-open: false;
    in property <bool> is-preview-mode: false;
    /// Window x of the View and Zoom items, so their menus open beneath them.
    out property <length> view-x: view-item.absolute-position.x;
    out property <length> zoom-x: zoom-item.absolute-position.x;

    callback toggle-view-menu;
    callback toggle-zoom-menu;
    callback add-slide;
    callback add-text;
    callback add-shape;
    callback add-picture;
    callback toggle-preview;
    callback show-inspector-tab(int);
    callback overflow-requested;

    view-item := IconOverLabelToolbarItem {
        icon: "view";
        label: "View";
        checked: root.view-menu-open;
        clicked => { root.toggle-view-menu(); }
    }
    zoom-item := IconOverLabelToolbarItem {
        icon: "zoom-fit";
        label: "Zoom";
        checked: root.zoom-menu-open;
        clicked => { root.toggle-zoom-menu(); }
    }
    IconOverLabelToolbarItem {
        icon: "slide";
        label: "Add Slide";
        clicked => { root.add-slide(); }
    }

    ToolbarSpacer { }

    IconOverLabelToolbarItem {
        icon: "image";
        label: "Insert";
        clicked => { root.add-picture(); }
    }
    IconOverLabelToolbarItem {
        icon: "text";
        label: "Text";
        clicked => { root.add-text(); }
    }
    IconOverLabelToolbarItem {
        icon: "shape";
        label: "Shape";
        clicked => { root.add-shape(); }
    }

    ToolbarSpacer { }

    IconOverLabelToolbarItem {
        icon: "play";
        label: "Play";
        checked: root.is-preview-mode;
        clicked => { root.toggle-preview(); }
    }
    IconOverLabelToolbarItem {
        icon: "format";
        label: "Format";
        checked: root.inspector-visible && root.inspector-tab == 0;
        clicked => { root.show-inspector-tab(0); }
    }
    IconOverLabelToolbarItem {
        icon: "sparkle";
        label: "Animate";
        checked: root.inspector-visible && root.inspector-tab == 1;
        clicked => { root.show-inspector-tab(1); }
    }
    IconOverLabelToolbarItem {
        icon: "document";
        label: "Document";
        checked: root.inspector-visible && root.inspector-tab == 2;
        clicked => { root.show-inspector-tab(2); }
    }
    if root.overflow : LoomOverflowButton {
        tooltip: "More presentation commands";
        clicked => { root.overflow-requested(); }
    }
}

/// The small menu under the View and Zoom toolbar items.
export component PresentToolbarMenu inherits Rectangle {
    /// 0 = View (pane toggles), 1 = Zoom (slide size).
    in property <int> kind: 0;
    in property <bool> navigator-visible: true;
    in property <bool> notes-visible: false;
    in property <int> zoom-index: 0;
    callback toggle-navigator;
    callback toggle-notes;
    callback choose-zoom(int);
    callback close-requested;

    width: 200px;
    height: menu-items.preferred-height + 2 * Theme.tokens.space.sm;
    border-radius: Theme.tokens.metrics.radius-medium;
    border-width: 1px;
    border-color: Theme.palette().border;
    background: Theme.palette().surface;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Theme.palette().shadow;

    menu-items := VerticalLayout {
        spacing: 2px;
        padding: Theme.tokens.space.sm;
        if root.kind == 0 : LoomMenuItem {
            label: "Navigator";
            checked: root.navigator-visible;
            activated => { root.toggle-navigator(); root.close-requested(); }
        }
        if root.kind == 0 : LoomMenuItem {
            label: "Speaker Notes";
            checked: root.notes-visible;
            activated => { root.toggle-notes(); root.close-requested(); }
        }
        if root.kind == 1 : LoomMenuItem {
            label: "Fit";
            checked: root.zoom-index == 0;
            activated => { root.choose-zoom(0); root.close-requested(); }
        }
        if root.kind == 1 : LoomMenuItem {
            label: "75%";
            checked: root.zoom-index == 1;
            activated => { root.choose-zoom(1); root.close-requested(); }
        }
        if root.kind == 1 : LoomMenuItem {
            label: "50%";
            checked: root.zoom-index == 2;
            activated => { root.choose-zoom(2); root.close-requested(); }
        }
    }
}
