import { LabeledToolbar, ToolbarSpacer } from "components.slint";
import { LoomMenuItem, LoomToolbarItem, LoomOverflowTrigger } from "foundation.slint";
import { Theme } from "theme.slint";

/// One icon-over-label row in three groups: View/Zoom/Add Slide on the
/// reading-start side, Insert/Text/Shape in the middle, Play and the three
/// inspector tabs on the reading-end side.
export component PresentActionToolbar inherits LabeledToolbar {
    in property <bool> overflow: false;
    in property <bool> inspector-visible: false;
    in property <int> inspector-tab: 0;
    in property <bool> view-menu-open: false;
    in property <bool> zoom-menu-open: false;
    in property <bool> is-preview-mode: false;
    /// The View and Zoom menus open beneath their items: each item reports the
    /// window x of its reading-start edge (left in LTR, right in RTL).
    callback toggle-view-menu(length);
    callback toggle-zoom-menu(length);
    callback add-slide;
    callback add-text;
    callback add-shape;
    callback add-picture;
    callback toggle-preview;
    callback show-inspector-tab(int);
    callback overflow-requested;

    /// Raised when Escape closes the View or Zoom menu, so focus goes back to
    /// the item that opened it. Each tick is a counter; the item takes focus
    /// when it changes.
    in property <int> focus-view-tick: 0;
    in property <int> focus-zoom-tick: 0;

    // Left-to-right order. Right-to-left is the exact mirror image: the groups
    // and the items inside each group are reversed, and the overflow button
    // moves to the left end. Both orders share the same commands.
    if !Theme.rtl : HorizontalLayout {
        horizontal-stretch: 1;
        spacing: 4px;
        LoomToolbarItem {
            icon: "view";
            label: "View";
            checked: root.view-menu-open;
            focus-request: root.focus-view-tick;
            clicked => { root.toggle-view-menu(self.absolute-position.x); }
        }
        LoomToolbarItem {
            icon: "zoom-fit";
            label: "Zoom";
            checked: root.zoom-menu-open;
            focus-request: root.focus-zoom-tick;
            clicked => { root.toggle-zoom-menu(self.absolute-position.x); }
        }
        LoomToolbarItem {
            icon: "slide";
            label: "Add Slide";
            clicked => { root.add-slide(); }
        }

        ToolbarSpacer { }

        LoomToolbarItem {
            icon: "image";
            label: "Insert";
            clicked => { root.add-picture(); }
        }
        LoomToolbarItem {
            icon: "text";
            label: "Text";
            clicked => { root.add-text(); }
        }
        LoomToolbarItem {
            icon: "shape";
            label: "Shape";
            clicked => { root.add-shape(); }
        }

        ToolbarSpacer { }

        LoomToolbarItem {
            icon: "play";
            label: "Play";
            checked: root.is-preview-mode;
            clicked => { root.toggle-preview(); }
        }
        LoomToolbarItem {
            icon: "format";
            label: "Format";
            checked: root.inspector-visible && root.inspector-tab == 0;
            clicked => { root.show-inspector-tab(0); }
        }
        LoomToolbarItem {
            icon: "sparkle";
            label: "Animate";
            checked: root.inspector-visible && root.inspector-tab == 1;
            clicked => { root.show-inspector-tab(1); }
        }
        LoomToolbarItem {
            icon: "document";
            label: "Document";
            checked: root.inspector-visible && root.inspector-tab == 2;
            clicked => { root.show-inspector-tab(2); }
        }
        if root.overflow : LoomOverflowTrigger {
            tooltip: "More presentation commands";
            clicked => { root.overflow-requested(); }
        }
    }
    if Theme.rtl : HorizontalLayout {
        horizontal-stretch: 1;
        spacing: 4px;
        if root.overflow : LoomOverflowTrigger {
            tooltip: "More presentation commands";
            clicked => { root.overflow-requested(); }
        }
        LoomToolbarItem {
            icon: "document";
            label: "Document";
            checked: root.inspector-visible && root.inspector-tab == 2;
            clicked => { root.show-inspector-tab(2); }
        }
        LoomToolbarItem {
            icon: "sparkle";
            label: "Animate";
            checked: root.inspector-visible && root.inspector-tab == 1;
            clicked => { root.show-inspector-tab(1); }
        }
        LoomToolbarItem {
            icon: "format";
            label: "Format";
            checked: root.inspector-visible && root.inspector-tab == 0;
            clicked => { root.show-inspector-tab(0); }
        }
        LoomToolbarItem {
            icon: "play";
            label: "Play";
            checked: root.is-preview-mode;
            clicked => { root.toggle-preview(); }
        }

        ToolbarSpacer { }

        LoomToolbarItem {
            icon: "shape";
            label: "Shape";
            clicked => { root.add-shape(); }
        }
        LoomToolbarItem {
            icon: "text";
            label: "Text";
            clicked => { root.add-text(); }
        }
        LoomToolbarItem {
            icon: "image";
            label: "Insert";
            clicked => { root.add-picture(); }
        }

        ToolbarSpacer { }

        LoomToolbarItem {
            icon: "slide";
            label: "Add Slide";
            clicked => { root.add-slide(); }
        }
        LoomToolbarItem {
            icon: "zoom-fit";
            label: "Zoom";
            checked: root.zoom-menu-open;
            focus-request: root.focus-zoom-tick;
            clicked => { root.toggle-zoom-menu(self.absolute-position.x + self.width); }
        }
        LoomToolbarItem {
            icon: "view";
            label: "View";
            checked: root.view-menu-open;
            focus-request: root.focus-view-tick;
            clicked => { root.toggle-view-menu(self.absolute-position.x + self.width); }
        }
    }
}

/// The small menu under the View and Zoom toolbar items.
export component PresentToolbarMenu inherits Rectangle {
    /// 0 = View (pane toggles), 1 = Zoom (slide size).
    in property <int> kind: 0;
    in property <bool> navigator-visible: true;
    in property <bool> notes-visible: false;
    in property <int> zoom-index: 0;
    callback toggle-navigator;
    callback toggle-notes;
    callback choose-zoom(int);
    /// An appearance row ran; carries its command id (`view.appearance.*`).
    callback choose-appearance(string);
    /// A row ran; the menu closes and focus goes back to the slide.
    callback close-requested;
    /// Escape: close and return focus to the toolbar item that opened it.
    callback dismissed;

    // Keyboard: Down/Up move the highlighted row, Return or Space runs it.
    in-out property <int> selected: 0;
    property <int> row-count: root.kind == 0 ? 6 : 3;
    property <[string]> appearance-ids: [
        "view.appearance.system", "view.appearance.light",
        "view.appearance.dark", "view.appearance.high_contrast",
    ];
    function run(row: int) {
        if (root.kind == 0) {
            if (row == 0) { root.toggle-navigator(); }
            else if (row == 1) { root.toggle-notes(); }
            else { root.choose-appearance(root.appearance-ids[row - 2]); }
        } else {
            root.choose-zoom(row);
        }
        root.close-requested();
    }
    init => { menu-focus.focus(); }
    menu-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.dismissed(); return accept; }
            if (event.text == Key.DownArrow) { root.selected = Math.mod(root.selected + 1, root.row-count); return accept; }
            if (event.text == Key.UpArrow) { root.selected = Math.mod(root.selected + root.row-count - 1, root.row-count); return accept; }
            if (event.text == Key.Return || event.text == " ") { root.run(root.selected); return accept; }
            return reject;
        }
    }

    width: 244px + 120px * (max(1.0, Theme.text-scale) - 1.0);
    height: menu-items.preferred-height + 2 * Theme.tokens.space.sm;
    border-radius: Theme.tokens.metrics.radius-medium;
    border-width: 1px;
    border-color: Theme.palette().border;
    background: Theme.palette().surface;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Theme.palette().shadow;

    menu-items := VerticalLayout {
        spacing: 2px;
        padding: Theme.tokens.space.sm;
        if root.kind == 0 : LoomMenuItem {
            label: "Navigator";
            checked: root.navigator-visible;
            selected: root.selected == 0;
            activated => { root.toggle-navigator(); root.close-requested(); }
        }
        if root.kind == 0 : LoomMenuItem {
            label: "Speaker Notes";
            checked: root.notes-visible;
            selected: root.selected == 1;
            activated => { root.toggle-notes(); root.close-requested(); }
        }
        if root.kind == 0 : LoomMenuItem {
            label: "Appearance: System";
            checked: Theme.appearance == "system";
            checkable: true;
            selected: root.selected == 2;
            activated => { root.choose-appearance("view.appearance.system"); root.close-requested(); }
        }
        if root.kind == 0 : LoomMenuItem {
            label: "Appearance: Light";
            checked: Theme.appearance == "light";
            checkable: true;
            selected: root.selected == 3;
            activated => { root.choose-appearance("view.appearance.light"); root.close-requested(); }
        }
        if root.kind == 0 : LoomMenuItem {
            label: "Appearance: Dark";
            checked: Theme.appearance == "dark";
            checkable: true;
            selected: root.selected == 4;
            activated => { root.choose-appearance("view.appearance.dark"); root.close-requested(); }
        }
        if root.kind == 0 : LoomMenuItem {
            label: "Appearance: High Contrast";
            checked: Theme.appearance == "high-contrast";
            checkable: true;
            selected: root.selected == 5;
            activated => { root.choose-appearance("view.appearance.high_contrast"); root.close-requested(); }
        }
        if root.kind == 1 : LoomMenuItem {
            label: "Fit";
            checked: root.zoom-index == 0;
            selected: root.selected == 0;
            activated => { root.choose-zoom(0); root.close-requested(); }
        }
        if root.kind == 1 : LoomMenuItem {
            label: "75%";
            checked: root.zoom-index == 1;
            selected: root.selected == 1;
            activated => { root.choose-zoom(1); root.close-requested(); }
        }
        if root.kind == 1 : LoomMenuItem {
            label: "50%";
            checked: root.zoom-index == 2;
            selected: root.selected == 2;
            activated => { root.choose-zoom(2); root.close-requested(); }
        }
    }
}
