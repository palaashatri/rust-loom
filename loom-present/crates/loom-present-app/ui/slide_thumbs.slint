import { LoomIconButton } from "foundation.slint";
import { Theme } from "theme.slint";
import { PresentSlideCanvas } from "slide_canvas.slint";

/// Per-element rows of one slide, in the form the slide canvas draws.
/// `key` fingerprints the slide so unchanged thumbnails are not rewritten.
export struct ThumbRows {
    key: string,
    labels: [string],
    contents: [string],
    xs: [float],
    ys: [float],
    widths: [float],
    heights: [float],
    rotations: [float],
    types: [int],
    images: [image],
}

/// A miniature slide: the editor's own slide canvas at thumbnail size, drawn
/// on the slide's paper colour (document artwork, not UI theme).
export component MiniSlide inherits Rectangle {
    in property <ThumbRows> rows;
    in property <string> description;
    height: self.width * 0.5625;
    accessible-role: image;
    accessible-label: root.description;
    PresentSlideCanvas {
        width: 100%;
        height: 100%;
        editing-enabled: false;
        fit-screen: true;
        background: transparent;
        element-labels: root.rows.labels;
        element-contents: root.rows.contents;
        element-xs: root.rows.xs;
        element-ys: root.rows.ys;
        element-widths: root.rows.widths;
        element-heights: root.rows.heights;
        element-rotations: root.rows.rotations;
        element-types: root.rows.types;
        element-images: root.rows.images;
    }
}

/// One slide in the strip: its number and the real slide, scaled down.
component PresentSlideThumbnail inherits Rectangle {
    in property <string> title: "Slide";
    in property <ThumbRows> rows;
    in property <int> index: 0;
    in property <bool> active: false;
    callback clicked;

    height: mini.height + Theme.tokens.space.sm * 2;
    min-width: 0px;
    horizontal-stretch: 1;
    border-radius: Theme.tokens.metrics.radius-medium;
    border-width: root.active ? 2px : 1px;
    border-color: root.active ? Theme.palette().accent : Theme.palette().border;
    background: root.active ? Theme.palette().selection-soft : Theme.palette().surface;
    accessible-role: button;
    accessible-label: "Slide " + (root.index + 1) + ": " + root.title;

    HorizontalLayout {
        spacing: Theme.tokens.space.sm;
        padding: Theme.tokens.space.sm;
        Text {
            text: (root.index + 1) + "";
            min-width: 12px;
            font-size: Theme.tokens.typography.micro;
            font-weight: 700;
            color: Theme.palette().ink-secondary;
            vertical-alignment: top;
        }
        Rectangle {
            horizontal-stretch: 1;
            border-radius: Theme.tokens.metrics.radius-small;
            border-width: 1px;
            border-color: Theme.palette().paper-line;
            background: Theme.palette().paper;
            clip: true;
            mini := MiniSlide {
                width: 100%;
                rows: root.rows;
                description: root.title;
            }
        }
    }
    TouchArea { clicked => { root.clicked(); } }
}
export component PresentSlideStrip inherits Rectangle {
    in property <[string]> titles: [];
    in property <[ThumbRows]> thumbs: [];
    in property <int> active-index: 0;
    callback select-slide(int);
    callback add-slide;
    callback delete-slide;

    width: 220px;
    background: Theme.palette().panel;
    border-width: 1px;
    border-color: Theme.palette().border;

    VerticalLayout {
        spacing: Theme.tokens.space.sm;
        padding-top: Theme.tokens.space.md;
        padding-bottom: Theme.tokens.space.md;
        padding-left: Theme.tokens.space.sm;
        padding-right: Theme.tokens.space.sm;
        alignment: start;

        for title[idx] in root.titles : PresentSlideThumbnail {
            index: idx;
            title: title;
            rows: root.thumbs[idx];
            active: idx == root.active-index;
            clicked => { root.select-slide(idx); }
        }

        Rectangle { vertical-stretch: 1; background: transparent; }

        HorizontalLayout {
            spacing: Theme.tokens.space.xs;
            alignment: start;
            LoomIconButton {
                icon: "plus";
                label: "Add Slide";
                tooltip: "Add a new slide";
                clicked => { root.add-slide(); }
            }
            LoomIconButton {
                icon: "trash-2";
                label: "Delete Slide";
                tooltip: "Delete selected slide";
                clicked => { root.delete-slide(); }
            }
        }
    }
}

