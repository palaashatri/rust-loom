import { Theme } from "theme.slint";

/// One selection handle: a crisp visual glyph centered inside a 24x24 px
/// pointer hit target (GOV-06 compliant) for comfortable corner, edge, and
/// rotation manipulation.
component ResizeHandle inherits Rectangle {
    in property <string> handle-name;
    in property <bool> is-rotate: false;
    in property <length> slide-width;
    in property <length> slide-height;
    callback focus-slide;
    callback pressed(string, bool);
    callback moved(string, float, float);
    callback released(string);
    callback cancelled(string);

    width: 24px;
    height: 24px;
    background: transparent;

    // Visual handle glyph centered inside the 24x24 px touch box.
    if !root.is-rotate : Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 8px;
        height: 8px;
        border-radius: 1.5px;
        background: Theme.palette().paper;
        border-width: 1.5px;
        border-color: Theme.palette().accent;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: Theme.palette().shadow;
    }

    if root.is-rotate : Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 10px;
        height: 10px;
        border-radius: 5px;
        background: Theme.palette().paper;
        border-width: 1.5px;
        border-color: Theme.palette().accent;
        drop-shadow-blur: 3px;
        drop-shadow-offset-y: 1px;
        drop-shadow-color: Theme.palette().shadow;

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 4px;
            height: 4px;
            border-radius: 2px;
            background: Theme.palette().accent;
        }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: root.is-rotate ? (self.pressed ? MouseCursor.grabbing : MouseCursor.grab)
            : (root.handle-name == "nw" || root.handle-name == "se") ? MouseCursor.nwse-resize
            : (root.handle-name == "ne" || root.handle-name == "sw") ? MouseCursor.nesw-resize
            : (root.handle-name == "n" || root.handle-name == "s") ? MouseCursor.ns-resize
            : MouseCursor.ew-resize;
        property <length> press-abs-x;
        property <length> press-abs-y;
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.focus-slide();
                self.press-abs-x = self.absolute-position.x + self.mouse-x;
                self.press-abs-y = self.absolute-position.y + self.mouse-y;
                root.pressed(root.handle-name, event.modifiers.shift);
            }
            if (event.kind == PointerEventKind.cancel) { root.cancelled(root.handle-name); }
            if (event.kind == PointerEventKind.up) { root.released(root.handle-name); }
        }
        moved => {
            if self.pressed {
                root.moved(
                    root.handle-name,
                    (self.absolute-position.x + self.mouse-x - self.press-abs-x) * 1000.0 / root.slide-width,
                    (self.absolute-position.y + self.mouse-y - self.press-abs-y) * 562.5 / root.slide-height
                );
            }
        }
    }
}

/// Keynote-grade 8-handle selection chrome (`nw`, `n`, `ne`, `e`, `se`, `s`, `sw`, `w`)
/// plus a stem-connected rotation knob centered above the top edge.
export component SlideSelectionHandles inherits Rectangle {
    in property <length> slide-width;
    in property <length> slide-height;
    callback focus-slide;
    callback handle-pressed(string, bool);
    callback handle-moved(string, float, float);
    callback handle-released(string);
    callback handle-cancelled(string);

    width: 100%;
    height: 100%;
    background: transparent;

    // Stem connecting the top edge midpoint to the rotation knob.
    Rectangle {
        x: parent.width / 2 - 0.75px;
        y: -22px;
        width: 1.5px;
        height: 22px;
        background: Theme.palette().accent;
        accessible-role: none;
    }

    ResizeHandle {
        handle-name: "nw"; x: -12px; y: -12px;
        slide-width: root.slide-width; slide-height: root.slide-height;
        focus-slide => { root.focus-slide(); }
        pressed(h, s) => { root.handle-pressed(h, s); }
        moved(h, dx, dy) => { root.handle-moved(h, dx, dy); }
        released(h) => { root.handle-released(h); }
        cancelled(h) => { root.handle-cancelled(h); }
    }
    ResizeHandle {
        handle-name: "n"; x: parent.width / 2 - 12px; y: -12px;
        slide-width: root.slide-width; slide-height: root.slide-height;
        focus-slide => { root.focus-slide(); }
        pressed(h, s) => { root.handle-pressed(h, s); }
        moved(h, dx, dy) => { root.handle-moved(h, dx, dy); }
        released(h) => { root.handle-released(h); }
        cancelled(h) => { root.handle-cancelled(h); }
    }
    ResizeHandle {
        handle-name: "ne"; x: parent.width - 12px; y: -12px;
        slide-width: root.slide-width; slide-height: root.slide-height;
        focus-slide => { root.focus-slide(); }
        pressed(h, s) => { root.handle-pressed(h, s); }
        moved(h, dx, dy) => { root.handle-moved(h, dx, dy); }
        released(h) => { root.handle-released(h); }
        cancelled(h) => { root.handle-cancelled(h); }
    }
    ResizeHandle {
        handle-name: "e"; x: parent.width - 12px; y: parent.height / 2 - 12px;
        slide-width: root.slide-width; slide-height: root.slide-height;
        focus-slide => { root.focus-slide(); }
        pressed(h, s) => { root.handle-pressed(h, s); }
        moved(h, dx, dy) => { root.handle-moved(h, dx, dy); }
        released(h) => { root.handle-released(h); }
        cancelled(h) => { root.handle-cancelled(h); }
    }
    ResizeHandle {
        handle-name: "se"; x: parent.width - 12px; y: parent.height - 12px;
        slide-width: root.slide-width; slide-height: root.slide-height;
        focus-slide => { root.focus-slide(); }
        pressed(h, s) => { root.handle-pressed(h, s); }
        moved(h, dx, dy) => { root.handle-moved(h, dx, dy); }
        released(h) => { root.handle-released(h); }
        cancelled(h) => { root.handle-cancelled(h); }
    }
    ResizeHandle {
        handle-name: "s"; x: parent.width / 2 - 12px; y: parent.height - 12px;
        slide-width: root.slide-width; slide-height: root.slide-height;
        focus-slide => { root.focus-slide(); }
        pressed(h, s) => { root.handle-pressed(h, s); }
        moved(h, dx, dy) => { root.handle-moved(h, dx, dy); }
        released(h) => { root.handle-released(h); }
        cancelled(h) => { root.handle-cancelled(h); }
    }
    ResizeHandle {
        handle-name: "sw"; x: -12px; y: parent.height - 12px;
        slide-width: root.slide-width; slide-height: root.slide-height;
        focus-slide => { root.focus-slide(); }
        pressed(h, s) => { root.handle-pressed(h, s); }
        moved(h, dx, dy) => { root.handle-moved(h, dx, dy); }
        released(h) => { root.handle-released(h); }
        cancelled(h) => { root.handle-cancelled(h); }
    }
    ResizeHandle {
        handle-name: "w"; x: -12px; y: parent.height / 2 - 12px;
        slide-width: root.slide-width; slide-height: root.slide-height;
        focus-slide => { root.focus-slide(); }
        pressed(h, s) => { root.handle-pressed(h, s); }
        moved(h, dx, dy) => { root.handle-moved(h, dx, dy); }
        released(h) => { root.handle-released(h); }
        cancelled(h) => { root.handle-cancelled(h); }
    }
    ResizeHandle {
        handle-name: "rotate"; is-rotate: true; x: parent.width / 2 - 12px; y: -34px;
        slide-width: root.slide-width; slide-height: root.slide-height;
        focus-slide => { root.focus-slide(); }
        pressed(h, s) => { root.handle-pressed(h, s); }
        moved(h, dx, dy) => { root.handle-moved(h, dx, dy); }
        released(h) => { root.handle-released(h); }
        cancelled(h) => { root.handle-cancelled(h); }
    }
}
