import { LoomButton } from "foundation.slint";
import { Icon } from "icons.slint";
import { Theme } from "theme.slint";

export global PrintPreviewState {
    in-out property <bool> open: false;
    in-out property <int> layout-index: 0; // 0=Single, 1=2-up, 2=4-up, 3=6-up, 4=Notes
    in-out property <int> paper-size-index: 0; // 0=Letter, 1=A4, 2=Legal
    in-out property <bool> landscape: true;
    in-out property <bool> show-slide-numbers: true;
    in-out property <int> current-page: 1;
    in-out property <int> total-pages: 1;
    in-out property <string> current-slide-title: "Slide 1";
    in-out property <string> current-slide-notes: "";
    in-out property <bool> focus-request: false;
    callback close-preview();
    callback export-pdf();
    callback prev-page();
    callback next-page();
    callback settings-changed();
}

component OptionChip inherits FocusScope {
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    height: 30px;
    width: max(68px, chip-txt.preferred-width + 18px);

    key-pressed(event) => {
        if event.text == Key.Return || event.text == " " {
            root.clicked();
            return accept;
        }
        return reject;
    }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.tokens.metrics.radius-small;
        background: root.active ? Theme.palette().selection-soft : Theme.palette().surface-raised;
        border-width: root.has-focus ? 2px : 1px;
        border-color: root.has-focus ? Theme.palette().focus : (root.active ? Theme.palette().accent : Theme.palette().border);

        chip-txt := Text {
            text: root.label;
            color: root.active ? Theme.palette().accent : Theme.palette().ink;
            font-family: Theme.ui-font-family;
            font-size: Theme.type.caption;
            font-weight: root.active ? 700 : 500;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    TouchArea {
        accessible-role: button;
        accessible-label: root.label;
        clicked => { root.clicked(); }
    }
}

export component PrintPreviewModal inherits Rectangle {
    in property <bool> open: PrintPreviewState.open;
    property <bool> preview-open: root.open;
    property <bool> focus-req: PrintPreviewState.focus-request;

    width: 100%;
    height: 100%;
    visible: root.open;
    background: Theme.palette().scrim;

    changed preview-open => {
        if root.preview-open {
            key-handler.focus();
        }
    }

    changed focus-req => {
        if root.preview-open {
            key-handler.focus();
        }
    }

    TouchArea { width: 100%; height: 100%; }

    key-handler := FocusScope {
        width: min(940px, max(520px, parent.width - Theme.tokens.space.xl * 2));
        height: min(660px, max(440px, parent.height - Theme.tokens.space.xl * 2));
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        enabled: root.open;

        key-pressed(event) => {
            if event.text == Key.Escape {
                PrintPreviewState.close-preview();
                return accept;
            }
            if event.text == Key.LeftArrow {
                PrintPreviewState.prev-page();
                return accept;
            }
            if event.text == Key.RightArrow {
                PrintPreviewState.next-page();
                return accept;
            }
            return reject;
        }

        Rectangle {
            width: 100%;
            height: 100%;
            border-radius: Theme.tokens.metrics.radius-large;
            background: Theme.palette().surface;
            border-width: 1px;
            border-color: Theme.palette().border-strong;
            drop-shadow-blur: 28px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: Theme.palette().shadow;
            clip: true;

            VerticalLayout {
                width: 100%;
                height: 100%;

                // Header
                Rectangle {
                    height: 56px;
                    background: Theme.palette().chrome;

                    Text {
                        x: Theme.rtl ? parent.width - self.preferred-width - Theme.tokens.space.xl : Theme.tokens.space.xl;
                        y: (parent.height - self.height) / 2;
                        text: "Print Preview & Handouts";
                        color: Theme.palette().ink;
                        font-family: Theme.ui-font-family;
                        font-size: Theme.type.title;
                        font-weight: 700;
                    }

                    LoomButton {
                        x: Theme.rtl ? Theme.tokens.space.lg : parent.width - self.width - Theme.tokens.space.lg;
                        y: (parent.height - self.height) / 2;
                        width: 32px;
                        height: 32px;
                        icon: "close";
                        variant: "ghost";
                        accessible-name: "Close Print Preview";
                        clicked => { PrintPreviewState.close-preview(); }
                    }
                }

                Rectangle { height: 1px; background: Theme.palette().border; }

                // Split body: Sidebar controls + Scaled page preview
                HorizontalLayout {
                    vertical-stretch: 1;

                    // Left controls
                    Rectangle {
                        width: 280px;
                        background: Theme.palette().surface-sunken;

                        VerticalLayout {
                            padding: Theme.tokens.space.lg;
                            spacing: Theme.tokens.space.md;

                            Text {
                                text: "Layout";
                                color: Theme.palette().ink-secondary;
                                font-family: Theme.ui-font-family;
                                font-size: Theme.type.caption;
                                font-weight: 700;
                            }
                            HorizontalLayout {
                                spacing: Theme.tokens.space.xs;
                                OptionChip {
                                    label: "Single";
                                    active: PrintPreviewState.layout-index == 0;
                                    clicked => { PrintPreviewState.layout-index = 0; PrintPreviewState.settings-changed(); }
                                }
                                OptionChip {
                                    label: "2-up";
                                    active: PrintPreviewState.layout-index == 1;
                                    clicked => { PrintPreviewState.layout-index = 1; PrintPreviewState.settings-changed(); }
                                }
                                OptionChip {
                                    label: "4-up";
                                    active: PrintPreviewState.layout-index == 2;
                                    clicked => { PrintPreviewState.layout-index = 2; PrintPreviewState.settings-changed(); }
                                }
                            }
                            HorizontalLayout {
                                spacing: Theme.tokens.space.xs;
                                OptionChip {
                                    label: "6-up";
                                    active: PrintPreviewState.layout-index == 3;
                                    clicked => { PrintPreviewState.layout-index = 3; PrintPreviewState.settings-changed(); }
                                }
                                OptionChip {
                                    label: "Notes Page";
                                    active: PrintPreviewState.layout-index == 4;
                                    clicked => { PrintPreviewState.layout-index = 4; PrintPreviewState.settings-changed(); }
                                }
                            }

                            Text {
                                text: "Paper Size";
                                color: Theme.palette().ink-secondary;
                                font-family: Theme.ui-font-family;
                                font-size: Theme.type.caption;
                                font-weight: 700;
                            }
                            HorizontalLayout {
                                spacing: Theme.tokens.space.xs;
                                OptionChip {
                                    label: "Letter";
                                    active: PrintPreviewState.paper-size-index == 0;
                                    clicked => { PrintPreviewState.paper-size-index = 0; PrintPreviewState.settings-changed(); }
                                }
                                OptionChip {
                                    label: "A4";
                                    active: PrintPreviewState.paper-size-index == 1;
                                    clicked => { PrintPreviewState.paper-size-index = 1; PrintPreviewState.settings-changed(); }
                                }
                                OptionChip {
                                    label: "Legal";
                                    active: PrintPreviewState.paper-size-index == 2;
                                    clicked => { PrintPreviewState.paper-size-index = 2; PrintPreviewState.settings-changed(); }
                                }
                            }

                            Text {
                                text: "Orientation";
                                color: Theme.palette().ink-secondary;
                                font-family: Theme.ui-font-family;
                                font-size: Theme.type.caption;
                                font-weight: 700;
                            }
                            HorizontalLayout {
                                spacing: Theme.tokens.space.xs;
                                OptionChip {
                                    label: "Landscape";
                                    active: PrintPreviewState.landscape;
                                    clicked => { PrintPreviewState.landscape = true; PrintPreviewState.settings-changed(); }
                                }
                                OptionChip {
                                    label: "Portrait";
                                    active: !PrintPreviewState.landscape;
                                    clicked => { PrintPreviewState.landscape = false; PrintPreviewState.settings-changed(); }
                                }
                            }

                            OptionChip {
                                width: 100%;
                                label: PrintPreviewState.show-slide-numbers ? "Slide Numbers: On" : "Slide Numbers: Off";
                                active: PrintPreviewState.show-slide-numbers;
                                clicked => {
                                    PrintPreviewState.show-slide-numbers = !PrintPreviewState.show-slide-numbers;
                                    PrintPreviewState.settings-changed();
                                }
                            }
                        }
                    }

                    Rectangle { width: 1px; background: Theme.palette().border; }

                    // Right scaled page preview
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.palette().surface-sunken;

                        Rectangle {
                            width: PrintPreviewState.landscape ? min(440px, parent.width - 48px) : min(320px, parent.width - 48px);
                            height: PrintPreviewState.landscape ? self.width * 0.72 : self.width * 1.28;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            border-radius: 6px;
                            background: #ffffff;
                            border-width: 1px;
                            border-color: Theme.palette().border-strong;
                            drop-shadow-blur: 14px;
                            drop-shadow-offset-y: 4px;
                            drop-shadow-color: Theme.palette().shadow;

                            VerticalLayout {
                                padding: 20px;
                                spacing: 10px;
                                Text {
                                    text: PrintPreviewState.current-slide-title;
                                    color: #1f2328;
                                    font-family: Theme.ui-font-family;
                                    font-size: Theme.type.title;
                                    font-weight: 700;
                                    wrap: word-wrap;
                                }
                                if PrintPreviewState.layout-index == 4 && PrintPreviewState.current-slide-notes != "" : Text {
                                    text: PrintPreviewState.current-slide-notes;
                                    color: #475569;
                                    font-family: Theme.ui-font-family;
                                    font-size: Theme.type.body;
                                    wrap: word-wrap;
                                }
                            }

                            if PrintPreviewState.show-slide-numbers : Text {
                                x: parent.width - self.preferred-width - 14px;
                                y: parent.height - self.preferred-height - 10px;
                                text: PrintPreviewState.current-page + " / " + PrintPreviewState.total-pages;
                                color: #64748b;
                                font-family: Theme.ui-font-family;
                                font-size: Theme.type.caption;
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: Theme.palette().border; }

                // Footer
                Rectangle {
                    height: 56px;
                    background: Theme.palette().chrome;

                    HorizontalLayout {
                        padding-left: Theme.tokens.space.xl;
                        padding-right: Theme.tokens.space.xl;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: Theme.tokens.space.sm;
                            y: (parent.height - self.preferred-height) / 2;

                            LoomButton {
                                label: "Prev";
                                icon: "chevron-left";
                                variant: "secondary";
                                enabled: PrintPreviewState.current-page > 1;
                                accessible-name: "Previous Page";
                                clicked => { PrintPreviewState.prev-page(); }
                            }
                            Text {
                                text: "Page " + PrintPreviewState.current-page + " of " + PrintPreviewState.total-pages;
                                color: Theme.palette().ink-secondary;
                                font-family: Theme.ui-font-family;
                                font-size: Theme.type.label;
                                vertical-alignment: center;
                            }
                            LoomButton {
                                label: "Next";
                                icon: "chevron-right";
                                variant: "secondary";
                                enabled: PrintPreviewState.current-page < PrintPreviewState.total-pages;
                                accessible-name: "Next Page";
                                clicked => { PrintPreviewState.next-page(); }
                            }
                        }

                        HorizontalLayout {
                            spacing: Theme.tokens.space.sm;
                            y: (parent.height - self.preferred-height) / 2;

                            LoomButton {
                                label: "Close";
                                variant: "secondary";
                                accessible-name: "Close Print Preview";
                                clicked => { PrintPreviewState.close-preview(); }
                            }
                            LoomButton {
                                label: "Export PDF...";
                                icon: "download";
                                variant: "primary";
                                accessible-name: "Export Presentation as PDF";
                                clicked => { PrintPreviewState.export-pdf(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
