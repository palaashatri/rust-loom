import { LoomSectionHeader, LoomButton } from "foundation.slint";
import { Theme } from "theme.slint";

export component PresentTableInspector inherits VerticalLayout {
    in-out property <string> current-style-id: "table-style-medium-1";
    in-out property <bool> header-row: true;
    in-out property <bool> banded-rows: true;
    in-out property <bool> first-column: false;

    callback set-table-style(string);
    callback toggle-table-option(string);
    callback table-action(string);

    spacing: Theme.tokens.space.md;
    padding-left: Theme.tokens.space.md;
    padding-right: Theme.tokens.space.md;

    LoomSectionHeader { title: "Table Styles"; }

    VerticalLayout {
        spacing: Theme.tokens.space.sm;

        // Light styles
        HorizontalLayout {
            spacing: Theme.tokens.space.sm;
            LoomButton {
                label: "Light 1";
                variant: root.current-style-id == "table-style-light-1" ? "primary" : "secondary";
                clicked => { root.set-table-style("table-style-light-1"); }
            }
            LoomButton {
                label: "Light 2";
                variant: root.current-style-id == "table-style-light-2" ? "primary" : "secondary";
                clicked => { root.set-table-style("table-style-light-2"); }
            }
            LoomButton {
                label: "Light 3";
                variant: root.current-style-id == "table-style-light-3" ? "primary" : "secondary";
                clicked => { root.set-table-style("table-style-light-3"); }
            }
            LoomButton {
                label: "Light 4";
                variant: root.current-style-id == "table-style-light-4" ? "primary" : "secondary";
                clicked => { root.set-table-style("table-style-light-4"); }
            }
        }

        // Medium styles
        HorizontalLayout {
            spacing: Theme.tokens.space.sm;
            LoomButton {
                label: "Med 1";
                variant: root.current-style-id == "table-style-medium-1" ? "primary" : "secondary";
                clicked => { root.set-table-style("table-style-medium-1"); }
            }
            LoomButton {
                label: "Med 2";
                variant: root.current-style-id == "table-style-medium-2" ? "primary" : "secondary";
                clicked => { root.set-table-style("table-style-medium-2"); }
            }
            LoomButton {
                label: "Med 3";
                variant: root.current-style-id == "table-style-medium-3" ? "primary" : "secondary";
                clicked => { root.set-table-style("table-style-medium-3"); }
            }
            LoomButton {
                label: "Med 4";
                variant: root.current-style-id == "table-style-medium-4" ? "primary" : "secondary";
                clicked => { root.set-table-style("table-style-medium-4"); }
            }
        }

        // Dark styles
        HorizontalLayout {
            spacing: Theme.tokens.space.sm;
            LoomButton {
                label: "Dark 1";
                variant: root.current-style-id == "table-style-dark-1" ? "primary" : "secondary";
                clicked => { root.set-table-style("table-style-dark-1"); }
            }
            LoomButton {
                label: "Dark 2";
                variant: root.current-style-id == "table-style-dark-2" ? "primary" : "secondary";
                clicked => { root.set-table-style("table-style-dark-2"); }
            }
            LoomButton {
                label: "Dark 3";
                variant: root.current-style-id == "table-style-dark-3" ? "primary" : "secondary";
                clicked => { root.set-table-style("table-style-dark-3"); }
            }
            LoomButton {
                label: "Dark 4";
                variant: root.current-style-id == "table-style-dark-4" ? "primary" : "secondary";
                clicked => { root.set-table-style("table-style-dark-4"); }
            }
        }
    }

    LoomSectionHeader { title: "Table Options"; }

    VerticalLayout {
        spacing: Theme.tokens.space.sm;
        HorizontalLayout {
            spacing: Theme.tokens.space.sm;
            LoomButton {
                label: "Header Row";
                variant: root.header-row ? "primary" : "secondary";
                clicked => { root.toggle-table-option("header_row"); }
            }
            LoomButton {
                label: "Banded Rows";
                variant: root.banded-rows ? "primary" : "secondary";
                clicked => { root.toggle-table-option("banded_rows"); }
            }
            LoomButton {
                label: "First Column";
                variant: root.first-column ? "primary" : "secondary";
                clicked => { root.toggle-table-option("first_column"); }
            }
        }
    }

    LoomSectionHeader { title: "Rows & Columns"; }

    VerticalLayout {
        spacing: Theme.tokens.space.sm;
        HorizontalLayout {
            spacing: Theme.tokens.space.sm;
            LoomButton {
                label: "+ Row Above";
                variant: "secondary";
                clicked => { root.table-action("add_row_above"); }
            }
            LoomButton {
                label: "+ Row Below";
                variant: "secondary";
                clicked => { root.table-action("add_row_below"); }
            }
            LoomButton {
                label: "Del Row";
                variant: "secondary";
                clicked => { root.table-action("del_row"); }
            }
        }
        HorizontalLayout {
            spacing: Theme.tokens.space.sm;
            LoomButton {
                label: "+ Col Left";
                variant: "secondary";
                clicked => { root.table-action("add_col_left"); }
            }
            LoomButton {
                label: "+ Col Right";
                variant: "secondary";
                clicked => { root.table-action("add_col_right"); }
            }
            LoomButton {
                label: "Del Col";
                variant: "secondary";
                clicked => { root.table-action("del_col"); }
            }
        }
    }
}
