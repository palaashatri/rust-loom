import { Theme } from "theme.slint";

/// The scene-model canvas keeps element coordinates in slide space.
export component PresentSlideCanvas inherits Rectangle {
    in property <bool> aspect-ratio-wide: true;
    in property <[string]> element-labels: [];
    in property <[string]> element-contents: [];
    /// Faint prompt for an empty text element; never part of the deck.
    in property <[string]> element-placeholders: [];
    in property <[float]> element-xs: [];
    in property <[float]> element-ys: [];
    in property <[float]> element-widths: [];
    in property <[float]> element-heights: [];
    in property <[float]> element-rotations: [];
    in property <[int]> element-types: [];
    in property <[image]> element-images: [];
    in property <[bool]> element-selected: [];
    in property <int> selection-count: 0;
    in property <bool> editing-enabled: true;
    /// Slideshow mode: the slide fills the window and text scales with it.
    in property <bool> fit-screen: false;
    /// Editor zoom: 1.0 fits the pane, smaller values shrink the slide.
    in property <float> zoom: 1.0;
    in property <[float]> snap-guides-x: [];
    in property <[float]> snap-guides-y: [];
    in property <float> marquee-x: 0;
    in property <float> marquee-y: 0;
    in property <float> marquee-width: 0;
    in property <float> marquee-height: 0;
    in property <bool> marquee-visible: false;
    in property <int> active-element-index: 0;
    /// The element whose text is being edited on the slide, or -1.
    in-out property <int> editing-idx: -1;

    callback select-element(int);
    callback canvas-pressed(float, float, bool);
    callback canvas-moved(float, float);
    callback canvas-released(float, float);
    callback canvas-cancelled;
    callback canvas-key-pressed(string, bool, bool) -> EventResult;
    callback element-pressed(int, bool);
    callback element-moved(int, float, float);
    callback element-released(int);
    callback element-cancelled(int);
    callback handle-pressed(int, string, bool);
    callback handle-moved(int, string, float, float);
    callback handle-released(int, string);
    callback handle-cancelled(int, string);
    callback content-edited(string);

    background: Theme.palette().canvas;

    /// Give the slide editor keyboard focus (arrows, Delete, shortcuts).
    public function focus-slide() { slide-focus.focus(); }

    slide-focus := FocusScope {
        enabled: root.editing-enabled;
        key-pressed(event) => {
            // Tab and Shift+Tab walk the objects on the slide (the first Tab selects
            // the first object); past the last or first one they leave the canvas, so
            // the slide never traps the keyboard. Enter or F2 edits the selected
            // object's text where it stands; Escape stops editing.
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                let back = event.text == Key.Backtab || event.modifiers.shift;
                let next = root.selection-count == 0 ? (back ? root.element-xs.length - 1 : 0) : root.active-element-index + (back ? -1 : 1);
                if (next >= 0 && next < root.element-xs.length) { root.select-element(next); return accept; }
                return reject;
            }
            if ((event.text == Key.Return || event.text == Key.F2) && !event.modifiers.control && !event.modifiers.meta
                && root.selection-count == 1 && root.active-element-index < root.element-types.length
                && root.element-types[root.active-element-index] != 6) {
                root.editing-idx = root.active-element-index;
                return accept;
            }
            return root.canvas-key-pressed(event.text, event.modifiers.shift, event.modifiers.control || event.modifiers.meta);
        }

        slide := Rectangle {
            property <float> slide-ratio: root.aspect-ratio-wide ? 0.5625 : 0.75;
            property <length> margin: root.fit-screen ? 0px : Theme.tokens.space.xxl;
            property <float> text-scale: root.fit-screen || root.zoom < 1.0 ? self.width / 840px : 1.0;
            x: max(self.margin, (parent.width - self.width) / 2);
            y: max(self.margin, (parent.height - self.height) / 2);
            width: min(root.fit-screen ? 100000px : 840px, max(1px, min(parent.width - self.margin * 2, (parent.height - self.margin * 2) / self.slide-ratio))) * root.zoom;
            height: min(parent.height - self.margin * 2, self.width * self.slide-ratio);
            border-radius: Theme.tokens.metrics.radius-small;
            border-width: 1px;
            border-color: Theme.palette().border;
            background: Theme.palette().paper;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: Theme.palette().shadow;
            clip: true;

            canvas-touch := TouchArea {
                enabled: root.editing-enabled;
                width: 100%;
                height: 100%;
                pointer-event(event) => {
                    let domain_x = self.mouse-x * 1000.0 / parent.width;
                    let domain_y = self.mouse-y * 562.5 / parent.height;
                    if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                        slide-focus.focus();
                        root.canvas-pressed(domain_x, domain_y, event.modifiers.shift);
                    } else if (event.kind == PointerEventKind.cancel) {
                        root.canvas-cancelled();
                    } else if (event.kind == PointerEventKind.up) {
                        root.canvas-released(domain_x, domain_y);
                    }
                }
                moved => {
                    if self.pressed {
                        let domain_x = self.mouse-x * 1000.0 / parent.width;
                        let domain_y = self.mouse-y * 562.5 / parent.height;
                        root.canvas-moved(domain_x, domain_y);
                    }
                }
            }

            for guide_x in root.snap-guides-x : Rectangle {
                x: guide_x * parent.width / 1000.0;
                y: 0px;
                width: 1px;
                height: parent.height;
                background: Theme.palette().focus;
                opacity: root.editing-enabled ? 0.7 : 0;
            }
            for guide_y in root.snap-guides-y : Rectangle {
                x: 0px;
                y: guide_y * parent.height / 562.5;
                width: parent.width;
                height: 1px;
                background: Theme.palette().focus;
                opacity: root.editing-enabled ? 0.7 : 0;
            }
            if root.marquee-visible && root.editing-enabled : Rectangle {
                x: root.marquee-x * parent.width / 1000.0;
                y: root.marquee-y * parent.height / 562.5;
                width: root.marquee-width * parent.width / 1000.0;
                height: root.marquee-height * parent.height / 562.5;
                border-width: 1px;
                border-color: Theme.palette().accent;
                background: Theme.palette().selection-soft;
                opacity: 0.45;
            }

            for element_x[idx] in root.element-xs : Rectangle {
                property <length> render-x: clamp(element_x * parent.width / 1000.0, 0px, max(0px, parent.width - 2px));
                property <length> render-y: clamp(root.element-ys[idx] * parent.height / 562.5, 0px, max(0px, parent.height - 2px));
                property <length> render-width: max(1px, min(root.element-widths[idx] * parent.width / 1000.0, max(1px, parent.width - self.render-x - 2px)));
                property <length> render-height: max(1px, min(root.element-heights[idx] * parent.height / 562.5, max(1px, parent.height - self.render-y - 2px)));
                x: self.render-x;
                y: self.render-y;
                width: self.render-width;
                height: self.render-height;
                border-radius: root.element-types[idx] == 4 ? self.width / 2 : Theme.tokens.metrics.radius-small;
                border-width: root.editing-enabled && root.element-selected.length > idx && root.element-selected[idx] ? 2px : 0px;
                border-color: Theme.palette().accent;
                background: root.element-types[idx] == 3 ? Theme.palette().content-accent-soft
                    : root.element-types[idx] == 4 ? Theme.palette().content-cool-soft
                    : root.element-types[idx] == 5 ? Theme.palette().content-accent
                    : transparent;
                transform-origin: { x: self.width / 2, y: self.height / 2 };
                transform-rotation: root.element-rotations.length > idx ? root.element-rotations[idx] * 1deg : 0deg;
                accessible-role: button;
                accessible-enabled: root.editing-enabled;
                accessible-label: root.element-labels[idx];
                accessible-action-default => { root.select-element(idx); root.element-pressed(idx, false); slide-focus.focus(); }

                Text {
                    visible: root.editing-idx != idx && root.element-types[idx] != 6;
                    x: Theme.tokens.space.sm;
                    y: Theme.tokens.space.xs;
                    width: max(1px, parent.width - Theme.tokens.space.lg * 2);
                    height: max(1px, parent.height - Theme.tokens.space.sm * 2);
                    text: root.element-contents[idx];
                    font-size: (root.element-types[idx] == 0 ? Theme.tokens.typography.display
                        : root.element-types[idx] == 5 ? Theme.tokens.typography.heading : Theme.tokens.typography.body-large) * slide.text-scale;
                    font-weight: root.element-types[idx] == 0 || root.element-types[idx] == 5 ? 700 : 400;
                    color: root.element-types[idx] == 3 || root.element-types[idx] == 4 ? Theme.palette().ink
                        : root.element-types[idx] == 1 || root.element-types[idx] == 2 ? Theme.palette().paper-muted
                        : Theme.palette().paper-ink;
                    horizontal-alignment: root.element-types[idx] == 0 || root.element-types[idx] == 5 ? center : left;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    overflow: elide;
                }

                if root.editing-enabled && root.editing-idx != idx && root.element-placeholders.length > idx && root.element-placeholders[idx] != "" : Text {
                    x: Theme.tokens.space.sm;
                    y: Theme.tokens.space.xs;
                    width: max(1px, parent.width - Theme.tokens.space.lg * 2);
                    height: max(1px, parent.height - Theme.tokens.space.sm * 2);
                    text: root.element-placeholders[idx];
                    font-size: (root.element-types[idx] == 0 ? Theme.tokens.typography.display : Theme.tokens.typography.body-large) * slide.text-scale;
                    color: Theme.palette().paper-muted;
                    opacity: 0.6;
                    horizontal-alignment: root.element-types[idx] == 0 ? center : left;
                    vertical-alignment: center;
                    overflow: elide;
                    accessible-role: none;
                }

                if root.element-types[idx] == 6 : Image {
                    width: 100%;
                    height: 100%;
                    source: root.element-images[idx];
                    image-fit: fill;
                    accessible-role: none;
                }

                element-touch := TouchArea {
                    // The area travels with the element, so the drag is measured
                    // against the pointer's window position, not the area's own.
                    property <length> press-abs-x;
                    property <length> press-abs-y;
                    enabled: root.editing-enabled;
                    width: 100%;
                    height: 100%;
                    mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.default;
                    double-clicked => { if (root.editing-enabled && root.element-types[idx] != 6) { root.editing-idx = idx; } }
                    pointer-event(event) => {
                        if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                            slide-focus.focus(); self.press-abs-x = self.absolute-position.x + self.mouse-x; self.press-abs-y = self.absolute-position.y + self.mouse-y;
                            root.element-pressed(idx, event.modifiers.shift);
                        } else if (event.kind == PointerEventKind.cancel) {
                            root.element-cancelled(idx);
                        } else if (event.kind == PointerEventKind.up) {
                            root.element-released(idx);
                        }
                    }
                    moved => {
                        if self.pressed {
                            root.element-moved(idx, (self.absolute-position.x + self.mouse-x - self.press-abs-x) * 1000.0 / slide.width, (self.absolute-position.y + self.mouse-y - self.press-abs-y) * 562.5 / slide.height);
                        }
                    }
                }

                // Double-click edits the text where it stands. The editor sits
                // over the text with the same type, so nothing jumps.
                if root.editing-enabled && root.editing-idx == idx : TextInput {
                    x: Theme.tokens.space.sm;
                    y: Theme.tokens.space.xs;
                    width: max(1px, parent.width - Theme.tokens.space.lg * 2);
                    height: max(1px, parent.height - Theme.tokens.space.sm * 2);
                    text: root.element-contents[idx];
                    font-size: (root.element-types[idx] == 0 ? Theme.tokens.typography.display
                        : root.element-types[idx] == 5 ? Theme.tokens.typography.heading : Theme.tokens.typography.body-large) * slide.text-scale;
                    font-weight: root.element-types[idx] == 0 || root.element-types[idx] == 5 ? 700 : 400;
                    color: Theme.palette().paper-ink;
                    horizontal-alignment: root.element-types[idx] == 0 || root.element-types[idx] == 5 ? center : left;
                    vertical-alignment: center;
                    wrap: word-wrap;
                    single-line: false;
                    accessible-label: "Edit text";
                    init => { self.focus(); self.select-all(); }
                    changed has-focus => { if (!self.has-focus) { root.editing-idx = -1; } }
                    edited => { root.content-edited(self.text); }
                    key-pressed(event) => {
                        if (event.text == Key.Escape) { root.editing-idx = -1; slide-focus.focus(); return accept; }
                        return reject;
                    }
                }

                if root.editing-enabled && root.selection-count == 1 && root.element-selected.length > idx && root.element-selected[idx] : Rectangle {
                    x: -5px; y: -5px; width: 10px; height: 10px; border-radius: 5px; background: Theme.palette().paper; border-width: 1px; border-color: Theme.palette().accent;
                    TouchArea {
                        width: 100%; height: 100%;
                        property <length> press-abs-x;
                        property <length> press-abs-y;
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { slide-focus.focus(); self.press-abs-x = self.absolute-position.x + self.mouse-x; self.press-abs-y = self.absolute-position.y + self.mouse-y; root.handle-pressed(idx, "nw", event.modifiers.shift); }
                            if (event.kind == PointerEventKind.cancel) { root.handle-cancelled(idx, "nw"); }
                            if (event.kind == PointerEventKind.up) { root.handle-released(idx, "nw"); }
                        }
                        moved => { if self.pressed { root.handle-moved(idx, "nw", (self.absolute-position.x + self.mouse-x - self.press-abs-x) * 1000.0 / slide.width, (self.absolute-position.y + self.mouse-y - self.press-abs-y) * 562.5 / slide.height); } }
                    }
                }
                if root.editing-enabled && root.selection-count == 1 && root.element-selected.length > idx && root.element-selected[idx] : Rectangle {
                    x: parent.width - 5px; y: -5px; width: 10px; height: 10px; border-radius: 5px; background: Theme.palette().paper; border-width: 1px; border-color: Theme.palette().accent;
                    TouchArea {
                        width: 100%; height: 100%;
                        property <length> press-abs-x;
                        property <length> press-abs-y;
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { slide-focus.focus(); self.press-abs-x = self.absolute-position.x + self.mouse-x; self.press-abs-y = self.absolute-position.y + self.mouse-y; root.handle-pressed(idx, "ne", event.modifiers.shift); }
                            if (event.kind == PointerEventKind.cancel) { root.handle-cancelled(idx, "ne"); }
                            if (event.kind == PointerEventKind.up) { root.handle-released(idx, "ne"); }
                        }
                        moved => { if self.pressed { root.handle-moved(idx, "ne", (self.absolute-position.x + self.mouse-x - self.press-abs-x) * 1000.0 / slide.width, (self.absolute-position.y + self.mouse-y - self.press-abs-y) * 562.5 / slide.height); } }
                    }
                }
                if root.editing-enabled && root.selection-count == 1 && root.element-selected.length > idx && root.element-selected[idx] : Rectangle {
                    x: -5px; y: parent.height - 5px; width: 10px; height: 10px; border-radius: 5px; background: Theme.palette().paper; border-width: 1px; border-color: Theme.palette().accent;
                    TouchArea {
                        width: 100%; height: 100%;
                        property <length> press-abs-x;
                        property <length> press-abs-y;
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { slide-focus.focus(); self.press-abs-x = self.absolute-position.x + self.mouse-x; self.press-abs-y = self.absolute-position.y + self.mouse-y; root.handle-pressed(idx, "sw", event.modifiers.shift); }
                            if (event.kind == PointerEventKind.cancel) { root.handle-cancelled(idx, "sw"); }
                            if (event.kind == PointerEventKind.up) { root.handle-released(idx, "sw"); }
                        }
                        moved => { if self.pressed { root.handle-moved(idx, "sw", (self.absolute-position.x + self.mouse-x - self.press-abs-x) * 1000.0 / slide.width, (self.absolute-position.y + self.mouse-y - self.press-abs-y) * 562.5 / slide.height); } }
                    }
                }
                if root.editing-enabled && root.selection-count == 1 && root.element-selected.length > idx && root.element-selected[idx] : Rectangle {
                    x: parent.width - 5px; y: parent.height - 5px; width: 10px; height: 10px; border-radius: 5px; background: Theme.palette().paper; border-width: 1px; border-color: Theme.palette().accent;
                    TouchArea {
                        width: 100%; height: 100%;
                        property <length> press-abs-x;
                        property <length> press-abs-y;
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { slide-focus.focus(); self.press-abs-x = self.absolute-position.x + self.mouse-x; self.press-abs-y = self.absolute-position.y + self.mouse-y; root.handle-pressed(idx, "se", event.modifiers.shift); }
                            if (event.kind == PointerEventKind.cancel) { root.handle-cancelled(idx, "se"); }
                            if (event.kind == PointerEventKind.up) { root.handle-released(idx, "se"); }
                        }
                        moved => { if self.pressed { root.handle-moved(idx, "se", (self.absolute-position.x + self.mouse-x - self.press-abs-x) * 1000.0 / slide.width, (self.absolute-position.y + self.mouse-y - self.press-abs-y) * 562.5 / slide.height); } }
                    }
                }
                if root.editing-enabled && root.selection-count == 1 && root.element-selected.length > idx && root.element-selected[idx] : Rectangle {
                    x: parent.width / 2 - 5px; y: -30px; width: 10px; height: 10px; border-radius: 5px; background: Theme.palette().accent;
                    TouchArea {
                        width: 100%; height: 100%;
                        property <length> press-abs-x;
                        property <length> press-abs-y;
                        pointer-event(event) => {
                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { slide-focus.focus(); self.press-abs-x = self.absolute-position.x + self.mouse-x; self.press-abs-y = self.absolute-position.y + self.mouse-y; root.handle-pressed(idx, "rotate", event.modifiers.shift); }
                            if (event.kind == PointerEventKind.cancel) { root.handle-cancelled(idx, "rotate"); }
                            if (event.kind == PointerEventKind.up) { root.handle-released(idx, "rotate"); }
                        }
                        moved => { if self.pressed { root.handle-moved(idx, "rotate", (self.absolute-position.x + self.mouse-x - self.press-abs-x) * 1000.0 / slide.width, (self.absolute-position.y + self.mouse-y - self.press-abs-y) * 562.5 / slide.height); } }
                    }
                }
            }
        }
    }
}
