import { LoomButton } from "foundation.slint";
import { Theme } from "theme.slint";

export component SaveChangesDialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> document-name: "";
    in property <bool> closing: false;
    in property <bool> rtl: false;

    callback save();
    callback discard();
    callback cancel();

    visible: root.open;

    if root.open : save-changes-focus := FocusScope {
        width: root.width;
        height: root.height;
        init => { save-button.grab-focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.cancel(); return accept; }
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                if (event.text == Key.Backtab || event.modifiers.shift) {
                    if (save-button.has-focus) { discard-button.grab-focus(); } else if (discard-button.has-focus) { cancel-button.grab-focus(); } else { save-button.grab-focus(); }
                } else {
                    if (cancel-button.has-focus) { discard-button.grab-focus(); } else if (discard-button.has-focus) { save-button.grab-focus(); } else { cancel-button.grab-focus(); }
                }
                return accept;
            }
            return reject;
        }
        Rectangle {
            width: parent.width;
            height: parent.height;
            background: #00000066;
            TouchArea { clicked => { save-changes-focus.focus(); } }
            Rectangle {
                width: min(440px * max(1.0, Theme.text-scale), root.width - 48px);
                height: min(save-changes-layout.preferred-height, root.height - 48px);
                x: (root.width - self.width) / 2;
                y: (root.height - self.height) / 2;
                background: Theme.palette().surface;
                border-width: 1px;
                border-color: Theme.palette().border;
                border-radius: 12px;
                save-changes-layout := VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    Text {
                        text: "Save changes?";
                        font-size: 22px * max(1.0, Theme.text-scale);
                        font-weight: 700;
                        color: Theme.palette().ink;
                        horizontal-alignment: root.rtl ? right : left;
                    }
                    Text {
                        text: "Save changes to \"" + root.document-name + "\" before " + (root.closing ? "closing" : "replacing it") + "?";
                        color: Theme.palette().ink-secondary;
                        font-size: Theme.type.body;
                        wrap: word-wrap;
                        horizontal-alignment: root.rtl ? right : left;
                    }
                    Rectangle {
                        height: Theme.tokens.metrics.control-height;
                        save-button := LoomButton {
                            label: root.closing ? "Save and close" : "Save";
                            variant: "primary";
                            width: self.preferred-width;
                            height: Theme.tokens.metrics.control-height;
                            x: root.rtl ? 0px : parent.width - self.width;
                            clicked => { root.save(); }
                        }
                        discard-button := LoomButton {
                            label: "Discard";
                            variant: "danger";
                            width: self.preferred-width;
                            height: Theme.tokens.metrics.control-height;
                            x: root.rtl ? save-button.width + 8px : save-button.x - 8px - self.width;
                            clicked => { root.discard(); }
                        }
                        cancel-button := LoomButton {
                            label: "Cancel";
                            variant: "secondary";
                            width: self.preferred-width;
                            height: Theme.tokens.metrics.control-height;
                            x: root.rtl ? discard-button.x + discard-button.width + 8px : discard-button.x - 8px - self.width;
                            clicked => { root.cancel(); }
                        }
                    }
                }
            }
        }
    }
}
