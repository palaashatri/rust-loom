import { Theme } from "theme.slint";
import { LoomButton } from "foundation.slint";

component EffectStepRow inherits HorizontalLayout {
    in property <string> label-text: "";
    callback dec();
    callback inc();
    spacing: Theme.tokens.space.xs;
    if Theme.rtl : LoomButton { label: "+"; clicked => { root.inc(); } }
    if Theme.rtl : LoomButton { label: "-"; clicked => { root.dec(); } }
    Text {
        text: root.label-text;
        font-size: Theme.type.caption;
        color: Theme.palette().ink;
        vertical-alignment: center;
        horizontal-alignment: Theme.rtl ? right : left;
        horizontal-stretch: 1;
    }
    if !Theme.rtl : LoomButton { label: "-"; clicked => { root.dec(); } }
    if !Theme.rtl : LoomButton { label: "+"; clicked => { root.inc(); } }
}

export component StyleEffectsPanel inherits VerticalLayout {
    in property <bool> has-selection: false;
    in property <int> opacity-pct: 100;
    in property <int> corner-radius-px: 0;
    in property <int> stroke-width-px: 0;
    in property <int> stroke-dash: 0; // 0=Solid, 1=Dashed, 2=Dotted
    in property <bool> has-shadow: false;
    in property <bool> has-gradient: false;

    callback set-opacity(int);
    callback set-corner-radius(int);
    callback set-stroke-width(int);
    callback cycle-stroke-dash();
    callback toggle-shadow();
    callback toggle-gradient();

    spacing: Theme.tokens.space.xs;
    visible: root.has-selection;

    Text {
        text: "Effects";
        font-size: Theme.type.caption;
        font-weight: 600;
        color: Theme.palette().ink-secondary;
        horizontal-alignment: Theme.rtl ? right : left;
    }

    EffectStepRow {
        label-text: "Opacity " + root.opacity-pct + "%";
        dec => { root.set-opacity(Math.max(10, root.opacity-pct - 10)); }
        inc => { root.set-opacity(Math.min(100, root.opacity-pct + 10)); }
    }

    EffectStepRow {
        label-text: "Radius " + root.corner-radius-px + "px";
        dec => { root.set-corner-radius(Math.max(0, root.corner-radius-px - 4)); }
        inc => { root.set-corner-radius(Math.min(48, root.corner-radius-px + 4)); }
    }

    EffectStepRow {
        label-text: "Stroke " + root.stroke-width-px + "px (" + (root.stroke-dash == 0 ? "Solid" : (root.stroke-dash == 1 ? "Dash" : "Dot")) + ")";
        dec => { root.set-stroke-width(Math.max(0, root.stroke-width-px - 1)); }
        inc => { root.set-stroke-width(Math.min(12, root.stroke-width-px + 1)); }
    }

    HorizontalLayout {
        spacing: Theme.tokens.space.xs;
        if Theme.rtl : LoomButton {
            label: root.has-gradient ? "Gradient: On" : "Gradient: Off";
            variant: root.has-gradient ? "primary" : "secondary";
            clicked => { root.toggle-gradient(); }
        }
        LoomButton {
            label: root.has-shadow ? "Shadow: On" : "Shadow: Off";
            variant: root.has-shadow ? "primary" : "secondary";
            clicked => { root.toggle-shadow(); }
        }
        if !Theme.rtl : LoomButton {
            label: root.has-gradient ? "Gradient: On" : "Gradient: Off";
            variant: root.has-gradient ? "primary" : "secondary";
            clicked => { root.toggle-gradient(); }
        }
    }
}
