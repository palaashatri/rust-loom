import {
    LoomButton, LoomIconButton, LoomStatusBar, LoomStatusText,
} from "foundation.slint";
import { Theme } from "theme.slint";
export { PresentSlideCanvas } from "slide_canvas.slint";
export { PresentSlideStrip, ThumbRows, MiniSlide } from "slide_thumbs.slint";

export component PresentNotesEditor inherits Rectangle {
    in-out property <string> text: "";
    in property <string> placeholder-text: "";
    in property <bool> enabled: true;
    in property <length> font-size: Theme.type.body;
    callback edited(string);
    callback key-pressed(event: KeyEvent) -> EventResult;
    callback key-released(event: KeyEvent) -> EventResult;

    border-radius: Theme.tokens.metrics.radius-small;
    border-width: notes-input.has-focus ? 2px : 1px;
    border-color: notes-input.has-focus ? Theme.palette().focus : Theme.palette().border-strong;
    background: root.enabled ? Theme.palette().surface-raised : Theme.palette().surface-sunken;
    clip: true;
    forward-focus: notes-input;

    if root.text == "" : Text {
        x: Theme.tokens.space.lg;
        y: Theme.tokens.space.sm;
        width: max(1px, root.width - Theme.tokens.space.xl);
        height: max(1px, root.height - Theme.tokens.space.lg);
        text: root.placeholder-text;
        font-size: root.font-size;
        color: Theme.palette().ink-disabled;
        vertical-alignment: top;
        wrap: word-wrap;
    }

    notes-input := TextInput {
        x: Theme.tokens.space.lg;
        y: Theme.tokens.space.sm;
        width: max(1px, root.width - Theme.tokens.space.xl);
        height: max(1px, root.height - Theme.tokens.space.lg);
        text <=> root.text;
        enabled: root.enabled;
        single-line: false;
        accessible-label: "Speaker notes";
        wrap: word-wrap;
        vertical-alignment: top;
        font-size: root.font-size;
        color: root.enabled ? Theme.palette().ink : Theme.palette().ink-disabled;
        selection-background-color: Theme.palette().selection;
        selection-foreground-color: Theme.palette().accent-ink;
        edited => { root.edited(notes-input.text); }
        key-pressed(event) => { return root.key-pressed(event); }
        key-released(event) => { return root.key-released(event); }
    }
}

export component PresentStatusBar inherits LoomStatusBar {
    in property <string> leading-text: "";
    in property <string> trailing-text: "";

    LoomStatusText {
        text: root.leading-text;
    }
    Rectangle { horizontal-stretch: 1; }
    LoomStatusText {
        text: root.trailing-text;
    }
}

/// Commands that have no toolbar item of their own.
export component PresentToolbarOverflow inherits Rectangle {
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    callback undo;
    callback redo;
    callback open-theme-chooser;
    callback export-pdf;
    callback export-pptx;
    callback close-requested;

    min-width: 220px * max(1.0, Theme.text-scale);
    max-width: 300px * max(1.0, Theme.text-scale);
    preferred-width: 256px * max(1.0, Theme.text-scale);
    border-radius: Theme.tokens.metrics.radius-medium;
    border-width: 1px;
    border-color: Theme.palette().border;
    background: Theme.palette().surface;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Theme.palette().shadow;

    // Focus starts on the first enabled command and Escape closes the menu from
    // any of them; Tab walks the commands.
    init => { if (root.can-undo) { undo-button.grab-focus(); } else if (root.can-redo) { redo-button.grab-focus(); } else { theme-button.grab-focus(); } }
    FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.close-requested(); return accept; }
            return reject;
        }

    VerticalLayout {
        spacing: Theme.tokens.space.xs;
        padding: Theme.tokens.space.sm;

        undo-button := LoomButton {
            icon: "undo";
            label: "Undo";
            variant: "ghost";
            enabled: root.can-undo;
            clicked => { root.undo(); root.close-requested(); }
        }
        redo-button := LoomButton {
            icon: "redo";
            label: "Redo";
            variant: "ghost";
            enabled: root.can-redo;
            clicked => { root.redo(); root.close-requested(); }
        }
        theme-button := LoomButton {
            icon: "format";
            label: "Choose theme";
            variant: "ghost";
            clicked => { root.open-theme-chooser(); root.close-requested(); }
        }
        LoomButton {
            icon: "export";
            label: "Export PDF";
            variant: "ghost";
            clicked => { root.export-pdf(); root.close-requested(); }
        }
        LoomButton {
            icon: "export";
            label: "Export PowerPoint";
            variant: "ghost";
            clicked => { root.export-pptx(); root.close-requested(); }
        }
    }
    }
}
