import { LoomButton } from "foundation.slint";
import { Theme } from "theme.slint";

export component PptxImportWarningDialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> warning-message: "";

    callback import-cancel;
    callback import-continue;

    visible: root.open;

    public function focus-dialog() {
        cancel-button.grab-focus();
    }

    changed open => {
        if (root.open) {
            cancel-button.grab-focus();
        }
    }

    warning-focus := FocusScope {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        enabled: root.open;
        visible: root.open;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.import-cancel();
                return accept;
            }
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                if (cancel-button.has-focus) {
                    continue-button.grab-focus();
                } else {
                    cancel-button.grab-focus();
                }
                return accept;
            }
            return reject;
        }

        TouchArea {
            clicked => {
                cancel-button.grab-focus();
            }
        }

        Rectangle {
            x: 0px;
            y: 0px;
            width: root.width;
            height: root.height;
            background: Theme.palette().scrim;
        }

        dialog-panel := Rectangle {
            width: min(520px * max(1.0, Theme.text-scale), root.width - 48px);
            height: min(dialog-layout.preferred-height, root.height - 48px);
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            background: Theme.palette().surface;
            border-width: 1px;
            border-color: Theme.palette().border;
            border-radius: Theme.tokens.metrics.radius-large;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: Theme.palette().shadow;

            dialog-layout := VerticalLayout {
                padding: Theme.tokens.space.xxl;
                spacing: Theme.tokens.space.lg;

                Text {
                    text: "PowerPoint Import Notice";
                    font-size: Theme.tokens.typography.heading * max(1.0, Theme.text-scale);
                    font-weight: 700;
                    color: Theme.palette().ink;
                    horizontal-alignment: Theme.rtl ? right : left;
                }

                Text {
                    text: root.warning-message != "" ? root.warning-message : "This PowerPoint deck contains unsupported constructs that may be omitted during import.";
                    color: Theme.palette().ink-secondary;
                    font-size: Theme.type.body;
                    wrap: word-wrap;
                    horizontal-alignment: Theme.rtl ? right : left;
                }

                Rectangle {
                    height: Theme.tokens.metrics.control-height;
                    continue-button := LoomButton {
                        label: "Continue Import";
                        variant: "primary";
                        width: self.preferred-width;
                        height: Theme.tokens.metrics.control-height;
                        x: Theme.rtl ? 0px : parent.width - self.width;
                        clicked => { root.import-continue(); }
                    }
                    cancel-button := LoomButton {
                        label: "Cancel";
                        variant: "secondary";
                        width: self.preferred-width;
                        height: Theme.tokens.metrics.control-height;
                        x: Theme.rtl ? continue-button.width + Theme.tokens.space.sm : continue-button.x - Theme.tokens.space.sm - self.width;
                        clicked => { root.import-cancel(); }
                    }
                }
            }
        }
    }
}
