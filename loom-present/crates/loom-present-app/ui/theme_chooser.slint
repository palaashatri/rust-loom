import {
    LoomButton,
} from "foundation.slint";
import { Theme } from "theme.slint";
import { Icon } from "icons.slint";

component PresentThemeCard inherits Rectangle {
    in property <string> title: "Theme";
    in property <bool> selected: false;
    in property <length> preview-width: 180px;
    in property <length> preview-height: 101px;
    in property <color> preview-background: Theme.palette().paper;
    callback clicked;

    width: root.preview-width + 20px;
    height: root.preview-height + 38px + 22px * max(1.0, Theme.text-scale);
    border-radius: Theme.tokens.metrics.radius-medium;
    background: touch.has-hover && !root.selected ? Theme.palette().surface-raised : transparent;
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { root.clicked(); }

    VerticalLayout {
        spacing: 8px;
        padding: 8px;
        alignment: center;
        cross-axis-alignment: center;

        Rectangle {
            width: root.preview-width;
            height: root.preview-height;
            border-radius: Theme.tokens.metrics.radius-small;
            background: root.preview-background;
            border-width: root.selected ? 2px : 1px;
            border-color: root.selected ? Theme.palette().accent : Theme.palette().border;
            drop-shadow-blur: 10px;
            drop-shadow-offset-y: 3px;
            drop-shadow-color: Theme.palette().shadow;
            clip: true;
            @children
        }

        if root.selected : Rectangle {
            height: 22px * max(1.0, Theme.text-scale);
            border-radius: Theme.tokens.metrics.radius-small;
            background: Theme.palette().accent;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                alignment: center;
                cross-axis-alignment: center;
                Text {
                    text: root.title;
                    font-size: Theme.type.caption;
                    font-weight: 700;
                    color: Theme.palette().accent-ink;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        if !root.selected : Text {
            text: root.title;
            font-size: Theme.type.caption;
            font-weight: 500;
            color: Theme.palette().ink;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

/// One template card. Everything a template says about itself is derived from
/// its number so the left-to-right and right-to-left grids list the same four.
component PresentThemeOption inherits PresentThemeCard {
    in property <int> theme: 0;
    in property <int> current: 0;

    // What each template really creates: a deck with these slides and empty
    // placeholders on them. None of them sets a colour, font or background.
    title: ["Blank", "Title and Content", "Two Columns", "Image and Text"][root.theme];
    selected: root.current == root.theme;

    VerticalLayout {
        padding: 12px;
        alignment: center;
        spacing: 4px;
        Text {
            text: root.title;
            font-size: Theme.tokens.typography.caption;
            font-weight: 700;
            color: Theme.palette().paper-ink;
            horizontal-alignment: center;
            overflow: elide;
        }
        Rectangle { width: 40px; height: 2px; background: Theme.palette().accent; }
        Text {
            text: ["One empty slide", "A title slide, then a content slide", "Title with two empty columns", "Title with room for a picture"][root.theme];
            font-size: Theme.tokens.typography.micro;
            color: Theme.palette().paper-muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

/// A row of the category list: icon, then label, from the reading-start edge.
component PresentThemeCategory inherits Rectangle {
    in property <string> icon: "new";
    in property <string> label: "";
    in property <bool> active: false;
    callback clicked;

    height: 32px * max(1.0, Theme.text-scale);
    border-radius: Theme.tokens.metrics.radius-medium;
    background: root.active ? Theme.palette().surface-raised : transparent;

    if !Theme.rtl : HorizontalLayout {
        spacing: Theme.tokens.space.md; padding-left: Theme.tokens.space.md; padding-right: Theme.tokens.space.md; cross-axis-alignment: center;
        Icon { size: 16px * max(1.0, Theme.text-scale); icon: root.icon; tint: root.active ? Theme.palette().accent : Theme.palette().ink-secondary; }
        Text {
            text: root.label;
            font-size: Theme.type.body;
            font-weight: root.active ? 600 : 400;
            color: Theme.palette().ink;
            vertical-alignment: center;
        }
    }
    if Theme.rtl : HorizontalLayout {
        spacing: Theme.tokens.space.md; padding-left: Theme.tokens.space.md; padding-right: Theme.tokens.space.md; cross-axis-alignment: center;
        alignment: end;
        Text {
            text: root.label;
            font-size: Theme.type.body;
            font-weight: root.active ? 600 : 400;
            color: Theme.palette().ink;
            vertical-alignment: center;
        }
        Icon { size: 16px * max(1.0, Theme.text-scale); icon: root.icon; tint: root.active ? Theme.palette().accent : Theme.palette().ink-secondary; }
    }
    TouchArea { clicked => { root.clicked(); } }
}

export component PresentThemeChooser inherits Rectangle {
    in-out property <bool> open: false;
    in-out property <int> theme-selected: 0;
    in-out property <int> theme-category: 0;
    callback choose-theme-category(int);
    callback cancel-theme;
    callback create-theme(int);

    function theme-visible(idx: int) -> bool {
        if (root.theme-category == 0) { return true; }
        if (root.theme-category == 1 && (idx == 0 || idx == 1)) { return true; }
        if (root.theme-category == 2 && (idx == 2 || idx == 3)) { return true; }
        if (root.theme-category == 3 && idx == 0) { return true; }
        return false;
    }

    // "Theme" in the property and callback names below is historical: this
    // dialog creates a deck from a template.
    // Keyboard: Left/Right pick a template, Up/Down a category, Return creates,
    // Escape cancels. Tab walks Cancel and Create and wraps from Create back to
    // the chooser (and Shift+Tab the other way), so focus never leaves the dialog.
    in property <int> refocus-tick: 0;
    changed refocus-tick => { chooser-focus.focus(); }

    function pick-category(cat: int) {
        root.theme-category = cat;
        if (!root.theme-visible(root.theme-selected)) {
            root.theme-selected = root.theme-visible(0) ? 0 : root.theme-visible(1) ? 1 : root.theme-visible(2) ? 2 : 3;
        }
        root.choose-theme-category(cat);
    }

    function step-theme(delta: int) {
        let s = root.theme-selected;
        if (s + delta >= 0 && s + delta <= 3 && root.theme-visible(s + delta)) { root.theme-selected = s + delta; }
        else if (s + 2 * delta >= 0 && s + 2 * delta <= 3 && root.theme-visible(s + 2 * delta)) { root.theme-selected = s + 2 * delta; }
        else if (s + 3 * delta >= 0 && s + 3 * delta <= 3 && root.theme-visible(s + 3 * delta)) { root.theme-selected = s + 3 * delta; }
    }

    width: 100%;
    height: 100%;
    background: Theme.palette().scrim;

    modal-touch := TouchArea {
        clicked => { }
    }

    chooser-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        init => { chooser-focus.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.cancel-theme(); return accept; }
            if (event.text == Key.Return) { root.create-theme(root.theme-selected); return accept; }
            if (event.text == Key.LeftArrow) { root.step-theme(Theme.rtl ? 1 : -1); return accept; }
            if (event.text == Key.RightArrow) { root.step-theme(Theme.rtl ? -1 : 1); return accept; }
            if (event.text == Key.UpArrow) { root.pick-category(max(0, root.theme-category - 1)); return accept; }
            if (event.text == Key.DownArrow) { root.pick-category(min(3, root.theme-category + 1)); return accept; }
            if (event.text == Key.Tab && !event.modifiers.shift && create-button.has-focus) { chooser-focus.focus(); return accept; }
            if ((event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) && chooser-focus.has-focus) { create-button.grab-focus(); return accept; }
            return reject;
        }

    Rectangle {
        width: min(1160px, max(1px, parent.width - 48px));
        height: min(760px, max(480px, parent.height - 48px));
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.tokens.metrics.radius-large;
        border-width: 1px;
        border-color: Theme.palette().border;
        background: Theme.palette().surface;
        clip: true;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: Theme.palette().shadow;

        VerticalLayout {
            spacing: 0px;
            padding: 0px;

            // The category list sits at the reading-start side: left in LTR, right
            // in RTL, with the theme grid filling the rest.
            Rectangle {
                vertical-stretch: 1;

                sidebar := Rectangle {
                    x: Theme.rtl ? parent.width - self.width : 0px;
                    width: 220px + 80px * (max(1.0, Theme.text-scale) - 1.0);
                    height: parent.height;
                    background: Theme.palette().panel;

                    VerticalLayout {
                        spacing: Theme.tokens.space.sm;
                        padding-top: Theme.tokens.space.xl;
                        padding-bottom: Theme.tokens.space.xl;
                        padding-left: Theme.tokens.space.lg;
                        padding-right: Theme.tokens.space.lg;

                        HorizontalLayout {
                            padding-left: Theme.rtl ? 0px : Theme.tokens.space.md;
                            padding-right: Theme.rtl ? Theme.tokens.space.md : 0px;
                            padding-bottom: Theme.tokens.space.sm;
                            alignment: Theme.rtl ? end : start;
                            Text {
                                text: "TEMPLATES";
                                font-size: Theme.type.micro;
                                font-weight: 700;
                                color: Theme.palette().ink-secondary;
                            }
                        }

                        PresentThemeCategory { icon: "grid"; label: "All Templates"; active: root.theme-category == 0; clicked => { root.pick-category(0); } }
                        PresentThemeCategory { icon: "document"; label: "Basic"; active: root.theme-category == 1; clicked => { root.pick-category(1); } }
                        PresentThemeCategory { icon: "slide"; label: "Layouts"; active: root.theme-category == 2; clicked => { root.pick-category(2); } }
                        PresentThemeCategory { icon: "stop"; label: "Blank"; active: root.theme-category == 3; clicked => { root.pick-category(3); } }

                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }

                    Rectangle { x: Theme.rtl ? 0px : parent.width - 1px; y: 0px; width: 1px; height: parent.height; background: Theme.palette().border; }
                }

                // Content Area
                VerticalLayout {
                    x: Theme.rtl ? 0px : sidebar.width;
                    width: parent.width - sidebar.width;
                    height: parent.height;
                    padding-top: Theme.tokens.space.xxl;
                    padding-bottom: Theme.tokens.space.xl;
                    padding-left: Theme.tokens.space.xxl;
                    padding-right: Theme.tokens.space.xxl;
                    spacing: Theme.tokens.space.xl;

                    Text {
                        text: "Choose a Template";
                        font-size: 24px * max(1.0, Theme.text-scale);
                        font-weight: 700;
                        color: Theme.palette().ink;
                        horizontal-alignment: Theme.rtl ? right : left;
                        overflow: elide;
                    }

                    // The cards form a grid with as many columns as the width holds (four at most),
                    // each card as wide as its share, so the row fills the content at any width.
                    // Right-to-left starts each row at the right edge.
                    theme-grid := Rectangle {
                        horizontal-stretch: 1;
                        background: transparent;
                        property <length> gap: Theme.tokens.space.xl;
                        property <float> columns: max(1.0, min(4.0, floor((self.width + self.gap) / (200px + self.gap))));
                        property <length> card-width: (self.width - self.gap * (self.columns - 1)) / self.columns;
                        // A card is its 16:9 preview, its caption and its padding.
                        property <length> card-height: (self.card-width - 20px) * 0.5625 + 38px + 22px * max(1.0, Theme.text-scale);
                        // Each card's place among the cards this category shows.
                        property <float> slot-0: 0;
                        property <float> slot-1: root.theme-visible(0) ? 1 : 0;
                        property <float> slot-2: self.slot-1 + (root.theme-visible(1) ? 1 : 0);
                        property <float> slot-3: self.slot-2 + (root.theme-visible(2) ? 1 : 0);
                        property <float> count: self.slot-3 + (root.theme-visible(3) ? 1 : 0);
                        property <float> rows: ceil(self.count / self.columns);
                        height: self.rows * self.card-height + max(0.0, self.rows - 1.0) * self.gap;

                        function x-of(slot: float) -> length {
                            return (Theme.rtl ? columns - 1 - mod(slot, columns) : mod(slot, columns)) * (card-width + gap);
                        }
                        function y-of(slot: float) -> length {
                            return floor(slot / columns) * (card-height + gap);
                        }

                        if root.theme-visible(0) : PresentThemeOption {
                            theme: 0; current: root.theme-selected; clicked => { root.theme-selected = 0; }
                            preview-width: theme-grid.card-width - 20px;
                            preview-height: self.preview-width * 0.5625;
                            x: theme-grid.x-of(theme-grid.slot-0);
                            y: theme-grid.y-of(theme-grid.slot-0);
                        }
                        if root.theme-visible(1) : PresentThemeOption {
                            theme: 1; current: root.theme-selected; clicked => { root.theme-selected = 1; }
                            preview-width: theme-grid.card-width - 20px;
                            preview-height: self.preview-width * 0.5625;
                            x: theme-grid.x-of(theme-grid.slot-1);
                            y: theme-grid.y-of(theme-grid.slot-1);
                        }
                        if root.theme-visible(2) : PresentThemeOption {
                            theme: 2; current: root.theme-selected; clicked => { root.theme-selected = 2; }
                            preview-width: theme-grid.card-width - 20px;
                            preview-height: self.preview-width * 0.5625;
                            x: theme-grid.x-of(theme-grid.slot-2);
                            y: theme-grid.y-of(theme-grid.slot-2);
                        }
                        if root.theme-visible(3) : PresentThemeOption {
                            theme: 3; current: root.theme-selected; clicked => { root.theme-selected = 3; }
                            preview-width: theme-grid.card-width - 20px;
                            preview-height: self.preview-width * 0.5625;
                            x: theme-grid.x-of(theme-grid.slot-3);
                            y: theme-grid.y-of(theme-grid.slot-3);
                        }
                    }

                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }

            // Footer Bar. The primary button sits at the reading end: right in
            // LTR, left in RTL; the hint fills the rest.
            Rectangle {
                height: 56px * max(1.0, Theme.text-scale);
                background: Theme.palette().chrome;

                Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.palette().border; }

                cancel-button := LoomButton {
                    label: "Cancel";
                    variant: "secondary";
                    width: self.preferred-width;
                    height: Theme.tokens.metrics.control-height;
                    x: Theme.rtl
                        ? create-button.x + create-button.width + Theme.tokens.space.lg
                        : create-button.x - Theme.tokens.space.lg - self.width;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.cancel-theme(); }
                }

                create-button := LoomButton {
                    label: "Create Presentation";
                    variant: "primary";
                    width: self.preferred-width;
                    height: Theme.tokens.metrics.control-height;
                    x: Theme.rtl ? Theme.tokens.space.xl : parent.width - Theme.tokens.space.xl - self.width;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.create-theme(root.theme-selected); }
                }

                Text {
                    text: "Escape to cancel • Return to create";
                    font-size: Theme.type.caption;
                    color: Theme.palette().ink-secondary;
                    x: Theme.rtl ? cancel-button.x + cancel-button.width + Theme.tokens.space.lg : Theme.tokens.space.xl;
                    width: Theme.rtl
                        ? max(0px, parent.width - Theme.tokens.space.xl - self.x)
                        : max(0px, cancel-button.x - Theme.tokens.space.lg - Theme.tokens.space.xl);
                    height: parent.height;
                    horizontal-alignment: Theme.rtl ? right : left;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
    }
}
