import { Theme } from "theme.slint";
import { LoomColorSwatch } from "foundation.slint";

/// One drawable piece of an element, in fractions of the element's box: a table
/// cell, a chart bar or label, or the fill and text of a styled text object.
export struct ObjectPart {
    fx: float,
    fy: float,
    fw: float,
    fh: float,
    text: string,
    has-bg: bool,
    bg: color,
    fg: color,
    bold: bool,
    /// 0 left, 1 centre, 2 right.
    align: int,
    /// Font size in slide units (the slide is 1000 x 562.5).
    fs: float,
    has-border: bool,
    /// Wrap the text onto several lines (text objects) instead of eliding it.
    wrap: bool,
    /// Inset the text like an unstyled text object does, so styling it moves nothing.
    pad: bool,
    italic: bool,
    /// The element's own font family; empty follows the document theme face.
    family: string,
    /// Text colour: 0 is `fg`, 1 the paper's ink, 2 its muted ink, 3 the interface ink.
    ink: int,
    /// Draw the background as an ellipse (a circle shape).
    round: bool,
    underline: bool,
    strikethrough: bool,
    has-image: bool,
    img: image,
    shape-kind: string,
}

export struct ElementVisualMeta {
    opacity: float,
    corner-radius: float,
    has-shadow: bool,
    shadow-dx: float,
    shadow-dy: float,
    locked: bool,
    flip-h: bool,
    flip-v: bool,
}

/// The slide's own colours. They are document artwork, not window chrome, so
/// selecting a different application theme (including high contrast) never
/// recolours the deck the user authored.
export global DocumentInk {
    out property <color> paper: #ffffff;
    out property <color> ink: #1d1d1f;
    out property <color> muted: #6e6e73;
    out property <color> shape-fill: #e6f0fc;
    out property <color> circle-fill: #e3f6ef;
    out property <color> stat-fill: #0071e3;
}

/// The selected object's text style, shown by the inspector, and the one callback
/// the style controls use. A global, so the byte-limited app window needs no new
/// property or callback for them.
export global ElementInk {
    /// A text object or shape is selected, so its style can be changed.
    in-out property <bool> available: false;
    in-out property <string> size-label: "";
    in-out property <bool> bold: false;
    in-out property <bool> italic: false;
    /// 0 left, 1 centre, 2 right.
    in-out property <int> align: 0;
    /// Palette slot of the text colour, or -1 for the type's own.
    in-out property <int> color-slot: -1;
    in-out property <int> fill-slot: -1;
    /// The selected text objects' family; empty follows the theme. `mixed` is
    /// true when the selection disagrees, so one object's family is never shown
    /// as if all of them used it.
    in-out property <string> font-family: "";
    in-out property <bool> font-family-mixed: false;
    /// The seven colours the swatches offer (the eighth swatch resets).
    in property <[color]> palette: [];
    /// `kind` is size, bold, italic, align, color or fill; `value` is the step,
    /// the alignment or the palette slot (7 resets).
    callback requested(string, int);
    /// A family was submitted; empty text means "follow the theme again".
    callback font-requested(string);
    /// Escape in the family field: show the document's real family again.
    callback font-cancelled;

    /// The selected object's position, size and rotation as the fields show them
    /// (plain numbers in slide units and degrees).
    in-out property <string> x-text: "";
    in-out property <string> y-text: "";
    in-out property <string> w-text: "";
    in-out property <string> h-text: "";
    in-out property <string> rot-text: "";
    /// A field was accepted: `field` is x, y, w, h or rot and `text` what was typed;
    /// empty text means the edit was cancelled and the field should show the real value.
    callback geometry-requested(string, string);

    // Extended style & mixed-value state
    /// Active Format inspector sub-tab: 0 = Style, 1 = Text, 2 = Arrange.
    in-out property <int> format-sub-tab: 1;
    in-out property <bool> underline: false;
    in-out property <bool> strikethrough: false;
    in-out property <bool> bold-mixed: false;
    in-out property <bool> italic-mixed: false;
    in-out property <bool> underline-mixed: false;
    in-out property <bool> strikethrough-mixed: false;
    in-out property <bool> size-mixed: false;
    in-out property <bool> align-mixed: false;

    // 48-color palette state (Text Color, Shape Fill, Slide Background)
    in-out property <[LoomColorSwatch]> color-swatches: [];
    in-out property <string> active-palette: ""; // "", "text", "fill", "bg"
    in-out property <string> text-color-hex: "";
    in-out property <bool> text-color-automatic: true;
    in-out property <bool> text-color-mixed: false;
    in-out property <string> text-color-label: "Automatic";
    in-out property <color> text-color-swatch: #1d1d1f;

    in-out property <string> fill-color-hex: "";
    in-out property <bool> fill-color-automatic: true;
    in-out property <bool> fill-color-mixed: false;
    in-out property <string> fill-color-label: "Automatic";
    in-out property <color> fill-color-swatch: transparent;

    in-out property <string> bg-color-hex: "";
    in-out property <bool> bg-color-automatic: true;
    in-out property <bool> bg-color-mixed: false;
    in-out property <string> bg-color-label: "Automatic";
    in-out property <color> bg-color-swatch: #ffffff;

    // Procedural Dynamic Background state & callbacks
    in-out property <bool> has-dynamic-bg: false;
    in-out property <image> dynamic-bg-image;
    in-out property <int> dynamic-bg-preset: 0;
    in-out property <bool> dynamic-bg-animate: true;
    in-out property <int> dynamic-bg-speed: 1;
    callback dynamic-bg-mode-changed(bool);
    callback dynamic-bg-preset-picked(int);
    callback dynamic-bg-animate-toggled(bool);
    callback dynamic-bg-speed-picked(int);
    callback dynamic-bg-apply-all();

    in-out property <string> hex-input: "";
    in-out property <string> hex-error: "";

    callback color-toggled(string);
    callback color-picked(string, string);
    callback hex-edited(string);
    callback hex-submitted(string, string);

    // Arrange & Document
    callback arrange-requested(string);
    callback layout-picked(string);
    in-out property <string> aspect-ratio: "16:9";
    callback aspect-requested(string);
    callback theme-preset-requested(int);
    in-out property <int> deck-theme-index: 0;
    in-out property <string> active-layout: "content";
    in-out property <string> deck-stats: "";

    // Effects, Animation, Hidden Slide, Group & Lock state
    in-out property <int> effects-opacity-pct: 100;
    in-out property <int> effects-corner-radius-px: 0;
    in-out property <int> effects-stroke-width-px: 0;
    in-out property <int> effects-stroke-dash: 0;
    in-out property <bool> effects-has-shadow: false;
    in-out property <bool> effects-has-gradient: false;
    in-out property <int> build-count: 0;
    in-out property <int> build-phase: 0;
    in-out property <int> build-trigger: 0;
    in-out property <bool> slide-hidden: false;
    in-out property <bool> selection-locked: false;
    in-out property <bool> selection-grouped: false;
    callback effects-set-opacity(int);
    callback effects-set-corner-radius(int);
    callback effects-set-stroke-width(int);
    callback effects-cycle-stroke-dash();
    callback effects-toggle-shadow();
    callback effects-toggle-gradient();
    callback add-build(int, int);
    callback remove-last-build();
    callback cycle-build-phase();
    callback cycle-build-trigger();
    callback toggle-slide-hidden();
    in-out property <bool> slide-sorter-open: false;
    callback toggle-slide-sorter();
    in-out property <string> slide-footer-text: "";
    in-out property <bool> show-slide-number: false;
    in-out property <int> active-slide-number: 1;
    callback set-slide-footer(string);
    callback toggle-slide-number();
    in-out property <bool> format-painter-active: false;
    callback copy-format-style();
    callback apply-format-style();
}

/// A part drawn at the box its caller gives it. `text-scale` is the slide's
/// width over 840 px, the scale the unstyled text objects use for their insets.
export component ObjectPartView inherits Rectangle {
    in property <ObjectPart> part;
    in property <length> slide-height;
    in property <float> text-scale: 1.0;

    background: root.part.has-bg && root.part.shape-kind == "" ? root.part.bg : transparent;
    border-radius: root.part.round ? self.width / 2 : 0px;
    border-width: root.part.has-border ? 1px : 0px;
    border-color: #d0d0d0;
    clip: true;
    accessible-role: none;

    if root.part.shape-kind == "rounded-rect" : Rectangle {
        width: 100%;
        height: 100%;
        border-radius: min(self.width, self.height) * 0.22;
        background: root.part.bg;
        accessible-role: none;
    }

    if root.part.shape-kind == "line" : Rectangle {
        x: 0px;
        y: (parent.height - max(2px, parent.height * 0.14)) / 2;
        width: parent.width;
        height: max(2px, parent.height * 0.14);
        background: root.part.bg;
        accessible-role: none;
    }

    if root.part.shape-kind == "arrow-right" : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        fill: root.part.bg;
        MoveTo { x: 0; y: 32; }
        LineTo { x: 65; y: 32; }
        LineTo { x: 65; y: 12; }
        LineTo { x: 100; y: 50; }
        LineTo { x: 65; y: 88; }
        LineTo { x: 65; y: 68; }
        LineTo { x: 0; y: 68; }
        Close {}
        accessible-role: none;
    }

    if root.part.shape-kind == "callout" : Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        fill: root.part.bg;
        MoveTo { x: 6; y: 6; }
        LineTo { x: 94; y: 6; }
        LineTo { x: 94; y: 74; }
        LineTo { x: 38; y: 74; }
        LineTo { x: 20; y: 96; }
        LineTo { x: 24; y: 74; }
        LineTo { x: 6; y: 74; }
        Close {}
        accessible-role: none;
    }

    txt := Text {
        x: root.part.pad ? Theme.tokens.space.sm * root.text-scale
            : root.part.shape-kind != "" ? 12px * root.text-scale : 4px;
        y: root.part.pad ? Theme.tokens.space.xs * root.text-scale : 0px;
        width: root.part.pad ? max(1px, parent.width - Theme.tokens.space.lg * 2 * root.text-scale)
            : root.part.shape-kind != "" ? max(1px, parent.width - 24px * root.text-scale)
            : max(1px, parent.width - 8px);
        height: root.part.pad ? max(1px, parent.height - Theme.tokens.space.sm * 2 * root.text-scale)
            : parent.height;
        text: root.part.text;
        font-family: root.part.family == "" ? Theme.document-font-family : root.part.family;
        font-size: root.part.fs * root.slide-height / 562.5;
        font-weight: root.part.bold ? 700 : 400;
        font-italic: root.part.italic;
        color: root.part.ink == 1 ? DocumentInk.ink
            : root.part.ink == 2 ? DocumentInk.muted
            : root.part.ink == 3 ? DocumentInk.ink
            : root.part.fg;
        horizontal-alignment: root.part.align == 1 ? center : root.part.align == 2 ? right : left;
        vertical-alignment: center;
        wrap: root.part.wrap ? word-wrap : no-wrap;
        overflow: elide;
        accessible-role: none;
    }

    if root.part.has-image : Image {
        width: parent.width;
        height: parent.height;
        source: root.part.img;
        image-fit: contain;
        accessible-role: none;
    }

    property <length> deco-w: min(txt.width, txt.preferred-width);
    property <length> deco-x: root.part.align == 1 ? txt.x + (txt.width - self.deco-w) / 2
        : root.part.align == 2 ? txt.x + txt.width - self.deco-w : txt.x;

    if root.part.underline && root.part.text != "" : Rectangle {
        x: root.deco-x;
        y: txt.y + txt.height * 0.5 + (root.part.fs * root.slide-height / 562.5) * 0.55;
        width: max(0px, root.deco-w);
        height: max(1px, 1.2 * root.slide-height / 562.5);
        background: root.part.ink == 1 ? DocumentInk.ink
            : root.part.ink == 2 ? DocumentInk.muted
            : root.part.ink == 3 ? DocumentInk.ink
            : root.part.fg;
    }

    if root.part.strikethrough && root.part.text != "" : Rectangle {
        x: root.deco-x;
        y: txt.y + txt.height * 0.5;
        width: max(0px, root.deco-w);
        height: max(1px, 1.2 * root.slide-height / 562.5);
        background: root.part.ink == 1 ? DocumentInk.ink
            : root.part.ink == 2 ? DocumentInk.muted
            : root.part.ink == 3 ? DocumentInk.ink
            : root.part.fg;
    }
}
