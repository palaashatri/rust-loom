import {
    LoomPanel, LoomSectionHeader, LoomSegmentedControl, LoomButton, LoomTextField,
} from "foundation.slint";
import { Theme } from "theme.slint";
import { PresentTableInspector } from "table_inspector.slint";
import { ElementInk } from "object_part.slint";
import { PresentFormatSection } from "format_section.slint";
import { PresentArrangeSection } from "arrange_section.slint";
import { PresentLayoutPicker } from "layout_picker.slint";
import { PresentDocumentSection } from "document_section.slint";
import { StyleEffectsPanel } from "style_effects_panel.slint";
import { AnimationInspector } from "animation_inspector.slint";

component InspectorHeading inherits Text {
    in property <string> title: "";
    text: root.title;
    font-size: Theme.type.caption;
    font-weight: 700;
    color: Theme.palette().ink-secondary;
    horizontal-alignment: Theme.rtl ? right : left;
    horizontal-stretch: 1;
}

export component PresentInspector inherits LoomPanel {
    in-out property <int> inspector-tab: 0;
    in property <bool> compact: false;
    in-out property <int> active-template-index: 1;
    in-out property <int> transition-index: 0;
    in property <string> slide-count-text: "1 slide";
    in property <bool> aspect-ratio-wide: true;
    in property <string> active-element-label: "No element selected";
    in property <string> active-element-content: "";
    in property <bool> content-editable: true;
    in property <int> active-element-index: 0;
    in property <int> element-count: 0;
    in property <int> selection-count: 0;
    in property <string> element-x-text: "100";
    in property <string> element-y-text: "100";
    in property <string> element-width-text: "400";
    in property <string> element-height-text: "100";
    in property <string> element-rotation-text: "0°";
    in property <bool> is-table: false;
    in-out property <string> table-style-id: "table-style-medium-1";
    in-out property <bool> table-header-row: true;
    in-out property <bool> table-banded-rows: true;
    in-out property <bool> table-first-column: false;

    callback apply-template(int);
    callback update-element-content(string);
    callback set-transition(int);
    callback open-theme-chooser;
    callback set-table-style(string);
    callback toggle-table-option(string);
    callback table-action(string);
    callback region-key(bool);

    function reveal(y: length, h: length) {
        let top = y - scroller.absolute-position.y;
        if (top < 0px) {
            scroller.viewport-y = min(0px, scroller.viewport-y - top);
        } else if (top + h > scroller.height) {
            scroller.viewport-y = max(scroller.height - scroller.viewport-height, scroller.viewport-y - (top + h - scroller.height));
        }
    }

    in property <int> focus-request: 0;

    accessible-role: groupbox;
    accessible-label: "Slide inspector";
    width: (root.compact ? 248px : 280px) * (1.0 + 0.7 * (max(1.0, Theme.text-scale) - 1.0));

    FocusScope {
        width: 100%;
        height: 100%;
        focus-on-tab-navigation: false;
        focus-on-click: false;
        key-pressed(event) => {
            if (event.text == Key.F6) {
                root.region-key(event.modifiers.shift);
                return accept;
            }
            return reject;
        }

        Rectangle {
            x: Theme.rtl ? parent.width - 1px : 0px;
            y: 0px;
            width: 1px;
            height: parent.height;
            background: Theme.palette().border;
        }

        VerticalLayout {
            width: parent.width;
            height: parent.height;
            padding: Theme.tokens.space.lg;
            spacing: Theme.tokens.space.xs;

            scroller := Flickable {
                vertical-stretch: 1;
                min-height: 0px;
                max-height: 100000px;
                viewport-width: self.width;
                viewport-height: max(self.height, content-col.preferred-height);
                interactive: true;

                content-col := VerticalLayout {
                    width: scroller.viewport-width;
                    height: max(scroller.height, self.preferred-height);
                    alignment: start;
                    spacing: Theme.tokens.space.md;

                    if root.inspector-tab == 0 : VerticalLayout {
                        alignment: start;
                        property <int> focus-request-tick: root.focus-request;
                        changed focus-request-tick => {
                            if (focus-request-tick > 0) { layout-template-control.grab-focus(); }
                        }
                        spacing: Theme.tokens.space.xs;
                        InspectorHeading { title: "Slide Layout"; }
                        layout-template-control := LoomSegmentedControl {
                            items: ["Title", "Content", "2 Col", "Image"];
                            current <=> root.active-template-index;
                            label: "Layout Template";
                            selected(idx) => { root.apply-template(idx); }
                        }
                        if root.selection-count == 0 : Text {
                            text: "Select an object to edit its position and style.";
                            wrap: word-wrap;
                            horizontal-alignment: Theme.rtl ? right : left;
                            font-size: Theme.type.body;
                            color: Theme.palette().ink-secondary;
                        }
                        if root.selection-count > 1 : InspectorHeading { title: "Selected Elements"; }
                        if root.selection-count > 1 : Text {
                            text: root.selection-count + " objects selected";
                            font-size: Theme.type.body;
                            font-weight: 600;
                            color: Theme.palette().ink;
                            horizontal-alignment: Theme.rtl ? right : left;
                            accessible-role: AccessibleRole.text;
                            accessible-label: self.text;
                        }
                        if root.selection-count > 1 && root.content-editable : Text {
                            text: "Select one object to edit its text content.";
                            wrap: word-wrap;
                            horizontal-alignment: Theme.rtl ? right : left;
                            font-size: Theme.type.caption;
                            color: Theme.palette().ink-secondary;
                            accessible-role: AccessibleRole.text;
                            accessible-label: self.text;
                        }
                        if root.selection-count == 1 && root.content-editable : Rectangle {
                            height: Theme.scaled-control-height;
                            border-radius: Theme.tokens.metrics.radius-small;
                            border-width: 1px;
                            border-color: Theme.palette().border;
                            background: Theme.palette().surface-raised;
                            clip: true;
                            HorizontalLayout {
                                padding-left: Theme.tokens.space.sm;
                                padding-right: Theme.tokens.space.sm;
                                TextInput {
                                    min-width: 0px;
                                    horizontal-stretch: 1;
                                    text: root.active-element-content;
                                    font-size: Theme.type.body;
                                    color: Theme.palette().ink;
                                    vertical-alignment: center;
                                    horizontal-alignment: Theme.rtl ? right : left;
                                    single-line: true;
                                    accessible-label: "Selected element text";
                                    edited => { root.update-element-content(self.text); }
                                }
                            }
                        }
                        if root.selection-count > 0 && ElementInk.available : Rectangle { height: 1px; background: Theme.palette().border; }
                        if root.selection-count > 0 && ElementInk.available : PresentFormatSection { }
                        if root.selection-count > 0 : StyleEffectsPanel {
                            has-selection: root.selection-count > 0;
                            opacity-pct: ElementInk.effects-opacity-pct;
                            corner-radius-px: ElementInk.effects-corner-radius-px;
                            stroke-width-px: ElementInk.effects-stroke-width-px;
                            stroke-dash: ElementInk.effects-stroke-dash;
                            has-shadow: ElementInk.effects-has-shadow;
                            has-gradient: ElementInk.effects-has-gradient;
                            set-opacity(v) => { ElementInk.effects-set-opacity(v); }
                            set-corner-radius(v) => { ElementInk.effects-set-corner-radius(v); }
                            set-stroke-width(v) => { ElementInk.effects-set-stroke-width(v); }
                            cycle-stroke-dash => { ElementInk.effects-cycle-stroke-dash(); }
                            toggle-shadow => { ElementInk.effects-toggle-shadow(); }
                            toggle-gradient => { ElementInk.effects-toggle-gradient(); }
                        }
                        if root.is-table : PresentTableInspector {
                            current-style-id: root.table-style-id;
                            header-row: root.table-header-row;
                            banded-rows: root.table-banded-rows;
                            first-column: root.table-first-column;
                            set-table-style(id) => { root.set-table-style(id); }
                            toggle-table-option(opt) => { root.toggle-table-option(opt); }
                            table-action(act) => { root.table-action(act); }
                        }
                        if root.selection-count > 0 : Rectangle { height: 1px; background: Theme.palette().border; }
                        if root.selection-count > 0 : PresentArrangeSection {
                            selection-count: root.selection-count;
                        }
                        if root.selection-count > 0 : Rectangle { height: 1px; background: Theme.palette().border; }
                        if root.selection-count > 0 : InspectorHeading { title: "Geometry"; }
                        if root.selection-count > 1 : InspectorHeading { title: "Selected Elements"; }
                        if root.selection-count > 1 : Text {
                            text: "Select one object to edit its geometry.";
                            font-size: Theme.type.caption;
                            color: Theme.palette().ink-secondary;
                            horizontal-alignment: Theme.rtl ? right : left;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                            accessible-role: AccessibleRole.text;
                            accessible-label: self.text;
                        }
                        if root.selection-count == 1 : Text {
                            text: "Type slide units, or add in, cm, mm or pt. Rotation accepts ° or deg.";
                            font-size: Theme.type.caption;
                            color: Theme.palette().ink-secondary;
                            horizontal-alignment: Theme.rtl ? right : left;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                            accessible-role: AccessibleRole.text;
                            accessible-label: self.text;
                        }
                        if root.selection-count == 1 : HorizontalLayout {
                            spacing: Theme.tokens.space.xs;
                            for slot in 2 : VerticalLayout {
                                property <int> k: Theme.rtl ? 1 - slot : slot;
                                horizontal-stretch: 1;
                                if k == 0 : LoomTextField {
                                    label: "X position";
                                    placeholder: "X";
                                    field-min-width: 96px;
                                    value <=> ElementInk.x-text;
                                    accepted(v) => { ElementInk.geometry-requested("x", v); }
                                    cancelled => { ElementInk.geometry-requested("x", ""); }
                                    changed focused => { if (self.focused) { root.reveal(self.absolute-position.y, self.height); } }
                                }
                                if k == 1 : LoomTextField {
                                    label: "Y position";
                                    placeholder: "Y";
                                    field-min-width: 96px;
                                    value <=> ElementInk.y-text;
                                    accepted(v) => { ElementInk.geometry-requested("y", v); }
                                    cancelled => { ElementInk.geometry-requested("y", ""); }
                                    changed focused => { if (self.focused) { root.reveal(self.absolute-position.y, self.height); } }
                                }
                            }
                        }
                        if root.selection-count == 1 : HorizontalLayout {
                            spacing: Theme.tokens.space.xs;
                            for slot in 2 : VerticalLayout {
                                property <int> k: Theme.rtl ? 1 - slot : slot;
                                horizontal-stretch: 1;
                                if k == 0 : LoomTextField {
                                    label: "Width";
                                    placeholder: "W";
                                    field-min-width: 96px;
                                    value <=> ElementInk.w-text;
                                    accepted(v) => { ElementInk.geometry-requested("w", v); }
                                    cancelled => { ElementInk.geometry-requested("w", ""); }
                                    changed focused => { if (self.focused) { root.reveal(self.absolute-position.y, self.height); } }
                                }
                                if k == 1 : LoomTextField {
                                    label: "Height";
                                    placeholder: "H";
                                    field-min-width: 96px;
                                    value <=> ElementInk.h-text;
                                    accepted(v) => { ElementInk.geometry-requested("h", v); }
                                    cancelled => { ElementInk.geometry-requested("h", ""); }
                                    changed focused => { if (self.focused) { root.reveal(self.absolute-position.y, self.height); } }
                                }
                            }
                        }
                        if root.selection-count == 1 : LoomTextField {
                            label: "Rotation";
                            placeholder: "0°";
                            field-min-width: 96px;
                            value <=> ElementInk.rot-text;
                            accepted(v) => { ElementInk.geometry-requested("rot", v); }
                            cancelled => { ElementInk.geometry-requested("rot", ""); }
                            changed focused => { if (self.focused) { root.reveal(self.absolute-position.y, self.height); } }
                        }
                        if root.selection-count == 0 : PresentLayoutPicker { }
                    }

                    if root.inspector-tab == 1 : VerticalLayout {
                        alignment: start;
                        property <int> focus-request-tick: root.focus-request;
                        changed focus-request-tick => {
                            if (focus-request-tick > 0) { transition-type-control.grab-focus(); }
                        }
                        spacing: Theme.tokens.space.sm;
                        LoomSectionHeader { title: "Slide Transition"; }
                        transition-type-control := LoomSegmentedControl {
                            items: ["None", "Dissolve", "Push"];
                            current <=> root.transition-index;
                            label: "Transition Type";
                            selected(idx) => { root.set-transition(idx); }
                        }
                        Text {
                            text: "Transition plays between slides during presentation playback.";
                            font-size: Theme.type.caption;
                            color: Theme.palette().ink-secondary;
                            wrap: word-wrap;
                            horizontal-alignment: Theme.rtl ? right : left;
                            horizontal-stretch: 1;
                        }
                        if root.transition-index == 3 : Text {
                            text: "This deck keeps Morph, but Loom playback does not support it. Choose another effect to replace it.";
                            font-size: Theme.type.caption;
                            color: Theme.palette().ink-secondary;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }

                    if root.inspector-tab == 2 : VerticalLayout {
                        alignment: start;
                        property <int> focus-request-tick: root.focus-request;
                        changed focus-request-tick => {
                            if (focus-request-tick > 0) { new-presentation-template.grab-focus(); }
                        }
                        spacing: Theme.tokens.space.md;
                        PresentDocumentSection {
                            deck-theme-index: ElementInk.deck-theme-index;
                            deck-theme-selected(idx) => { ElementInk.theme-preset-requested(idx); }
                        }
                        AnimationInspector {
                            has-selection: root.selection-count > 0;
                            build-count: ElementInk.build-count;
                            selected-phase: ElementInk.build-phase;
                            selected-trigger: ElementInk.build-trigger;
                            add-build(p, t) => { ElementInk.add-build(p, t); }
                            remove-last-build => { ElementInk.remove-last-build(); }
                            cycle-phase => { ElementInk.cycle-build-phase(); }
                            cycle-trigger => { ElementInk.cycle-build-trigger(); }
                        }
                        new-presentation-template := LoomButton {
                            icon: "format";
                            label: "New from Template...";
                            variant: "secondary";
                            clicked => { root.open-theme-chooser(); }
                        }
                        Text {
                            text: root.slide-count-text;
                            font-size: Theme.type.caption;
                            color: Theme.palette().ink-secondary;
                        }
                    }
                }
            }
        }
    }
}
