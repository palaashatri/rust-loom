// Loom UI deterministic component reference surface.
//
// This is the executable specimen for the shared desktop toolkit. Human-
// approved captures become regression evidence; an agent may not bless an
// arbitrary changed screenshot merely by replacing a baseline.

import {
    DocumentChrome, Toolbar, ToolbarGroup, ToolbarSpacer,
    ToolbarButton, ToolbarIconButton, SidebarSurface, InspectorSurface,
    SectionHeader, ToolkitStatusBar
} from "toolkit.slint";
import {
    PrimaryButton, SearchField, SegmentedControl, Field, Slider, Switch,
    TabControl, EmptyState, StatusPill, CommandPalette, CommandPaletteItem
} from "components.slint";
import { Theme } from "theme.slint";
export { Theme } from "theme.slint";

export component SmokeWindow inherits Window {
    title: "Loom UI Reference";
    width: 1280px;
    height: 800px;
    min-width: 1024px;
    min-height: 720px;
    background: Theme.palette().canvas;

    in-out property <[CommandPaletteItem]> palette-commands: [
        { id: "document.new", label: "New Document", shortcut: "Ctrl+N", enabled: true },
        { id: "document.open", label: "Open…", shortcut: "Ctrl+O", enabled: true },
        { id: "document.save", label: "Save", shortcut: "Ctrl+S", enabled: true },
        { id: "document.export", label: "Export…", shortcut: "Ctrl+E", enabled: false },
    ];

    VerticalLayout {
        spacing: 0px;
        padding: 0px;

        DocumentChrome {
            title: "Component Reference";
            trailing-text: "1280 × 800";
        }

        Toolbar {
            ToolbarGroup {
                ToolbarButton { icon: "new"; label: "New"; }
                ToolbarButton { icon: "open"; label: "Open"; }
                ToolbarIconButton { icon: "save"; label: "Save"; }
            }
            ToolbarGroup { leading-separation: true;
                ToolbarIconButton { icon: "undo"; label: "Undo"; enabled: false; }
                ToolbarIconButton { icon: "redo"; label: "Redo"; enabled: false; }
            }
            ToolbarSpacer { }
            ToolbarGroup {
                SearchField { placeholder: "Search"; width: 180px; }
                ToolbarButton { icon: "export"; label: "Export"; primary: true; }
            }
        }

        HorizontalLayout {
            spacing: 0px;
            padding: 0px;
            vertical-stretch: 1;

            SidebarSurface {
                width: 240px;
                title: "Controls";

                VerticalLayout {
                    spacing: 12px;
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 12px;
                    padding-bottom: 12px;

                    SectionHeader { title: "Buttons"; }
                    HorizontalLayout {
                        spacing: 6px;
                        ToolbarButton { icon: "bold"; label: "Bold"; checked: true; }
                        ToolbarIconButton { icon: "italic"; label: "Italic"; }
                        ToolbarIconButton { icon: "underline"; label: "Underline"; enabled: false; }
                    }
                    PrimaryButton { text: "Primary Action"; }

                    SectionHeader { title: "Fields"; }
                    Field { label: "Name"; placeholder: "Untitled"; value: "Project 01"; }
                    SearchField { placeholder: "Filter items"; }

                    SectionHeader { title: "Choice"; }
                    SegmentedControl { label: "Alignment"; items: ["Left", "Center", "Right"]; current: 0; }
                    Switch { text: "Snap to guides"; checked: true; }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: Theme.palette().canvas;

                VerticalLayout {
                    spacing: 12px;
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 16px;
                    padding-bottom: 16px;

                    Rectangle {
                        vertical-stretch: 1;
                        background: Theme.palette().surface-raised;
                        border-width: 1px;
                        border-color: Theme.palette().border;
                        border-radius: Theme.tokens.metrics.radius-medium;

                        EmptyState {
                            width: 100%;
                            height: 100%;
                            icon: "document";
                            title: "Content owns the window";
                            description: "Chrome is compact and neutral. Actions remain readable, panels are subordinate, and the primary work surface expands first.";
                            action-text: "Create Document";
                        }
                    }

                    Rectangle {
                        min-height: 112px;
                        max-height: 112px;
                        background: Theme.palette().surface-raised;
                        border-width: 1px;
                        border-color: Theme.palette().border;
                        border-radius: Theme.tokens.metrics.radius-medium;
                        VerticalLayout {
                            spacing: 8px;
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            TabControl { tabs: ["Document", "Comments", "History"]; current-tab: 0; }
                            HorizontalLayout {
                                spacing: 8px;
                                StatusPill { text: "Selected"; tone: 1; }
                                StatusPill { text: "Ready"; tone: 2; }
                                StatusPill { text: "Warning"; tone: 3; }
                                StatusPill { text: "Error"; tone: 4; }
                            }
                        }
                    }
                }
            }

            InspectorSurface {
                width: 280px;
                title: "Inspector";

                VerticalLayout {
                    spacing: 12px;
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 12px;
                    padding-bottom: 12px;

                    SectionHeader { title: "Transform"; }
                    Field { label: "X"; value: "120 px"; }
                    Field { label: "Y"; value: "84 px"; }

                    SectionHeader { title: "Appearance"; }
                    Slider { label: "Opacity"; value: 72; minimum: 0; maximum: 100; }
                    SegmentedControl { label: "Blend mode"; items: ["Normal", "Multiply", "Screen"]; current: 0; }

                    SectionHeader { title: "Accessibility"; }
                    Field { label: "Description"; placeholder: "Describe selection"; }
                    Switch { text: "Include in reading order"; checked: true; }
                }
            }
        }

        ToolkitStatusBar {
            leading: "Reference fixture • deterministic software renderer";
            trailing: "Ready";
        }
    }

    CommandPalette {
        open: false;
        selected: 0;
        query: "";
        commands: root.palette-commands;
    }
}
