// Loom UI deterministic component reference surface.
//
// This is not a marketing screenshot. It is the executable specimen for the
// shared desktop toolkit: common controls, selected/disabled states, panel
// hierarchy, toolbar density, and status chrome are rendered together from
// the same components applications consume. Human-approved captures of this
// surface become regression evidence; agents must not bless arbitrary output
// by replacing a baseline without review.

import {
    AppHeader, WorkspaceToolbar, ToolButton, IconButton, PrimaryButton,
    SearchField, SegmentedControl, Field, Slider, Switch, TabControl,
    EmptyState, Panel, InspectorSection, StatusBar, StatusPill,
    CommandPalette, CommandPaletteItem
} from "components.slint";
import { Theme } from "theme.slint";
export { Theme } from "theme.slint";

export component SmokeWindow inherits Window {
    title: "Loom UI Reference";
    width: 1280px;
    height: 800px;
    min-width: 1024px;
    min-height: 720px;
    background: Theme.palette().canvas;

    in-out property <[CommandPaletteItem]> palette-commands: [
        { id: "document.new", label: "New Document", shortcut: "Ctrl+N", enabled: true },
        { id: "document.open", label: "Open…", shortcut: "Ctrl+O", enabled: true },
        { id: "document.save", label: "Save", shortcut: "Ctrl+S", enabled: true },
        { id: "document.export", label: "Export…", shortcut: "Ctrl+E", enabled: false },
    ];

    VerticalLayout {
        spacing: 0px;
        padding: 0px;

        AppHeader {
            app-name: "Loom";
            document-title: "Component Reference";
            icon: "layers";
            context: "";
            state-text: "Local";
            state-tone: 0;
        }

        WorkspaceToolbar {
            ToolButton { icon: "new"; text: "New"; }
            ToolButton { icon: "open"; text: "Open"; }
            ToolButton { icon: "save"; text: "Save"; }
            IconButton { icon: "undo"; label: "Undo"; enabled: false; }
            IconButton { icon: "redo"; label: "Redo"; enabled: false; }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            SearchField { placeholder: "Search"; width: 180px; }
            ToolButton { icon: "export"; text: "Export"; }
        }

        HorizontalLayout {
            spacing: 0px;
            padding: 0px;
            vertical-stretch: 1;

            Panel {
                width: 256px;
                vertical-stretch: 1;
                header: "Controls";

                VerticalLayout {
                    spacing: 12px;
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 12px;
                    padding-bottom: 12px;

                    InspectorSection { title: "Buttons"; }
                    HorizontalLayout {
                        spacing: 6px;
                        ToolButton { icon: "bold"; text: "Bold"; checked: true; }
                        IconButton { icon: "italic"; label: "Italic"; }
                        IconButton { icon: "underline"; label: "Underline"; enabled: false; }
                    }
                    PrimaryButton { text: "Primary Action"; }

                    InspectorSection { title: "Fields"; }
                    Field { label: "Name"; placeholder: "Untitled"; value: "Project 01"; }
                    SearchField { placeholder: "Filter items"; }

                    InspectorSection { title: "Choice"; }
                    SegmentedControl { label: "Alignment"; items: ["Left", "Center", "Right"]; current: 0; }
                    Switch { text: "Snap to guides"; checked: true; }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: Theme.palette().canvas;

                VerticalLayout {
                    spacing: 12px;
                    padding-left: 16px;
                    padding-right: 16px;
                    padding-top: 16px;
                    padding-bottom: 16px;

                    Panel {
                        header: "Workspace hierarchy";
                        vertical-stretch: 1;
                        EmptyState {
                            width: 100%;
                            height: 100%;
                            icon: "document";
                            title: "Content owns the window";
                            description: "Chrome is compact and neutral. Actions remain readable, panels are subordinate, and the primary work surface expands first.";
                            action-text: "Create Document";
                        }
                    }

                    Panel {
                        min-height: 118px;
                        max-height: 118px;
                        header: "Navigation and state";
                        VerticalLayout {
                            spacing: 8px;
                            padding-left: 12px;
                            padding-right: 12px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            TabControl { tabs: ["Document", "Comments", "History"]; current-tab: 0; }
                            HorizontalLayout {
                                spacing: 8px;
                                StatusPill { text: "Selected"; tone: 1; }
                                StatusPill { text: "Ready"; tone: 2; }
                                StatusPill { text: "Warning"; tone: 3; }
                                StatusPill { text: "Error"; tone: 4; }
                            }
                        }
                    }
                }
            }

            Panel {
                width: 292px;
                vertical-stretch: 1;
                header: "Inspector";

                VerticalLayout {
                    spacing: 12px;
                    padding-left: 12px;
                    padding-right: 12px;
                    padding-top: 12px;
                    padding-bottom: 12px;

                    InspectorSection { title: "Transform"; }
                    Field { label: "X"; value: "120 px"; }
                    Field { label: "Y"; value: "84 px"; }

                    InspectorSection { title: "Appearance"; }
                    Slider { label: "Opacity"; value: 72; minimum: 0; maximum: 100; }
                    SegmentedControl { label: "Blend mode"; items: ["Normal", "Multiply", "Screen"]; current: 0; }

                    InspectorSection { title: "Accessibility"; }
                    Field { label: "Description"; placeholder: "Describe selection"; }
                    Switch { text: "Include in reading order"; checked: true; }
                }
            }
        }

        StatusBar {
            status-left: "Reference fixture • deterministic software renderer";
            status-right: "1280 × 800";
        }
    }

    CommandPalette {
        open: false;
        selected: 0;
        query: "";
        commands: root.palette-commands;
    }
}
