// Loom desktop design tokens.
//
// Runtime values are deterministic and derive from the machine-readable Loom
// design contract/token set. Application UI must not invent local colors or
// standard control geometry to compensate for a missing runtime token.

// The bundled UI typeface. Importing the files registers the family for every
// window that loads this module; a window opts in with
// `default-font-family: "Inter"`. See assets.toml for provenance.
import "fonts/Inter-Regular.ttf";
import "fonts/Inter-Medium.ttf";
import "fonts/Inter-SemiBold.ttf";
import "fonts/Inter-Bold.ttf";

struct Palette {
    canvas: color, canvas-alt: color, surface: color, surface-raised: color,
    surface-sunken: color, chrome: color, panel: color, overlay: color,
    ink: color, ink-secondary: color, ink-disabled: color,
    accent: color, accent-hover: color, accent-pressed: color, accent-ink: color,
    success: color, warning: color, danger: color, info: color,
    border: color, border-strong: color, focus: color, selection: color,
    selection-soft: color, danger-surface: color, shadow: color, scrim: color,
    grid-major: color, grid-minor: color, paper: color, paper-ink: color,
    paper-muted: color, paper-line: color, media-stage: color,
    content-accent: color, content-accent-soft: color, content-cool: color,
    content-cool-soft: color, meter-good: color, meter-warn: color,
}

struct TypeScale {
    micro: length, caption: length, body: length, body-large: length,
    title: length, heading: length, display: length, display-large: length,
}

struct Spacing {
    xs: length, sm: length, md: length, lg: length,
    xl: length, xxl: length, xxxl: length, xxxxl: length,
}

struct Motion {
    instant-ms: int, fast-ms: int, standard-ms: int, deliberate-ms: int,
    ease-out-x1: float, ease-out-y1: float, ease-out-x2: float, ease-out-y2: float,
}

struct Metrics {
    control-height: length,
    compact-control-height: length,
    toolbar-height: length,
    context-toolbar-height: length,
    labeled-toolbar-min-height: length,
    labeled-toolbar-max-height: length,
    header-height: length,
    panel-header-height: length,
    status-height: length,
    sheet-tab-height: length,
    formula-bar-height: length,
    icon-size: length,
    icon-small: length,
    radius-small: length,
    radius-medium: length,
    radius-large: length,
}

struct ThemeTokens {
    palette: Palette,
    typography: TypeScale,
    space: Spacing,
    motion: Motion,
    metrics: Metrics,
    reduced-motion: bool,
}

export global Theme {
    private property <ThemeTokens> light-tokens: {
        palette: {
            canvas: #f5f5f7, canvas-alt: #ececf0, surface: #ffffff,
            surface-raised: #ffffff, surface-sunken: #ededf0, chrome: #f9f9fb,
            panel: #f5f5f7, overlay: #fffffff8, ink: #1d1d1f,
            ink-secondary: #62626a,
            // Keep disabled labels subordinate while meeting the 4.5:1
            // body-text floor on light canvas, panel, surface, and wells.
            ink-disabled: #686870, accent: #0071e3,
            accent-hover: #006bd8, accent-pressed: #0062c4, accent-ink: #ffffff,
            success: #1e8e3e, warning: #b45309, danger: #d92d20, info: #0071e3,
            border: #e3e3e8, border-strong: #c9c9d0, focus: #0071e3,
            selection: #0071e3, selection-soft: #e6f0fc, danger-surface: #fdecea,
            shadow: #00000018, scrim: #0000004d, grid-major: #c9c9d0,
            grid-minor: #e3e3e8, paper: #ffffff, paper-ink: #1d1d1f,
            paper-muted: #6e6e73, paper-line: #e5e5ea, media-stage: #0a0a0c,
            content-accent: #0071e3, content-accent-soft: #e6f0fc,
            content-cool: #1a8f6e, content-cool-soft: #e3f6ef,
            meter-good: #1e8e3e, meter-warn: #b45309,
        },
        typography: {
            micro: 10px, caption: 11px, body: 13px, body-large: 14px,
            title: 13px, heading: 20px, display: 24px, display-large: 32px,
        },
        space: { xs: 2px, sm: 4px, md: 8px, lg: 12px, xl: 16px, xxl: 24px, xxxl: 32px, xxxxl: 48px },
        motion: {
            instant-ms: 0, fast-ms: 120, standard-ms: 180, deliberate-ms: 220,
            ease-out-x1: 0.33, ease-out-y1: 1.0, ease-out-x2: 0.68, ease-out-y2: 1.0,
        },
        metrics: {
            control-height: 28px, compact-control-height: 24px,
            toolbar-height: 40px, context-toolbar-height: 40px,
            labeled-toolbar-min-height: 48px, labeled-toolbar-max-height: 52px,
            header-height: 40px, panel-header-height: 32px,
            status-height: 28px, sheet-tab-height: 30px,
            formula-bar-height: 32px, icon-size: 16px, icon-small: 14px,
            radius-small: 4px, radius-medium: 6px, radius-large: 10px,
        },
        reduced-motion: false,
    };

    // Keep one complete, writable token bundle for consumers while selecting
    // the corresponding immutable theme bundle whenever the active theme
    // changes. This ensures reduced-motion and all non-palette tokens follow
    // the selected theme instead of only the palette function changing.
    in-out property <ThemeTokens> tokens: light-tokens;
    in-out property <string> active-theme: "light";
    // Direction is orthogonal to colour theme. Hosts set it from the
    // platform/document locale; primitives consume it without introducing
    // app-local palette or spacing overrides.
    in-out property <bool> rtl: false;
    // Accessibility text scale. It lives on the shared theme, not in an
    // application, so every primitive honours the same factor instead of each
    // app inventing its own multiplier. Hosts that support no scaling leave it
    // at 1.0, which renders exactly as before.
    //
    // `type` is the raw type scale multiplied by that factor. It is a bound
    // property rather than a function so a primitive can read it from a pure
    // measurement context such as `preferred-width`.
    in-out property <float> text-scale: 1.0;
    // Width of one in-window menu label; grows with text so labels never touch.
    out property <length> menu-label-width: 64px + 40px * (max(1.0, root.text-scale) - 1.0);
    in-out property <TypeScale> type: {
        micro: tokens.typography.micro * max(1.0, root.text-scale),
        caption: tokens.typography.caption * max(1.0, root.text-scale),
        body: tokens.typography.body * max(1.0, root.text-scale),
        body-large: tokens.typography.body-large * max(1.0, root.text-scale),
        title: tokens.typography.title * max(1.0, root.text-scale),
        heading: tokens.typography.heading * max(1.0, root.text-scale),
        display: tokens.typography.display * max(1.0, root.text-scale),
        display-large: tokens.typography.display-large * max(1.0, root.text-scale),
    };
    changed active-theme => {
        tokens = active-theme == "dark" ? ThemeDark.tokens
            : active-theme == "high-contrast" ? ThemeHighContrast.tokens
            : light-tokens;
    }
    public pure function palette() -> Palette {
        // All consumers read the same active token bundle. Keeping palette()
        // on `tokens` prevents palette-only branches from drifting away from
        // typography, metrics, motion, or reduced-motion state.
        return tokens.palette;
    }
}

export global ThemeDark {
    in-out property <ThemeTokens> tokens: {
        palette: {
            canvas: #1c1c1e, canvas-alt: #161618, surface: #232326,
            surface-raised: #2c2c30, surface-sunken: #18181a, chrome: #262629,
            panel: #202023, overlay: #2c2c30f2, ink: #f5f5f7,
            ink-secondary: #a1a1a8, ink-disabled: #9a9aa2, accent: #0968d8,
            accent-hover: #0a62cc, accent-pressed: #0757b8, accent-ink: #ffffff,
            success: #34c759, warning: #ffb340, danger: #ff6961, info: #4da3ff,
            border: #37373c, border-strong: #48484e, focus: #4da3ff,
            selection: #4da3ff, selection-soft: #14283f, danger-surface: #361919,
            shadow: #00000099, scrim: #000000b3, grid-major: #3a3a40,
            grid-minor: #2a2a2f, paper: #ffffff, paper-ink: #1d1d1f,
            paper-muted: #6e6e73, paper-line: #e5e5ea, media-stage: #0a0a0c,
            content-accent: #4da3ff, content-accent-soft: #14283f,
            content-cool: #34d0a3, content-cool-soft: #10302a,
            meter-good: #34c759, meter-warn: #ffb340,
        },
        typography: {
            micro: 10px, caption: 11px, body: 13px, body-large: 14px,
            title: 13px, heading: 20px, display: 24px, display-large: 32px,
        },
        space: { xs: 2px, sm: 4px, md: 8px, lg: 12px, xl: 16px, xxl: 24px, xxxl: 32px, xxxxl: 48px },
        motion: {
            instant-ms: 0, fast-ms: 120, standard-ms: 180, deliberate-ms: 220,
            ease-out-x1: 0.33, ease-out-y1: 1.0, ease-out-x2: 0.68, ease-out-y2: 1.0,
        },
        metrics: {
            control-height: 28px, compact-control-height: 24px,
            toolbar-height: 40px, context-toolbar-height: 40px,
            labeled-toolbar-min-height: 48px, labeled-toolbar-max-height: 52px,
            header-height: 40px, panel-header-height: 32px,
            status-height: 28px, sheet-tab-height: 30px,
            formula-bar-height: 32px, icon-size: 16px, icon-small: 14px,
            radius-small: 4px, radius-medium: 6px, radius-large: 10px,
        },
        reduced-motion: false,
    };
}

export global ThemeHighContrast {
    in-out property <ThemeTokens> tokens: {
        palette: {
            canvas: #000000, canvas-alt: #000000, surface: #000000,
            surface-raised: #161616, surface-sunken: #000000, chrome: #000000,
            panel: #000000, overlay: #000000f2, ink: #ffffff,
            ink-secondary: #ffffff, ink-disabled: #c8c8c8, accent: #ffd84d,
            accent-hover: #ffe681, accent-pressed: #e7bd25, accent-ink: #000000,
            success: #80ff80, warning: #ffbd52, danger: #ff7164, info: #80ccff,
            border: #ffffff, border-strong: #ffffff, focus: #ffd84d,
            selection: #ffd84d, selection-soft: #3a3200, danger-surface: #3d0d09,
            shadow: #000000, scrim: #000000cc, grid-major: #ffffff,
            grid-minor: #777777, paper: #ffffff, paper-ink: #000000,
            paper-muted: #222222, paper-line: #000000, media-stage: #000000,
            content-accent: #ffd84d, content-accent-soft: #ffffff,
            content-cool: #003cff, content-cool-soft: #ffffff,
            meter-good: #00ff66, meter-warn: #ffd84d,
        },
        typography: {
            micro: 10px, caption: 11px, body: 13px, body-large: 14px,
            title: 13px, heading: 20px, display: 24px, display-large: 32px,
        },
        space: { xs: 2px, sm: 4px, md: 8px, lg: 12px, xl: 16px, xxl: 24px, xxxl: 32px, xxxxl: 48px },
        motion: {
            instant-ms: 0, fast-ms: 0, standard-ms: 0, deliberate-ms: 0,
            ease-out-x1: 0.0, ease-out-y1: 1.0, ease-out-x2: 1.0, ease-out-y2: 1.0,
        },
        metrics: {
            control-height: 28px, compact-control-height: 24px,
            toolbar-height: 40px, context-toolbar-height: 40px,
            labeled-toolbar-min-height: 48px, labeled-toolbar-max-height: 52px,
            header-height: 40px, panel-header-height: 32px,
            status-height: 28px, sheet-tab-height: 30px,
            formula-bar-height: 32px, icon-size: 16px, icon-small: 14px,
            radius-small: 4px, radius-medium: 6px, radius-large: 10px,
        },
        reduced-motion: true,
    };
}

// Responsive geometry has one owner. Apps may project the resulting booleans
// into their controllers, but they must not invent a second 1180/1320 policy.
// The two toolbar slot sizes are deliberately explicit: a 40px context row
// cannot silently host a 48–52px icon-over-label control.
export global ResponsivePolicy {
    in-out property <length> priority-1-icon-only-below: 1180px;
    in-out property <length> priority-2-overflow-below: 1320px;
    in-out property <length> context-toolbar-height: 40px;
    in-out property <length> labeled-toolbar-min-height: 48px;
    in-out property <length> labeled-toolbar-max-height: 52px;

    public pure function priority-1-icon-only(width: length) -> bool {
        return width < priority-1-icon-only-below;
    }
    public pure function priority-2-overflow(width: length) -> bool {
        return width < priority-2-overflow-below;
    }
    public pure function uses-labeled-slot(width: length) -> bool {
        return width >= priority-2-overflow-below;
    }
    public pure function toolbar-height(labeled: bool) -> length {
        return labeled ? labeled-toolbar-min-height : context-toolbar-height;
    }
}
