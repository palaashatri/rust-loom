            selection: #d97a4a,
            selection-soft: #3d2b22,
            danger-surface: #3d2322,
            shadow: #00000080,
            scrim: #00000099,
            grid-major: #48484a,
            grid-minor: #303033,
            paper: #f8f8fa,
            paper-ink: #1d1d1f,
            paper-muted: #6e6e73,
            paper-line: #d1d1d6,
            media-stage: #070708,
            content-accent: #d97a4a,
            content-accent-soft: #3d2b22,
            content-cool: #6f9ab4,
            content-cool-soft: #22313a,
            meter-good: #58b478,
            meter-warn: #e0a24b,
        },
        typography: {
            micro: 10px,
            caption: 11px,
            body: 13px,
            body-large: 14px,
            title: 13px,
            heading: 20px,
            display: 24px,
            display-large: 32px,
        },
        space: { xs: 2px, sm: 4px, md: 8px, lg: 12px, xl: 16px, xxl: 24px, xxxl: 32px, xxxxl: 48px },
        motion: { instant-ms: 0, fast-ms: 120, standard-ms: 180, deliberate-ms: 220, ease-out-x1: 0.33, ease-out-y1: 1.0, ease-out-x2: 0.68, ease-out-y2: 1.0 },
        metrics: { control-height: 28px, compact-control-height: 24px, toolbar-height: 40px, header-height: 40px, panel-header-height: 32px, radius-small: 4px, radius-medium: 6px, radius-large: 10px },
        reduced-motion: false,
    };
}

export global ThemeHighContrast {
    in-out property <ThemeTokens> tokens: {
        palette: {
            canvas: #000000,
            canvas-alt: #000000,
            surface: #000000,
            surface-raised: #161616,
            surface-sunken: #000000,
            chrome: #000000,
            panel: #000000,
            overlay: #000000f2,
            ink: #ffffff,
            ink-secondary: #ffffff,
            ink-disabled: #c8c8c8,
            accent: #ffd84d,
            accent-hover: #ffe681,
            accent-pressed: #e7bd25,
            accent-ink: #000000,
            success: #80ff80,
            warning: #ffbd52,
            danger: #ff7164,
            info: #80ccff,
            border: #ffffff,
            border-strong: #ffffff,
            focus: #ffd84d,
            selection: #ffd84d,
            selection-soft: #3a3200,
            danger-surface: #3d0d09,
            shadow: #000000,
            scrim: #000000cc,
            grid-major: #ffffff,
            grid-minor: #777777,
            paper: #ffffff,
            paper-ink: #000000,
            paper-muted: #222222,
