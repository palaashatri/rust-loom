// Loom design tokens — semantic constants generated from the canonical
// token file in loom-design-bible/tokens/loom.toml.
//
// Palette: light (default), dark, high-contrast. Hosts switch themes by
// setting the `Theme.active-theme` global property from Rust, e.g.
// `Theme::get(&window).set_active_theme("dark")`; every component reads
// `Theme.palette()`, which resolves the active palette.

struct Palette {
    canvas: color,
    surface: color,
    surface-sunken: color,
    ink: color,
    ink-secondary: color,
    ink-disabled: color,
    accent: color,
    accent-hover: color,
    accent-ink: color,
    success: color,
    warning: color,
    danger: color,
    info: color,
    border: color,
    border-strong: color,
    focus: color,
    selection: color,
    selection-soft: color,
    danger-surface: color,
}

struct TypeScale {
    caption: length,
    body: length,
    body-large: length,
    title: length,
    heading: length,
    display: length,
    display-large: length,
}

struct Spacing {
    xs: length,
    sm: length,
    md: length,
    lg: length,
    xl: length,
    xxl: length,
    xxxl: length,
    xxxxl: length,
}

struct Motion {
    fast-ms: int,
    standard-ms: int,
    deliberate-ms: int,
    ease-out-x1: float,
    ease-out-y1: float,
    ease-out-x2: float,
    ease-out-y2: float,
}

struct ThemeTokens {
    palette: Palette,
    typography: TypeScale,
    space: Spacing,
    motion: Motion,
    reduced-motion: bool,
}

// Light palette.
export global Theme {
    in-out property <ThemeTokens> tokens: {
        palette: {
            canvas: #f2f2f0,
            surface: #fbfbfa,
            surface-sunken: #e8e8e5,
            ink: #1d1d1f,
            ink-secondary: #5f6065,
            ink-disabled: #96979c,
            accent: #b95f36,
            accent-hover: #c96b42,
            accent-ink: #ffffff,
            success: #397a52,
            warning: #a76520,
            danger: #b13a32,
            info: #3f6f9a,
            border: #d5d5d2,
            border-strong: #b8b8b5,
            focus: #d47749,
            selection: #b95f36,
            selection-soft: #f1ddd2,
            danger-surface: #f6dfdc,
        },
        typography: { caption: 11px, body: 13px, body-large: 14px, title: 15px, heading: 21px, display: 26px, display-large: 34px },
        space: { xs: 2px, sm: 4px, md: 8px, lg: 12px, xl: 16px, xxl: 24px, xxxl: 32px, xxxxl: 48px },
        motion: { fast-ms: 120, standard-ms: 200, deliberate-ms: 320, ease-out-x1: 0.33, ease-out-y1: 1.0, ease-out-x2: 0.68, ease-out-y2: 1.0 },
        reduced-motion: false,
    };

    in-out property <string> active-theme: "light";

    public pure function palette() -> Palette {
        return active-theme == "dark" ? ThemeDark.tokens.palette
            : active-theme == "high-contrast" ? ThemeHighContrast.tokens.palette
            : tokens.palette;
    }
}

// Dark palette (activated by the host when the user or system prefers dark).
export global ThemeDark {
    in-out property <ThemeTokens> tokens: {
        palette: {
            canvas: #0d0e10,
            surface: #17181b,
            surface-sunken: #111216,
            ink: #f5f5f2,
            ink-secondary: #a5a6ab,
            ink-disabled: #6d6f76,
            accent: #d97745,
            accent-hover: #e88958,
            accent-ink: #140c08,
            success: #65b983,
            warning: #dca251,
            danger: #e16e62,
            info: #77a8d3,
            border: #2b2d32,
            border-strong: #44474e,
            focus: #f09a6c,
            selection: #d97745,
            selection-soft: #3a271f,
            danger-surface: #3b2222,
        },
        typography: { caption: 11px, body: 13px, body-large: 14px, title: 15px, heading: 21px, display: 26px, display-large: 34px },
        space: { xs: 2px, sm: 4px, md: 8px, lg: 12px, xl: 16px, xxl: 24px, xxxl: 32px, xxxxl: 48px },
        motion: { fast-ms: 120, standard-ms: 200, deliberate-ms: 320, ease-out-x1: 0.33, ease-out-y1: 1.0, ease-out-x2: 0.68, ease-out-y2: 1.0 },
        reduced-motion: false,
    };
}

// High-contrast palette.
export global ThemeHighContrast {
    in-out property <ThemeTokens> tokens: {
        palette: {
            canvas: #000000,
            surface: #000000,
            surface-sunken: #1a1a1a,
            ink: #ffffff,
            ink-secondary: #ffffff,
            ink-disabled: #b0b0b0,
            accent: #ffd54a,
            accent-hover: #ffe082,
            accent-ink: #000000,
            success: #7cf27c,
            warning: #ffb547,
            danger: #ff6b5e,
            info: #7cc7ff,
            border: #ffffff,
            border-strong: #ffffff,
            focus: #ffd54a,
            selection: #ffd54a,
            selection-soft: #3a3a00,
            danger-surface: #3a0d0a,
        },
        typography: { caption: 11px, body: 13px, body-large: 14px, title: 15px, heading: 21px, display: 26px, display-large: 34px },
        space: { xs: 2px, sm: 4px, md: 8px, lg: 12px, xl: 16px, xxl: 24px, xxxl: 32px, xxxxl: 48px },
        motion: { fast-ms: 120, standard-ms: 200, deliberate-ms: 320, ease-out-x1: 0.33, ease-out-y1: 1.0, ease-out-x2: 0.68, ease-out-y2: 1.0 },
        reduced-motion: false,
    };
}
