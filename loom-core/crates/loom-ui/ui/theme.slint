// Loom desktop design tokens.
//
// Runtime values are intentionally boring and deterministic: neutral chrome,
// content-first surfaces, a restrained Loom accent, desktop-sized controls,
// and one shared geometry language. Normative values live in
// loom-design-bible/contracts/desktop-ui.toml. Do not add app-local colors or
// control geometry to compensate for a missing token; extend the contract.

struct Palette {
    canvas: color,
    canvas-alt: color,
    surface: color,
    surface-raised: color,
    surface-sunken: color,
    chrome: color,
    panel: color,
    overlay: color,
    ink: color,
    ink-secondary: color,
    ink-disabled: color,
    accent: color,
    accent-hover: color,
    accent-pressed: color,
    accent-ink: color,
    success: color,
    warning: color,
    danger: color,
    info: color,
    border: color,
    border-strong: color,
    focus: color,
    selection: color,
    selection-soft: color,
    danger-surface: color,
    shadow: color,
    scrim: color,
    grid-major: color,
    grid-minor: color,
    paper: color,
    paper-ink: color,
    paper-muted: color,
    paper-line: color,
    media-stage: color,
    content-accent: color,
    content-accent-soft: color,
    content-cool: color,
    content-cool-soft: color,
    meter-good: color,
    meter-warn: color,
}

struct TypeScale {
    micro: length,
    caption: length,
    body: length,
    body-large: length,
    title: length,
    heading: length,
    display: length,
    display-large: length,
}

struct Spacing {
    xs: length,
    sm: length,
    md: length,
    lg: length,
    xl: length,
    xxl: length,
    xxxl: length,
    xxxxl: length,
}

struct Motion {
    instant-ms: int,
    fast-ms: int,
    standard-ms: int,
    deliberate-ms: int,
    ease-out-x1: float,
    ease-out-y1: float,
    ease-out-x2: float,
    ease-out-y2: float,
}

struct Metrics {
    control-height: length,
    compact-control-height: length,
    toolbar-height: length,
    header-height: length,
    panel-header-height: length,
    radius-small: length,
    radius-medium: length,
    radius-large: length,
}

struct ThemeTokens {
    palette: Palette,
    typography: TypeScale,
    space: Spacing,
    motion: Motion,
    metrics: Metrics,
    reduced-motion: bool,
}

export global Theme {
    in-out property <ThemeTokens> tokens: {
        palette: {
            canvas: #f2f2f4,
            canvas-alt: #eaeaec,
            surface: #f7f7f8,
            surface-raised: #ffffff,
            surface-sunken: #ededef,
            chrome: #f6f6f7,
            panel: #f4f4f5,
            overlay: #fffffff2,
            ink: #1d1d1f,
            ink-secondary: #6e6e73,
            ink-disabled: #a1a1a6,
            accent: #b4552d,
            accent-hover: #c9643a,
            accent-pressed: #994724,
            accent-ink: #ffffff,
            success: #347a50,
            warning: #966019,
            danger: #a43424,
            info: #356d9a,
            border: #d1d1d6,
            border-strong: #b8b8bd,
            focus: #b4552d,
            selection: #b4552d,
            selection-soft: #f1ddd4,
            danger-surface: #f6deda,
            shadow: #0000001f,
            scrim: #00000066,
            grid-major: #c7c7cc,
            grid-minor: #e1e1e4,
            paper: #ffffff,
            paper-ink: #1d1d1f,
            paper-muted: #6e6e73,
            paper-line: #d1d1d6,
            media-stage: #0b0b0c,
            content-accent: #b4552d,
            content-accent-soft: #f1ddd4,
            content-cool: #3e6680,
            content-cool-soft: #e5edf2,
            meter-good: #4fa96d,
            meter-warn: #d49a3f,
        },
        // macOS-class desktop density: 13 logical px UI type and 28 px
        // standard controls. Document/media content owns its independent scale.
        typography: {
            micro: 10px,
            caption: 11px,
            body: 13px,
            body-large: 14px,
            title: 13px,
            heading: 20px,
            display: 24px,
            display-large: 32px,
        },
        space: {
            xs: 2px,
            sm: 4px,
            md: 8px,
            lg: 12px,
            xl: 16px,
            xxl: 24px,
            xxxl: 32px,
            xxxxl: 48px,
        },
        motion: {
            instant-ms: 0,
            fast-ms: 120,
            standard-ms: 180,
            deliberate-ms: 220,
            ease-out-x1: 0.33,
            ease-out-y1: 1.0,
            ease-out-x2: 0.68,
            ease-out-y2: 1.0,
        },
        metrics: {
            control-height: 28px,
            compact-control-height: 24px,
            toolbar-height: 40px,
            header-height: 40px,
            panel-header-height: 32px,
            radius-small: 4px,
            radius-medium: 6px,
            radius-large: 10px,
        },
        reduced-motion: false,
    };

    in-out property <string> active-theme: "light";

    public pure function palette() -> Palette {
        return active-theme == "dark" ? ThemeDark.tokens.palette
            : active-theme == "high-contrast" ? ThemeHighContrast.tokens.palette
            : tokens.palette;
    }
}

export global ThemeDark {
    in-out property <ThemeTokens> tokens: {
        palette: {
            canvas: #1c1c1e,
            canvas-alt: #18181a,
            surface: #242426,
            surface-raised: #2c2c2e,
            surface-sunken: #151517,
            chrome: #242426,
            panel: #202022,
            overlay: #2c2c2ef2,
            ink: #f5f5f7,
            ink-secondary: #aeaeb2,
            ink-disabled: #6c6c70,
            accent: #d97a4a,
            accent-hover: #e88b5e,
            accent-pressed: #be653b,
            accent-ink: #1c1c1e,
            success: #66bb84,
            warning: #dfa553,
            danger: #e27065,
            info: #78a9d2,
            border: #3a3a3c,
