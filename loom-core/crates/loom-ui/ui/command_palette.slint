// Loom command palette: a modal, keyboard-first list of commands that any
// application can host. components.slint re-exports these names, so the
// applications keep their import path.

import { Theme } from "theme.slint";

/// One command shown by the searchable command palette.
export struct CommandPaletteItem {
    /// Stable command identifier used by journey logs.
    id: string,
    /// Human-readable command name.
    label: string,
    /// Shortcut hint, such as `Ctrl+K`.
    shortcut: string,
    /// Whether the command can currently run.
    enabled: bool,
}

/// Modal, searchable, fully keyboard-operable command palette.
///
/// The host owns the command model and filters it as the query changes. The
/// palette renders the filtered list, keeps the selection index, and routes
/// every key through a single focus scope so the full journey — open, type,
/// move, invoke, close — works without a pointing device. `Escape` closes,
/// `Up`/`Down` move the selection, `Return` invokes, `Backspace` edits the
/// query, and printable characters append to the query. The typed query is
/// rendered as text (a palette search box does not need a blinking caret).
export component CommandPalette inherits Rectangle {
    in property <bool> open: false;
    in property <[CommandPaletteItem]> commands: [];
    in-out property <string> query: "";
    in-out property <int> selected: 0;
    callback command-invoked(int);
    callback query-changed(string);
    callback move-selection(int);
    callback key-text(string);
    callback backspace;
    callback close-requested;
    // Rows and the search field grow with text scale.
    private property <length> row-h: 34px * max(1.0, Theme.text-scale);
    private property <length> search-h: 32px * max(1.0, Theme.text-scale);

    /// Move keyboard focus into the palette's focus scope. The host calls
    /// this when opening the palette so the modal captures the next keypress.
    public function grab-focus() {
        focus-scope.focus();
    }

    /// Slint reports keys that are not text as key codes: modifiers, navigation,
    /// editing, lock and function keys. None of them belongs in the query.
    pure function is-key-code(text: string) -> bool {
        return text == Key.Shift || text == Key.ShiftR || text == Key.Control
            || text == Key.ControlR || text == Key.Alt || text == Key.AltGr
            || text == Key.Meta || text == Key.MetaR || text == Key.CapsLock
            || text == Key.Tab || text == Key.Backtab || text == Key.Insert
            || text == Key.Home || text == Key.End || text == Key.Delete
            || text == Key.LeftArrow || text == Key.RightArrow
            || text == Key.SysReq || text == Key.ScrollLock || text == Key.Pause
            || text == Key.Menu || text == Key.F1 || text == Key.F2 || text == Key.F3
            || text == Key.F4 || text == Key.F5 || text == Key.F6 || text == Key.F7
            || text == Key.F8 || text == Key.F9 || text == Key.F10 || text == Key.F11
            || text == Key.F12;
    }

    background: transparent;
    visible: root.open;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        background: Theme.palette().overlay;
        opacity: 0.78;
        touch := TouchArea {
            clicked => { root.close-requested(); }
        }
    }

    Rectangle {
        x: (parent.width - Math.min(560px, parent.width - 48px)) / 2;
        y: Math.max(64px, parent.height / 5);
        width: Math.min(560px, parent.width - 48px);
        // Fit the content, floored at one row and capped to keep scrolling.
        height: Math.min(
            430px,
            Math.min(parent.height - 140px, Math.max(104px + root.search-h, 70px + root.search-h + root.commands.length * root.row-h))
        );
        border-radius: 12px;
        border-width: 1px;
        border-color: focus-scope.has-focus ? Theme.palette().focus : Theme.palette().border-strong;
        background: Theme.palette().surface-raised;
        // Long lists stay inside the panel.
        clip: true;
        accessible-role: list;
        accessible-label: "Command palette";

        focus-scope := FocusScope {
            key-pressed(event) => {
                if (!root.open) { return reject; }
                if (event.modifiers.control || event.modifiers.alt || event.modifiers.meta) { return reject; }
                if (event.text == Key.Escape) { root.close-requested(); return accept; }
                if (event.text == Key.UpArrow) { root.move-selection(-1); return accept; }
                if (event.text == Key.DownArrow) { root.move-selection(1); return accept; }
                if (event.text == Key.PageUp) { root.move-selection(-8); return accept; }
                if (event.text == Key.PageDown) { root.move-selection(8); return accept; }
                if (event.text == Key.Return) {
                    root.command-invoked(root.selected);
                    return accept;
                }
                if (event.text == Key.Backspace) { root.backspace(); return accept; }
                // Keys that are not text are consumed here, so the query and the
                // page are left alone. The Shift press that precedes a capital
                // letter is one of them.
                if (root.is-key-code(event.text)) { return accept; }
                root.key-text(event.text);
                return accept;
            }
        }

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    height: root.search-h;
                    horizontal-stretch: 1;
                    border-radius: 7px;
                    border-width: 1px;
                    border-color: focus-scope.has-focus ? Theme.palette().focus : Theme.palette().border-strong;
                    background: Theme.palette().surface;
                    Text {
                        x: 12px;
                        vertical-alignment: center;
                        font-size: Theme.type.body;
                        color: Theme.palette().ink;
                        text: root.query == "" ? "Search commands…" : "> " + root.query;
                        width: parent.width - 24px;
                        overflow: clip;
                    }
                }
                Text {
                    text: Theme.text-scale > 1.5 ? "esc close" : "↑↓ select  Enter run  esc close";
                    font-size: Theme.type.caption;
                    color: Theme.palette().ink-disabled;
                    vertical-alignment: center;
                }
            }

            Rectangle {
                height: 1px;
                background: Theme.palette().border;
            }

            list-viewport := Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                min-height: 1px;
                preferred-height: 100%;
                clip: true;
                border-radius: 6px;

                Flickable {
                    // The list owns the viewport, while the repeated rows
                    // remain a fixed-height content surface. Keyboard moves
                    // update `selected`; this offset keeps that row visible.
                    width: parent.width;
                    height: parent.height;
                    preferred-height: 100%;
                    viewport-width: parent.width;
                    viewport-height: Math.max(parent.height, root.commands.length * root.row-h);
                    viewport-y: -Math.min(
                        Math.max(0px, Math.max(0, root.selected) * root.row-h - (parent.height - root.row-h)),
                        Math.max(0px, root.commands.length * root.row-h - parent.height)
                    );

                    VerticalLayout {
                        width: parent.width;
                        height: root.commands.length * root.row-h;
                        for item[idx] in root.commands : Rectangle {
                            height: root.row-h;
                            border-radius: 6px;
                            background: idx == root.selected ? Theme.palette().selection-soft
                                : row-touch.has-hover ? Theme.palette().surface-sunken : transparent;
                            border-width: 1px;
                            border-color: idx == root.selected ? Theme.palette().accent : transparent;
                            HorizontalLayout {
                                spacing: 8px;
                                padding-left: 10px;
                                padding-right: 10px;
                                Text {
                                    horizontal-stretch: 1;
                                    text: item.label;
                                    font-size: Theme.type.body;
                                    color: item.enabled ? Theme.palette().ink : Theme.palette().ink-disabled;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Text {
                                    text: item.shortcut;
                                    font-size: Theme.type.caption;
                                    color: Theme.palette().ink-secondary;
                                    vertical-alignment: center;
                                }
                            }
                            row-touch := TouchArea {
                                clicked => {
                                    focus-scope.focus();
                                    root.selected = idx;
                                    if (item.enabled) { root.command-invoked(idx); }
                                }
                            }
                            accessible-role: button;
                            accessible-label: item.label;
                            accessible-action-default => {
                                focus-scope.focus();
                                root.selected = idx;
                                if (item.enabled) { root.command-invoked(idx); }
                            }
                        }
                    }
                }

                if root.commands.length == 0 : Text {
                    x: 10px;
                    y: 0px;
                    width: parent.width - 20px;
                    height: root.row-h;
                    text: "No matching commands";
                    font-size: Theme.type.body;
                    color: Theme.palette().ink-secondary;
                    vertical-alignment: center;
                }

                // A slim, non-interactive rail makes the clipped list's
                // scrollable state discoverable without stealing row clicks.
                if root.commands.length * root.row-h > parent.height : Rectangle {
                    x: parent.width - 3px;
                    y: 4px;
                    width: 2px;
                    height: parent.height - 8px;
                    border-radius: 1px;
                    background: Theme.palette().border;
                }
            }
        }
    }
}

// Slint's default Rust component selection only emits roots that inherit
// Window. Keep the production palette as a Rectangle so applications can
// embed it in their own windows, and expose a tiny Window root solely for
// deterministic shared-component tests. The harness forwards the palette's
// real state and callbacks; it does not duplicate palette rendering.
export component CommandPaletteTestWindow inherits Window {
    in property <bool> open: false;
    in property <[CommandPaletteItem]> commands: [];
    in-out property <string> query: "";
    in-out property <int> selected: 0;
    callback command-invoked(int);
    callback query-changed(string);
    callback move-selection(int);
    callback key-text(string);
    callback backspace;
    callback close-requested;

    background: transparent;

    palette := CommandPalette {
        width: parent.width;
        height: parent.height;
        open: root.open;
        commands: root.commands;
        query <=> root.query;
        selected <=> root.selected;
        command-invoked(index) => { root.command-invoked(index); }
        query-changed(value) => { root.query-changed(value); }
        move-selection(delta) => { root.move-selection(delta); }
        key-text(value) => { root.key-text(value); }
        backspace => { root.backspace(); }
        close-requested => { root.close-requested(); }
    }
}
