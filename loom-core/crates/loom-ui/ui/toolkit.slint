// Loom Desktop Toolkit v2
//
// This module is the migration target for standard application chrome and
// controls. It obeys loom-design-bible/contracts/desktop-ui.toml. Application
// code supplies state/commands/content; it does not restyle these primitives.

import { Theme } from "theme.slint";
import { Icon } from "icons.slint";

export component DocumentChrome inherits Rectangle {
    in property <string> title: "Untitled";
    in property <bool> modified: false;
    in property <string> trailing-text: "";
    in property <bool> show-traffic-lights: true;
    min-height: Theme.tokens.metrics.header-height;
    max-height: Theme.tokens.metrics.header-height;
    background: Theme.palette().chrome;
    HorizontalLayout {
        spacing: 12px; padding-left: 12px; padding-right: 12px; cross-axis-alignment: center;

        // macOS native traffic lights (Close, Minimize, Zoom)
        if root.show-traffic-lights : HorizontalLayout {
            spacing: 8px; cross-axis-alignment: center; width: 56px;
            Rectangle { width: 12px; height: 12px; border-radius: 6px; background: Theme.palette().danger; }
            Rectangle { width: 12px; height: 12px; border-radius: 6px; background: Theme.palette().warning; }
            Rectangle { width: 12px; height: 12px; border-radius: 6px; background: Theme.palette().success; }
        }

        Text {
            text: root.title + (root.modified ? " — Edited" : "");
            font-size: Theme.tokens.typography.title; font-weight: 600;
            color: Theme.palette().ink; vertical-alignment: center;
            horizontal-alignment: center;
            horizontal-stretch: 1; overflow: elide;
        }

        if root.trailing-text != "" : Text {
            text: root.trailing-text; font-size: Theme.tokens.typography.caption;
            font-weight: 500; color: Theme.palette().ink-secondary; vertical-alignment: center;
            max-width: 320px; overflow: elide; horizontal-alignment: right;
        }
        if root.trailing-text == "" && root.show-traffic-lights : Rectangle { width: 56px; }
    }
    Rectangle { x: 0px; y: root.height - 1px; width: root.width; height: 1px; background: Theme.palette().border; }
}

export component Toolbar inherits Rectangle {
    min-height: 48px;
    max-height: 52px;
    background: Theme.palette().chrome;
    HorizontalLayout { spacing: 4px; padding-left: 8px; padding-right: 8px; cross-axis-alignment: center; @children }
    Rectangle { x: 0px; y: root.height - 1px; width: root.width; height: 1px; background: Theme.palette().border; }
}

export component ToolbarGroup inherits Rectangle {
    in property <bool> leading-separation: false;
    min-height: 44px;
    max-height: 48px;
    background: transparent;
    HorizontalLayout { spacing: 2px; padding-left: root.leading-separation ? 10px : 0px; cross-axis-alignment: center; @children }
}

export component ToolbarSpacer inherits Rectangle { horizontal-stretch: 1; background: transparent; }

/// Apple Creator Studio-style toolbar item: icon on top, label below.
export component AppleToolbarItem inherits Rectangle {
    in property <string> icon: "generic";
    in property <string> label: "";
    in property <bool> enabled: true;
    in property <bool> checked: false;
    callback clicked;

    min-width: max(48px, label-text.preferred-width + 16px);
    preferred-width: max(48px, label-text.preferred-width + 16px);
    height: 44px;
    border-radius: 6px;
    border-width: focus.has-focus ? 2px : root.checked ? 1px : 0px;
    border-color: focus.has-focus ? Theme.palette().focus : root.checked ? Theme.palette().accent : transparent;
    background: !root.enabled ? transparent
        : touch.pressed ? Theme.palette().surface-sunken
        : root.checked ? Theme.palette().selection-soft
        : touch.has-hover ? Theme.palette().surface-raised
        : transparent;
    accessible-role: button;
    accessible-label: root.label != "" ? root.label : root.icon;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    VerticalLayout {
        spacing: 2px; padding-top: 4px; padding-bottom: 4px; padding-left: 4px; padding-right: 4px;
        alignment: center; cross-axis-alignment: center;
        Icon {
            size: 18px; icon: root.icon;
            tint: !root.enabled ? Theme.palette().ink-disabled
                : root.checked ? Theme.palette().accent : Theme.palette().ink;
        }
        label-text := Text {
            text: root.label;
            font-size: 10px;
            font-weight: root.checked ? 600 : 500;
            color: !root.enabled ? Theme.palette().ink-disabled
                : root.checked ? Theme.palette().accent : Theme.palette().ink-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.clicked(); } }
}

export component ToolbarIconButton inherits Rectangle {
    in property <string> icon: "generic";
    in property <string> label: "";
    in property <bool> enabled: true;
    in property <bool> checked: false;
    callback clicked;
    width: Theme.tokens.metrics.control-height;
    height: Theme.tokens.metrics.control-height;
    border-radius: Theme.tokens.metrics.radius-medium;
    border-width: focus.has-focus ? 2px : checked ? 1px : 0px;
    border-color: focus.has-focus ? Theme.palette().focus : checked ? Theme.palette().border-strong : transparent;
    background: !enabled ? transparent
        : touch.pressed ? Theme.palette().surface-sunken
        : checked ? Theme.palette().selection-soft
        : touch.has-hover ? Theme.palette().surface-raised
        : transparent;
    accessible-role: button;
    accessible-label: label != "" ? label : icon;
    accessible-action-default => { if (enabled) { clicked(); } }
    Icon {
        x: (root.width - 16px) / 2; y: (root.height - 16px) / 2; size: 16px; icon: root.icon;
        tint: !root.enabled ? Theme.palette().ink-disabled : root.checked ? Theme.palette().accent : Theme.palette().ink-secondary;
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.clicked(); } }
}

export component ToolbarButton inherits Rectangle {
    in property <string> icon: "";
    in property <string> label: "Action";
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> checked: false;
    callback clicked;
    height: Theme.tokens.metrics.control-height;
    // Keep the label's intrinsic width as the lower bound. Without this, a
    // crowded toolbar can shrink a labelled button to the 28px icon target
    // while its text continues painting into neighbouring controls.
    min-width: max(Theme.tokens.metrics.control-height,
        label-content.preferred-width + (root.icon != "" ? Theme.tokens.metrics.icon-size + 6px : 0px) + 20px);
    preferred-width: max(Theme.tokens.metrics.control-height,
        label-content.preferred-width + (root.icon != "" ? Theme.tokens.metrics.icon-size + 6px : 0px) + 20px);
    border-radius: Theme.tokens.metrics.radius-medium;
    border-width: focus.has-focus ? 2px : root.primary || root.checked ? 1px : 0px;
    border-color: focus.has-focus ? Theme.palette().focus
        : root.primary ? Theme.palette().accent-hover
        : root.checked ? Theme.palette().border-strong : transparent;
    background: !root.enabled ? transparent
        : root.primary ? (touch.pressed ? Theme.palette().accent-pressed : touch.has-hover ? Theme.palette().accent-hover : Theme.palette().accent)
        : touch.pressed ? Theme.palette().surface-sunken
        : root.checked ? Theme.palette().selection-soft
        : touch.has-hover ? Theme.palette().surface-raised : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    HorizontalLayout {
        spacing: 6px; padding-left: 10px; padding-right: 10px; alignment: center; cross-axis-alignment: center;
        if root.icon != "" : Icon {
            size: 16px; icon: root.icon;
            tint: !root.enabled ? Theme.palette().ink-disabled : root.primary ? Theme.palette().accent-ink
                : root.checked ? Theme.palette().accent : Theme.palette().ink-secondary;
        }
        label-content := Text {
            text: root.label; font-size: Theme.tokens.typography.body; font-weight: 500;
            color: !root.enabled ? Theme.palette().ink-disabled : root.primary ? Theme.palette().accent-ink : Theme.palette().ink;
            vertical-alignment: center;
        }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) { root.clicked(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.clicked(); } }
}

export component PanelHeader inherits Rectangle {
    in property <string> title: "Panel";
    min-height: Theme.tokens.metrics.panel-header-height;
    max-height: Theme.tokens.metrics.panel-header-height;
    background: Theme.palette().panel;
    HorizontalLayout {
        spacing: 8px; padding-left: 12px; padding-right: 12px; cross-axis-alignment: center;
        Rectangle { width: 3px; height: 14px; border-radius: 2px; background: Theme.palette().accent; }
        Text {
            text: root.title; font-size: Theme.tokens.typography.title; font-weight: 600;
            color: Theme.palette().ink; vertical-alignment: center; horizontal-stretch: 1; overflow: elide;
        }
        @children
    }
}

export component SidebarSurface inherits Rectangle {
    in property <string> title: "";
    min-width: 200px; max-width: 360px; background: Theme.palette().panel;
    VerticalLayout {
        spacing: 0px; padding: 0px;
        if root.title != "" : PanelHeader { title: root.title; }
        Rectangle { vertical-stretch: 1; background: Theme.palette().panel; @children }
    }
    Rectangle { x: root.width - 1px; width: 1px; height: root.height; background: Theme.palette().border; }
}

export component InspectorSurface inherits Rectangle {
    in property <string> title: "Inspector";
    min-width: 240px; max-width: 360px; background: Theme.palette().panel;
    VerticalLayout {
        spacing: 0px; padding: 0px;
        PanelHeader { title: root.title; }
        Rectangle { vertical-stretch: 1; background: Theme.palette().panel; @children }
    }
    Rectangle { x: 0px; width: 1px; height: root.height; background: Theme.palette().border; }
}

export component SectionHeader inherits Rectangle {
    in property <string> title: "Section";
    min-height: Theme.tokens.metrics.control-height;
    max-height: Theme.tokens.metrics.control-height;
    background: transparent;
    Text {
        x: 0px; width: parent.width; height: parent.height; text: root.title;
        font-size: Theme.tokens.typography.title; font-weight: 600; color: Theme.palette().ink; vertical-alignment: center;
        overflow: elide;
    }
}

export component ToolkitStatusBar inherits Rectangle {
    in property <string> leading: "";
    in property <string> trailing: "";
    min-height: Theme.tokens.metrics.status-height;
    max-height: Theme.tokens.metrics.status-height;
    background: Theme.palette().chrome;
    Rectangle { x: 0px; y: 0px; width: root.width; height: 1px; background: Theme.palette().border; }
    HorizontalLayout {
        spacing: 12px; padding-left: 12px; padding-right: 12px; cross-axis-alignment: center;
        Text {
            text: root.leading; font-size: Theme.tokens.typography.caption; font-weight: 400;
            color: Theme.palette().ink-secondary; horizontal-stretch: 1; vertical-alignment: center; overflow: elide;
        }
        Text {
            text: root.trailing; font-size: Theme.tokens.typography.caption; font-weight: 500;
            color: Theme.palette().ink-secondary; vertical-alignment: center; overflow: elide;
            max-width: 320px;
        }
    }
}

export component CanvasSurface inherits Rectangle {
    background: Theme.palette().canvas; horizontal-stretch: 1; vertical-stretch: 1;
}

export component ContentSurface inherits Rectangle {
    background: Theme.palette().surface-raised;
    border-width: 1px; border-color: Theme.palette().border; border-radius: Theme.tokens.metrics.radius-medium;
}

/// Standard single-line desktop field. Labels belong outside the field in a
/// PropertyRow; `label` is the accessible name, never decorative in-field UI.
export component TextField inherits Rectangle {
    in property <string> label: "Field";
    in property <string> placeholder: "";
    in-out property <string> value: "";
    in property <bool> enabled: true;
    in property <bool> invalid: false;
    callback edited(string);
    callback accepted(string);
    callback cancelled;
    height: Theme.tokens.metrics.control-height;
    min-width: 120px;
    border-radius: Theme.tokens.metrics.radius-medium;
    border-width: input.has-focus ? 2px : 1px;
    border-color: root.invalid ? Theme.palette().danger : input.has-focus ? Theme.palette().focus : Theme.palette().border-strong;
    background: root.enabled ? Theme.palette().surface-raised : Theme.palette().surface-sunken;
    accessible-role: AccessibleRole.text-input;
    accessible-label: root.label;
    input := TextInput {
        x: 8px; width: root.width - 16px; height: root.height;
        text: root.value; enabled: root.enabled; single-line: true; vertical-alignment: center;
        font-size: Theme.tokens.typography.body;
        color: root.enabled ? Theme.palette().ink : Theme.palette().ink-disabled;
        edited => { root.value = input.text; root.edited(input.text); }
        accepted => { root.accepted(input.text); }
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.cancelled(); return accept; }
            return reject;
        }
    }
    if root.value == "" : Text {
        x: 8px; width: root.width - 16px; height: root.height; text: root.placeholder;
        font-size: Theme.tokens.typography.body; color: Theme.palette().ink-disabled;
        vertical-alignment: center; overflow: elide;
    }
    TouchArea { enabled: root.enabled; clicked => { input.focus(); } }
}

export component SearchField inherits Rectangle {
    in property <string> label: "Search";
    in property <string> placeholder: "Search";
    in-out property <string> value: "";
    in property <bool> enabled: true;
    callback edited(string);
    height: Theme.tokens.metrics.control-height;
    min-width: 160px;
    border-radius: Theme.tokens.metrics.radius-medium;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.palette().focus : Theme.palette().border-strong;
    background: root.enabled ? Theme.palette().surface-raised : Theme.palette().surface-sunken;
    accessible-role: AccessibleRole.text-input;
    accessible-label: root.label;
    Icon { x: 8px; y: 7px; size: 14px; icon: "search"; tint: Theme.palette().ink-secondary; }
    input := TextInput {
        x: 28px; width: root.width - 36px; height: root.height;
        text: root.value; enabled: root.enabled; single-line: true; vertical-alignment: center;
        font-size: Theme.tokens.typography.body; color: root.enabled ? Theme.palette().ink : Theme.palette().ink-disabled;
        edited => { root.value = input.text; root.edited(input.text); }
    }
    if root.value == "" : Text {
        x: 28px; width: root.width - 36px; height: root.height; text: root.placeholder;
        font-size: Theme.tokens.typography.body; color: Theme.palette().ink-disabled;
        vertical-alignment: center; overflow: elide;
    }
    TouchArea { enabled: root.enabled; clicked => { input.focus(); } }
}

export component SegmentedControl inherits Rectangle {
    in property <[string]> items: [];
    in property <string> label: "Options";
    in property <bool> enabled: true;
    in-out property <int> current: 0;
    callback selected(int);
    height: 28px;
    min-width: 120px;
    border-radius: 6px;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Theme.palette().focus : Theme.palette().border;
    background: Theme.palette().surface-sunken;
    accessible-role: radio-group;
    accessible-label: root.label;
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (!root.enabled || root.items.length == 0) { return reject; }
            if (event.text == Key.LeftArrow || event.text == Key.UpArrow) {
                root.current = max(0, root.current - 1); root.selected(root.current); return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.DownArrow) {
                root.current = min(root.items.length - 1, root.current + 1); root.selected(root.current); return accept;
            }
            return reject;
        }
    }
    HorizontalLayout {
        spacing: 2px; padding: 2px;
        for item[idx] in root.items : Rectangle {
            horizontal-stretch: 1;
            border-radius: 4px;
            background: idx == root.current ? Theme.palette().surface-raised : item-touch.has-hover ? Theme.palette().surface : transparent;
            border-width: idx == root.current ? 1px : 0px;
            border-color: idx == root.current ? Theme.palette().border-strong : transparent;
            Text {
                text: item; font-size: 11px; font-weight: idx == root.current ? 600 : 500;
                color: idx == root.current ? Theme.palette().ink : Theme.palette().ink-secondary;
                horizontal-alignment: center; vertical-alignment: center; overflow: elide;
            }
            item-touch := TouchArea {
                enabled: root.enabled;
                clicked => { focus.focus(); root.current = idx; root.selected(idx); }
            }
            accessible-role: button; accessible-label: item;
            accessible-action-default => { if (root.enabled) { root.current = idx; root.selected(idx); } }
        }
    }
}

export component Toggle inherits Rectangle {
    in property <string> label: "Option";
    in-out property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);
    height: Theme.tokens.metrics.control-height;
    min-width: 52px;
    background: transparent;
    accessible-role: checkbox; accessible-label: root.label; accessible-checked: root.checked;
    accessible-action-default => {
        if (root.enabled) { root.checked = !root.checked; root.toggled(root.checked); }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) {
                root.checked = !root.checked; root.toggled(root.checked); return accept;
            }
            return reject;
        }
    }
    HorizontalLayout {
        spacing: 8px; cross-axis-alignment: center;
        Rectangle {
            width: 32px; height: 18px; border-radius: 9px;
            background: !root.enabled ? Theme.palette().surface-sunken : root.checked ? Theme.palette().accent : Theme.palette().surface-sunken;
            border-width: focus.has-focus ? 2px : 1px;
            border-color: focus.has-focus ? Theme.palette().focus : root.checked ? Theme.palette().accent : Theme.palette().border-strong;
            Rectangle {
                x: root.checked ? 16px : 2px; y: 2px; width: 12px; height: 12px; border-radius: 6px;
                background: root.checked ? Theme.palette().accent-ink : Theme.palette().ink-secondary;
            }
        }
        Text {
            text: root.label; font-size: Theme.tokens.typography.body; font-weight: 500;
            color: root.enabled ? Theme.palette().ink : Theme.palette().ink-disabled; vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { focus.focus(); root.checked = !root.checked; root.toggled(root.checked); }
    }
}

export component RangeSlider inherits Rectangle {
    in property <string> label: "Value";
    in-out property <float> value: 0.0;
    in property <float> minimum: 0.0;
    in property <float> maximum: 100.0;
    in property <bool> enabled: true;
    callback changed(float);
    height: Theme.tokens.metrics.control-height;
    min-width: 120px;
    background: transparent;
    accessible-role: slider; accessible-label: root.label;
    accessible-value: root.value; accessible-value-minimum: root.minimum; accessible-value-maximum: root.maximum;
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (!root.enabled) { return reject; }
            if (event.text == Key.LeftArrow || event.text == Key.DownArrow) {
                root.value = max(root.minimum, root.value - (root.maximum - root.minimum) / 20.0); root.changed(root.value); return accept;
            }
            if (event.text == Key.RightArrow || event.text == Key.UpArrow) {
                root.value = min(root.maximum, root.value + (root.maximum - root.minimum) / 20.0); root.changed(root.value); return accept;
            }
            return reject;
        }
    }
    Rectangle {
        x: 0px; y: 12px; width: root.width; height: 4px; border-radius: 2px;
        background: Theme.palette().surface-sunken; border-width: 1px; border-color: Theme.palette().border;
        Rectangle {
            width: root.maximum > root.minimum ? clamp((root.value - root.minimum) / (root.maximum - root.minimum) * parent.width, 0px, parent.width) : 0px;
            height: parent.height; border-radius: 2px; background: root.enabled ? Theme.palette().accent : Theme.palette().ink-disabled;
        }
    }
    Rectangle {
        x: root.maximum > root.minimum ? clamp((root.value - root.minimum) / (root.maximum - root.minimum) * (root.width - 16px), 0px, root.width - 16px) : 0px;
        y: 6px; width: 16px; height: 16px; border-radius: 8px;
        background: Theme.palette().surface-raised; border-width: focus.has-focus ? 2px : 1px;
        border-color: focus.has-focus ? Theme.palette().focus : Theme.palette().accent;
    }
    touch := TouchArea {
        enabled: root.enabled;
        moved => {
            if (self.pressed) {
                focus.focus(); root.value = root.minimum + max(0.0, min(1.0, self.mouse-x / root.width)) * (root.maximum - root.minimum); root.changed(root.value);
            }
        }
        clicked => {
            focus.focus(); root.value = root.minimum + max(0.0, min(1.0, self.mouse-x / root.width)) * (root.maximum - root.minimum); root.changed(root.value);
        }
    }
}

export component PropertyRow inherits Rectangle {
    in property <string> label: "Property";
    min-height: Theme.tokens.metrics.control-height;
    HorizontalLayout {
        spacing: 8px; cross-axis-alignment: center;
        Text {
            text: root.label; min-width: 84px; max-width: 112px;
            font-size: Theme.tokens.typography.caption; font-weight: 500;
            color: Theme.palette().ink-secondary; vertical-alignment: center; overflow: elide;
        }
        Rectangle { horizontal-stretch: 1; @children }
    }
}

export component TabStrip inherits Rectangle {
    in property <[string]> tabs: [];
    in-out property <int> current: 0;
    callback selected(int);
    height: 30px;
    background: Theme.palette().chrome;
    accessible-role: tab;
    HorizontalLayout {
        spacing: 2px; padding-left: 4px; padding-right: 4px; padding-top: 2px; padding-bottom: 2px;
        for tab[idx] in root.tabs : Rectangle {
            // Tabs are content-sized controls.  Without an explicit preferred
            // width Slint may distribute the strip's spare width across the
            // repeated rectangles, making one tab consume most of the window.
            min-width: max(72px, tab-label.preferred-width + 16px);
            preferred-width: max(72px, tab-label.preferred-width + 16px);
            horizontal-stretch: 0;
            height: 26px; border-radius: Theme.tokens.metrics.radius-small;
            background: idx == root.current ? Theme.palette().selection-soft : touch.has-hover ? Theme.palette().surface-raised : transparent;
            border-width: idx == root.current ? 1px : 0px;
            border-color: idx == root.current ? Theme.palette().border-strong : transparent;
            tab-label := Text {
                text: tab; x: 8px; width: parent.width - 16px; font-size: Theme.tokens.typography.caption;
                font-weight: idx == root.current ? 600 : 500; color: Theme.palette().ink;
                vertical-alignment: center; horizontal-alignment: center; overflow: elide;
            }
            touch := TouchArea { clicked => { root.current = idx; root.selected(idx); } }
            accessible-role: AccessibleRole.tab; accessible-label: tab;
            accessible-action-default => { root.current = idx; root.selected(idx); }
        }
        Rectangle { horizontal-stretch: 1; }
    }
}

export component NumericStepper inherits Rectangle {
    in property <string> label: "Value";
    in-out property <string> value: "0";
    in property <string> suffix: "";
    in property <bool> enabled: true;
    callback incremented;
    callback decremented;
    callback edited(string);
    height: Theme.tokens.metrics.control-height;
    min-width: 90px;
    border-radius: Theme.tokens.metrics.radius-medium;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.palette().focus : Theme.palette().border-strong;
    background: root.enabled ? Theme.palette().surface-raised : Theme.palette().surface-sunken;
    accessible-role: AccessibleRole.text-input;
    accessible-label: root.label;
    accessible-value: root.value;

    HorizontalLayout {
        padding-left: 6px; padding-right: 2px; spacing: 2px; cross-axis-alignment: center;
        input := TextInput {
            text: root.value + (root.suffix != "" ? " " + root.suffix : "");
            enabled: root.enabled; single-line: true; vertical-alignment: center;
            font-size: Theme.tokens.typography.body; horizontal-stretch: 1;
            color: root.enabled ? Theme.palette().ink : Theme.palette().ink-disabled;
            edited => { root.value = input.text; root.edited(input.text); }
        }
        VerticalLayout {
            width: 18px; spacing: 1px; padding: 1px; alignment: center;
            Rectangle {
                height: 11px; border-radius: 2px;
                background: up-touch.pressed ? Theme.palette().surface-sunken : up-touch.has-hover ? Theme.palette().surface : transparent;
                Icon { x: 3px; y: 1px; size: 12px; icon: "chevron-up"; tint: root.enabled ? Theme.palette().ink : Theme.palette().ink-disabled; }
                up-touch := TouchArea { enabled: root.enabled; clicked => { root.incremented(); } }
            }
            Rectangle {
                height: 11px; border-radius: 2px;
                background: down-touch.pressed ? Theme.palette().surface-sunken : down-touch.has-hover ? Theme.palette().surface : transparent;
                Icon { x: 3px; y: 0px; size: 12px; icon: "chevron-down"; tint: root.enabled ? Theme.palette().ink : Theme.palette().ink-disabled; }
                down-touch := TouchArea { enabled: root.enabled; clicked => { root.decremented(); } }
            }
        }
    }
}

export component ColorSwatch inherits Rectangle {
    in property <color> color-value: Theme.palette().accent;
    in property <bool> checked: false;
    in property <bool> enabled: true;
    callback clicked;
    width: 24px; height: 24px; border-radius: 12px;
    border-width: root.checked ? 2px : 1px;
    border-color: root.checked ? Theme.palette().accent : Theme.palette().border-strong;
    background: transparent;
    Rectangle {
        x: root.checked ? 2px : 1px; y: root.checked ? 2px : 1px;
        width: root.width - (root.checked ? 4px : 2px);
        height: root.height - (root.checked ? 4px : 2px);
        border-radius: (parent.width - (root.checked ? 4px : 2px)) / 2;
        background: root.color-value;
    }
    TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

export component Badge inherits Rectangle {
    in property <string> text: "BADGE";
    in property <color> badge-color: Theme.palette().surface-sunken;
    in property <color> ink-color: Theme.palette().ink-secondary;
    height: 18px;
    min-width: label.preferred-width + 12px;
    preferred-width: label.preferred-width + 12px;
    border-radius: 4px;
    background: root.badge-color;
    border-width: 1px;
    border-color: Theme.palette().border;
    label := Text {
        text: root.text; font-size: Theme.tokens.typography.micro;
        font-weight: 600; color: root.ink-color;
        horizontal-alignment: center; vertical-alignment: center;
    }
}

export component ProgressBar inherits Rectangle {
    in property <float> progress: 0.0;
    in property <color> fill-color: Theme.palette().accent;
    height: 6px;
    min-width: 80px;
    border-radius: 3px;
    background: Theme.palette().surface-sunken;
    border-width: 1px;
    border-color: Theme.palette().border;
    accessible-role: AccessibleRole.progress-indicator;
    accessible-value: root.progress;
    Rectangle {
        x: 0px; y: 0px;
        width: clamp(root.progress * parent.width, 0px, parent.width);
        height: parent.height;
        border-radius: 3px;
        background: root.fill-color;
    }
}

export component TemplateCard inherits Rectangle {
    in property <string> title: "Blank";
    in property <string> subtitle: "";
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback clicked;
    width: 140px; height: 160px;
    border-radius: Theme.tokens.metrics.radius-medium;
    background: touch.has-hover ? Theme.palette().surface-raised : transparent;
    border-width: root.selected ? 2px : 0px;
    border-color: root.selected ? Theme.palette().accent : transparent;
    VerticalLayout {
        spacing: 6px; padding: 8px; alignment: center; cross-axis-alignment: center;
        Rectangle {
            width: 120px; height: 110px; border-radius: Theme.tokens.metrics.radius-small;
            background: Theme.palette().paper; border-width: 1px; border-color: Theme.palette().border;
            @children
        }
        Text {
            text: root.title; font-size: Theme.tokens.typography.body; font-weight: root.selected ? 600 : 500;
            color: root.selected ? Theme.palette().accent : Theme.palette().ink; horizontal-alignment: center;
            overflow: elide; max-width: 130px;
        }
        if root.subtitle != "" : Text {
            text: root.subtitle; font-size: Theme.tokens.typography.micro; color: Theme.palette().ink-secondary;
            horizontal-alignment: center; overflow: elide; max-width: 130px;
        }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

export component ModalSheet inherits Rectangle {
    in property <string> title: "Dialog";
    in property <length> sheet-width: 560px;
    in property <length> sheet-height: 440px;
    callback closed;
    width: 100%; height: 100%;
    background: Theme.palette().scrim;
    TouchArea { clicked => { } }
    sheet := Rectangle {
        x: (parent.width - root.sheet-width) / 2;
        y: (parent.height - root.sheet-height) / 2;
        width: root.sheet-width;
        height: root.sheet-height;
        border-radius: Theme.tokens.metrics.radius-large;
        background: Theme.palette().chrome;
        border-width: 1px;
        border-color: Theme.palette().border-strong;
        VerticalLayout {
            spacing: 0px; padding: 0px;
            Rectangle {
                height: 44px; background: Theme.palette().surface;
                border-radius: Theme.tokens.metrics.radius-large;
                HorizontalLayout {
                    padding-left: 16px; padding-right: 16px; cross-axis-alignment: center;
                    Text {
                        text: root.title; font-size: Theme.tokens.typography.heading;
                        font-weight: 700; color: Theme.palette().ink; horizontal-stretch: 1;
                    }
                    ToolbarIconButton { icon: "close"; label: "Close"; clicked => { root.closed(); } }
                }
                Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.palette().border; }
            }
            Rectangle {
                vertical-stretch: 1; background: Theme.palette().canvas;
                @children
            }
        }
    }
}

export component VULevelMeter inherits Rectangle {
    in property <float> level-db: -60.0;
    in property <bool> peak-hold: false;
    width: 12px; height: 120px;
    background: Theme.palette().surface-sunken;
    border-radius: 2px;
    border-width: 1px;
    border-color: Theme.palette().border;
    Rectangle {
        x: 1px; y: parent.height - 1px - max(0px, min(parent.height - 2px, (root.level-db + 60.0) / 66.0 * (parent.height - 2px)));
        width: parent.width - 2px;
        height: max(0px, min(parent.height - 2px, (root.level-db + 60.0) / 66.0 * (parent.height - 2px)));
        background: root.level-db > 0.0 ? Theme.palette().danger : root.level-db > -6.0 ? Theme.palette().warning : Theme.palette().meter-good;
    }
}
