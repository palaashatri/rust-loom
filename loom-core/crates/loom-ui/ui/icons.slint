// Loom icon family — original minimal line icons.
//
// All icons are drawn on a 20x20 logical grid with a 1.5px stroke and
// round caps/joins, matching loom-design-bible/ICONOGRAPHY.md. They are
// original geometric constructions, not derived from any proprietary set.
// The `commands` property takes SVG path data (parsed by the Slint
// compiler), keeping each icon deterministic and serializable.

import { Theme } from "theme.slint";

export component Icon inherits Rectangle {
    in property <string> icon: "generic";
    in property <color> tint: Theme.palette().ink;
    in property <length> size: 20px;
    width: size;
    height: size;
    background: transparent;

    Path {
        x: 0px;
        y: 0px;
        // Scale the 20-unit source path into the requested icon slot. Keeping
        // a fixed 20px viewport made small (14/16/18px) icons paint into their
        // neighbouring labels and outside their button bounds.
        width: parent.width;
        height: parent.height;
        stroke: parent.tint;
        // Path geometry is fitted to the requested icon slot, but Slint keeps
        // stroke-width in logical pixels rather than applying that fit scale.
        // Scale the source-grid stroke with the slot so 14/16/18px icons keep
        // the same proportional weight as the 20px source artwork.
        stroke-width: max(1.35px, 1.65px * (parent.width / 20px));
        fill: transparent;
        stroke-line-cap: round;
        stroke-line-join: round;
        commands: { if (parent.icon == "document") { "M6 2.5 L12.5 2.5 L16 6 L16 16 Q16 17.5 14.5 17.5 L5.5 17.5 Q4 17.5 4 16 L4 4.5 Q4 2.5 6 2.5 Z M12.5 2.5 L12.5 6 L16 6"
            }
            else if (parent.icon == "download") { "M10 3 L10 13 M6.5 9.5 L10 13 L13.5 9.5 M4 14.5 L4 16 Q4 17 5 17 L15 17 Q16 17 16 16 L16 14.5"
            }
            else if (parent.icon == "folder") { "M4 5 Q2.5 5 2.5 6.5 L2.5 15 Q2.5 16.5 4 16.5 L16 16.5 Q17.5 16.5 17.5 15 L17.5 8.5 Q17.5 7 16 7 L10 7 L8.5 5 Z"
            }
            else if (parent.icon == "folder-open") { "M2.5 6.5 Q2.5 5 4 5 L7.5 5 L9 7 L16 7 Q17.5 7 17.5 8.5 M3.5 9.5 L16.5 9.5 Q17.5 9.5 17.2 10.5 L15.7 15.5 Q15.4 16.5 14.4 16.5 L4.6 16.5 Q3.6 16.5 3.3 15.5 L2.5 10.5 Q2.3 9.5 3.5 9.5 Z"
            }
            else if (parent.icon == "save") { "M4.5 2.5 L13.5 2.5 L17.5 6.5 L17.5 16 Q17.5 17.5 16 17.5 L4 17.5 Q2.5 17.5 2.5 16 L2.5 4 Q2.5 2.5 4.5 2.5 Z M6 2.5 L6 7 Q6 7.5 6.5 7.5 L13.5 7.5 Q14 7.5 14 7 L14 3 M5.5 17.5 L5.5 12 Q5.5 11.5 6 11.5 L14 11.5 Q14.5 11.5 14.5 12 L14.5 17.5"
            }
            else if (parent.icon == "save-as") { "M3.5 2.5 L12.5 2.5 L16.5 6.5 L16.5 17.5 L2.5 17.5 L2.5 2.5 Z M5 2.5 L5 7.5 L13 7.5 M5.5 17.5 L5.5 11.5 L13.5 11.5 L13.5 17.5 M15 10 L15 15 M12.5 12.5 L17.5 12.5"
            }
            else if (parent.icon == "open") { "M2.5 6.5 Q2.5 5.5 3.5 5.5 L7.5 5.5 L9 7.5 L16.5 7.5 Q17.5 7.5 17.5 8.5 L15.7 15 Q15.4 16 14.4 16 L4.6 16 Q3.6 16 3.3 15 Z"
            }
            else if (parent.icon == "new") { "M10 3 L10 17 M3 10 L17 10"
            }
            else if (parent.icon == "undo") { "M5 6 A6.7 6.7 0 1 0 15 6 M5 6 L8.5 6 M5 6 L5 9.5"
            }
            else if (parent.icon == "redo") { "M15 6 A6.7 6.7 0 1 1 5 6 M15 6 L11.5 6 M15 6 L15 9.5"
            }
            else if (parent.icon == "play") { "M6.5 4.8 Q6.5 3.8 7.4 4.3 L15.6 9.3 Q16.4 9.8 15.6 10.5 L7.4 15.6 Q6.5 16.2 6.5 15.2 Z"
            }
            else if (parent.icon == "present") { "M3.5 4.5 Q3.5 3.5 4.5 3.5 L15.5 3.5 Q16.5 3.5 16.5 4.5 L16.5 12.5 Q16.5 13.5 15.5 13.5 L4.5 13.5 Q3.5 13.5 3.5 12.5 Z M10 13.5 L10 17.5 M6.5 17.5 L10 15 L13.5 17.5"
            }
            else if (parent.icon == "pause") { "M6.5 3.5 L6.5 16.5 M13.5 3.5 L13.5 16.5"
            }
            else if (parent.icon == "stop") { "M6 4.5 L14 4.5 L14 15.5 L6 15.5 Z"
            }
            else if (parent.icon == "trash") { "M4 5.5 L16 5.5 M8 3 Q8 2.5 8.5 2.5 L11.5 2.5 Q12 2.5 12 3 L12 5.5 M6 5.5 L6.8 15.5 Q6.9 16.5 7.9 16.5 L12.1 16.5 Q13.1 16.5 13.2 15.5 L14 5.5"
            }
            else if (parent.icon == "trash-2") { "M3.5 5.5 L16.5 5.5 M8 5.5 L8 3.5 Q8 3 8.5 3 L11.5 3 Q12 3 12 3.5 L12 5.5 M5.5 5.5 L6.4 15.5 Q6.5 16.5 7.5 16.5 L12.5 16.5 Q13.5 16.5 13.6 15.5 L14.5 5.5 M9 8.5 L9 14 M11 8.5 L11 14"
            }
            else if (parent.icon == "plus") { "M10 4.5 L10 15.5 M4.5 10 L15.5 10"
            }
            else if (parent.icon == "plus-circle") { "M10 2.5 A7.5 7.5 0 1 1 10 17.5 A7.5 7.5 0 1 1 10 2.5 M10 6.5 L10 13.5 M6.5 10 L13.5 10"
            }
            else if (parent.icon == "minus") { "M4.5 10 L15.5 10"
            }
            else if (parent.icon == "more") { "M4.5 10 A0.9 0.9 0 1 1 4.5 10.01 M10 10 A0.9 0.9 0 1 1 10 10.01 M15.5 10 A0.9 0.9 0 1 1 15.5 10.01"
            }
            else if (parent.icon == "search") { "M8.8 3.5 A5.3 5.3 0 1 1 8.8 14.1 A5.3 5.3 0 1 1 8.8 3.5 M12.8 12.8 L17 17"
            }
            else if (parent.icon == "settings") { "M3 7 L17 7 M3 13 L17 13 M8 5.2 A1.8 1.8 0 1 1 8 8.8 A1.8 1.8 0 1 1 8 5.2 M13.5 11.2 A1.8 1.8 0 1 1 13.5 14.8 A1.8 1.8 0 1 1 13.5 11.2"
            }
            else if (parent.icon == "export") { "M10 3 L10 12.5 M6.5 6.5 L10 3 L13.5 6.5 M4 12.5 L4 15.5 Q4 16.5 5 16.5 L15 16.5 Q16 16.5 16 15.5 L16 12.5"
            }
            else if (parent.icon == "import") { "M10 3 L10 12.5 M6.5 9 L10 12.5 L13.5 9 M4 14 L4 16 Q4 17 5 17 L15 17 Q16 17 16 16 L16 14"
            }
            else if (parent.icon == "grid") { "M3.5 3.5 L8.5 3.5 L8.5 8.5 L3.5 8.5 Z M11.5 3.5 L16.5 3.5 L16.5 8.5 L11.5 8.5 Z M3.5 11.5 L8.5 11.5 L8.5 16.5 L3.5 16.5 Z M11.5 11.5 L16.5 11.5 L16.5 16.5 L11.5 16.5 Z"
            }
            else if (parent.icon == "layers") { "M10 3 L17 7.5 L10 12 L3 7.5 Z M3 11 L17 11 M3 14.5 L17 14.5"
            }
            else if (parent.icon == "image") { "M4.5 4 L15.5 4 Q17 4 17 5.5 L17 14.5 Q17 16 15.5 16 L4.5 16 Q3 16 3 14.5 L3 5.5 Q3 4 4.5 4 Z M3 13 L7.5 8.5 L11.5 12 L14 9.5 L17 12.5 M7.5 6.5 A1.1 1.1 0 1 1 7.5 8.7 A1.1 1.1 0 1 1 7.5 6.5"
            }
            else if (parent.icon == "video") { "M3 5 L17 5 L17 15 L3 15 Z M8.5 7.5 L13.5 10 L8.5 12.5 Z"
            }
            else if (parent.icon == "audio") { "M8 15.5 L8 5 L15 3.5 L15 14 M6.5 13.5 A2 2 0 1 1 6.5 17.5 A2 2 0 1 1 6.5 13.5 M13.5 12 A2 2 0 1 1 13.5 16 A2 2 0 1 1 13.5 12"
            }
            else if (parent.icon == "table") { "M4.5 3.5 L15.5 3.5 Q17 3.5 17 5 L17 15 Q17 16.5 15.5 16.5 L4.5 16.5 Q3 16.5 3 15 L3 5 Q3 3.5 4.5 3.5 Z M3 8 L17 8 M3 12.5 L17 12.5 M9.5 3.5 L9.5 16.5"
            }
            else if (parent.icon == "slide") { "M4 5 L16 5 Q17.5 5 17.5 6.5 L17.5 13.5 Q17.5 15 16 15 L4 15 Q2.5 15 2.5 13.5 L2.5 6.5 Q2.5 5 4 5 Z M7.5 5 L7.5 15"
            }
            else if (parent.icon == "timeline") { "M3 4 L3 16 M6.5 8 L9.5 8 M6.5 12 L13.5 12 M14.5 5 L14.5 15"
            }
            else if (parent.icon == "waveform") { "M3 10 L6 10 L7 5.5 L9.5 14.5 L12 6.5 L13.5 10 L17 10"
            }
            else if (parent.icon == "check") { "M4.5 10.5 L8.5 14.5 L15.5 6"
            }
            else if (parent.icon == "chevron-left") { "M12 4 L7 10 L12 16"
            }
            else if (parent.icon == "chevron-right") { "M8 4 L13 10 L8 16"
            }
            else if (parent.icon == "close") { "M5 5 L15 15 M15 5 L5 15"
            }
            else if (parent.icon == "zoom-in") { "M8.8 3.5 A5.3 5.3 0 1 1 8.8 14.1 A5.3 5.3 0 1 1 8.8 3.5 M12.8 12.8 L17 17 M8.8 6.3 L8.8 11.3 M6.3 8.8 L11.3 8.8"
            }
            else if (parent.icon == "cursor") { "M6 3.5 L6 14 L9 11.5 L11 16.5 L13 15.5 L11 11 L14.5 11 Z"
            }
            else if (parent.icon == "text") { "M10 3.5 L10 16.5 M5 4.5 L15 4.5 M7.5 16.5 L12.5 16.5"
            }
            else if (parent.icon == "text-box") { "M4.5 3.5 L15.5 3.5 Q17 3.5 17 5 L17 15 Q17 16.5 15.5 16.5 L4.5 16.5 Q3 16.5 3 15 L3 5 Q3 3.5 4.5 3.5 Z M7 7.5 L13 7.5 M10 7.5 L10 13.5"
            }
            else if (parent.icon == "brush") { "M4 16.5 C6.5 14 11 8 14 5 L15.5 3.5 L16.5 4.5 L15 6 C11 9.5 6.5 13.5 4 16.5"
            }
            else if (parent.icon == "camera") { "M2.5 9 L6 9 L8 6 L12 6 L14 9 L17.5 9 L17.5 16 L2.5 16 Z M10 8 A3 3 0 1 1 10 14 A3 3 0 1 1 10 8"
            }
            else if (parent.icon == "scissors") { "M6 3.5 A2.5 2.5 0 1 1 6 8.5 A2.5 2.5 0 1 1 6 3.5 M6 11.5 A2.5 2.5 0 1 1 6 16.5 A2.5 2.5 0 1 1 6 11.5 M8 7.5 L16 15 M8 12.5 L16 5"
            }
            else if (parent.icon == "clock") { "M10 3 A7 7 0 1 1 10 17 A7 7 0 1 1 10 3 M10 6.5 L10 10 L12.8 11.8"
            }
            else if (parent.icon == "keyboard") { "M2.5 7 L17.5 7 L17.5 15 L2.5 15 Z M7 12.8 L13 12.8 M4.8 10.2 L6.2 10.2 M8.5 10.2 L9.9 10.2 M12.2 10.2 L13.6 10.2"
            }
            else if (parent.icon == "eye") { "M2.5 10 C5.5 6 14.5 6 17.5 10 C14.5 14 5.5 14 2.5 10 Z M10 7.5 A2.5 2.5 0 1 1 10 12.5 A2.5 2.5 0 1 1 10 7.5"
            }
            else if (parent.icon == "eye-off") { "M2.5 10 C5.5 6 14.5 6 17.5 10 C14.5 14 5.5 14 2.5 10 Z M10 7.5 A2.5 2.5 0 0 1 12.5 10 M3 3 L17 17"
            }
            else if (parent.icon == "mask") { "M10 3.5 A6.5 6.5 0 1 1 10 16.5 A6.5 6.5 0 1 1 10 3.5 M10 8 A2 2 0 1 1 10 12 A2 2 0 1 1 10 8"
            }
            else if (parent.icon == "wand") { "M4 16.5 L13.5 7 M15 3.5 L15 6 M12.5 3.5 L12.5 6 M10 5 L11 6 M15 8 L16 9 M17.5 5 L16.5 6"
            }
            else if (parent.icon == "film") { "M2.5 4 L17.5 4 L17.5 16 L2.5 16 Z M5.5 4 L5.5 16 M14.5 4 L14.5 16 M6.5 7.4 L6.5 7 M6.5 13.4 L6.5 13 M13.5 7.4 L13.5 7 M13.5 13.4 L13.5 13"
            }
            else if (parent.icon == "link") { "M8.5 13 C6 15.5 3.5 14.5 3.5 11.5 C3.5 8.5 6 7.5 8.5 8 M11.5 7 C14 4.5 16.5 5.5 16.5 8.5 C16.5 11.5 14 12.5 11.5 12"
            }
            else if (parent.icon == "terminal") { "M2.5 4.5 L17.5 4.5 L17.5 15.5 L2.5 15.5 Z M6 8 L9.5 10.5 L6 13"
            }
            else if (parent.icon == "package") { "M10 2.5 L17 5.5 L17 14.5 L10 17.5 L3 14.5 L3 5.5 Z M3 5.5 L10 8.5 L17 5.5 M10 8.5 L10 17.5"
            }
            else if (parent.icon == "scale") { "M10 3 L10 17 M4 17 L16 17 M4 3.5 L4 7 M16 3.5 L16 7 M2.5 7 L5.5 7 M14.5 7 L17.5 7"
            }
            else if (parent.icon == "waves") { "M3 10 L5.5 10 C6.5 4 8.5 16 10 9 C11.5 16 13.5 4 14.5 10 L17 10"
            }
            else if (parent.icon == "bold") { "M6 4 Q6 3.5 6.5 3.5 L11 3.5 C13.2 3.5 14.5 4.8 14.5 6.75 C14.5 8.7 13.2 10 11 10 L6 10 M6 3.5 L6 16.5 L11.8 16.5 C14.2 16.5 15.5 15.1 15.5 13.25 C15.5 11.4 14.2 10 11.8 10 L6 10"
            }
            else if (parent.icon == "italic") { "M12 3.5 L7.5 16.5 M9 3.5 L14.5 3.5 M5.5 16.5 L11 16.5"
            }
            else if (parent.icon == "underline") { "M5.5 3.5 L5.5 10 C5.5 12.8 7.5 15 10 15 C12.5 15 14.5 12.8 14.5 10 L14.5 3.5 M4.5 17.5 L15.5 17.5"
