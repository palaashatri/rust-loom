// Canonical icon-over-label toolbar item. It lives in its own module so that
// toolkit.slint, a legacy file with a byte ceiling, can shrink; toolkit.slint
// re-exports it unchanged.

import { Theme, ResponsivePolicy } from "theme.slint";
import { Icon } from "icons.slint";

/// Canonical toolbar item (icon over label); `AppleToolbarItem` is its alias.
export component IconOverLabelToolbarItem inherits Rectangle {
    in property <string> icon: "generic";
    in property <string> label: "";
    // The name assistive technology announces when it must differ from the
    // visible label, for example when two toolbar items share one caption.
    in property <string> accessible-name: "";
    in property <bool> enabled: true;
    in property <bool> checked: false;
    property <color> on-tint: Theme.control-accent;
    callback clicked;
    // Left (-1) and Right (+1). The key still bubbles, so a host that does not
    // connect this callback sees the same key as before.
    callback arrow(int);
    public function focus-item() { focus.focus(); }

    min-width: max(48px, label-text.preferred-width + 16px);
    preferred-width: max(48px, label-text.preferred-width + 16px);
    // The host owns the slot; compact hosts use the icon-only variant.
    min-height: ResponsivePolicy.labeled-toolbar-min-height + ResponsivePolicy.toolbar-label-extra;
    max-height: ResponsivePolicy.labeled-toolbar-max-height + ResponsivePolicy.toolbar-label-extra;
    border-radius: Theme.tokens.metrics.radius-medium;
    border-width: 0px;
    border-color: transparent;
    background: !root.enabled ? transparent
        : touch.pressed ? Theme.palette().surface-sunken
        : root.checked ? Theme.palette().selection-soft
        : touch.has-hover ? Theme.palette().surface-raised
        : transparent;
    accessible-role: button;
    accessible-label: root.accessible-name != "" ? root.accessible-name : root.label != "" ? root.label : root.icon;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }

    VerticalLayout {
        spacing: 2px; padding-top: 4px; padding-bottom: 4px; padding-left: 4px; padding-right: 4px;
        alignment: center; cross-axis-alignment: center;
        Icon {
            size: 18px * max(1.0, Theme.text-scale); icon: root.icon;
            tint: !root.enabled ? Theme.palette().ink-disabled
                : root.checked ? root.on-tint : Theme.palette().ink;
        }
        label-text := Text {
            text: root.label;
            font-size: Theme.type.caption;
            min-height: Theme.leading.caption;
            wrap: no-wrap;
            font-weight: root.checked ? 600 : 500;
            color: !root.enabled ? Theme.palette().ink-disabled
                : root.checked ? root.on-tint : Theme.palette().ink-secondary;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    state-outline := Rectangle {
        x: Theme.tokens.metrics.focus-offset;
        y: Theme.tokens.metrics.focus-offset;
        width: max(0px, root.width - 2 * Theme.tokens.metrics.focus-offset);
        height: max(0px, root.height - 2 * Theme.tokens.metrics.focus-offset);
        border-radius: max(0px, Theme.tokens.metrics.radius-medium - Theme.tokens.metrics.focus-offset);
        border-width: focus.has-focus ? Theme.tokens.metrics.focus-ring : root.checked ? 1px : 0px;
        border-color: focus.has-focus ? Theme.palette().focus : root.checked ? Theme.palette().accent : transparent;
        background: transparent;
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Space || event.text == Key.Return) { root.clicked(); return accept; }
            if (event.text == Key.LeftArrow) { root.arrow(-1); }
            if (event.text == Key.RightArrow) { root.arrow(1); }
            return reject;
        }
    }
    touch := TouchArea { enabled: root.enabled; clicked => { focus.focus(); root.clicked(); } }
}
