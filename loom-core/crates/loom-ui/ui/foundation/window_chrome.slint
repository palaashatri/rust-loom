// Window chrome for platforms where Loom draws its own frame (Windows and
// Linux). The title bar hosts the application menu on its left, the document
// title in the middle, and the window controls on the right, so menu and title
// share one row instead of stacking two.
//
// The host owns behaviour: it starts a window drag, toggles maximize, and so
// on, in response to these callbacks. macOS keeps the native frame and global
// menu bar and never instantiates this component.

import { Theme } from "../theme.slint";

/// One caption button. `kind` selects the glyph: "minimize", "maximize",
/// "restore", or "close". The close button turns red on hover.
component LoomCaptionButton inherits Rectangle {
    in property <string> kind: "minimize";
    in property <string> label: "";
    callback clicked;

    width: 46px;
    background: touch.has-hover
        ? (root.kind == "close" ? Theme.palette().danger : Theme.palette().surface-sunken)
        : transparent;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }

    // The caption glyph grows with text scale so it keeps its weight beside
    // the scaled caption text and the scaled icons.
    property <length> glyph-size: 10px * max(1.0, Theme.text-scale);
    property <color> glyph: touch.has-hover && root.kind == "close"
        ? (Theme.active-theme == "light" ? Theme.palette().paper : Theme.palette().paper-ink) : Theme.palette().ink;

    if root.kind == "minimize" : Rectangle {
        x: (parent.width - root.glyph-size) / 2;
        y: parent.height / 2;
        width: root.glyph-size;
        height: 1px;
        background: root.glyph;
    }
    if root.kind == "maximize" : Rectangle {
        x: (parent.width - root.glyph-size) / 2;
        y: (parent.height - root.glyph-size) / 2;
        width: root.glyph-size;
        height: root.glyph-size;
        border-width: 1px;
        border-color: root.glyph;
    }
    if root.kind == "restore" : Rectangle {
        x: (parent.width - root.glyph-size) / 2;
        y: (parent.height - root.glyph-size) / 2;
        width: root.glyph-size;
        height: root.glyph-size;
        Rectangle {
            x: root.glyph-size * 0.2;
            y: 0px;
            width: root.glyph-size * 0.8;
            height: root.glyph-size * 0.8;
            border-width: 1px;
            border-color: root.glyph;
        }
        Rectangle {
            x: 0px;
            y: root.glyph-size * 0.2;
            width: root.glyph-size * 0.8;
            height: root.glyph-size * 0.8;
            border-width: 1px;
            border-color: root.glyph;
            background: touch.has-hover && root.kind == "close" ? transparent : Theme.palette().chrome;
        }
    }
    if root.kind == "close" : Path {
        x: (parent.width - root.glyph-size) / 2;
        y: (parent.height - root.glyph-size) / 2;
        width: root.glyph-size;
        height: root.glyph-size;
        viewbox-width: 10;
        viewbox-height: 10;
        stroke: root.glyph;
        stroke-width: 1px;
        commands: "M 0 0 L 10 10 M 10 0 L 0 10";
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

/// The title bar. Children fill the left area (the menu); everything else is
/// draggable.
export component LoomTitleBar inherits Rectangle {
    in property <string> title: "";
    in property <bool> maximized: false;
    in property <bool> active: true;
    callback drag-requested;
    callback toggle-maximize;
    callback minimize;
    callback close;

    height: 36px;
    background: Theme.palette().chrome;

    // Everything behind the controls drags the window; a double click toggles
    // maximize, exactly like a native title bar.
    TouchArea {
        mouse-cursor: MouseCursor.default;
        double-clicked => { root.toggle-maximize(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                root.drag-requested();
            }
        }
    }

    // Left-to-right: menu at the left, caption buttons at the right.
    // Right-to-left mirrors the whole row, as mirrored Windows does: menu at
    // the right, caption buttons at the left in reverse order.
    Text {
        x: Theme.rtl ? max(150px, 380px - 5 * (Theme.menu-label-width - 64px)) : 380px + 5 * (Theme.menu-label-width - 64px);
        y: 0px;
        width: Theme.rtl
            ? max(0px, root.width - self.x - (380px + 5 * (Theme.menu-label-width - 64px)))
            : max(0px, root.width - self.x - max(150px, 380px - 5 * (Theme.menu-label-width - 64px)));
        height: root.height;
        text: root.title;
        color: root.active ? Theme.palette().ink-secondary : Theme.palette().ink-disabled;
        font-size: Theme.type.body;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        // Centered in the space the menu and caption buttons leave free.
        accessible-role: none;
    }

    HorizontalLayout {
        padding-left: Theme.rtl ? 0px : Theme.tokens.space.md;
        padding-right: Theme.rtl ? Theme.tokens.space.md : 0px;
        spacing: 0px;
        alignment: Theme.rtl ? end : start;
        @children
    }

    if !Theme.rtl : HorizontalLayout {
        x: root.width - self.preferred-width;
        width: self.preferred-width;
        height: root.height;
        alignment: end;

        LoomCaptionButton {
            kind: "minimize";
            label: "Minimize window";
            height: root.height;
            clicked => { root.minimize(); }
        }
        LoomCaptionButton {
            kind: root.maximized ? "restore" : "maximize";
            label: root.maximized ? "Restore window" : "Maximize window";
            height: root.height;
            clicked => { root.toggle-maximize(); }
        }
        LoomCaptionButton {
            kind: "close";
            label: "Close window";
            height: root.height;
            clicked => { root.close(); }
        }
    }
    if Theme.rtl : HorizontalLayout {
        x: 0px;
        width: self.preferred-width;
        height: root.height;
        alignment: start;

        LoomCaptionButton {
            kind: "close";
            label: "Close window";
            height: root.height;
            clicked => { root.close(); }
        }
        LoomCaptionButton {
            kind: root.maximized ? "restore" : "maximize";
            label: root.maximized ? "Restore window" : "Maximize window";
            height: root.height;
            clicked => { root.toggle-maximize(); }
        }
        LoomCaptionButton {
            kind: "minimize";
            label: "Minimize window";
            height: root.height;
            clicked => { root.minimize(); }
        }
    }

    Rectangle {
        x: 0px;
        y: root.height - 1px;
        width: root.width;
        height: 1px;
        background: Theme.palette().border;
    }
}

/// Invisible resize handles along the window edges, for frameless windows.
/// `direction` is 0..7: N, S, E, W, NE, NW, SE, SW. Place it over the whole
/// window, above the content, and inset by `thickness`.
export component LoomWindowResizeEdges inherits Rectangle {
    in property <length> thickness: 6px;
    in property <bool> enabled: true;
    callback resize(int);

    background: transparent;
    visible: root.enabled;

    // Edges
    TouchArea {
        x: root.thickness; y: 0px; width: root.width - 2 * root.thickness; height: root.thickness;
        mouse-cursor: MouseCursor.ns-resize;
        pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.resize(0); } }
    }
    TouchArea {
        x: root.thickness; y: root.height - root.thickness; width: root.width - 2 * root.thickness; height: root.thickness;
        mouse-cursor: MouseCursor.ns-resize;
        pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.resize(1); } }
    }
    TouchArea {
        x: root.width - root.thickness; y: root.thickness; width: root.thickness; height: root.height - 2 * root.thickness;
        mouse-cursor: MouseCursor.ew-resize;
        pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.resize(2); } }
    }
    TouchArea {
        x: 0px; y: root.thickness; width: root.thickness; height: root.height - 2 * root.thickness;
        mouse-cursor: MouseCursor.ew-resize;
        pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.resize(3); } }
    }
    // Corners
    TouchArea {
        x: root.width - root.thickness; y: 0px; width: root.thickness; height: root.thickness;
        mouse-cursor: MouseCursor.nesw-resize;
        pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.resize(4); } }
    }
    TouchArea {
        x: 0px; y: 0px; width: root.thickness; height: root.thickness;
        mouse-cursor: MouseCursor.nwse-resize;
        pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.resize(5); } }
    }
    TouchArea {
        x: root.width - root.thickness; y: root.height - root.thickness; width: root.thickness; height: root.thickness;
        mouse-cursor: MouseCursor.nwse-resize;
        pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.resize(6); } }
    }
    TouchArea {
        x: 0px; y: root.height - root.thickness; width: root.thickness; height: root.thickness;
        mouse-cursor: MouseCursor.nesw-resize;
        pointer-event(event) => { if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) { root.resize(7); } }
    }
}
