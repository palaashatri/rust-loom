import { ToolButton, IconButton, StatusBar } from "components.slint";
import { Icon } from "icons.slint";
import { Theme } from "theme.slint";
export { Theme } from "theme.slint";

export component StudioApp inherits Window {
    title: "Loom Studio";
    min-width: 900px;
    min-height: 600px;
    background: Theme.palette().canvas;

    in property <string> song-title: "Untitled Song";
    in property <string> tempo-text: "120 BPM • 4/4";
    in property <string> workspace-mode: "Quick Workspace";
    in property <[string]> track-labels: [];
    in property <int> active-track-index: 0;
    in property <string> status-left: "Ready";
    in property <string> status-right: "Offline";

    callback new-song;
    callback open-song;
    callback save-song;
    callback add-track;
    callback select-track(int);
    callback toggle-workspace;
    callback export-audio;

    VerticalLayout {
        spacing: 0px;

        // Titlebar
        Rectangle {
            min-height: 41px;
            max-height: 41px;
            background: Theme.palette().surface;

            HorizontalLayout {
                spacing: 8px;
                padding-left: 12px;
                padding-right: 12px;
                Icon {
                    icon: "layers";
                    size: 18px;
                    tint: Theme.palette().accent;
                    y: (parent.height - 18px) / 2;
                }
                Text {
                    text: "Loom Studio — " + root.song-title + " (" + root.workspace-mode + ")";
                    font-size: Theme.tokens.typography.title;
                    font-weight: 700;
                    color: Theme.palette().ink;
                    vertical-alignment: center;
                }
            }
        }

        // Toolbar
        Rectangle {
            min-height: 40px;
            max-height: 40px;
            background: Theme.palette().surface-sunken;

            HorizontalLayout {
                height: parent.height;
                cross-axis-alignment: center;
                spacing: 6px;
                padding-left: 8px;
                padding-right: 8px;

                ToolButton { icon: "new"; text: "New Song"; clicked => { root.new-song(); } }
                ToolButton { icon: "open"; text: "Open"; clicked => { root.open-song(); } }
                ToolButton { icon: "save"; text: "Save"; clicked => { root.save-song(); } }
                ToolButton { icon: "add"; text: "+ Track"; clicked => { root.add-track(); } }
                ToolButton { icon: "settings"; text: "Switch Mode"; clicked => { root.toggle-workspace(); } }
                Rectangle { horizontal-stretch: 1; background: transparent; }
                IconButton { icon: "export"; label: "Export Mix"; clicked => { root.export-audio(); } }
            }
        }

        // Multitrack Workspace & DAW Mixer View
        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            // Multitrack Arrangement Area
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.palette().canvas;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: "MULTITRACK DAW ARRANGER (" + root.tempo-text + ")";
                        font-size: Theme.tokens.typography.caption;
                        font-weight: 700;
                        color: Theme.palette().ink-secondary;
                    }

                    for label[idx] in root.track-labels : Rectangle {
                        height: 44px;
                        background: idx == root.active-track-index
                            ? Theme.palette().selection-soft
                            : Theme.palette().surface;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: idx == root.active-track-index
                            ? Theme.palette().accent
                            : Theme.palette().border;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;

                            Text {
                                text: label;
                                color: Theme.palette().ink;
                                font-size: Theme.tokens.typography.body;
                                vertical-alignment: center;
                            }
                        }
                        touch := TouchArea {
                            clicked => { root.select-track(idx); }
                        }
                        accessible-role: button;
                        accessible-label: "Select studio track " + label;
                    }

                }
            }

            // Studio Mixer Sidebar
            Rectangle {
                width: 220px;
                background: Theme.palette().surface;

                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;

                    Text {
                        text: "MIXER CHANNELS";
                        font-size: Theme.tokens.typography.caption;
                        font-weight: 700;
                        color: Theme.palette().ink-secondary;
                    }

                    Rectangle {
                        height: 120px;
                        background: Theme.palette().surface-sunken;
                        border-radius: 4px;

                        VerticalLayout {
                            alignment: center;

                            Text {
                                text: "Master Out";
                                color: Theme.palette().accent;
                                font-size: Theme.tokens.typography.body;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "0.0 dB • Peak -0.3";
                                color: Theme.palette().ink;
                                font-size: Theme.tokens.typography.caption;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        StatusBar {
            status-left: root.status-left;
            status-right: root.status-right;
        }
    }
}
