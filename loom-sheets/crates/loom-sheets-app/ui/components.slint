// Sheets-specific workspace objects.  Shared chrome and controls continue to
// come from loom-ui; this module owns the domain boundaries and their state
// wiring so the Numbers surface is inspectable without a monolithic Window.
import {
    ContextToolbar, LabeledToolbar, ToolbarGroup, ToolbarSpacer, ToolbarButton,
    DirectionalLayout, IconOnlyToolbarItem, Overflow, IconOverLabelToolbarItem,
    StatusBar, CanvasSurface, InspectorSurface, SectionHeader, Field,
    SearchField, PropertyRow, SheetTabStrip
} from "toolkit.slint";
import { Icon } from "icons.slint";
import { Theme } from "theme.slint";

/// The workbook tab strip is deliberately content-sized.  The active tab is
/// the live sheet name supplied by the controller; adding a sheet remains
/// disabled until a real workbook mutation is available.
export component SheetTabs inherits Rectangle {
    in property <string> sheet-name: "Untitled";
    in property <bool> can-add-sheet: false;
    callback add-sheet;

    height: 32px;
    background: Theme.palette().chrome;

    HorizontalLayout {
        spacing: Theme.tokens.space.sm;
        padding-left: Theme.tokens.space.lg;
        padding-right: Theme.tokens.space.lg;
        cross-axis-alignment: center;

        Rectangle {
            width: 128px;
            height: 26px;
            border-radius: Theme.tokens.metrics.radius-small;
            background: Theme.palette().accent;
            accessible-role: AccessibleRole.tab;
            accessible-label: root.sheet-name;

            HorizontalLayout {
                alignment: center;
                spacing: Theme.tokens.space.sm;
                Icon { size: 14px; icon: "table"; tint: Theme.palette().accent-ink; }
                sheet-label := Text {
                    text: root.sheet-name;
                    max-width: parent.width - 34px;
                    font-size: Theme.tokens.typography.caption;
                    font-weight: 600;
                    color: Theme.palette().accent-ink;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        IconOnlyToolbarItem {
            icon: "plus";
            label: root.can-add-sheet ? "Add sheet" : "Add sheet unavailable";
            enabled: root.can-add-sheet;
            clicked => { root.add-sheet(); }
        }

        ToolbarSpacer { }
    }

    Rectangle {
        x: 0px;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.palette().border;
    }
}

/// Action toolbar shared by the compact and labeled hosts.  Every enabled
/// action has a controller callback; unsupported insertion commands stay
/// disabled instead of presenting Numbers-like theatre.
export component SheetActionToolbar inherits DirectionalLayout {
    in property <bool> wide: false;
    in property <bool> overflow: false;
    in property <bool> inspector-available: true;
    in property <bool> inspector-visible: false;
    in property <bool> labeled-export: false;
    callback toggle-inspector;
    callback export-csv;
    callback overflow-requested;

    spacing: Theme.tokens.space.sm;
    leading-padding: 0px;
    trailing-padding: 0px;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    if root.wide : ToolbarGroup { labeled-slot: true;
        IconOverLabelToolbarItem {
            icon: "eye";
            label: "View";
            accessible-label: "View";
            enabled: root.inspector-available;
            clicked => { if (root.inspector-available) { root.toggle-inspector(); } }
        }
        IconOverLabelToolbarItem { icon: "zoom-in"; label: "Page Zoom"; accessible-label: "Page zoom unavailable"; enabled: false; }
        IconOverLabelToolbarItem { icon: "plus"; label: "Add Category"; accessible-label: "Add category unavailable"; enabled: false; }
    }

    if !root.wide : ToolbarGroup { labeled-slot: false;
        if !root.overflow : IconOnlyToolbarItem {
            icon: "eye";
            label: "View";
            enabled: root.inspector-available;
            clicked => { root.toggle-inspector(); }
        }
        if root.overflow : Overflow {
            label: "More Sheets actions";
            clicked => { root.overflow-requested(); }
        }
    }

    if !root.overflow : ToolbarSpacer { }

    if root.wide : ToolbarGroup { labeled-slot: true;
        IconOverLabelToolbarItem { icon: "table"; label: "Table"; accessible-label: "Insert table unavailable"; enabled: false; }
        IconOverLabelToolbarItem { icon: "grid"; label: "Pivot Table"; accessible-label: "Insert pivot table unavailable"; enabled: false; }
        IconOverLabelToolbarItem { icon: "chart"; label: "Chart"; accessible-label: "Insert chart unavailable"; enabled: false; }
        IconOverLabelToolbarItem { icon: "text"; label: "Text"; accessible-label: "Insert text box unavailable"; enabled: false; }
        IconOverLabelToolbarItem { icon: "shape"; label: "Shape"; accessible-label: "Insert shape unavailable"; enabled: false; }
        IconOverLabelToolbarItem { icon: "image"; label: "Media"; accessible-label: "Insert media unavailable"; enabled: false; }
        IconOverLabelToolbarItem { icon: "comment"; label: "Comment"; accessible-label: "Insert comment unavailable"; enabled: false; }
    }

    if !root.overflow : ToolbarSpacer { }

    if root.wide : ToolbarGroup { labeled-slot: true;
        IconOverLabelToolbarItem { icon: "share"; label: "Share"; accessible-label: "Share unavailable"; enabled: false; }
        IconOverLabelToolbarItem {
            icon: "format";
            label: "Format";
            accessible-label: "Format inspector";
            checked: root.inspector-visible;
            enabled: root.inspector-available;
            clicked => { if (root.inspector-available) { root.toggle-inspector(); } }
        }
        IconOverLabelToolbarItem { icon: "organize"; label: "Organize"; accessible-label: "Organize unavailable"; enabled: false; }
        IconOverLabelToolbarItem {
            icon: "export";
            label: "Export";
            accessible-label: "Export CSV";
            clicked => { root.export-csv(); }
        }
    }

    if !root.wide && !root.overflow : ToolbarGroup { labeled-slot: false;
        IconOnlyToolbarItem {
            icon: "format";
            label: "Format";
            checked: root.inspector-visible;
            enabled: root.inspector-available;
            clicked => { if (root.inspector-available) { root.toggle-inspector(); } }
        }
        IconOnlyToolbarItem { icon: "export"; label: "Export CSV"; clicked => { root.export-csv(); } }
    }

    if root.overflow : ToolbarSpacer { }
    if root.overflow : ToolbarGroup { labeled-slot: false;
        IconOnlyToolbarItem { icon: "export"; label: "Export CSV"; clicked => { root.export-csv(); } }
    }
}

/// Formula/name bar.  The value is an in-out draft: typing only changes the
/// draft, while Enter or the check action emits commit. Escape and the close
/// action restore the selected cell's exact raw state before emitting cancel.
export component FormulaNameBar inherits Rectangle {
    in property <string> selection-range: "A1";
    in property <string> selection-formula: "";
    in property <int> selection-count: 1;
    in property <bool> show-quick-formulas: false;
    in-out property <string> formula-edit-buffer: "";
    callback commit(string);
    callback cancel;
    callback quick-formula(string);
    callback fill-selection;

    min-height: 32px;
    max-height: 32px;
    background: Theme.palette().chrome;

    HorizontalLayout {
        spacing: Theme.tokens.space.sm;
        padding-left: Theme.tokens.space.lg;
        padding-right: Theme.tokens.space.lg;
        cross-axis-alignment: center;

        Rectangle {
            width: 78px;
            height: 24px;
            border-radius: Theme.tokens.metrics.radius-small;
            border-width: 1px;
            border-color: Theme.palette().border;
            background: Theme.palette().surface-sunken;
            Text {
                text: root.selection-range;
                font-weight: 600;
                font-size: Theme.tokens.typography.caption;
                color: Theme.palette().ink;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        Text {
            text: "fx";
            width: 20px;
            font-size: Theme.tokens.typography.body;
            font-weight: 700;
            color: Theme.palette().accent;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        Field {
            label: "Selected cell formula or value";
            placeholder: "Enter a value or formula (=SUM, =AVERAGE)";
            value <=> root.formula-edit-buffer;
            horizontal-stretch: 1;
            accepted(text) => { root.commit(text); }
            cancelled => {
                root.formula-edit-buffer = root.selection-formula;
                root.cancel();
            }
        }

        if root.show-quick-formulas : HorizontalLayout {
            spacing: Theme.tokens.space.xs;
            ToolbarButton { label: "SUM"; clicked => { root.quick-formula("SUM"); } }
            ToolbarButton { label: "AVG"; clicked => { root.quick-formula("AVERAGE"); } }
            ToolbarButton { label: "COUNT"; clicked => { root.quick-formula("COUNT"); } }
        }

        IconOnlyToolbarItem {
            icon: "check";
            label: "Commit formula";
            clicked => { root.commit(root.formula-edit-buffer); }
        }
        IconOnlyToolbarItem {
            icon: "close";
            label: "Cancel editing";
            clicked => {
                root.formula-edit-buffer = root.selection-formula;
                root.cancel();
            }
        }
        ToolbarButton {
            label: "Fill down";
            enabled: root.selection-count > 1;
            clicked => { root.fill-selection(); }
        }
    }

    Rectangle {
        x: 0px;
        y: parent.height - 1px;
        width: parent.width;
        height: 1px;
        background: Theme.palette().border;
    }
}

/// Selection overlay and fill handle used by every materialized cell.  The
/// cell remains the hit target for selection; the handle is a separate named
/// affordance and only emits the real fill callback.
export component SheetSelectionOverlay inherits Rectangle {
    in property <bool> active: false;
    in property <bool> in-selection: false;
    callback fill-selection;

    x: 0px;
    y: 0px;
    background: transparent;
    border-width: root.active ? 2px : root.in-selection ? 1px : 0px;
    border-color: Theme.palette().accent;
    // The interactive role belongs to the handle below.  Keeping the overlay
    // itself non-interactive avoids exposing every painted range cell as a
    // duplicate button to screen readers.

    if root.active : Rectangle {
        x: parent.width - 7px;
        y: parent.height - 7px;
        width: 8px;
        height: 8px;
        border-radius: 2px;
        background: Theme.palette().accent;
        accessible-role: button;
        accessible-label: "Selected cell fill handle";
        TouchArea {
            clicked => { root.fill-selection(); }
        }
    }
}

/// Compact scrollbar primitive for the virtual worksheet.
component SheetScrollBar inherits Rectangle {
    in property <bool> horizontal: false;
    in-out property <length> value: 0px;
    in property <length> maximum: 0px;
    in property <length> page-size: 1px;
    property <length> handle-length: root.maximum > 0px
        ? max(24px, (root.horizontal ? root.width : root.height) * root.page-size / (root.maximum + root.page-size))
        : (root.horizontal ? root.width : root.height);

    width: Theme.tokens.space.md;
    height: Theme.tokens.space.md;
    background: Theme.palette().surface-sunken;
    accessible-role: slider;
    accessible-label: root.horizontal ? "Horizontal sheet scroll" : "Vertical sheet scroll";
    accessible-value: root.maximum > 0px ? -root.value / 1px : 0.0;
    accessible-value-minimum: 0.0;
    accessible-value-maximum: root.maximum / 1px;

    scroll-focus := FocusScope {
        key-pressed(event) => {
            let step = max(1px, root.maximum / 10.0);
            if ((root.horizontal && event.text == Key.LeftArrow)
                || (!root.horizontal && event.text == Key.UpArrow)) {
                root.value = min(0px, root.value + step);
                return accept;
            }
            if ((root.horizontal && event.text == Key.RightArrow)
                || (!root.horizontal && event.text == Key.DownArrow)) {
                root.value = max(-root.maximum, root.value - step);
                return accept;
            }
            return reject;
        }
    }

    Rectangle {
        x: root.horizontal && root.maximum > 0px
            ? clamp((-root.value / root.maximum) * (parent.width - self.width), 0px, parent.width - self.width)
            : 0px;
        y: root.horizontal ? 0px
            : root.maximum > 0px
                ? clamp((-root.value / root.maximum) * (parent.height - self.height), 0px, parent.height - self.height)
                : 0px;
        width: root.horizontal ? root.handle-length : parent.width;
        height: root.horizontal ? parent.height : root.handle-length;
        border-radius: Theme.tokens.metrics.radius-small;
        background: scroll-track.pressed || scroll-track.has-hover
            ? Theme.palette().accent
            : Theme.palette().border-strong;
    }

    scroll-track := TouchArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        moved => {
            if (self.pressed) {
                if (root.horizontal) {
                    root.value = -clamp(
                        (self.mouse-x - root.handle-length / 2.0)
                            / max(1px, root.width - root.handle-length),
                        0.0,
                        1.0
                    ) * root.maximum;
                } else {
                    root.value = -clamp(
                        (self.mouse-y - root.handle-length / 2.0)
                            / max(1px, root.height - root.handle-length),
                        0.0,
                        1.0
                    ) * root.maximum;
                }
            }
        }
        clicked => {
            scroll-focus.focus();
            if (root.horizontal) {
                root.value = -clamp(
                    (self.mouse-x - root.handle-length / 2.0)
                        / max(1px, root.width - root.handle-length),
                    0.0,
                    1.0
                ) * root.maximum;
            } else {
                root.value = -clamp(
                    (self.mouse-y - root.handle-length / 2.0)
                        / max(1px, root.height - root.handle-length),
                    0.0,
                    1.0
                ) * root.maximum;
            }
        }
    }
}

/// Both worksheet scrollbars are one named object so their extents and live
/// offsets are reviewed together with the table surface.
export component SheetScrollbars inherits Rectangle {
    in property <bool> vertical-visible: false;
    in property <bool> horizontal-visible: false;
    in property <length> vertical-maximum: 0px;
    in property <length> horizontal-maximum: 0px;
    in property <length> vertical-page-size: 1px;
    in property <length> horizontal-page-size: 1px;
    in-out property <length> scroll-x: 0px;
    in-out property <length> scroll-y: 0px;

    if root.vertical-visible : SheetScrollBar {
        x: parent.width - Theme.tokens.space.md;
        y: 0px;
        width: Theme.tokens.space.md;
        height: parent.height;
        maximum: root.vertical-maximum;
        page-size: root.vertical-page-size;
        value <=> root.scroll-y;
    }
    if root.horizontal-visible : SheetScrollBar {
        x: 0px;
        y: parent.height - Theme.tokens.space.md;
        width: parent.width;
        height: Theme.tokens.space.md;
        horizontal: true;
        maximum: root.horizontal-maximum;
        page-size: root.horizontal-page-size;
        value <=> root.scroll-x;
    }
}

/// A real table boundary containing the bounded materialized worksheet slice.
/// The parent `SheetGridSurface` supplies keyboard focus and canvas geometry;
/// this object owns the table name, headers, cells, selection affordances, and
/// scrollbars.
export component SheetTable inherits Rectangle {
    in property <string> sheet-name: "Untitled";
    in property <[int]> rows: [];
    in property <[int]> cols: [];
    in property <[string]> column-headers: [];
    in property <[string]> row-headers: [];
    in property <[string]> cells: [];
    in property <int> view-row-origin: 0;
    in property <int> view-col-origin: 0;
    in property <int> selected-row: 0;
    in property <int> selected-col: 0;
    in property <int> selection-start-row: 0;
    in property <int> selection-start-col: 0;
    in property <int> selection-end-row: 0;
    in property <int> selection-end-col: 0;
    in property <length> grid-col-offset: 0px;
    in property <length> grid-row-offset: 0px;
    in property <length> grid-visible-width: 640px;
    in property <length> grid-visible-height: 360px;
    in property <length> grid-content-width: 640px;
    in property <length> grid-content-height: 360px;
    in property <[length]> grid-column-widths: [];
    in property <[length]> grid-row-heights: [];
    in-out property <length> grid-scroll-x: 0px;
    in-out property <length> grid-scroll-y: 0px;
    callback cell-clicked(int, int);
    callback fill-selection;
    callback grid-scrolled;
    callback grid-viewport-changed(length, length);

    border-radius: Theme.tokens.metrics.radius-small;
    border-width: 1px;
    border-color: Theme.palette().border;
    background: Theme.palette().surface;
    drop-shadow-blur: 12px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Theme.palette().shadow;
    clip: true;
    accessible-role: table;
    accessible-label: root.sheet-name + " table";

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 28px;
            background: Theme.palette().surface;

            HorizontalLayout {
                padding-left: 12px;
                cross-axis-alignment: center;
                Text {
                    text: root.sheet-name + " table";
                    font-size: Theme.tokens.typography.title;
                    font-weight: 700;
                    color: Theme.palette().ink;
                    overflow: elide;
                }
            }
            Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.palette().border; }
        }

        grid-viewport := Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            min-height: 386px;
            clip: true;
            changed width => { root.grid-viewport-changed(self.width, self.height); }
            changed height => { root.grid-viewport-changed(self.width, self.height); }

            grid-flick := Flickable {
                width: parent.width;
                height: parent.height;
                viewport-width: max(parent.width, 36px + root.grid-content-width);
                viewport-height: max(parent.height, 26px + root.grid-content-height);
                viewport-x <=> root.grid-scroll-x;
                viewport-y <=> root.grid-scroll-y;
                flicked => { root.grid-scrolled(); }

                projected-grid := GridLayout {
                    x: root.grid-col-offset;
                    y: root.grid-row-offset;
                    width: 36px + root.grid-visible-width;
                    height: 26px + root.grid-visible-height;
                    spacing: 0px;

                    Row {
                        Rectangle {
                            width: 36px;
                            min-height: 26px;
                            max-height: 26px;
                            background: Theme.palette().chrome;
                            border-width: 1px;
                            border-color: Theme.palette().border;
                        }
                        for c in root.cols : Rectangle {
                            min-width: root.grid-column-widths[c];
                            max-width: root.grid-column-widths[c];
                            min-height: 26px;
                            max-height: 26px;
                            background: c + root.view-col-origin >= root.selection-start-col && c + root.view-col-origin <= root.selection-end-col ? Theme.palette().selection-soft : Theme.palette().chrome;
                            border-width: c + root.view-col-origin == root.selected-col ? 2px : 1px;
                            border-color: c + root.view-col-origin == root.selected-col ? Theme.palette().accent : Theme.palette().grid-major;
                            Text {
                                text: root.column-headers[c];
                                font-size: Theme.tokens.typography.caption;
                                font-weight: c + root.view-col-origin == root.selected-col ? 700 : 500;
                                color: c + root.view-col-origin == root.selected-col ? Theme.palette().accent : Theme.palette().ink-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    for r in root.rows : Row {
                        Rectangle {
                            width: 36px;
                            min-height: root.grid-row-heights[r];
                            max-height: root.grid-row-heights[r];
                            background: r + root.view-row-origin >= root.selection-start-row && r + root.view-row-origin <= root.selection-end-row ? Theme.palette().selection-soft : Theme.palette().chrome;
                            border-width: r + root.view-row-origin == root.selected-row ? 2px : 1px;
                            border-color: r + root.view-row-origin == root.selected-row ? Theme.palette().accent : Theme.palette().grid-major;
                            Text {
                                text: root.row-headers[r];
                                font-size: Theme.tokens.typography.caption;
                                font-weight: r + root.view-row-origin == root.selected-row ? 700 : 500;
                                color: r + root.view-row-origin == root.selected-row ? Theme.palette().accent : Theme.palette().ink-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        for c in root.cols : Rectangle {
                            min-width: root.grid-column-widths[c];
                            max-width: root.grid-column-widths[c];
                            min-height: root.grid-row-heights[r];
                            max-height: root.grid-row-heights[r];
                            property <int> global-row: r + root.view-row-origin;
                            property <int> global-col: c + root.view-col-origin;
                            property <bool> in-selection: global-row >= root.selection-start-row
                                && global-row <= root.selection-end-row
                                && global-col >= root.selection-start-col
                                && global-col <= root.selection-end-col;
                            property <bool> is-active: global-row == root.selected-row && global-col == root.selected-col;
                            background: is-active || in-selection
                                ? Theme.palette().selection-soft
                                : (Math.mod(global-row, 2) == 1) ? Theme.palette().surface-sunken : Theme.palette().surface;

                            Text {
                                x: 8px;
                                width: parent.width - 16px;
                                height: parent.height;
                                text: root.cells[r * root.cols.length + c];
                                font-size: Theme.tokens.typography.body;
                                color: Theme.palette().ink;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            SheetSelectionOverlay {
                                width: parent.width;
                                height: parent.height;
                                active: is-active;
                                in-selection: in-selection;
                                fill-selection => { root.fill-selection(); }
                            }

                            TouchArea {
                                clicked => { root.cell-clicked(global-row, global-col); }
                            }
                        }
                    }
                }
            }

            SheetScrollbars {
                width: grid-viewport.width;
                height: grid-viewport.height;
                vertical-visible: 26px + root.grid-content-height > grid-viewport.height;
                horizontal-visible: 36px + root.grid-content-width > grid-viewport.width;
                vertical-maximum: max(0px, 26px + root.grid-content-height - grid-viewport.height);
                horizontal-maximum: max(0px, 36px + root.grid-content-width - grid-viewport.width);
                vertical-page-size: grid-viewport.height;
                horizontal-page-size: grid-viewport.width;
                scroll-x <=> root.grid-scroll-x;
                scroll-y <=> root.grid-scroll-y;
            }
        }
    }
}

/// Grid canvas wrapper.  It owns keyboard navigation focus and keeps the
/// table's dominant surface separate from the surrounding app chrome.
export component SheetGridSurface inherits CanvasSurface {
    in property <string> sheet-name: "Untitled";
    in property <[int]> rows: [];
    in property <[int]> cols: [];
    in property <[string]> column-headers: [];
    in property <[string]> row-headers: [];
    in property <[string]> cells: [];
    in property <int> view-row-origin: 0;
    in property <int> view-col-origin: 0;
    in property <int> selected-row: 0;
    in property <int> selected-col: 0;
    in property <int> selection-start-row: 0;
    in property <int> selection-start-col: 0;
    in property <int> selection-end-row: 0;
    in property <int> selection-end-col: 0;
    in property <length> grid-col-offset: 0px;
    in property <length> grid-row-offset: 0px;
    in property <length> grid-visible-width: 640px;
    in property <length> grid-visible-height: 360px;
    in property <length> grid-content-width: 640px;
    in property <length> grid-content-height: 360px;
    in property <[length]> grid-column-widths: [];
    in property <[length]> grid-row-heights: [];
    in-out property <length> grid-scroll-x: 0px;
    in-out property <length> grid-scroll-y: 0px;
    callback cell-clicked(int, int);
    callback fill-selection;
    callback grid-scrolled;
    callback grid-viewport-changed(length, length);
    callback navigate-selection(int, int);
    callback extend-selection(int, int);

    grid-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.LeftArrow) {
                if (event.modifiers.shift) { root.extend-selection(0, -1); }
                else { root.navigate-selection(0, -1); }
                return accept;
            }
            if (event.text == Key.RightArrow) {
                if (event.modifiers.shift) { root.extend-selection(0, 1); }
                else { root.navigate-selection(0, 1); }
                return accept;
            }
            if (event.text == Key.UpArrow) {
                if (event.modifiers.shift) { root.extend-selection(-1, 0); }
                else { root.navigate-selection(-1, 0); }
                return accept;
            }
            if (event.text == Key.DownArrow) {
                if (event.modifiers.shift) { root.extend-selection(1, 0); }
                else { root.navigate-selection(1, 0); }
                return accept;
            }
            return reject;
        }
    }

    public function focus-grid() {
        grid-focus.focus();
    }

    SheetTable {
        x: 24px;
        y: 20px;
        width: max(1px, parent.width - 48px);
        height: max(1px, parent.height - 40px);
        sheet-name: root.sheet-name;
        rows: root.rows;
        cols: root.cols;
        column-headers: root.column-headers;
        row-headers: root.row-headers;
        cells: root.cells;
        view-row-origin: root.view-row-origin;
        view-col-origin: root.view-col-origin;
        selected-row: root.selected-row;
        selected-col: root.selected-col;
        selection-start-row: root.selection-start-row;
        selection-start-col: root.selection-start-col;
        selection-end-row: root.selection-end-row;
        selection-end-col: root.selection-end-col;
        grid-col-offset: root.grid-col-offset;
        grid-row-offset: root.grid-row-offset;
        grid-visible-width: root.grid-visible-width;
        grid-visible-height: root.grid-visible-height;
        grid-content-width: root.grid-content-width;
        grid-content-height: root.grid-content-height;
        grid-column-widths: root.grid-column-widths;
        grid-row-heights: root.grid-row-heights;
        grid-scroll-x <=> root.grid-scroll-x;
        grid-scroll-y <=> root.grid-scroll-y;
        cell-clicked(row, col) => {
            // A cell click establishes the grid's keyboard scope before the
            // controller updates selection, matching spreadsheet focus rules.
            grid-focus.focus();
            root.cell-clicked(row, col);
        }
        fill-selection => { root.fill-selection(); }
        grid-scrolled => { root.grid-scrolled(); }
        grid-viewport-changed(width, height) => { root.grid-viewport-changed(width, height); }
    }
}

/// Contextual Table/Cell inspector.  Search and tab state are in-out so the
/// controller can project the selected range and preserve keyboard context.
export component SheetInspector inherits InspectorSurface {
    in property <string> selection-range: "A1";
    in property <string> selection-value: "";
    in property <string> selection-formula: "";
    in property <string> sheet-name: "Untitled";
    in property <string> table-rows-label: "1";
    in property <string> table-cols-label: "1";
    in property <string> selected-row-height: "24 px";
    in property <string> selected-col-width: "80 px";
    in-out property <string> inspector-search: "";
    in-out property <int> inspector-tab: 0;
    in property <bool> inspector-show-table: true;
    in property <bool> inspector-show-cell: true;
    callback inspector-search-edited(string);
    callback inspector-context-changed(int);

    title: root.selection-range + " selection";
    width: 280px;

    VerticalLayout {
        spacing: Theme.tokens.space.lg;
        padding: 0px;

        SearchField {
            label: "Search inspector properties";
            placeholder: "Search properties…";
            value <=> root.inspector-search;
            edited(text) => { root.inspector-search-edited(text); }
        }

        SheetTabStrip {
            tabs: ["Table", "Cell"];
            current <=> root.inspector-tab;
            selected(index) => { root.inspector-context-changed(index); }
        }

        Flickable {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            viewport-width: parent.width;
            viewport-height: max(parent.height, 460px);

            VerticalLayout {
                width: parent.width;
                spacing: Theme.tokens.space.lg;

                if root.inspector-tab == 0 && root.inspector-show-table : VerticalLayout {
                    spacing: Theme.tokens.space.md;
                    SectionHeader { title: "Table"; }
                    PropertyRow {
                        label: "Name";
                        Field { label: "Table name"; value: root.sheet-name; enabled: false; }
                    }
                    PropertyRow {
                        label: "Rows";
                        Field { label: "Worksheet rows"; value: root.table-rows-label; enabled: false; }
                    }
                    PropertyRow {
                        label: "Columns";
                        Field { label: "Worksheet columns"; value: root.table-cols-label; enabled: false; }
                    }
                }

                if root.inspector-tab == 1 && root.inspector-show-cell : VerticalLayout {
                    spacing: Theme.tokens.space.md;
                    SectionHeader { title: "Cell"; }
                    PropertyRow {
                        label: "Selection";
                        Field { label: "Selected range"; value: root.selection-range; enabled: false; }
                    }
                    PropertyRow {
                        label: "Value";
                        Field { label: "Displayed value"; value: root.selection-value == "" ? "Empty" : root.selection-value; enabled: false; }
                    }
                    PropertyRow {
                        label: "Formula";
                        Field { label: "Raw formula"; value: root.selection-formula == "" ? "—" : root.selection-formula; enabled: false; }
                    }
                    PropertyRow {
                        label: "Row height";
                        Field { label: "Selected row height"; value: root.selected-row-height; enabled: false; }
                    }
                    PropertyRow {
                        label: "Column width";
                        Field { label: "Selected column width"; value: root.selected-col-width; enabled: false; }
                    }
                }

                if (root.inspector-tab == 0 && !root.inspector-show-table)
                    || (root.inspector-tab == 1 && !root.inspector-show-cell) : Rectangle {
                    height: 72px;
                    Text {
                        text: "No matching properties";
                        color: Theme.palette().ink-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Rectangle { vertical-stretch: 1; background: transparent; }
            }
        }
    }
}
