import { LoomMenuItem } from "foundation.slint";
import { Theme } from "theme.slint";

/// The "More actions" menu: file and history commands that have no toolbar
/// item. Up/Down move over the enabled rows, Return or Space run the selected
/// one, Escape closes. Every row sends a command id through `command`.
export component SheetToolbarOverflow inherits Rectangle {
    in property <bool> open: false;
    in property <bool> available: false;
    in property <bool> rtl: false;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in property <length> content-width: 0px;
    in property <length> content-height: 0px;
    in property <length> menu-y: 0px;
    callback close-requested;
    callback command(string);
    public function focus-first-action() {
        if (root.open && root.available) {
            root.selected = root.can-undo ? 0 : root.can-redo ? 1 : 2;
            menu-focus.focus();
        }
    }

    property <int> selected: 2;
    property <[string]> labels: ["Undo", "Redo", "New", "Open", "Save", "Save As", "Commands"];
    property <[string]> ids: ["edit.undo", "edit.redo", "file.new", "file.open", "file.save", "file.save_as", "app.palette"];
    property <[string]> shortcuts: ["Ctrl+Z", "Ctrl+Shift+Z", "Ctrl+N", "Ctrl+O", "Ctrl+S", "Ctrl+Shift+S", "Ctrl+K"];
    pure function enabled-at(idx: int) -> bool {
        return idx == 0 ? root.can-undo : idx == 1 ? root.can-redo : true;
    }
    /// The next enabled row in `delta` direction (Undo and Redo may be off).
    function step(delta: int) {
        root.selected = Math.mod(root.selected + delta + 7, 7);
        if (!root.enabled-at(root.selected)) { root.selected = Math.mod(root.selected + delta + 7, 7); }
        if (!root.enabled-at(root.selected)) { root.selected = Math.mod(root.selected + delta + 7, 7); }
    }

    visible: root.open && root.available;
    width: root.content-width;
    height: root.content-height;
    background: transparent;

    TouchArea { clicked => { root.close-requested(); } }

    popup-panel := Rectangle {
        x: root.rtl ? 8px : max(8px, root.content-width - 248px);
        y: root.menu-y + 8px;
        width: 240px;
        height: min(popup-layout.preferred-height, root.content-height - root.menu-y - 16px);
        border-radius: Theme.tokens.metrics.radius-medium;
        border-width: 1px;
        border-color: Theme.palette().border;
        background: Theme.palette().surface;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: Theme.palette().shadow;

        menu-focus := FocusScope {
            enabled: root.open && root.available;
            key-pressed(event) => {
                if (event.text == Key.Escape) { root.close-requested(); return accept; }
                if (event.text == Key.DownArrow) { root.step(1); return accept; }
                if (event.text == Key.UpArrow) { root.step(-1); return accept; }
                if (event.text == Key.Return || event.text == " ") {
                    if (root.enabled-at(root.selected)) { root.command(root.ids[root.selected]); }
                    return accept;
                }
                return reject;
            }
            popup-layout := VerticalLayout {
                spacing: 2px;
                padding: Theme.tokens.space.sm;
                for label[idx] in root.labels : LoomMenuItem {
                    label: label;
                    shortcut: root.shortcuts[idx];
                    enabled: root.enabled-at(idx);
                    selected: idx == root.selected;
                    activated => { root.command(root.ids[idx]); }
                }
            }
        }
    }
}
