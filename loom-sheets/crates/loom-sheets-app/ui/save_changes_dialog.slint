import { LoomButton } from "foundation.slint";
import { Theme } from "theme.slint";

export component SaveChangesDialog inherits Rectangle {
    in property <bool> open: false;
    in property <bool> close-mode: false;
    in property <string> document-name: "";
    in property <string> prompt: "";
    callback cancel;
    callback discard;
    callback save;

    visible: root.open;

    // The primary button takes focus when the dialog opens, so Enter saves.
    public function focus-dialog() {
        save-button.grab-focus();
    }

    dialog-focus := FocusScope {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        enabled: root.open;
        visible: root.open;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel();
                return accept;
            }
            // Tab cycles Cancel, Discard, Save and never leaves the dialog.
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                if (event.text == Key.Backtab || event.modifiers.shift) {
                    if (save-button.has-focus) { discard-button.grab-focus(); } else if (discard-button.has-focus) { cancel-button.grab-focus(); } else { save-button.grab-focus(); }
                } else {
                    if (cancel-button.has-focus) { discard-button.grab-focus(); } else if (discard-button.has-focus) { save-button.grab-focus(); } else { cancel-button.grab-focus(); }
                }
                return accept;
            }
            return reject;
        }

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: Theme.palette().scrim;
            accessible-role: groupbox;
            accessible-label: "Save changes dialog";

            TouchArea { clicked => { dialog-focus.focus(); } }

            // The panel follows its content and is capped to the window, so a
            // large text scale or a long document name reflows instead of
            // clipping. Only the prompt scrolls; the actions never do.
            panel := Rectangle {
                x: (root.width - min(520px, root.width - 32px)) / 2;
                y: (root.height - self.height) / 2;
                width: min(520px, root.width - 32px);
                height: min(dialog-content.preferred-height,
                    max(120px, root.height - 32px));
                border-radius: Theme.tokens.metrics.radius-large;
                border-width: 1px;
                border-color: Theme.palette().border;
                background: Theme.palette().surface;
                drop-shadow-blur: 18px;
                drop-shadow-offset-y: 6px;
                drop-shadow-color: Theme.palette().shadow;

                dialog-content := VerticalLayout {
                    spacing: Theme.tokens.space.md;
                    padding: Theme.tokens.space.xl;

                    Text {
                        text: "Save changes?";
                        font-size: Theme.type.heading;
                        font-weight: 700;
                        color: Theme.palette().ink;
                        horizontal-alignment: Theme.rtl ? right : left;
                    }
                    // The prompt is measured, not clipped: the panel's height
                    // follows the wrapped text, so a large text scale or a long
                    // document name reflows the dialog instead of hiding text.
                    prompt-text := Text {
                        text: root.prompt;
                        accessible-label: root.prompt;
                        width: max(0px, parent.width);
                        height: self.preferred-height;
                        font-size: Theme.type.body;
                        color: Theme.palette().ink-secondary;
                        horizontal-alignment: Theme.rtl ? right : left;
                        wrap: word-wrap;
                    }
                    // The primary button sits at the reading end: right in LTR,
                    // left in RTL.
                    Rectangle {
                        height: Theme.tokens.metrics.control-height;
                        save-button := LoomButton {
                            label: root.close-mode ? "Save and close" : "Save";
                            variant: "primary";
                            width: self.preferred-width;
                            height: Theme.tokens.metrics.control-height;
                            x: Theme.rtl ? 0px : max(0px, parent.width - self.width);
                            clicked => { root.save(); }
                        }
                        discard-button := LoomButton {
                            label: "Discard";
                            variant: "danger";
                            width: self.preferred-width;
                            height: Theme.tokens.metrics.control-height;
                            x: Theme.rtl ? save-button.width + Theme.tokens.space.sm : max(0px, save-button.x - Theme.tokens.space.sm - self.width);
                            clicked => { root.discard(); }
                        }
                        cancel-button := LoomButton {
                            label: "Cancel";
                            variant: "secondary";
                            width: self.preferred-width;
                            height: Theme.tokens.metrics.control-height;
                            x: Theme.rtl ? discard-button.x + discard-button.width + Theme.tokens.space.sm : max(0px, discard-button.x - Theme.tokens.space.sm - self.width);
                            clicked => { root.cancel(); }
                        }
                    }
                }
            }
        }
    }
}
