import { LoomButton } from "foundation.slint";
import { Theme } from "theme.slint";

export component SaveChangesDialog inherits Rectangle {
    in property <bool> open: false;
    in property <bool> close-mode: false;
    in property <string> document-name: "";
    in property <string> prompt: "";
    callback cancel;
    callback discard;
    callback save;

    visible: root.open;

    public function focus-dialog() {
        dialog-focus.focus();
    }

    dialog-focus := FocusScope {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        enabled: root.open;
        visible: root.open;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel();
                return accept;
            }
            return reject;
        }

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: Theme.palette().scrim;
            accessible-role: groupbox;
            accessible-label: "Save changes dialog";

            TouchArea { clicked => { dialog-focus.focus(); } }

            // The panel follows its content and is capped to the window, so a
            // large text scale or a long document name reflows instead of
            // clipping. Only the prompt scrolls; the actions never do.
            panel := Rectangle {
                x: (root.width - min(520px, root.width - 32px)) / 2;
                y: (root.height - self.height) / 2;
                width: min(520px, root.width - 32px);
                height: min(dialog-content.preferred-height,
                    max(120px, root.height - 32px));
                border-radius: Theme.tokens.metrics.radius-large;
                border-width: 1px;
                border-color: Theme.palette().border;
                background: Theme.palette().surface;
                drop-shadow-blur: 18px;
                drop-shadow-offset-y: 6px;
                drop-shadow-color: Theme.palette().shadow;

                dialog-content := VerticalLayout {
                    spacing: Theme.tokens.space.md;
                    padding: Theme.tokens.space.xl;

                    Text {
                        text: "Save changes?";
                        font-size: Theme.type.heading;
                        font-weight: 700;
                        color: Theme.palette().ink;
                    }
                    // The prompt is measured, not clipped: the panel's height
                    // follows the wrapped text, so a large text scale or a long
                    // document name reflows the dialog instead of hiding text.
                    prompt-text := Text {
                        text: root.prompt;
                        accessible-label: root.prompt;
                        width: max(0px, parent.width);
                        height: self.preferred-height;
                        font-size: Theme.type.body;
                        color: Theme.palette().ink-secondary;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: Theme.tokens.space.sm;
                        alignment: end;
                        LoomButton {
                            label: "Cancel";
                            variant: "secondary";
                            clicked => { root.cancel(); }
                        }
                        if !root.close-mode : LoomButton {
                            label: "Discard";
                            variant: "danger";
                            clicked => { root.discard(); }
                        }
                        LoomButton {
                            label: root.close-mode ? "Save and close" : "Save";
                            variant: "primary";
                            clicked => { root.save(); }
                        }
                    }
                }
            }
        }
    }
}
