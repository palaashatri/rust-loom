import {
    LoomTextField, LoomSearchField, LoomTabStrip,
    LoomPanel, LoomSectionHeader, LoomToggle, LoomButton, LoomIconButton,
} from "foundation.slint";
import { Theme } from "theme.slint";

component SheetPropertyRow inherits HorizontalLayout {
    in property <string> label: "";
    spacing: Theme.tokens.space.sm;
    cross-axis-alignment: center;
    Text {
        text: root.label;
        width: 70px;
        font-size: Theme.tokens.typography.caption;
        color: Theme.palette().ink-secondary;
        overflow: elide;
    }
    @children
}

// Fill color swatch: pointer shortcut for direct color choice. Every fill
// state stays keyboard-reachable through the palette's Fill cycle command.
component FillSwatch inherits Rectangle {
    in property <color> swatch-color: transparent;
    in property <bool> selected: false;
    in property <string> swatch-label: "";
    in property <int> swatch-index: -1;
    callback pick(int);
    width: 24px;
    height: 24px;
    border-radius: 4px;
    background: root.swatch-color;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.palette().accent : Theme.palette().border;
    accessible-role: button;
    accessible-label: root.swatch-label;
    TouchArea { clicked => { root.pick(root.swatch-index); } }
}

export component SheetInspector inherits LoomPanel {
    in property <string> selection-range: "A1";
    in property <string> selection-value: "";
    in property <string> selection-formula: "";
    in property <string> sheet-name: "Untitled";
    in property <string> table-rows-label: "1";
    in property <string> table-cols-label: "1";
    in property <string> selected-row-height: "24 px";
    in property <string> selected-col-width: "80 px";
    in-out property <string> inspector-search: "";
    in-out property <int> inspector-tab: 0;
    in property <bool> inspector-show-table: true;
    in property <bool> inspector-show-cell: true;
    in property <bool> active: false;
    in property <int> cell-format: 0;
    in property <int> cell-alignment: 0;
    in property <bool> cell-bold: false;
    in property <bool> cell-italic: false;
    in property <bool> cell-underline: false;
    in property <bool> cell-border: false;
    in property <int> cell-fill: -1;
    in property <int> cell-font-size: 14;
    in property <string> cell-font-label: "14";
    in property <string> cell-decimals-label: "2";
    callback inspector-search-edited(string);
    callback inspector-context-changed(int);
    callback rename-sheet(string);
    callback add-table-row;
    callback delete-table-row;
    callback add-table-col;
    callback delete-table-col;
    callback adjust-row-height(int);
    callback adjust-col-width(int);
    callback set-cell-format(int);
    callback set-cell-alignment(int);
    callback toggle-bold;
    callback toggle-italic;
    callback toggle-underline;
    callback toggle-borders;
    callback cycle-fill;
    callback set-fill(int);
    callback adjust-font(int);
    callback adjust-decimals(int);
    callback close-requested;

    public function focus-inspector() { panel-focus.focus(); }

    title: root.selection-range + " selection";
    width: 320px;

    changed active => {
        if (root.active) { panel-focus.focus(); }
    }

    panel-focus := FocusScope {
        enabled: root.active;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            return reject;
        }

    VerticalLayout {
        spacing: Theme.tokens.space.md;
        padding: Theme.tokens.space.md;

        HorizontalLayout {
            cross-axis-alignment: center;
            Text {
                text: "Format and table properties";
                font-size: Theme.tokens.typography.caption;
                font-weight: 600;
                color: Theme.palette().ink-secondary;
                horizontal-stretch: 1;
            }
            LoomButton {
                label: "Close";
                variant: "ghost";
                clicked => { root.close-requested(); }
            }
        }

        LoomSearchField {
            placeholder: "Search properties…";
            value <=> root.inspector-search;
            edited(text) => { root.inspector-search-edited(text); }
        }

        LoomTabStrip {
            items: ["Table", "Cell"];
            current <=> root.inspector-tab;
            selected(idx) => { root.inspector-context-changed(idx); }
        }

        Flickable {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            viewport-width: parent.width;
            viewport-height: max(parent.height, 460px);

            VerticalLayout {
                width: parent.width;
                spacing: Theme.tokens.space.lg;

                if root.inspector-tab == 0 && root.inspector-show-table : VerticalLayout {
                    spacing: Theme.tokens.space.md;
                    LoomSectionHeader { title: "Table"; }
                    SheetPropertyRow {
                        label: "Name";
                        LoomTextField {
                            label: "Table name";
                            value: root.sheet-name;
                            edited(name) => { root.rename-sheet(name); }
                        }
                    }
                    SheetPropertyRow {
                        label: "Rows";
                        HorizontalLayout {
                            spacing: Theme.tokens.space.xs;
                            LoomTextField { label: "Worksheet rows"; value: root.table-rows-label; enabled: false; horizontal-stretch: 1; }
                            LoomIconButton { icon: "plus"; tooltip: "Add row"; clicked => { root.add-table-row(); } }
                            LoomIconButton { icon: "minus"; tooltip: "Delete row"; clicked => { root.delete-table-row(); } }
                        }
                    }
                    SheetPropertyRow {
                        label: "Columns";
                        HorizontalLayout {
                            spacing: Theme.tokens.space.xs;
                            LoomTextField { label: "Worksheet columns"; value: root.table-cols-label; enabled: false; horizontal-stretch: 1; }
                            LoomIconButton { icon: "plus"; tooltip: "Add column"; clicked => { root.add-table-col(); } }
                            LoomIconButton { icon: "minus"; tooltip: "Delete column"; clicked => { root.delete-table-col(); } }
                        }
                    }
                }

                if root.inspector-tab == 1 && root.inspector-show-cell : VerticalLayout {
                    spacing: Theme.tokens.space.md;
                    LoomSectionHeader { title: "Cell"; }
                    SheetPropertyRow {
                        label: "Selection";
                        LoomTextField { label: "Selected range"; value: root.selection-range; enabled: false; }
                    }
                    SheetPropertyRow {
                        label: "Value";
                        LoomTextField { label: "Displayed value"; value: root.selection-value == "" ? "Empty" : root.selection-value; enabled: false; }
                    }
                    SheetPropertyRow {
                        label: "Formula";
                        LoomTextField { label: "Raw formula"; value: root.selection-formula == "" ? "—" : root.selection-formula; enabled: false; }
                    }
                    LoomSectionHeader { title: "Font Style"; }
                    HorizontalLayout {
                        spacing: Theme.tokens.space.xs;
                        LoomIconButton {
                            icon: "bold";
                            label: "Bold";
                            tooltip: "Bold (Cmd+B)";
                            selected: root.cell-bold;
                            clicked => { root.toggle-bold(); }
                        }
                        LoomIconButton {
                            icon: "italic";
                            label: "Italic";
                            tooltip: "Italic (Cmd+I)";
                            selected: root.cell-italic;
                            clicked => { root.toggle-italic(); }
                        }
                        LoomIconButton {
                            icon: "underline";
                            label: "Underline";
                            tooltip: "Underline (Cmd+U)";
                            selected: root.cell-underline;
                            clicked => { root.toggle-underline(); }
                        }
                    }
                    LoomSectionHeader { title: "Borders & Fill"; }
                    HorizontalLayout {
                        spacing: Theme.tokens.space.xs;
                        LoomButton {
                            label: "Border";
                            variant: root.cell-border ? "primary" : "ghost";
                            clicked => { root.toggle-borders(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.tokens.space.xs;
                        FillSwatch { swatch-color: #FECACA; selected: root.cell-fill == 0; swatch-label: "Fill red"; swatch-index: 0; pick(idx) => { root.set-fill(idx); } }
                        FillSwatch { swatch-color: #FED7AA; selected: root.cell-fill == 1; swatch-label: "Fill orange"; swatch-index: 1; pick(idx) => { root.set-fill(idx); } }
                        FillSwatch { swatch-color: #FEF08A; selected: root.cell-fill == 2; swatch-label: "Fill yellow"; swatch-index: 2; pick(idx) => { root.set-fill(idx); } }
                        FillSwatch { swatch-color: #BBF7D0; selected: root.cell-fill == 3; swatch-label: "Fill green"; swatch-index: 3; pick(idx) => { root.set-fill(idx); } }
                        FillSwatch { swatch-color: #BFDBFE; selected: root.cell-fill == 4; swatch-label: "Fill blue"; swatch-index: 4; pick(idx) => { root.set-fill(idx); } }
                        FillSwatch { swatch-color: #DDD6FE; selected: root.cell-fill == 5; swatch-label: "Fill purple"; swatch-index: 5; pick(idx) => { root.set-fill(idx); } }
                        FillSwatch { swatch-color: #E5E7EB; selected: root.cell-fill == 6; swatch-label: "Fill gray"; swatch-index: 6; pick(idx) => { root.set-fill(idx); } }
                        FillSwatch { swatch-color: transparent; selected: root.cell-fill == -1; swatch-label: "No fill"; swatch-index: -1; pick(idx) => { root.set-fill(idx); } }
                    }
                    SheetPropertyRow {
                        label: "Font size";
                        HorizontalLayout {
                            spacing: Theme.tokens.space.xs;
                            LoomTextField { label: "Font size in points"; value: root.cell-font-label; enabled: false; horizontal-stretch: 1; }
                            LoomIconButton { icon: "minus"; tooltip: "Decrease font size"; clicked => { root.adjust-font(-1); } }
                            LoomIconButton { icon: "plus"; tooltip: "Increase font size"; clicked => { root.adjust-font(1); } }
                        }
                    }
                    LoomSectionHeader { title: "Data Format"; }
                    HorizontalLayout {
                        spacing: Theme.tokens.space.xs;
                        LoomButton {
                            label: "123";
                            variant: root.cell-format == 0 ? "primary" : "ghost";
                            clicked => { root.set-cell-format(0); }
                        }
                        LoomButton {
                            label: "$";
                            variant: root.cell-format == 1 ? "primary" : "ghost";
                            clicked => { root.set-cell-format(1); }
                        }
                        LoomButton {
                            label: "%";
                            variant: root.cell-format == 2 ? "primary" : "ghost";
                            clicked => { root.set-cell-format(2); }
                        }
                        LoomButton {
                            label: "1.23";
                            variant: root.cell-format == 3 ? "primary" : "ghost";
                            clicked => { root.set-cell-format(3); }
                        }
                    }
                    SheetPropertyRow {
                        label: "Decimals";
                        HorizontalLayout {
                            spacing: Theme.tokens.space.xs;
                            LoomTextField { label: "Decimals count"; value: root.cell-decimals-label; enabled: false; horizontal-stretch: 1; }
                            LoomIconButton { icon: "minus"; tooltip: "Decrease decimals"; clicked => { root.adjust-decimals(-1); } }
                            LoomIconButton { icon: "plus"; tooltip: "Increase decimals"; clicked => { root.adjust-decimals(1); } }
                        }
                    }
                    LoomSectionHeader { title: "Alignment"; }
                    HorizontalLayout {
                        spacing: Theme.tokens.space.xs;
                        LoomButton {
                            label: "Left";
                            variant: root.cell-alignment == 0 ? "primary" : "ghost";
                            clicked => { root.set-cell-alignment(0); }
                        }
                        LoomButton {
                            label: "Center";
                            variant: root.cell-alignment == 1 ? "primary" : "ghost";
                            clicked => { root.set-cell-alignment(1); }
                        }
                        LoomButton {
                            label: "Right";
                            variant: root.cell-alignment == 2 ? "primary" : "ghost";
                            clicked => { root.set-cell-alignment(2); }
                        }
                    }
                    SheetPropertyRow {
                        label: "Row height";
                        HorizontalLayout {
                            spacing: Theme.tokens.space.xs;
                            LoomTextField { label: "Selected row height"; value: root.selected-row-height; enabled: false; horizontal-stretch: 1; }
                            LoomIconButton { icon: "minus"; tooltip: "Decrease row height"; clicked => { root.adjust-row-height(-4); } }
                            LoomIconButton { icon: "plus"; tooltip: "Increase row height"; clicked => { root.adjust-row-height(4); } }
                        }
                    }
                    SheetPropertyRow {
                        label: "Column width";
                        HorizontalLayout {
                            spacing: Theme.tokens.space.xs;
                            LoomTextField { label: "Selected column width"; value: root.selected-col-width; enabled: false; horizontal-stretch: 1; }
                            LoomIconButton { icon: "minus"; tooltip: "Decrease column width"; clicked => { root.adjust-col-width(-10); } }
                            LoomIconButton { icon: "plus"; tooltip: "Increase column width"; clicked => { root.adjust-col-width(10); } }
                        }
                    }
                }

                if (root.inspector-tab == 0 && !root.inspector-show-table)
                    || (root.inspector-tab == 1 && !root.inspector-show-cell) : Rectangle {
                    height: 72px;
                    Text {
                        text: "No matching properties";
                        color: Theme.palette().ink-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle { vertical-stretch: 1; background: transparent; }
            }
        }
    }
    }
}
