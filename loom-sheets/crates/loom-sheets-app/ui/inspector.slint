import {
    LoomTextField, LoomSearchField, LoomTabStrip,
    LoomPanel, LoomToggle, LoomButton, LoomIconButton,
} from "foundation.slint";
import { Theme } from "theme.slint";
import { SheetFieldRow, SheetStepperRow, SheetFillRow, SheetChoiceRow, SheetHeading } from "inspector_rows.slint";
import { SheetScrollBar } from "sheet_scrollbar.slint";

export component SheetInspector inherits LoomPanel {
    in property <string> selection-range: "A1";
    in property <string> selection-value: "";
    in property <string> selection-formula: "";
    in property <string> sheet-name: "Untitled";
    in property <string> table-rows-label: "1";
    in property <string> table-cols-label: "1";
    in property <string> selected-row-height: "24 px";
    in property <string> selected-col-width: "80 px";
    in-out property <string> inspector-search: "";
    in-out property <int> inspector-tab: 0;
    in property <bool> inspector-show-table: true;
    in property <bool> inspector-show-cell: true;
    in property <bool> active: false;
    in property <int> cell-format: 0;
    in property <int> cell-alignment: 0;
    in property <bool> cell-bold: false;
    in property <bool> cell-italic: false;
    in property <bool> cell-underline: false;
    in-out property <bool> cell-border: false;
    in property <int> cell-fill: -1;
    in property <int> cell-font-size: 14;
    in property <string> cell-font-label: "14";
    in property <string> cell-decimals-label: "2";
    callback inspector-search-edited(string);
    callback inspector-context-changed(int);
    callback rename-sheet(string);
    callback add-table-row;
    callback delete-table-row;
    callback add-table-col;
    callback delete-table-col;
    callback adjust-row-height(int);
    callback adjust-col-width(int);
    callback set-cell-format(int);
    callback set-cell-alignment(int);
    callback toggle-bold;
    callback toggle-italic;
    callback toggle-underline;
    callback toggle-borders;
    callback cycle-fill;
    callback set-fill(int);
    callback adjust-font(int);
    callback adjust-decimals(int);
    callback close-requested;
    // How far the body scrolls: zero when every control fits.
    property <length> scroll-range: max(0px, inspector-scroll.viewport-height - inspector-scroll.height);

    public function focus-inspector() { panel-focus.focus(); }

    width: 320px;

    changed active => {
        if (root.active) { panel-focus.focus(); }
    }

    changed inspector-tab => {
        inspector-scroll.viewport-y = 0px;
    }

    panel-focus := FocusScope {
        enabled: root.active;
        accessible-role: groupbox;
        accessible-label: "Inspector, " + root.selection-range + " selection";
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-requested();
                return accept;
            }
            return reject;
        }

    VerticalLayout {
        spacing: Theme.tokens.space.md;
        padding: Theme.tokens.space.xl;

        if !Theme.rtl : HorizontalLayout {
            cross-axis-alignment: center;
            Text {
                text: root.selection-range + " selection";
                font-size: Theme.type.title;
                font-weight: 700;
                color: Theme.palette().ink;
                horizontal-stretch: 1;
                min-width: 0px;
                wrap: no-wrap;
                overflow: elide;
                accessible-role: text;
                accessible-label: root.selection-range + " selection";
            }
            LoomButton {
                label: "Close";
                variant: "ghost";
                clicked => { root.close-requested(); }
            }
        }
        if Theme.rtl : HorizontalLayout {
            cross-axis-alignment: center;
            LoomButton {
                label: "Close";
                variant: "ghost";
                clicked => { root.close-requested(); }
            }
            Text {
                text: root.selection-range + " selection";
                font-size: Theme.type.title;
                font-weight: 700;
                color: Theme.palette().ink;
                horizontal-stretch: 1;
                min-width: 0px;
                horizontal-alignment: right;
                wrap: no-wrap;
                overflow: elide;
                accessible-role: text;
                accessible-label: root.selection-range + " selection";
            }
        }

        LoomSearchField {
            placeholder: "Search properties…";
            value <=> root.inspector-search;
            edited(text) => { root.inspector-search-edited(text); }
        }

        LoomTabStrip {
            items: ["Organize", "Format"];
            current <=> root.inspector-tab;
            selected(idx) => { root.inspector-context-changed(idx); }
        }

        inspector-scroll := Flickable {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            viewport-width: parent.width;
            // The content keeps its own height. A taller viewport would make the
            // layout absorb the spare height as gaps between rows.
            viewport-height: cell-property-layout.preferred-height;

            cell-property-layout := VerticalLayout {
                x: 0px;
                width: parent.width;
                spacing: Theme.tokens.space.lg;
                padding-bottom: Theme.tokens.space.xl * Theme.text-scale;

                if root.inspector-tab == 0 && root.inspector-show-table : VerticalLayout {
                    spacing: Theme.tokens.space.md;
                    SheetHeading { title: "Table"; }
                    SheetFieldRow {
                        label: "Name";
                        field-label: "Table name";
                        value: root.sheet-name;
                        editable: true;
                        edited(name) => { root.rename-sheet(name); }
                    }
                    SheetStepperRow {
                        label: "Rows";
                        field-label: "Worksheet rows";
                        value: root.table-rows-label;
                        plus-first: true;
                        increase-label: "Add worksheet row";
                        increase-tip: "Add a row after the last used worksheet row.";
                        decrease-label: "Delete selected row";
                        decrease-tip: "Remove the row containing the selected cell and shift later rows up.";
                        increase => { root.add-table-row(); }
                        decrease => { root.delete-table-row(); }
                    }
                    SheetStepperRow {
                        label: "Columns";
                        field-label: "Worksheet columns";
                        value: root.table-cols-label;
                        plus-first: true;
                        increase-label: "Add worksheet column";
                        increase-tip: "Add a column after the last used worksheet column.";
                        decrease-label: "Delete selected column";
                        decrease-tip: "Remove the column containing the selected cell and shift later columns left.";
                        increase => { root.add-table-col(); }
                        decrease => { root.delete-table-col(); }
                    }
                }

                if root.inspector-tab == 1 && root.inspector-show-cell : VerticalLayout {
                    spacing: Theme.tokens.space.md;
                    SheetHeading { title: "Cell"; }
                    SheetFieldRow { label: "Selection"; field-label: "Selected range"; value: root.selection-range; }
                    SheetFieldRow { label: "Value"; field-label: "Displayed value"; value: root.selection-value == "" ? "Empty" : root.selection-value; }
                    SheetFieldRow { label: "Formula"; field-label: "Raw formula"; value: root.selection-formula == "" ? "No formula" : root.selection-formula; placeholder: root.selection-formula == ""; }
                    SheetHeading { title: "Font Style"; }
                    if !Theme.rtl : HorizontalLayout {
                        spacing: Theme.tokens.space.xs;
                        LoomIconButton {
                            icon: "bold";
                            label: "Toggle bold formatting (Cell inspector)";
                            tooltip: "Turn bold formatting on or off for selected cells in the Cell inspector.";
                            selected: root.cell-bold;
                            text-scale: Theme.text-scale;
                            clicked => { root.toggle-bold(); }
                        }
                        LoomIconButton {
                            icon: "italic";
                            label: "Toggle italic formatting (Cell inspector)";
                            tooltip: "Turn italic formatting on or off for selected cells in the Cell inspector.";
                            selected: root.cell-italic;
                            text-scale: Theme.text-scale;
                            clicked => { root.toggle-italic(); }
                        }
                        LoomIconButton {
                            icon: "underline";
                            label: "Toggle underline formatting (Cell inspector)";
                            tooltip: "Turn underline formatting on or off for selected cells in the Cell inspector.";
                            selected: root.cell-underline;
                            text-scale: Theme.text-scale;
                            clicked => { root.toggle-underline(); }
                        }
                    }
                    if Theme.rtl : HorizontalLayout {
                        spacing: Theme.tokens.space.xs;
                        alignment: end;
                        LoomIconButton {
                            icon: "underline";
                            label: "Toggle underline formatting (Cell inspector)";
                            tooltip: "Turn underline formatting on or off for selected cells in the Cell inspector.";
                            selected: root.cell-underline;
                            text-scale: Theme.text-scale;
                            clicked => { root.toggle-underline(); }
                        }
                        LoomIconButton {
                            icon: "italic";
                            label: "Toggle italic formatting (Cell inspector)";
                            tooltip: "Turn italic formatting on or off for selected cells in the Cell inspector.";
                            selected: root.cell-italic;
                            text-scale: Theme.text-scale;
                            clicked => { root.toggle-italic(); }
                        }
                        LoomIconButton {
                            icon: "bold";
                            label: "Toggle bold formatting (Cell inspector)";
                            tooltip: "Turn bold formatting on or off for selected cells in the Cell inspector.";
                            selected: root.cell-bold;
                            text-scale: Theme.text-scale;
                            clicked => { root.toggle-bold(); }
                        }
                    }
                    SheetStepperRow {
                        label: "Font size";
                        field-label: "Font size in points";
                        value: root.cell-font-label;
                        decrease-label: "Decrease selected cell font size";
                        decrease-tip: "Reduce the font size of selected cells by one step.";
                        increase-label: "Increase selected cell font size";
                        increase-tip: "Increase the font size of selected cells by one step.";
                        decrease => { root.adjust-font(-1); }
                        increase => { root.adjust-font(1); }
                    }
                    SheetHeading { title: "Borders & Fill"; }
                    HorizontalLayout {
                        spacing: Theme.tokens.space.xs;
                        alignment: Theme.rtl ? end : start;
                        // A switch, not a button: its on/off value is announced, and it
                        // follows the cell's border state in both directions.
                        LoomToggle {
                            label: "Border";
                            checked <=> root.cell-border;
                            accessible-checkable: true;
                            accessible-checked: root.cell-border;
                            toggled => { root.toggle-borders(); }
                        }
                    }
                    Text {
                        text: "Fill";
                        font-size: Theme.type.caption;
                        color: Theme.palette().ink-secondary;
                        horizontal-alignment: Theme.rtl ? right : left;
                        accessible-role: text;
                        accessible-label: "Fill";
                    }
                    SheetFillRow { cell-fill: root.cell-fill; set-fill(idx) => { root.set-fill(idx); } }
                    SheetHeading { title: "Data Format"; }
                    SheetChoiceRow { choices: ["123", "$", "%", "1.23"]; choice-names: ["Number", "Currency", "Percent", "Decimal places"]; current: root.cell-format; chosen(i) => { root.set-cell-format(i); } }
                    SheetStepperRow {
                        label: "Decimals";
                        field-label: "Decimals count";
                        value: root.cell-decimals-label;
                        decrease-label: "Decrease displayed decimal places";
                        decrease-tip: "Show one fewer decimal place in the selected cells.";
                        increase-label: "Increase displayed decimal places";
                        increase-tip: "Show one more decimal place in the selected cells.";
                        decrease => { root.adjust-decimals(-1); }
                        increase => { root.adjust-decimals(1); }
                    }
                    SheetHeading { title: "Alignment"; }
                    SheetChoiceRow { choices: ["Left", "Center", "Right"]; current: root.cell-alignment; chosen(i) => { root.set-cell-alignment(i); } }
                    SheetStepperRow {
                        label: "Row height";
                        field-label: "Selected row height";
                        value: root.selected-row-height;
                        decrease-label: "Decrease selected row height";
                        decrease-tip: "Reduce the selected row height by 4 px, down to 16 px.";
                        increase-label: "Increase selected row height";
                        increase-tip: "Increase the selected row height by 4 px, up to 160 px.";
                        decrease => { root.adjust-row-height(-4); }
                        increase => { root.adjust-row-height(4); }
                    }
                    SheetStepperRow {
                        label: "Column width";
                        field-label: "Selected column width";
                        value: root.selected-col-width;
                        decrease-label: "Decrease selected column width";
                        decrease-tip: "Reduce the selected column width by 10 px, down to 32 px.";
                        increase-label: "Increase selected column width";
                        increase-tip: "Increase the selected column width by 10 px, up to 400 px.";
                        decrease => { root.adjust-col-width(-10); }
                        increase => { root.adjust-col-width(10); }
                    }
                }

                if (root.inspector-tab == 0 && !root.inspector-show-table)
                    || (root.inspector-tab == 1 && !root.inspector-show-cell) : Rectangle {
                    height: 72px;
                    Text {
                        text: "No matching properties";
                        color: Theme.palette().ink-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle { vertical-stretch: 1; background: transparent; }
            }
        }
    }
    }
    // Drawn over the body's right padding (the left one in right-to-left), so the
    // track never covers a control. It is not a Tab stop: focus already scrolls.
    if root.scroll-range > 0px : SheetScrollBar {
        label: "Inspector scroll";
        focusable: false;
        x: Theme.rtl ? (Theme.tokens.space.xl - Theme.tokens.space.md) / 2
            : root.width - Theme.tokens.space.xl + (Theme.tokens.space.xl - Theme.tokens.space.md) / 2;
        y: inspector-scroll.absolute-position.y - root.absolute-position.y;
        width: Theme.tokens.space.md;
        height: inspector-scroll.height;
        maximum: root.scroll-range;
        page-size: inspector-scroll.height;
        value <=> inspector-scroll.viewport-y;
    }
}
