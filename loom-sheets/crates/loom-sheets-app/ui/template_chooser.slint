import { LoomButton } from "foundation.slint";
import { Icon } from "icons.slint";
import { Theme } from "theme.slint";
import {
    BlankPreview, BlankBlackPreview, TableChartPreview, PivotPreview,
    ChartingPreview, BudgetPreview, MonthlyBudgetPreview, MonthlyGoalPreview,
    PortfolioPreview, NetWorthPreview, InvoicePreview,
} from "template_previews.slint";

component SheetsTemplateCard inherits Rectangle {
    in property <string> title: "";
    in property <bool> selected: false;
    in property <length> preview-width: 144px;
    in property <length> preview-height: 96px;
    in property <color> preview-background: #ffffff;
    in property <float> text-scale: 1.0;
    callback clicked;

    width: 156px;
    height: max(160px, root.preview-height + 14px + 44px * root.text-scale);
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { root.clicked(); }

    VerticalLayout {
        spacing: 6px;
        alignment: start;
        cross-axis-alignment: center;

        // Preview frame
        Rectangle {
            width: root.preview-width;
            height: root.preview-height;
            border-radius: Theme.tokens.metrics.radius-small;
            background: root.preview-background;
            border-width: root.selected ? 2.5px : 1px;
            border-color: root.selected ? Theme.palette().success : Theme.palette().border;
            clip: true;
            drop-shadow-blur: root.selected ? 6px : 3px;
            drop-shadow-offset-y: 1.5px;
            drop-shadow-color: Theme.palette().shadow;

            @children
        }

        Text {
            text: root.title;
            font-size: Theme.tokens.typography.caption * root.text-scale;
            font-weight: root.selected ? 600 : 500;
            color: Theme.palette().ink;
            horizontal-alignment: center;
            wrap: word-wrap;
            width: root.width - 8px;
            min-height: 44px * root.text-scale;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component TemplateChooserModal inherits Rectangle {
    in-out property <int> template-selected: 0;
    in-out property <int> template-category: 0;
    in property <[int]> template-recents: [];
    in-out property <int> template-scroll-position: 0;
    in property <float> text-scale: 1.0;
    function template-content-height() -> length {
        let card-height = max(160px, 110px + 44px * root.text-scale);
        let heading-height = 24px * root.text-scale;
        let body-height = 40px * root.text-scale;
        let inner-gap = 16px;
        let section-gap = 24px;
        let recent-height = heading-height + inner-gap
            + (root.template-recents.length == 0 ? body-height : card-height);
        let two-row-section = heading-height + 2 * inner-gap + 2 * card-height;
        let one-row-section = heading-height + inner-gap + card-height;

        if (root.template-category == 0) {
            return recent-height + 2 * two-row-section + 3 * one-row-section
                + 5 * section-gap + 16px;
        }
        if (root.template-category == 1) {
            return recent-height + 16px;
        }
        if (root.template-category == 2 || root.template-category == 3) {
            return two-row-section + 16px;
        }
        return one-row-section + 16px;
    }
    pure function template-title(index: int) -> string {
        return ["Blank", "Monthly Budget", "Invoice & Expenses", "Checklist", "Table and Chart", "Expense Summary", "Sales Chart", "Budget", "Monthly Goal", "Portfolio", "Net Worth"][index];
    }
    callback cancel-template;
    callback create-template(int);

    function choose-template-category(category-index: int) {
        root.template-category = category-index;
        root.template-scroll-position = 0;
        if (category-index == 1) {
            root.template-selected = root.template-recents.length > 0 ? root.template-recents[0] : 0;
        } else if (category-index == 2) {
            root.template-selected = 0;
        } else if (category-index == 3) {
            root.template-selected = 7;
        } else if (category-index == 4) {
            root.template-selected = 1;
        } else if (category-index == 5) {
            root.template-selected = 2;
        } else if (category-index == 6) {
            root.template-selected = 6;
        }
    }

    x: 0px;
    y: 0px;
    background: Theme.palette().scrim;

    // Numbers modal container
    Rectangle {
        width: min(1120px, max(760px, root.width - 48px));
        x: (root.width - self.width) / 2;
        height: min(720px, max(460px, root.height - 48px));
        y: (root.height - self.height) / 2;
        border-radius: Theme.tokens.metrics.radius-large;
        border-width: 1px;
        border-color: Theme.palette().border;
        background: Theme.palette().surface;
        clip: true;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: Theme.palette().shadow;

        VerticalLayout {
            spacing: 0px;
            padding: 0px;

            HorizontalLayout {
                spacing: 0px;
                vertical-stretch: 1;

                // Left Category Sidebar
                Rectangle {
                    width: 200px;
                    background: Theme.palette().panel;

                    VerticalLayout {
                        spacing: Theme.tokens.space.xs;
                        padding-top: Theme.tokens.space.xl;
                        padding-bottom: Theme.tokens.space.md;
                        padding-left: Theme.tokens.space.md;
                        padding-right: Theme.tokens.space.md;

                        for cat[i] in [
                            { name: "All Templates", icon: "grid" },
                            { name: "Recents", icon: "clock" },
                            { name: "Basic", icon: "table" },
                            { name: "Personal Finance", icon: "chart" },
                            { name: "Personal", icon: "folder" },
                            { name: "Business", icon: "package" },
                            { name: "Education", icon: "document" },
                        ] : Rectangle {
                            height: 30px * root.text-scale;
                            border-radius: Theme.tokens.metrics.radius-medium;
                            background: root.template-category == i ? Theme.palette().surface-raised : transparent;
                            HorizontalLayout {
                                spacing: Theme.tokens.space.md;
                                padding-left: Theme.tokens.space.md;
                                padding-right: Theme.tokens.space.md;
                                cross-axis-alignment: center;
                                Icon {
                                    size: 15px;
                                    icon: cat.icon;
                                    tint: Theme.palette().success;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: cat.name;
                                    font-size: Theme.tokens.typography.caption * root.text-scale;
                                    font-weight: root.template-category == i ? 600 : 400;
                                    color: Theme.palette().ink;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                            TouchArea { clicked => { root.choose-template-category(i); } }
                        }

                        Rectangle { vertical-stretch: 1; background: transparent; }

                        HorizontalLayout {
                            spacing: Theme.tokens.space.sm;
                            padding-left: Theme.tokens.space.md;
                            padding-bottom: Theme.tokens.space.sm;
                            cross-axis-alignment: center;
                            Text {
                                text: "English (US)";
                                font-size: Theme.tokens.typography.micro;
                                color: Theme.palette().ink-secondary;
                                vertical-alignment: center;
                            }
                            Icon {
                                size: 10px;
                                icon: "chevron-down";
                                tint: Theme.palette().ink-secondary;
                            }
                        }
                    }

                    Rectangle {
                        x: parent.width - 1px;
                        y: 0px;
                        width: 1px;
                        height: parent.height;
                        background: Theme.palette().border;
                    }
                }

                // Right Content Area
                VerticalLayout {
                    horizontal-stretch: 1;
                    padding-top: Theme.tokens.space.xl;
                    padding-bottom: Theme.tokens.space.md;
                    padding-left: Theme.tokens.space.xxl;
                    padding-right: Theme.tokens.space.xl;
                    spacing: Theme.tokens.space.lg;

                    Text {
                        text: "Choose a Template";
                        font-size: Theme.tokens.typography.display * root.text-scale;
                        font-weight: 700;
                        color: Theme.palette().ink;
                    }

                    scroll-viewport := Rectangle {
                        height: min(520px, max(400px, root.height - 240px));
                        clip: true;

                        template-scroll := Flickable {
                            width: parent.width;
                            height: parent.height;
                            viewport-height: max(template-scroll.height, root.template-content-height());
                            viewport-y: -Math.min(
                                Math.max(0px, root.template-scroll-position * (174px * root.text-scale)
                                    - (template-scroll.height - 174px * root.text-scale)),
                                Math.max(0px, root.template-content-height() - template-scroll.height)
                            );

                            sections := VerticalLayout {
                                width: parent.width;
                                spacing: Theme.tokens.space.xl;
                                padding-bottom: Theme.tokens.space.md;
                                alignment: start;

                            // Only templates actually created in this session appear here.
                            if root.template-category == 0 || root.template-category == 1 : VerticalLayout {
                                vertical-stretch: 0;
                                spacing: Theme.tokens.space.md;
                                alignment: start;
                                Text {
                                    text: "Recent templates (this session)";
                                    font-size: Theme.tokens.typography.title * root.text-scale;
                                    font-weight: 600;
                                    color: Theme.palette().ink;
                                }
                                if root.template-recents.length == 0 : Text {
                                    text: "No recent templates. Choose a template below or select a category.";
                                    wrap: word-wrap;
                                    font-size: Theme.tokens.typography.body * root.text-scale;
                                    color: Theme.palette().ink-secondary;
                                }
                                HorizontalLayout {
                                    vertical-stretch: 0;
                                    spacing: Theme.tokens.space.lg;
                                    alignment: start;
                                    for recent in root.template-recents : SheetsTemplateCard {
                                        title: root.template-title(recent);
                                        selected: root.template-selected == recent;
                                        text-scale: root.text-scale;
                                        clicked => { root.template-selected = recent; }
                                        if recent == 0 : BlankPreview {}
                                        if recent == 1 : MonthlyBudgetPreview {}
                                        if recent == 2 : InvoicePreview {}
                                        if recent == 3 : BlankBlackPreview {}
                                        if recent == 4 : TableChartPreview {}
                                        if recent == 5 : PivotPreview {}
                                        if recent == 6 : ChartingPreview {}
                                        if recent == 7 : BudgetPreview {}
                                        if recent == 8 : MonthlyGoalPreview {}
                                        if recent == 9 : PortfolioPreview {}
                                        if recent == 10 : NetWorthPreview {}
                                    }
                                }
                            }

                            // Basic Section
                            if root.template-category == 0 || root.template-category == 2 : VerticalLayout {
                                vertical-stretch: 0;
                                spacing: Theme.tokens.space.md;
                                alignment: start;
                                Text {
                                    text: "Basic";
                                    font-size: Theme.tokens.typography.title * root.text-scale;
                                    font-weight: 600;
                                    color: Theme.palette().ink;
                                }
                                HorizontalLayout {
                                    vertical-stretch: 0;
                                    spacing: Theme.tokens.space.lg;
                                    SheetsTemplateCard {
                                        title: "Blank";
                                        selected: root.template-selected == 0;
                                        text-scale: root.text-scale;
                                        clicked => { root.template-selected = 0; }
                                        BlankPreview {}
                                    }
                                    SheetsTemplateCard {
                                        title: "Checklist";
                                        selected: root.template-selected == 3;
                                        text-scale: root.text-scale;
                                        clicked => { root.template-selected = 3; }
                                        BlankBlackPreview {}
                                    }
                                    SheetsTemplateCard {
                                        title: "Table and Chart";
                                        selected: root.template-selected == 4;
                                        text-scale: root.text-scale;
                                        clicked => { root.template-selected = 4; }
                                        TableChartPreview {}
                                    }
                                }
                                HorizontalLayout {
                                    vertical-stretch: 0;
                                    spacing: Theme.tokens.space.lg;
                                    alignment: start;
                                    SheetsTemplateCard {
                                        title: "Expense Summary";
                                        selected: root.template-selected == 5;
                                        text-scale: root.text-scale;
                                        clicked => { root.template-selected = 5; }
                                        PivotPreview {}
                                    }
                                    SheetsTemplateCard {
                                        title: "Sales Chart";
                                        selected: root.template-selected == 6;
                                        text-scale: root.text-scale;
                                        clicked => { root.template-selected = 6; }
                                        ChartingPreview {}
                                    }
                                }
                            }

                            // Personal Finance Section
                            if root.template-category == 0 || root.template-category == 3 : VerticalLayout {
                                vertical-stretch: 0;
                                spacing: Theme.tokens.space.md;
                                alignment: start;
                                Text {
                                    text: "Personal Finance";
                                    font-size: Theme.tokens.typography.title * root.text-scale;
                                    font-weight: 600;
                                    color: Theme.palette().ink;
                                }
                                HorizontalLayout {
                                    vertical-stretch: 0;
                                    spacing: Theme.tokens.space.lg;
                                    SheetsTemplateCard {
                                        title: "Budget";
                                        selected: root.template-selected == 7;
                                        text-scale: root.text-scale;
                                        clicked => { root.template-selected = 7; }
                                        BudgetPreview {}
                                    }
                                    SheetsTemplateCard {
                                        title: "Monthly Budget";
                                        selected: root.template-selected == 1;
                                        text-scale: root.text-scale;
                                        clicked => { root.template-selected = 1; }
                                        MonthlyBudgetPreview {}
                                    }
                                    SheetsTemplateCard {
                                        title: "Monthly Goal";
                                        selected: root.template-selected == 8;
                                        text-scale: root.text-scale;
                                        clicked => { root.template-selected = 8; }
                                        MonthlyGoalPreview {}
                                    }
                                }
                                HorizontalLayout {
                                    vertical-stretch: 0;
                                    spacing: Theme.tokens.space.lg;
                                    alignment: start;
                                    SheetsTemplateCard {
                                        title: "Portfolio";
                                        selected: root.template-selected == 9;
                                        text-scale: root.text-scale;
                                        clicked => { root.template-selected = 9; }
                                        PortfolioPreview {}
                                    }
                                    SheetsTemplateCard {
                                        title: "Net Worth";
                                        selected: root.template-selected == 10;
                                        text-scale: root.text-scale;
                                        clicked => { root.template-selected = 10; }
                                        NetWorthPreview {}
                                    }
                                }
                            }

                            // Personal Section (category 4)
                            if root.template-category == 0 || root.template-category == 4 : VerticalLayout {
                                vertical-stretch: 0;
                                spacing: Theme.tokens.space.md;
                                alignment: start;
                                Text {
                                    text: "Personal";
                                    font-size: Theme.tokens.typography.title * root.text-scale;
                                    font-weight: 600;
                                    color: Theme.palette().ink;
                                }
                                HorizontalLayout {
                                    vertical-stretch: 0;
                                    spacing: Theme.tokens.space.lg;
                                    SheetsTemplateCard {
                                        title: "Monthly Budget";
                                        selected: root.template-selected == 1;
                                        text-scale: root.text-scale;
                                        clicked => { root.template-selected = 1; }
                                        MonthlyBudgetPreview {}
                                    }
                                    SheetsTemplateCard {
                                        title: "Monthly Goal";
                                        selected: root.template-selected == 8;
                                        text-scale: root.text-scale;
                                        clicked => { root.template-selected = 8; }
                                        MonthlyGoalPreview {}
                                    }
                                    SheetsTemplateCard {
                                        title: "Net Worth";
                                        selected: root.template-selected == 10;
                                        text-scale: root.text-scale;
                                        clicked => { root.template-selected = 10; }
                                        NetWorthPreview {}
                                    }
                                }
                            }

                            // Business Section (category 5)
                            if root.template-category == 0 || root.template-category == 5 : VerticalLayout {
                                vertical-stretch: 0;
                                spacing: Theme.tokens.space.md;
                                alignment: start;
                                Text {
                                    text: "Business";
                                    font-size: Theme.tokens.typography.title * root.text-scale;
                                    font-weight: 600;
                                    color: Theme.palette().ink;
                                }
                                HorizontalLayout {
                                    vertical-stretch: 0;
                                    spacing: Theme.tokens.space.lg;
                                    SheetsTemplateCard {
                                        title: "Invoice & Expenses";
                                        selected: root.template-selected == 2;
                                        text-scale: root.text-scale;
                                        clicked => { root.template-selected = 2; }
                                        InvoicePreview {}
                                    }
                                    SheetsTemplateCard {
                                        title: "Table and Chart";
                                        selected: root.template-selected == 4;
                                        text-scale: root.text-scale;
                                        clicked => { root.template-selected = 4; }
                                        TableChartPreview {}
                                    }
                                    SheetsTemplateCard {
                                        title: "Expense Summary";
                                        selected: root.template-selected == 5;
                                        text-scale: root.text-scale;
                                        clicked => { root.template-selected = 5; }
                                        PivotPreview {}
                                    }
                                }
                            }

                            // Education Section (category 6)
                            if root.template-category == 0 || root.template-category == 6 : VerticalLayout {
                                vertical-stretch: 0;
                                spacing: Theme.tokens.space.md;
                                alignment: start;
                                Text {
                                    text: "Education";
                                    font-size: Theme.tokens.typography.title * root.text-scale;
                                    font-weight: 600;
                                    color: Theme.palette().ink;
                                }
                                HorizontalLayout {
                                    vertical-stretch: 0;
                                    spacing: Theme.tokens.space.lg;
                                    SheetsTemplateCard {
                                        title: "Sales Chart";
                                        selected: root.template-selected == 6;
                                        text-scale: root.text-scale;
                                        clicked => { root.template-selected = 6; }
                                        ChartingPreview {}
                                    }
                                    SheetsTemplateCard {
                                        title: "Monthly Goal";
                                        selected: root.template-selected == 8;
                                        text-scale: root.text-scale;
                                        clicked => { root.template-selected = 8; }
                                        MonthlyGoalPreview {}
                                    }
                                    SheetsTemplateCard {
                                        title: "Table and Chart";
                                        selected: root.template-selected == 4;
                                        text-scale: root.text-scale;
                                        clicked => { root.template-selected = 4; }
                                        TableChartPreview {}
                                    }
                                }
                            }
                            }
                        }
                    }
                }
            }

            // Bottom Footer Action Bar
            Rectangle {
                height: 52px;
                background: Theme.palette().chrome;

                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.palette().border;
                }

                HorizontalLayout {
                    spacing: Theme.tokens.space.lg;
                    padding-left: Theme.tokens.space.xl;
                    padding-right: Theme.tokens.space.xl;
                    cross-axis-alignment: center;

                    Text {
                        text: "Escape to cancel • Return to create";
                        font-size: Theme.tokens.typography.caption;
                        color: Theme.palette().ink-secondary;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }

                    LoomButton {
                        label: "Cancel";
                        variant: "secondary";
                        clicked => { root.cancel-template(); }
                    }

                    LoomButton {
                        label: "Create";
                        variant: "primary";
                        clicked => { root.create-template(root.template-selected); }
                    }
                }
            }
        }
    }
}
