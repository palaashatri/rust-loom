import { LoomButton } from "foundation.slint";
import { Icon } from "icons.slint";
import { Theme } from "theme.slint";

component BlankPreview inherits VerticalLayout {
    spacing: 0px;
    Rectangle { height: 16px; background: #e5e7eb; }
    for idx in 4 : Rectangle {
        height: 16px;
        background: #ffffff;
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: #f3f4f6; }
        HorizontalLayout {
            spacing: 0px;
            Rectangle { width: 32px; border-width: 0.5px; border-color: #e5e7eb; }
            Rectangle { width: 44px; border-width: 0.5px; border-color: #e5e7eb; }
            Rectangle { width: 44px; border-width: 0.5px; border-color: #e5e7eb; }
            Rectangle { horizontal-stretch: 1; border-width: 0.5px; border-color: #e5e7eb; }
        }
    }
}

component BlankBlackPreview inherits VerticalLayout {
    spacing: 0px;
    Rectangle { height: 16px; background: #27272a; }
    for idx in 4 : Rectangle {
        height: 16px;
        background: #18181b;
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: #27272a; }
        HorizontalLayout {
            spacing: 0px;
            Rectangle { width: 32px; border-width: 0.5px; border-color: #3f3f46; }
            Rectangle { width: 44px; border-width: 0.5px; border-color: #3f3f46; }
            Rectangle { width: 44px; border-width: 0.5px; border-color: #3f3f46; }
            Rectangle { horizontal-stretch: 1; border-width: 0.5px; border-color: #3f3f46; }
        }
    }
}

component TableChartPreview inherits VerticalLayout {
    spacing: 2px;
    padding: 4px;
    HorizontalLayout {
        height: 44px;
        spacing: 6px;
        alignment: center;
        cross-axis-alignment: end;
        Rectangle { width: 14px; height: 18px; border-radius: 2px; background: #3b82f6; }
        Rectangle { width: 14px; height: 32px; border-radius: 2px; background: #06b6d4; }
        Rectangle { width: 14px; height: 24px; border-radius: 2px; background: #10b981; }
        Rectangle { width: 14px; height: 40px; border-radius: 2px; background: #f59e0b; }
        Rectangle { width: 14px; height: 28px; border-radius: 2px; background: #8b5cf6; }
    }
    Rectangle { height: 1px; background: #e5e7eb; }
    VerticalLayout {
        spacing: 0px;
        Rectangle { height: 12px; background: #f1f5f9; }
        Rectangle { height: 12px; background: #ffffff; }
        Rectangle { height: 12px; background: #f8fafc; }
    }
}

component PivotPreview inherits VerticalLayout {
    spacing: 0px;
    Rectangle { height: 14px; background: #2563eb; }
    for idx in 4 : Rectangle {
        height: 16px;
        background: Math.mod(idx, 2) == 1 ? #f1f5f9 : #ffffff;
        HorizontalLayout {
            spacing: 0px;
            Rectangle { width: 48px; border-width: 0.5px; border-color: #cbd5e1; }
            Rectangle { width: 44px; border-width: 0.5px; border-color: #cbd5e1; }
            Rectangle { horizontal-stretch: 1; border-width: 0.5px; border-color: #cbd5e1; }
        }
    }
}

component ChartingPreview inherits HorizontalLayout {
    padding: 4px;
    spacing: 6px;
    HorizontalLayout {
        width: 60px;
        spacing: 4px;
        alignment: center;
        cross-axis-alignment: end;
        Rectangle { width: 12px; height: 22px; border-radius: 2px; background: #ef4444; }
        Rectangle { width: 12px; height: 38px; border-radius: 2px; background: #eab308; }
        Rectangle { width: 12px; height: 50px; border-radius: 2px; background: #10b981; }
    }
    VerticalLayout {
        spacing: 4px;
        alignment: center;
        Rectangle { width: 56px; height: 10px; border-radius: 2px; background: #3b82f6; }
        Rectangle { width: 40px; height: 10px; border-radius: 2px; background: #06b6d4; }
        Rectangle { width: 48px; height: 10px; border-radius: 2px; background: #8b5cf6; }
    }
}

