    }
}

component InvoicePreview inherits VerticalLayout {
    padding: 4px;
    spacing: 2px;
    HorizontalLayout {
        alignment: end;
        Rectangle { width: 44px; height: 10px; border-radius: 2px; background: #0284c7; }
    }
    for idx in 3 : Rectangle {
        height: 14px;
        background: Math.mod(idx, 2) == 1 ? #f8fafc : #ffffff;
        HorizontalLayout {
            spacing: 0px;
            Rectangle { width: 40px; border-width: 0.5px; border-color: #cbd5e1; }
            Rectangle { width: 28px; border-width: 0.5px; border-color: #cbd5e1; }
            Rectangle { horizontal-stretch: 1; border-width: 0.5px; border-color: #cbd5e1; }
        }
    }
    HorizontalLayout {
        alignment: end;
        Rectangle { width: 50px; height: 12px; border-radius: 2px; background: #e0f2fe; }
    }
}

component SheetsTemplateCard inherits Rectangle {
    in property <string> title: "";
    in property <bool> selected: false;
    in property <length> preview-width: 144px;
    in property <length> preview-height: 96px;
    in property <color> preview-background: #ffffff;
    callback clicked;

    width: 156px;
    height: 136px;
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { root.clicked(); }

    VerticalLayout {
        spacing: 6px;
        alignment: start;
        cross-axis-alignment: center;

        // Preview frame
        Rectangle {
            width: root.preview-width;
            height: root.preview-height;
            border-radius: Theme.tokens.metrics.radius-small;
            background: root.preview-background;
            border-width: root.selected ? 2.5px : 1px;
            border-color: root.selected ? Theme.palette().success : Theme.palette().border;
            clip: true;
            drop-shadow-blur: root.selected ? 6px : 3px;
            drop-shadow-offset-y: 1.5px;
            drop-shadow-color: Theme.palette().shadow;

            @children
        }

        // Selection pill badge or regular label
        if root.selected : Rectangle {
            height: 18px;
            border-radius: 9px;
            background: Theme.palette().success;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                alignment: center;
                cross-axis-alignment: center;
                Text {
                    text: root.title;
                    font-size: Theme.tokens.typography.micro;
                    font-weight: 600;
                    color: #ffffff;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if !root.selected : Text {
            text: root.title;
            font-size: Theme.tokens.typography.caption;
            font-weight: 500;
            color: Theme.palette().ink;
            horizontal-alignment: center;
            overflow: elide;
            max-width: root.width - 8px;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component TemplateChooserModal inherits Rectangle {
    in-out property <int> template-selected: 0;
    in-out property <int> template-category: 0;
    callback cancel-template;
    callback create-template(int);

    function choose-template-category(category-index: int) {
        root.template-category = category-index;
        if (category-index == 1) {
            root.template-selected = 0;
        } else if (category-index == 2) {
            root.template-selected = 0;
        } else if (category-index == 3) {
            root.template-selected = 7;
        } else if (category-index == 4) {
            root.template-selected = 1;
        } else if (category-index == 5) {
            root.template-selected = 2;
        } else if (category-index == 6) {
            root.template-selected = 6;
        }
    }

    x: 0px;
    y: 0px;
    background: Theme.palette().scrim;

    // Numbers modal container
    Rectangle {
        width: min(1120px, max(760px, root.width - 48px));
        x: (root.width - self.width) / 2;
        height: min(720px, max(460px, root.height - 48px));
        y: (root.height - self.height) / 2;
        border-radius: Theme.tokens.metrics.radius-large;
        border-width: 1px;
        border-color: Theme.palette().border;
        background: Theme.palette().surface;
        clip: true;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: Theme.palette().shadow;

        VerticalLayout {
            spacing: 0px;
            padding: 0px;

            HorizontalLayout {
                spacing: 0px;
                vertical-stretch: 1;

                // Left Category Sidebar
                Rectangle {
                    width: 200px;
                    background: Theme.palette().panel;

                    VerticalLayout {
                        spacing: Theme.tokens.space.xs;
                        padding-top: Theme.tokens.space.xl;
                        padding-bottom: Theme.tokens.space.md;
                        padding-left: Theme.tokens.space.md;
                        padding-right: Theme.tokens.space.md;

                        for cat[i] in [
                            { name: "All Templates", icon: "grid" },
                            { name: "Recents", icon: "clock" },
                            { name: "Basic", icon: "table" },
                            { name: "Personal Finance", icon: "chart" },
                            { name: "Personal", icon: "folder" },
                            { name: "Business", icon: "package" },
                            { name: "Education", icon: "document" },
                        ] : Rectangle {
                            height: 30px;
                            border-radius: Theme.tokens.metrics.radius-medium;
                            background: root.template-category == i ? Theme.palette().surface-raised : transparent;
                            HorizontalLayout {
                                spacing: Theme.tokens.space.md;
                                padding-left: Theme.tokens.space.md;
                                padding-right: Theme.tokens.space.md;
                                cross-axis-alignment: center;
                                Icon {
                                    size: 15px;
                                    icon: cat.icon;
                                    tint: Theme.palette().success;
                                }
                                Text {
                                    text: cat.name;
                                    font-size: Theme.tokens.typography.caption;
                                    font-weight: root.template-category == i ? 600 : 400;
                                    color: Theme.palette().ink;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                            }
                            TouchArea { clicked => { root.choose-template-category(i); } }
                        }

                        Rectangle { vertical-stretch: 1; background: transparent; }

                        HorizontalLayout {
                            spacing: Theme.tokens.space.sm;
                            padding-left: Theme.tokens.space.md;
                            padding-bottom: Theme.tokens.space.sm;
                            cross-axis-alignment: center;
                            Text {
                                text: "English (US)";
                                font-size: Theme.tokens.typography.micro;
                                color: Theme.palette().ink-secondary;
                                vertical-alignment: center;
                            }
                            Icon {
                                size: 10px;
                                icon: "chevron-down";
                                tint: Theme.palette().ink-secondary;
                            }
                        }
                    }

                    Rectangle {
                        x: parent.width - 1px;
                        y: 0px;
                        width: 1px;
                        height: parent.height;
                        background: Theme.palette().border;
                    }
                }

                // Right Content Area
                VerticalLayout {
                    horizontal-stretch: 1;
                    padding-top: Theme.tokens.space.xl;
                    padding-bottom: Theme.tokens.space.md;
                    padding-left: Theme.tokens.space.xxl;
                    padding-right: Theme.tokens.space.xl;
                    spacing: Theme.tokens.space.lg;

                    Text {
                        text: "Choose a Template";
                        font-size: Theme.tokens.typography.display;
                        font-weight: 700;
                        color: Theme.palette().ink;
                    }

                    Flickable {
                        vertical-stretch: 1;
                        viewport-height: sections.preferred-height;

                        sections := VerticalLayout {
                            spacing: Theme.tokens.space.xl;
                            padding-bottom: Theme.tokens.space.md;

                            // Recents Section
                            if root.template-category == 0 || root.template-category == 1 : VerticalLayout {
                                spacing: Theme.tokens.space.md;
                                Text {
                                    text: "Recents";
                                    font-size: Theme.tokens.typography.title;
                                    font-weight: 600;
                                    color: Theme.palette().ink;
                                }
                                HorizontalLayout {
                                    spacing: Theme.tokens.space.lg;
                                    SheetsTemplateCard {
                                        title: "Blank";
                                        selected: root.template-selected == 0;
                                        clicked => { root.template-selected = 0; }
                                        BlankPreview {}
                                    }
                                }
                            }

                            // Basic Section
                            if root.template-category == 0 || root.template-category == 2 : VerticalLayout {
                                spacing: Theme.tokens.space.md;
                                Text {
                                    text: "Basic";
                                    font-size: Theme.tokens.typography.title;
                                    font-weight: 600;
                                    color: Theme.palette().ink;
                                }
                                HorizontalLayout {
                                    spacing: Theme.tokens.space.lg;
                                    SheetsTemplateCard {
                                        title: "Blank";
                                        selected: root.template-selected == 0;
                                        clicked => { root.template-selected = 0; }
                                        BlankPreview {}
                                    }
                                    SheetsTemplateCard {
                                        title: "Blank Black";
                                        selected: root.template-selected == 3;
                                        preview-background: #18181b;
                                        clicked => { root.template-selected = 3; }
                                        BlankBlackPreview {}
                                    }
                                    SheetsTemplateCard {
                                        title: "Table and Chart";
                                        selected: root.template-selected == 4;
                                        clicked => { root.template-selected = 4; }
                                        TableChartPreview {}
                                    }
                                    SheetsTemplateCard {
                                        title: "Pivot Table Basics";
                                        selected: root.template-selected == 5;
                                        clicked => { root.template-selected = 5; }
                                        PivotPreview {}
                                    }
                                    SheetsTemplateCard {
                                        title: "Charting Basics";
                                        selected: root.template-selected == 6;
                                        clicked => { root.template-selected = 6; }
                                        ChartingPreview {}
                                    }
                                }
                            }

                            // Personal Finance Section
                            if root.template-category == 0 || root.template-category == 3 : VerticalLayout {
                                spacing: Theme.tokens.space.md;
                                Text {
                                    text: "Personal Finance";
                                    font-size: Theme.tokens.typography.title;
                                    font-weight: 600;
                                    color: Theme.palette().ink;
                                }
                                HorizontalLayout {
                                    spacing: Theme.tokens.space.lg;
                                    SheetsTemplateCard {
                                        title: "Budget";
                                        selected: root.template-selected == 7;
                                        clicked => { root.template-selected = 7; }
                                        BudgetPreview {}
                                    }
                                    SheetsTemplateCard {
                                        title: "Monthly Budget";
                                        selected: root.template-selected == 1;
                                        clicked => { root.template-selected = 1; }
                                        MonthlyBudgetPreview {}
                                    }
                                    SheetsTemplateCard {
                                        title: "Monthly Goal";
                                        selected: root.template-selected == 8;
                                        clicked => { root.template-selected = 8; }
                                        MonthlyGoalPreview {}
                                    }
                                    SheetsTemplateCard {
                                        title: "Portfolio";
                                        selected: root.template-selected == 9;
                                        clicked => { root.template-selected = 9; }
                                        PortfolioPreview {}
                                    }
                                    SheetsTemplateCard {
                                        title: "Net Worth";
                                        selected: root.template-selected == 10;
                                        clicked => { root.template-selected = 10; }
                                        NetWorthPreview {}
                                    }
                                }
                            }

                            // Personal Section (category 4)
                            if root.template-category == 4 : VerticalLayout {
                                spacing: Theme.tokens.space.md;
                                Text {
                                    text: "Personal";
                                    font-size: Theme.tokens.typography.title;
                                    font-weight: 600;
                                    color: Theme.palette().ink;
                                }
                                HorizontalLayout {
                                    spacing: Theme.tokens.space.lg;
                                    SheetsTemplateCard {
                                        title: "Monthly Budget";
                                        selected: root.template-selected == 1;
                                        clicked => { root.template-selected = 1; }
                                        MonthlyBudgetPreview {}
                                    }
                                    SheetsTemplateCard {
                                        title: "Monthly Goal";
                                        selected: root.template-selected == 8;
                                        clicked => { root.template-selected = 8; }
                                        MonthlyGoalPreview {}
                                    }
                                    SheetsTemplateCard {
                                        title: "Net Worth";
                                        selected: root.template-selected == 10;
                                        clicked => { root.template-selected = 10; }
                                        NetWorthPreview {}
                                    }
                                }
                            }

                            // Business Section (category 5)
                            if root.template-category == 5 : VerticalLayout {
                                spacing: Theme.tokens.space.md;
                                Text {
                                    text: "Business";
                                    font-size: Theme.tokens.typography.title;
                                    font-weight: 600;
                                    color: Theme.palette().ink;
                                }
                                HorizontalLayout {
                                    spacing: Theme.tokens.space.lg;
                                    SheetsTemplateCard {
                                        title: "Invoice & Expenses";
                                        selected: root.template-selected == 2;
                                        clicked => { root.template-selected = 2; }
                                        InvoicePreview {}
                                    }
                                    SheetsTemplateCard {
                                        title: "Table and Chart";
                                        selected: root.template-selected == 4;
                                        clicked => { root.template-selected = 4; }
                                        TableChartPreview {}
                                    }
                                    SheetsTemplateCard {
                                        title: "Pivot Table Basics";
                                        selected: root.template-selected == 5;
                                        clicked => { root.template-selected = 5; }
                                        PivotPreview {}
                                    }
                                }
                            }

                            // Education Section (category 6)
                            if root.template-category == 6 : VerticalLayout {
                                spacing: Theme.tokens.space.md;
                                Text {
                                    text: "Education";
                                    font-size: Theme.tokens.typography.title;
                                    font-weight: 600;
                                    color: Theme.palette().ink;
                                }
                                HorizontalLayout {
                                    spacing: Theme.tokens.space.lg;
                                    SheetsTemplateCard {
                                        title: "Charting Basics";
                                        selected: root.template-selected == 6;
                                        clicked => { root.template-selected = 6; }
                                        ChartingPreview {}
                                    }
                                    SheetsTemplateCard {
                                        title: "Monthly Goal";
                                        selected: root.template-selected == 8;
                                        clicked => { root.template-selected = 8; }
                                        MonthlyGoalPreview {}
                                    }
                                    SheetsTemplateCard {
                                        title: "Table and Chart";
                                        selected: root.template-selected == 4;
                                        clicked => { root.template-selected = 4; }
                                        TableChartPreview {}
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Bottom Footer Action Bar
            Rectangle {
                height: 52px;
                background: Theme.palette().chrome;

                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.palette().border;
                }

                HorizontalLayout {
                    spacing: Theme.tokens.space.lg;
                    padding-left: Theme.tokens.space.xl;
                    padding-right: Theme.tokens.space.xl;
                    cross-axis-alignment: center;

                    Text {
                        text: "Escape to cancel • Return to create";
                        font-size: Theme.tokens.typography.caption;
                        color: Theme.palette().ink-secondary;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }

                    LoomButton {
                        label: "Cancel";
                        variant: "secondary";
                        clicked => { root.cancel-template(); }
                    }

                    LoomButton {
                        label: "Create";
                        variant: "primary";
                        clicked => { root.create-template(root.template-selected); }
                    }
                }
            }
        }
    }
}


