import { LoomButton } from "foundation.slint";
import { Icon } from "icons.slint";
import { Theme } from "theme.slint";
import { SheetsTemplateOption } from "template_cards.slint";

export component TemplateChooserModal inherits Rectangle {
    in-out property <int> template-selected: 0;
    in-out property <int> template-category: 0;
    in property <[int]> template-recents: [];
    in-out property <int> template-scroll-position: 0;
    in property <float> text-scale: 1.0;
    in property <bool> keyboard-active: false;
    in property <bool> focus-request: false;
    accessible-role: groupbox;
    accessible-label: "Template chooser";
    accessible-description: root.template-title(root.template-selected)
        + " selected. Use Left and Right to choose; Return creates it; Escape cancels.";
    function template-content-height() -> length {
        let card-height = max(160px, 110px + 44px * root.text-scale);
        let heading-height = 24px * root.text-scale;
        let body-height = 40px * root.text-scale;
        let inner-gap = 16px;
        let section-gap = 24px;
        let recent-height = heading-height + inner-gap
            + (root.template-recents.length == 0 ? body-height : card-height);
        let two-row-section = heading-height + 2 * inner-gap + 2 * card-height;
        let one-row-section = heading-height + inner-gap + card-height;

        if (root.template-category == 0) {
            return recent-height + 2 * two-row-section + 3 * one-row-section
                + 5 * section-gap + 16px;
        }
        if (root.template-category == 1) {
            return recent-height + 16px;
        }
        if (root.template-category == 2 || root.template-category == 3) {
            return two-row-section + 16px;
        }
        return one-row-section + 16px;
    }
    pure function template-title(index: int) -> string {
        return ["Blank", "Monthly Budget", "Invoice & Expenses", "Checklist", "Table and Chart", "Expense Summary", "Sales Chart", "Budget", "Monthly Goal", "Portfolio", "Net Worth"][index];
    }
    callback cancel-template;
    callback create-template(int);
    callback navigate-template-selection(int);

    public function focus-template-chooser() {
        chooser-focus.focus();
    }

    changed keyboard-active => {
        if (root.keyboard-active) {
            chooser-focus.focus();
        }
    }

    changed focus-request => {
        if (root.keyboard-active) {
            chooser-focus.focus();
        }
    }

    function choose-template-category(category-index: int) {
        root.template-category = category-index;
        root.template-scroll-position = 0;
        if (category-index == 1) {
            root.template-selected = root.template-recents.length > 0 ? root.template-recents[0] : 0;
        } else if (category-index == 2) {
            root.template-selected = 0;
        } else if (category-index == 3) {
            root.template-selected = 7;
        } else if (category-index == 4) {
            root.template-selected = 1;
        } else if (category-index == 5) {
            root.template-selected = 2;
        } else if (category-index == 6) {
            root.template-selected = 6;
        }
    }

    x: 0px;
    y: 0px;
    background: Theme.palette().scrim;

    // The chooser is keyboard-complete: Left/Right pick a template, Up/Down a
    // category, Return creates, Escape cancels, and Tab walks Cancel and Create
    // then wraps back to the chooser (Shift+Tab the other way), so focus never
    // leaves the dialog. The scope parents the buttons, so their keys bubble to it.
    chooser-focus := FocusScope {
        width: parent.width;
        height: parent.height;
        enabled: root.keyboard-active;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel-template();
                return accept;
            }
            if (event.text == Key.Return) {
                root.create-template(root.template-selected);
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.navigate-template-selection(Theme.rtl ? 1 : -1);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.navigate-template-selection(Theme.rtl ? -1 : 1);
                return accept;
            }
            if (event.text == Key.UpArrow) { root.choose-template-category(max(0, root.template-category - 1)); return accept; }
            if (event.text == Key.DownArrow) { root.choose-template-category(min(6, root.template-category + 1)); return accept; }
            if (event.text == Key.Tab && !event.modifiers.shift && create-button.has-focus) { chooser-focus.focus(); return accept; }
            if ((event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) && chooser-focus.has-focus) { create-button.grab-focus(); return accept; }
            return reject;
        }

    // Numbers modal container
    Rectangle {
        width: min(1120px, max(760px, root.width - 48px));
        x: (root.width - self.width) / 2;
        height: min(720px, max(460px, root.height - 48px));
        y: (root.height - self.height) / 2;
        border-radius: Theme.tokens.metrics.radius-large;
        border-width: 1px;
        border-color: Theme.palette().border;
        background: Theme.palette().surface;
        clip: true;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: Theme.palette().shadow;

        VerticalLayout {
            spacing: 0px;
            padding: 0px;

            // The category list sits at the reading-start side: left in LTR, right
            // in RTL; the template grid fills the rest.
            Rectangle {
                vertical-stretch: 1;

                sidebar := Rectangle {
                    x: Theme.rtl ? parent.width - self.width : 0px;
                    width: 200px;
                    height: parent.height;
                    background: Theme.palette().panel;

                    VerticalLayout {
                        spacing: Theme.tokens.space.xs;
                        padding-top: Theme.tokens.space.xl;
                        padding-bottom: Theme.tokens.space.md;
                        padding-left: Theme.tokens.space.md;
                        padding-right: Theme.tokens.space.md;

                        for cat[i] in [
                            { name: "All Templates", icon: "grid" },
                            { name: "Recents", icon: "clock" },
                            { name: "Basic", icon: "table" },
                            { name: "Personal Finance", icon: "chart" },
                            { name: "Personal", icon: "folder" },
                            { name: "Business", icon: "package" },
                            { name: "Education", icon: "document" },
                        ] : Rectangle {
                            height: 30px * root.text-scale;
                            border-radius: Theme.tokens.metrics.radius-medium;
                            background: root.template-category == i ? Theme.palette().surface-raised : transparent;
                            if !Theme.rtl : HorizontalLayout {
                                spacing: Theme.tokens.space.md;
                                padding-left: Theme.tokens.space.md;
                                padding-right: Theme.tokens.space.md;
                                cross-axis-alignment: center;
                                Icon {
                                    size: 15px;
                                    icon: cat.icon;
                                    tint: Theme.palette().success;
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: cat.name;
                                    font-size: Theme.tokens.typography.caption * root.text-scale;
                                    font-weight: root.template-category == i ? 600 : 400;
                                    color: Theme.palette().ink;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                            if Theme.rtl : HorizontalLayout {
                                spacing: Theme.tokens.space.md;
                                padding-left: Theme.tokens.space.md;
                                padding-right: Theme.tokens.space.md;
                                cross-axis-alignment: center;
                                Text {
                                    horizontal-stretch: 1;
                                    text: cat.name;
                                    font-size: Theme.tokens.typography.caption * root.text-scale;
                                    font-weight: root.template-category == i ? 600 : 400;
                                    color: Theme.palette().ink;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    wrap: word-wrap;
                                }
                                Icon {
                                    size: 15px;
                                    icon: cat.icon;
                                    tint: Theme.palette().success;
                                }
                            }
                            TouchArea { clicked => { root.choose-template-category(i); } }
                        }

                        Rectangle { vertical-stretch: 1; background: transparent; }

                        HorizontalLayout {
                            spacing: Theme.tokens.space.sm;
                            padding-left: Theme.rtl ? 0px : Theme.tokens.space.md;
                            padding-right: Theme.rtl ? Theme.tokens.space.md : 0px;
                            padding-bottom: Theme.tokens.space.sm;
                            alignment: Theme.rtl ? end : start;
                            cross-axis-alignment: center;
                            Text {
                                text: "English (US)";
                                font-size: Theme.type.micro;
                                color: Theme.palette().ink-secondary;
                                vertical-alignment: center;
                            }
                            Icon {
                                size: 10px;
                                icon: "chevron-down";
                                tint: Theme.palette().ink-secondary;
                            }
                        }
                    }

                    Rectangle {
                        x: Theme.rtl ? 0px : parent.width - 1px;
                        y: 0px;
                        width: 1px;
                        height: parent.height;
                        background: Theme.palette().border;
                    }
                }

                // Content area
                VerticalLayout {
                    x: Theme.rtl ? 0px : sidebar.width;
                    width: parent.width - sidebar.width;
                    height: parent.height;
                    padding-top: Theme.tokens.space.xl;
                    padding-bottom: Theme.tokens.space.md;
                    padding-left: Theme.rtl ? Theme.tokens.space.xl : Theme.tokens.space.xxl;
                    padding-right: Theme.rtl ? Theme.tokens.space.xxl : Theme.tokens.space.xl;
                    spacing: Theme.tokens.space.lg;

                    Text {
                        text: "Choose a Template";
                        font-size: Theme.tokens.typography.display * root.text-scale;
                        font-weight: 700;
                        color: Theme.palette().ink;
                        horizontal-alignment: Theme.rtl ? right : left;
                    }

                    scroll-viewport := Rectangle {
                        height: min(520px, max(400px, root.height - 240px));
                        clip: true;

                        template-scroll := Flickable {
                            width: parent.width;
                            height: parent.height;
                            viewport-height: max(template-scroll.height, root.template-content-height());
                            viewport-y: -Math.min(
                                Math.max(0px, root.template-scroll-position * (174px * root.text-scale)
                                    - (template-scroll.height - 174px * root.text-scale)),
                                Math.max(0px, root.template-content-height() - template-scroll.height)
                            );

                            sections := VerticalLayout {
                                width: parent.width;
                                spacing: Theme.tokens.space.xl;
                                padding-bottom: Theme.tokens.space.md;
                                alignment: start;

                            // Only templates actually created in this session appear here.
                            if root.template-category == 0 || root.template-category == 1 : VerticalLayout {
                                vertical-stretch: 0;
                                spacing: Theme.tokens.space.md;
                                alignment: start;
                                Text {
                                    text: "Recent templates (this session)";
                                    font-size: Theme.tokens.typography.title * root.text-scale;
                                    font-weight: 600;
                                    color: Theme.palette().ink;
                                    horizontal-alignment: Theme.rtl ? right : left;
                                }
                                if root.template-recents.length == 0 : Text {
                                    text: "No recent templates. Choose a template below or select a category.";
                                    wrap: word-wrap;
                                    font-size: Theme.tokens.typography.body * root.text-scale;
                                    color: Theme.palette().ink-secondary;
                                }
                                if !Theme.rtl : HorizontalLayout {
                                    vertical-stretch: 0;
                                    spacing: Theme.tokens.space.lg;
                                    alignment: start;
                                    for recent in root.template-recents : SheetsTemplateOption { index: recent; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = recent; } }
                                }
                                if Theme.rtl : HorizontalLayout {
                                    vertical-stretch: 0;
                                    spacing: Theme.tokens.space.lg;
                                    alignment: end;
                                    for slot in root.template-recents.length : SheetsTemplateOption { index: root.template-recents[root.template-recents.length - 1 - slot]; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = root.template-recents[root.template-recents.length - 1 - slot]; } }
                                }
                            }

                            // Basic Section
                            if root.template-category == 0 || root.template-category == 2 : VerticalLayout {
                                vertical-stretch: 0;
                                spacing: Theme.tokens.space.md;
                                alignment: start;
                                Text {
                                    text: "Basic";
                                    font-size: Theme.tokens.typography.title * root.text-scale;
                                    font-weight: 600;
                                    color: Theme.palette().ink;
                                    horizontal-alignment: Theme.rtl ? right : left;
                                }
                                if !Theme.rtl : HorizontalLayout {
                                    vertical-stretch: 0;
                                    spacing: Theme.tokens.space.lg;
                                    alignment: start;
                                    SheetsTemplateOption { index: 0; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 0; } }
                                    SheetsTemplateOption { index: 3; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 3; } }
                                    SheetsTemplateOption { index: 4; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 4; } }
                                }
                                if Theme.rtl : HorizontalLayout {
                                    vertical-stretch: 0;
                                    spacing: Theme.tokens.space.lg;
                                    alignment: end;
                                    SheetsTemplateOption { index: 4; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 4; } }
                                    SheetsTemplateOption { index: 3; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 3; } }
                                    SheetsTemplateOption { index: 0; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 0; } }
                                }
                                if !Theme.rtl : HorizontalLayout {
                                    vertical-stretch: 0;
                                    spacing: Theme.tokens.space.lg;
                                    alignment: start;
                                    SheetsTemplateOption { index: 5; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 5; } }
                                    SheetsTemplateOption { index: 6; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 6; } }
                                }
                                if Theme.rtl : HorizontalLayout {
                                    vertical-stretch: 0;
                                    spacing: Theme.tokens.space.lg;
                                    alignment: end;
                                    SheetsTemplateOption { index: 6; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 6; } }
                                    SheetsTemplateOption { index: 5; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 5; } }
                                }
                            }

                            // Personal Finance Section
                            if root.template-category == 0 || root.template-category == 3 : VerticalLayout {
                                vertical-stretch: 0;
                                spacing: Theme.tokens.space.md;
                                alignment: start;
                                Text {
                                    text: "Personal Finance";
                                    font-size: Theme.tokens.typography.title * root.text-scale;
                                    font-weight: 600;
                                    color: Theme.palette().ink;
                                    horizontal-alignment: Theme.rtl ? right : left;
                                }
                                if !Theme.rtl : HorizontalLayout {
                                    vertical-stretch: 0;
                                    spacing: Theme.tokens.space.lg;
                                    alignment: start;
                                    SheetsTemplateOption { index: 7; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 7; } }
                                    SheetsTemplateOption { index: 1; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 1; } }
                                    SheetsTemplateOption { index: 8; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 8; } }
                                }
                                if Theme.rtl : HorizontalLayout {
                                    vertical-stretch: 0;
                                    spacing: Theme.tokens.space.lg;
                                    alignment: end;
                                    SheetsTemplateOption { index: 8; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 8; } }
                                    SheetsTemplateOption { index: 1; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 1; } }
                                    SheetsTemplateOption { index: 7; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 7; } }
                                }
                                if !Theme.rtl : HorizontalLayout {
                                    vertical-stretch: 0;
                                    spacing: Theme.tokens.space.lg;
                                    alignment: start;
                                    SheetsTemplateOption { index: 9; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 9; } }
                                    SheetsTemplateOption { index: 10; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 10; } }
                                }
                                if Theme.rtl : HorizontalLayout {
                                    vertical-stretch: 0;
                                    spacing: Theme.tokens.space.lg;
                                    alignment: end;
                                    SheetsTemplateOption { index: 10; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 10; } }
                                    SheetsTemplateOption { index: 9; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 9; } }
                                }
                            }

                            // Personal Section (category 4)
                            if root.template-category == 0 || root.template-category == 4 : VerticalLayout {
                                vertical-stretch: 0;
                                spacing: Theme.tokens.space.md;
                                alignment: start;
                                Text {
                                    text: "Personal";
                                    font-size: Theme.tokens.typography.title * root.text-scale;
                                    font-weight: 600;
                                    color: Theme.palette().ink;
                                    horizontal-alignment: Theme.rtl ? right : left;
                                }
                                if !Theme.rtl : HorizontalLayout {
                                    vertical-stretch: 0;
                                    spacing: Theme.tokens.space.lg;
                                    alignment: start;
                                    SheetsTemplateOption { index: 1; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 1; } }
                                    SheetsTemplateOption { index: 8; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 8; } }
                                    SheetsTemplateOption { index: 10; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 10; } }
                                }
                                if Theme.rtl : HorizontalLayout {
                                    vertical-stretch: 0;
                                    spacing: Theme.tokens.space.lg;
                                    alignment: end;
                                    SheetsTemplateOption { index: 10; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 10; } }
                                    SheetsTemplateOption { index: 8; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 8; } }
                                    SheetsTemplateOption { index: 1; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 1; } }
                                }
                            }

                            // Business Section (category 5)
                            if root.template-category == 0 || root.template-category == 5 : VerticalLayout {
                                vertical-stretch: 0;
                                spacing: Theme.tokens.space.md;
                                alignment: start;
                                Text {
                                    text: "Business";
                                    font-size: Theme.tokens.typography.title * root.text-scale;
                                    font-weight: 600;
                                    color: Theme.palette().ink;
                                    horizontal-alignment: Theme.rtl ? right : left;
                                }
                                if !Theme.rtl : HorizontalLayout {
                                    vertical-stretch: 0;
                                    spacing: Theme.tokens.space.lg;
                                    alignment: start;
                                    SheetsTemplateOption { index: 2; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 2; } }
                                    SheetsTemplateOption { index: 4; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 4; } }
                                    SheetsTemplateOption { index: 5; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 5; } }
                                }
                                if Theme.rtl : HorizontalLayout {
                                    vertical-stretch: 0;
                                    spacing: Theme.tokens.space.lg;
                                    alignment: end;
                                    SheetsTemplateOption { index: 5; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 5; } }
                                    SheetsTemplateOption { index: 4; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 4; } }
                                    SheetsTemplateOption { index: 2; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 2; } }
                                }
                            }

                            // Education Section (category 6)
                            if root.template-category == 0 || root.template-category == 6 : VerticalLayout {
                                vertical-stretch: 0;
                                spacing: Theme.tokens.space.md;
                                alignment: start;
                                Text {
                                    text: "Education";
                                    font-size: Theme.tokens.typography.title * root.text-scale;
                                    font-weight: 600;
                                    color: Theme.palette().ink;
                                    horizontal-alignment: Theme.rtl ? right : left;
                                }
                                if !Theme.rtl : HorizontalLayout {
                                    vertical-stretch: 0;
                                    spacing: Theme.tokens.space.lg;
                                    alignment: start;
                                    SheetsTemplateOption { index: 6; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 6; } }
                                    SheetsTemplateOption { index: 8; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 8; } }
                                    SheetsTemplateOption { index: 4; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 4; } }
                                }
                                if Theme.rtl : HorizontalLayout {
                                    vertical-stretch: 0;
                                    spacing: Theme.tokens.space.lg;
                                    alignment: end;
                                    SheetsTemplateOption { index: 4; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 4; } }
                                    SheetsTemplateOption { index: 8; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 8; } }
                                    SheetsTemplateOption { index: 6; current: root.template-selected; text-scale: root.text-scale; clicked => { root.template-selected = 6; } }
                                }
                            }
                            }
                        }
                    }
                }
            }

            // Bottom Footer Action Bar. The primary button sits at the reading end:
            // right in LTR, left in RTL; the hint fills the rest.
            Rectangle {
                height: 52px;
                background: Theme.palette().chrome;

                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.palette().border;
                }

                cancel-button := LoomButton {
                    label: "Cancel";
                    variant: "secondary";
                    width: self.preferred-width;
                    height: Theme.tokens.metrics.control-height;
                    x: Theme.rtl
                        ? create-button.x + create-button.width + Theme.tokens.space.lg
                        : create-button.x - Theme.tokens.space.lg - self.width;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.cancel-template(); }
                }

                create-button := LoomButton {
                    label: "Create";
                    variant: "primary";
                    width: self.preferred-width;
                    height: Theme.tokens.metrics.control-height;
                    x: Theme.rtl ? Theme.tokens.space.xl : parent.width - Theme.tokens.space.xl - self.width;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.create-template(root.template-selected); }
                }

                Text {
                    text: "Escape to cancel • Return to create";
                    font-size: Theme.type.caption;
                    color: Theme.palette().ink-secondary;
                    x: Theme.rtl ? cancel-button.x + cancel-button.width + Theme.tokens.space.lg : Theme.tokens.space.xl;
                    width: Theme.rtl
                        ? max(0px, parent.width - Theme.tokens.space.xl - self.x)
                        : max(0px, cancel-button.x - Theme.tokens.space.lg - Theme.tokens.space.xl);
                    height: parent.height;
                    horizontal-alignment: Theme.rtl ? right : left;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
    }
}
