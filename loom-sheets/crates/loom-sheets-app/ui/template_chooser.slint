import { TemplateCard } from "toolkit.slint";
import { LoomButton } from "foundation.slint";
import { Icon } from "icons.slint";
import { Theme } from "theme.slint";

export component TemplateChooserModal inherits Rectangle {
    in-out property <int> template-selected: 0;
    in-out property <int> template-category: 0;
    callback cancel-template;
    callback create-template(int);

    function template-visible(template-index: int) -> bool {
        return root.template-category == 0
            || (root.template-category == 1 && template-index == 0)
            || (root.template-category == 2 && template-index == 1)
            || (root.template-category == 3 && template-index >= 2);
    }

    function choose-template-category(category-index: int) {
        root.template-category = category-index;
        if (category-index == 1) {
            root.template-selected = 0;
        } else if (category-index == 2) {
            root.template-selected = 1;
        } else if (category-index == 3) {
            root.template-selected = 2;
        }
    }

    x: 0px;
    y: 0px;
    background: Theme.palette().scrim;

    Rectangle {
        width: min(1160px, max(1px, root.width - 48px));
        x: (root.width - self.width) / 2;
        height: min(760px, max(480px, root.height - 48px));
        y: (root.height - self.height) / 2;
        border-radius: Theme.tokens.metrics.radius-large;
        border-width: 1px;
        border-color: Theme.palette().border;
        background: Theme.palette().surface;
        clip: true;
        drop-shadow-blur: 24px;
        drop-shadow-offset-y: 8px;
        drop-shadow-color: Theme.palette().shadow;

        VerticalLayout {
            spacing: 0px;
            padding: 0px;

            HorizontalLayout {
                spacing: 0px;
                vertical-stretch: 1;

                // Sidebar
                Rectangle {
                    width: 220px;
                    background: Theme.palette().panel;

                    VerticalLayout {
                        spacing: Theme.tokens.space.sm;
                        padding-top: Theme.tokens.space.xl;
                        padding-bottom: Theme.tokens.space.xl;
                        padding-left: Theme.tokens.space.lg;
                        padding-right: Theme.tokens.space.lg;

                        HorizontalLayout {
                            padding-left: Theme.tokens.space.md;
                            padding-bottom: Theme.tokens.space.sm;
                            Text {
                                text: "TEMPLATES";
                                font-size: 10px;
                                font-weight: 700;
                                color: Theme.palette().ink-secondary;
                            }
                        }

                        for cat[i] in [
                            { name: "All Templates", icon: "grid" },
                            { name: "Basic", icon: "table" },
                            { name: "Personal Finance", icon: "chart" },
                            { name: "Business", icon: "folder" }
                        ] : Rectangle {
                            height: 32px;
                            border-radius: Theme.tokens.metrics.radius-medium;
                            background: root.template-category == i ? Theme.palette().surface-raised : transparent;
                            HorizontalLayout {
                                spacing: Theme.tokens.space.md;
                                padding-left: Theme.tokens.space.md;
                                padding-right: Theme.tokens.space.md;
                                cross-axis-alignment: center;
                                Icon { size: 16px; icon: cat.icon; tint: root.template-category == i ? Theme.palette().accent : Theme.palette().ink-secondary; }
                                Text {
                                    text: cat.name;
                                    font-size: Theme.tokens.typography.body;
                                    font-weight: root.template-category == i ? 600 : 400;
                                    color: Theme.palette().ink;
                                    vertical-alignment: center;
                                }
                            }
                            TouchArea { clicked => { root.choose-template-category(i); } }
                        }

                        Rectangle { vertical-stretch: 1; background: transparent; }

                        HorizontalLayout {
                            spacing: Theme.tokens.space.sm; padding: Theme.tokens.space.md;
                            Text {
                                text: "English (US)";
                                font-size: Theme.tokens.typography.caption;
                                color: Theme.palette().ink-secondary;
                                vertical-alignment: center;
                            }
                            Icon { size: 12px; icon: "chevron-down"; tint: Theme.palette().ink-secondary; }
                        }
                    }

                    Rectangle { x: parent.width - 1px; y: 0px; width: 1px; height: parent.height; background: Theme.palette().border; }
                }

                // Content Area
                VerticalLayout {
                    horizontal-stretch: 1;
                    padding-top: Theme.tokens.space.xxl;
                    padding-bottom: Theme.tokens.space.xl;
                    padding-left: Theme.tokens.space.xxl;
                    padding-right: Theme.tokens.space.xxl;
                    spacing: Theme.tokens.space.xl;

                    Text {
                        text: "Choose a Template";
                        font-size: 24px;
                        font-weight: 700;
                        color: Theme.palette().ink;
                    }

                    VerticalLayout {
                        spacing: Theme.tokens.space.xl;

                        HorizontalLayout {
                            spacing: Theme.tokens.space.xl;

                            if root.template-visible(0) : TemplateCard {
                                title: "Blank";
                                selected: root.template-selected == 0;
                                preview-width: 160px;
                                preview-height: 115px;
                                width: 180px;
                                height: 185px;
                                show-selected-badge: true;
                                clicked => { root.template-selected = 0; }
                                VerticalLayout {
                                    spacing: 0px;
                                    Rectangle {
                                        height: 20px;
                                        background: Theme.palette().surface-sunken;
                                        HorizontalLayout {
                                            spacing: 1px;
                                            Rectangle { width: 40px; }
                                            Rectangle { width: 1px; background: Theme.palette().border; }
                                            Rectangle { width: 50px; }
                                            Rectangle { width: 1px; background: Theme.palette().border; }
                                            Rectangle { width: 50px; }
                                            Rectangle { width: 1px; background: Theme.palette().border; }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                    }
                                    for idx in 5 : Rectangle {
                                        height: 19px;
                                        background: Theme.palette().paper;
                                        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.palette().paper-line; }
                                        HorizontalLayout {
                                            spacing: 1px;
                                            Rectangle { width: 40px; }
                                            Rectangle { width: 1px; background: Theme.palette().paper-line; }
                                            Rectangle { width: 50px; }
                                            Rectangle { width: 1px; background: Theme.palette().paper-line; }
                                            Rectangle { width: 50px; }
                                            Rectangle { width: 1px; background: Theme.palette().paper-line; }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                    }
                                }
                            }

                            if root.template-visible(1) : TemplateCard {
                                title: "Monthly Budget";
                                selected: root.template-selected == 1;
                                preview-width: 160px;
                                preview-height: 115px;
                                width: 180px;
                                height: 185px;
                                show-selected-badge: true;
                                clicked => { root.template-selected = 1; }
                                VerticalLayout {
                                    spacing: 0px;
                                    Rectangle {
                                        height: 20px;
                                        background: Theme.palette().accent;
                                        HorizontalLayout {
                                            spacing: 1px;
                                            Rectangle { width: 40px; }
                                            Rectangle { width: 1px; background: Theme.palette().border; }
                                            Rectangle { width: 50px; }
                                            Rectangle { width: 1px; background: Theme.palette().border; }
                                            Rectangle { width: 50px; }
                                            Rectangle { width: 1px; background: Theme.palette().border; }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                    }
                                    for idx in 5 : Rectangle {
                                        height: 19px;
                                        background: Math.mod(idx, 2) == 1 ? Theme.palette().surface-sunken : Theme.palette().paper;
                                        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.palette().paper-line; }
                                        HorizontalLayout {
                                            spacing: 1px;
                                            Rectangle { width: 40px; }
                                            Rectangle { width: 1px; background: Theme.palette().paper-line; }
                                            Rectangle { width: 50px; }
                                            Rectangle { width: 1px; background: Theme.palette().paper-line; }
                                            Rectangle { width: 50px; }
                                            Rectangle { width: 1px; background: Theme.palette().paper-line; }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: Theme.tokens.space.xl;

                            if root.template-visible(2) : TemplateCard {
                                title: "Invoice & Expenses";
                                selected: root.template-selected == 2;
                                preview-width: 160px;
                                preview-height: 115px;
                                width: 180px;
                                height: 185px;
                                show-selected-badge: true;
                                clicked => { root.template-selected = 2; }
                                VerticalLayout {
                                    spacing: 0px;
                                    Rectangle {
                                        height: 20px;
                                        background: Theme.palette().content-cool;
                                        HorizontalLayout {
                                            spacing: 1px;
                                            Rectangle { width: 40px; }
                                            Rectangle { width: 1px; background: Theme.palette().border; }
                                            Rectangle { width: 50px; }
                                            Rectangle { width: 1px; background: Theme.palette().border; }
                                            Rectangle { width: 50px; }
                                            Rectangle { width: 1px; background: Theme.palette().border; }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                    }
                                    for idx in 5 : Rectangle {
                                        height: 19px;
                                        background: Math.mod(idx, 2) == 1 ? Theme.palette().surface-sunken : Theme.palette().paper;
                                        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.palette().paper-line; }
                                        HorizontalLayout {
                                            spacing: 1px;
                                            Rectangle { width: 40px; }
                                            Rectangle { width: 1px; background: Theme.palette().paper-line; }
                                            Rectangle { width: 50px; }
                                            Rectangle { width: 1px; background: Theme.palette().paper-line; }
                                            Rectangle { width: 50px; }
                                            Rectangle { width: 1px; background: Theme.palette().paper-line; }
                                            Rectangle { horizontal-stretch: 1; }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }

            // Footer Bar
            Rectangle {
                height: 56px;
                background: Theme.palette().chrome;

                Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.palette().border; }

                HorizontalLayout {
                    spacing: Theme.tokens.space.lg;
                    padding-left: Theme.tokens.space.xl;
                    padding-right: Theme.tokens.space.xl;
                    cross-axis-alignment: center;

                    Text {
                        text: "Escape to cancel • Return to create";
                        font-size: Theme.tokens.typography.caption;
                        color: Theme.palette().ink-secondary;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }

                    LoomButton {
                        label: "Cancel";
                        variant: "secondary";
                        clicked => { root.cancel-template(); }
                    }

                    LoomButton {
                        label: "Create Spreadsheet";
                        variant: "primary";
                        clicked => { root.create-template(root.template-selected); }
                    }
                }
            }
        }
    }
}
