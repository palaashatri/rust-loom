component PortfolioPreview inherits VerticalLayout {
    padding: 4px;
    spacing: 4px;
    Rectangle { height: 14px; border-radius: 2px; background: #dcfce7; }
    HorizontalLayout {
        height: 10px;
        spacing: 2px;
        Rectangle { width: 55px; border-radius: 2px; background: #10b981; }
        Rectangle { width: 35px; border-radius: 2px; background: #3b82f6; }
        Rectangle { horizontal-stretch: 1; border-radius: 2px; background: #f59e0b; }
    }
    VerticalLayout {
        spacing: 0px;
        Rectangle { height: 14px; background: #ffffff; border-width: 0.5px; border-color: #e5e7eb; }
        Rectangle { height: 14px; background: #f8fafc; border-width: 0.5px; border-color: #e5e7eb; }
        Rectangle { height: 14px; background: #ffffff; border-width: 0.5px; border-color: #e5e7eb; }
    }
}

component NetWorthPreview inherits VerticalLayout {
    padding: 4px;
    spacing: 4px;
    HorizontalLayout {
        spacing: 4px;
        Rectangle { horizontal-stretch: 1; height: 28px; border-radius: 2px; background: #dcfce7; }
        Rectangle { horizontal-stretch: 1; height: 28px; border-radius: 2px; background: #fee2e2; }
    }
    VerticalLayout {
        spacing: 0px;
        Rectangle { height: 14px; background: #f1f5f9; }
        Rectangle { height: 14px; background: #ffffff; }
