            width: 32px;
            height: 32px;
            border-radius: 16px;
            border-width: 6px;
            border-color: #10b981;
            background: transparent;
        }
        VerticalLayout {
            spacing: 3px;
            Rectangle { width: 50px; height: 6px; border-radius: 3px; background: #3b82f6; }
            Rectangle { width: 36px; height: 6px; border-radius: 3px; background: #f59e0b; }
            Rectangle { width: 44px; height: 6px; border-radius: 3px; background: #10b981; }
        }
    }
    Rectangle { height: 1px; background: #e5e7eb; }
    VerticalLayout {
        spacing: 0px;
        Rectangle { height: 12px; background: #dcfce7; }
        Rectangle { height: 12px; background: #ffffff; }
        Rectangle { height: 12px; background: #f8fafc; }
    }
}

