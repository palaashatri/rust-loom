import {
    LoomCanvasHandle, LoomIconButton, LoomButton
} from "foundation.slint";
import { Theme } from "theme.slint";

export component SheetChart inherits Rectangle {
    in property <string> title: "Chart";
    in property <string> source-range: "";
    in property <string> series-label: "Values";
    in property <string> unit-label: "Not specified";
    in property <string> kind: "bar";
    in property <float> text-scale: 1.0;
    in property <string> context-key: "";
    in property <bool> focus-request: false;
    in property <length> available-height: 600px;
    in property <[string]> categories: ["Development", "Design", "QA & Testing", "Total"];
    in property <[string]> values-display: ["$15,000", "$8,000", "$5,000", "$28,000"];
    in property <[float]> normalized: [0.54, 0.29, 0.18, 1.0];
    in property <float> bar-baseline-fraction: 1.0;
    in property <string> line-commands: "";
    in property <[string]> pie-commands: [];
    in property <[float]> pie-opacities: [];
    in-out property <int> selected-point: 0;
    in-out property <length> category-scroll-y: 0px;
    out property <int> point-count: min(root.categories.length, root.values-display.length);
    private property <bool> data-list-focused: false;
    private property <bool> category-focused: false;
    out property <bool> data-focused: root.data-list-focused || root.category-focused;
    callback close-chart;
    callback cycle-kind;
    callback focus-changed(bool);
    callback leave-data;

    function kind-label() -> string {
        if (root.kind == "line") {
            return "Line";
        }
        if (root.kind == "pie") {
            return "Pie";
        }
        if (root.kind == "scatter") {
            return "Scatter";
        }
        return "Bar";
    }

    function point-label() -> string {
        if (root.point-count == 0) {
            return "";
        }
        let label = root.categories[root.selected-point];
        return label == "" ? "Blank category" : label;
    }

    function point-value() -> string {
        if (root.point-count == 0) {
            return "";
        }
        return root.values-display[root.selected-point];
    }

    function point-detail() -> string {
        if (root.point-count == 0) {
            return "No chart data points.";
        }
        return "Point " + (root.selected-point + 1) + " of " + root.point-count
            + (root.kind == "scatter" ? ". X value: " : ". Category: ") + root.point-label() + ". Series: " + root.series-label
            + ". Value: " + root.point-value() + ". Unit: " + root.unit-label + ".";
    }

    function pie-summary() -> string {
        if (root.kind != "pie") {
            return "";
        }
        if (root.pie-commands.length == 0) {
            return "No positive values to plot. Zero and negative values are omitted.";
        }
        return "Zero and negative values are omitted from pie slices.";
    }

    function chart-guidance() -> string {
        if (root.kind == "pie" && root.pie-commands.length == 0) {
            return "No positive values to plot. Zero and negative values are omitted.";
        }
        if (root.kind == "pie") {
            return "Zero and negative values are omitted from pie slices.";
        }
        return "To change source: select two columns including headers, then Insert Chart.";
    }

    function chart-summary() -> string {
        if (root.point-count == 0) {
            return root.kind-label() + " chart. Source range " + root.source-range
                + ". Series " + root.series-label + ". Unit " + root.unit-label
                + ". No chart data points.";
        }
        return root.kind-label() + " chart. Source range " + root.source-range
            + ". Series " + root.series-label + ". Unit " + root.unit-label
            + (root.kind == "pie" ? ". " + root.pie-summary() : "")
            + ". " + root.point-detail()
            + " Use Left and Right to inspect points, Home and End to jump, Tab then Page Up or Page Down to scroll long point details, and F6 or Escape to return to the worksheet.";
    }

    function handle-data-key(event: KeyEvent) -> EventResult {
        if (event.text == Key.Escape || event.text == Key.F6) {
            root.leave-data();
            return accept;
        }
        if (event.modifiers.alt) {
            if (event.text == "f" || event.text == "F" || event.text == "e" || event.text == "E"
                || event.text == "v" || event.text == "V" || event.text == "t" || event.text == "T"
                || event.text == "h" || event.text == "H") { return reject; }
            return accept;
        }
        if (event.modifiers.control || event.modifiers.meta) {
            if (event.text == "k" || event.text == "K"
                || event.text == "n" || event.text == "N"
                || event.text == "o" || event.text == "O"
                || event.text == "s" || event.text == "S"
                || event.text == "e" || event.text == "E"
                || event.text == "=" || event.text == "+"
                || event.text == "-" || event.text == "0") { return reject; }
            return accept;
        }
        if (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
            if (!event.modifiers.shift && root.point-count > 0) {
                root.selected-point = max(0, min(root.point-count - 1,
                    root.selected-point + (event.text == Key.RightArrow ? 1 : -1)));
            }
            return accept;
        }
        if (event.text == Key.Home) {
            if (root.point-count > 0) { root.selected-point = 0; }
            return accept;
        }
        if (event.text == Key.End) {
            if (root.point-count > 0) { root.selected-point = root.point-count - 1; }
            return accept;
        }
        if (event.text == Key.Tab || event.text == Key.Backtab) { return reject; }
        if (event.text == Key.UpArrow || event.text == Key.DownArrow
            || event.text == Key.Delete || event.text == Key.Backspace
            || event.text == Key.Shift || event.text == Key.Control
            || event.text == Key.Alt || event.text == Key.AltGr || event.text == Key.Meta) {
            return accept;
        }
        if (event.text != "") { return accept; }
        return reject;
    }

    function clamp-selected-point() {
        root.selected-point = root.point-count == 0
            ? 0 : min(max(0, root.selected-point), root.point-count - 1);
    }

    changed categories => { root.clamp-selected-point(); root.category-scroll-y = 0px; }
    changed values-display => { root.clamp-selected-point(); root.category-scroll-y = 0px; }
    changed selected-point => { root.category-scroll-y = 0px; }
    changed context-key => { root.selected-point = 0; root.category-scroll-y = 0px; }
    changed focus-request => { root.focus-data(); }
    public function focus-data() {
        data-focus.focus();
    }

    width: 430px;
    height: min(400px * max(1.0, root.text-scale), max(1px, root.available-height - 24px));
    background: Theme.palette().surface;
    border-width: 1px;
    border-color: Theme.palette().border;
    border-radius: Theme.tokens.space.sm;
    drop-shadow-blur: 8px;
    drop-shadow-color: Theme.palette().shadow;

    VerticalLayout {
        padding: Theme.tokens.space.md;
        spacing: Theme.tokens.space.sm;

        // Chart Header
        HorizontalLayout {
            spacing: Theme.tokens.space.sm;
            cross-axis-alignment: center;

            Text {
                text: root.title;
                font-size: Theme.tokens.typography.body-large * root.text-scale;
                font-weight: 700;
                color: Theme.palette().ink;
                horizontal-stretch: 1;
                overflow: elide;
            }

            LoomButton {
                variant: "ghost";
                label: root.kind-label();
                clicked => {
                    root.cycle-kind();
                }
            }

            LoomIconButton {
                icon: "close";
                label: "Hide chart panel";
                tooltip: "Hide the chart preview and keep the chart in the worksheet.";
                clicked => { root.close-chart(); }
            }
        }

        Text {
            text: "Source: " + root.source-range + " · Series: " + root.series-label + " · Unit: " + root.unit-label;
            width: parent.width;
            overflow: elide;
            color: Theme.palette().ink;
            font-size: Theme.tokens.typography.caption * root.text-scale;
        }
        chart-guidance-text := Text {
            text: root.chart-guidance();
            accessible-label: root.chart-guidance();
            wrap: word-wrap;
            color: Theme.palette().ink;
            font-size: Theme.tokens.typography.caption * root.text-scale;
        }

        // Plot Area
        Rectangle {
            vertical-stretch: 1;
            background: Theme.palette().surface-sunken;
            border-width: 1px;
            border-color: Theme.palette().border;
            border-radius: Theme.tokens.space.xs;
            clip: true;
            min-height: min(112px * max(1.0, root.text-scale), root.height * 0.20);

            if root.point-count == 0 : Text {
                x: Theme.tokens.space.lg;
                y: Theme.tokens.space.lg;
                width: max(1px, parent.width - 2 * Theme.tokens.space.lg);
                text: "No chart data points are available for this source.";
                wrap: word-wrap;
                color: Theme.palette().ink-secondary;
                font-size: Theme.tokens.typography.body * root.text-scale;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            // Horizontal gridlines
            Rectangle {
                x: 0px;
                y: parent.height * 0.25;
                width: parent.width;
                height: 1px;
                background: Theme.palette().border;
            }
            Rectangle {
                x: 0px;
                y: parent.height * 0.50;
                width: parent.width;
                height: 1px;
                background: Theme.palette().border;
            }
            Rectangle {
                x: 0px;
                y: parent.height * 0.75;
                width: parent.width;
                height: 1px;
                background: Theme.palette().border;
            }

            // Series Data: bars, line, or pie depending on the live kind.
            if root.kind == "line" || root.kind == "scatter" : line-plot := Rectangle {
                x: 12px;
                y: 10px;
                width: parent.width - 24px;
                height: parent.height - 20px;
                clip: true;

                if root.kind == "line" : Path {
                    x: 6px;
                    y: 6px;
                    width: parent.width - 12px;
                    height: parent.height - 12px;
                    stroke: Theme.palette().accent;
                    stroke-width: 2px;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 100;
                    viewbox-height: 60;
                    fit: fill;
                    fill: transparent;
                    commands: root.line-commands;
                }

                for idx in root.point-count : line-point-marker := Rectangle {
                    property <float> nx: root.kind == "scatter"
                        ? (idx * 2 + 1 < root.normalized.length ? root.normalized[idx * 2 + 1] : 0.5)
                        : (root.categories.length > 1 ? idx / (root.categories.length - 1) : 0.5);
                    property <float> ny: root.kind == "scatter"
                        ? (idx * 2 < root.normalized.length ? root.normalized[idx * 2] : 0.0)
                        : (idx < root.normalized.length ? root.normalized[idx] : 0.0);
                    width: 11px;
                    height: 11px;
                    border-radius: 6px;
                    background: idx == root.selected-point ? Theme.palette().accent : transparent;
                    border-width: idx == root.selected-point ? 2px : 0px;
                    border-color: Theme.palette().ink;
                    x: 6px + (parent.width - 12px) * self.nx - self.width / 2;
                    y: 6px + (parent.height - 12px) * ((58 - 54 * self.ny) / 60) - self.height / 2;

                    if idx != root.selected-point : Rectangle {
                        x: 2px;
                        y: 2px;
                        width: 7px;
                        height: 7px;
                        border-radius: 4px;
                        background: Theme.palette().accent;
                    }
                }
            }

            if root.kind == "pie" : HorizontalLayout {
                x: 12px;
                y: 10px;
                width: parent.width - 24px;
                height: parent.height - 20px;
                spacing: Theme.tokens.space.md;

                pie-plot := Rectangle {
                    width: parent.height;
                    height: parent.height;
                    clip: true;

                    for idx in root.categories.length : Rectangle {
                        width: parent.width;
                        height: parent.height;

                        Path {
                            width: parent.width;
                            height: parent.height;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 100;
                            viewbox-height: 100;
                            fit: fill;
                            fill: Theme.palette().accent;
                            opacity: idx < root.pie-opacities.length ? root.pie-opacities[idx] : 1.0;
                            stroke: Theme.palette().surface;
                            stroke-width: 1px;
                            commands: idx < root.pie-commands.length ? root.pie-commands[idx] : "";
                        }

                        if idx == root.selected-point : Path {
                            width: parent.width;
                            height: parent.height;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: 100;
                            viewbox-height: 100;
                            fit: fill;
                            fill: transparent;
                            stroke: Theme.palette().ink;
                            stroke-width: 2px;
                            commands: idx < root.pie-commands.length ? root.pie-commands[idx] : "";
                        }
                    }
                }

                Flickable {
                    horizontal-stretch: 1;
                    height: parent.height;
                    viewport-height: pie-legend.preferred-height;

                    pie-legend := VerticalLayout {
                        spacing: 2px;

                        for idx in root.categories.length : HorizontalLayout {
                            spacing: 6px;
                            Rectangle {
                                y: 4px;
                                width: 8px;
                                height: 8px;
                                border-radius: 2px;
                                background: Theme.palette().accent;
                                opacity: idx < root.pie-opacities.length ? root.pie-opacities[idx] : 1.0;
                            }
                            Text {
                                text: (idx < root.categories.length ? root.categories[idx] : "") + " — " + (idx < root.values-display.length ? root.values-display[idx] : "");
                                font-size: Theme.tokens.typography.micro * root.text-scale;
                                color: Theme.palette().ink;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
            }

            if root.kind == "bar" : HorizontalLayout {
                x: 12px;
                y: 10px;
                width: parent.width - 24px;
                height: parent.height - 20px;
                spacing: Theme.tokens.space.md;

                for idx in root.categories.length : bar-column := Rectangle {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    preferred-width: 0px;
                    height: parent.height;
                    property <length> value-label-height: 18px * max(1.0, root.text-scale);
                    property <length> category-label-height: 20px * max(1.0, root.text-scale);
                    property <length> bar-area-height: max(1px, parent.height - self.value-label-height - self.category-label-height - 8px * max(1.0, root.text-scale));
                    property <float> signed-bar-height: idx < root.normalized.length ? root.normalized[idx] : 0.0;
                    property <float> bar-top-fraction: self.signed-bar-height >= 0.0
                        ? root.bar-baseline-fraction - self.signed-bar-height : root.bar-baseline-fraction;
                    property <float> bar-height-fraction: self.signed-bar-height >= 0.0
                        ? self.signed-bar-height : -self.signed-bar-height;
                    property <length> bar-origin-y: self.value-label-height + 4px * max(1.0, root.text-scale);
                    property <length> zero-axis-y: self.bar-origin-y + self.bar-area-height * root.bar-baseline-fraction;
                    property <length> bar-shape-y: self.bar-origin-y + self.bar-area-height * self.bar-top-fraction;
                    property <length> bar-shape-height: max(1px, self.bar-area-height * self.bar-height-fraction);

                    Rectangle {
                        x: 0px;
                        y: bar-column.zero-axis-y;
                        width: parent.width;
                        height: 1px;
                        background: Theme.palette().border-strong;
                    }

                    bar-shape := Rectangle {
                        x: parent.width * 0.18;
                        width: parent.width * 0.64;
                        y: bar-column.bar-shape-y;
                        height: bar-column.bar-shape-height;
                        background: Theme.palette().accent;
                        border-width: idx == root.selected-point ? 2px : 0px;
                        border-color: Theme.palette().ink;
                        border-radius: 3px;
                        drop-shadow-blur: 2px;
                        drop-shadow-color: Theme.palette().shadow;
                    }

                    bar-value-text := Text {
                        x: 0px;
                        width: parent.width;
                        height: bar-column.value-label-height;
                        y: max(0px, bar-column.bar-shape-y - self.height - 2px * max(1.0, root.text-scale));
                        text: idx < root.values-display.length ? root.values-display[idx] : "";
                        font-size: Theme.tokens.typography.micro * root.text-scale;
                        font-weight: 600;
                        color: Theme.palette().ink;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    bar-category-text := Text {
                        x: 0px;
                        width: parent.width;
                        height: bar-column.category-label-height;
                        y: parent.height - self.height;
                        text: root.categories[idx];
                        font-size: Theme.tokens.typography.micro * root.text-scale;
                        color: Theme.palette().ink-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }

        data-list := Rectangle {
            height: min(140px * max(1.0, root.text-scale), root.height * 0.45);
            background: Theme.palette().surface-sunken;
            border-width: 1px;
            border-color: Theme.palette().border-strong;
            border-radius: Theme.tokens.space.xs;
            accessible-role: list;
            accessible-label: root.title + " chart data";
            accessible-description: root.chart-summary();
            accessible-action-default => { root.focus-data(); }

            data-focus := FocusScope {
                width: parent.width;
                height: parent.height;
                focus-on-tab-navigation: true;
                changed has-focus => {
                    root.data-list-focused = data-focus.has-focus;
                    root.focus-changed(root.data-list-focused || root.category-focused);
                }
                key-pressed(event) => { return root.handle-data-key(event); }
            }

            if root.point-count > 0 : Rectangle {
                x: 8px;
                y: 8px;
                width: parent.width - 16px;
                height: parent.height - 16px;
                background: Theme.palette().selection-soft;
                border-width: 1px;
                border-color: Theme.palette().border-strong;
                border-radius: Theme.tokens.space.xs;
                accessible-role: list-item;
                accessible-label: root.point-label();
                accessible-description: root.point-detail();
                accessible-value: root.point-value();
                accessible-live-region: AccessibleLiveness.polite;

                VerticalLayout {
                    spacing: 1px * max(1.0, root.text-scale);
                    padding-left: 8px * max(1.0, root.text-scale);
                    padding-right: 8px * max(1.0, root.text-scale);
                    padding-top: 4px * max(1.0, root.text-scale);
                    padding-bottom: 4px * max(1.0, root.text-scale);
                    point-heading := Text {
                        text: "Point " + (root.selected-point + 1) + " of " + root.point-count;
                        font-size: Theme.tokens.typography.body-large * root.text-scale;
                        font-weight: 700;
                        color: Theme.palette().ink;
                        wrap: word-wrap;
                    }
                    category-viewport := Rectangle {
                        height: max(0px, min(
                            Theme.tokens.typography.body-large * root.text-scale * 3.0 + 12px * max(1.0, root.text-scale),
                            parent.height - point-heading.preferred-height
                                - point-help-text.preferred-height
                                - 10px * max(1.0, root.text-scale)
                        ));
                        clip: true;

                        category-scroll := Flickable {
                            // Keep the focus rings outside the scrolling text area so they do
                            // not strike through long point details when the text is focused.
                            x: 4px;
                            y: 4px;
                            width: parent.width - 8px;
                            height: parent.height - 8px;
                            viewport-width: parent.width;
                            viewport-height: max(parent.height, point-details-content.preferred-height);
                            viewport-y <=> root.category-scroll-y;
                            point-details-content := VerticalLayout {
                                width: parent.width;
                                height: self.preferred-height;
                                spacing: Theme.tokens.space.xs;
                                category-text := Text {
                                    text: root.point-label();
                                    width: parent.width;
                                    height: self.preferred-height;
                                    font-size: Theme.tokens.typography.body-large * root.text-scale;
                                    font-weight: 700;
                                    color: Theme.palette().ink;
                                    wrap: word-wrap;
                                }
                                point-value-text := Text {
                                    text: root.series-label + ": " + root.point-value() + " " + root.unit-label;
                                    width: parent.width;
                                    height: self.preferred-height;
                                    font-size: Theme.tokens.typography.caption * root.text-scale;
                                    color: Theme.palette().ink;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        category-focus := FocusScope {
                            width: parent.width;
                            height: parent.height;
                            focus-on-click: false;
                            focus-on-tab-navigation: point-details-content.preferred-height > category-scroll.height;
                            changed has-focus => {
                                root.category-focused = category-focus.has-focus;
                                root.focus-changed(root.data-list-focused || root.category-focused);
                            }
                            key-pressed(event) => {
                                if (event.text == Key.PageUp) {
                                    root.category-scroll-y = min(0px, root.category-scroll-y + category-scroll.height);
                                    return accept;
                                }
                                if (event.text == Key.PageDown) {
                                    root.category-scroll-y = max(category-scroll.height - category-scroll.viewport-height,
                                        root.category-scroll-y - category-scroll.height);
                                    return accept;
                                }
                                return root.handle-data-key(event);
                            }
                        }
                        if category-focus.has-focus : Rectangle {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            background: transparent;
                            border-width: 2px;
                            border-color: Theme.palette().ink;
                            border-radius: Theme.tokens.space.xs;
                        }
                        if category-focus.has-focus : Rectangle {
                            x: 4px;
                            y: 4px;
                            width: parent.width - 8px;
                            height: parent.height - 8px;
                            background: transparent;
                            border-width: 2px;
                            border-color: Theme.palette().focus;
                            border-radius: Theme.tokens.space.xs;
                        }
                    }
                    point-help-text := Text {
                        text: "Left/Right: points · Home/End: jump · Tab then PgUp/PgDn: scroll details · Escape: grid";
                        font-size: Theme.tokens.typography.caption * root.text-scale;
                        color: Theme.palette().ink-secondary;
                        wrap: word-wrap;
                    }
                }
            }

            if root.point-count == 0 : Text {
                x: 12px;
                y: 8px;
                width: parent.width - 24px;
                height: parent.height - 16px;
                text: "No chart data points";
                font-size: Theme.tokens.typography.body-large * root.text-scale;
                font-weight: 700;
                color: Theme.palette().ink;
                vertical-alignment: center;
            }

            if data-focus.has-focus : Rectangle {
                width: parent.width;
                height: parent.height;
                background: transparent;
                border-width: 2px;
                border-color: Theme.palette().ink;
                border-radius: Theme.tokens.space.xs;
            }
            if data-focus.has-focus : Rectangle {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                background: transparent;
                border-width: 2px;
                border-color: Theme.palette().focus;
                border-radius: Theme.tokens.space.xs;
            }

        }
    }

    // Direct manipulation corner handle
    LoomCanvasHandle {
        x: parent.width - 10px;
        y: parent.height - 10px;
        label: "Chart resize handle";
    }
}

export component SheetChartOverlay inherits Rectangle {
    in-out property <bool> chart-visible: true;
    in property <string> title: "Chart";
    in property <string> source-range: "";
    in property <string> series-label: "Values";
    in property <string> unit-label: "Not specified";
    in property <string> kind: "bar";
    in property <float> text-scale: 1.0;
    in property <string> context-key: "";
    in property <bool> focus-request: false;
    in property <[string]> categories: [];
    in property <[string]> values-display: [];
    in property <[float]> normalized: [];
    in property <float> bar-baseline-fraction: 1.0;
    in property <string> line-commands: "";
    in property <[string]> pie-commands: [];
    in property <[float]> pie-opacities: [];
    callback close-chart;
    callback cycle-kind;
    callback focus-changed(bool);
    callback leave-data;

    background: transparent;

    if root.chart-visible : sheet-chart := SheetChart {
        x: max(12px, min(parent.width - 442px, 120px));
        y: max(12px, min(parent.height - sheet-chart.height - 12px, 180px));
        title: root.title;
        source-range: root.source-range;
        series-label: root.series-label;
        unit-label: root.unit-label;
        kind: root.kind;
        text-scale: root.text-scale;
        available-height: parent.height;
        context-key: root.context-key;
        focus-request: root.focus-request;
        categories: root.categories;
        values-display: root.values-display;
        normalized: root.normalized;
        bar-baseline-fraction: root.bar-baseline-fraction;
        line-commands: root.line-commands;
        pie-commands: root.pie-commands;
        pie-opacities: root.pie-opacities;
        close-chart => { root.chart-visible = false; root.close-chart(); }
        cycle-kind => { root.cycle-kind(); }
        focus-changed(focused) => { root.focus-changed(focused); }
        leave-data => { root.leave-data(); }
    }
}
