import {
    LoomCanvasHandle, LoomIconButton, LoomButton
} from "foundation.slint";
import { Theme } from "theme.slint";

export component SheetChart inherits Rectangle {
    in property <string> title: "Chart";
    in property <string> kind: "bar";
    in property <[string]> categories: ["Development", "Design", "QA & Testing", "Total"];
    in property <[string]> values-display: ["$15,000", "$8,000", "$5,000", "$28,000"];
    in property <[float]> normalized: [0.54, 0.29, 0.18, 1.0];
    in property <string> line-commands: "";
    in property <[string]> pie-commands: [];
    in property <[float]> pie-opacities: [];
    callback close-chart;
    callback cycle-kind;

    function kind-label() -> string {
        if (root.kind == "line") {
            return "Line";
        }
        if (root.kind == "pie") {
            return "Pie";
        }
        return "Bar";
    }

    width: 380px;
    height: 240px;
    background: Theme.palette().surface;
    border-width: 1px;
    border-color: Theme.palette().border;
    border-radius: Theme.tokens.space.sm;
    drop-shadow-blur: 8px;
    drop-shadow-color: Theme.palette().shadow;

    VerticalLayout {
        padding: Theme.tokens.space.md;
        spacing: Theme.tokens.space.sm;

        // Chart Header
        HorizontalLayout {
            spacing: Theme.tokens.space.sm;
            cross-axis-alignment: center;

            Text {
                text: root.title;
                font-size: Theme.tokens.typography.body-large;
                font-weight: 700;
                color: Theme.palette().ink;
                horizontal-stretch: 1;
                overflow: elide;
            }

            LoomButton {
                variant: "ghost";
                label: root.kind-label();
                clicked => {
                    root.cycle-kind();
                }
            }

            LoomIconButton {
                icon: "close";
                tooltip: "Dismiss chart";
                clicked => { root.close-chart(); }
            }
        }

        // Plot Area
        Rectangle {
            vertical-stretch: 1;
            background: Theme.palette().surface-sunken;
            border-width: 1px;
            border-color: Theme.palette().border;
            border-radius: Theme.tokens.space.xs;
            clip: true;

            // Horizontal gridlines
            Rectangle {
                x: 0px;
                y: parent.height * 0.25;
                width: parent.width;
                height: 1px;
                background: Theme.palette().border;
            }
            Rectangle {
                x: 0px;
                y: parent.height * 0.50;
                width: parent.width;
                height: 1px;
                background: Theme.palette().border;
            }
            Rectangle {
                x: 0px;
                y: parent.height * 0.75;
                width: parent.width;
                height: 1px;
                background: Theme.palette().border;
            }

            // Series Data: bars, line, or pie depending on the live kind.
            if root.kind == "line" : Rectangle {
                x: 12px;
                y: 10px;
                width: parent.width - 24px;
                height: parent.height - 20px;
                clip: true;

                Path {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    stroke: Theme.palette().accent;
                    stroke-width: 2px;
                    fill: transparent;
                    commands: root.line-commands;
                }

                for idx in root.categories.length : Rectangle {
                    property <float> nx: root.categories.length > 1 ? idx / (root.categories.length - 1) : 0.5;
                    property <float> ny: idx < root.normalized.length ? root.normalized[idx] : 0.0;
                    width: 7px;
                    height: 7px;
                    border-radius: 4px;
                    background: Theme.palette().accent;
                    x: parent.width * self.nx - 3px;
                    y: parent.height - 6px - self.ny * (parent.height - 12px) - 3px;
                }
            }

            if root.kind == "pie" : HorizontalLayout {
                x: 12px;
                y: 10px;
                width: parent.width - 24px;
                height: parent.height - 20px;
                spacing: Theme.tokens.space.md;

                Rectangle {
                    width: parent.height;
                    height: parent.height;
                    clip: true;

                    for idx in root.categories.length : Path {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        fill: Theme.palette().accent;
                        opacity: idx < root.pie-opacities.length ? root.pie-opacities[idx] : 1.0;
                        stroke: Theme.palette().surface;
                        stroke-width: 1px;
                        commands: idx < root.pie-commands.length ? root.pie-commands[idx] : "";
                    }
                }

                Flickable {
                    horizontal-stretch: 1;
                    height: parent.height;
                    viewport-height: pie-legend.preferred-height;

                    pie-legend := VerticalLayout {
                        spacing: 2px;

                        for idx in root.categories.length : HorizontalLayout {
                            spacing: 6px;
                            Rectangle {
                                y: 4px;
                                width: 8px;
                                height: 8px;
                                border-radius: 2px;
                                background: Theme.palette().accent;
                                opacity: idx < root.pie-opacities.length ? root.pie-opacities[idx] : 1.0;
                            }
                            Text {
                                text: (idx < root.categories.length ? root.categories[idx] : "") + " — " + (idx < root.values-display.length ? root.values-display[idx] : "");
                                font-size: Theme.tokens.typography.micro;
                                color: Theme.palette().ink;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
            }

            if root.kind != "line" && root.kind != "pie" : HorizontalLayout {
                x: 12px;
                y: 10px;
                width: parent.width - 24px;
                height: parent.height - 20px;
                spacing: Theme.tokens.space.md;

                for idx in root.categories.length : Rectangle {
                    horizontal-stretch: 1;
                    height: parent.height;

                    VerticalLayout {
                        spacing: 4px;
                        alignment: end;

                        // Value label above bar
                        Text {
                            text: idx < root.values-display.length ? root.values-display[idx] : "";
                            font-size: Theme.tokens.typography.micro;
                            font-weight: 600;
                            color: Theme.palette().ink;
                            horizontal-alignment: center;
                            overflow: elide;
                        }

                        // The Bar
                        Rectangle {
                            height: max(6px, (parent.height - 36px) * (idx < root.normalized.length ? root.normalized[idx] : 0.1));
                            background: Theme.palette().accent;
                            border-radius: 3px;
                            drop-shadow-blur: 2px;
                            drop-shadow-color: Theme.palette().shadow;
                        }

                        // Category label below bar
                        Text {
                            text: root.categories[idx];
                            font-size: Theme.tokens.typography.micro;
                            color: Theme.palette().ink-secondary;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }
    }

    // Direct manipulation corner handle
    LoomCanvasHandle {
        x: parent.width - 10px;
        y: parent.height - 10px;
        label: "Chart resize handle";
    }
}
