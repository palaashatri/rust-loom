import { LoomButton, LoomSearchField } from "foundation.slint";
import { Icon } from "icons.slint";
import { Theme } from "theme.slint";

export struct StartHubRecentItem {
    name: string,
    path: string,
    subtitle: string,
    kind: string,
}

export global StartHubState {
    in-out property <bool> open: false;
    in-out property <int> sidebar-tab: 0;
    in-out property <string> search-query: "";
    in-out property <[StartHubRecentItem]> recents: [];
    in-out property <int> selected-index: 0;
    in-out property <bool> focus-request: false;

    callback open-recent(string);
    callback open-file();
    callback new-document();
    callback close-hub();
    callback search-edited(string);
    callback tab-changed(int);
}

component StartHubSidebarItem inherits Rectangle {
    in property <string> label: "";
    in property <bool> active: false;
    callback clicked();

    height: 34px;
    border-radius: Theme.tokens.metrics.radius-medium;
    background: root.active
        ? Theme.palette().accent.with-alpha(0.14)
        : (item-touch.has-hover ? Theme.palette().surface-sunken : transparent);

    HorizontalLayout {
        padding-left: Theme.tokens.space.md;
        padding-right: Theme.tokens.space.md;
        alignment: start;

        Text {
            text: root.label;
            font-size: Theme.type.body;
            font-weight: root.active ? 700 : 500;
            color: root.active ? Theme.palette().accent : Theme.palette().ink;
            vertical-alignment: center;
        }
    }

    item-touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component StartHubModal inherits Rectangle {
    in property <bool> focus-request: StartHubState.focus-request;
    background: Theme.palette().scrim;
    accessible-role: groupbox;
    accessible-label: "Loom Sheets Start Hub";

    init => {
        hub-focus.focus();
    }

    public function focus-start-hub() {
        hub-focus.focus();
    }

    changed focus-request => {
        if (StartHubState.open) {
            hub-focus.focus();
        }
    }

    TouchArea {
        clicked => { StartHubState.close-hub(); }
    }

    hub-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                StartHubState.close-hub();
                return accept;
            }
            if (event.text == Key.DownArrow && StartHubState.recents.length > 0) {
                StartHubState.selected-index = min(StartHubState.recents.length - 1, StartHubState.selected-index + 1);
                return accept;
            }
            if (event.text == Key.UpArrow && StartHubState.recents.length > 0) {
                StartHubState.selected-index = max(0, StartHubState.selected-index - 1);
                return accept;
            }
            if (event.text == Key.Return) {
                if (StartHubState.selected-index >= 0 && StartHubState.selected-index < StartHubState.recents.length) {
                    StartHubState.open-recent(StartHubState.recents[StartHubState.selected-index].path);
                } else {
                    StartHubState.new-document();
                }
                return accept;
            }
            return reject;
        }

        Rectangle {
            width: min(880px, max(480px, root.width - 64px));
            height: min(560px, max(360px, root.height - 64px));
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            border-radius: Theme.tokens.metrics.radius-large;
            background: Theme.palette().surface;
            border-width: 1px;
            border-color: Theme.palette().border;
            clip: true;

            TouchArea { }

            HorizontalLayout {
                // Loom Sheets left sidebar
                Rectangle {
                    width: 210px;
                    background: Theme.palette().surface;
                    border-width: 0px;

                    Rectangle {
                        x: parent.width - 1px;
                        width: 1px;
                        height: parent.height;
                        background: Theme.palette().border;
                    }

                    VerticalLayout {
                        padding: Theme.tokens.space.lg;
                        spacing: Theme.tokens.space.sm;

                        Text {
                            text: "Loom Sheets";
                            font-size: Theme.type.title;
                            font-weight: 700;
                            color: Theme.palette().ink;
                        }
                        Text {
                            text: "Workbooks";
                            font-size: Theme.type.caption;
                            color: Theme.palette().ink-secondary;
                        }

                        Rectangle { height: Theme.tokens.space.md; }

                        StartHubSidebarItem {
                            label: "Recents";
                            active: StartHubState.sidebar-tab == 0;
                            clicked => {
                                StartHubState.sidebar-tab = 0;
                                StartHubState.tab-changed(0);
                            }
                        }
                        StartHubSidebarItem {
                            label: "Workbooks on Disk";
                            active: StartHubState.sidebar-tab == 1;
                            clicked => {
                                StartHubState.sidebar-tab = 1;
                                StartHubState.tab-changed(1);
                            }
                        }

                        Rectangle { vertical-stretch: 1; }

                        LoomButton {
                            label: "Open File…";
                            variant: "secondary";
                            clicked => { StartHubState.open-file(); }
                        }
                    }
                }

                // Right browser + footer
                VerticalLayout {
                    horizontal-stretch: 1;
                    padding: Theme.tokens.space.xl;
                    spacing: Theme.tokens.space.md;

                    HorizontalLayout {
                        spacing: Theme.tokens.space.md;
                        alignment: space-between;

                        Text {
                            text: StartHubState.sidebar-tab == 0 ? "Recent Workbooks" : "Workbooks on Disk";
                            font-size: Theme.type.title;
                            font-weight: 700;
                            color: Theme.palette().ink;
                            vertical-alignment: center;
                        }

                        HorizontalLayout {
                            spacing: Theme.tokens.space.sm;
                            LoomSearchField {
                                width: 220px;
                                placeholder: "Filter workbooks…";
                                value <=> StartHubState.search-query;
                                edited(text) => { StartHubState.search-edited(text); }
                            }
                            LoomButton {
                                label: "Close";
                                variant: "ghost";
                                clicked => { StartHubState.close-hub(); }
                            }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        border-radius: Theme.tokens.metrics.radius-medium;
                        background: Theme.palette().surface-sunken;
                        border-width: 1px;
                        border-color: Theme.palette().border;
                        clip: true;

                        if StartHubState.recents.length == 0 : VerticalLayout {
                            alignment: center;
                            padding: Theme.tokens.space.xl;
                            spacing: Theme.tokens.space.sm;

                            Text {
                                text: StartHubState.search-query == ""
                                    ? "No recent workbooks yet."
                                    : "No workbooks match \"" + StartHubState.search-query + "\".";
                                font-size: Theme.type.body;
                                font-weight: 600;
                                color: Theme.palette().ink;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Choose New Document to browse templates, or Open File… to open an existing workbook.";
                                font-size: Theme.type.caption;
                                color: Theme.palette().ink-secondary;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }

                        if StartHubState.recents.length > 0 : Flickable {
                            width: 100%;
                            height: 100%;
                            viewport-width: self.width;
                            viewport-height: recents-list.preferred-height;

                            recents-list := VerticalLayout {
                                width: parent.width;
                                padding: Theme.tokens.space.sm;
                                spacing: 4px;

                                for item[idx] in StartHubState.recents : Rectangle {
                                    height: 54px;
                                    border-radius: Theme.tokens.metrics.radius-medium;
                                    background: idx == StartHubState.selected-index
                                        ? Theme.palette().accent.with-alpha(0.12)
                                        : (row-touch.has-hover ? Theme.palette().surface : transparent);
                                    border-width: idx == StartHubState.selected-index ? 1px : 0px;
                                    border-color: Theme.palette().accent;

                                    row-touch := TouchArea {
                                        clicked => { StartHubState.selected-index = idx; }
                                        double-clicked => { StartHubState.open-recent(item.path); }
                                    }

                                    HorizontalLayout {
                                        padding-left: Theme.tokens.space.md;
                                        padding-right: Theme.tokens.space.md;
                                        spacing: Theme.tokens.space.md;
                                        alignment: space-between;

                                        HorizontalLayout {
                                            spacing: Theme.tokens.space.md;
                                            horizontal-stretch: 1;

                                            Rectangle {
                                                width: 34px;
                                                height: 34px;
                                                y: (parent.height - self.height) / 2;
                                                border-radius: Theme.tokens.metrics.radius-small;
                                                background: Theme.palette().accent.with-alpha(0.15);

                                                Text {
                                                    text: item.kind;
                                                    font-size: Theme.type.caption;
                                                    font-weight: 700;
                                                    color: Theme.palette().accent;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                horizontal-stretch: 1;
                                                spacing: 2px;

                                                Text {
                                                    text: item.name;
                                                    font-size: Theme.type.body;
                                                    font-weight: 600;
                                                    color: Theme.palette().ink;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: item.path;
                                                    font-size: Theme.type.caption;
                                                    color: Theme.palette().ink-secondary;
                                                    overflow: elide;
                                                }
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: Theme.tokens.space.md;

                                            Text {
                                                text: item.subtitle;
                                                font-size: Theme.type.caption;
                                                color: Theme.palette().ink-secondary;
                                                vertical-alignment: center;
                                            }
                                            LoomButton {
                                                label: "Open";
                                                variant: "secondary";
                                                y: (parent.height - self.height) / 2;
                                                clicked => { StartHubState.open-recent(item.path); }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: Theme.tokens.space.sm;
                            LoomButton {
                                label: "Blank Workbook";
                                variant: "ghost";
                                clicked => { StartHubState.close-hub(); }
                            }
                        }

                        LoomButton {
                            label: "New Document";
                            variant: "primary";
                            clicked => { StartHubState.new-document(); }
                        }
                    }
                }
            }
        }
    }
}
