import { LoomButton } from "foundation.slint";
import { Theme } from "theme.slint";

export component XlsxImportWarningDialog inherits Rectangle {
    in property <bool> open: false;
    in property <string> warning-message: "";
    in property <bool> save-changes-open: false;
    in property <bool> template-chooser-open: false;

    callback clear-sibling-overlays;
    callback focus-save-changes;
    callback focus-template-chooser;
    callback focus-app;
    callback focus-grid;
    callback import-cancel;
    callback import-continue;

    visible: root.open;

    // Cancel is the safe default: Enter on a freshly opened warning keeps the
    // current workbook.
    public function focus-dialog() {
        cancel-button.grab-focus();
    }

    changed open => {
        if (root.open) {
            root.clear-sibling-overlays();
            cancel-button.grab-focus();
        } else if (root.save-changes-open) {
            root.focus-save-changes();
        } else if (root.template-chooser-open) {
            root.focus-template-chooser();
        } else {
            root.focus-app();
        }
    }

    changed template-chooser-open => {
        if (root.template-chooser-open) {
            if (root.open) {
                cancel-button.grab-focus();
            } else {
                root.focus-template-chooser();
            }
        } else if (root.save-changes-open) {
            root.focus-save-changes();
        } else if (root.open) {
            cancel-button.grab-focus();
        } else {
            root.focus-grid();
        }
    }

    warning-focus := FocusScope {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        enabled: root.open;
        visible: root.open;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.import-cancel();
                return accept;
            }
            // Tab cycles the two buttons and never leaves the dialog.
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                if (cancel-button.has-focus) { continue-button.grab-focus(); } else { cancel-button.grab-focus(); }
                return accept;
            }
            return reject;
        }

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: Theme.palette().scrim;
            accessible-role: groupbox;
            accessible-label: "Excel import warning";

            TouchArea { clicked => { warning-focus.focus(); } }

            dialog-surface := Rectangle {
                x: (root.width - min(560px, root.width - 32px)) / 2;
                y: (root.height - dialog-surface.height) / 2;
                width: min(560px, root.width - 32px);
                height: min(dialog-layout.preferred-height, root.height - 32px);
                border-radius: Theme.tokens.metrics.radius-large;
                border-width: 1px;
                border-color: Theme.palette().border;
                background: Theme.palette().surface;
                drop-shadow-blur: 18px;
                drop-shadow-offset-y: 6px;
                drop-shadow-color: Theme.palette().shadow;

                dialog-layout := VerticalLayout {
                    spacing: Theme.tokens.space.md;
                    padding: Theme.tokens.space.xl;
                    alignment: start;

                    dialog-title := Text {
                        text: "This Excel file has features Loom cannot keep";
                        font-size: Theme.type.heading;
                        font-weight: 700;
                        color: Theme.palette().ink;
                        horizontal-alignment: Theme.rtl ? right : left;
                        wrap: word-wrap;
                    }

                    warning-scroll := Flickable {
                        width: parent.width;
                        height: min(warning-copy.preferred-height,
                            max(72px, root.height - dialog-title.preferred-height
                                - Theme.tokens.metrics.control-height - 82px));
                        viewport-width: parent.width;
                        viewport-height: max(warning-scroll.height, warning-copy.preferred-height);

                        warning-copy := Text {
                            width: parent.width;
                            text: root.warning-message;
                            font-size: Theme.type.body;
                            color: Theme.palette().ink-secondary;
                            horizontal-alignment: Theme.rtl ? right : left;
                            wrap: word-wrap;
                        }
                    }

                    // The destructive choice sits at the reading end: right in LTR,
                    // left in RTL; the safe default is beside it.
                    action-row := Rectangle {
                        height: Theme.tokens.metrics.control-height;
                        continue-button := LoomButton {
                            label: "Import with feature loss";
                            variant: "danger";
                            width: self.preferred-width;
                            height: Theme.tokens.metrics.control-height;
                            x: Theme.rtl ? 0px : max(0px, parent.width - self.width);
                            clicked => { root.import-continue(); }
                        }
                        cancel-button := LoomButton {
                            label: "Cancel import";
                            variant: "secondary";
                            width: self.preferred-width;
                            height: Theme.tokens.metrics.control-height;
                            x: Theme.rtl ? continue-button.width + Theme.tokens.space.sm : max(0px, continue-button.x - Theme.tokens.space.sm - self.width);
                            clicked => { root.import-cancel(); }
                        }
                    }
                }
            }
        }
    }
}
