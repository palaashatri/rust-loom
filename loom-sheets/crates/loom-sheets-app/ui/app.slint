import {
    DocumentChrome, Toolbar, ToolbarGroup, ToolbarSpacer, ToolbarButton,
    ToolbarIconButton, ToolkitStatusBar, TextField, TabStrip
} from "toolkit.slint";
import { CommandPalette, CommandPaletteItem } from "components.slint";
import { Theme } from "theme.slint";
export { Theme } from "theme.slint";

export component SheetsApp inherits Window {
    title: "Loom Sheets";
    min-width: 1024px;
    min-height: 720px;
    background: Theme.palette().canvas;
    // Breakpoints are supplied by the host after it chooses the window size.
    // Deriving them from root.width makes optional toolbar children feed back
    // into the window's implicit width and creates a Slint binding loop.
    in property <bool> show-quick-formulas: false;
    in property <bool> labeled-export: false;
    callback window-resized(length);
    changed width => { root.window-resized(root.width); }

    in property <string> sheet-name: "Untitled";
    in property <string> status-left: "";
    in property <string> status-right: "";
    in property <[int]> rows: [];
    in property <[int]> cols: [];
    in property <[string]> column-headers: [];
    in property <[string]> row-headers: [];
    in property <[string]> cells: [];
    in property <string> selected-cell: "A1";
    in property <int> selected-row: 0;
    in property <int> selected-col: 0;
    in property <string> selection-formula: "";
    property <string> formula-edit-buffer: "";
    in property <string> selection-value: "";
    in-out property <string> formula-feedback: "Ready";

    callback new-sheet;
    callback open-sheet;
    callback save-sheet;
    callback save-as-sheet;
    callback export-csv;
    callback undo;
    callback redo;
    callback cell-clicked(int, int);
    callback commit-selected-cell(string);
    callback cancel-selected-cell;
    callback quick-formula(string);

    in-out property <[CommandPaletteItem]> palette-commands: [];
    in-out property <bool> palette-open: false;
    in-out property <string> palette-query: "";
    in-out property <int> palette-selected: 0;
    callback palette-invoked(int);
    callback palette-query-changed(string);
    callback palette-move(int);
    callback palette-key-text(string);
    callback palette-backspace;
    callback palette-close;

    public function open-palette() {
        root.palette-open = true;
        root.palette-query = "";
        palette.grab-focus();
    }

    public function reset-formula-edit-buffer() {
        formula-edit-buffer = selection-formula;
    }

    app-focus := FocusScope {
        key-pressed(event) => {
            if (root.palette-open) { return reject; }
            if (event.modifiers.control || event.modifiers.meta) {
                if (event.text == Key.K || event.text == "k") {
                    root.open-palette();
                    return accept;
                }
                if (event.text == "n" || event.text == "N") {
                    root.new-sheet();
                    return accept;
                }
                if (event.text == "o" || event.text == "O") {
                    root.open-sheet();
                    return accept;
                }
                if (event.text == "s" || event.text == "S") {
                    if (event.modifiers.shift) { root.save-as-sheet(); } else { root.save-sheet(); }
                    return accept;
                }
                if (event.text == "e" || event.text == "E") {
                    root.export-csv();
                    return accept;
                }
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0px;
            padding: 0px;

            DocumentChrome { title: root.sheet-name; }

            Toolbar {
                ToolbarGroup {
                    ToolbarIconButton { icon: "new"; label: "New sheet"; clicked => { root.new-sheet(); } }
                    ToolbarIconButton { icon: "open"; label: "Open workbook"; clicked => { root.open-sheet(); } }
                    ToolbarIconButton { icon: "save"; label: "Save"; clicked => { root.save-sheet(); } }
                    ToolbarIconButton { icon: "save-as"; label: "Save workbook as"; clicked => { root.save-as-sheet(); } }
                    ToolbarIconButton { icon: "undo"; label: "Undo"; clicked => { root.undo(); } }
                    ToolbarIconButton { icon: "redo"; label: "Redo"; clicked => { root.redo(); } }
                }

                if root.show-quick-formulas : ToolbarGroup {
                    leading-separation: true;
                    ToolbarButton { label: "SUM"; clicked => { root.quick-formula("SUM"); } }
                    ToolbarButton { label: "AVERAGE"; clicked => { root.quick-formula("AVERAGE"); } }
                    ToolbarButton { label: "COUNT"; clicked => { root.quick-formula("COUNT"); } }
                    ToolbarButton { label: "MIN"; clicked => { root.quick-formula("MIN"); } }
                    ToolbarButton { label: "MAX"; clicked => { root.quick-formula("MAX"); } }
                }

                ToolbarSpacer { }

                ToolbarGroup {
                    Text {
                        text: root.selected-cell + (root.selection-value == "" ? "" : "  " + root.selection-value);
                        max-width: 220px;
                        font-size: Theme.tokens.typography.caption;
                        font-weight: 500;
                        color: Theme.palette().ink-secondary;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    if root.labeled-export : ToolbarButton {
                        // The final toolbar group can inherit all remaining
                        // width; keep Export CSV sized to its content instead of
                        // turning it into a full-width banner.
                        width: 124px;
                        icon: "export";
                        label: "Export CSV";
                        primary: true;
                        clicked => { root.export-csv(); }
                    }
                    if !root.labeled-export : ToolbarIconButton {
                        icon: "export";
                        label: "Export CSV";
                        clicked => { root.export-csv(); }
                    }
                }
            }

            Rectangle {
                min-height: 32px;
                max-height: 32px;
                background: Theme.palette().chrome;

                HorizontalLayout {
                    spacing: 6px;
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 2px;
                    padding-bottom: 2px;
                    cross-axis-alignment: center;

                    Rectangle {
                        width: 56px;
                        height: Theme.tokens.metrics.control-height;
                        border-radius: Theme.tokens.metrics.radius-medium;
                        border-width: 1px;
                        border-color: Theme.palette().border;
                        background: Theme.palette().surface-sunken;
                        Text {
                            text: root.selected-cell;
                            font-weight: 600;
                            font-size: Theme.tokens.typography.body;
                            color: Theme.palette().ink;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "fx";
                        width: 24px;
                        font-size: Theme.tokens.typography.body;
                        font-weight: 600;
                        color: Theme.palette().ink-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TextField {
                        label: "Selected cell formula or value";
                        placeholder: "Enter a value or formula";
                        value <=> root.formula-edit-buffer;
                        horizontal-stretch: 1;
                        accepted(text) => { root.commit-selected-cell(text); }
                        cancelled => {
                            root.formula-edit-buffer = root.selection-formula;
                            root.cancel-selected-cell();
                        }
                    }

                    ToolbarIconButton {
                        icon: "check";
                        label: "Commit formula";
                        clicked => { root.commit-selected-cell(root.formula-edit-buffer); }
                    }
                    ToolbarIconButton {
                        icon: "close";
                        label: "Cancel editing";
                        clicked => {
                            root.formula-edit-buffer = root.selection-formula;
                            root.cancel-selected-cell();
                        }
                    }
                }

                Rectangle {
                    x: 0px;
                    y: parent.height - 1px;
                    width: parent.width;
                    height: 1px;
                    background: Theme.palette().border;
                }
            }

            Rectangle {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                background: Theme.palette().surface;
                clip: true;

                GridLayout {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    spacing: 0px;

                    Row {
                        Rectangle {
                            width: 44px;
                            min-height: 30px;
                            max-height: 30px;
                            background: Theme.palette().chrome;
                            border-width: 1px;
                            border-color: Theme.palette().border;
                        }
                        for c in root.cols : Rectangle {
                            min-width: 96px;
                            horizontal-stretch: 1;
                            min-height: 30px;
                            max-height: 30px;
                            background: c == root.selected-col ? Theme.palette().selection-soft : Theme.palette().chrome;
                            border-width: 1px;
                            border-color: c == root.selected-col ? Theme.palette().accent : Theme.palette().border;
                            Text {
                                text: root.column-headers[c];
                                font-size: Theme.tokens.typography.caption;
                                font-weight: c == root.selected-col ? 600 : 500;
                                color: c == root.selected-col ? Theme.palette().accent : Theme.palette().ink-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    for r in root.rows : Row {
                        Rectangle {
                            width: 44px;
                            min-height: 32px;
                            max-height: 32px;
                            background: r == root.selected-row ? Theme.palette().selection-soft : Theme.palette().chrome;
                            border-width: 1px;
                            border-color: r == root.selected-row ? Theme.palette().accent : Theme.palette().border;
                            Text {
                                text: root.row-headers[r];
                                font-size: Theme.tokens.typography.caption;
                                font-weight: r == root.selected-row ? 600 : 500;
                                color: r == root.selected-row ? Theme.palette().accent : Theme.palette().ink-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        for c in root.cols : Rectangle {
                            min-width: 96px;
                            horizontal-stretch: 1;
                            min-height: 32px;
                            max-height: 32px;
                            border-width: r == root.selected-row && c == root.selected-col ? 2px : 1px;
                            border-color: r == root.selected-row && c == root.selected-col ? Theme.palette().accent : Theme.palette().grid-minor;
                            background: r == root.selected-row && c == root.selected-col
                                ? Theme.palette().selection-soft
                                : cell-touch.has-hover ? Theme.palette().surface-raised : Theme.palette().surface;

                            Text {
                                x: 8px;
                                width: parent.width - 16px;
                                text: root.cells[r * root.cols.length + c];
                                font-size: Theme.tokens.typography.body;
                                font-weight: r == root.selected-row && c == root.selected-col ? 600 : 400;
                                color: Theme.palette().ink;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            cell-touch := TouchArea { clicked => { root.cell-clicked(r, c); } }
                            accessible-role: button;
                            accessible-label: "Cell " + root.column-headers[c] + root.row-headers[r]
                                + ", " + root.cells[r * root.cols.length + c];
                        }
                    }
                }
            }

            TabStrip {
                horizontal-stretch: 1;
                tabs: [root.sheet-name];
                current: 0;
            }

            ToolkitStatusBar {
                leading: root.status-left + (root.formula-feedback == "" ? "" : "  •  " + root.formula-feedback);
                trailing: root.status-right;
            }
        }

        palette := CommandPalette {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            open: root.palette-open;
            commands: root.palette-commands;
            query: root.palette-query;
            selected: root.palette-selected;
            command-invoked(idx) => { root.palette-invoked(idx); }
            query-changed(q) => {
                root.palette-query = q;
                root.palette-query-changed(q);
            }
            move-selection(delta) => { root.palette-move(delta); }
            key-text(text) => { root.palette-key-text(text); }
            backspace => { root.palette-backspace(); }
            close-requested => {
                root.palette-open = false;
                app-focus.focus();
            }
        }
    }
}
