// Loom Sheets application window: shared components + inline chrome
// (a Window component cannot be nested), with a virtualized-style grid
// driven by engine-evaluated cell models.

import { ToolButton, IconButton, StatusBar, SegmentedControl } from "components.slint";
import { Icon } from "icons.slint";
import { Theme } from "theme.slint";
export { Theme } from "theme.slint";

component FormulaBarField inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> value: "";
    callback committed(string);
    callback cancelled;
    height: 28px;
    min-width: 140px;
    border-radius: 6px;
    border-width: 1px;
    border-color: text-input.has-focus ? Theme.palette().focus : Theme.palette().border-strong;
    background: Theme.palette().surface;

    text-input := TextInput {
        x: 8px;
        width: parent.width - 16px;
        single-line: true;
        vertical-alignment: center;
        font-size: Theme.tokens.typography.body;
        color: Theme.palette().ink;
        text <=> root.value;
        accepted => { root.committed(text-input.text); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancelled();
                return accept;
            }
            return reject;
        }
    }
    if root.value == "" : Text {
        x: 8px;
        width: parent.width - 16px;
        vertical-alignment: center;
        font-size: Theme.tokens.typography.body;
        color: Theme.palette().ink-disabled;
        text: root.placeholder;
    }

    accessible-role: AccessibleRole.text-input;
    accessible-label: root.label;
}

export component SheetsApp inherits Window {
    title: "Loom Sheets";
    in property <string> sheet-name: "Untitled";
    in property <string> status-left: "";
    in property <string> status-right: "";
    in property <[int]> rows: [];
    in property <[int]> cols: [];
    in property <[string]> column-headers: [];
    in property <[string]> row-headers: [];
    in property <[string]> cells: [];
    in property <string> selected-cell: "A1";
    in property <string> selection-formula: "";
    property <string> formula-edit-buffer: "";
    in property <string> selection-value: "";

    // Sheets, Cell Format, and Formula Feedback state
    in-out property <[string]> sheets: ["Sheet 1"];
    in-out property <int> active-sheet-index: 0;
    in-out property <int> cell-format-index: 0; // 0: General, 1: Number, 2: Currency, 3: %
    in-out property <string> formula-feedback: "Ready";

    callback new-sheet;
    callback open-sheet;
    callback save-sheet;
    callback export-csv;
    callback undo;
    callback redo;
    callback cell-clicked(int, int);
    callback commit-selected-cell(string);
    callback cancel-selected-cell;

    // Quick formula actions, sheet tab navigation, cell formatting
    callback quick-formula(string);
    callback select-sheet(int);
    callback add-new-sheet;
    callback set-cell-format(int);

    public function reset-formula-edit-buffer() {
        formula-edit-buffer = selection-formula;
    }

    background: Theme.palette().canvas;

    VerticalLayout {
        spacing: 0px;
        padding: 0px;

        Rectangle {
            min-height: 40px;
            max-height: 40px;
            background: Theme.palette().surface;

            VerticalLayout {
                spacing: 0px;
                padding: 0px;

                HorizontalLayout {
                    spacing: 8px;
                    padding-left: 6px;
                    padding-right: 12px;
                    Icon {
                        icon: "grid";
                        size: 18px;
                        tint: Theme.palette().accent;
                        y: (parent.height - 18px) / 2;
                    }
                    Text {
                        text: "Loom Sheets";
                        font-size: Theme.tokens.typography.title;
                        font-weight: 700;
                        color: Theme.palette().ink;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; background: transparent; }
                    Text {
                        text: root.sheet-name;
                        font-size: Theme.tokens.typography.caption;
                        color: Theme.palette().ink-secondary;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 1px;
                    background: Theme.palette().border;
                }
            }
        }

        // Action Toolbar with Quick Formula Actions and Cell Format Selector
        Rectangle {
            min-height: 40px;
            max-height: 40px;
            background: Theme.palette().surface-sunken;

            HorizontalLayout {
                height: parent.height;
                cross-axis-alignment: center;
                spacing: 6px;
                padding-left: 8px;
                padding-right: 8px;

                ToolButton { icon: "new"; text: "New"; clicked => { root.new-sheet(); } }
                ToolButton { icon: "open"; text: "Open"; clicked => { root.open-sheet(); } }
                ToolButton { icon: "save"; text: "Save"; clicked => { root.save-sheet(); } }
                ToolButton { icon: "undo"; clicked => { root.undo(); } }
                ToolButton { icon: "redo"; clicked => { root.redo(); } }

                Rectangle { width: 1px; height: 18px; background: Theme.palette().border; }

                Text {
                    text: "Fx:";
                    font-size: Theme.tokens.typography.caption;
                    font-weight: 700;
                    color: Theme.palette().accent;
                    vertical-alignment: center;
                }
                ToolButton { text: "SUM"; clicked => { root.quick-formula("SUM"); } }
                ToolButton { text: "AVG"; clicked => { root.quick-formula("AVERAGE"); } }
                ToolButton { text: "COUNT"; clicked => { root.quick-formula("COUNT"); } }
                ToolButton { text: "MIN"; clicked => { root.quick-formula("MIN"); } }
                ToolButton { text: "MAX"; clicked => { root.quick-formula("MAX"); } }

                Rectangle { width: 1px; height: 18px; background: Theme.palette().border; }

                Text {
                    text: "Format:";
                    font-size: Theme.tokens.typography.caption;
                    color: Theme.palette().ink-secondary;
                    vertical-alignment: center;
                }
                SegmentedControl {
                    items: ["General", "Number", "Currency", "%"];
                    current <=> root.cell-format-index;
                    selected(idx) => { root.set-cell-format(idx); }
                }

                Rectangle { horizontal-stretch: 1; background: transparent; }
                IconButton { icon: "export"; label: "Export CSV"; clicked => { root.export-csv(); } }
            }
        }

        // Enhanced Formula Bar with Commit/Cancel Actions & Clear Validation Feedback
        Rectangle {
            min-height: 36px;
            max-height: 36px;
            background: Theme.palette().surface;

            HorizontalLayout {
                height: parent.height;
                cross-axis-alignment: center;
                spacing: 8px;
                padding-left: 8px;
                padding-right: 8px;

                Rectangle {
                    min-width: 56px;
                    max-width: 56px;
                    min-height: 24px;
                    max-height: 24px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: Theme.palette().border;
                    background: Theme.palette().surface-sunken;
                    Text {
                        text: root.selected-cell;
                        font-weight: 700;
                        font-size: Theme.tokens.typography.caption;
                        color: Theme.palette().ink;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                IconButton {
                    icon: "check";
                    label: "Commit formula";
                    clicked => { root.commit-selected-cell(root.formula-edit-buffer); }
                }
                IconButton {
                    icon: "close";
                    label: "Cancel editing";
                    clicked => {
                        root.formula-edit-buffer = root.selection-formula;
                        root.cancel-selected-cell();
                    }
                }

                FormulaBarField {
                    label: "Selected cell formula or value";
                    placeholder: "Enter a value or formula (e.g. =SUM(A1:A5))";
                    value <=> root.formula-edit-buffer;
                    horizontal-stretch: 1;
                    committed(text) => { root.commit-selected-cell(text); }
                    cancelled => {
                        root.formula-edit-buffer = root.selection-formula;
                        root.cancel-selected-cell();
                    }
                }
                Text {
                    text: "=";
                    font-size: Theme.tokens.typography.body;
                    color: Theme.palette().ink-disabled;
                    vertical-alignment: center;
                }
                Text {
                    text: root.selection-value;
                    font-size: Theme.tokens.typography.body;
                    font-weight: 600;
                    color: Theme.palette().accent;
                    vertical-alignment: center;
                }

                if root.formula-feedback != "" : Text {
                    text: "· " + root.formula-feedback;
                    font-size: Theme.tokens.typography.caption;
                    color: Theme.palette().ink-secondary;
                    vertical-alignment: center;
                }
            }
        }

        Rectangle {
            min-height: 1px;
            max-height: 1px;
            background: Theme.palette().border;
        }

        // Cell Grid
        GridLayout {
            vertical-stretch: 1;
            horizontal-stretch: 1;
            max-width: 10000px;
            max-height: 10000px;
            spacing: 0px;
            padding-left: 4px;
            padding-top: 4px;

            Row {
                Rectangle {
                    min-width: 36px;
                    max-width: 36px;
                    min-height: 22px;
                    max-height: 22px;
                }
                for c in root.cols : Rectangle {
                    min-width: 120px;
                    max-width: 120px;
                    min-height: 22px;
                    max-height: 22px;
                    background: Theme.palette().surface-sunken;
                    Text {
                        text: root.column-headers[c];
                        font-size: Theme.tokens.typography.caption;
                        font-weight: 700;
                        color: Theme.palette().ink-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            for r in root.rows : Row {
                Rectangle {
                    min-width: 36px;
                    max-width: 36px;
                    min-height: 26px;
                    max-height: 26px;
                    background: Theme.palette().surface-sunken;
                    Text {
                        text: root.row-headers[r];
                        font-size: Theme.tokens.typography.caption;
                        color: Theme.palette().ink-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                for c in root.cols : Rectangle {
                    min-width: 120px;
                    max-width: 120px;
                    min-height: 26px;
                    max-height: 26px;
                    border-width: 1px;
                    border-color: Theme.palette().border;
                    background: ta.has-hover ? Theme.palette().selection-soft : Theme.palette().surface;
                    Text {
                        x: 4px;
                        width: parent.width - 8px;
                        text: root.cells[r * root.cols.length + c];
                        font-size: Theme.tokens.typography.body;
                        color: Theme.palette().ink;
                        horizontal-alignment: left;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    ta := TouchArea {
                        clicked => { root.cell-clicked(r, c); }
                    }
                }
            }
        }

        // Sheet Tabs Bar at bottom
        Rectangle {
            min-height: 32px;
            max-height: 32px;
            background: Theme.palette().surface;

            HorizontalLayout {
                height: parent.height;
                cross-axis-alignment: center;
                spacing: 4px;
                padding-left: 8px;
                padding-right: 8px;

                for sheet[idx] in root.sheets : Rectangle {
                    height: 24px;
                    border-radius: 4px;
                    background: idx == root.active-sheet-index ? Theme.palette().surface-sunken : Theme.palette().surface;
                    border-width: 1px;
                    border-color: idx == root.active-sheet-index ? Theme.palette().accent : Theme.palette().border;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: center;
                        Text {
                            text: sheet;
                            font-size: Theme.tokens.typography.caption;
                            font-weight: idx == root.active-sheet-index ? 700 : 400;
                            color: idx == root.active-sheet-index ? Theme.palette().accent : Theme.palette().ink;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        clicked => { root.select-sheet(idx); }
                    }
                }

                ToolButton {
                    text: "+ New Sheet";
                    clicked => { root.add-new-sheet(); }
                }

                Rectangle { horizontal-stretch: 1; }
            }
        }

        StatusBar {
            status-left: root.status-left;
            status-right: root.status-right;
        }
    }
}

