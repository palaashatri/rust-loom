import { TemplateChooserModal } from "template_chooser.slint";
import {
    LoomButton, LoomToolbar, LoomStatusBar, LoomStatusText,
} from "foundation.slint";
import { SheetChart } from "chart.slint";
import { SheetObjectLayer } from "objects.slint";
import { CommandPalette, CommandPaletteItem } from "../../../../loom-core/crates/loom-ui/ui/components.slint";
import {
    FormulaNameBar, SheetActionToolbar, SheetGridSurface, SheetInspector, SheetSelectionOverlay,
    SheetScrollbars, SheetTable, SheetTabs
} from "components.slint";
import { Icon } from "icons.slint";
import { Theme, ResponsivePolicy } from "theme.slint";
export { Theme, ResponsivePolicy } from "theme.slint";

export struct LocalMenuEntry {
    menu_index: int,
    label: string,
    command_id: string,
    shortcut: string,
    enabled: bool,
    checked: bool,
    separator: bool,
}

export component SheetsApp inherits Window {
    in-out property <string> window-title: "Untitled";
    title: root.window-title;
    min-width: 900px;
    min-height: 680px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.palette().canvas;

    in property <bool> show-quick-formulas: false;
    in property <bool> local-menu-visible: true;
    in property <[string]> local-menu-labels: ["File", "Edit", "View", "Table", "Help"];
    in property <[LocalMenuEntry]> local-menu-items: [];
    in-out property <int> local-menu-open-index: -1;
    callback local-menu-action(string);
    in property <bool> wide-toolbar: false;
    in property <bool> icon-only-toolbar: false;
    in property <bool> labeled-toolbar: false;
    in property <bool> labeled-export: false;
    in property <bool> overflow-toolbar: false;
    in property <bool> rtl: false;
    in-out property <bool> toolbar-overflow-open: false;
    // The work surface owns the first-launch width. The Format inspector is
    // opt-in and its preference survives compact/wide breakpoint changes.
    in-out property <bool> show-inspector: false;
    in-out property <bool> inspector-preference: false;
    in property <bool> inspector-available: true;
    property <bool> inspector-visible: root.show-inspector && root.inspector-available;
    property <bool> inspector-docked-visible: root.inspector-visible && !root.icon-only-toolbar;
    property <bool> compact-inspector-visible: root.inspector-visible && root.icon-only-toolbar;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in-out property <int> inspector-tab: 0;
    in property <bool> inspector-show-table: true;
    in property <bool> inspector-show-cell: true;
    callback window-resized(length);
    changed rtl => {
        Theme.rtl = root.rtl;
    }
    changed inspector-visible => {
        if (root.inspector-visible) {
            inspector-panel.focus-inspector();
        } else {
            action-toolbar.focus-inspector-trigger();
        }
    }
    changed width => {
        root.window-resized(root.width);
        if (!ResponsivePolicy.priority-2-overflow(root.width)) {
            root.close-toolbar-overflow();
        }
    }

    in property <string> sheet-name: "Untitled";
    in property <string> status-left: "";
    in property <string> status-summary: "";
    in property <string> status-right: "";
    in property <[int]> rows: [];
    in property <[int]> cols: [];
    in property <[string]> column-headers: [];
    in property <[string]> row-headers: [];
    in property <[string]> cells: [];
    in property <[int]> cell-alignments: [];
    in property <[bool]> cell-bolds: [];
    in property <[bool]> cell-italics: [];
    in property <[bool]> cell-underlines: [];
    in property <[bool]> cell-borders: [];
    in property <[int]> cell-fills: [];
    in property <[int]> cell-font-sizes: [];
    in property <[string]> object-kinds: [];
    in property <[string]> object-labels: [];
    in property <[image]> object-images: [];
    in property <[length]> object-positions-x: [];
    in property <[length]> object-positions-y: [];
    in property <[int]> object-widths: [];
    in property <[int]> object-heights: [];
    in property <[int]> object-fills: [];
    in property <[bool]> visible-objects: [];
    in property <[bool]> selected-objects: [];
    in-out property <int> selected-object: -1;
    in property <bool> cell-bold: false;
    in property <bool> cell-italic: false;
    in property <bool> cell-underline: false;
    in property <bool> cell-border: false;
    in property <int> cell-fill: -1;
    in property <int> cell-font-size: 14;
    in property <string> cell-font-label: "14";
    in property <int> cell-decimals: 2;
    in property <string> cell-decimals-label: "2";
    // The grid renders a bounded slice of the sparse workbook. These are
    // zero-based worksheet coordinates, not visual row/column indexes.
    in property <int> view-row-origin: 0;
    in property <int> view-col-origin: 0;
    in property <int> workbook-rows: 1;
    in property <int> workbook-cols: 1;
    in property <length> grid-col-width: 80px;
    in property <length> grid-row-height: 24px;
    in property <length> grid-col-offset: 0px;
    in property <length> grid-row-offset: 0px;
    in property <length> grid-visible-width: 640px;
    in property <length> grid-visible-height: 360px;
    in property <length> grid-content-width: 640px;
    in property <length> grid-content-height: 360px;
    in property <[length]> grid-column-widths: [];
    in property <[length]> grid-row-heights: [];
    in-out property <length> grid-scroll-x: 0px;
    in-out property <length> grid-scroll-y: 0px;
    in-out property <length> grid-viewport-width: 720px;
    in-out property <length> grid-viewport-height: 420px;
    in property <string> selected-cell: "A1";
    in property <int> selected-row: 0;
    in property <int> selected-col: 0;
    in property <int> selection-anchor-row: 0;
    in property <int> selection-anchor-col: 0;
    in property <int> selection-start-row: 0;
    in property <int> selection-start-col: 0;
    in property <int> selection-end-row: 0;
    in property <int> selection-end-col: 0;
    in property <string> selection-range: "A1";
    in property <int> selection-count: 1;
    in property <string> selection-formula: "";
    in-out property <string> formula-edit-buffer: "";
    in property <string> selection-value: "";
    in property <string> selection-announcement: "A1 selected; value: Empty";
    in property <string> table-rows-label: "1";
    in property <string> table-cols-label: "1";
    in property <string> selected-row-height: "24 px";
    in property <string> selected-col-width: "80 px";
    in-out property <string> inspector-search: "";
    in-out property <string> formula-feedback: "Ready";
    in-out property <bool> is-editing: false;
    in-out property <[string]> sheet-names: ["Sheet 1"];
    in-out property <int> active-sheet-index: 0;
    in-out property <string> zoom-level: "100%";
    in-out property <float> zoom-factor: 1.0;

    in-out property <bool> template-chooser-open: false;
    in-out property <bool> template-chooser-focus-request: false;
    in-out property <int> template-selected: 0;
    in-out property <int> template-category: 0;
    in-out property <[int]> template-recents: [];
    in-out property <int> template-scroll-position: 0;
    in property <float> template-text-scale: 1.0;
    in-out property <bool> save-changes-open: false;
    in-out property <string> save-changes-document: "";

    callback new-sheet;
    callback open-sheet;
    callback save-sheet;
    callback save-as-sheet;
    callback export-csv;
    callback export-xlsx;
    callback undo;
    callback redo;
    callback cell-clicked(int, int);
    callback commit-selected-cell(string);
    callback cancel-selected-cell;
    callback begin-edit(string);
    callback quick-formula(string);
    callback navigate-selection(int, int);
    callback extend-selection(int, int);
    callback fill-selection;
    callback grid-scrolled;
    callback grid-viewport-changed(length, length);
    callback inspector-search-edited(string);
    callback inspector-context-changed(int);
    callback toggle-inspector;
    callback create-template(int);
    callback navigate-template-selection(int);
    callback cancel-template;
    callback save-changes-save;
    callback save-changes-discard;
    callback save-changes-cancel;
    callback select-sheet(int);
    callback add-sheet;
    callback add-row;
    callback organize;
    callback cycle-zoom;
    callback zoom-in;
    callback zoom-out;
    callback zoom-actual;
    callback insert-chart;
    callback insert-shape;
    callback insert-image;
    callback object-move-started(int);
    callback object-moved(int, float, float);
    callback object-move-ended(int);
    callback object-move-cancelled(int);
    callback object-resize-started(int);
    callback object-resized(int, float, float);
    callback object-resize-ended(int);
    callback object-resize-cancelled(int);
    callback rename-sheet(string);
    callback add-table-col;
    callback delete-row;
    callback delete-col;
    callback delete-sheet;
    callback sort-ascending;
    callback sort-descending;
    callback freeze-panes;
    callback unfreeze-panes;
    callback adjust-row-height(int);
    callback adjust-col-width(int);
    callback set-cell-format(int);
    callback set-cell-alignment(int);
    callback toggle-bold;
    callback toggle-italic;
    callback toggle-underline;
    callback toggle-borders;
    callback cycle-fill;
    callback set-fill(int);
    callback adjust-font(int);
    callback adjust-decimals(int);
    callback clear-selected-cells;
    callback copy-selection;
    callback cut-selection;
    callback paste-selection;
    callback select-all;
    callback close-chart;
    callback cycle-chart-kind;
    callback pivot-summary(int);

    in-out property <bool> chart-visible: false;
    in-out property <string> chart-title: "Chart";
    in-out property <string> chart-source-range: "";
    in-out property <string> chart-series-label: "Values";
    in-out property <string> chart-unit-label: "Not specified";
    in-out property <string> chart-kind: "bar";
    in-out property <[string]> chart-categories: [];
    in-out property <[string]> chart-values-display: [];
    in-out property <[float]> chart-normalized: [];
    in-out property <string> chart-line-commands: "";
    in-out property <[string]> chart-pie-commands: [];
    in-out property <[float]> chart-pie-opacities: [];
    in-out property <int> cell-format: 0;
    in-out property <int> cell-alignment: 0;

    in-out property <[CommandPaletteItem]> palette-commands: [];
    in-out property <bool> palette-open: false;
    in-out property <string> palette-query: "";
    in-out property <int> palette-selected: 0;
    callback palette-invoked(int);
    callback palette-query-changed(string);
    callback palette-move(int);
    callback palette-key-text(string);
    callback palette-backspace;
    callback palette-close;

    public function open-palette() {
        root.palette-open = true;
        root.palette-query = "";
        palette.grab-focus();
    }

    // Exposed for the native grid journey and for restoring keyboard focus
    // after a formula-bar or toolbar interaction.
    public function focus-grid() {
        grid-surface.focus-grid();
    }

    public function focus-template-chooser() {
        root.template-chooser-focus-request = !root.template-chooser-focus-request;
    }

    public function focus-formula-bar() {
        root.is-editing = true;
        formula-bar.focus-formula-bar();
    }

    public function reset-formula-edit-buffer() {
        formula-edit-buffer = selection-formula;
    }

    public function close-toolbar-overflow() {
        if (root.toolbar-overflow-open) {
            root.toolbar-overflow-open = false;
            app-focus.focus();
        }
    }

    changed overflow-toolbar => {
        if (!root.overflow-toolbar) {
            root.close-toolbar-overflow();
        }
    }

    overflow-menu-focus := FocusScope {
        enabled: root.toolbar-overflow-open;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-toolbar-overflow();
                return accept;
            }
            return reject;
        }
    }

    save-changes-focus := FocusScope {
        enabled: root.save-changes-open;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.save-changes-cancel();
                return accept;
            }
            return reject;
        }
    }

    changed save-changes-open => {
        if (root.save-changes-open) {
            root.palette-open = false;
            root.toolbar-overflow-open = false;
            save-changes-focus.focus();
        } else if (!root.template-chooser-open && !root.palette-open) {
            app-focus.focus();
        }
    }

    changed template-chooser-open => {
        if (root.template-chooser-open) {
            root.template-chooser-focus-request = !root.template-chooser-focus-request;
        } else if (root.save-changes-open) {
            save-changes-focus.focus();
        } else {
            grid-surface.focus-grid();
        }
    }

        app-focus := FocusScope {
        key-pressed(event) => {
            if (root.local-menu-open-index >= 0 && event.text == Key.Escape) {
                root.local-menu-open-index = -1;
                return accept;
            }
            if (root.local-menu-visible && event.modifiers.alt) {
                if (event.text == "f" || event.text == "F") { root.local-menu-open-index = 0; return accept; }
                if (event.text == "e" || event.text == "E") { root.local-menu-open-index = 1; return accept; }
                if (event.text == "v" || event.text == "V") { root.local-menu-open-index = 2; return accept; }
                if (event.text == "t" || event.text == "T") { root.local-menu-open-index = 3; return accept; }
                if (event.text == "h" || event.text == "H") { root.local-menu-open-index = 4; return accept; }
            }
            if (root.palette-open || root.template-chooser-open || root.toolbar-overflow-open || root.save-changes-open) { return reject; }
            if (event.modifiers.control || event.modifiers.meta) {
                if (event.text == Key.K || event.text == "k") {
                    root.open-palette();
                    return accept;
                }
                if (event.text == "n" || event.text == "N") {
                    root.new-sheet();
                    return accept;
                }
                if (event.text == "o" || event.text == "O") {
                    root.open-sheet();
                    return accept;
                }
                if (event.text == "s" || event.text == "S") {
                    if (event.modifiers.shift) { root.save-as-sheet(); } else { root.save-sheet(); }
                    return accept;
                }
                if (event.text == "e" || event.text == "E") {
                    root.export-csv();
                    return accept;
                }
                if (event.text == "z" || event.text == "Z") {
                    if (event.modifiers.shift) { root.redo(); } else { root.undo(); }
                    return accept;
                }
                if (event.text == "c" || event.text == "C") {
                    root.copy-selection();
                    return accept;
                }
                if (event.text == "x" || event.text == "X") {
                    root.cut-selection();
                    return accept;
                }
                if (event.text == "v" || event.text == "V") {
                    root.paste-selection();
                    return accept;
                }
                if (event.text == "a" || event.text == "A") {
                    root.select-all();
                    return accept;
                }
                if (event.text == "b" || event.text == "B") {
                    root.toggle-bold();
                    return accept;
                }
                if (event.text == "i" || event.text == "I") {
                    root.toggle-italic();
                    return accept;
                }
                if (event.text == "u" || event.text == "U") {
                    root.toggle-underline();
                    return accept;
                }
                if (event.text == "=" || event.text == "+") {
                    root.zoom-in();
                    return accept;
                }
                if (event.text == "-") {
                    root.zoom-out();
                    return accept;
                }
                if (event.text == "0") {
                    root.zoom-actual();
                    return accept;
                }
            }
            if (event.text == Key.Backspace || event.text == Key.Delete) {
                root.clear-selected-cells();
                return accept;
            }
            if (event.text == Key.Escape) {
                // Dismiss the chart overlay when one is showing; formula-bar
                // editing handles its own Escape closer to the focus.
                if (root.chart-visible) {
                    root.chart-visible = false;
                    root.close-chart();
                    return accept;
                }
                return reject;
            }
            if (event.text == Key.LeftArrow) {
                if (event.modifiers.shift) { root.extend-selection(0, -1); } else { root.navigate-selection(0, -1); }
                return accept;
            }
            if (event.text == Key.RightArrow) {
                if (event.modifiers.shift) { root.extend-selection(0, 1); } else { root.navigate-selection(0, 1); }
                return accept;
            }
            if (event.text == Key.UpArrow) {
                if (event.modifiers.shift) { root.extend-selection(-1, 0); } else { root.navigate-selection(-1, 0); }
                return accept;
            }
            if (event.text == Key.DownArrow) {
                if (event.modifiers.shift) { root.extend-selection(1, 0); } else { root.navigate-selection(1, 0); }
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0px;
            padding: 0px;

            if root.local-menu-visible : Rectangle {
                width: root.width;
                height: 36px;
                background: Theme.palette().surface;

                HorizontalLayout {
                    spacing: 0px;
                    padding-left: Theme.tokens.space.sm;

                    for label[index] in root.local-menu-labels : LoomButton {
                        width: 64px;
                        height: 36px;
                        label: label;
                        variant: "ghost";
                        selected: root.local-menu-open-index == index;
                        clicked => {
                            root.local-menu-open-index = root.local-menu-open-index == index ? -1 : index;
                        }
                    }
                }

                Rectangle {
                    x: 0px;
                    y: 35px;
                    width: root.width;
                    height: 1px;
                    background: Theme.palette().border;
                }
            }

            // Numbers Unified Action Toolbar
            action-toolbar := SheetActionToolbar {
                rtl: root.rtl;
                wide: root.wide-toolbar;
                overflow: root.overflow-toolbar;
                inspector-available: root.inspector-available;
                inspector-visible: root.inspector-visible;
                labeled-export: root.labeled-export;
                can-undo: root.can-undo;
                can-redo: root.can-redo;
                zoom-level: root.zoom-level;
                cell-bold: root.cell-bold;
                cell-italic: root.cell-italic;
                cell-underline: root.cell-underline;
                cell-alignment: root.cell-alignment;
                new-sheet => { root.new-sheet(); }
                open-sheet => { root.open-sheet(); }
                save-sheet => { root.save-sheet(); }
                save-as-sheet => { root.save-as-sheet(); }
                open-palette => { root.open-palette(); }
                undo => { root.undo(); }
                redo => { root.redo(); }
                toggle-inspector => { root.toggle-inspector(); }
                export-csv => { root.export-csv(); }
                zoom-clicked => { root.cycle-zoom(); }
                toggle-bold => { root.toggle-bold(); }
                toggle-italic => { root.toggle-italic(); }
                toggle-underline => { root.toggle-underline(); }
                set-cell-alignment(align) => { root.set-cell-alignment(align); }
                add-row => { root.add-row(); }
                add-col => { root.add-table-col(); }
                insert-chart => { root.insert-chart(); }
                organize => { root.organize(); }
                overflow-requested => {
                    if (root.toolbar-overflow-open) {
                        root.close-toolbar-overflow();
                    } else {
                        root.toolbar-overflow-open = true;
                        overflow-menu-focus.focus();
                    }
                }
            }

            // Numbers-style sheet tabs
            SheetTabs {
                sheets: root.sheet-names;
                active-sheet: root.active-sheet-index;
                can-add-sheet: true;
                select-sheet(idx) => { root.select-sheet(idx); }
                add-sheet => { root.add-sheet(); }
            }

            formula-bar := FormulaNameBar {
                selection-range: root.selection-range;
                selection-formula: root.selection-formula;
                selection-count: root.selection-count;
                show-quick-formulas: root.show-quick-formulas;
                formula-edit-buffer <=> root.formula-edit-buffer;
                is-editing: root.is-editing;
                commit(text) => {
                    root.is-editing = false;
                    root.commit-selected-cell(text);
                }
                cancel => {
                    root.is-editing = false;
                    root.cancel-selected-cell();
                }
                quick-formula(function) => { root.quick-formula(function); }
                fill-selection => { root.fill-selection(); }
            }

            // Main spreadsheet workspace
            workspace := Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: transparent;

                HorizontalLayout {
                    height: parent.height;
                    spacing: 0px;
                    vertical-stretch: 1;

                if root.rtl && root.inspector-docked-visible : Rectangle { width: 320px; background: transparent; }

                Rectangle {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    grid-surface := SheetGridSurface {
                        width: parent.width;
                        height: parent.height;
                        sheet-name: root.sheet-name;
                        zoom-factor: root.zoom-factor;
                        selection-formula: root.selection-formula;
                        rows: root.rows;
                        cols: root.cols;
                        column-headers: root.column-headers;
                        row-headers: root.row-headers;
                        cells: root.cells;
                        cell-alignments: root.cell-alignments;
                        cell-bolds: root.cell-bolds;
                        cell-italics: root.cell-italics;
                        cell-underlines: root.cell-underlines;
                        cell-borders: root.cell-borders;
                        cell-fills: root.cell-fills;
                        cell-font-sizes: root.cell-font-sizes;
                        view-row-origin: root.view-row-origin;
                        view-col-origin: root.view-col-origin;
                        selected-row: root.selected-row;
                        selected-col: root.selected-col;
                        selection-start-row: root.selection-start-row;
                        selection-start-col: root.selection-start-col;
                        selection-end-row: root.selection-end-row;
                        selection-end-col: root.selection-end-col;
                        selection-announcement: root.selection-announcement;
                        grid-col-offset: root.grid-col-offset;
                        grid-row-offset: root.grid-row-offset;
                        grid-visible-width: root.grid-visible-width;
                        grid-visible-height: root.grid-visible-height;
                        grid-content-width: root.grid-content-width;
                        grid-content-height: root.grid-content-height;
                        grid-column-widths: root.grid-column-widths;
                        grid-row-heights: root.grid-row-heights;
                        grid-scroll-x <=> root.grid-scroll-x;
                        grid-scroll-y <=> root.grid-scroll-y;
                        cell-clicked(row, col) => { root.cell-clicked(row, col); }
                        clear-selected => { root.clear-selected-cells(); }
                        fill-selection => { root.fill-selection(); }
                        grid-scrolled => { root.grid-scrolled(); }
                        grid-viewport-changed(width, height) => {
                            root.grid-viewport-width = width;
                            root.grid-viewport-height = height;
                            root.grid-viewport-changed(width, height);
                        }
                        navigate-selection(row-delta, col-delta) => { root.navigate-selection(row-delta, col-delta); }
                        extend-selection(row-delta, col-delta) => { root.extend-selection(row-delta, col-delta); }
                        begin-edit(initial-text) => {
                            root.is-editing = true;
                            root.begin-edit(initial-text);
                        }
                    }

                    SheetObjectLayer {
                        width: parent.width;
                        height: parent.height;
                        kinds: root.object-kinds;
                        labels: root.object-labels;
                        images: root.object-images;
                        positions-x: root.object-positions-x;
                        positions-y: root.object-positions-y;
                        widths: root.object-widths;
                        heights: root.object-heights;
                        fills: root.object-fills;
                        visible-objects: root.visible-objects;
                        selected-objects: root.selected-objects;
                        selected-object: root.selected-object;
                        object-move-started(index) => { root.object-move-started(index); }
                        object-moved(index, delta-x, delta-y) => { root.object-moved(index, delta-x, delta-y); }
                        object-move-ended(index) => { root.object-move-ended(index); }
                        object-move-cancelled(index) => { root.object-move-cancelled(index); }
                        object-resize-started(index) => { root.object-resize-started(index); }
                        object-resized(index, delta-x, delta-y) => { root.object-resized(index, delta-x, delta-y); }
                        object-resize-ended(index) => { root.object-resize-ended(index); }
                        object-resize-cancelled(index) => { root.object-resize-cancelled(index); }
                    }

                    if root.chart-visible : SheetChart {
                        x: min(parent.width - 400px, 120px);
                        y: min(parent.height - 260px, 180px);
                        title: root.chart-title;
                        source-range: root.chart-source-range;
                        series-label: root.chart-series-label;
                        unit-label: root.chart-unit-label;
                        kind: root.chart-kind;
                        categories: root.chart-categories;
                        values-display: root.chart-values-display;
                        normalized: root.chart-normalized;
                        line-commands: root.chart-line-commands;
                        pie-commands: root.chart-pie-commands;
                        pie-opacities: root.chart-pie-opacities;
                        close-chart => { root.chart-visible = false; root.close-chart(); }
                        cycle-kind => { root.cycle-chart-kind(); }
                    }
                }

                if !root.rtl && root.inspector-docked-visible : Rectangle { width: 320px; background: transparent; }
            }

                if root.compact-inspector-visible : Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    background: Theme.palette().scrim;
                    TouchArea { clicked => { root.toggle-inspector(); } }
                }

                inspector-panel := SheetInspector {
                    visible: root.inspector-visible;
                    active: root.inspector-visible;
                    x: root.rtl ? 0px : parent.width - self.width;
                    y: 0px;
                    width: 320px;
                    height: parent.height;
                    close-requested => { root.toggle-inspector(); }
                                        selection-range: root.selection-range;
                                        selection-value: root.selection-value;
                                        selection-formula: root.selection-formula;
                                        sheet-name: root.sheet-name;
                                        table-rows-label: root.table-rows-label;
                                        table-cols-label: root.table-cols-label;
                                        selected-row-height: root.selected-row-height;
                                        selected-col-width: root.selected-col-width;
                                        cell-format: root.cell-format;
                                        cell-alignment: root.cell-alignment;
                                        cell-bold: root.cell-bold;
                                        cell-italic: root.cell-italic;
                                        cell-underline: root.cell-underline;
                                        cell-border: root.cell-border;
                                        cell-fill: root.cell-fill;
                                        cell-font-size: root.cell-font-size;
                                        cell-font-label: root.cell-font-label;
                                        cell-decimals-label: root.cell-decimals-label;
                                        inspector-search <=> root.inspector-search;
                                        inspector-tab <=> root.inspector-tab;
                                        inspector-show-table: root.inspector-show-table;
                                        inspector-show-cell: root.inspector-show-cell;
                                        inspector-search-edited(query) => { root.inspector-search-edited(query); }
                                        inspector-context-changed(index) => { root.inspector-context-changed(index); }
                                        rename-sheet(name) => { root.rename-sheet(name); }
                                        add-table-row => { root.add-row(); }
                                        delete-table-row => { root.delete-row(); }
                                        add-table-col => { root.add-table-col(); }
                                        delete-table-col => { root.delete-col(); }
                                        adjust-row-height(delta) => { root.adjust-row-height(delta); }
                                        adjust-col-width(delta) => { root.adjust-col-width(delta); }
                                        set-cell-format(fmt) => { root.set-cell-format(fmt); }
                                        set-cell-alignment(align) => { root.set-cell-alignment(align); }
                                        toggle-bold => { root.toggle-bold(); }
                                        toggle-italic => { root.toggle-italic(); }
                                        toggle-underline => { root.toggle-underline(); }
                                        toggle-borders => { root.toggle-borders(); }
                                        cycle-fill => { root.cycle-fill(); }
                                        set-fill(idx) => { root.set-fill(idx); }
                                        adjust-font(delta) => { root.adjust-font(delta); }
                                        adjust-decimals(delta) => { root.adjust-decimals(delta); }

                }
            }
            LoomStatusBar {
                LoomStatusText {
                    text: root.status-left != "" ? root.status-left : "Ready";
                    strong: true;
                    accessible-live-region: AccessibleLiveness.polite;
                    horizontal-stretch: 1;
                }
                LoomStatusText {
                    text: root.status-summary;
                    horizontal-alignment: right;
                }
                LoomStatusText {
                    text: root.status-right;
                    horizontal-alignment: right;
                }
            }
        }
    }

    // Local menu fallback for desktop systems that do not display the
    // installed native menu in a global application bar.
    if root.local-menu-visible && root.local-menu-open-index >= 0 : Rectangle {
        x: 0px;
        y: 36px;
        width: root.width;
        height: root.height - 36px;
        background: transparent;

        TouchArea {
            clicked => { root.local-menu-open-index = -1; }
        }

        Rectangle {
            x: 8px + root.local-menu-open-index * 64px;
            y: 0px;
            width: 288px;
            height: min(520px, root.height - 44px);
            border-radius: Theme.tokens.metrics.radius-small;
            border-width: 1px;
            border-color: Theme.palette().border;
            background: Theme.palette().surface;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 3px;
            drop-shadow-color: Theme.palette().shadow;

            VerticalLayout {
                spacing: Theme.tokens.space.xs;
                padding: Theme.tokens.space.sm;

                for item in root.local-menu-items : Rectangle {
                    visible: item.menu_index == root.local-menu-open-index;
                    height: item.separator ? 1px : Theme.tokens.metrics.control-height;

                    if item.separator : Rectangle {
                        width: root.width;
                        height: 1px;
                        background: Theme.palette().border;
                    }

                    if !item.separator : LoomButton {
                        width: parent.width;
                        height: parent.height;
                        label: (item.checked ? "✓ " : "") + item.label + (item.shortcut != "" ? "    " + item.shortcut : "");
                        variant: "ghost";
                        enabled: item.enabled;
                        clicked => {
                            root.local-menu-open-index = -1;
                            root.local-menu-action(item.command_id);
                        }
                    }
                }
            }
        }
    }

    // Compact toolbar overflow menu
    if root.toolbar-overflow-open && root.overflow-toolbar : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: transparent;

        TouchArea {
            clicked => { root.close-toolbar-overflow(); }
        }

        Rectangle {
            x: max(8px, root.width - 272px);
            y: Theme.tokens.metrics.header-height + Theme.tokens.metrics.sheet-tab-height + Theme.tokens.metrics.toolbar-height + 8px;
            width: 256px;
            height: 76px;
            border-radius: Theme.tokens.metrics.radius-medium;
            border-width: 1px;
            border-color: Theme.palette().border;
            background: Theme.palette().surface;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.palette().shadow;

            VerticalLayout {
                spacing: Theme.tokens.space.sm;
                padding: Theme.tokens.space.md;

                LoomButton {
                    icon: "export";
                    label: "Export CSV";
                    variant: "ghost";
                    horizontal-stretch: 1;
                    clicked => { root.export-csv(); root.close-toolbar-overflow(); }
                }
            }
        }
    }

    // Numbers-Style Template Chooser Modal
    if root.template-chooser-open : TemplateChooserModal {
        width: root.width;
        height: root.height;
        keyboard-active: !root.save-changes-open;
        focus-request: root.template-chooser-focus-request;
        template-selected <=> root.template-selected;
        template-category <=> root.template-category;
        template-recents: root.template-recents;
        template-scroll-position <=> root.template-scroll-position;
        text-scale: root.template-text-scale;
        cancel-template => { root.cancel-template(); }
        create-template(selected) => { root.create-template(selected); }
        navigate-template-selection(delta) => { root.navigate-template-selection(delta); }
    }

    if root.save-changes-open : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: Theme.palette().scrim;
        accessible-role: groupbox;
        accessible-label: "Save changes dialog";

        TouchArea { clicked => { save-changes-focus.focus(); } }

        Rectangle {
            x: (root.width - min(520px, root.width - 32px)) / 2;
            y: (root.height - 208px) / 2;
            width: min(520px, root.width - 32px);
            height: 208px;
            border-radius: Theme.tokens.metrics.radius-large;
            border-width: 1px;
            border-color: Theme.palette().border;
            background: Theme.palette().surface;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 6px;
            drop-shadow-color: Theme.palette().shadow;

            VerticalLayout {
                spacing: Theme.tokens.space.md;
                padding: Theme.tokens.space.xl;

                Text {
                    text: "Save changes?";
                    font-size: Theme.tokens.typography.heading;
                    font-weight: 700;
                    color: Theme.palette().ink;
                }
                Text {
                    text: "Save changes to \"" + root.save-changes-document + "\" before replacing it?";
                    font-size: Theme.tokens.typography.body;
                    color: Theme.palette().ink-secondary;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    spacing: Theme.tokens.space.sm;
                    alignment: end;
                    LoomButton {
                        label: "Cancel";
                        variant: "secondary";
                        clicked => { root.save-changes-cancel(); }
                    }
                    LoomButton {
                        label: "Discard";
                        variant: "danger";
                        clicked => { root.save-changes-discard(); }
                    }
                    LoomButton {
                        label: "Save";
                        variant: "primary";
                        clicked => { root.save-changes-save(); }
                    }
                }
            }
        }
    }

    palette := CommandPalette {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        open: root.palette-open;
        commands: root.palette-commands;
        query: root.palette-query;
        selected: root.palette-selected;
        command-invoked(idx) => { root.palette-invoked(idx); }
        query-changed(q) => {
            root.palette-query = q;
            root.palette-query-changed(q);
        }
        move-selection(delta) => { root.palette-move(delta); }
        key-text(text) => { root.palette-key-text(text); }
        backspace => { root.palette-backspace(); }
        close-requested => {
            root.palette-open = false;
            root.palette-close();
        }
    }
}
