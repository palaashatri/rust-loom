import {
    TitleChrome, ContextToolbar, LabeledToolbar, ToolbarGroup, ToolbarSpacer, ToolbarButton, DirectionalLayout,
    IconOnlyToolbarItem, Overflow, IconOverLabelToolbarItem, StatusBar, CanvasSurface, InspectorSurface,
    SectionHeader, Field, SearchField, PropertyRow, SheetTabStrip
} from "toolkit.slint";
import { CommandPalette, CommandPaletteItem } from "components.slint";
import { Icon } from "icons.slint";
import { Theme, ResponsivePolicy } from "theme.slint";
export { Theme, ResponsivePolicy } from "theme.slint";

/// Toolbar contents are shared by both explicit slot hosts. The host owns
/// the 40px/48-52px geometry; this body only switches command visibility.
component SheetsToolbarBody inherits DirectionalLayout {
    in property <bool> wide: false;
    in property <bool> overflow: false;
    in property <bool> inspector-available: true;
    in property <bool> inspector-visible: false;
    in property <bool> labeled-export: false;
    callback toggle-inspector;
    callback export-csv;
    callback overflow-requested;

    spacing: 4px;
    leading-padding: 0px;
    trailing-padding: 0px;
    horizontal-stretch: 1;
    vertical-stretch: 1;

    if root.wide : ToolbarGroup { labeled-slot: true;
        IconOverLabelToolbarItem {
            icon: "eye";
            label: "View";
            accessible-label: "View";
            enabled: root.inspector-available;
            clicked => { if (root.inspector-available) { root.toggle-inspector(); } }
        }
        IconOverLabelToolbarItem { icon: "zoom-in"; label: "Page Zoom"; accessible-label: "Page zoom unavailable"; enabled: false; }
        IconOverLabelToolbarItem { icon: "plus"; label: "Add Category"; accessible-label: "Add category unavailable"; enabled: false; }
    }

    if !root.wide : ToolbarGroup { labeled-slot: false;
        if !root.overflow : IconOnlyToolbarItem {
            icon: "eye";
            label: "View";
            enabled: root.inspector-available;
            clicked => { root.toggle-inspector(); }
        }
        if root.overflow : Overflow {
            label: "More Sheets actions";
            clicked => { root.overflow-requested(); }
        }
    }

    if !root.overflow : ToolbarSpacer { }

    if root.wide : ToolbarGroup { labeled-slot: true;
        IconOverLabelToolbarItem { icon: "table"; label: "Table"; accessible-label: "Insert table unavailable"; enabled: false; }
        IconOverLabelToolbarItem { icon: "grid"; label: "Pivot Table"; accessible-label: "Insert pivot table unavailable"; enabled: false; }
        IconOverLabelToolbarItem { icon: "chart"; label: "Chart"; accessible-label: "Insert chart unavailable"; enabled: false; }
        IconOverLabelToolbarItem { icon: "text"; label: "Text"; accessible-label: "Insert text box unavailable"; enabled: false; }
        IconOverLabelToolbarItem { icon: "shape"; label: "Shape"; accessible-label: "Insert shape unavailable"; enabled: false; }
        IconOverLabelToolbarItem { icon: "image"; label: "Media"; accessible-label: "Insert media unavailable"; enabled: false; }
        IconOverLabelToolbarItem { icon: "comment"; label: "Comment"; accessible-label: "Insert comment unavailable"; enabled: false; }
    }

    if !root.overflow : ToolbarSpacer { }

    if root.wide : ToolbarGroup { labeled-slot: true;
        IconOverLabelToolbarItem { icon: "share"; label: "Share"; accessible-label: "Share unavailable"; enabled: false; }
        IconOverLabelToolbarItem {
            icon: "format";
            label: "Format";
            accessible-label: "Format inspector";
            checked: root.inspector-visible;
            enabled: root.inspector-available;
            clicked => { if (root.inspector-available) { root.toggle-inspector(); } }
        }
        IconOverLabelToolbarItem { icon: "organize"; label: "Organize"; accessible-label: "Organize unavailable"; enabled: false; }
        IconOverLabelToolbarItem {
            icon: "export";
            label: "Export";
            accessible-label: "Export CSV";
            clicked => { root.export-csv(); }
        }
    }

    if !root.wide && !root.overflow : ToolbarGroup { labeled-slot: false;
        IconOnlyToolbarItem {
            icon: "format";
            label: "Format";
            checked: root.inspector-visible;
            enabled: root.inspector-available;
            clicked => { if (root.inspector-available) { root.toggle-inspector(); } }
        }
        IconOnlyToolbarItem { icon: "export"; label: "Export CSV"; clicked => { root.export-csv(); } }
    }

    if root.overflow : ToolbarSpacer { }
    if root.overflow : ToolbarGroup { labeled-slot: false;
        IconOnlyToolbarItem { icon: "export"; label: "Export CSV"; clicked => { root.export-csv(); } }
    }
}

/// Numbers-style spreadsheet template card
component SheetTemplateCard inherits Rectangle {
    in property <int> template-index: 0;
    in property <string> template-name: "Blank";
    in property <string> description: "Start from a blank table";
    in property <bool> selected: false;
    callback clicked;

    width: 180px;
    height: 185px;
    border-radius: Theme.tokens.metrics.radius-medium;
    background: touch.has-hover && !root.selected ? Theme.palette().surface-raised : transparent;
    accessible-role: button;
    accessible-label: root.template-name + " template";
    accessible-action-default => { root.clicked(); }

    VerticalLayout {
        spacing: 10px;
        padding: 6px;
        alignment: center;
        cross-axis-alignment: center;

        Rectangle {
            width: 160px;
            height: 115px;
            border-radius: 4px;
            border-width: root.selected ? 2.5px : 1px;
            border-color: root.selected ? Theme.palette().accent : Theme.palette().paper-line;
            background: Theme.palette().paper;
            drop-shadow-blur: 10px;
            drop-shadow-offset-y: 3px;
            drop-shadow-color: Theme.palette().shadow;
            clip: true;

            // Sheet Template Preview Grid
            VerticalLayout {
                spacing: 0px;

                // Header row
                Rectangle {
                    height: 20px;
                    background: root.template-index == 1 ? Theme.palette().accent
                        : root.template-index == 2 ? Theme.palette().content-cool
                        : Theme.palette().surface-sunken;
                    HorizontalLayout {
                        spacing: 1px;
                        Rectangle { width: 40px; }
                        Rectangle { width: 1px; background: Theme.palette().border; }
                        Rectangle { width: 50px; }
                        Rectangle { width: 1px; background: Theme.palette().border; }
                        Rectangle { width: 50px; }
                        Rectangle { width: 1px; background: Theme.palette().border; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                // Grid rows
                for idx in 5 : Rectangle {
                    height: 19px;
                    background: (Math.mod(idx, 2) == 1 && root.template-index != 0) ? Theme.palette().surface-sunken : Theme.palette().paper;
                    Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.palette().paper-line; }
                    HorizontalLayout {
                        spacing: 1px;
                        Rectangle { width: 40px; }
                        Rectangle { width: 1px; background: Theme.palette().paper-line; }
                        Rectangle { width: 50px; }
                        Rectangle { width: 1px; background: Theme.palette().paper-line; }
                        Rectangle { width: 50px; }
                        Rectangle { width: 1px; background: Theme.palette().paper-line; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }

        if root.selected : Rectangle {
            height: 20px;
            border-radius: 4px;
            background: Theme.palette().accent;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                alignment: center;
                cross-axis-alignment: center;
                Text {
                    text: root.template-name;
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.palette().accent-ink;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if !root.selected : Text {
            text: root.template-name;
            font-size: 11px;
            font-weight: 500;
            color: Theme.palette().ink;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

/// Compact, keyboard/accessibility-visible scrollbar for the virtual sheet.
/// Flickable still handles wheel/touchpad gestures; this thumb provides an
/// explicit drag target without materializing the full worksheet.
component SheetScrollBar inherits Rectangle {
    in property <bool> horizontal: false;
    in-out property <length> value: 0px;
    in property <length> maximum: 0px;
    in property <length> page-size: 1px;
    property <length> handle-length: root.maximum > 0px
        ? max(24px, (root.horizontal ? root.width : root.height) * root.page-size / (root.maximum + root.page-size))
        : (root.horizontal ? root.width : root.height);

    // Keep dimensions in concrete lengths.  Slint cannot mix percentage and
    // length units in a conditional expression; each orientation supplies
    // its full extent at the call site below.
    width: 9px;
    height: 9px;
    background: Theme.palette().surface-sunken;
    accessible-role: slider;
    accessible-label: root.horizontal ? "Horizontal sheet scroll" : "Vertical sheet scroll";
    accessible-value: root.maximum > 0px ? -root.value / 1px : 0.0;
    accessible-value-minimum: 0.0;
    accessible-value-maximum: root.maximum / 1px;

    scroll-focus := FocusScope {
        key-pressed(event) => {
            let step = max(1px, root.maximum / 10.0);
            if ((root.horizontal && event.text == Key.LeftArrow)
                || (!root.horizontal && event.text == Key.UpArrow)) {
                root.value = min(0px, root.value + step);
                return accept;
            }
            if ((root.horizontal && event.text == Key.RightArrow)
                || (!root.horizontal && event.text == Key.DownArrow)) {
                root.value = max(-root.maximum, root.value - step);
                return accept;
            }
            return reject;
        }
    }

    Rectangle {
        x: root.horizontal && root.maximum > 0px
            ? clamp((-root.value / root.maximum) * (parent.width - self.width), 0px, parent.width - self.width)
            : 0px;
        y: root.horizontal ? 0px
            : root.maximum > 0px
                ? clamp((-root.value / root.maximum) * (parent.height - self.height), 0px, parent.height - self.height)
                : 0px;
        width: root.horizontal ? root.handle-length : parent.width;
        height: root.horizontal ? parent.height : root.handle-length;
        border-radius: 4px;
        background: scroll-track.pressed || scroll-track.has-hover
            ? Theme.palette().accent
            : Theme.palette().border-strong;
    }

    // A full-track target handles both clicking a page position and dragging
    // the thumb.  Mapping to the thumb centre avoids the jump caused by
    // interpreting pointer coordinates in the thumb's local space.
    scroll-track := TouchArea {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        moved => {
            if (self.pressed) {
                if (root.horizontal) {
                    root.value = -clamp(
                        (self.mouse-x - root.handle-length / 2.0)
                            / max(1px, root.width - root.handle-length),
                        0.0,
                        1.0
                    ) * root.maximum;
                } else {
                    root.value = -clamp(
                        (self.mouse-y - root.handle-length / 2.0)
                            / max(1px, root.height - root.handle-length),
                        0.0,
                        1.0
                    ) * root.maximum;
                }
            }
        }
        clicked => {
            scroll-focus.focus();
            if (root.horizontal) {
                root.value = -clamp(
                    (self.mouse-x - root.handle-length / 2.0)
                        / max(1px, root.width - root.handle-length),
                    0.0,
                    1.0
                ) * root.maximum;
            } else {
                root.value = -clamp(
                    (self.mouse-y - root.handle-length / 2.0)
                        / max(1px, root.height - root.handle-length),
                    0.0,
                    1.0
                ) * root.maximum;
            }
        }
    }
}

export component SheetsApp inherits Window {
    title: "Loom Sheets";
    min-width: 900px;
    min-height: 680px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.palette().canvas;

    in property <bool> show-quick-formulas: false;
    in property <bool> wide-toolbar: false;
    in property <bool> labeled-export: false;
    in property <bool> overflow-toolbar: false;
    in property <bool> rtl: false;
    in-out property <bool> toolbar-overflow-open: false;
    // Wide/reference windows open the contextual inspector by default. The
    // controller closes it below the compact breakpoint and restores it when
    // returning to a wide window unless the user has explicitly hidden it.
    in-out property <bool> show-inspector: true;
    in property <bool> inspector-available: true;
    property <bool> inspector-visible: root.show-inspector && root.inspector-available;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in-out property <int> inspector-tab: 0;
    in property <bool> inspector-show-table: true;
    in property <bool> inspector-show-cell: true;
    callback window-resized(length);
    changed rtl => {
        Theme.rtl = root.rtl;
    }
    changed width => {
        root.window-resized(root.width);
        if (!ResponsivePolicy.priority-2-overflow(root.width)) {
            root.close-toolbar-overflow();
        }
    }

    in property <string> sheet-name: "Untitled";
    in property <string> status-left: "";
    in property <string> status-right: "";
    in property <[int]> rows: [];
    in property <[int]> cols: [];
    in property <[string]> column-headers: [];
    in property <[string]> row-headers: [];
    in property <[string]> cells: [];
    // The grid renders a bounded slice of the sparse workbook. These are
    // zero-based worksheet coordinates, not visual row/column indexes.
    in property <int> view-row-origin: 0;
    in property <int> view-col-origin: 0;
    in property <int> workbook-rows: 1;
    in property <int> workbook-cols: 1;
    in property <length> grid-col-width: 80px;
    in property <length> grid-row-height: 24px;
    in property <length> grid-col-offset: 0px;
    in property <length> grid-row-offset: 0px;
    in property <length> grid-visible-width: 640px;
    in property <length> grid-visible-height: 360px;
    in property <length> grid-content-width: 640px;
    in property <length> grid-content-height: 360px;
    in property <[length]> grid-column-widths: [];
    in property <[length]> grid-row-heights: [];
    in-out property <length> grid-scroll-x: 0px;
    in-out property <length> grid-scroll-y: 0px;
    in-out property <length> grid-viewport-width: 720px;
    in-out property <length> grid-viewport-height: 420px;
    in property <string> selected-cell: "A1";
    in property <int> selected-row: 0;
    in property <int> selected-col: 0;
    in property <int> selection-anchor-row: 0;
    in property <int> selection-anchor-col: 0;
    in property <int> selection-start-row: 0;
    in property <int> selection-start-col: 0;
    in property <int> selection-end-row: 0;
    in property <int> selection-end-col: 0;
    in property <string> selection-range: "A1";
    in property <int> selection-count: 1;
    in property <string> selection-formula: "";
    property <string> formula-edit-buffer: "";
    in property <string> selection-value: "";
    in property <string> selection-announcement: "A1 selected; value: Empty";
    in property <string> table-rows-label: "1";
    in property <string> table-cols-label: "1";
    in property <string> selected-row-height: "24 px";
    in property <string> selected-col-width: "80 px";
    in-out property <string> inspector-search: "";
    in-out property <string> formula-feedback: "Ready";

    in-out property <bool> template-chooser-open: false;
    in-out property <int> template-selected: 0;
    in-out property <int> template-category: 0;

    callback new-sheet;
    callback open-sheet;
    callback save-sheet;
    callback save-as-sheet;
    callback export-csv;
    callback undo;
    callback redo;
    callback cell-clicked(int, int);
    callback commit-selected-cell(string);
    callback cancel-selected-cell;
    callback quick-formula(string);
    callback navigate-selection(int, int);
    callback extend-selection(int, int);
    callback fill-selection;
    callback grid-scrolled;
    callback grid-viewport-changed(length, length);
    callback inspector-search-edited(string);
    callback inspector-context-changed(int);
    callback toggle-inspector;
    callback create-template(int);
    callback cancel-template;

    in-out property <[CommandPaletteItem]> palette-commands: [];
    in-out property <bool> palette-open: false;
    in-out property <string> palette-query: "";
    in-out property <int> palette-selected: 0;
    callback palette-invoked(int);
    callback palette-query-changed(string);
    callback palette-move(int);
    callback palette-key-text(string);
    callback palette-backspace;
    callback palette-close;

    public function open-palette() {
        root.palette-open = true;
        root.palette-query = "";
        palette.grab-focus();
    }

    // Exposed for the native grid journey and for restoring keyboard focus
    // after a formula-bar or toolbar interaction.
    public function focus-grid() {
        grid-focus.focus();
    }

    public function reset-formula-edit-buffer() {
        formula-edit-buffer = selection-formula;
    }

    function template-visible(template-index: int) -> bool {
        return root.template-category == 0
            || (root.template-category == 1 && template-index == 0)
            || (root.template-category == 2 && template-index == 1)
            || (root.template-category == 3 && template-index >= 2);
    }

    function choose-template-category(category-index: int) {
        root.template-category = category-index;
        if (category-index == 1) {
            root.template-selected = 0;
        } else if (category-index == 2) {
            root.template-selected = 1;
        } else if (category-index == 3) {
            root.template-selected = 2;
        }
    }

    function compact-label(full-label: string) -> string {
        return root.wide-toolbar ? full-label : "";
    }

    public function close-toolbar-overflow() {
        if (root.toolbar-overflow-open) {
            root.toolbar-overflow-open = false;
            app-focus.focus();
        }
    }

    changed overflow-toolbar => {
        if (!root.overflow-toolbar) {
            root.close-toolbar-overflow();
        }
    }

    overflow-menu-focus := FocusScope {
        enabled: root.toolbar-overflow-open;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-toolbar-overflow();
                return accept;
            }
            return reject;
        }
    }

    template-chooser-focus := FocusScope {
        enabled: root.template-chooser-open;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel-template();
                return accept;
            }
            if (event.text == Key.Return) {
                root.create-template(root.template-selected);
                return accept;
            }
            return reject;
        }
    }

    changed template-chooser-open => {
        if (root.template-chooser-open) {
            template-chooser-focus.focus();
        } else {
            app-focus.focus();
        }
    }

    app-focus := FocusScope {
        key-pressed(event) => {
            if (root.palette-open || root.template-chooser-open || root.toolbar-overflow-open) { return reject; }
            if (event.modifiers.control || event.modifiers.meta) {
                if (event.text == Key.K || event.text == "k") {
                    root.open-palette();
                    return accept;
                }
                if (event.text == "n" || event.text == "N") {
                    root.new-sheet();
                    return accept;
                }
                if (event.text == "o" || event.text == "O") {
                    root.open-sheet();
                    return accept;
                }
                if (event.text == "s" || event.text == "S") {
                    if (event.modifiers.shift) { root.save-as-sheet(); } else { root.save-sheet(); }
                    return accept;
                }
                if (event.text == "e" || event.text == "E") {
                    root.export-csv();
                    return accept;
                }
            }
            if (event.text == Key.LeftArrow) {
                if (event.modifiers.shift) { root.extend-selection(0, -1); } else { root.navigate-selection(0, -1); }
                return accept;
            }
            if (event.text == Key.RightArrow) {
                if (event.modifiers.shift) { root.extend-selection(0, 1); } else { root.navigate-selection(0, 1); }
                return accept;
            }
            if (event.text == Key.UpArrow) {
                if (event.modifiers.shift) { root.extend-selection(-1, 0); } else { root.navigate-selection(-1, 0); }
                return accept;
            }
            if (event.text == Key.DownArrow) {
                if (event.modifiers.shift) { root.extend-selection(1, 0); } else { root.navigate-selection(1, 0); }
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0px;
            padding: 0px;

            // Document Chrome Header
            TitleChrome {
                title: root.sheet-name;
                trailing-text: "";
            }

            // Apple Numbers-style Sheet Tab Bar
            Rectangle {
                height: 32px;
                background: Theme.palette().chrome;

                HorizontalLayout {
                    spacing: 4px;
                    padding-left: 12px;
                    padding-right: 12px;
                    cross-axis-alignment: center;

                    // Active Sheet Tab
                    Rectangle {
                        width: 108px;
                        height: 26px;
                        border-radius: Theme.tokens.metrics.radius-small;
                        background: Theme.palette().accent;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Icon { size: 14px; icon: "table"; tint: Theme.palette().accent-ink; }
                            Text {
                                text: root.sheet-name;
                                font-size: Theme.tokens.typography.caption;
                                font-weight: 600;
                                color: Theme.palette().accent-ink;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Add Sheet Button (+)
                    IconOnlyToolbarItem {
                        icon: "plus";
                        label: "Add sheet unavailable";
                        enabled: false;
                    }

                    ToolbarSpacer { }
                }

                Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.palette().border; }
            }

            // Action toolbar. The host is selected explicitly so a 40px
            // context row never stretches the labeled controls.
            if root.wide-toolbar : LabeledToolbar {
                SheetsToolbarBody {
                    wide: true;
                    overflow: root.overflow-toolbar;
                    inspector-available: root.inspector-available;
                    inspector-visible: root.inspector-visible;
                    labeled-export: root.labeled-export;
                    toggle-inspector => { root.toggle-inspector(); }
                    export-csv => { root.export-csv(); }
                    overflow-requested => {
                        if (root.toolbar-overflow-open) {
                            root.close-toolbar-overflow();
                        } else {
                            root.toolbar-overflow-open = true;
                            overflow-menu-focus.focus();
                        }
                    }
                }
            }
            if !root.wide-toolbar : ContextToolbar {
                SheetsToolbarBody {
                    wide: false;
                    overflow: root.overflow-toolbar;
                    inspector-available: root.inspector-available;
                    inspector-visible: root.inspector-visible;
                    labeled-export: root.labeled-export;
                    toggle-inspector => { root.toggle-inspector(); }
                    export-csv => { root.export-csv(); }
                    overflow-requested => {
                        if (root.toolbar-overflow-open) {
                            root.close-toolbar-overflow();
                        } else {
                            root.toolbar-overflow-open = true;
                            overflow-menu-focus.focus();
                        }
                    }
                }
            }

            // Formula Bar
            Rectangle {
                min-height: 32px;
                max-height: 32px;
                background: Theme.palette().chrome;

                HorizontalLayout {
                    spacing: 6px;
                    padding-left: 12px;
                    padding-right: 12px;
                    cross-axis-alignment: center;

                    Rectangle {
                        width: 78px;
                        height: 24px;
                        border-radius: Theme.tokens.metrics.radius-small;
                        border-width: 1px;
                        border-color: Theme.palette().border;
                        background: Theme.palette().surface-sunken;
                        Text {
                            text: root.selection-range;
                            font-weight: 600;
                            font-size: Theme.tokens.typography.caption;
                            color: Theme.palette().ink;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "fx";
                        width: 20px;
                        font-size: Theme.tokens.typography.body;
                        font-weight: 700;
                        color: Theme.palette().accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    Field {
                        label: "Selected cell formula or value";
                        placeholder: "Enter a value or formula (=SUM, =AVERAGE)";
                        value <=> root.formula-edit-buffer;
                        horizontal-stretch: 1;
                        accepted(text) => { root.commit-selected-cell(text); }
                        cancelled => {
                            root.formula-edit-buffer = root.selection-formula;
                            root.cancel-selected-cell();
                        }
                    }

                    // Quick formula buttons appear only when the wide toolbar
                    // breakpoint has enough room beside the formula field.
                    if root.show-quick-formulas : HorizontalLayout {
                        spacing: 2px;
                        ToolbarButton { label: "SUM"; clicked => { root.quick-formula("SUM"); } }
                        ToolbarButton { label: "AVG"; clicked => { root.quick-formula("AVERAGE"); } }
                        ToolbarButton { label: "COUNT"; clicked => { root.quick-formula("COUNT"); } }
                    }

                    IconOnlyToolbarItem {
                        icon: "check";
                        label: "Commit formula";
                        clicked => { root.commit-selected-cell(root.formula-edit-buffer); }
                    }
                    IconOnlyToolbarItem {
                        icon: "close";
                        label: "Cancel editing";
                        clicked => {
                            root.formula-edit-buffer = root.selection-formula;
                            root.cancel-selected-cell();
                        }
                    }
                    ToolbarButton {
                        label: "Fill down";
                        enabled: root.selection-count > 1;
                        clicked => { root.fill-selection(); }
                    }
                }

                Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.palette().border; }
            }

            // Main Spreadsheet Canvas and Right Inspector
            DirectionalLayout {
                spacing: 0px;
                vertical-stretch: 1;

                // Spreadsheet Canvas Area
                CanvasSurface {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    // Keep keyboard navigation attached to the spreadsheet
                    // rather than whichever toolbar or field was last
                    // clicked. Cell clicks explicitly focus this scope below
                    // so arrow keys continue the visible selection journey.
                    grid-focus := FocusScope {
                        key-pressed(event) => {
                            if (event.text == Key.LeftArrow) {
                                if (event.modifiers.shift) { root.extend-selection(0, -1); } else { root.navigate-selection(0, -1); }
                                return accept;
                            }
                            if (event.text == Key.RightArrow) {
                                if (event.modifiers.shift) { root.extend-selection(0, 1); } else { root.navigate-selection(0, 1); }
                                return accept;
                            }
                            if (event.text == Key.UpArrow) {
                                if (event.modifiers.shift) { root.extend-selection(-1, 0); } else { root.navigate-selection(-1, 0); }
                                return accept;
                            }
                            if (event.text == Key.DownArrow) {
                                if (event.modifiers.shift) { root.extend-selection(1, 0); } else { root.navigate-selection(1, 0); }
                                return accept;
                            }
                            return reject;
                        }
                    }

                    // Table Sheet Container with drop shadow
                    Rectangle {
                        x: 24px;
                        y: 20px;
                        width: max(1px, parent.width - 48px);
                        height: max(1px, parent.height - 40px);
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Theme.palette().border;
                        background: Theme.palette().surface;
                        drop-shadow-blur: 12px;
                        drop-shadow-offset-y: 4px;
                        drop-shadow-color: Theme.palette().shadow;
                        clip: true;

                        VerticalLayout {
                            spacing: 0px;

                            // Table Name Banner
                            Rectangle {
                                height: 28px;
                                background: Theme.palette().surface;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    cross-axis-alignment: center;
                                    Text {
                                        text: root.sheet-name + " table";
                                        font-size: Theme.tokens.typography.title;
                                        font-weight: 700;
                                        color: Theme.palette().ink;
                                    }
                                }
                                Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.palette().border; }
                            }

                            // Virtualized spreadsheet grid.  Flickable owns the
                            // full workbook extent and only the projected rows
                            // and columns are materialized inside it.
                            grid-viewport := Rectangle {
                                horizontal-stretch: 1;
                                vertical-stretch: 1;
                                // Keep the materialized window large enough
                                // for the default 15-row editing surface
                                // during the initial layout pass. Without a
                                // floor the nested Flickable/GridLayout can
                                // collapse to its two-row intrinsic height
                                // before the viewport callback runs.
                                min-height: 386px;
                                clip: true;
                                accessible-role: table;
                                accessible-label: root.selection-announcement;
                                changed width => { root.grid-viewport-width = self.width; root.grid-viewport-changed(self.width, self.height); }
                                changed height => { root.grid-viewport-height = self.height; root.grid-viewport-changed(self.width, self.height); }

                                grid-flick := Flickable {
                                    width: parent.width;
                                    height: parent.height;
                                    viewport-width: max(parent.width, 36px + root.grid-content-width);
                                    viewport-height: max(parent.height, 26px + root.grid-content-height);
                                    viewport-x <=> root.grid-scroll-x;
                                    viewport-y <=> root.grid-scroll-y;
                                    flicked => { root.grid-scrolled(); }

                                    projected-grid := GridLayout {
                                        x: root.grid-col-offset;
                                        y: root.grid-row-offset;
                                        width: 36px + root.grid-visible-width;
                                        height: 26px + root.grid-visible-height;
                                        spacing: 0px;

                                        // Column Headers Row
                                        Row {
                                            Rectangle {
                                                width: 36px;
                                                min-height: 26px;
                                                max-height: 26px;
                                                background: Theme.palette().chrome;
                                                border-width: 1px;
                                                border-color: Theme.palette().border;
                                            }
                                            for c in root.cols : Rectangle {
                                                min-width: root.grid-column-widths[c];
                                                max-width: root.grid-column-widths[c];
                                                min-height: 26px;
                                                max-height: 26px;
                                                background: c + root.view-col-origin >= root.selection-start-col && c + root.view-col-origin <= root.selection-end-col ? Theme.palette().selection-soft : Theme.palette().chrome;
                                                border-width: c + root.view-col-origin == root.selected-col ? 2px : 1px;
                                                border-color: c + root.view-col-origin == root.selected-col ? Theme.palette().accent : Theme.palette().grid-major;

                                                Text {
                                                    text: root.column-headers[c];
                                                    font-size: Theme.tokens.typography.caption;
                                                    font-weight: c + root.view-col-origin == root.selected-col ? 700 : 500;
                                                    color: c + root.view-col-origin == root.selected-col ? Theme.palette().accent : Theme.palette().ink-secondary;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Data Rows
                                        for r in root.rows : Row {
                                            Rectangle {
                                                width: 36px;
                                                min-height: root.grid-row-heights[r];
                                                max-height: root.grid-row-heights[r];
                                                background: r + root.view-row-origin >= root.selection-start-row && r + root.view-row-origin <= root.selection-end-row ? Theme.palette().selection-soft : Theme.palette().chrome;
                                                border-width: r + root.view-row-origin == root.selected-row ? 2px : 1px;
                                                border-color: r + root.view-row-origin == root.selected-row ? Theme.palette().accent : Theme.palette().grid-major;
                                                Text {
                                                    text: root.row-headers[r];
                                                    font-size: Theme.tokens.typography.caption;
                                                    font-weight: r + root.view-row-origin == root.selected-row ? 700 : 500;
                                                    color: r + root.view-row-origin == root.selected-row ? Theme.palette().accent : Theme.palette().ink-secondary;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            // Cells
                                            for c in root.cols : Rectangle {
                                                min-width: root.grid-column-widths[c];
                                                max-width: root.grid-column-widths[c];
                                                min-height: root.grid-row-heights[r];
                                                max-height: root.grid-row-heights[r];
                                                property <int> global-row: r + root.view-row-origin;
                                                property <int> global-col: c + root.view-col-origin;
                                                property <bool> in-selection: global-row >= root.selection-start-row
                                                    && global-row <= root.selection-end-row
                                                    && global-col >= root.selection-start-col
                                                    && global-col <= root.selection-end-col;
                                                property <bool> is-active: global-row == root.selected-row && global-col == root.selected-col;
                                                background: is-active ? Theme.palette().selection-soft
                                                    : in-selection ? Theme.palette().selection-soft
                                                    : (Math.mod(global-row, 2) == 1) ? Theme.palette().surface-sunken : Theme.palette().surface;
                                                border-width: is-active ? 2px : in-selection ? 1px : 1px;
                                                border-color: is-active || in-selection ? Theme.palette().accent : Theme.palette().grid-minor;

                                                Text {
                                                    x: 8px;
                                                    width: parent.width - 16px;
                                                    height: parent.height;
                                                    text: root.cells[r * root.cols.length + c];
                                                    font-size: Theme.tokens.typography.body;
                                                    font-weight: (global-row == 0) ? 600 : 400;
                                                    color: Theme.palette().ink;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }

                                                // Selection fill handle doubles as
                                                // an explicit, keyboard-reachable
                                                // fill affordance for range edits.
                                                if is-active : Rectangle {
                                                    x: parent.width - 7px;
                                                    y: parent.height - 7px;
                                                    width: 8px;
                                                    height: 8px;
                                                    border-radius: 2px;
                                                    background: Theme.palette().accent;
                                                    TouchArea {
                                                        clicked => { root.fill-selection(); }
                                                    }
                                                }

                                                TouchArea {
                                                    clicked => {
                                                        grid-focus.focus();
                                                        root.cell-clicked(global-row, global-col);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }

                                // Include the frozen row header in the scroll
                                // extent.  Without the 26px header offset the
                                // bar stayed hidden for a nearly-full view and
                                // the last rows could be reached only through
                                // wheel gestures.
                                if 26px + root.grid-content-height > grid-viewport.height : SheetScrollBar {
                                    x: grid-viewport.width - 9px;
                                    y: 0px;
                                    width: 9px;
                                    height: grid-viewport.height;
                                    maximum: max(0px, 26px + root.grid-content-height - grid-viewport.height);
                                    page-size: grid-viewport.height;
                                    value <=> root.grid-scroll-y;
                                }
                                // Likewise account for the frozen column
                                // header before deciding whether horizontal
                                // scrolling needs an explicit affordance.
                                if 36px + root.grid-content-width > grid-viewport.width : SheetScrollBar {
                                    x: 0px;
                                    y: grid-viewport.height - 9px;
                                    width: grid-viewport.width;
                                    height: 9px;
                                    maximum: max(0px, 36px + root.grid-content-width - grid-viewport.width);
                                    page-size: grid-viewport.width;
                                    value <=> root.grid-scroll-x;
                                }
                            }
                        }
                    }
                }

                // Contextual inspector: one searchable scrolling column.  It
                // reflects the live worksheet and selection; unsupported
                // formatting controls are intentionally not presented as if
                // they were editable.
                if root.inspector-visible : InspectorSurface {
                    title: root.selection-range + " selection";
                    width: 280px;

                    VerticalLayout {
                        // InspectorSurface supplies the canonical 12px panel
                        // inset.  Keep this child layout unpadded so fields
                        // reach the shared control edge instead of forming a
                        // second, cramped inset inside the inspector.
                        spacing: Theme.tokens.space.lg;
                        padding: 0px;

                        SearchField {
                            label: "Search inspector properties";
                            placeholder: "Search properties…";
                            value <=> root.inspector-search;
                            edited(text) => { root.inspector-search-edited(text); }
                        }

                        // Keep the context explicit, like a professional
                        // spreadsheet inspector: table-level options and
                        // selection-level options are separate views.  The
                        // same `inspector-tab` state drives the visible
                        // section and the accessibility-selected tab.
                        SheetTabStrip {
                            tabs: ["Table", "Cell"];
                            current <=> root.inspector-tab;
                            selected(index) => { root.inspector-context-changed(index); }
                        }

                        Flickable {
                            horizontal-stretch: 1;
                            vertical-stretch: 1;
                            viewport-width: parent.width;
                            viewport-height: max(parent.height, 460px);

                            VerticalLayout {
                                width: parent.width;
                                spacing: 12px;

                                if root.inspector-tab == 0 && root.inspector-show-table : VerticalLayout {
                                    spacing: 8px;
                                    SectionHeader { title: "Table"; }
                                    PropertyRow {
                                        label: "Name";
                                        Field { label: "Table name"; value: root.sheet-name; enabled: false; }
                                    }
                                    PropertyRow {
                                        label: "Rows";
                                        Field { label: "Worksheet rows"; value: root.table-rows-label; enabled: false; }
                                    }
                                    PropertyRow {
                                        label: "Columns";
                                        Field { label: "Worksheet columns"; value: root.table-cols-label; enabled: false; }
                                    }
                                }

                                if root.inspector-tab == 1 && root.inspector-show-cell : VerticalLayout {
                                    spacing: 8px;
                                    SectionHeader { title: "Cell"; }
                                    PropertyRow {
                                        label: "Selection";
                                        Field { label: "Selected range"; value: root.selection-range; enabled: false; }
                                    }
                                    PropertyRow {
                                        label: "Value";
                                        Field { label: "Displayed value"; value: root.selection-value == "" ? "Empty" : root.selection-value; enabled: false; }
                                    }
                                    PropertyRow {
                                        label: "Formula";
                                        Field { label: "Raw formula"; value: root.selection-formula == "" ? "—" : root.selection-formula; enabled: false; }
                                    }
                                    PropertyRow {
                                        label: "Row height";
                                        Field { label: "Selected row height"; value: root.selected-row-height; enabled: false; }
                                    }
                                    PropertyRow {
                                        label: "Column width";
                                        Field { label: "Selected column width"; value: root.selected-col-width; enabled: false; }
                                    }
                                }

                                if (root.inspector-tab == 0 && !root.inspector-show-table)
                                    || (root.inspector-tab == 1 && !root.inspector-show-cell) : Rectangle {
                                    height: 72px;
                                    Text {
                                        text: "No matching properties";
                                        color: Theme.palette().ink-secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle { vertical-stretch: 1; background: transparent; }
                            }
                        }
                    }
                }
            }

            // Standard Status Bar
            StatusBar {
                leading: root.status-left;
                trailing: root.status-right;
            }
        }
    }

    // Compact toolbars keep the primary workspace clear and expose every
    // currently actionable toolbar command through one real,
    // keyboard-accessible menu.
    if root.toolbar-overflow-open && root.overflow-toolbar : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: transparent;

        TouchArea {
            clicked => { root.close-toolbar-overflow(); }
        }

        Rectangle {
            x: max(8px, root.width - 272px);
            y: Theme.tokens.metrics.header-height + 32px + 8px;
            width: 256px;
            height: 76px;
            border-radius: Theme.tokens.metrics.radius-medium;
            border-width: 1px;
            border-color: Theme.palette().border;
            background: Theme.palette().surface;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.palette().shadow;

            VerticalLayout {
                spacing: 4px;
                padding: 8px;

                ToolbarButton {
                    icon: "export";
                    label: "Export CSV";
                    horizontal-stretch: 1;
                    clicked => { root.export-csv(); root.close-toolbar-overflow(); }
                }
            }
        }
    }

    // Numbers-Style Template Chooser Modal
    if root.template-chooser-open : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: Theme.palette().scrim;

        Rectangle {
            // Template selection is a primary workspace, not a compact
            // confirmation sheet. Match the desktop scale while preserving
            // an outer margin at the supported compact size.
            width: min(1160px, max(1px, parent.width - 48px));
            x: (parent.width - self.width) / 2;
            height: min(760px, max(480px, parent.height - 48px));
            y: (parent.height - self.height) / 2;
            border-radius: Theme.tokens.metrics.radius-large;
            border-width: 1px;
            border-color: Theme.palette().border;
            background: Theme.palette().surface;
            clip: true;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: Theme.palette().shadow;

            VerticalLayout {
                spacing: 0px;
                padding: 0px;

                HorizontalLayout {
                    spacing: 0px;
                    vertical-stretch: 1;

                    // Sidebar
                    Rectangle {
                        width: 220px;
                        background: Theme.palette().panel;

                        VerticalLayout {
                            spacing: 4px;
                            padding-top: 16px;
                            padding-bottom: 16px;
                            padding-left: 12px;
                            padding-right: 12px;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-bottom: 4px;
                                Text {
                                    text: "TEMPLATES";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: Theme.palette().ink-secondary;
                                }
                            }

                            Rectangle {
                                height: 32px;
                                border-radius: Theme.tokens.metrics.radius-medium;
                                background: root.template-category == 0 ? Theme.palette().surface-raised : transparent;
                                HorizontalLayout {
                                    spacing: 8px; padding-left: 10px; padding-right: 10px; cross-axis-alignment: center;
                                    Icon { size: 16px; icon: "grid"; tint: root.template-category == 0 ? Theme.palette().accent : Theme.palette().ink-secondary; }
                                    Text {
                                        text: "All Templates";
                                        font-size: Theme.tokens.typography.body;
                                        font-weight: root.template-category == 0 ? 600 : 400;
                                        color: Theme.palette().ink;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.choose-template-category(0); } }
                            }

                            Rectangle {
                                height: 32px;
                                border-radius: Theme.tokens.metrics.radius-medium;
                                background: root.template-category == 1 ? Theme.palette().surface-raised : transparent;
                                HorizontalLayout {
                                    spacing: 8px; padding-left: 10px; padding-right: 10px; cross-axis-alignment: center;
                                    Icon { size: 16px; icon: "table"; tint: root.template-category == 1 ? Theme.palette().accent : Theme.palette().ink-secondary; }
                                    Text {
                                        text: "Basic";
                                        font-size: Theme.tokens.typography.body;
                                        font-weight: root.template-category == 1 ? 600 : 400;
                                        color: Theme.palette().ink;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.choose-template-category(1); } }
                            }

                            Rectangle {
                                height: 32px;
                                border-radius: Theme.tokens.metrics.radius-medium;
                                background: root.template-category == 2 ? Theme.palette().surface-raised : transparent;
                                HorizontalLayout {
                                    spacing: 8px; padding-left: 10px; padding-right: 10px; cross-axis-alignment: center;
                                    Icon { size: 16px; icon: "chart"; tint: root.template-category == 2 ? Theme.palette().accent : Theme.palette().ink-secondary; }
                                    Text {
                                        text: "Personal Finance";
                                        font-size: Theme.tokens.typography.body;
                                        font-weight: root.template-category == 2 ? 600 : 400;
                                        color: Theme.palette().ink;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.choose-template-category(2); } }
                            }

                            Rectangle {
                                height: 32px;
                                border-radius: Theme.tokens.metrics.radius-medium;
                                background: root.template-category == 3 ? Theme.palette().surface-raised : transparent;
                                HorizontalLayout {
                                    spacing: 8px; padding-left: 10px; padding-right: 10px; cross-axis-alignment: center;
                                    Icon { size: 16px; icon: "folder"; tint: root.template-category == 3 ? Theme.palette().accent : Theme.palette().ink-secondary; }
                                    Text {
                                        text: "Business";
                                        font-size: Theme.tokens.typography.body;
                                        font-weight: root.template-category == 3 ? 600 : 400;
                                        color: Theme.palette().ink;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.choose-template-category(3); } }
                            }

                            Rectangle { vertical-stretch: 1; background: transparent; }

                            HorizontalLayout {
                                spacing: 6px; padding: 8px;
                                Text {
                                    text: "English (US)";
                                    font-size: Theme.tokens.typography.caption;
                                    color: Theme.palette().ink-secondary;
                                    vertical-alignment: center;
                                }
                                Icon { size: 12px; icon: "chevron-down"; tint: Theme.palette().ink-secondary; }
                            }
                        }

                        Rectangle { x: parent.width - 1px; y: 0px; width: 1px; height: parent.height; background: Theme.palette().border; }
                    }

                    // Content Area
                    VerticalLayout {
                        horizontal-stretch: 1;
                        padding-top: 24px;
                        padding-bottom: 20px;
                        padding-left: 28px;
                        padding-right: 28px;
                        spacing: 16px;

                        Text {
                            text: "Choose a Template";
                            font-size: 24px;
                            font-weight: 700;
                            color: Theme.palette().ink;
                        }

                        VerticalLayout {
                            spacing: 16px;

                            HorizontalLayout {
                                spacing: 16px;

                                if root.template-visible(0) : SheetTemplateCard {
                                    template-index: 0;
                                    template-name: "Blank";
                                    description: "Simple table layout";
                                    selected: root.template-selected == 0;
                                    clicked => { root.template-selected = 0; }
                                }

                                if root.template-visible(1) : SheetTemplateCard {
                                    template-index: 1;
                                    template-name: "Monthly Budget";
                                    description: "Income and expenses tracker";
                                    selected: root.template-selected == 1;
                                    clicked => { root.template-selected = 1; }
                                }
                            }

                            HorizontalLayout {
                                spacing: 16px;

                                if root.template-visible(2) : SheetTemplateCard {
                                    template-index: 2;
                                    template-name: "Invoice & Expenses";
                                    description: "Track billing and totals";
                                    selected: root.template-selected == 2;
                                    clicked => { root.template-selected = 2; }
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }
                }

                // Footer Bar
                Rectangle {
                    height: 56px;
                    background: Theme.palette().chrome;

                    Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.palette().border; }

                    HorizontalLayout {
                        spacing: 12px;
                        padding-left: 20px;
                        padding-right: 20px;
                        cross-axis-alignment: center;

                        Text {
                            text: "Escape to cancel • Return to create";
                            font-size: Theme.tokens.typography.caption;
                            color: Theme.palette().ink-secondary;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }

                        ToolbarButton {
                            label: "Cancel";
                            clicked => { root.cancel-template(); }
                        }

                        ToolbarButton {
                            label: "Create Spreadsheet";
                            primary: true;
                            clicked => { root.create-template(root.template-selected); }
                        }
                    }
                }
            }
        }
    }

    palette := CommandPalette {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        open: root.palette-open;
        commands: root.palette-commands;
        query: root.palette-query;
        selected: root.palette-selected;
        command-invoked(idx) => { root.palette-invoked(idx); }
        query-changed(q) => {
            root.palette-query = q;
            root.palette-query-changed(q);
        }
        move-selection(delta) => { root.palette-move(delta); }
        key-text(text) => { root.palette-key-text(text); }
        backspace => { root.palette-backspace(); }
        close-requested => {
            root.palette-open = false;
            root.palette-close();
        }
    }
}
