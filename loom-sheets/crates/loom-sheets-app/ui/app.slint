import {
    DocumentChrome, Toolbar, ToolbarGroup, ToolbarSpacer, ToolbarButton,
    ToolbarIconButton, ToolbarOverflowButton, AppleToolbarItem, ToolkitStatusBar, CanvasSurface, InspectorSurface,
    SectionHeader, TextField, SegmentedControl, PropertyRow, TabStrip, Toggle
} from "toolkit.slint";
import { CommandPalette, CommandPaletteItem } from "components.slint";
import { Icon } from "icons.slint";
import { Theme } from "theme.slint";
export { Theme } from "theme.slint";

/// Numbers-style spreadsheet template card
component SheetTemplateCard inherits Rectangle {
    in property <int> template-index: 0;
    in property <string> template-name: "Blank";
    in property <string> description: "Start from a blank table";
    in property <bool> selected: false;
    callback clicked;

    width: 180px;
    height: 185px;
    border-radius: Theme.tokens.metrics.radius-medium;
    background: touch.has-hover && !root.selected ? Theme.palette().surface-raised : transparent;
    accessible-role: button;
    accessible-label: root.template-name + " template";
    accessible-action-default => { root.clicked(); }

    VerticalLayout {
        spacing: 10px;
        padding: 6px;
        alignment: center;
        cross-axis-alignment: center;

        Rectangle {
            width: 160px;
            height: 115px;
            border-radius: 4px;
            border-width: root.selected ? 2.5px : 1px;
            border-color: root.selected ? Theme.palette().accent : Theme.palette().paper-line;
            background: Theme.palette().paper;
            drop-shadow-blur: 10px;
            drop-shadow-offset-y: 3px;
            drop-shadow-color: Theme.palette().shadow;
            clip: true;

            // Sheet Template Preview Grid
            VerticalLayout {
                spacing: 0px;

                // Header row
                Rectangle {
                    height: 20px;
                    background: root.template-index == 1 ? Theme.palette().accent
                        : root.template-index == 2 ? Theme.palette().content-cool
                        : Theme.palette().surface-sunken;
                    HorizontalLayout {
                        spacing: 1px;
                        Rectangle { width: 40px; }
                        Rectangle { width: 1px; background: Theme.palette().border; }
                        Rectangle { width: 50px; }
                        Rectangle { width: 1px; background: Theme.palette().border; }
                        Rectangle { width: 50px; }
                        Rectangle { width: 1px; background: Theme.palette().border; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                // Grid rows
                for idx in 5 : Rectangle {
                    height: 19px;
                    background: (Math.mod(idx, 2) == 1 && root.template-index != 0) ? Theme.palette().surface-sunken : Theme.palette().paper;
                    Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.palette().paper-line; }
                    HorizontalLayout {
                        spacing: 1px;
                        Rectangle { width: 40px; }
                        Rectangle { width: 1px; background: Theme.palette().paper-line; }
                        Rectangle { width: 50px; }
                        Rectangle { width: 1px; background: Theme.palette().paper-line; }
                        Rectangle { width: 50px; }
                        Rectangle { width: 1px; background: Theme.palette().paper-line; }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }

        if root.selected : Rectangle {
            height: 20px;
            border-radius: 4px;
            background: Theme.palette().accent;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                alignment: center;
                cross-axis-alignment: center;
                Text {
                    text: root.template-name;
                    font-size: 11px;
                    font-weight: 700;
                    color: Theme.palette().accent-ink;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        if !root.selected : Text {
            text: root.template-name;
            font-size: 11px;
            font-weight: 500;
            color: Theme.palette().ink;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

export component SheetsApp inherits Window {
    title: "Loom Sheets";
    min-width: 900px;
    min-height: 680px;
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.palette().canvas;

    in property <bool> show-quick-formulas: false;
    in property <bool> wide-toolbar: false;
    in property <bool> labeled-export: false;
    in-out property <bool> toolbar-overflow-open: false;
    in-out property <bool> show-inspector: false;
    in property <bool> inspector-available: true;
    property <bool> inspector-visible: root.show-inspector && root.inspector-available;
    in-out property <int> inspector-tab: 0;
    callback window-resized(length);
    changed width => { root.window-resized(root.width); }

    in property <string> sheet-name: "Untitled";
    in property <string> status-left: "";
    in property <string> status-right: "";
    in property <[int]> rows: [];
    in property <[int]> cols: [];
    in property <[string]> column-headers: [];
    in property <[string]> row-headers: [];
    in property <[string]> cells: [];
    in property <string> selected-cell: "A1";
    in property <int> selected-row: 0;
    in property <int> selected-col: 0;
    in property <string> selection-formula: "";
    property <string> formula-edit-buffer: "";
    in property <string> selection-value: "";
    in-out property <string> formula-feedback: "Ready";

    in-out property <bool> template-chooser-open: false;
    in-out property <int> template-selected: 0;
    in-out property <int> template-category: 0;

    callback new-sheet;
    callback open-sheet;
    callback save-sheet;
    callback save-as-sheet;
    callback export-csv;
    callback undo;
    callback redo;
    callback cell-clicked(int, int);
    callback commit-selected-cell(string);
    callback cancel-selected-cell;
    callback quick-formula(string);
    callback toggle-inspector;
    callback create-template(int);
    callback cancel-template;

    in-out property <[CommandPaletteItem]> palette-commands: [];
    in-out property <bool> palette-open: false;
    in-out property <string> palette-query: "";
    in-out property <int> palette-selected: 0;
    callback palette-invoked(int);
    callback palette-query-changed(string);
    callback palette-move(int);
    callback palette-key-text(string);
    callback palette-backspace;
    callback palette-close;

    public function open-palette() {
        root.palette-open = true;
        root.palette-query = "";
        palette.grab-focus();
    }

    public function reset-formula-edit-buffer() {
        formula-edit-buffer = selection-formula;
    }

    function template-visible(template-index: int) -> bool {
        return root.template-category == 0
            || (root.template-category == 1 && template-index == 0)
            || (root.template-category == 2 && template-index == 1)
            || (root.template-category == 3 && template-index >= 2);
    }

    function choose-template-category(category-index: int) {
        root.template-category = category-index;
        if (category-index == 1) {
            root.template-selected = 0;
        } else if (category-index == 2) {
            root.template-selected = 1;
        } else if (category-index == 3) {
            root.template-selected = 2;
        }
    }

    function compact-label(full-label: string) -> string {
        return root.wide-toolbar ? full-label : "";
    }

    overflow-menu-focus := FocusScope {
        enabled: root.toolbar-overflow-open;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.toolbar-overflow-open = false;
                app-focus.focus();
                return accept;
            }
            return reject;
        }
    }

    template-chooser-focus := FocusScope {
        enabled: root.template-chooser-open;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancel-template();
                return accept;
            }
            if (event.text == Key.Return) {
                root.create-template(root.template-selected);
                return accept;
            }
            return reject;
        }
    }

    changed template-chooser-open => {
        if (root.template-chooser-open) {
            template-chooser-focus.focus();
        } else {
            app-focus.focus();
        }
    }

    app-focus := FocusScope {
        key-pressed(event) => {
            if (root.palette-open || root.template-chooser-open || root.toolbar-overflow-open) { return reject; }
            if (event.modifiers.control || event.modifiers.meta) {
                if (event.text == Key.K || event.text == "k") {
                    root.open-palette();
                    return accept;
                }
                if (event.text == "n" || event.text == "N") {
                    root.new-sheet();
                    return accept;
                }
                if (event.text == "o" || event.text == "O") {
                    root.open-sheet();
                    return accept;
                }
                if (event.text == "s" || event.text == "S") {
                    if (event.modifiers.shift) { root.save-as-sheet(); } else { root.save-sheet(); }
                    return accept;
                }
                if (event.text == "e" || event.text == "E") {
                    root.export-csv();
                    return accept;
                }
            }
            return reject;
        }

        VerticalLayout {
            spacing: 0px;
            padding: 0px;

            // Document Chrome Header
            DocumentChrome {
                title: root.sheet-name;
                trailing-text: "";
            }

            // Apple Numbers-style Sheet Tab Bar
            Rectangle {
                height: 32px;
                background: Theme.palette().chrome;

                HorizontalLayout {
                    spacing: 4px;
                    padding-left: 12px;
                    padding-right: 12px;
                    cross-axis-alignment: center;

                    // Active Sheet Tab
                    Rectangle {
                        width: 108px;
                        height: 26px;
                        border-radius: Theme.tokens.metrics.radius-small;
                        background: Theme.palette().accent;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Icon { size: 14px; icon: "table"; tint: Theme.palette().accent-ink; }
                            Text {
                                text: "Sheet 1";
                                font-size: Theme.tokens.typography.caption;
                                font-weight: 600;
                                color: Theme.palette().accent-ink;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Add Sheet Button (+)
                    ToolbarIconButton {
                        icon: "plus";
                        label: "Add sheet";
                        enabled: true;
                        clicked => { root.new-sheet(); }
                    }

                    ToolbarSpacer { }
                }

                Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.palette().border; }
            }

            // Action Toolbar
            Toolbar {
                // Left group: View, page zoom, Add Category
                ToolbarGroup {
                    if root.wide-toolbar : AppleToolbarItem {
                        icon: "eye";
                        label: root.compact-label("View");
                        accessible-label: "View";
                        enabled: root.inspector-available;
                        clicked => { if (root.inspector-available) { root.toggle-inspector(); } }
                    }
                    if root.wide-toolbar : AppleToolbarItem {
                        icon: "zoom-in";
                        label: root.compact-label("Page Zoom");
                        accessible-label: "Page zoom unavailable";
                        enabled: false;
                    }
                    if root.wide-toolbar : AppleToolbarItem {
                        icon: "plus";
                        label: root.compact-label("Add Category");
                        accessible-label: "Add category unavailable";
                        enabled: false;
                    }
                    if !root.wide-toolbar : ToolbarOverflowButton {
                        label: "More Sheets actions";
                        clicked => {
                            root.toolbar-overflow-open = !root.toolbar-overflow-open;
                            if (root.toolbar-overflow-open) { overflow-menu-focus.focus(); }
                        }
                    }
                }

                if root.wide-toolbar : ToolbarSpacer { }

                // Numbers-style center tools: Table, Pivot, Chart, Text, Shape, Media, Comment
                if root.wide-toolbar : ToolbarGroup {
                    AppleToolbarItem { icon: "table"; label: root.compact-label("Table"); accessible-label: "Insert table unavailable"; enabled: false; }
                    AppleToolbarItem { icon: "grid"; label: root.compact-label("Pivot Table"); accessible-label: "Insert pivot table unavailable"; enabled: false; }
                    AppleToolbarItem { icon: "chart"; label: root.compact-label("Chart"); accessible-label: "Insert chart unavailable"; enabled: false; }
                    AppleToolbarItem { icon: "text"; label: root.compact-label("Text"); accessible-label: "Insert text box unavailable"; enabled: false; }
                    AppleToolbarItem { icon: "shape"; label: root.compact-label("Shape"); accessible-label: "Insert shape unavailable"; enabled: false; }
                    AppleToolbarItem { icon: "image"; label: root.compact-label("Media"); accessible-label: "Insert media unavailable"; enabled: false; }
                    AppleToolbarItem { icon: "comment"; label: root.compact-label("Comment"); accessible-label: "Insert comment unavailable"; enabled: false; }
                }

                if root.wide-toolbar : ToolbarSpacer { }

                // Right tools: Share, Format, Organize, Export
                if root.wide-toolbar : ToolbarGroup {
                    AppleToolbarItem { icon: "share"; label: root.compact-label("Share"); accessible-label: "Share unavailable"; enabled: false; }
                    AppleToolbarItem {
                        icon: "format";
                        label: root.compact-label("Format");
                        accessible-label: "Format inspector";
                        checked: root.inspector-visible;
                        enabled: root.inspector-available;
                        clicked => { if (root.inspector-available) { root.toggle-inspector(); } }
                    }
                    AppleToolbarItem {
                        icon: "organize";
                        label: root.compact-label("Organize");
                        accessible-label: "Organize unavailable";
                        enabled: false;
                    }
                    AppleToolbarItem {
                        icon: "export";
                        label: root.labeled-export ? "Export" : "";
                        accessible-label: "Export CSV";
                        clicked => { root.export-csv(); }
                    }
                }
            }

            // Formula Bar
            Rectangle {
                min-height: 32px;
                max-height: 32px;
                background: Theme.palette().chrome;

                HorizontalLayout {
                    spacing: 6px;
                    padding-left: 12px;
                    padding-right: 12px;
                    cross-axis-alignment: center;

                    Rectangle {
                        width: 48px;
                        height: 24px;
                        border-radius: Theme.tokens.metrics.radius-small;
                        border-width: 1px;
                        border-color: Theme.palette().border;
                        background: Theme.palette().surface-sunken;
                        Text {
                            text: root.selected-cell;
                            font-weight: 600;
                            font-size: Theme.tokens.typography.caption;
                            color: Theme.palette().ink;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "fx";
                        width: 20px;
                        font-size: Theme.tokens.typography.body;
                        font-weight: 700;
                        color: Theme.palette().accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TextField {
                        label: "Selected cell formula or value";
                        placeholder: "Enter a value or formula (=SUM, =AVERAGE)";
                        value <=> root.formula-edit-buffer;
                        horizontal-stretch: 1;
                        accepted(text) => { root.commit-selected-cell(text); }
                        cancelled => {
                            root.formula-edit-buffer = root.selection-formula;
                            root.cancel-selected-cell();
                        }
                    }

                    // Quick formula buttons appear only when the wide toolbar
                    // breakpoint has enough room beside the formula field.
                    if root.show-quick-formulas : HorizontalLayout {
                        spacing: 2px;
                        ToolbarButton { label: "SUM"; clicked => { root.quick-formula("SUM"); } }
                        ToolbarButton { label: "AVG"; clicked => { root.quick-formula("AVERAGE"); } }
                        ToolbarButton { label: "COUNT"; clicked => { root.quick-formula("COUNT"); } }
                    }

                    ToolbarIconButton {
                        icon: "check";
                        label: "Commit formula";
                        clicked => { root.commit-selected-cell(root.formula-edit-buffer); }
                    }
                    ToolbarIconButton {
                        icon: "close";
                        label: "Cancel editing";
                        clicked => {
                            root.formula-edit-buffer = root.selection-formula;
                            root.cancel-selected-cell();
                        }
                    }
                }

                Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.palette().border; }
            }

            // Main Spreadsheet Canvas and Right Inspector
            HorizontalLayout {
                spacing: 0px;
                vertical-stretch: 1;

                // Spreadsheet Canvas Area
                    CanvasSurface {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    // Table Sheet Container with drop shadow
                    Rectangle {
                        x: 24px;
                        y: 20px;
                        width: max(1px, parent.width - 48px);
                        height: max(1px, parent.height - 40px);
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: Theme.palette().border;
                        background: Theme.palette().surface;
                        drop-shadow-blur: 12px;
                        drop-shadow-offset-y: 4px;
                        drop-shadow-color: Theme.palette().shadow;
                        clip: true;

                        VerticalLayout {
                            spacing: 0px;

                            // Table Name Banner
                            Rectangle {
                                height: 28px;
                                background: Theme.palette().surface;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    cross-axis-alignment: center;
                                    Text {
                                        text: "Table 1";
                                        font-size: Theme.tokens.typography.title;
                                        font-weight: 700;
                                        color: Theme.palette().ink;
                                    }
                                }
                                Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: Theme.palette().border; }
                            }

                            // Spreadsheet Data Grid
                            GridLayout {
                                spacing: 0px;
                                horizontal-stretch: 1;
                                vertical-stretch: 1;

                                // Column Headers Row
                                Row {
                                    Rectangle {
                                        width: 36px;
                                        min-height: 26px;
                                        max-height: 26px;
                                        background: Theme.palette().chrome;
                                        border-width: 1px;
                                        border-color: Theme.palette().border;
                                    }
                                    for c in root.cols : Rectangle {
                                        min-width: 90px;
                                        horizontal-stretch: 1;
                                        min-height: 26px;
                                        max-height: 26px;
                                        background: c == root.selected-col ? Theme.palette().selection-soft : Theme.palette().chrome;
                                        border-width: 1px;
                                        border-color: c == root.selected-col ? Theme.palette().accent : Theme.palette().border;

                                        Text {
                                            text: root.column-headers[c];
                                            font-size: Theme.tokens.typography.caption;
                                            font-weight: c == root.selected-col ? 700 : 500;
                                            color: c == root.selected-col ? Theme.palette().accent : Theme.palette().ink-secondary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Data Rows
                                for r in root.rows : Row {
                                    // Row Header
                                    Rectangle {
                                        width: 36px;
                                        min-height: 28px;
                                        max-height: 28px;
                                        background: r == root.selected-row ? Theme.palette().selection-soft : Theme.palette().chrome;
                                        border-width: 1px;
                                        border-color: r == root.selected-row ? Theme.palette().accent : Theme.palette().border;
                                        Text {
                                            text: root.row-headers[r];
                                            font-size: Theme.tokens.typography.caption;
                                            font-weight: r == root.selected-row ? 700 : 500;
                                            color: r == root.selected-row ? Theme.palette().accent : Theme.palette().ink-secondary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Cells
                                    for c in root.cols : Rectangle {
                                        min-width: 90px;
                                        horizontal-stretch: 1;
                                        min-height: 28px;
                                        max-height: 28px;
                                        background: (r == root.selected-row && c == root.selected-col) ? Theme.palette().selection-soft
                                            : (Math.mod(r, 2) == 1) ? Theme.palette().surface-sunken : Theme.palette().surface;
                                        border-width: (r == root.selected-row && c == root.selected-col) ? 2px : 1px;
                                        border-color: (r == root.selected-row && c == root.selected-col) ? Theme.palette().accent : Theme.palette().border;

                                        Text {
                                            x: 8px;
                                            width: parent.width - 16px;
                                            height: parent.height;
                                            text: root.cells[r * root.cols.length + c];
                                            font-size: Theme.tokens.typography.body;
                                            font-weight: (r == 0) ? 600 : 400;
                                            color: Theme.palette().ink;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }

                                        // Selection Corner Drag Handle
                                        if (r == root.selected-row && c == root.selected-col) : Rectangle {
                                            x: parent.width - 5px;
                                            y: parent.height - 5px;
                                            width: 6px;
                                            height: 6px;
                                            border-radius: 3px;
                                            background: Theme.palette().accent;
                                        }

                                        TouchArea {
                                            clicked => {
                                                root.cell-clicked(r, c);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Apple Numbers-Style 4-Tab Inspector
                if root.inspector-visible : InspectorSurface {
                    title: "Format";
                    width: 280px;

                    VerticalLayout {
                        spacing: 12px;
                        padding: 12px;
                        alignment: start;

                        // Tabs: Table | Cell | Text | Arrange
                        SegmentedControl {
                            items: ["Table", "Cell", "Text", "Arrange"];
                            current <=> root.inspector-tab;
                            label: "Inspector Tabs";
                        }

                        // Tab 0: Table Settings
                        if root.inspector-tab == 0 : VerticalLayout {
                            spacing: 10px;

                            SectionHeader { title: "Table Styles"; }

                            // Table Style Preset Thumbnails
                            HorizontalLayout {
                                spacing: 6px;

                                Rectangle {
                                    width: 40px; height: 32px; border-radius: 4px;
                                    border-width: 2px; border-color: Theme.palette().accent;
                                    background: Theme.palette().surface;
                                    VerticalLayout {
                                        Rectangle { height: 8px; background: Theme.palette().border-strong; }
                                        Rectangle { vertical-stretch: 1; background: transparent; }
                                    }
                                }
                                Rectangle {
                                    width: 40px; height: 32px; border-radius: 4px;
                                    border-width: 1px; border-color: Theme.palette().border;
                                    background: Theme.palette().surface;
                                    VerticalLayout {
                                        Rectangle { height: 8px; background: Theme.palette().accent; }
                                        Rectangle { vertical-stretch: 1; background: transparent; }
                                    }
                                }
                                Rectangle {
                                    width: 40px; height: 32px; border-radius: 4px;
                                    border-width: 1px; border-color: Theme.palette().border;
                                    background: Theme.palette().surface;
                                    VerticalLayout {
                                        Rectangle { height: 8px; background: Theme.palette().content-cool; }
                                        Rectangle { vertical-stretch: 1; background: transparent; }
                                    }
                                }
                                Rectangle {
                                    width: 40px; height: 32px; border-radius: 4px;
                                    border-width: 1px; border-color: Theme.palette().border;
                                    background: Theme.palette().surface;
                                    VerticalLayout {
                                        Rectangle { height: 8px; background: Theme.palette().warning; }
                                        Rectangle { vertical-stretch: 1; background: transparent; }
                                    }
                                }
                            }

                            SectionHeader { title: "Headers & Footers"; }

                            PropertyRow {
                                label: "Header Rows";
                                TextField { label: "Header Rows"; value: "1"; enabled: false; }
                            }
                            PropertyRow {
                                label: "Header Columns";
                                TextField { label: "Header Columns"; value: "1"; enabled: false; }
                            }

                            SectionHeader { title: "Gridlines & Styling"; }

                            PropertyRow {
                                label: "Alternating Rows";
                                Toggle { label: "Alternating Color"; checked: true; }
                            }

                            PropertyRow {
                                label: "Gridlines";
                                SegmentedControl {
                                    items: ["All", "Horiz", "Vert", "None"];
                                    current: 0;
                                    label: "Gridlines";
                                }
                            }
                        }

                        // Tab 1: Cell Settings
                        if root.inspector-tab == 1 : VerticalLayout {
                            spacing: 10px;

                            SectionHeader { title: "Data Format"; }

                            SegmentedControl {
                                items: ["Automatic", "Number", "Currency", "Text"];
                                current: 0;
                                label: "Data Format";
                            }

                            PropertyRow {
                                label: "Decimals";
                                TextField { label: "Decimals"; value: "2"; enabled: false; }
                            }

                            SectionHeader { title: "Cell Fill"; }

                            PropertyRow {
                                label: "Fill Color";
                                Rectangle {
                                    height: 24px; border-radius: 4px;
                                    background: Theme.palette().surface-sunken;
                                    border-width: 1px; border-color: Theme.palette().border;
                                }
                            }
                        }

                        // Tab 2: Text Settings
                        if root.inspector-tab == 2 : VerticalLayout {
                            spacing: 10px;

                            SectionHeader { title: "Font"; }

                            PropertyRow {
                                label: "Family";
                                TextField { label: "Font family"; value: "Helvetica Neue"; enabled: false; }
                            }

                            PropertyRow {
                                label: "Style";
                                HorizontalLayout {
                                    spacing: 4px;
                                    ToolbarIconButton { icon: "bold"; label: "Bold"; enabled: false; }
                                    ToolbarIconButton { icon: "italic"; label: "Italic"; enabled: false; }
                                    ToolbarIconButton { icon: "underline"; label: "Underline"; enabled: false; }
                                }
                            }

                            SectionHeader { title: "Alignment"; }

                            SegmentedControl {
                                items: ["Left", "Center", "Right"];
                                current: 0;
                                label: "Alignment";
                            }
                        }

                        // Tab 3: Arrange Settings
                        if root.inspector-tab == 3 : VerticalLayout {
                            spacing: 10px;

                            SectionHeader { title: "Table Size"; }

                            PropertyRow {
                                label: "Rows";
                                TextField { label: "Rows count"; value: "6"; enabled: false; }
                            }
                            PropertyRow {
                                label: "Columns";
                                TextField { label: "Columns count"; value: "8"; enabled: false; }
                            }

                            SectionHeader { title: "Row & Column Size"; }

                            PropertyRow {
                                label: "Row Height";
                                HorizontalLayout {
                                    spacing: 4px;
                                    TextField { label: "Row Height"; value: "28 pt"; enabled: false; }
                                    ToolbarButton { label: "Fit"; enabled: false; }
                                }
                            }
                            PropertyRow {
                                label: "Col Width";
                                HorizontalLayout {
                                    spacing: 4px;
                                    TextField { label: "Column Width"; value: "96 pt"; enabled: false; }
                                    ToolbarButton { label: "Fit"; enabled: false; }
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; background: transparent; }

                        // Selection Info Card
                        Rectangle {
                            height: 52px;
                            border-radius: Theme.tokens.metrics.radius-medium;
                            background: Theme.palette().surface-sunken;
                            border-width: 1px;
                            border-color: Theme.palette().border;

                            VerticalLayout {
                                spacing: 2px;
                                alignment: center;
                                padding: 8px;
                                Text {
                                    text: "Cell " + root.selected-cell;
                                    font-size: Theme.tokens.typography.caption;
                                    font-weight: 600;
                                    color: Theme.palette().ink;
                                }
                                Text {
                                    text: root.selection-value != "" ? root.selection-value : "Empty";
                                    font-size: Theme.tokens.typography.caption;
                                    color: Theme.palette().ink-secondary;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                }
            }

            // Standard Status Bar
            ToolkitStatusBar {
                leading: root.status-left;
                trailing: root.status-right;
            }
        }
    }

    // Compact toolbars keep the primary workspace clear and expose every
    // currently actionable toolbar command through one real,
    // keyboard-accessible menu.
    if root.toolbar-overflow-open && !root.wide-toolbar : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: transparent;

        TouchArea {
            clicked => { root.toolbar-overflow-open = false; }
        }

        Rectangle {
            x: max(8px, root.width - 272px);
            y: Theme.tokens.metrics.header-height + 32px + 8px;
            width: 256px;
            height: 148px;
            border-radius: Theme.tokens.metrics.radius-medium;
            border-width: 1px;
            border-color: Theme.palette().border;
            background: Theme.palette().surface;
            drop-shadow-blur: 16px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.palette().shadow;

            VerticalLayout {
                spacing: 4px;
                padding: 8px;

                ToolbarButton {
                    icon: "eye";
                    label: "View";
                    enabled: root.inspector-available;
                    horizontal-stretch: 1;
                    clicked => { root.toggle-inspector(); root.toolbar-overflow-open = false; }
                }
                ToolbarButton {
                    icon: "format";
                    label: "Format";
                    checked: root.inspector-visible;
                    enabled: root.inspector-available;
                    horizontal-stretch: 1;
                    clicked => { root.toggle-inspector(); root.toolbar-overflow-open = false; }
                }
                ToolbarButton {
                    icon: "export";
                    label: "Export CSV";
                    horizontal-stretch: 1;
                    clicked => { root.export-csv(); root.toolbar-overflow-open = false; }
                }
            }
        }
    }

    // Numbers-Style Template Chooser Modal
    if root.template-chooser-open : Rectangle {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        background: Theme.palette().scrim;

        Rectangle {
            // Template selection is a primary workspace, not a compact
            // confirmation sheet. Match the desktop scale while preserving
            // an outer margin at the supported compact size.
            width: min(1160px, max(1px, parent.width - 48px));
            x: (parent.width - self.width) / 2;
            height: min(760px, max(480px, parent.height - 48px));
            y: (parent.height - self.height) / 2;
            border-radius: Theme.tokens.metrics.radius-large;
            border-width: 1px;
            border-color: Theme.palette().border;
            background: Theme.palette().surface;
            clip: true;
            drop-shadow-blur: 24px;
            drop-shadow-offset-y: 8px;
            drop-shadow-color: Theme.palette().shadow;

            VerticalLayout {
                spacing: 0px;
                padding: 0px;

                HorizontalLayout {
                    spacing: 0px;
                    vertical-stretch: 1;

                    // Sidebar
                    Rectangle {
                        width: 220px;
                        background: Theme.palette().panel;

                        VerticalLayout {
                            spacing: 4px;
                            padding-top: 16px;
                            padding-bottom: 16px;
                            padding-left: 12px;
                            padding-right: 12px;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-bottom: 4px;
                                Text {
                                    text: "TEMPLATES";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: Theme.palette().ink-secondary;
                                }
                            }

                            Rectangle {
                                height: 32px;
                                border-radius: Theme.tokens.metrics.radius-medium;
                                background: root.template-category == 0 ? Theme.palette().surface-raised : transparent;
                                HorizontalLayout {
                                    spacing: 8px; padding-left: 10px; padding-right: 10px; cross-axis-alignment: center;
                                    Icon { size: 16px; icon: "grid"; tint: root.template-category == 0 ? Theme.palette().accent : Theme.palette().ink-secondary; }
                                    Text {
                                        text: "All Templates";
                                        font-size: Theme.tokens.typography.body;
                                        font-weight: root.template-category == 0 ? 600 : 400;
                                        color: Theme.palette().ink;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.choose-template-category(0); } }
                            }

                            Rectangle {
                                height: 32px;
                                border-radius: Theme.tokens.metrics.radius-medium;
                                background: root.template-category == 1 ? Theme.palette().surface-raised : transparent;
                                HorizontalLayout {
                                    spacing: 8px; padding-left: 10px; padding-right: 10px; cross-axis-alignment: center;
                                    Icon { size: 16px; icon: "table"; tint: root.template-category == 1 ? Theme.palette().accent : Theme.palette().ink-secondary; }
                                    Text {
                                        text: "Basic";
                                        font-size: Theme.tokens.typography.body;
                                        font-weight: root.template-category == 1 ? 600 : 400;
                                        color: Theme.palette().ink;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.choose-template-category(1); } }
                            }

                            Rectangle {
                                height: 32px;
                                border-radius: Theme.tokens.metrics.radius-medium;
                                background: root.template-category == 2 ? Theme.palette().surface-raised : transparent;
                                HorizontalLayout {
                                    spacing: 8px; padding-left: 10px; padding-right: 10px; cross-axis-alignment: center;
                                    Icon { size: 16px; icon: "chart"; tint: root.template-category == 2 ? Theme.palette().accent : Theme.palette().ink-secondary; }
                                    Text {
                                        text: "Personal Finance";
                                        font-size: Theme.tokens.typography.body;
                                        font-weight: root.template-category == 2 ? 600 : 400;
                                        color: Theme.palette().ink;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.choose-template-category(2); } }
                            }

                            Rectangle {
                                height: 32px;
                                border-radius: Theme.tokens.metrics.radius-medium;
                                background: root.template-category == 3 ? Theme.palette().surface-raised : transparent;
                                HorizontalLayout {
                                    spacing: 8px; padding-left: 10px; padding-right: 10px; cross-axis-alignment: center;
                                    Icon { size: 16px; icon: "folder"; tint: root.template-category == 3 ? Theme.palette().accent : Theme.palette().ink-secondary; }
                                    Text {
                                        text: "Business";
                                        font-size: Theme.tokens.typography.body;
                                        font-weight: root.template-category == 3 ? 600 : 400;
                                        color: Theme.palette().ink;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea { clicked => { root.choose-template-category(3); } }
                            }

                            Rectangle { vertical-stretch: 1; background: transparent; }

                            HorizontalLayout {
                                spacing: 6px; padding: 8px;
                                Text {
                                    text: "English (US)";
                                    font-size: Theme.tokens.typography.caption;
                                    color: Theme.palette().ink-secondary;
                                    vertical-alignment: center;
                                }
                                Icon { size: 12px; icon: "chevron-down"; tint: Theme.palette().ink-secondary; }
                            }
                        }

                        Rectangle { x: parent.width - 1px; y: 0px; width: 1px; height: parent.height; background: Theme.palette().border; }
                    }

                    // Content Area
                    VerticalLayout {
                        horizontal-stretch: 1;
                        padding-top: 24px;
                        padding-bottom: 20px;
                        padding-left: 28px;
                        padding-right: 28px;
                        spacing: 16px;

                        Text {
                            text: "Choose a Template";
                            font-size: 24px;
                            font-weight: 700;
                            color: Theme.palette().ink;
                        }

                        VerticalLayout {
                            spacing: 16px;

                            HorizontalLayout {
                                spacing: 16px;

                                if root.template-visible(0) : SheetTemplateCard {
                                    template-index: 0;
                                    template-name: "Blank";
                                    description: "Simple table layout";
                                    selected: root.template-selected == 0;
                                    clicked => { root.template-selected = 0; }
                                }

                                if root.template-visible(1) : SheetTemplateCard {
                                    template-index: 1;
                                    template-name: "Monthly Budget";
                                    description: "Income and expenses tracker";
                                    selected: root.template-selected == 1;
                                    clicked => { root.template-selected = 1; }
                                }
                            }

                            HorizontalLayout {
                                spacing: 16px;

                                if root.template-visible(2) : SheetTemplateCard {
                                    template-index: 2;
                                    template-name: "Invoice & Expenses";
                                    description: "Track billing and totals";
                                    selected: root.template-selected == 2;
                                    clicked => { root.template-selected = 2; }
                                }
                            }
                        }

                        Rectangle { vertical-stretch: 1; background: transparent; }
                    }
                }

                // Footer Bar
                Rectangle {
                    height: 56px;
                    background: Theme.palette().chrome;

                    Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: Theme.palette().border; }

                    HorizontalLayout {
                        spacing: 12px;
                        padding-left: 20px;
                        padding-right: 20px;
                        cross-axis-alignment: center;

                        Text {
                            text: "Escape to cancel • Return to create";
                            font-size: Theme.tokens.typography.caption;
                            color: Theme.palette().ink-secondary;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }

                        ToolbarButton {
                            label: "Cancel";
                            clicked => { root.cancel-template(); }
                        }

                        ToolbarButton {
                            label: "Create Spreadsheet";
                            primary: true;
                            clicked => { root.create-template(root.template-selected); }
                        }
                    }
                }
            }
        }
    }

    palette := CommandPalette {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        open: root.palette-open;
        commands: root.palette-commands;
        query: root.palette-query;
        selected: root.palette-selected;
        command-invoked(idx) => { root.palette-invoked(idx); }
        query-changed(q) => {
            root.palette-query = q;
            root.palette-query-changed(q);
        }
        move-selection(delta) => { root.palette-move(delta); }
        key-text(text) => { root.palette-key-text(text); }
        backspace => { root.palette-backspace(); }
        close-requested => {
            root.palette-open = false;
            root.palette-close();
        }
    }
}
