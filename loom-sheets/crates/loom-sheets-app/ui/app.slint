import {
    AppHeader, WorkspaceToolbar, ToolButton, IconButton, StatusBar, MetricChip
} from "components.slint";
import { Theme } from "theme.slint";
export { Theme } from "theme.slint";

component FormulaBarField inherits Rectangle {
    in property <string> label: "";
    in property <string> placeholder: "";
    in-out property <string> value: "";
    callback committed(string);
    callback cancelled;

    height: Theme.tokens.metrics.control-height;
    min-width: 180px;
    border-radius: Theme.tokens.metrics.radius-medium;
    border-width: 1px;
    border-color: text-input.has-focus ? Theme.palette().focus : Theme.palette().border;
    background: Theme.palette().surface-raised;

    text-input := TextInput {
        x: 11px;
        width: parent.width - 22px;
        single-line: true;
        vertical-alignment: center;
        font-size: Theme.tokens.typography.body;
        color: Theme.palette().ink;
        text <=> root.value;
        accepted => { root.committed(text-input.text); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.cancelled();
                return accept;
            }
            return reject;
        }
    }

    if root.value == "" : Text {
        x: 11px;
        width: parent.width - 22px;
        vertical-alignment: center;
        font-size: Theme.tokens.typography.body;
        color: Theme.palette().ink-disabled;
        text: root.placeholder;
    }

    accessible-role: AccessibleRole.text-input;
    accessible-label: root.label;
}

export component SheetsApp inherits Window {
    title: "Loom Sheets";
    min-width: 900px;
    min-height: 680px;
    background: Theme.palette().canvas;
    property <bool> compact-layout: root.width < 1120px;

    in property <string> sheet-name: "Untitled";
    in property <string> status-left: "";
    in property <string> status-right: "";
    in property <[int]> rows: [];
    in property <[int]> cols: [];
    in property <[string]> column-headers: [];
    in property <[string]> row-headers: [];
    in property <[string]> cells: [];
    in property <string> selected-cell: "A1";
    in property <int> selected-row: 0;
    in property <int> selected-col: 0;
    in property <string> selection-formula: "";
    property <string> formula-edit-buffer: "";
    in property <string> selection-value: "";

    // Retained for compatibility with the current Rust adapter. Only the
    // persisted single-sheet workbook is surfaced until multi-sheet storage
    // is implemented in the engine.
    in-out property <[string]> sheets: ["Sheet 1"];
    in-out property <int> active-sheet-index: 0;
    in-out property <int> cell-format-index: 0;
    in-out property <string> formula-feedback: "Ready";

    callback new-sheet;
    callback open-sheet;
    callback save-sheet;
    callback export-csv;
    callback undo;
    callback redo;
    callback cell-clicked(int, int);
    callback commit-selected-cell(string);
    callback cancel-selected-cell;
    callback quick-formula(string);
    callback select-sheet(int);
    callback add-new-sheet;
    callback set-cell-format(int);

    public function reset-formula-edit-buffer() {
        formula-edit-buffer = selection-formula;
    }

    VerticalLayout {
        spacing: 0px;

        AppHeader {
            app-name: "Loom Sheets";
            document-title: root.sheet-name;
            icon: "table";
            context: root.rows.length + " × " + root.cols.length + " visible grid";
            state-text: "Calculated locally";
            state-tone: 0;
        }

        WorkspaceToolbar {
            ToolButton { icon: "new"; text: "New"; clicked => { root.new-sheet(); } }
            ToolButton { icon: "open"; text: "Open"; clicked => { root.open-sheet(); } }
            ToolButton { icon: "save"; text: "Save"; clicked => { root.save-sheet(); } }
            Rectangle { width: 1px; height: 20px; background: Theme.palette().border; }
            IconButton { icon: "undo"; label: "Undo"; clicked => { root.undo(); } }
            IconButton { icon: "redo"; label: "Redo"; clicked => { root.redo(); } }
            Rectangle { width: 1px; height: 20px; background: Theme.palette().border; }
            ToolButton { text: "SUM"; clicked => { root.quick-formula("SUM"); } }
            ToolButton { text: root.compact-layout ? "AVG" : "AVERAGE"; clicked => { root.quick-formula("AVERAGE"); } }
            ToolButton { text: "COUNT"; clicked => { root.quick-formula("COUNT"); } }
            ToolButton { text: "MIN"; clicked => { root.quick-formula("MIN"); } }
            ToolButton { text: "MAX"; clicked => { root.quick-formula("MAX"); } }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            MetricChip { label: root.selected-cell; value: root.selection-value == "" ? "Empty" : root.selection-value; }
            ToolButton { icon: "export"; text: root.compact-layout ? "CSV" : "Export CSV"; clicked => { root.export-csv(); } }
        }

        Rectangle {
            height: 44px;
            background: Theme.palette().panel;
            border-width: 0px;

            HorizontalLayout {
                spacing: 8px;
                padding-left: 10px;
                padding-right: 10px;
                cross-axis-alignment: center;

                Rectangle {
                    width: root.compact-layout ? 52px : 62px;
                    height: Theme.tokens.metrics.control-height;
                    border-radius: Theme.tokens.metrics.radius-medium;
                    border-width: 1px;
                    border-color: Theme.palette().border;
                    background: Theme.palette().surface-sunken;
                    Text {
                        text: root.selected-cell;
                        font-weight: 700;
                        font-size: Theme.tokens.typography.body;
                        color: Theme.palette().ink;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: "fx";
                    width: 24px;
                    font-size: Theme.tokens.typography.body-large;
                    font-weight: 700;
                    color: Theme.palette().accent;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                FormulaBarField {
                    label: "Selected cell formula or value";
                    placeholder: "Enter a value or formula";
                    value <=> root.formula-edit-buffer;
                    horizontal-stretch: 1;
                    committed(text) => { root.commit-selected-cell(text); }
                    cancelled => {
                        root.formula-edit-buffer = root.selection-formula;
                        root.cancel-selected-cell();
                    }
                }

                IconButton {
                    icon: "check";
                    label: "Commit formula";
                    clicked => { root.commit-selected-cell(root.formula-edit-buffer); }
                }
                IconButton {
                    icon: "close";
                    label: "Cancel editing";
                    clicked => {
                        root.formula-edit-buffer = root.selection-formula;
                        root.cancel-selected-cell();
                    }
                }

                if root.formula-feedback != "" : Text {
                    text: root.formula-feedback;
                    max-width: root.compact-layout ? 96px : 180px;
                    font-size: Theme.tokens.typography.caption;
                    color: Theme.palette().ink-secondary;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        Rectangle { height: 1px; background: Theme.palette().border; }

        Rectangle {
            vertical-stretch: 1;
            background: Theme.palette().canvas-alt;

            Rectangle {
                x: 10px;
                y: 10px;
                width: parent.width - 20px;
                height: parent.height - 20px;
                border-radius: 11px;
                border-width: 1px;
                border-color: Theme.palette().border;
                background: Theme.palette().surface;
                clip: true;

                GridLayout {
                    max-width: 10000px;
                    max-height: 10000px;
                    spacing: 0px;

                    Row {
                        Rectangle {
                            min-width: 46px;
                            max-width: 46px;
                            min-height: 30px;
                            max-height: 30px;
                            background: Theme.palette().chrome;
                            border-width: 1px;
                            border-color: Theme.palette().border;
                        }
                        for c in root.cols : Rectangle {
                            min-width: root.compact-layout ? 104px : 132px;
                            max-width: root.compact-layout ? 104px : 132px;
                            min-height: 30px;
                            max-height: 30px;
                            background: c == root.selected-col
                                ? Theme.palette().selection-soft
                                : Theme.palette().chrome;
                            border-width: 1px;
                            border-color: c == root.selected-col
                                ? Theme.palette().accent
                                : Theme.palette().border;
                            Text {
                                text: root.column-headers[c];
                                font-size: Theme.tokens.typography.caption;
                                font-weight: c == root.selected-col ? 700 : 600;
                                color: c == root.selected-col
                                    ? Theme.palette().accent
                                    : Theme.palette().ink-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    for r in root.rows : Row {
                        Rectangle {
                            min-width: 46px;
                            max-width: 46px;
                            min-height: 32px;
                            max-height: 32px;
                            background: r == root.selected-row
                                ? Theme.palette().selection-soft
                                : Theme.palette().chrome;
                            border-width: 1px;
                            border-color: r == root.selected-row
                                ? Theme.palette().accent
                                : Theme.palette().border;
                            Text {
                                text: root.row-headers[r];
                                font-size: Theme.tokens.typography.caption;
                                font-weight: r == root.selected-row ? 700 : 500;
                                color: r == root.selected-row
                                    ? Theme.palette().accent
                                    : Theme.palette().ink-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        for c in root.cols : Rectangle {
                            min-width: root.compact-layout ? 104px : 132px;
                            max-width: root.compact-layout ? 104px : 132px;
                            min-height: 32px;
                            max-height: 32px;
                            border-width: r == root.selected-row && c == root.selected-col ? 2px : 1px;
                            border-color: r == root.selected-row && c == root.selected-col
                                ? Theme.palette().accent
                                : Theme.palette().grid-minor;
                            background: r == root.selected-row && c == root.selected-col
                                ? Theme.palette().selection-soft
                                : cell-touch.has-hover
                                    ? Theme.palette().surface-raised
                                    : Theme.palette().surface;

                            Text {
                                x: 7px;
                                width: parent.width - 14px;
                                text: root.cells[r * root.cols.length + c];
                                font-size: Theme.tokens.typography.body;
                                font-weight: r == root.selected-row && c == root.selected-col ? 600 : 400;
                                color: Theme.palette().ink;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                                overflow: elide;
                            }

                            cell-touch := TouchArea {
                                clicked => { root.cell-clicked(r, c); }
                            }
                            accessible-role: button;
                            accessible-label: "Cell " + root.column-headers[c] + root.row-headers[r]
                                + ", " + root.cells[r * root.cols.length + c];
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 36px;
            background: Theme.palette().panel;
            border-width: 0px;

            HorizontalLayout {
                spacing: 6px;
                padding-left: 10px;
                padding-right: 10px;
                cross-axis-alignment: center;

                Rectangle {
                    height: 27px;
                    min-width: 112px;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.palette().accent;
                    background: Theme.palette().selection-soft;
                    Text {
                        text: root.sheet-name;
                        x: 12px;
                        width: parent.width - 24px;
                        font-size: Theme.tokens.typography.caption;
                        font-weight: 700;
                        color: Theme.palette().ink;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                Text {
                    text: "Single-sheet package";
                    font-size: Theme.tokens.typography.caption;
                    color: Theme.palette().ink-disabled;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; background: transparent; }
            }
        }

        StatusBar {
            status-left: root.status-left;
            status-right: root.status-right;
        }
    }
}
