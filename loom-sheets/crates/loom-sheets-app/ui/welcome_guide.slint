import { LoomButton } from "foundation.slint";
import { Theme } from "theme.slint";

export component WelcomeGuideModal inherits Rectangle {
    width: 100%;
    height: 100%;
    in property <bool> open: false;
    in-out property <int> step: 0;
    in property <string> mod-key: "Ctrl+";
    in property <bool> focus-request: false;
    callback close-guide;
    callback try-action(string);

    visible: root.open;

    property <int> total-steps: 7;

    function step-title(s: int) -> string {
        s == 0 ? "Welcome to Loom Sheets"
        : s == 1 ? "Grid & Fast Navigation"
        : s == 2 ? "Formulas & Multi-Sheet Tabs"
        : s == 3 ? "Formatting & Inspector"
        : s == 4 ? "Tables, Sorting & Pivot Summaries"
        : s == 5 ? "Charts, Objects & Export"
        : "Command Palette & Shortcuts"
    }

    function step-summary(s: int) -> string {
        s == 0 ? "Loom Sheets is a local-first spreadsheet editor. Your work stays on your device with open .loomtable workbooks, crash recovery, and 11 built-in templates."
        : s == 1 ? "Click any cell or start typing to edit in the formula bar. Press Enter to commit and move down, Tab to move right, or Escape to cancel."
        : s == 2 ? "Write formulas using 100+ Excel-compatible functions, dynamic arrays (FILTER, SORT, UNIQUE), and cross-sheet references such as =Sheet2!A1 or =SUM('Sheet 2'!B2:B10)."
        : s == 3 ? "Style cells with Bold, Italic, Underline, Alignment, Number Formats (General, Number, Currency, Percent), Decimal precision, Borders, Fills, and Wrap Text."
        : s == 4 ? "Insert or delete rows and columns, sort ascending or descending with formula-aware row protection, freeze header rows, and build formula-backed Pivot Summaries."
        : s == 5 ? "Create live-linked Line, Bar, and Pie charts, add shapes and embedded images, and export anytime to CSV or Microsoft Excel (.xlsx)."
        : "Every action in Loom Sheets is available from the menus, toolbar, and a searchable Command Palette that shows all keyboard shortcuts."
    }

    function step-highlights(s: int) -> string {
        s == 0 ? "• New blank workbook: " + root.mod-key + "N  |  From Template: " + root.mod-key + "Shift+N\n• Open (.loomtable, .csv, .xlsx): " + root.mod-key + "O  |  Save: " + root.mod-key + "S\n• Reopen this guide anytime from Help > Welcome Guide or View > Welcome Guide"
        : s == 1 ? "• Jump to data edge: " + root.mod-key + "Arrow  (add Shift to extend selection)\n• Fill Down: " + root.mod-key + "D  |  Select All: " + root.mod-key + "A  |  Undo / Redo: " + root.mod-key + "Z / " + root.mod-key + "Shift+Z\n• Cycle grid, objects, chart data, toolbar, and inspector: F6 / Shift+F6"
        : s == 2 ? "• Add Sheet: click + on the sheet tab bar or press " + root.mod-key + "Alt+N\n• Delete active Sheet: click - on the sheet tab bar or press " + root.mod-key + "Alt+X\n• Double-click a sheet tab or use Organize in the Inspector to rename it"
        : s == 3 ? "• Open Format Inspector: " + root.mod-key + "Alt+I  (or click Format / Organize in the toolbar)\n• Text styles: " + root.mod-key + "B / I / U  |  Align: " + root.mod-key + "Shift+L / M / R\n• Formats: " + root.mod-key + "Alt+0 (General), 1 (Number), 4 (Currency), 5 (Percent)"
        : s == 4 ? "• Open the Table menu for Add/Delete Row & Column, Sort, Freeze, and Delete Sheet\n• Shortcuts: " + root.mod-key + "Alt+R / W (Row +/-), " + root.mod-key + "Alt+K / L (Col +/-)\n• Sort Asc/Desc: " + root.mod-key + "Alt+S / D  |  Freeze Header: " + root.mod-key + "Alt+F  |  Pivot Sum: " + root.mod-key + "Alt+P"
        : s == 5 ? "• Insert Chart / Shape / Image: " + root.mod-key + "Alt+C / J / M\n• Cycle Chart Kind / Copy Chart: " + root.mod-key + "Alt+T / Y  |  Object keyboard mode: F6\n• Export CSV: " + root.mod-key + "E  |  Export Excel (.xlsx): " + root.mod-key + "Shift+E"
        : "• Open Command Palette: " + root.mod-key + "K, " + root.mod-key + "Shift+P, or F1\n• Type any action name or shortcut (for example \"sort\" or \"Alt+F\") to filter\n• Appearance themes (System, Light, Dark, High Contrast) live in the View menu"
    }

    function step-try-label(s: int) -> string {
        s == 0 ? "Try: Browse Templates"
        : s == 1 ? "Try: Load Practice Sheet"
        : s == 2 ? "Try: Add a Second Sheet"
        : s == 3 ? "Try: Open Format Inspector"
        : s == 4 ? "Try: Open Table Menu"
        : s == 5 ? "Try: Open Export Menu"
        : "Try: Open Command Palette"
    }

    function step-try-id(s: int) -> string {
        s == 0 ? "templates"
        : s == 1 ? "sample-budget"
        : s == 2 ? "add-sheet"
        : s == 3 ? "inspector"
        : s == 4 ? "table-menu"
        : s == 5 ? "export-menu"
        : "palette"
    }

    public function focus-dialog() {
        next-button.grab-focus();
    }

    changed open => {
        if (root.open) {
            next-button.grab-focus();
        }
    }

    changed focus-request => {
        if (root.open) {
            next-button.grab-focus();
        }
    }

    guide-focus := FocusScope {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        enabled: root.open;
        visible: root.open;
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                root.close-guide();
                return accept;
            }
            if (event.text == Key.LeftArrow && root.step > 0) {
                root.step -= 1;
                return accept;
            }
            if (event.text == Key.RightArrow && root.step + 1 < root.total-steps) {
                root.step += 1;
                return accept;
            }
            if (event.text == Key.Tab || event.text == Key.Backtab) {
                if (event.text == Key.Backtab || event.modifiers.shift) {
                    if (next-button.has-focus) {
                        if (root.step > 0) { prev-button.grab-focus(); } else { try-button.grab-focus(); }
                    }
                    else if (prev-button.has-focus) { try-button.grab-focus(); }
                    else if (try-button.has-focus) { close-button.grab-focus(); }
                    else { next-button.grab-focus(); }
                } else {
                    if (close-button.has-focus) { try-button.grab-focus(); }
                    else if (try-button.has-focus) {
                        if (root.step > 0) { prev-button.grab-focus(); } else { next-button.grab-focus(); }
                    }
                    else if (prev-button.has-focus) { next-button.grab-focus(); }
                    else { close-button.grab-focus(); }
                }
                return accept;
            }
            return reject;
        }

        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: Theme.palette().scrim;
            accessible-role: groupbox;
            accessible-label: "Welcome guide";

            TouchArea { clicked => { guide-focus.focus(); } }

            panel := Rectangle {
                x: (root.width - self.width) / 2;
                y: (root.height - self.height) / 2;
                width: min(680px, root.width - 32px);
                height: min(content-layout.preferred-height, root.height - 32px);
                border-radius: Theme.tokens.metrics.radius-large;
                border-width: 1px;
                border-color: Theme.palette().border;
                background: Theme.palette().surface;
                drop-shadow-blur: 18px;
                drop-shadow-offset-y: 6px;
                drop-shadow-color: Theme.palette().shadow;

                content-layout := VerticalLayout {
                    spacing: Theme.tokens.space.md;
                    padding: Theme.tokens.space.xl;
                    alignment: start;

                    step-label := Text {
                        text: "Welcome Guide — Step " + (root.step + 1) + " of " + root.total-steps;
                        font-size: Theme.type.caption;
                        font-weight: 600;
                        color: Theme.palette().accent;
                        horizontal-alignment: Theme.rtl ? right : left;
                    }

                    title-text := Text {
                        text: root.step-title(root.step);
                        font-size: Theme.type.heading;
                        font-weight: 700;
                        color: Theme.palette().ink;
                        horizontal-alignment: Theme.rtl ? right : left;
                        wrap: word-wrap;
                    }

                    body-scroll := Flickable {
                        width: parent.width;
                        height: min(
                            body-layout.preferred-height,
                            max(120px, root.height - 230px * max(1.0, Theme.text-scale))
                        );
                        viewport-width: parent.width;
                        viewport-height: max(self.height, body-layout.preferred-height);

                        body-layout := VerticalLayout {
                            width: body-scroll.width;
                            spacing: Theme.tokens.space.md;
                            alignment: start;

                            Text {
                                width: parent.width;
                                text: root.step-summary(root.step);
                                font-size: Theme.type.body;
                                color: Theme.palette().ink;
                                horizontal-alignment: Theme.rtl ? right : left;
                                wrap: word-wrap;
                            }

                            Rectangle {
                                width: parent.width;
                                height: highlights-text.preferred-height + 2 * Theme.tokens.space.md;
                                border-radius: Theme.tokens.metrics.radius-medium;
                                border-width: 1px;
                                border-color: Theme.palette().border;
                                background: Theme.palette().canvas;

                                highlights-text := Text {
                                    x: Theme.tokens.space.md;
                                    y: Theme.tokens.space.md;
                                    width: max(0px, parent.width - 2 * Theme.tokens.space.md);
                                    text: root.step-highlights(root.step);
                                    font-size: Theme.type.caption;
                                    color: Theme.palette().ink-secondary;
                                    horizontal-alignment: Theme.rtl ? right : left;
                                    wrap: word-wrap;
                                }
                            }

                            Rectangle {
                                width: parent.width;
                                height: try-button.height;
                                try-button := LoomButton {
                                    label: root.step-try-label(root.step);
                                    variant: "secondary";
                                    width: min(self.preferred-width, parent.width);
                                    height: Theme.tokens.metrics.control-height;
                                    x: Theme.rtl ? max(0px, parent.width - self.width) : 0px;
                                    clicked => { root.try-action(root.step-try-id(root.step)); }
                                }
                            }
                        }
                    }

                    footer := Rectangle {
                        width: parent.width;
                        height: Theme.tokens.metrics.control-height;

                        close-button := LoomButton {
                            label: "Close";
                            variant: "secondary";
                            width: self.preferred-width;
                            height: Theme.tokens.metrics.control-height;
                            x: Theme.rtl ? max(0px, parent.width - self.width) : 0px;
                            clicked => { root.close-guide(); }
                        }

                        next-button := LoomButton {
                            label: root.step + 1 < root.total-steps ? "Next" : "Get Started";
                            variant: "primary";
                            width: self.preferred-width;
                            height: Theme.tokens.metrics.control-height;
                            x: Theme.rtl ? 0px : max(0px, parent.width - self.width);
                            clicked => {
                                if (root.step + 1 < root.total-steps) {
                                    root.step += 1;
                                } else {
                                    root.close-guide();
                                }
                            }
                        }

                        prev-button := LoomButton {
                            label: "Previous";
                            variant: "secondary";
                            enabled: root.step > 0;
                            width: self.preferred-width;
                            height: Theme.tokens.metrics.control-height;
                            x: Theme.rtl
                                ? next-button.width + Theme.tokens.space.sm
                                : max(0px, next-button.x - Theme.tokens.space.sm - self.width);
                            clicked => {
                                if (root.step > 0) {
                                    root.step -= 1;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
