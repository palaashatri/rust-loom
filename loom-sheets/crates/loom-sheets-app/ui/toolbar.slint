import { LabeledToolbar, IconOverLabelToolbarItem, ToolbarSpacer } from "toolkit.slint";
import { LoomOverflowButton } from "foundation.slint";
import { Theme } from "theme.slint";

/// One icon-over-label row in three groups: View/Zoom/Add Sheet on the
/// reading-start side, Chart/Table/Text/Shape/Image in the middle, and
/// Export plus the two inspector tabs on the reading-end side. Items that
/// open a menu report their window x through `toggle-menu`; every direct item
/// sends a command id through `command`.
export component SheetActionToolbar inherits LabeledToolbar {
    in property <bool> inspector-visible: false;
    in property <int> inspector-tab: 0;
    /// 0 = none, 1 = View, 2 = Zoom, 3 = Table, 4 = Text, 5 = Export.
    in property <int> menu-kind: 0;
    /// Window y just below the toolbar, where menus open.
    out property <length> bottom-y: root.absolute-position.y + root.height;

    // Take the labeled slot's minimum height; the sheet needs the room.
    max-height: Theme.tokens.metrics.labeled-toolbar-min-height;

    callback command(string);
    callback toggle-menu(int, length);
    callback show-inspector-tab(int);
    callback overflow-requested;

    /// Return keyboard focus to the Format item (after the inspector closes).
    public function focus-inspector-trigger() { format-item.focus-item(); }
    public function focus-overflow-trigger() { overflow-button.grab-focus(); }

    changed inspector-visible => {
        if (!root.inspector-visible) { root.focus-inspector-trigger(); }
    }

    IconOverLabelToolbarItem {
        icon: "view";
        label: "View";
        checked: root.menu-kind == 1;
        clicked => { root.toggle-menu(1, self.absolute-position.x); }
    }
    IconOverLabelToolbarItem {
        icon: "zoom-fit";
        label: "Zoom";
        checked: root.menu-kind == 2;
        clicked => { root.toggle-menu(2, self.absolute-position.x); }
    }
    IconOverLabelToolbarItem {
        icon: "plus";
        label: "Add Sheet";
        clicked => { root.command("sheets.add_sheet"); }
    }

    ToolbarSpacer { }

    IconOverLabelToolbarItem {
        icon: "chart";
        label: "Chart";
        clicked => { root.command("sheets.insert_chart"); }
    }
    IconOverLabelToolbarItem {
        icon: "table";
        label: "Table";
        checked: root.menu-kind == 3;
        clicked => { root.toggle-menu(3, self.absolute-position.x); }
    }
    IconOverLabelToolbarItem {
        icon: "text";
        label: "Text";
        checked: root.menu-kind == 4;
        clicked => { root.toggle-menu(4, self.absolute-position.x); }
    }
    IconOverLabelToolbarItem {
        icon: "shape";
        label: "Shape";
        clicked => { root.command("sheets.insert_shape"); }
    }
    IconOverLabelToolbarItem {
        icon: "image";
        label: "Image";
        clicked => { root.command("sheets.insert_image"); }
    }

    ToolbarSpacer { }

    IconOverLabelToolbarItem {
        icon: "export";
        label: "Export";
        checked: root.menu-kind == 5;
        clicked => { root.toggle-menu(5, self.absolute-position.x); }
    }
    format-item := IconOverLabelToolbarItem {
        icon: "format";
        label: "Format";
        checked: root.inspector-visible && root.inspector-tab == 1;
        clicked => { root.show-inspector-tab(1); }
    }
    IconOverLabelToolbarItem {
        icon: "organize";
        label: "Organize";
        checked: root.inspector-visible && root.inspector-tab == 0;
        clicked => { root.show-inspector-tab(0); }
    }
    overflow-button := LoomOverflowButton {
        clicked => { root.overflow-requested(); }
    }
}
