import {
    LoomToolbar, LoomToolbarGroup, LoomToolbarSpacer, LoomToolbarDivider,
    LoomButton, LoomIconButton, LoomOverflowButton,
} from "foundation.slint";
import { Theme } from "theme.slint";

export component SheetActionToolbar inherits LoomToolbar {
    in property <bool> rtl: Theme.rtl;
    in property <bool> wide: false;
    in property <bool> icon-only: false;
    in property <bool> overflow: false;
    in property <bool> inspector-available: true;
    in property <bool> inspector-visible: false;
    in property <bool> labeled-export: false;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in property <string> zoom-level: "125%";
    in property <bool> cell-bold: false;
    in property <bool> cell-italic: false;
    in property <bool> cell-underline: false;
    in property <int> cell-alignment: 0;

    callback undo;
    callback redo;
    callback new-sheet;
    callback open-sheet;
    callback save-sheet;
    callback save-as-sheet;
    callback open-palette;
    callback toggle-inspector;
    callback export-csv;
    callback overflow-requested;
    callback zoom-clicked;
    callback toggle-bold;
    callback toggle-italic;
    callback toggle-underline;
    callback set-cell-alignment(int);
    callback add-row;
    callback add-col;
    callback insert-chart;
    callback organize;
    public function focus-overflow-trigger() { overflow-button.grab-focus(); }

    public function focus-inspector-trigger() {
        if (root.icon-only) {
            inspector-icon-button.grab-focus();
        } else {
            inspector-button.grab-focus();
        }
    }

    changed inspector-visible => {
        if (!root.inspector-visible) {
            root.focus-inspector-trigger();
        }
    }

    // File commands stay on the local toolbar so Linux users can discover
    // the core workflow without relying on a native menu host or shortcuts.
    LoomToolbarGroup {
        if root.wide : LoomButton {
            icon: "plus";
            label: "New";
            variant: "ghost";
            clicked => { root.new-sheet(); }
        }
        if !root.wide : LoomIconButton {
            icon: "plus";
            label: "New workbook";
            tooltip: "Start a new workbook. Confirm before replacing unsaved changes.";
            clicked => { root.new-sheet(); }
        }
        if root.wide : LoomButton {
            icon: "open";
            label: "Open";
            variant: "ghost";
            clicked => { root.open-sheet(); }
        }
        if !root.wide : LoomIconButton {
            icon: "open";
            label: "Open workbook";
            tooltip: "Choose a workbook file to open.";
            clicked => { root.open-sheet(); }
        }
        if root.wide : LoomButton {
            icon: "save";
            label: "Save";
            variant: "ghost";
            clicked => { root.save-sheet(); }
        }
        if !root.wide : LoomIconButton {
            icon: "save";
            label: "Save workbook";
            tooltip: "Save changes to the current workbook.";
            clicked => { root.save-sheet(); }
        }
        if root.wide : LoomButton {
            icon: "save-as";
            label: "Save As";
            variant: "ghost";
            clicked => { root.save-as-sheet(); }
        }
        if !root.wide : LoomIconButton {
            icon: "save-as";
            label: "Save workbook as";
            tooltip: "Choose a file and save the current workbook there.";
            clicked => { root.save-as-sheet(); }
        }
        if root.wide : LoomButton {
            icon: "search";
            label: "Commands";
            variant: "ghost";
            clicked => { root.open-palette(); }
        }
        if !root.wide : LoomIconButton {
            icon: "search";
            label: "Command palette";
            tooltip: "Open the command palette to search for and run commands.";
            clicked => { root.open-palette(); }
        }
    }

    LoomToolbarDivider { }

    LoomToolbarGroup {
        LoomButton {
            icon: "zoom-in";
            label: root.zoom-level;
            variant: "ghost";
            clicked => { root.zoom-clicked(); }
        }
        LoomIconButton {
            icon: "undo";
            label: "Undo";
            tooltip: "Undo the most recent workbook change.";
            enabled: root.can-undo;
            clicked => { root.undo(); }
        }
        LoomIconButton {
            icon: "redo";
            label: "Redo";
            tooltip: "Redo the last undone workbook change.";
            enabled: root.can-redo;
            clicked => { root.redo(); }
        }
    }

    LoomToolbarDivider { }

    LoomToolbarGroup {
        LoomIconButton {
            icon: "bold";
            label: "Toggle bold formatting (toolbar)";
            tooltip: "Turn bold formatting on or off for selected cells from the toolbar.";
            selected: root.cell-bold;
            clicked => { root.toggle-bold(); }
        }
        LoomIconButton {
            icon: "italic";
            label: "Toggle italic formatting (toolbar)";
            tooltip: "Turn italic formatting on or off for selected cells from the toolbar.";
            selected: root.cell-italic;
            clicked => { root.toggle-italic(); }
        }
        LoomIconButton {
            icon: "underline";
            label: "Toggle underline formatting (toolbar)";
            tooltip: "Turn underline formatting on or off for selected cells from the toolbar.";
            selected: root.cell-underline;
            clicked => { root.toggle-underline(); }
        }
    }

    LoomToolbarDivider { }

    LoomToolbarGroup {
        LoomIconButton {
            icon: "align-left";
            label: "Align selected cells left";
            tooltip: "Set horizontal alignment of selected cells to left.";
            selected: root.cell-alignment == 0;
            clicked => { root.set-cell-alignment(0); }
        }
        LoomIconButton {
            icon: "align-center";
            label: "Align selected cells center";
            tooltip: "Set horizontal alignment of selected cells to center.";
            selected: root.cell-alignment == 1;
            clicked => { root.set-cell-alignment(1); }
        }
        LoomIconButton {
            icon: "align-right";
            label: "Align selected cells right";
            tooltip: "Set horizontal alignment of selected cells to right.";
            selected: root.cell-alignment == 2;
            clicked => { root.set-cell-alignment(2); }
        }
    }

    LoomToolbarDivider { }

    LoomToolbarGroup {
        if !root.overflow : LoomButton {
            icon: "plus";
            label: "Row";
            variant: "ghost";
            clicked => { root.add-row(); }
        }
        if !root.overflow : LoomButton {
            icon: "plus";
            label: "Col";
            variant: "ghost";
            clicked => { root.add-col(); }
        }
        if !root.overflow : LoomButton {
            icon: "chart";
            label: "Chart";
            variant: "ghost";
            clicked => { root.insert-chart(); }
        }
    }

    LoomToolbarSpacer { }

    LoomToolbarGroup {
        if !root.overflow : LoomButton {
            icon: "export";
            label: root.labeled-export ? "Export" : "";
            accessible-label: "Export CSV";
            accessible-description: "Export the active worksheet as CSV";
            variant: "ghost";
            clicked => { root.export-csv(); }
        }
        inspector-icon-button := LoomIconButton {
            visible: root.icon-only;
            icon: "format";
            label: "Format inspector";
            tooltip: "Open or close the format inspector.";
            selected: root.inspector-visible;
            enabled: root.inspector-available;
            clicked => { if (root.inspector-available) { root.toggle-inspector(); } }
        }
        inspector-button := LoomButton {
            visible: !root.icon-only;
            icon: "format";
            label: "Format";
            variant: root.inspector-visible ? "primary" : "ghost";
            selected: root.inspector-visible;
            enabled: root.inspector-available;
            clicked => { if (root.inspector-available) { root.toggle-inspector(); } }
        }
        if !root.overflow : LoomButton {
            icon: "organize";
            label: "Sort";
            variant: "ghost";
            clicked => { root.organize(); }
        }
        overflow-button := LoomOverflowButton {
            visible: root.overflow;
            clicked => { root.overflow-requested(); }
        }
    }
}
