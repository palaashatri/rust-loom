import { LoomMenuItem } from "foundation.slint";
import { Theme } from "theme.slint";

/// The menu that opens under a toolbar item, with its click-away scrim and
/// keyboard handling (Up/Down move, Return or Space run, Escape closes).
/// Every row sends a command id through `command`; the shared Rust dispatcher
/// performs it.
export component SheetToolbarMenu inherits Rectangle {
    /// 1 = View, 2 = Zoom, 3 = Table, 4 = Text, 5 = Export; 0 hides the menu.
    in property <int> kind: 0;
    in property <length> menu-x: 0px;
    in property <length> menu-y: 0px;
    in property <bool> inspector-visible: false;
    in property <bool> cell-bold: false;
    in property <bool> cell-italic: false;
    in property <bool> cell-underline: false;
    in property <int> cell-alignment: 0;
    in property <string> mod-key: "Ctrl+";
    callback command(string);
    callback close-requested;
    public function focus-menu() { menu-focus.focus(); }

    property <int> selected: 0;
    property <[string]> labels: root.kind == 1 ? ["Format Inspector", "Command Palette", "Appearance: System", "Appearance: Light", "Appearance: Dark", "Appearance: High Contrast"]
        : root.kind == 2 ? ["Zoom In", "Zoom Out", "Actual Size"]
        : root.kind == 3 ? ["Add Row", "Add Column", "Sort", "Sort Descending", "Delete Row", "Delete Column", "Freeze Header Row", "Delete Sheet"]
        : root.kind == 4 ? ["Bold", "Italic", "Underline", "Align Left", "Align Center", "Align Right"]
        : root.kind == 5 ? ["Export CSV", "Export Excel"] : [];
    property <[string]> ids: root.kind == 1 ? ["view.inspector", "app.palette", "view.appearance.system", "view.appearance.light", "view.appearance.dark", "view.appearance.high_contrast"]
        : root.kind == 2 ? ["view.zoom_in", "view.zoom_out", "view.zoom_actual"]
        : root.kind == 3 ? ["table.add_row", "table.add_col", "sheets.organize", "table.sort_desc", "table.delete_row", "table.delete_col", "table.freeze_header", "sheets.delete_sheet"]
        : root.kind == 4 ? ["format.bold", "format.italic", "format.underline", "format.align_left", "format.align_center", "format.align_right"]
        : root.kind == 5 ? ["file.export_csv", "file.export_xlsx"] : [];
    property <[string]> shortcuts: root.kind == 1 ? [root.mod-key + "Alt+I", root.mod-key + "K", root.mod-key + "Alt+6", root.mod-key + "Alt+7", root.mod-key + "Shift+D", root.mod-key + "Shift+H"]
        : root.kind == 2 ? [root.mod-key + "=", root.mod-key + "-", root.mod-key + "0"]
        : root.kind == 3 ? [root.mod-key + "Alt+R", root.mod-key + "Alt+K", root.mod-key + "Alt+S", root.mod-key + "Alt+D", root.mod-key + "Alt+W", root.mod-key + "Alt+L", root.mod-key + "Alt+F", root.mod-key + "Alt+X"]
        : root.kind == 4 ? [root.mod-key + "B", root.mod-key + "I", root.mod-key + "U", root.mod-key + "Shift+L", root.mod-key + "Shift+M", root.mod-key + "Shift+R"]
        : root.kind == 5 ? [root.mod-key + "E", root.mod-key + "Shift+E"] : [];
    property <[bool]> checks: root.kind == 1 ? [root.inspector-visible, false, Theme.appearance == "system", Theme.appearance == "light", Theme.appearance == "dark", Theme.appearance == "high-contrast"]
        : root.kind == 4 ? [root.cell-bold, root.cell-italic, root.cell-underline,
            root.cell-alignment == 0, root.cell-alignment == 1, root.cell-alignment == 2] : [];
    property <[bool]> checkables: root.kind == 1 ? [true, false, true, true, true, true]
        : root.kind == 4 ? [true, true, true, true, true, true] : [];

    changed kind => { root.selected = 0; }

    visible: root.kind != 0;
    background: transparent;
    TouchArea { clicked => { root.close-requested(); } }

    menu-focus := FocusScope {
        enabled: root.kind != 0;
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.close-requested(); return accept; }
            if (event.text == Key.DownArrow) { root.selected = Math.mod(root.selected + 1, root.labels.length); return accept; }
            if (event.text == Key.UpArrow) { root.selected = Math.mod(root.selected + root.labels.length - 1, root.labels.length); return accept; }
            if (event.text == Key.Return || event.text == " ") {
                if (root.selected < root.ids.length) { root.command(root.ids[root.selected]); }
                return accept;
            }
            return reject;
        }
    }
    Rectangle {
        // Opens at the item's reading-start edge: its left edge in LTR; in RTL
        // the menu's right edge lines up with the item's right edge.
        x: Theme.rtl
            ? max(8px, min(root.menu-x - self.width, root.width - self.width - 8px))
            : max(0px, min(root.menu-x, root.width - self.width - 8px));
        y: root.menu-y;
        width: min(296px * max(1.0, Theme.text-scale), max(1px, root.width - 16px));
        height: items.preferred-height;
        border-radius: Theme.tokens.metrics.radius-medium;
        border-width: 1px;
        border-color: Theme.palette().border;
        background: Theme.palette().surface;
        drop-shadow-blur: 16px;
        drop-shadow-offset-y: 4px;
        drop-shadow-color: Theme.palette().shadow;

        items := VerticalLayout {
            spacing: 2px;
            padding: Theme.tokens.space.sm;
            for label[idx] in root.labels : LoomMenuItem {
                label: label;
                shortcut: idx < root.shortcuts.length ? root.shortcuts[idx] : "";
                checked: idx < root.checks.length && root.checks[idx];
                checkable: idx < root.checkables.length && root.checkables[idx];
                selected: idx == root.selected;
                pointer-hovered => { root.selected = idx; }
                activated => { root.command(root.ids[idx]); }
            }
        }
    }
}
