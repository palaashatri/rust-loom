// Rows of the Sheets inspector. Each row lists its parts from the reading-start
// edge, so right-to-left is the exact mirror image of left-to-right: label,
// then field, then the buttons; or buttons, field, label.
import { LoomTextField, LoomNumericField, LoomButton, LoomIconButton, LoomSectionHeader } from "foundation.slint";
import { Theme } from "theme.slint";
import { CellInk } from "grid_pointer.slint";

component SheetRowLabel inherits Text {
    min-width: 84px;
    max-width: 100px;
    font-size: Theme.type.caption;
    color: Theme.palette().ink-secondary;
    wrap: word-wrap;
    vertical-alignment: center;
    horizontal-alignment: Theme.rtl ? right : left;
    accessible-role: text;
}

/// A section heading. The shared header pads its text by space.xl, so the heading
/// moves back by that much: its text starts at the column edge of the rows below.
export component SheetHeading inherits Rectangle {
    in property <string> title: "";
    height: Theme.tokens.metrics.panel-header-height;

    LoomSectionHeader {
        x: Theme.rtl ? Theme.tokens.space.xl : -Theme.tokens.space.xl;
        width: Theme.rtl ? parent.width : parent.width + Theme.tokens.space.xl;
        height: parent.height;
        title: root.title;
    }
}

/// A read-only value: a sunken well with no input outline, so it does not look
/// like a field that takes typing. Editable fields keep the shared outline.
component SheetValueBox inherits Rectangle {
    in property <string> field-label: "";
    in property <string> value: "";
    in property <bool> placeholder: false;

    min-width: 140px;
    horizontal-stretch: 1;
    height: Theme.scaled-control-height;
    border-radius: Theme.tokens.metrics.radius-medium;
    background: Theme.palette().surface-sunken;
    // High contrast gives every field an outline: the sunken well is the same
    // black as the panel, so a borderless value does not read as a field.
    border-width: Theme.active-theme == "high-contrast" ? 1px : 0px;
    border-color: Theme.palette().border;
    accessible-role: text;
    accessible-label: root.field-label;
    accessible-value: root.value;

    Text {
        x: Theme.tokens.space.md;
        width: parent.width - Theme.tokens.space.xl;
        height: parent.height;
        text: root.value;
        font-size: Theme.type.body;
        color: root.placeholder ? Theme.palette().ink-disabled : Theme.palette().ink-secondary;
        horizontal-alignment: Theme.rtl ? right : left;
        vertical-alignment: center;
        overflow: elide;
    }
}

/// A label with one field: an editable field gets the shared input; a read-only
/// value gets the subdued well.
export component SheetFieldRow inherits Rectangle {
    in property <string> label: "";
    in property <string> field-label: "";
    in property <string> value: "";
    in property <bool> editable: false;
    in property <bool> placeholder: false;
    callback edited(string);

    min-width: 0px;
    vertical-stretch: 0;
    min-height: Theme.scaled-control-height;
    if !Theme.rtl : HorizontalLayout {
        spacing: Theme.tokens.space.sm;
        cross-axis-alignment: center;
        SheetRowLabel { text: root.label; accessible-label: root.label; }
        if root.editable : LoomTextField {
            label: root.field-label;
            value: root.value;
            edited(text) => { root.edited(text); }
        }
        if !root.editable : SheetValueBox {
            field-label: root.field-label;
            value: root.value;
            placeholder: root.placeholder;
        }
    }
    if Theme.rtl : HorizontalLayout {
        spacing: Theme.tokens.space.sm;
        cross-axis-alignment: center;
        if root.editable : LoomTextField {
            label: root.field-label;
            value: root.value;
            edited(text) => { root.edited(text); }
        }
        if !root.editable : SheetValueBox {
            field-label: root.field-label;
            value: root.value;
            placeholder: root.placeholder;
        }
        SheetRowLabel { text: root.label; accessible-label: root.label; }
    }
}

/// The two step buttons, in reading order: decrease then increase (or the
/// other way round with `plus-first`); the order mirrors in right-to-left.
component SheetStepButtons inherits HorizontalLayout {
    in property <bool> plus-first: false;
    in property <string> decrease-label: "";
    in property <string> decrease-tip: "";
    in property <string> increase-label: "";
    in property <string> increase-tip: "";
    callback decrease;
    callback increase;

    spacing: Theme.tokens.space.xs;
    for slot in 2 : LoomIconButton {
        property <int> pos: Theme.rtl ? 1 - slot : slot;
        property <bool> plus: (self.pos == 0) == root.plus-first;
        icon: self.plus ? "plus" : "minus";
        label: self.plus ? root.increase-label : root.decrease-label;
        tooltip: self.plus ? root.increase-tip : root.decrease-tip;
        text-scale: Theme.text-scale;
        clicked => { if (self.plus) { root.increase(); } else { root.decrease(); } }
    }
}

/// A label, a read-only value and two step buttons (decrease, increase).
export component SheetStepperRow inherits Rectangle {
    in property <string> label: "";
    in property <string> field-label: "";
    in property <string> value: "";
    in property <bool> plus-first: false;
    in property <string> decrease-label: "";
    in property <string> decrease-tip: "";
    in property <string> increase-label: "";
    in property <string> increase-tip: "";
    in property <bool> editable: false;
    in property <string> edit-unit: "";
    in property <string> edit-description: "";
    in-out property <string> edit-value: "";
    in-out property <bool> invalid: false;
    callback decrease;
    callback increase;
    callback edited(string);
    callback accepted(string) -> bool;
    callback cancelled;

    // Stack when the label, the field's 140 px minimum and both full-size
    // buttons cannot share a line. Scaling also gives the label its own line.
    private property <bool> stacked: root.width < 100px + Theme.tokens.space.sm
        + 140px + 2 * Theme.tokens.metrics.control-height + 2 * Theme.tokens.space.xs
        || Theme.text-scale > 1;
    min-width: 0px;
    height: row-layout.preferred-height;
    vertical-stretch: 0;
    row-layout := GridLayout {
        width: root.width;
        spacing: Theme.tokens.space.sm;
        SheetRowLabel {
            row: 0;
            col: !root.stacked && Theme.rtl ? 1 : 0;
            text: root.label;
            accessible-label: root.label;
            horizontal-stretch: root.stacked ? 1 : 0;
            max-width: root.stacked ? root.width : 100px;
        }
        HorizontalLayout {
            row: root.stacked ? 1 : 0;
            col: root.stacked || Theme.rtl ? 0 : 1;
            spacing: Theme.tokens.space.xs;
            if Theme.rtl : SheetStepButtons {
                plus-first: root.plus-first;
                decrease-label: root.decrease-label; decrease-tip: root.decrease-tip;
                increase-label: root.increase-label; increase-tip: root.increase-tip;
                decrease => { root.decrease(); }
                increase => { root.increase(); }
            }
            if root.editable : LoomNumericField {
                field-min-width: 140px;
                label: root.field-label;
                description: root.edit-description;
                unit: root.edit-unit;
                value <=> root.edit-value;
                invalid <=> root.invalid;
                edited(text) => { root.edited(text); }
                accepted(text) => { root.invalid = !root.accepted(text); }
                cancelled => { root.cancelled(); }
            }
            if !root.editable : SheetValueBox { field-label: root.field-label; value: root.value; }
            if !Theme.rtl : SheetStepButtons {
                plus-first: root.plus-first;
                decrease-label: root.decrease-label; decrease-tip: root.decrease-tip;
                increase-label: root.increase-label; increase-tip: root.increase-tip;
                decrease => { root.decrease(); }
                increase => { root.increase(); }
            }
        }
    }
}

/// Fill color swatch: pointer shortcut for direct color choice. Every fill
/// state stays keyboard-reachable through the palette's Fill cycle command.
component FillSwatch inherits Rectangle {
    in property <color> swatch-color: transparent;
    in property <bool> selected: false;
    in property <string> swatch-label: "";
    in property <int> swatch-index: -1;
    // The ring drawn round the chosen swatch; dark text colours need a ring
    // that does not blend into them.
    in property <color> ring: Theme.palette().accent;
    callback pick(int);
    width: 24px;
    height: 24px;
    border-radius: 4px;
    background: root.swatch-color;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? root.ring : Theme.palette().border;
    accessible-role: button;
    accessible-label: root.swatch-label;
    TouchArea { clicked => { root.pick(root.swatch-index); } }
}

/// The eight fill choices, red first; right-to-left starts from the right edge.
export component SheetFillRow inherits HorizontalLayout {
    in property <int> cell-fill: -1;
    callback set-fill(int);

    spacing: Theme.tokens.space.xs;
    alignment: Theme.rtl ? end : start;
    for slot in 8 : FillSwatch {
        property <int> k: Theme.rtl ? 7 - slot : slot;
        property <int> fill: k == 7 ? -1 : k;
        swatch-color: [#FECACA, #FED7AA, #FEF08A, #BBF7D0, #BFDBFE, #DDD6FE, #E5E7EB, transparent][self.k];
        selected: root.cell-fill == self.fill;
        swatch-label: ["Fill red", "Fill orange", "Fill yellow", "Fill green", "Fill blue", "Fill purple", "Fill gray", "No fill"][self.k];
        swatch-index: self.fill;
        pick(idx) => { root.set-fill(idx); }
    }
}

/// The text colour choices: seven colours and "Automatic" (the paper's ink).
/// The palette comes from the app so the swatches and the colours applied are
/// one list; right-to-left starts from the right edge.
export component SheetTextColorRow inherits HorizontalLayout {
    spacing: Theme.tokens.space.xs;
    alignment: Theme.rtl ? end : start;
    for slot in 8 : FillSwatch {
        property <int> k: Theme.rtl ? 7 - slot : slot;
        property <int> choice: k == 7 ? -1 : k;
        swatch-color: k == 7 ? transparent : (k < CellInk.palette.length ? CellInk.palette[k] : transparent);
        selected: CellInk.selected-slot == self.choice;
        ring: Theme.palette().ink;
        swatch-label: ["Text red", "Text orange", "Text green", "Text blue", "Text purple", "Text gray", "Text black", "Automatic text colour"][self.k];
        swatch-index: self.choice;
        pick(idx) => { CellInk.color-requested(idx); }
    }
}

/// A group of choice buttons, the current one filled; first choice at the
/// reading-start edge.
export component SheetChoiceRow inherits HorizontalLayout {
    in property <[string]> choices: [];
    // Spoken names for the choices whose captions are symbols ("123", "$").
    in property <[string]> choice-names: [];
    in property <int> current: 0;
    callback chosen(int);

    spacing: Theme.tokens.space.xs;
    alignment: Theme.rtl ? end : start;
    for slot in root.choices.length : LoomButton {
        property <int> k: Theme.rtl ? root.choices.length - 1 - slot : slot;
        label: root.choices[self.k];
        accessible-name: root.choice-names.length > self.k ? root.choice-names[self.k] : "";
        variant: root.current == self.k ? "primary" : "ghost";
        clicked => { root.chosen(self.k); }
    }
}
