import { LoomButton, LoomPanel, LoomTextField } from "foundation.slint";
import { Theme } from "theme.slint";
import { CellRichFormat } from "rich_format.slint";

export component ConditionalFormatModal inherits Rectangle {
    in property <bool> open: false;

    visible: root.open;
    background: #00000066;

    if root.open : Rectangle {
        width: 100%;
        height: 100%;

        TouchArea {
            clicked => { CellRichFormat.cf-close(); }
        }

        FocusScope {
            width: 100%;
            height: 100%;
            enabled: root.open;
            init => { self.focus(); }
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    CellRichFormat.cf-close();
                    return accept;
                }
                // Tab is a closed cycle between the header Close button and
                // Clear Selection Rules, so focus never leaves the modal.
                if (event.text == Key.Backtab || (event.text == Key.Tab && event.modifiers.shift)) {
                    if (self.has-focus || cf-close.has-focus) { cf-clear.grab-focus(); return accept; }
                    return reject;
                }
                if (event.text == Key.Tab) {
                    if (self.has-focus || cf-clear.has-focus) { cf-close.grab-focus(); return accept; }
                    return reject;
                }
                return reject;
            }

            LoomPanel {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(460px, parent.width - 32px);
                height: min(500px, parent.height - 32px);
                border-radius: Theme.tokens.metrics.radius-large;
                border-width: 1px;
                border-color: Theme.palette().border;

                TouchArea { }

                VerticalLayout {
                    padding: Theme.tokens.space.xl;
                    spacing: Theme.tokens.space.md;

                    HorizontalLayout {
                        Text {
                            text: "Conditional Formatting (" + CellRichFormat.cf-range + ")";
                            font-size: Theme.type.title;
                            font-weight: 700;
                            color: Theme.palette().ink;
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                        }
                        cf-close := LoomButton {
                            label: "Close";
                            variant: "ghost";
                            clicked => { CellRichFormat.cf-close(); }
                        }
                    }

                    Text {
                        text: "New Rule";
                        font-size: Theme.type.caption;
                        font-weight: 600;
                        color: Theme.palette().ink-secondary;
                    }

                    HorizontalLayout {
                        spacing: Theme.tokens.space.xs;
                        for op-label[idx] in ["> Greater", "< Less", "= Equal", "Contains"] : LoomButton {
                            label: op-label;
                            variant: CellRichFormat.cf-operator == idx ? "primary" : "secondary";
                            clicked => { CellRichFormat.cf-operator = idx; }
                        }
                    }

                    LoomTextField {
                        placeholder: "Comparison value (e.g. 100 or Error)";
                        value <=> CellRichFormat.cf-value;
                    }

                    HorizontalLayout {
                        spacing: Theme.tokens.space.sm;
                        Text {
                            text: "Fill:";
                            font-size: Theme.type.caption;
                            color: Theme.palette().ink-secondary;
                            vertical-alignment: center;
                            width: 44px;
                        }
                        for swatch[idx] in [#FECACA, #FED7AA, #FEF08A, #BBF7D0, #BFDBFE, #DDD6FE, #E5E7EB] : Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 4px;
                            background: swatch;
                            border-width: CellRichFormat.cf-fill == idx ? 2px : 1px;
                            border-color: CellRichFormat.cf-fill == idx ? Theme.palette().selection : Theme.palette().border;
                            TouchArea {
                                clicked => { CellRichFormat.cf-fill = idx; }
                            }
                        }
                        LoomButton {
                            label: "None";
                            variant: CellRichFormat.cf-fill == -1 ? "primary" : "ghost";
                            clicked => { CellRichFormat.cf-fill = -1; }
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.tokens.space.sm;
                        Text {
                            text: "Text:";
                            font-size: Theme.type.caption;
                            color: Theme.palette().ink-secondary;
                            vertical-alignment: center;
                            width: 44px;
                        }
                        LoomButton {
                            label: "Auto";
                            variant: CellRichFormat.cf-text-color == -1 ? "primary" : "ghost";
                            clicked => { CellRichFormat.cf-text-color = -1; }
                        }
                        for ink-swatch[idx] in [#C62828, #E65100, #2E7D32, #1565C0, #6A1B9A, #616161, #000000] : Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 11px;
                            background: ink-swatch;
                            border-width: CellRichFormat.cf-text-color == idx ? 2px : 1px;
                            border-color: CellRichFormat.cf-text-color == idx ? Theme.palette().selection : Theme.palette().border;
                            TouchArea {
                                clicked => { CellRichFormat.cf-text-color = idx; }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: Theme.tokens.space.sm;
                        LoomButton {
                            label: "Add Rule";
                            variant: "primary";
                            clicked => {
                                CellRichFormat.cf-add-rule(
                                    CellRichFormat.cf-operator,
                                    CellRichFormat.cf-value,
                                    CellRichFormat.cf-fill,
                                    CellRichFormat.cf-text-color
                                );
                            }
                        }
                        cf-clear := LoomButton {
                            label: "Clear Selection Rules";
                            variant: "secondary";
                            clicked => { CellRichFormat.cf-clear-selection(); }
                        }
                    }

                    Text {
                        text: "Active Rules (" + CellRichFormat.cf-rules.length + ")";
                        font-size: Theme.type.caption;
                        font-weight: 600;
                        color: Theme.palette().ink-secondary;
                    }

                    Flickable {
                        vertical-stretch: 1;
                        viewport-height: rules-list.preferred-height;
                        rules-list := VerticalLayout {
                            spacing: Theme.tokens.space.xs;
                            for rule[idx] in CellRichFormat.cf-rules : Rectangle {
                                height: 32px;
                                border-radius: Theme.tokens.metrics.radius-small;
                                border-width: 1px;
                                border-color: Theme.palette().border;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 8px;
                                    Text {
                                        text: rule.range + ": " + rule.operator + " \"" + rule.value + "\" (" + rule.fill-name + ")";
                                        font-size: Theme.type.caption;
                                        color: Theme.palette().ink;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    LoomButton {
                                        label: "Remove";
                                        variant: "ghost";
                                        clicked => { CellRichFormat.cf-remove-rule(idx); }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
