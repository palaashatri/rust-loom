import { LoomButton } from "foundation.slint";
import { Theme } from "theme.slint";
import {
    BlankPreview, ChecklistPreview, TableChartPreview, PivotPreview,
    ChartingPreview, BudgetPreview, MonthlyBudgetPreview, MonthlyGoalPreview,
    PortfolioPreview, NetWorthPreview, InvoicePreview,
} from "template_previews.slint";

export component SheetsTemplateCard inherits Rectangle {
    in property <string> title: "";
    in property <bool> selected: false;
    in property <length> preview-width: 144px;
    in property <length> preview-height: 96px;
    in property <color> preview-background: #ffffff;
    in property <float> text-scale: 1.0;
    callback clicked;

    width: 156px;
    height: max(160px, root.preview-height + 14px + 44px * root.text-scale);
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { root.clicked(); }

    VerticalLayout {
        spacing: 6px;
        alignment: start;
        cross-axis-alignment: center;

        // Preview frame: inset previews inside the 2.5 px selected border so
        // full-bleed thumbnails never paint over top/side border strokes.
        Rectangle {
            width: root.preview-width;
            height: root.preview-height;
            border-radius: Theme.tokens.metrics.radius-small;
            background: root.preview-background;
            border-width: root.selected ? 2.5px : 1px;
            border-color: root.selected ? Theme.palette().success : Theme.palette().border;
            clip: true;
            drop-shadow-blur: root.selected ? 6px : 3px;
            drop-shadow-offset-y: 1.5px;
            drop-shadow-color: Theme.palette().shadow;

            Rectangle {
                x: 3px;
                y: 3px;
                width: parent.width - 6px;
                height: parent.height - 6px;
                border-radius: max(0px, Theme.tokens.metrics.radius-small - 3px);
                clip: true;

                @children
            }
        }

        Text {
            text: root.title;
            font-size: Theme.tokens.typography.caption * root.text-scale;
            font-weight: root.selected ? 600 : 500;
            color: Theme.palette().ink;
            horizontal-alignment: center;
            wrap: word-wrap;
            width: root.width - 8px;
            min-height: 44px * root.text-scale;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

/// One template card whose title and miniature come from its template number,
/// so the left-to-right and right-to-left grids list the same cards.
export component SheetsTemplateOption inherits SheetsTemplateCard {
    in property <int> index: 0;
    in property <int> current: 0;

    title: ["Blank", "Monthly Budget", "Invoice & Expenses", "Checklist", "Table and Chart", "Expense Summary", "Sales Chart", "Budget", "Monthly Goal", "Portfolio", "Net Worth"][root.index];
    selected: root.current == root.index;

    if root.index == 0 : BlankPreview {}
    if root.index == 1 : MonthlyBudgetPreview {}
    if root.index == 2 : InvoicePreview {}
    if root.index == 3 : ChecklistPreview {}
    if root.index == 4 : TableChartPreview {}
    if root.index == 5 : PivotPreview {}
    if root.index == 6 : ChartingPreview {}
    if root.index == 7 : BudgetPreview {}
    if root.index == 8 : MonthlyGoalPreview {}
    if root.index == 9 : PortfolioPreview {}
    if root.index == 10 : NetWorthPreview {}
}

export component TemplateChooserFooter inherits Rectangle {
    callback open-file;
    callback cancel-template;
    callback create-template;
    out property <bool> create-focused: create-button.has-focus;
    public function focus-create() { create-button.grab-focus(); }

    height: 52px;
    background: Theme.palette().chrome;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 1px;
        background: Theme.palette().border;
    }

    open-button := LoomButton {
        label: "Open File…";
        variant: "secondary";
        width: self.preferred-width;
        height: Theme.tokens.metrics.control-height;
        x: Theme.rtl ? parent.width - Theme.tokens.space.xl - self.width : Theme.tokens.space.xl;
        y: (parent.height - self.height) / 2;
        clicked => { root.open-file(); }
    }

    cancel-button := LoomButton {
        label: "Cancel";
        variant: "secondary";
        width: self.preferred-width;
        height: Theme.tokens.metrics.control-height;
        x: Theme.rtl
            ? create-button.x + create-button.width + Theme.tokens.space.lg
            : create-button.x - Theme.tokens.space.lg - self.width;
        y: (parent.height - self.height) / 2;
        clicked => { root.cancel-template(); }
    }

    create-button := LoomButton {
        label: "Create";
        variant: "primary";
        width: self.preferred-width;
        height: Theme.tokens.metrics.control-height;
        x: Theme.rtl ? Theme.tokens.space.xl : parent.width - Theme.tokens.space.xl - self.width;
        y: (parent.height - self.height) / 2;
        clicked => { root.create-template(); }
    }

    Text {
        text: "Esc: cancel • Return: create";
        font-size: Theme.type.caption;
        color: Theme.palette().ink-secondary;
        x: Theme.rtl ? cancel-button.x + cancel-button.width + Theme.tokens.space.lg : open-button.x + open-button.width + Theme.tokens.space.lg;
        width: Theme.rtl
            ? max(0px, open-button.x - Theme.tokens.space.lg - self.x)
            : max(0px, cancel-button.x - Theme.tokens.space.lg - self.x);
        height: parent.height;
        horizontal-alignment: Theme.rtl ? right : left;
        vertical-alignment: center;
        overflow: elide;
    }
}
