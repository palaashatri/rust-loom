import { Theme } from "theme.slint";
import {
    BlankPreview, ChecklistPreview, TableChartPreview, PivotPreview,
    ChartingPreview, BudgetPreview, MonthlyBudgetPreview, MonthlyGoalPreview,
    PortfolioPreview, NetWorthPreview, InvoicePreview,
} from "template_previews.slint";

export component SheetsTemplateCard inherits Rectangle {
    in property <string> title: "";
    in property <bool> selected: false;
    in property <length> preview-width: 144px;
    in property <length> preview-height: 96px;
    in property <color> preview-background: #ffffff;
    in property <float> text-scale: 1.0;
    callback clicked;

    width: 156px;
    height: max(160px, root.preview-height + 14px + 44px * root.text-scale);
    accessible-role: button;
    accessible-label: root.title;
    accessible-action-default => { root.clicked(); }

    VerticalLayout {
        spacing: 6px;
        alignment: start;
        cross-axis-alignment: center;

        // Preview frame
        Rectangle {
            width: root.preview-width;
            height: root.preview-height;
            border-radius: Theme.tokens.metrics.radius-small;
            background: root.preview-background;
            border-width: root.selected ? 2.5px : 1px;
            border-color: root.selected ? Theme.palette().success : Theme.palette().border;
            clip: true;
            drop-shadow-blur: root.selected ? 6px : 3px;
            drop-shadow-offset-y: 1.5px;
            drop-shadow-color: Theme.palette().shadow;

            @children
        }

        Text {
            text: root.title;
            font-size: Theme.tokens.typography.caption * root.text-scale;
            font-weight: root.selected ? 600 : 500;
            color: Theme.palette().ink;
            horizontal-alignment: center;
            wrap: word-wrap;
            width: root.width - 8px;
            min-height: 44px * root.text-scale;
        }
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

/// One template card whose title and miniature come from its template number,
/// so the left-to-right and right-to-left grids list the same cards.
export component SheetsTemplateOption inherits SheetsTemplateCard {
    in property <int> index: 0;
    in property <int> current: 0;

    title: ["Blank", "Monthly Budget", "Invoice & Expenses", "Checklist", "Table and Chart", "Expense Summary", "Sales Chart", "Budget", "Monthly Goal", "Portfolio", "Net Worth"][root.index];
    selected: root.current == root.index;

    if root.index == 0 : BlankPreview {}
    if root.index == 1 : MonthlyBudgetPreview {}
    if root.index == 2 : InvoicePreview {}
    if root.index == 3 : ChecklistPreview {}
    if root.index == 4 : TableChartPreview {}
    if root.index == 5 : PivotPreview {}
    if root.index == 6 : ChartingPreview {}
    if root.index == 7 : BudgetPreview {}
    if root.index == 8 : MonthlyGoalPreview {}
    if root.index == 9 : PortfolioPreview {}
    if root.index == 10 : NetWorthPreview {}
}
