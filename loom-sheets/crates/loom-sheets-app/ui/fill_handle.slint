import { Theme } from "theme.slint";
import { AuditHighlightRect } from "formula_audit_overlay.slint";

/// Global state and callbacks for Sheets P0 parity features.
export global SheetsParityState {
    in-out property <bool> show-formulas: false;
    in-out property <bool> format-painter-active: false;
    in-out property <bool> format-painter-locked: false;
    in-out property <[AuditHighlightRect]> audit-highlights: [];
    in-out property <bool> fill-handle-visible: false;
    in-out property <length> fill-handle-x: 0px;
    in-out property <length> fill-handle-y: 0px;
    in-out property <bool> fill-dragging: false;
    in-out property <length> fill-preview-x: 0px;
    in-out property <length> fill-preview-y: 0px;
    in-out property <length> fill-preview-w: 0px;
    in-out property <length> fill-preview-h: 0px;
    callback autofill-series();
    callback fill-drag-started(length, length);
    callback fill-drag-moved(length, length);
    callback fill-drag-ended(length, length);
    callback hide-rows();
    callback unhide-rows();
    callback hide-cols();
    callback unhide-cols();
    callback freeze-selection();
    callback format-painter-copy();
    callback format-painter-lock();
    callback format-painter-apply();
    callback toggle-show-formulas();
    callback trace-precedents();
    callback trace-dependents();
    callback clear-audit();
}

/// Interactive 6x6px bottom-right selection corner handle + dashed drag preview rect.
export component FillHandleOverlay inherits Rectangle {
    in property <bool> visible-handle: false;
    in property <length> corner-x: 0px;
    in property <length> corner-y: 0px;
    in property <bool> dragging: false;
    in property <length> preview-x: 0px;
    in property <length> preview-y: 0px;
    in property <length> preview-w: 0px;
    in property <length> preview-h: 0px;

    callback drag-started(length, length);
    callback drag-moved(length, length);
    callback drag-ended(length, length);
    callback double-clicked();

    background: transparent;

    if dragging && preview-w > 0px && preview-h > 0px: Rectangle {
        x: preview-x;
        y: preview-y;
        width: preview-w;
        height: preview-h;
        background: Theme.palette().accent.with-alpha(0.08);
        border-width: 1.5px;
        border-color: Theme.palette().accent;
    }

    if visible-handle: Rectangle {
        x: corner-x - 3px;
        y: corner-y - 3px;
        width: 6px;
        height: 6px;
        background: Theme.palette().accent;
        border-width: 1px;
        border-color: Theme.palette().surface;

        TouchArea {
            mouse-cursor: crosshair;
            pointer-event(event) => {
                if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                    root.drag-started(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                } else if event.kind == PointerEventKind.up && event.button == PointerEventButton.left {
                    root.drag-ended(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
            moved => {
                if self.pressed {
                    root.drag-moved(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
            double-clicked => {
                root.double-clicked();
            }
        }
    }
}
