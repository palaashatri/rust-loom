// Pointer gestures on the grid that the controller owns: selecting by press and
// drag, whole row and column selection, resizing from a header edge and the
// name box. A global keeps them out of the window's own callback list.
export global GridPointer {
    // Row, column, shift held.
    callback cell-pressed(int, int, bool);
    // Origin row and column, then the pointer's position relative to that cell.
    callback cell-dragged(int, int, length, length);
    // Is a row header, index, shift held.
    callback header-pressed(bool, int, bool);
    // Is a row header, index, pointer travel since the press, gesture finished.
    callback header-resized(bool, int, length, bool);
    // Text typed in the name box.
    callback goto-cell(string);
    // Ctrl+Arrow: row direction, column direction, shift held.
    callback jump(int, int, bool);
    // The top-left header corner.
    callback corner-pressed();
    // Double-click on a header's resize edge: is a row header, index.
    callback header-autofit(bool, int);
    // The mouse button that selected cells was released.
    callback drag-ended();
}

// Text that runs past its cell into empty neighbours. Geometry is relative to
// the projected grid; row and column are window-local.
export struct SpillItem {
    text: string,
    x: length,
    y: length,
    width: length,
    height: length,
    row: int,
    col: int,
    align: int,
    size: length,
    bold: bool,
    italic: bool,
}

export global CellSpill {
    in property <[SpillItem]> items;
    // Per visible cell: 0 plain, 1 drawn by the overflow layer, 2 number (clipped).
    in property <[int]> kinds;
}
