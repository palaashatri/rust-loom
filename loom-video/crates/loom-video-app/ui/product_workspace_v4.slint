import { DocumentChrome, DirectionalLayout, ContextToolbar, LabeledToolbar } from "toolkit.slint";
import { CommandPalette, CommandPaletteItem } from "../../../../loom-core/crates/loom-ui/ui/components.slint";
import {
    VideoToolbarBody, VideoMediaBin, VideoPreviewStage, VideoTransport,
    VideoTimeline, VideoInspector, VideoStatusBar
} from "components.slint";
import { Theme, ResponsivePolicy } from "theme.slint";

export component VideoApp inherits Window {
    title: "Loom Video";
    min-width: 920px;
    min-height: 700px;
    background: Theme.palette().canvas;
    in property <bool> rtl: false;
    changed rtl => { Theme.rtl = root.rtl; }
    // Responsive mode comes from the host so width-dependent panes cannot
    // feed back into the breakpoint predicate and create a binding loop.
    in property <bool> compact-layout: false;
    in property <bool> icon-only-toolbar: false;
    in property <bool> labeled-toolbar: false;
    in property <bool> overflow-toolbar: false;
    callback window-resized(length);
    changed width => { root.window-resized(root.width); }
    // Timeline grammar reserves 180px for track controls at every width so
    // mute/solo actions and names do not collide with the ruler lane.
    property <length> track-header-width: 180px;
    property <float> frame-step: 1.0 / 30.0;
    in-out property <bool> show-inspector: true;
    property <bool> inspector-visible: root.show-inspector && !root.icon-only-toolbar;

    in property <string> project-name: "Untitled Video";
    in property <string> project-format: "1920 × 1080 · 30 fps";
    in property <[string]> track-labels: [];
    in property <[bool]> track-mutes: [];
    in property <[bool]> track-solos: [];
    in property <int> active-track-index: 0;
    in property <[string]> media-bin-items: [];
    in property <[string]> clip-labels: [];
    in property <[float]> clip-starts: [];
    in property <[float]> clip-durations: [];
    in property <[float]> clip-in-points: [];
    in property <[float]> clip-out-points: [];
    in property <[string]> clip-cache-status: [];
    in property <int> active-clip-index: 0;
    in property <image> preview-image;
    in property <bool> has-preview: false;
    in property <bool> preview-synthetic: false;
    in property <bool> backend-available: false;
    in property <string> backend-version: "FFmpeg not found";
    in property <float> timeline-duration: 1;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in property <bool> exporting: false;
    in property <float> export-progress: 0;
    in property <string> status-left: "Ready";
    in property <string> status-right: "Offline";
    in property <string> playback-clock-source: "No clock";
    in property <string> audio-output-status: "Audio output unavailable";
    in-out property <float> timeline-zoom: 1;
    in-out property <float> timeline-scroll: 0;

    in-out property <string> active-nle-tool: "Select";
    in-out property <bool> snap-enabled: true;
    in-out property <bool> is-playing: false;
    in-out property <float> playhead-seconds: 0;
    in-out property <string> timecode-display: "00:00:00:00";
    in-out property <string> import-path: "";
    in-out property <string> export-path: "";
    in-out property <int> inspector-tab: 0;

    callback new-project;
    callback open-project;
    callback save-project;
    callback save-as-project;
    callback undo;
    callback redo;
    callback import-media(string);
    callback select-track(int);
    callback toggle-track-mute(int);
    callback toggle-track-solo(int);
    callback select-clip(int);
    callback remove-clip;
    callback split-clip;
    callback trim-selected(float, float);
    callback move-clip(int, float);
    callback trim-clip-in(int, float);
    callback trim-clip-out(int, float);
    callback begin-clip-gesture(int, string);
    callback end-clip-gesture;
    callback cancel-clip-gesture;
    callback select-nle-tool(string);
    callback toggle-snap;
    callback play-pause;
    callback stop-playback;
    callback seek(float);
    callback add-marker;
    callback export-timeline(string);
    callback cancel-export;

    in-out property <[CommandPaletteItem]> palette-commands: [];
    in-out property <bool> palette-open: false;
    in-out property <string> palette-query: "";
    in-out property <int> palette-selected: 0;
    callback palette-invoked(int);
    callback palette-query-changed(string);
    callback palette-move(int);
    callback palette-key-text(string);
    callback palette-backspace;
    callback palette-close;

    public function open-palette() {
        root.palette-open = true;
        root.palette-query = "";
        palette.grab-focus();
    }

    app-focus := FocusScope {
        key-pressed(event) => {
            if (root.palette-open) { return reject; }
            if ((event.modifiers.control || event.modifiers.meta) && (event.text == Key.K || event.text == "k")) {
                root.open-palette();
                return accept;
            }
            if (event.modifiers.control || event.modifiers.meta) {
                if (event.text == Key.N || event.text == "n") { root.new-project(); return accept; }
                if (event.text == Key.O || event.text == "o") { root.open-project(); return accept; }
                if (event.text == Key.S || event.text == "s") {
                    if (event.modifiers.shift) { root.save-as-project(); } else { root.save-project(); }
                    return accept;
                }
                if (event.text == Key.Z || event.text == "z") {
                    if (event.modifiers.shift) { root.redo(); } else { root.undo(); }
                    return accept;
                }
                if (event.text == Key.I || event.text == "i") { root.import-media(""); return accept; }
                if (event.text == Key.E || event.text == "e") { root.export-timeline(root.export-path); return accept; }
            }
            if (event.text == Key.Space) { root.play-pause(); return accept; }
            return reject;
        }

        VerticalLayout {
        spacing: 0px;

        DocumentChrome {
            title: root.project-name;
            trailing-text: root.project-format;
        }

        if root.labeled-toolbar : LabeledToolbar {
            VideoToolbarBody {
                rtl: root.rtl;
                labeled: true;
                overflow: false;
                active-nle-tool <=> root.active-nle-tool;
                snap-enabled <=> root.snap-enabled;
                show-inspector: root.inspector-visible;
                exporting: root.exporting;
                backend-available: root.backend-available;
                clip-count: root.clip-labels.length;
                import-path: root.import-path;
                export-path: root.export-path;
                select-nle-tool(tool) => {
                    root.active-nle-tool = tool;
                    root.select-nle-tool(tool);
                }
                toggle-snap => { root.toggle-snap(); }
                toggle-inspector => { root.show-inspector = !root.show-inspector; }
                import-media(path) => { root.import-media(path); }
                export-timeline(path) => { root.export-timeline(path); }
                overflow-requested => { root.open-palette(); }
            }
        }
        if !root.labeled-toolbar : ContextToolbar {
            VideoToolbarBody {
                rtl: root.rtl;
                labeled: false;
                overflow: root.overflow-toolbar;
                active-nle-tool <=> root.active-nle-tool;
                snap-enabled <=> root.snap-enabled;
                show-inspector: root.inspector-visible;
                exporting: root.exporting;
                backend-available: root.backend-available;
                clip-count: root.clip-labels.length;
                import-path: root.import-path;
                export-path: root.export-path;
                select-nle-tool(tool) => {
                    root.active-nle-tool = tool;
                    root.select-nle-tool(tool);
                }
                toggle-snap => { root.toggle-snap(); }
                toggle-inspector => { root.show-inspector = !root.show-inspector; }
                import-media(path) => { root.import-media(path); }
                export-timeline(path) => { root.export-timeline(path); }
                overflow-requested => { root.open-palette(); }
            }
        }

        DirectionalLayout {
            rtl: root.rtl;
            spacing: 0px;
            vertical-stretch: 1;

            if !root.rtl : VideoMediaBin {
                panel-width: root.compact-layout ? 200px : 258px;
                media-bin-items: root.media-bin-items;
                import-path <=> root.import-path;
                clip-count: root.clip-labels.length;
                backend-available: root.backend-available;
                backend-version: root.backend-version;
                import-media(path) => { root.import-media(path); }
            }

            if !root.rtl : Rectangle { width: 1px; background: Theme.palette().border; }

            if root.rtl && root.inspector-visible : VideoInspector {
                compact-layout: root.compact-layout;
                clip-labels: root.clip-labels;
                clip-starts: root.clip-starts;
                clip-durations: root.clip-durations;
                clip-in-points: root.clip-in-points;
                clip-out-points: root.clip-out-points;
                clip-cache-status: root.clip-cache-status;
                active-clip-index: root.active-clip-index;
                inspector-tab <=> root.inspector-tab;
                export-path <=> root.export-path;
                backend-available: root.backend-available;
                exporting: root.exporting;
                export-progress: root.export-progress;
                split-clip => { root.split-clip(); }
                trim-selected(in, out) => { root.trim-selected(in, out); }
                remove-clip => { root.remove-clip(); }
                export-timeline(path) => { root.export-timeline(path); }
                cancel-export => { root.cancel-export(); }
            }
            if root.rtl && root.inspector-visible : Rectangle { width: 1px; background: Theme.palette().border; }

            VerticalLayout {
                spacing: 0px;
                horizontal-stretch: 1;

                VideoPreviewStage {
                    compact-layout: root.compact-layout;
                    has-preview: root.has-preview;
                    preview-image: root.preview-image;
                }

                VideoTransport {
                    compact-layout: root.compact-layout;
                    frame-step: root.frame-step;
                    clip-count: root.clip-labels.length;
                    backend-available: root.backend-available;
                    playback-clock-source: root.playback-clock-source;
                    audio-output-status: root.audio-output-status;
                    is-playing <=> root.is-playing;
                    playhead-seconds <=> root.playhead-seconds;
                    timeline-duration: root.timeline-duration;
                    timecode-display: root.timecode-display;
                    play-pause => { root.play-pause(); }
                    stop-playback => { root.stop-playback(); }
                    seek(value) => { root.seek(value); }
                    add-marker => { root.add-marker(); }
                }

                Rectangle { height: 1px; background: Theme.palette().border; }

                VideoTimeline {
                    horizontal-stretch: 1;
                    timeline-duration: root.timeline-duration;
                    zoom-level <=> root.timeline-zoom;
                    scroll-offset <=> root.timeline-scroll;
                    track-header-width: root.track-header-width;
                    track-labels: root.track-labels;
                    track-mutes: root.track-mutes;
                    track-solos: root.track-solos;
                    active-track-index: root.active-track-index;
                    clip-labels: root.clip-labels;
                    clip-starts: root.clip-starts;
                    clip-durations: root.clip-durations;
                    clip-cache-status: root.clip-cache-status;
                    active-clip-index: root.active-clip-index;
                    active-nle-tool: root.active-nle-tool;
                    playhead-seconds <=> root.playhead-seconds;
                    frame-step: root.frame-step;
                    select-track(index) => { root.select-track(index); }
                    toggle-track-mute(index) => { root.toggle-track-mute(index); }
                    toggle-track-solo(index) => { root.toggle-track-solo(index); }
                    select-clip(index) => { root.select-clip(index); }
                    move-clip(index, delta) => { root.move-clip(index, delta); }
                    trim-clip-in(index, delta) => { root.trim-clip-in(index, delta); }
                    trim-clip-out(index, delta) => { root.trim-clip-out(index, delta); }
                    begin-clip-gesture(index, kind) => { root.begin-clip-gesture(index, kind); }
                    end-clip-gesture => { root.end-clip-gesture(); }
                    cancel-clip-gesture => { root.cancel-clip-gesture(); }
                    split-clip => { root.split-clip(); }
                    seek(value) => { root.seek(value); }
                }
            }

            if root.rtl : Rectangle { width: 1px; background: Theme.palette().border; }
            if root.rtl : VideoMediaBin {
                panel-width: root.compact-layout ? 200px : 258px;
                media-bin-items: root.media-bin-items;
                import-path <=> root.import-path;
                clip-count: root.clip-labels.length;
                backend-available: root.backend-available;
                backend-version: root.backend-version;
                import-media(path) => { root.import-media(path); }
            }

            if !root.rtl && root.inspector-visible : Rectangle { width: 1px; background: Theme.palette().border; }
            if !root.rtl && root.inspector-visible : VideoInspector {
                compact-layout: root.compact-layout;
                clip-labels: root.clip-labels;
                clip-starts: root.clip-starts;
                clip-durations: root.clip-durations;
                clip-in-points: root.clip-in-points;
                clip-out-points: root.clip-out-points;
                clip-cache-status: root.clip-cache-status;
                active-clip-index: root.active-clip-index;
                inspector-tab <=> root.inspector-tab;
                export-path <=> root.export-path;
                backend-available: root.backend-available;
                exporting: root.exporting;
                export-progress: root.export-progress;
                split-clip => { root.split-clip(); }
                trim-selected(in, out) => { root.trim-selected(in, out); }
                remove-clip => { root.remove-clip(); }
                export-timeline(path) => { root.export-timeline(path); }
                cancel-export => { root.cancel-export(); }
            }
        }

        VideoStatusBar {
            leading: root.status-left;
            trailing: root.status-right;
        }
        }
    }

    palette := CommandPalette {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
        open: root.palette-open;
        commands: root.palette-commands;
        query: root.palette-query;
        selected: root.palette-selected;
        command-invoked(idx) => {
            root.palette-invoked(idx);
        }
        query-changed(q) => {
            root.palette-query = q;
            root.palette-query-changed(q);
        }
        move-selection(delta) => {
            root.palette-move(delta);
        }
        key-text(text) => {
            root.palette-key-text(text);
        }
        backspace => {
            root.palette-backspace();
        }
        close-requested => {
            root.palette-open = false;
            app-focus.focus();
        }
    }
}
