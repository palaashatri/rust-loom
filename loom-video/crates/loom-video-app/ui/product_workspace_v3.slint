import {
    AppHeader, WorkspaceToolbar, ToolButton, IconButton, PrimaryButton, StatusBar,
    SidebarSurface, InspectorSurface, WorkspaceRow, PaneTabs, Slider,
    Field, MetricChip, CanvasBackdrop, TransportButton, StatusPill
} from "components.slint";
import { Icon } from "icons.slint";
import { Theme } from "theme.slint";

export component VideoApp inherits Window {
    title: "Loom Video";
    min-width: 920px;
    min-height: 700px;
    background: Theme.palette().canvas;
    property <bool> compact-layout: root.width < 1200px;
    property <length> track-header-width: root.compact-layout ? 94px : 124px;
    property <float> frame-step: 1.0 / 30.0;
    property <bool> show-inspector: true;

    in property <string> project-name: "Untitled Video";
    in property <string> project-format: "1920 × 1080 · 30 fps";
    in property <[string]> track-labels: [];
    in property <[bool]> track-mutes: [];
    in property <[bool]> track-solos: [];
    in property <int> active-track-index: 0;
    in property <[string]> media-bin-items: [];
    in property <[string]> clip-labels: [];
    in property <[float]> clip-starts: [];
    in property <[float]> clip-durations: [];
    in property <int> active-clip-index: 0;
    in property <image> preview-image;
    in property <bool> has-preview: false;
    in property <bool> backend-available: false;
    in property <string> backend-version: "FFmpeg not found";
    in property <float> timeline-duration: 1;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in property <bool> exporting: false;
    in property <float> export-progress: 0;
    in property <string> status-left: "Ready";
    in property <string> status-right: "Offline";

    in-out property <string> active-nle-tool: "Select";
    in-out property <bool> snap-enabled: true;
    in-out property <bool> is-playing: false;
    in-out property <float> playhead-seconds: 0;
    in-out property <string> timecode-display: "00:00:00:00";
    in-out property <string> import-path: "";
    in-out property <string> export-path: "loom-video-export.mp4";
    in-out property <int> inspector-tab: 0;

    callback new-project;
    callback open-project;
    callback save-project;
    callback undo;
    callback redo;
    callback import-media(string);
    callback select-track(int);
    callback toggle-track-mute(int);
    callback toggle-track-solo(int);
    callback select-clip(int);
    callback remove-clip;
    callback split-clip;
    callback trim-selected(float, float);
    callback select-nle-tool(string);
    callback toggle-snap;
    callback play-pause;
    callback stop-playback;
    callback seek(float);
    callback add-marker;
    callback export-timeline(string);

    VerticalLayout {
        spacing: 0px;

        AppHeader {
            app-name: "Loom Video";
            document-title: root.project-name;
            icon: "video";
            context: root.project-format;
            state-text: timeline-dragging.pressed ? "Scrubbing timeline" : root.exporting ? "Exporting " + Math.round(root.export-progress) + "%" : root.backend-available ? "Media engine ready" : "Media engine unavailable";
            state-tone: timeline-dragging.pressed || root.exporting ? 1 : root.backend-available ? 0 : 2;
        }

        WorkspaceToolbar {
            ToolButton { icon: "new"; text: "New"; clicked => { root.new-project(); } }
            ToolButton { icon: "open"; text: "Open"; clicked => { root.open-project(); } }
            ToolButton { icon: "save"; text: "Save"; clicked => { root.save-project(); } }
            Rectangle { width: 1px; height: 20px; background: Theme.palette().border; }
            IconButton { icon: "undo"; label: "Undo"; enabled: root.can-undo; clicked => { root.undo(); } }
            IconButton { icon: "redo"; label: "Redo"; enabled: root.can-redo; clicked => { root.redo(); } }
            Rectangle { width: 1px; height: 20px; background: Theme.palette().border; }
            ToolButton {
                icon: "cursor";
                text: "Select";
                checked: root.active-nle-tool == "Select";
                clicked => { root.active-nle-tool = "Select"; root.select-nle-tool("Select"); }
            }
            ToolButton {
                icon: "scissors";
                text: "Blade";
                checked: root.active-nle-tool == "Blade";
                clicked => { root.active-nle-tool = "Blade"; root.select-nle-tool("Blade"); }
            }
            ToolButton {
                icon: "link";
                text: "Snap";
                checked: root.snap-enabled;
                clicked => { root.snap-enabled = !root.snap-enabled; root.toggle-snap(); }
            }
            Rectangle { horizontal-stretch: 1; background: transparent; }
            MetricChip { label: "TC"; value: root.timecode-display; }
            MetricChip { label: "Duration"; value: Math.round(root.timeline-duration * 10) / 10 + " s"; }
            ToolButton {
                icon: "settings";
                text: "Inspector";
                checked: root.show-inspector;
                clicked => { root.show-inspector = !root.show-inspector; }
            }
            PrimaryButton { text: root.exporting ? "Exporting…" : "Export"; enabled: root.backend-available && root.clip-labels.length > 0 && !root.exporting; clicked => { root.export-timeline(root.export-path); } }
        }

        HorizontalLayout {
            spacing: 0px;
            vertical-stretch: 1;

            SidebarSurface {
                width: root.compact-layout ? 190px : 258px;
                title: "Media";
                detail: root.media-bin-items.length + " sources";
                VerticalLayout {
                    spacing: 8px;
                    padding: 10px;
                    Field { label: "Media path"; placeholder: "/path/to/clip.mov"; value <=> root.import-path; }
                    ToolButton { icon: "import"; text: "Import Local Media"; enabled: root.backend-available; clicked => { root.import-media(root.import-path); } }
                    Rectangle { height: 1px; background: Theme.palette().border; }
                    for item[index] in root.media-bin-items : WorkspaceRow {
                        label: item;
                        height: 58px;
                        HorizontalLayout {
                            spacing: 8px;
                            padding: 7px;
                            Rectangle {
                                width: 58px;
                                height: 42px;
                                border-radius: 7px;
                                background: Theme.palette().surface-sunken;
                                border-width: 1px;
                                border-color: Theme.palette().border;
                                Icon { icon: "video"; size: 18px; tint: Theme.palette().accent; }
                            }
                            VerticalLayout {
                                spacing: 3px;
                                Text { text: item; font-size: Theme.tokens.typography.body; color: Theme.palette().ink; overflow: elide; }
                                Text { text: "Local media"; font-size: Theme.tokens.typography.caption; color: Theme.palette().ink-disabled; }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                    Rectangle {
                        min-height: 70px;
                        border-radius: 8px;
                        background: Theme.palette().surface-sunken;
                        border-width: 1px;
                        border-color: Theme.palette().border;
                        VerticalLayout {
                            padding: 9px;
                            spacing: 4px;
                            Text { text: root.backend-available ? "FFmpeg / FFprobe / FFplay" : "Install FFmpeg tools"; font-size: Theme.tokens.typography.body; font-weight: 650; color: Theme.palette().ink; }
                            Text { text: root.backend-version; font-size: Theme.tokens.typography.caption; color: Theme.palette().ink-secondary; overflow: elide; }
                        }
                    }
                }
            }

            Rectangle { width: 1px; background: Theme.palette().border; }

            VerticalLayout {
                spacing: 0px;
                horizontal-stretch: 1;

                CanvasBackdrop {
                    vertical-stretch: 1;
                    Rectangle {
                        x: root.compact-layout ? 10px : 20px;
                        y: root.compact-layout ? 10px : 18px;
                        width: parent.width - (root.compact-layout ? 20px : 40px);
                        height: parent.height - (root.compact-layout ? 20px : 36px);
                        border-radius: 9px;
                        background: Theme.palette().media-stage;
                        clip: true;
                        border-width: 1px;
                        border-color: Theme.palette().border-strong;
                        if root.has-preview : Image { source: root.preview-image; width: parent.width; height: parent.height; image-fit: contain; }
                        if !root.has-preview : VerticalLayout {
                            alignment: center;
                            spacing: 10px;
                            Icon { icon: "video"; size: 44px; tint: Theme.palette().ink-disabled; }
                            Text { text: "Import media to decode a real preview frame"; color: Theme.palette().ink; font-size: Theme.tokens.typography.body-large; horizontal-alignment: center; }
                        }
                        Rectangle {
                            x: 12px;
                            y: 12px;
                            height: 28px;
                            min-width: 174px;
                            border-radius: 8px;
                            background: Theme.palette().scrim;
                            border-width: 1px;
                            border-color: Theme.palette().border-strong;
                            HorizontalLayout {
                                spacing: 7px;
                                padding-left: 9px;
                                padding-right: 9px;
                                StatusPill { text: root.is-playing ? "PLAY" : "PAUSED"; tone: root.is-playing ? 1 : 0; }
                                Text { text: root.timecode-display; color: Theme.palette().paper; font-size: 12px; font-weight: 700; vertical-alignment: center; }
                            }
                        }
                    }
                }

                Rectangle {
                    height: 56px;
                    background: Theme.palette().surface;
                    HorizontalLayout {
                        spacing: 9px;
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: center;
                        TransportButton {
                            icon: "chevron-left";
                            label: "Step one frame backward";
                            enabled: root.clip-labels.length > 0;
                            clicked => {
                                root.playhead-seconds = max(0.0, root.playhead-seconds - root.frame-step);
                                root.seek(root.playhead-seconds);
                            }
                        }
                        TransportButton { icon: root.is-playing ? "pause" : "play"; label: "Play selected media"; enabled: root.backend-available && root.clip-labels.length > 0; active: root.is-playing; clicked => { root.play-pause(); } }
                        TransportButton { icon: "stop"; label: "Stop playback"; enabled: root.is-playing; clicked => { root.stop-playback(); } }
                        TransportButton {
                            icon: "chevron-right";
                            label: "Step one frame forward";
                            enabled: root.clip-labels.length > 0;
                            clicked => {
                                root.playhead-seconds = min(root.timeline-duration, root.playhead-seconds + root.frame-step);
                                root.seek(root.playhead-seconds);
                            }
                        }
                        Text { text: root.timecode-display; width: 88px; color: Theme.palette().ink; font-size: Theme.tokens.typography.body; font-weight: 650; vertical-alignment: center; }
                        Slider { label: "Playhead"; horizontal-stretch: 1; minimum: 0; maximum: Math.max(0.01, root.timeline-duration); value <=> root.playhead-seconds; changed(value) => { root.seek(value); } }
                        IconButton { icon: "plus-circle"; label: "Add marker"; clicked => { root.add-marker(); } }
                    }
                }

                Rectangle { height: 1px; background: Theme.palette().border; }

                timeline-panel := Rectangle {
                    height: 230px;
                    background: Theme.palette().surface-sunken;
                    border-width: 0px;
                    clip: true;

                    timeline-focus := FocusScope {
                        enabled: root.clip-labels.length > 0;
                        key-pressed(event) => {
                            if (event.text == Key.LeftArrow) {
                                root.playhead-seconds = max(0.0, root.playhead-seconds - root.frame-step);
                                root.seek(root.playhead-seconds);
                                return accept;
                            }
                            if (event.text == Key.RightArrow) {
                                root.playhead-seconds = min(root.timeline-duration, root.playhead-seconds + root.frame-step);
                                root.seek(root.playhead-seconds);
                                return accept;
                            }
                            if (event.text == Key.Home) {
                                root.playhead-seconds = 0.0;
                                root.seek(root.playhead-seconds);
                                return accept;
                            }
                            if (event.text == Key.End) {
                                root.playhead-seconds = root.timeline-duration;
                                root.seek(root.playhead-seconds);
                                return accept;
                            }
                            return reject;
                        }
                    }

                    VerticalLayout {
                        spacing: 0px;

                        Rectangle {
                            height: 30px;
                            background: Theme.palette().surface;
                            HorizontalLayout {
                                spacing: 0px;
                                Rectangle {
                                    width: root.track-header-width;
                                    background: Theme.palette().panel;
                                    Text { text: "TRACKS"; x: 9px; width: parent.width - 18px; font-size: Theme.tokens.typography.micro; font-weight: 700; color: Theme.palette().ink-disabled; vertical-alignment: center; }
                                }
                                ruler-lane := Rectangle {
                                    horizontal-stretch: 1;
                                    background: Theme.palette().surface;
                                    border-width: 0px;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        Text { text: "0s"; horizontal-stretch: 1; color: Theme.palette().ink-disabled; font-size: 9px; }
                                        Text { text: Math.round(root.timeline-duration * 0.25 * 10) / 10 + "s"; horizontal-stretch: 1; color: Theme.palette().ink-disabled; font-size: 9px; horizontal-alignment: center; }
                                        Text { text: Math.round(root.timeline-duration * 0.5 * 10) / 10 + "s"; horizontal-stretch: 1; color: Theme.palette().ink-disabled; font-size: 9px; horizontal-alignment: center; }
                                        Text { text: Math.round(root.timeline-duration * 0.75 * 10) / 10 + "s"; horizontal-stretch: 1; color: Theme.palette().ink-disabled; font-size: 9px; horizontal-alignment: center; }
                                        Text { text: Math.round(root.timeline-duration * 10) / 10 + "s"; horizontal-stretch: 1; color: Theme.palette().ink-disabled; font-size: 9px; horizontal-alignment: right; }
                                    }
                                    ruler-scrub := TouchArea {
                                        mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                                        pointer-event(event) => {
                                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                                timeline-focus.focus();
                                            }
                                        }
                                        moved => {
                                            if (self.pressed) {
                                                root.playhead-seconds = clamp(self.mouse-x / self.width * root.timeline-duration, 0.0, root.timeline-duration);
                                            }
                                        }
                                        clicked => {
                                            root.playhead-seconds = clamp(self.mouse-x / self.width * root.timeline-duration, 0.0, root.timeline-duration);
                                            root.seek(root.playhead-seconds);
                                        }
                                    }
                                    Rectangle {
                                        x: clamp(parent.width * root.playhead-seconds / Math.max(0.01, root.timeline-duration) - 5px, 0px, parent.width - 10px);
                                        y: parent.height - 10px;
                                        width: 10px;
                                        height: 10px;
                                        border-radius: 5px;
                                        background: Theme.palette().meter-warn;
                                        border-width: 2px;
                                        border-color: Theme.palette().paper;
                                        animate x { duration: ruler-scrub.pressed || Theme.tokens.reduced-motion ? 0ms : 90ms; }
                                    }
                                }
                            }
                        }

                        for track[index] in root.track-labels : Rectangle {
                            height: 64px;
                            background: index == root.active-track-index ? Theme.palette().selection-soft : Theme.palette().surface-sunken;
                            HorizontalLayout {
                                spacing: 0px;
                                Rectangle {
                                    width: root.track-header-width;
                                    background: Theme.palette().surface;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 7px;
                                        spacing: 5px;
                                        IconButton { icon: "audio"; label: "Mute track"; checked: root.track-mutes[index]; clicked => { root.toggle-track-mute(index); } }
                                        ToolButton { text: "S"; checked: root.track-solos[index]; clicked => { root.toggle-track-solo(index); } }
                                        Text { text: track; color: Theme.palette().ink; font-size: 11px; font-weight: index == root.active-track-index ? 650 : 500; overflow: elide; vertical-alignment: center; }
                                    }
                                    TouchArea { clicked => { timeline-focus.focus(); root.select-track(index); } }
                                }

                                track-lane := Rectangle {
                                    horizontal-stretch: 1;
                                    background: Theme.palette().media-stage;
                                    border-width: 0px;

                                    lane-scrub := TouchArea {
                                        mouse-cursor: self.pressed ? MouseCursor.grabbing : MouseCursor.grab;
                                        pointer-event(event) => {
                                            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                                                timeline-focus.focus();
                                            }
                                        }
                                        moved => {
                                            if (self.pressed) {
                                                root.playhead-seconds = clamp(self.mouse-x / self.width * root.timeline-duration, 0.0, root.timeline-duration);
                                            }
                                        }
                                        clicked => {
                                            root.playhead-seconds = clamp(self.mouse-x / self.width * root.timeline-duration, 0.0, root.timeline-duration);
                                            root.seek(root.playhead-seconds);
                                        }
                                    }

                                    for clip[clip-index] in root.clip-labels : clip-card := Rectangle {
                                        visible: index == 0;
                                        x: parent.width * root.clip-starts[clip-index] / Math.max(0.01, root.timeline-duration);
                                        width: Math.max(56px, parent.width * root.clip-durations[clip-index] / Math.max(0.01, root.timeline-duration) - 3px);
                                        y: 6px;
                                        height: 52px;
                                        border-radius: 7px;
                                        background: clip-index == root.active-clip-index ? Theme.palette().content-accent : clip-touch.has-hover ? Theme.palette().content-accent-soft : Theme.palette().content-cool;
                                        border-width: clip-index == root.active-clip-index || clip-touch.has-hover ? 2px : 1px;
                                        border-color: clip-index == root.active-clip-index ? Theme.palette().focus : clip-touch.has-hover ? Theme.palette().accent : Theme.palette().content-cool;
                                        animate background, border-color { duration: Theme.tokens.reduced-motion ? 0ms : 120ms; }
                                        VerticalLayout {
                                            padding: 6px;
                                            spacing: 3px;
                                            Text { text: clip; color: Theme.palette().paper; font-size: 11px; font-weight: 650; overflow: elide; }
                                            HorizontalLayout {
                                                spacing: 5px;
                                                Icon { icon: "waveform"; size: 16px; tint: Theme.palette().paper-line; }
                                                Text { text: Math.round(root.clip_durations[clip-index] * 100) / 100 + "s"; font-size: 9px; color: Theme.palette().paper-muted; vertical-alignment: center; }
                                            }
                                        }
                                        clip-touch := TouchArea {
                                            clicked => {
                                                timeline-focus.focus();
                                                root.select-clip(clip-index);
                                                if (root.active-nle-tool == "Blade") {
                                                    root.split-clip();
                                                }
                                            }
                                        }
                                    }

                                    Rectangle {
                                        x: clamp(parent.width * root.playhead-seconds / Math.max(0.01, root.timeline-duration), 0px, parent.width - 2px);
                                        width: 2px;
                                        height: parent.height;
                                        background: Theme.palette().meter-warn;
                                        animate x { duration: lane-scrub.pressed || Theme.tokens.reduced-motion ? 0ms : 90ms; }
                                    }
                                }
                            }
                        }
                    }

                    timeline-dragging := TouchArea {
                        enabled: false;
                        visible: false;
                    }

                    Rectangle {
                        x: root.track-header-width + 10px;
                        y: 34px;
                        min-width: 224px;
                        height: 28px;
                        border-radius: 8px;
                        background: Theme.palette().overlay;
                        border-width: 1px;
                        border-color: timeline-focus.has-focus ? Theme.palette().focus : Theme.palette().border;
                        HorizontalLayout {
                            spacing: 7px;
                            padding-left: 8px;
                            padding-right: 8px;
                            StatusPill { text: root.active-nle-tool.to-upper-case(); tone: timeline-focus.has-focus ? 1 : 0; }
                            Text {
                                text: "Drag timeline to scrub · arrows step one frame";
                                font-size: Theme.tokens.typography.caption;
                                color: Theme.palette().ink-secondary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            if root.show-inspector : Rectangle { width: 1px; background: Theme.palette().border; }
            if root.show-inspector : InspectorSurface {
                width: root.compact-layout ? 236px : 306px;
                title: "Inspector";
                detail: root.clip-labels.length > 0 ? "Selected clip" : "No selection";
                PaneTabs { items: ["Clip", "Edit", "Export"]; current <=> root.inspector-tab; }
                Rectangle { height: 1px; background: Theme.palette().border; }
                VerticalLayout {
                    spacing: 12px;
                    padding: 14px;
                    if root.inspector-tab == 0 : VerticalLayout {
                        spacing: 10px;
                        Text { text: "CLIP"; font-size: Theme.tokens.typography.caption; font-weight: 700; color: Theme.palette().ink-secondary; }
                        Text { text: root.clip-labels.length > 0 ? root.clip-labels[root.active-clip-index] : "No clip"; font-size: Theme.tokens.typography.body-large; font-weight: 650; color: Theme.palette().ink; wrap: word-wrap; }
                        Text { text: root.clip-labels.length > 0 ? "Start " + Math.round(root.clip-starts[root.active-clip-index] * 100) / 100 + " s · Duration " + Math.round(root.clip-durations[root.active-clip-index] * 100) / 100 + " s" : ""; font-size: Theme.tokens.typography.caption; color: Theme.palette().ink-secondary; wrap: word-wrap; }
                    }
                    if root.inspector-tab == 1 : VerticalLayout {
                        spacing: 8px;
                        Text { text: "TIMELINE EDIT"; font-size: Theme.tokens.typography.caption; font-weight: 700; color: Theme.palette().ink-secondary; }
                        ToolButton { icon: "scissors"; text: "Split at Playhead"; enabled: root.clip-labels.length > 0; clicked => { root.split-clip(); } }
                        ToolButton { icon: "chevron-right"; text: "Trim In +0.25s"; enabled: root.clip-labels.length > 0; clicked => { root.trim-selected(0.25, 0); } }
                        ToolButton { icon: "chevron-left"; text: "Trim Out -0.25s"; enabled: root.clip-labels.length > 0; clicked => { root.trim-selected(0, -0.25); } }
                        ToolButton { icon: "trash"; text: "Remove Clip (Ripple)"; enabled: root.clip-labels.length > 0; clicked => { root.remove-clip(); } }
                    }
                    if root.inspector-tab == 2 : VerticalLayout {
                        spacing: 10px;
                        Text { text: "LOCAL TIMELINE EXPORT"; font-size: Theme.tokens.typography.caption; font-weight: 700; color: Theme.palette().ink-secondary; }
                        Field { label: "Export path"; placeholder: "output.mp4"; value <=> root.export-path; }
                        PrimaryButton { text: root.exporting ? "Exporting " + Math.round(root.export-progress) + "%" : "Export H.264"; enabled: root.backend-available && root.clip-labels.length > 0 && !root.exporting; clicked => { root.export-timeline(root.export-path); } }
                        Text { text: "The current renderer concatenates enabled video clips through FFmpeg. Audio mixing remains a separate integration milestone."; wrap: word-wrap; font-size: Theme.tokens.typography.caption; color: Theme.palette().ink-secondary; }
                    }
                    Rectangle { vertical-stretch: 1; background: transparent; }
                }
            }
        }

        StatusBar { status-left: root.status-left; status-right: root.status-right; }
    }
}
